# Fins de ligne canoniques du depot. Detail et rationale : .
#
# Sources et scripts normalises en LF (depot ET arbre de travail, Windows
# inclus). Les .owl ne sont PAS normalises : le langage tolere LF/CRLF. Le code
# tiers (vendor/) reste tel que publie par l'amont.

*.c     text eol=lf
*.h     text eol=lf
*.cpp   text eol=lf
*.hpp   text eol=lf
*.sh    text eol=lf
*.def   text eol=lf

vendor/** -text
