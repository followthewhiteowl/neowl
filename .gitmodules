[submodule "vendor/qt6/qtbase"]
	path = vendor/qt6/qtbase
	url = https://code.qt.io/qt/qtbase.git
[submodule "vendor/qpdf"]
	path = vendor/qpdf
	url = https://github.com/qpdf/qpdf.git
[submodule "vendor/zlib"]
	path = vendor/zlib
	url = https://github.com/madler/zlib.git
	# Le CMakeLists.txt amont de zlib fait file(RENAME zconf.h zconf.h.included)
	# au configure pour eviter une collision avec le zconf.h genere par
	# autotools quand le meme source est utilise des deux build systems.
	# Side-effect : working tree de vendor/zlib reste "dirty" en permanence
	# apres le 1er build qpdf. On ignore ce dirty pour ne pas polluer
	# git status du repo root — la version du submodule (zlib 1.3.1)
	# reste suivie comme d'habitude.
	ignore = dirty
[submodule "vendor/libjpeg-turbo"]
	path = vendor/libjpeg-turbo
	url = https://github.com/libjpeg-turbo/libjpeg-turbo.git
[submodule "vendor/duckdb/source"]
	path = vendor/duckdb/source
	url = https://github.com/duckdb/duckdb.git
[submodule "vendor/zstd"]
	path = vendor/zstd
	url = https://github.com/facebook/zstd.git
[submodule "vendor/qt6/qtsvg"]
	path = vendor/qt6/qtsvg
	url = https://code.qt.io/qt/qtsvg.git
