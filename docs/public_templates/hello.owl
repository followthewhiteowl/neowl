// @nom: hello
// @description: Premier script OWL — variables typées et Trace
// @niveau: basique

// Script plat : pas de procédure principale, pas de classe. Les
// instructions s'exécutent dans l'ordre. Idéal pour explorer
// rapidement une idée.

Trace("Hello OWL")

// Variables typées explicitement. OWL ne fait pas d'inférence
// implicite — le type vit au-dessus de la valeur.
nom est une chaîne = "monde"
n   est un entier = 42

Trace("Bonjour ", nom, ", la réponse est ", n)

// Concaténation simple.
salutation est une chaîne = "Bonjour " + nom + " !"
Trace(salutation)
