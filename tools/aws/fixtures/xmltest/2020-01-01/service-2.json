{
  "version": "2.0",
  "metadata": {
    "apiVersion": "2020-01-01",
    "endpointPrefix": "xmltest",
    "protocol": "rest-xml",
    "serviceFullName": "XML Serialisation Test",
    "serviceId": "Xmltest",
    "signatureVersion": "v4",
    "signingName": "xmltest",
    "uid": "xmltest-2020-01-01"
  },
  "operations": {
    "GetStuff": {
      "name": "GetStuff",
      "http": { "method": "GET", "requestUri": "/stuff" },
      "output": { "shape": "GetStuffResponse" }
    },
    "PutStuff": {
      "name": "PutStuff",
      "http": { "method": "PUT", "requestUri": "/stuff" },
      "input": { "shape": "PutStuffRequest" }
    }
  },
  "shapes": {
    "GetStuffResponse": { "type": "structure", "members": {} },
    "PutStuffRequest": {
      "type": "structure",
      "members": {
        "AccountId": { "shape": "StringType", "location": "uri", "locationName": "account" },
        "Name": { "shape": "StringType" },
        "Tags": { "shape": "TagList", "locationName": "TagSet" },
        "Nested": { "shape": "NestedType" }
      },
      "locationName": "PutStuffRequest",
      "xmlNamespace": { "uri": "http://xmltest.example.com/doc/2020-01-01/" }
    },
    "StringType": { "type": "string" },
    "IntType": { "type": "integer" },
    "TagList": {
      "type": "list",
      "member": { "shape": "StringType", "locationName": "Tag" }
    },
    "NestedType": {
      "type": "structure",
      "members": {
        "Value": { "shape": "IntType" }
      }
    }
  }
}
