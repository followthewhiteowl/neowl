/* owl_categories.def — Single source des categories (natives ET non-natives :
 * mots-cles, limites compile-time), dans leurs deux formes canoniques.
 *
 * Format : OWL_CATEGORY(fr, en)
 *   - fr : forme canonique FR. C'est la CLE portee par le champ `category`
 *          des OwlNativeDef (et des constantes / limites qui reutilisent le
 *          meme vocabulaire). Doit correspondre byte a byte.
 *   - en : forme canonique EN. Identique a `fr` quand la categorie porte
 *          deja un nom anglais (HTTP, JSON, Buffer, Chrono...).
 *
 * La categorie est la cle du filtre `owl list ... --cat <X>` : les deux
 * formes resolvent vers la meme categorie (casse- et accent-insensible,
 * invariants 1 et 2), et l'affichage rend celle de la langue courante.
 *
 * Inclus en double-include depuis owl_categories.c. Ajouter une categorie au
 * registre = ajouter une ligne ici, rien d'autre : le rendu la reprend sans
 * edit. Le self-test du registre exige la paire pour toute categorie portee
 * par une declaration — un oubli rougit, il ne passe pas silencieusement.
 *
 * Six formes EN ne sont pas des traductions libres mais des formes deja
 * etablies ailleurs dans le registre : Reports (Etat/Report), Arrays
 * (tableau/array), Strings (chaine/string), Color (enum couleur/color),
 * BarCodes (CodeBarres/BarCodes), Math.
 */

OWL_CATEGORY("AWS",                  "AWS")
OWL_CATEGORY("Binaire",              "Binary")
OWL_CATEGORY("Buffer",               "Buffer")
OWL_CATEGORY("Chaines",              "Strings")
OWL_CATEGORY("Chrono",               "Chrono")
OWL_CATEGORY("CodeBarres",           "BarCodes")
OWL_CATEGORY("Compression",          "Compression")
OWL_CATEGORY("Console",              "Console")
OWL_CATEGORY("Conversion",           "Conversion")
OWL_CATEGORY("Couleur",              "Color")
OWL_CATEGORY("Cryptographie",        "Cryptography")
OWL_CATEGORY("Dates",                "Dates")
OWL_CATEGORY("Debug",                "Debug")
OWL_CATEGORY("Données",              "Data")
OWL_CATEGORY("Email",                "Email")
OWL_CATEGORY("Encodage",             "Encoding")
OWL_CATEGORY("Erreur",               "Error")
OWL_CATEGORY("Etats",                "Reports")
OWL_CATEGORY("Eval",                 "Eval")
OWL_CATEGORY("Exceptions",           "Exceptions")
OWL_CATEGORY("Fichiers",             "Files")
OWL_CATEGORY("File",                 "Queue")
OWL_CATEGORY("FTP",                  "FTP")
OWL_CATEGORY("HTTP",                 "HTTP")
OWL_CATEGORY("Icone",                "Icon")
OWL_CATEGORY("Image",                "Image")
OWL_CATEGORY("Intelligence artificielle", "Artificial Intelligence")
OWL_CATEGORY("Internationalisation", "Internationalization")
OWL_CATEGORY("Introspection",        "Introspection")
OWL_CATEGORY("JSON",                 "JSON")
OWL_CATEGORY("Maths",                "Math")
OWL_CATEGORY("Métriques d'évaluation", "Evaluation Metrics")
OWL_CATEGORY("Matrices",             "Matrices")
OWL_CATEGORY("AMQP",                 "AMQP")
OWL_CATEGORY("MQTT",                 "MQTT")
OWL_CATEGORY("NATS",                 "NATS")
OWL_CATEGORY("STOMP",                "STOMP")
OWL_CATEGORY("Pile",                 "Stack")
OWL_CATEGORY("Projet",               "Project")
OWL_CATEGORY("Regex",                "Regex")
OWL_CATEGORY("Runtime",              "Runtime")
OWL_CATEGORY("SQL",                  "SQL")
OWL_CATEGORY("SimilaritéTexte",      "TextSimilarity")
OWL_CATEGORY("Système",              "System")
OWL_CATEGORY("Tableaux",             "Arrays")
OWL_CATEGORY("Tableaux Associatifs", "Associative Arrays")
OWL_CATEGORY("Tableur",              "Spreadsheet")
