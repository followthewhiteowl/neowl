/* Categories NON-NATIVES : mots-cles (owl_keyword_catalog.c) et limites
 * compile-time (owl_limits.def). Meme role de cle bilingue, meme rendu via
 * owl_category_display. Sans leur paire, l'en-tete anglais de
 * `owl list keywords` / `owl list limits` et la fiche `owl explain` sortaient
 * en francais. La regle 56 du self-test exige desormais la paire pour toute
 * categorie portee par un mot-cle ou une limite, pas seulement une native.
 * Les categories d'operateurs (`list operators`) sont desormais enregistrees
 * ici aussi, avec l'en-tete et les libelles de la commande. */

/* Mots-cles */
OWL_CATEGORY("Constantes",           "Constants")
OWL_CATEGORY("Contrôle",             "Control")
OWL_CATEGORY("Déclaration",          "Declaration")
OWL_CATEGORY("Logique",              "Logic")
OWL_CATEGORY("OOP",                  "OOP")
OWL_CATEGORY("Visibilité",           "Visibility")

/* Operateurs (owl_operator_catalog.c) — separateurs de `list operators`,
 * restes FR en --lang en avant leur enregistrement bilingue ici. */
OWL_CATEGORY("Comparaison chaîne",   "String comparison")
OWL_CATEGORY("Null-safe",            "Null-safe")
OWL_CATEGORY("Égalité souple",       "Loose equality")
OWL_CATEGORY("Affectation",          "Assignment")
OWL_CATEGORY("Arithmétique",         "Arithmetic")
OWL_CATEGORY("Comparaison",          "Comparison")

/* Limites compile-time */
OWL_CATEGORY("Compiler/Bytecode",    "Compiler/Bytecode")
OWL_CATEGORY("Compiler/Controle",    "Compiler/Control")
OWL_CATEGORY("Compiler/DSL",         "Compiler/DSL")
OWL_CATEGORY("Compiler/Globales",    "Compiler/Globals")
OWL_CATEGORY("Compiler/Hoisting",    "Compiler/Hoisting")
OWL_CATEGORY("Compiler/POO",         "Compiler/OOP")
OWL_CATEGORY("Compiler/Procedures",  "Compiler/Procedures")
OWL_CATEGORY("Compiler/Types",       "Compiler/Types")
