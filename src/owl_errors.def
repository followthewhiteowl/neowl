/* owl_errors.def — Source canon des codes d'erreur OWL.
 *
 * Chaque entrée OWL_ERROR(name, category, templateFR, templateEN) définit :
 *  - `name`       : code symbole en C (E_LEX_UNTERMINATED_STRING, etc.)
 *  - `category`   : classe sémantique ("lex", "syntax", "semantic", "runtime", "native", "io")
 *  - `templateFR` : template message FR (avec placeholders {var} si dynamiques)
 *  - `templateEN` : template message EN (avec placeholders {var} si dynamiques)
 *
 * Les placeholders respectent la syntaxe {nom_var}. Le rendu est fait par
 * owl_error_render_fr / owl_error_render_en (format engine interne).
 *
 * Cf.  pour la politique de stabilité / numérotation des codes. En
 * phase alpha, les codes peuvent être renumérotés librement. Au passage beta/v1,
 * on gèle l'ordre et on garantit la stabilité backward.
 *
 * ALIAS NUMÉRIQUE : chaque code expose aussi un numéro court
 * dérivé de son ORDRE D'APPARITION dans ce fichier, par espace de préfixe
 * (codes E_* -> E0001, E0002, ... ; codes W_* -> W0001, W0002, ... ;
 * compteurs séparés). ⚠ Ce numéro est DÉRIVÉ, pas stocké : insérer un code
 * au milieu d'un espace décale tous les numéros suivants. Tant qu'on est en
 * alpha c'est assumé (cf. politique ci-dessus). Pour garder un numéro stable,
 * ajouter les nouveaux codes EN FIN d'espace.
 *
 * ================================================================ */

/* ================================================================
 * LEX — erreurs scanner (6 codes pour migration scanner complète)
 * ================================================================ */
OWL_ERROR(E_LEX_UNTERMINATED_STRING,        "lex",
          "Chaîne non terminée.",
          "Unterminated string.")
OWL_ERROR(E_LEX_UNTERMINATED_STRING_INTERP, "lex",
          "Chaîne avec interpolation non terminée (%\"...\").",
          "Unterminated interpolated string (%\"...\").")
OWL_ERROR(E_LEX_UNTERMINATED_BACKTICK,      "lex",
          "Chaîne backtick non terminée.",
          "Unterminated backtick string.")
OWL_ERROR(E_LEX_UNTERMINATED_MULTILINE,     "lex",
          "Chaîne multi-ligne non terminée (']' manquant).",
          "Unterminated multiline string (']' missing).")
OWL_ERROR(E_LEX_UNEXPECTED_CHAR_QUOTED,     "lex",
          "Caractère inattendu : '{char}'.",
          "Unexpected character: '{char}'.")
OWL_ERROR(E_LEX_UNEXPECTED_CHAR,            "lex",
          "Caractère inattendu.",
          "Unexpected character.")
OWL_ERROR(E_LEX_INVALID_ESCAPE,             "lex",
          "Séquence d'échappement invalide : '\\{char}'.",
          "Invalid escape sequence: '\\{char}'.")
OWL_ERROR(E_LEX_INVISIBLE_CHAR,             "lex",
          "Caractère invisible {cp} ({name}), probablement collé depuis un document externe. Le supprimer ou le remplacer par un espace normal.",
          "Invisible character {cp} ({name}), likely pasted from an external document. Remove it or replace it with a normal space.")

