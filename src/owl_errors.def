          "'{name}' is not a known native function. The 'OWL.' namespace "
          "targets an original native function.")
OWL_ERROR(E_SEM_DOT_OUTSIDE_AVEC, "semantic",
          "Accès '.<membre>' nécessite un bloc AVEC/WITH englobant.",
          "'.' member access requires a WITH block.")
OWL_ERROR(E_SEM_PRIVATE_SYMBOL_ACCESS, "semantic",
          "Accès interdit à un symbole privé depuis un autre fichier.",
          "Cannot access private symbol from another file.")
OWL_ERROR(E_SEM_AMBIGUOUS_SYMBOL, "semantic",
          "Symbole ambigu, utiliser le nom qualifié (ex: "
          "collection.Nom).",
          "Ambiguous symbol, use qualified name (e.g. collection.Name).")
OWL_ERROR(E_SEM_REASSIGN_REFERENCE_OP, "semantic",
          "L'opérateur '<-' n'est pas nécessaire en OWL : '=' sur un "
          "objet donne déjà une référence. Utilisez '<=' pour forcer "
          "une copie profonde.",
          "Operator '<-' is not needed in OWL: '=' on an object already "
          "gives a reference. Use '<=' to force a deep copy.")

/* --- Call / parameter / default semantic errors --- */
OWL_ERROR(E_SEM_EXECUTE_NEEDS_PROC_ARG, "semantic",
          "'Exécute' attend au moins un argument procédure.",
          "Execute expects at least a procedure argument.")
OWL_ERROR(E_SEM_REQUIRED_PARAM_AFTER_DEFAULT, "semantic",
          "Un paramètre requis ne peut pas suivre un paramètre avec "
          "valeur par défaut.",
          "Required parameter cannot follow a parameter with a default value.")
OWL_ERROR(E_SEM_PARAM_TYPE_REQUIRED, "semantic",
          "Le paramètre '{name}' doit avoir un type explicite (pas "
          "d'inférence, pas de Variant).",
          "Parameter '{name}' must have an explicit type (no inference, "
          "no Variant).")
OWL_ERROR(E_SEM_DEFAULT_MUST_BE_LITERAL, "semantic",
          "Valeur par défaut de paramètre attendue : littéral "
          "(entier, réel, chaîne, Vrai/Faux, Null).",
          "Default parameter value must be a literal "
          "(integer, real, string, True/False, Null).")
OWL_ERROR(E_SEM_DEFAULT_MINUS_PREFIX_INVALID, "semantic",
          "Préfixe '-' invalide pour cette valeur par défaut ({kind}).",
          "'-' prefix is not valid for this default value ({kind}).")

/* --- Assignment / dot-chain semantic errors --- */
OWL_ERROR(E_SEM_DOTDOT_ON_CONST, "semantic",
          "'{name}' est une constante ({category}), pas un type composé "
          "— chaînage '..' interdit.",
          "'{name}' is a constant ({category}), not a composite type — "
          "'..' chaining is not allowed.")
OWL_ERROR(E_SEM_INDIRECTION_SCOPE_INVALID, "semantic",
          "'{name}' n'est pas un scope d'indirection — scopes valides "
          ": indFenêtre, indChamp, indVariable.",
          "'{name}' is not an indirection scope — valid scopes: "
          "indWindow, indControl, indVariable.")
OWL_ERROR(E_SEM_STYLE_STATE_INVALID, "semantic",
          "'{state}' n'est pas un état de {type} — états valides : "
          "{states}.",
          "'{state}' is not a state of {type} — valid states: {states}.")
OWL_ERROR(E_SEM_STYLE_INDEX_NOT_COLLECTION, "semantic",
          "Indexation invalide sur {type} : le crochet [etat] doit viser le "
          "membre Etats (ex : ..ZoneSaisie..Etats[survol]..CouleurFond).",
          "Invalid indexing on {type}: the [state] bracket must target the "
          "Etats member (e.g. ..ZoneSaisie..Etats[hover]..CouleurFond).")
OWL_ERROR(E_SEM_STYLE_LITERAL_INDEXED_STATE, "semantic",
          "Forme indexée '{field}[...]' refusée dans un littéral : écrire "
          "« {exemple} ».",
          "Indexed form '{field}[...]' is not accepted inside a literal: write "
          "\"{exemple}\".")
OWL_ERROR(E_SEM_REASSIGN_CONSTANTE, "semantic",
          "'{name}' est une constante (déclarée dans un bloc "
          "CONSTANTE) — réassignation interdite.",
          "'{name}' is a constant (declared in a CONSTANT block) — "
          "reassignment is not allowed.")
OWL_ERROR(E_SEM_REASSIGN_READONLY_GLOBAL, "semantic",
          "'{name}' est une variable globale prédéfinie en lecture "
          "seule — réassignation interdite.",
          "'{name}' is a predefined read-only global variable — "
          "reassignment is not allowed.")

/* --- IS Class / class-name forms --- */
OWL_ERROR(E_SEM_EST_EXPECTED_CLASS_NAME, "semantic",
          "Attendu : nom de classe après 'est' (forme : '<objet> est "
          "<NomClasse>').",
          "Expected class name after 'est' (form: "
          "'<object> est <ClassName>').")

/* --- Class declaration scope / 1-class-per-file rule --- */
OWL_ERROR(E_SEM_CLASS_NOT_TOP_LEVEL, "semantic",
          "Une classe ne peut être déclarée qu'au top-level d'un "
          "fichier, pas dans une procédure ou méthode.",
          "A class can only be declared at the top level of a file, not "
          "inside a procedure or method.")
OWL_ERROR(E_SEM_CLASS_FILE_ALREADY_HAS_CLASS, "semantic",
          "Convention OWL : un fichier ne peut déclarer qu'une seule "
          "Classe. Classe '{name}' déjà déclarée ligne {line}. Place "
          "chaque Classe dans son propre fichier .owl.",
          "OWL convention: a file can only declare one Class. Class "
          "'{name}' already declared on line {line}. Place each Class in "
          "its own .owl file.")
OWL_ERROR(E_SEM_CLASS_FILE_HAS_WINDOW, "semantic",
          "Convention OWL : un fichier ne peut pas contenir une Classe "
          "et une Fenêtre. Fenêtre déjà déclarée ligne {line}. "
          "Place la Classe dans son propre fichier .owl.",
          "OWL convention: a file cannot contain both a Class and a "
          "Window. Window already declared on line {line}. Place the "
          "Class in its own .owl file.")
OWL_ERROR(E_SEM_CLASS_FILE_HAS_ETAT, "semantic",
          "Convention OWL : un fichier ne peut pas contenir une Classe "
          "et un État. État déjà déclaré ligne {line}. Place la "
          "Classe dans son propre fichier .owl.",
          "OWL convention: a file cannot contain both a Class and a "
          "Report. Report already declared on line {line}. Place the "
          "Class in its own .owl file.")
OWL_ERROR(E_SEM_CLASS_FILE_HAS_RUNTIME_CODE, "semantic",
          "Convention OWL : un fichier classe ne peut pas contenir de "
          "code runtime top-level. Statement déjà vu ligne {line}. Un "
          "fichier classe ne contient que la Classe (déclaration + "
          "méthodes inline dans le corps) + commentaires.",
          "OWL convention: a class file cannot contain top-level runtime "
          "code. Statement already seen on line {line}. A class file "
          "only contains the Class (declaration + inline methods in the "
          "body) + comments.")

/* --- Window / Etat declaration semantic errors --- */
OWL_ERROR(E_SEM_WINDOW_DUPLICATE, "semantic",
          "Fenêtre '{name}' déjà déclarée. Chaque fenêtre doit "
          "avoir un nom unique.",
          "Window '{name}' already declared. Each window must have a "
          "unique name.")
OWL_ERROR(E_SEM_ETAT_DUPLICATE, "semantic",
          "État '{name}' déjà déclaré. Chaque État doit avoir un "
          "nom unique.",
          "Report '{name}' already declared. Each Report must have a "
          "unique name.")
OWL_ERROR(E_SEM_ELEMENT_NAME_DUPLICATE, "semantic",
          "Le nom '{name}' est déjà utilisé par un autre élément du projet ; "
          "chaque élément de niveau supérieur doit avoir un nom unique.",
          "The name '{name}' is already used by another element in the "
          "project; each top-level element must have a unique name.")
OWL_ERROR(E_SEM_INTERNAL_WINDOW_REGISTER_FAILED, "semantic",
          "Erreur interne : échec d'enregistrement de la déclaration "
          "de fenêtre.",
          "Internal: failed to register window declaration.")
OWL_ERROR(E_SEM_INTERNAL_ETAT_REGISTER_FAILED, "semantic",
          "Erreur interne : échec d'enregistrement de la déclaration "
          "d'État.",
          "Internal: failed to register Report declaration.")

/* --- Symbol resolution / undefined / type-as-value --- */
OWL_ERROR(E_SEM_TYPE_USED_AS_VARIABLE, "semantic",
          "'{name}' est un nom de type, pas une variable.",
          "'{name}' is a type name, not a variable.")
OWL_ERROR(E_SEM_UNKNOWN_SYMBOL, "semantic",
          "'{name}' : {kind} inconnue ou inaccessible.",
          "'{name}': unknown or inaccessible {kind}.")
OWL_ERROR(E_SEM_BARE_FUNCTION_REFERENCE, "semantic",
          "'{name}' est une fonction — ajoute () pour l'appeler, ou "
          "passe-la en argument. Une référence isolée ne fait rien.",
          "'{name}' is a function — add () to call it, or pass it as an "
          "argument. A bare reference does nothing.")
OWL_ERROR(E_SEM_INSTRUCTION_SANS_EFFET, "semantic",
          "Instruction sans effet : cette expression ne produit aucun "
          "résultat utilisé. Manque une affectation, un appel, ou RENVOYER ?",
          "Statement with no effect: this expression produces no result that "
          "is used. Missing an assignment, a call, or RETURN?")

/* --- Native call / arity --- */
OWL_ERROR(E_SEM_CALL_BAD_ARITY, "semantic",
          "'{name}' attend {expected} argument(s), reçu {got}.",
          "'{name}' expects {expected} argument(s), got {got}.")
/* Multi-syntaxes : aucune des formes declarees ne matche le nb d'args.
   Couvre la forme chainee (receveur implicite) et les natives variadiques
   a formes discretes (Cherche {2,3,4}, ...). */
OWL_ERROR(E_SEM_NO_MATCHING_SYNTAX, "semantic",
          "Aucune syntaxe de '{name}' ne correspond ({got} argument(s) "
          "fourni(s)). Formes acceptées : {expected}.",
          "No syntax of '{name}' matches ({got} argument(s) provided). Accepted forms: {expected}.")
OWL_ERROR(E_SEM_CHAINE_VERS_DUREE_NEEDS_FORMAT, "semantic",
          "Cha\xc3\xae" "neVersDur\xc3\xa9" "e requiert 2 arguments "
          "(<Cha\xc3\xae" "ne>, <Format>). La forme \xc3\xa0 1 argument "
          "n'est plus support\xc3\xa9" "e.",
          "Cha\xc3\xae" "neVersDur\xc3\xa9" "e requires 2 arguments "
          "(<String>, <Format>). The 1-argument form is no longer supported.")

/* Litteral statique `dur est une duree = "..."` : format canon strict
 * Q5-bis "[+/-]<J>HHMMSSCC" (signe obligatoire + jours + heures/minutes/
 * secondes/centiemes, total >= 10 chars). Cf. .
 * Variante BAD_COUNT : longueur invalide ou bornes hors-plage.
 * Variante NON_DIGITS : caracteres non-numeriques presents apres le signe. */
OWL_ERROR(E_SEM_DUREE_LITERAL_FORMAT_BAD_COUNT, "semantic",
          "Format de dur\xc3\xa9" "e litt\xc3\xa9rale invalide : attendu "
          "[+/-]<J>HHMMSSCC (signe obligatoire, jours, heures, minutes, "
          "secondes, centi\xc3\xa8" "mes), obtenu {got}. Exemple valide : "
          "\"+0013000000\" pour 1h30.",
          "Invalid duration literal format: expected [+/-]<J>HHMMSSCC "
          "(sign required, days, hours, minutes, seconds, hundredths), "
          "got {got}. Valid example: \"+0013000000\" for 1h30.")
OWL_ERROR(E_SEM_DUREE_LITERAL_FORMAT_NON_DIGITS, "semantic",
          "Format de dur\xc3\xa9" "e litt\xc3\xa9rale invalide : la "
          "cha\xc3\xae" "ne contient des caract\xc3\xa8res non-num\xc3\xa9riques. "
          "Format attendu : [+/-]<J>HHMMSSCC (signe obligatoire).",
          "Invalid duration literal format: the string contains "
          "non-numeric characters. Expected format: [+/-]<J>HHMMSSCC "
          "(sign required).")

/*  /  — Litteraux statiques temporels (Date/Heure/DateHeure).
 * Symetrique de E_SEM_DUREE_LITERAL_FORMAT_*. Le parser appele est
 * EXACTEMENT le meme que la coerce runtime — single-parser invariant.
 *
 *  lot 1 — Scindes en 2 variantes par type (FORMAT vs BOUNDS,
 * decision coordinator Q2) :
 *   - _FORMAT : la chaine ne respecte pas la grammaire (longueur,
 *     digits, separateurs).
 *   - _BOUNDS : la grammaire est respectee mais les valeurs sont
 *     hors-plage calendaire/horaire (mois>12, jour>31, h>23, etc.).
 *
 * Messages obligatoirement porteurs des substrings "format invalide" /
 * "mois invalide" / "heure invalide" — testes par les fixtures
 * compile-error temporal_literal_*. */
OWL_ERROR(E_SEM_DATE_LITERAL_FORMAT, "semantic",
          "Litt\xc3\xa9ral date : format invalide. Formats accept\xc3\xa9s : "
          "AAAAMMJJ, JJ/MM/AAAA, JJ-MM-AAAA, AAAA-MM-JJ, AAAA/MM/JJ.",
          "Date literal: invalid format. Accepted formats: AAAAMMJJ, "
          "JJ/MM/AAAA, JJ-MM-AAAA, AAAA-MM-JJ, AAAA/MM/JJ.")
OWL_ERROR(E_SEM_DATE_LITERAL_BOUNDS, "semantic",
          "Litt\xc3\xa9ral date : mois invalide ou jour hors-borne. "
          "Mois doit \xc3\xaa" "tre 01-12, jour 01-31 selon le mois.",
          "Date literal: invalid month or out-of-range day. Month must be "
          "01-12, day 01-31 according to month.")
OWL_ERROR(E_SEM_HEURE_LITERAL_FORMAT, "semantic",
          "Litt\xc3\xa9ral heure : format invalide. Formats accept\xc3\xa9s : "
          "HHMMSS, HHMMSSCC, HH:MM, HH:MM:SS, HH:MM:SS:CC.",
          "Time literal: invalid format. Accepted formats: HHMMSS, "
          "HHMMSSCC, HH:MM, HH:MM:SS, HH:MM:SS:CC.")
OWL_ERROR(E_SEM_HEURE_LITERAL_BOUNDS, "semantic",
          "Litt\xc3\xa9ral heure invalide : composant hors-borne. Heures "
          "00-23, minutes et secondes 00-59, centi\xc3\xa8mes 00-99.",
          "Time literal: out-of-range component. Hours 00-23, minutes and "
          "seconds 00-59, centiseconds 00-99.")
OWL_ERROR(E_SEM_DATEHEURE_LITERAL_FORMAT, "semantic",
          "Litt\xc3\xa9ral dateheure : format invalide. Formats accept\xc3\xa9s : "
          "AAAA-MM-JJ[ T]HH:MM[:SS], AAAA/MM/JJ[ T]HH:MM[:SS], "
          "AAAAMMJJ[HHMM[SS[CC|FFF]]].",
          "DateTime literal: invalid format. Accepted: "
          "AAAA-MM-JJ[ T]HH:MM[:SS], AAAA/MM/JJ[ T]HH:MM[:SS], "
          "AAAAMMJJ[HHMM[SS[CC|FFF]]].")
OWL_ERROR(E_SEM_DATEHEURE_LITERAL_BOUNDS, "semantic",
          "Litt\xc3\xa9ral dateheure : mois invalide ou composant hors-borne. "
          "Mois 01-12, jour 01-31, heures 00-23, minutes/secondes 00-59.",
          "DateTime literal: invalid month or out-of-range component. "
          "Month 01-12, day 01-31, hours 00-23, minutes/seconds 00-59.")

/* Cast `entier = <DateHeure>` : pas de canon univoque (DateHeureVersR\xc3\xa9el
 * renvoie un r\xc3\xa9el jours-Excel, DateHeureVersEpoch renvoie un timestamp Unix).
 * On rejette l'affectation pour forcer le choix explicite. Cf. . */
OWL_ERROR(E_SEM_DATEHEURE_TO_INT_NO_CANON, "semantic",
          "Cast DateHeure \xe2\x86\x92" " entier : pas de conversion canon "
          "unique. Utiliser 'DateHeureVersR\xc3\xa9" "el' (r\xc3\xa9" "el "
          "jours Excel) ou 'DateHeureVersEpoch' (entier timestamp Unix) "
          "selon le besoin.",
          "DateTime \xe2\x86\x92" " integer cast: no single canonical "
          "conversion. Use 'DateTimeToReal' (Excel days as real) or "
          "'DateTimeToEpoch' (Unix timestamp integer) as needed.")

/*  — Coercion structurelle tableau <-> scalaire refusee. La frontiere
 * tableau/scalaire est un mismatch toujours invalide (a la difference des
 * coercions valeur-dependantes scalaire<->scalaire). Typage explicite requis. */
OWL_ERROR(E_SEM_ARRAY_FROM_SCALAR, "semantic",
          "Affectation d'un scalaire à une variable tableau refusée : la "
          "frontière tableau ⇄ scalaire ne se convertit pas implicitement "
          "(pas de wrap ni d'éclatement par caractère). Initialiser le "
          "tableau avec un littéral '[...]', ou changer le type de la "
          "variable.",
          "Assigning a scalar to an array variable is refused: the array ⇄ "
          "scalar boundary is not implicitly converted (no wrapping nor "
          "per-character splitting). Initialize the array with a '[...]' "
          "literal, or change the variable's type.")
OWL_ERROR(E_SEM_SCALAR_FROM_ARRAY, "semantic",
          "Affectation d'un tableau à une variable scalaire refusée : la "
          "frontière tableau ⇄ scalaire ne se convertit pas implicitement "
          "(pas de sérialisation). Indexer le tableau (ex. 'tab[1]') pour "
          "obtenir un élément, ou changer le type de la variable.",
          "Assigning an array to a scalar variable is refused: the array ⇄ "
          "scalar boundary is not implicitly converted (no serialization). "
          "Index the array (e.g. 'tab[1]') to get an element, or change the "
          "variable's type.")

/*  — Typage strict a l'affectation pour les types objet/struct.
 * Une instance d'un type objet/struct ne peut etre affectee qu'a une variable
 * du meme type ou d'un super-type (sous-type assignable a super-type, Liskov).
 * Deux types objet sans relation d'heritage sont incompatibles. */
OWL_ERROR(E_SEM_OBJECT_ASSIGN_TYPE_MISMATCH, "semantic",
          "Affectation refusée : type objet '{got}' incompatible avec "
          "'{expected}' (aucune relation d'héritage). Un sous-type est "
          "assignable à un super-type, pas l'inverse ni entre types objet "
          "sans lien.",
          "Assignment refused: object type '{got}' is incompatible with "
          "'{expected}' (no inheritance relationship). A subtype is "
          "assignable to a super-type, not the reverse nor between unrelated "
          "object types.")
OWL_ERROR(E_SEM_OBJECT_ASSIGN_FROM_SCALAR, "semantic",
          "Affectation refusée : {got} n'est pas une instance compatible du "
          "type objet '{expected}'. Un scalaire ne se convertit pas "
          "implicitement en instance.",
          "Assignment refused: {got} is not a compatible instance of object "
          "type '{expected}'. A scalar is not implicitly converted to an "
          "instance.")
OWL_ERROR(E_SEM_DSL_OBJECT_PROP_TYPE_MISMATCH, "semantic",
          "Affectation à '{target}' refusée : type '{got}' incompatible avec "
          "'{expected}' attendu.",
          "Assignment to '{target}' refused: type '{got}' is incompatible "
          "with expected '{expected}'.")
/*  — genre de style incompatible avec le genre du champ recepteur.
 * Un champ n'accepte que le styleXxx correspondant a son genre (Bouton ->
 * styleBouton, Saisie -> styleSaisie, Libelle -> styleLibelle...). */
OWL_ERROR(E_SEM_STYLE_KIND_MISMATCH, "semantic",
          "Style incompatible : le champ '{field}' ({kind}) attend un "
          "{expected}, mais '{style}' est un {got}.",
          "Incompatible style: field '{field}' ({kind}) expects a "
          "{expected}, but '{style}' is a {got}.")

/* --- Control / widget context errors --- */
OWL_ERROR(E_SEM_CONTROL_KIND_OUTSIDE_WINDOW, "semantic",
          "'{kind}' n'est valide qu'à l'intérieur d'une déclaration "
          "'Fenêtre'.",
          "'{kind}' is only valid inside a 'Window' declaration.")
OWL_ERROR(E_SEM_WIDGET_NOT_SCALAR_ASSIGN, "semantic",
          "'{name}' est un {kind} — l'affectation directe '{name} = "
          "...' n'est pas supportée (widget composé ou non scalaire). "
          "Cible une propriété explicite ('{name}..Champ = ...') ou "
          "utilise les fonctions natives dédiées.",
          "'{name}' is a {kind} — direct assignment '{name} = ...' is "
          "not supported (composite or non-scalar widget). Target an "
          "explicit property ('{name}..Field = ...') or use dedicated "
          "native functions.")

/* --- Abstract class / file convention --- */
OWL_ERROR(E_SEM_ABSTRACT_CLASS_INSTANTIATION, "semantic",
          "La classe '{name}' est abstraite et ne peut pas être "
          "instanciée directement.",
          "Class '{name}' is abstract and cannot be instantiated "
          "directly.")
OWL_ERROR(E_SEM_FILE_WINDOW_AND_ETAT, "semantic",
          "Un fichier ne peut pas contenir à la fois une Fenêtre et un "
          "État. État déjà déclaré ligne {line}. Place les "
          "Fenêtres et les États dans des fichiers séparés.",
          "A file cannot contain both a Window and a Report. Report "
          "already declared on line {line}. Place Windows and Reports "
          "in separate files.")
OWL_ERROR(E_SEM_OUVRE_FORBIDDEN_IN_ETAT, "semantic",
          "{name}() interdit dans un État. Un État génère un rapport "
          "(pas une UI interactive) — Ouvre() ne s'applique pas à ce "
          "contexte.",
          "{name}() forbidden inside a Report. A Report produces a "
          "printable document (no interactive UI) — Open() does not "
          "apply in this context.")
OWL_ERROR(E_SEM_MULTIPLE_WINDOWS_IN_FILE, "semantic",
          "Un fichier ne peut contenir qu'une seule Fenêtre. Première "
          "Fenêtre déclarée ligne {line}. Place chaque Fenêtre dans "
          "son propre fichier (le designer + le packaging supposent 1 "
          "fichier = 1 fenêtre).",
          "A file can only contain one Window. First Window declared on "
          "line {line}. Place each Window in its own file (the designer "
          "+ packaging assume 1 file = 1 window).")

/* --- Method declaration / visibility errors --- */
OWL_ERROR(E_SEM_ABSTRAITE_OUTSIDE_CLASS_METHOD, "semantic",
          "ABSTRAITE est réservé aux méthodes externes de classe "
          "(forme 'PROCEDURE ABSTRAITE cClasse.Methode(...)').",
          "ABSTRACT is reserved for external class methods (form "
          "'PROCEDURE ABSTRACT cClass.Method(...)').")
OWL_ERROR(E_SEM_METHOD_DUPLICATE, "semantic",
          "Méthode '{method}' déjà définie dans la classe '{class}' "
          "ligne {line}.",
          "Method '{method}' already defined in class '{class}' at "
          "line {line}.")
OWL_ERROR(E_SEM_PROTEGEE_OUTSIDE_CLASS, "semantic",
          "PROTÉGÉ n'est valide que pour les méthodes de classe — "
          "une procédure top-level ne peut pas être PROTÉGÉ (pas "
          "d'héritage hors classe).",
          "PROTEGEE is only valid for class methods — a top-level "
          "procedure cannot be PROTEGEE (no inheritance outside a "
          "class).")
OWL_ERROR(E_SEM_UNKNOWN_VISIBILITY_MODIFIER, "semantic",
          "'{name}' n'est pas un modificateur de visibilité reconnu. "
          "Formes acceptées : PRIVÉ, PUBLIC, PROTÉGÉ.",
          "'{name}' is not a recognized visibility modifier. Accepted "
          "forms: PRIVEE, PUBLIC, PROTEGEE.")
OWL_ERROR(E_SEM_METHODE_EXTERNE_SUPPRIMEE, "semantic",
          "Les méthodes externes (PROCEDURE {class}.{method}()) ne sont "
          "plus supportées. Déclarez la méthode directement dans le "
          "corps de la classe {class} : c'est le seul site de déclaration "
          "accepté.",
          "External methods (PROCEDURE {class}.{method}()) are no longer "
          "supported. Declare the method directly inside the body of "
          "class {class}: this is the only accepted declaration site.")
OWL_ERROR(E_SEM_METHODE_PREFIXE_REDONDANT, "semantic",
          "Dans le corps d'une classe, une méthode se déclare par son nom "
          "seul ; le préfixe « {class}. » devant {method} est superflu — "
          "écrivez PROCEDURE {method}(...).",
          "Inside a class body, a method is declared by its name alone; the "
          "prefix '{class}.' before {method} is redundant — write "
          "PROCEDURE {method}(...).")
OWL_ERROR(E_SEM_CONSTRUCTEUR_EXTERNE_SUPPRIME, "semantic",
          "Les méthodes externes ne sont plus supportées. Déclarez le "
          "Constructeur directement dans le corps de la classe "
          "via PROCEDURE Constructeur(...) : c'est le seul site de "
          "déclaration accepté.",
          "External methods are no longer supported. Declare the "
          "Constructor directly inside the class body via "
          "PROCEDURE Constructor(...): this is the only accepted "
          "declaration site.")
OWL_ERROR(E_SEM_DESTRUCTEUR_EXTERNE_SUPPRIME, "semantic",
          "Les méthodes externes ne sont plus supportées. Déclarez le "
          "Destructeur directement dans le corps de la classe via "
          "PROCEDURE Destructeur() : c'est le seul site de déclaration "
          "accepté.",
          "External methods are no longer supported. Declare the "
          "Destructor directly inside the class body via "
          "PROCEDURE Destructor(): this is the only accepted declaration "
          "site.")
OWL_ERROR(E_SEM_INSTANCE_NEEDS_ARGS, "semantic",
          "Constructeur de {name} requiert {arity} argument(s) : "
          "utiliser {name}(...) pour instancier.",
          "Constructor of {name} requires {arity} argument(s): "
          "use {name}(...) to instantiate.")

/* ================================================================
 * RUNTIME — erreurs runtime VM ( : 91 sites src/vm.c)
 *
 * Codes consommes par owl_emit_runtime_error(code, ...) via le pont
 * src/owl_errors_runtime.c. Le rendu va dans le format legacy
 * "Erreur d'execution : <msg>\n" + stack trace OU JSON selon
 * g_json_error_mode. Cf.  pour la politique de stabilite.
 * ================================================================ */

/* --- Arithmetique / division --- */
OWL_ERROR(E_RT_DIV_BY_ZERO, "runtime",
          "Division par zéro.",
          "Division by zero.")
OWL_ERROR(E_RT_OPERANDS_NUMBERS, "runtime",
          "Les opérandes doivent être des nombres.",
          "Operands must be numbers.")
OWL_ERROR(E_RT_VECTOR_ARRAY_OPERAND, "runtime",
          "Opérande tableau non autorisé en arithmétique Vecteur. "
          "Convertir explicitement via TableauVersVecteur ou déclarer un Vecteur.",
          "Array operand not allowed in Vector arithmetic. "
          "Convert explicitly with ArrayToVector or declare a Vector.")
OWL_ERROR(E_RT_VECTOR_SIZE_MISMATCH, "runtime",
          "Tailles de Vecteur incompatibles.",
          "Incompatible Vector sizes.")
OWL_ERROR(E_RT_VECTOR_EMPTY_REDUCTION, "runtime",
          "Réduction indéfinie sur un Vecteur vide.",
          "Reduction of an empty Vector is undefined.")
OWL_ERROR(E_RT_MATRIX_ARRAY_OPERAND, "runtime",
          "Opérande tableau non autorisé en arithmétique Matrice. "
          "Convertir explicitement via TableauVersMatrice ou déclarer une Matrice.",
          "Array operand not allowed in Matrix arithmetic. "
          "Convert explicitly with ArrayToMatrix or declare a Matrix.")
OWL_ERROR(E_RT_MATRIX_SIZE_MISMATCH, "runtime",
          "Dimensions de Matrice incompatibles.",
          "Incompatible Matrix dimensions.")
OWL_ERROR(E_RT_OPERANDS_NUMBERS_OR_STRINGS, "runtime",
          "Les opérandes doivent être des nombres ou des chaînes.",
          "Operands must be numbers or strings.")
OWL_ERROR(E_RT_OPERANDS_NUMBERS_OR_DATES, "runtime",
          "Les opérandes doivent être des nombres ou des dates.",
          "Operands must be numbers or dates.")
OWL_ERROR(E_RT_OPERAND_NUMBER, "runtime",
          "L'opérande doit être un nombre.",
          "Operand must be a number.")
OWL_ERROR(E_RT_NIL_ORDERED_CMP, "runtime",
          "Null ne peut être utilisé que dans une égalité (=) ou "
          "différence (<>).",
          "Null can only be used in an equality (=) or inequality (<>) comparison.")
OWL_ERROR(E_RT_LOGIC_OPERAND_TYPE, "runtime",
          "Opérateur ET/OU appliqué à une expression non booléenne. "
          "Convertir en booléen explicite (ex. Taille(s) > 0 pour une "
          "chaîne, t.Occurrence > 0 pour un tableau) ou utiliser _ET_ "
          "/ _OU_ si la valeur est déjà filtrée par court-circuit.",
          "AND/OR operator applied to a non-boolean expression. "
          "Convert to an explicit boolean (e.g. Length(s) > 0 for a "
          "string, t.Count > 0 for an array) or use _AND_ / _OR_ "
          "if the value is already filtered by short-circuit.")

/* --- Murs de coercion vers entier / monetaire --- */
OWL_ERROR(E_RT_NUMERIC_TO_INT_OVERFLOW, "runtime",
          "Conversion vers entier impossible : la magnitude du numérique "
          "dépasse la capacité d'un entier (±9223372036854775807).",
          "Cannot convert to integer: the numeric magnitude exceeds the "
          "integer capacity (±9223372036854775807).")
OWL_ERROR(E_RT_REAL_TO_INT_OVERFLOW, "runtime",
          "Conversion vers entier impossible : la magnitude dépasse la "
          "capacité d'un entier (±9223372036854775807).",
          "Cannot convert to integer: the magnitude exceeds the integer "
          "capacity (±9223372036854775807).")
OWL_ERROR(E_RT_REAL_TO_INT_NON_FINITE, "runtime",
          "Conversion vers entier impossible : valeur réelle non finie "
          "(Infini ou indéfini).",
          "Cannot convert to integer: non-finite real value (Infinity or "
          "NaN).")
OWL_ERROR(E_RT_NUMERIC_TO_CURRENCY_OVERFLOW, "runtime",
          "Conversion vers monétaire impossible : la magnitude du numérique "
          "dépasse la capacité d'un monétaire.",
          "Cannot convert to currency: the numeric magnitude exceeds the "
          "currency capacity.")

/* --- Appel / arite / chaine de procedures --- */
OWL_ERROR(E_RT_BAD_ARITY, "runtime",
          "{expected} argument(s) attendu(s), {got} reçu(s).",
          "Expected {expected} arguments but got {got}.")
OWL_ERROR(E_RT_BAD_ARITY_RANGE, "runtime",
          "Entre {min} et {max} argument(s) attendu(s), {got} reçu(s).",
          "Expected {min} to {max} arguments but got {got}.")
OWL_ERROR(E_RT_MISSING_DEFAULT, "runtime",
          "Valeur par défaut manquante pour le paramètre {position}.",
          "Missing default for parameter {position}.")
OWL_ERROR(E_RT_STACK_OVERFLOW, "runtime",
          "Débordement de pile.",
          "Stack overflow.")
OWL_ERROR(E_RT_PROC_CHAIN_TOO_MANY_ARGS, "runtime",
          "Trop d'arguments pour la chaîne de procédures.",
          "Too many arguments for procedure chain.")
OWL_ERROR(E_RT_CONSTRUCTOR_EXPECTED_ZERO_ARGS, "runtime",
          "0 argument attendu, {got} reçu(s).",
          "Expected 0 arguments but got {got}.")
OWL_ERROR(E_RT_NOT_CALLABLE, "runtime",
          "Seules les fonctions et procédures peuvent être appelées.",
          "Can only call functions and procedures.")

/* --- Exceptions --- */
OWL_ERROR(E_RT_UNHANDLED_EXCEPTION, "runtime",
          "Exception non gérée : {message}",
          "Unhandled exception: {message}")
OWL_ERROR(E_RT_EXCEPTION_STACK_OVERFLOW, "runtime",
          "Débordement de la pile des gestionnaires d'exception.",
          "Exception handler stack overflow.")
OWL_ERROR(E_RT_NO_PENDING_EXCEPTION, "runtime",
          "Pas d'exception en cours à propager.",
          "No pending exception to propagate.")
OWL_ERROR(E_RT_INTERRUPTED, "runtime",
          "Interrompu (Ctrl-C)",
          "Interrupted (Ctrl-C)")

/* --- Variables / fonctions inconnues --- */
OWL_ERROR(E_RT_UNDEFINED_FUNCTION, "runtime",
          "Fonction ou procédure inconnue '{name}'.",
          "Undefined function/procedure '{name}'.")
OWL_ERROR(E_RT_UNDEFINED_VARIABLE, "runtime",
          "Variable inconnue '{name}'.",
          "Undefined variable '{name}'.")

/* --- Conditions / controle de flux --- */
OWL_ERROR(E_RT_NON_BOOL_CONDITION, "runtime",
          "Expression non booléenne en condition. "
          "Une condition doit être un booléen, un nombre, ou Null. "
          "Pour tester une chaîne non vide : SI Taille(s) > 0. "
          "Pour tester un tableau non vide : SI t.Occurrence > 0.",
          "Non-boolean expression in condition. "
          "A condition must be a boolean, a number, or Null. "
          "To test a non-empty string: IF Length(s) > 0. "
          "To test a non-empty array: IF t.Count > 0.")

/* --- Indirection / acces dynamique --- */
OWL_ERROR(E_RT_INDIRECTION_NAME_STRING, "runtime",
          "Le nom d'indirection doit être une chaîne.",
          "Indirection name must be a string.")
OWL_ERROR(E_RT_INDIRECTION_NAME_UNKNOWN, "runtime",
          "Indirection : « {nom} » ne correspond à aucun élément connu "
          "(variable globale, fenêtre ou champ).",
          "Indirection: '{nom}' matches no known element "
          "(global variable, window or control).")
OWL_ERROR(E_RT_INDIRECTION_FIELD_UNKNOWN, "runtime",
          "Indirection : le champ « {nom} » est introuvable sur cette instance.",
          "Indirection: field '{nom}' not found on this instance.")
OWL_ERROR(E_RT_OBJ_DOT_BRACE_NEEDS_INSTANCE, "runtime",
          "Indirection obj.{expr} : une instance est attendue à gauche du "
          "point, et un nom de champ sous forme de chaîne entre accolades.",
          "Indirection obj.{expr}: an instance is expected left of the dot, "
          "and a field name as a string inside the braces.")

/* --- Slicing / subscript chaine --- */
OWL_ERROR(E_RT_SUBSCRIPT_NEEDS_STRING_OR_BUFFER, "runtime",
          "Indexation s[[i]] : seules une chaîne et un buffer sont "
          "indexables.",
          "Subscript s[[i]]: only a string or a buffer can be indexed.")
OWL_ERROR(E_RT_SLICE_NEEDS_STRING_OR_BUFFER, "runtime",
          "Extraction s[[i À j]] : seules une chaîne et un buffer sont "
          "découpables.",
          "Slice s[[i TO j]]: only a string or a buffer can be sliced.")

/* --- Indexation tableaux / collections --- */
OWL_ERROR(E_RT_COLLECTION_INDEX_NUMBER, "runtime",
          "L'index de collection doit être un nombre.",
          "Collection index must be a number.")
OWL_ERROR(E_RT_COLLECTION_INDEX_OOB, "runtime",
          "Index de collection {index} hors limites (1..{max}).",
          "Collection index {index} out of bounds (1..{max}).")
OWL_ERROR(E_RT_ASSOC_KEY_STRING_V1, "runtime",
          "La clé d'un tableau associatif doit être une chaîne (v1).",
          "Associative array key must be a string (v1).")
OWL_ERROR(E_RT_INDEX_NEEDS_ARRAY_OR_COMBI, "runtime",
          "Seuls les tableaux ou les combinaisons peuvent être indexés.",
          "Can only index arrays or combinations.")
OWL_ERROR(E_RT_ARRAY_INDEX_NUMBER, "runtime",
          "L'index de tableau doit être un nombre.",
          "Array index must be a number.")
OWL_ERROR(E_RT_ARRAY_INDEX_OOB, "runtime",
          "Index de tableau {index} hors limites (1..{max}).",
          "Array index {index} out of bounds (1..{max}).")
OWL_ERROR(E_RT_ARRAY_INDEX_OOB_MIN, "runtime",
          "Index de tableau {index} hors limites (doit être >= 1).",
          "Array index {index} out of bounds (must be >= 1).")

/* --- Indexation 2D / image --- */
OWL_ERROR(E_RT_IMAGE_INDEX_INT_XY, "runtime",
          "Image[x,y]: x et y doivent être des entiers.",
          "Image[x,y]: x and y must be integers.")
OWL_ERROR(E_RT_2D_INDEX_NEEDS_NESTED_OR_IMAGE, "runtime",
          "[x,y]: 2 indices nécessitent un tableau 2D nested ou une Image.",
          "[x,y]: 2 indices require a 2D nested array or an Image.")
OWL_ERROR(E_RT_2D_TYPE_UNSUPPORTED, "runtime",
          "[x,y]: type non supporté pour 2 indices (attendu : Image ou "
          "tableau 2D).",
          "[x,y]: type not supported for 2 indices "
          "(expected: Image or 2D array).")
OWL_ERROR(E_RT_IMAGE_SET_TYPES, "runtime",
          "Image[x,y] = couleur: x, y, couleur doivent être des entiers.",
          "Image[x,y] = color: x, y, color must be integers.")
OWL_ERROR(E_RT_2D_SET_NEEDS_NESTED_OR_IMAGE, "runtime",
          "[x,y] = val: 2 indices nécessitent un tableau 2D nested ou une Image.",
          "[x,y] = val: 2 indices require a 2D nested array or an Image.")
OWL_ERROR(E_RT_2D_SET_TYPE_UNSUPPORTED, "runtime",
          "[x,y] = val: type non supporté pour 2 indices (attendu : "
          "Image ou tableau 2D).",
          "[x,y] = val: type not supported for 2 indices "
          "(expected: Image or 2D array).")

/* --- Taille / champs / structures --- */
OWL_ERROR(E_RT_LENGTH_NEEDS_ARRAY_OR_COLLECTION, "runtime",
          "Seuls les tableaux ou les collections ont une taille mesurable.",
          "Can only get length of arrays or collections.")
OWL_ERROR(E_RT_FIELDS_NEED_INSTANCE, "runtime",
          "Accès à un champ sur une valeur Null : initialiser "
          "l'instance avant l'accès, ou tester la présence avec _OU_ / "
          "_ET_.",
          "Field access on a Null value: initialize the instance first, or guard the access with the short-circuit forms _OU_ / _ET_ (FR-only).")
OWL_ERROR(E_RT_FIELD_SET_NEEDS_JSON_OBJECT, "runtime",
          "Seuls les objets JSON acceptent l'affectation de champs.",
          "Can only set fields on JSON objects.")
/*  — Modele C : un champ vit dans une instance de fenetre
 * montee. Acces sans Ouvre prealable = erreur soft (pas hard runtime_error
 * pour que le pattern user "Si ErreurDetectee Alors ..." reste fonctionnel). */
OWL_ERROR(E_RT_UI_FIELD_NO_WINDOW_OPEN, "runtime",
          "Champ '{name}' inaccessible : aucune fenêtre ouverte. "
          "Appelle Ouvre(FEN_X) avant d'accéder à ses champs.",
          "Field '{name}' inaccessible: no window open. "
          "Call Ouvre(FEN_X) before accessing its fields.")
OWL_ERROR(E_RT_UI_FIELD_NOT_IN_WINDOW, "runtime",
          "Champ '{name}' n'appartient pas à la fenêtre courante "
          "'{window}'.",
          "Field '{name}' does not belong to the current window '{window}'.")
/*  — DonneFocus vise un champ absent de la fenetre courante. Soft
 * error (pose ErreurDetectee, pas de hard-stop) : le canon affiche une erreur
 * mais le programme peut continuer. */
OWL_ERROR(E_RT_UI_FOCUS_FIELD_UNKNOWN, "runtime",
          "DonneFocus : le champ '{name}' n'existe pas dans la fenêtre "
          "en cours.",
          "SetFocus: control '{name}' does not exist in the current window.")
/*  — acces (lecture/ecriture) a une propriete absente du catalogue
 * du widget via une reference qualifiee non verifiable a la compile
 * (FEN_X.CHP_Y..Prop). Remplace le store fantome silencieux : soft error
 * (pose ErreurDetectee, pas de hard-stop), le programme peut continuer. */
OWL_ERROR(E_RT_UI_PROP_UNKNOWN_FOR_KIND, "runtime",
          "Propriété '{prop}' inconnue pour {kind}.",
          "Property '{prop}' unknown for {kind}.")
/*  — Ferme("nom") avec un nom de fenetre non vide qui ne correspond a
 * aucune fenetre connue. Le 1er argument chaine designe TOUJOURS une fenetre
 * (canon) : pas d'heuristique val-de-retour. Soft error (pose ErreurDetectee,
 * pas de hard-stop) ; la fenetre courante n'est pas fermee (la fenetre visee
 * n'existant pas, l'operation est sans objet). */
OWL_ERROR(E_RT_UI_WINDOW_NOT_FOUND, "runtime",
          "Ferme : aucune fenêtre nommée '{name}'.",
          "Close: no window named '{name}'.")
/*  — acces qualifie exterieur `FEN_X.gVar` alors qu'aucune instance de
 * FEN_X n'est ouverte. Hard error (exit non-zero, meme en mode script) : la
 * variable de fenetre est instance-based, il n'y a pas de valeur a lire tant
 * que la fenetre n'a pas ete ouverte. */
OWL_ERROR(E_RT_WINDOW_NOT_OPEN, "runtime",
          "La fenêtre '{window}' n'est pas ouverte : impossible "
          "d'accéder à sa variable. Ouvrir la fenêtre avant d'y "
          "accéder de l'extérieur.",
          "Window '{window}' is not open: cannot access its variable. Open the "
          "window before accessing it from the outside.")
/*  — MoiMême sans contexte widget actif (stack vide). Soft-error
 * style E_RT_UI_FIELD_NO_WINDOW_OPEN : pose ErreurDetectee, ne hard-stop pas. */
OWL_ERROR(E_RT_MOIMEME_NO_WIDGET, "runtime",
          "MoiMême : aucun champ en cours d'exécution. Utilise "
          "MoiMême depuis un handler d'événement, une fenêtre ou un "
          "état.",
          "MySelf: no control currently executing. "
          "Use MySelf from an event handler, a window or a report.")
/*  — MonChamp sans champ courant (stack vide OU contexte fenetre).
 * STRICT : contrairement a MoiMême, aucun repli fenetre/etat. Soft-error. */
OWL_ERROR(E_RT_MONCHAMP_NO_CONTROL, "runtime",
          "MonChamp : aucun champ en cours d'exécution. Utilise "
          "MonChamp depuis un handler d'événement de champ.",
          "MyControl: no control currently executing. "
          "Use MyControl from a control's event handler.")
/*  — MaFenêtre sans fenetre ouverte (window_stack vide). Soft-error. */
OWL_ERROR(E_RT_MAFENETRE_NO_WINDOW, "runtime",
          "MaFenêtre : aucune fenêtre ouverte. Utilise MaFenêtre "
          "depuis une fenêtre ou un handler d'événement.",
          "MyWindow: no window currently open. "
          "Use MyWindow from a window or an event handler.")
/*  (Table) +  (ZoneRepetee) — lecture cellule hors plage
 * (TBL[ligne].COL / ZR[i].champ avec index < 1 ou > nb lignes). Soft-error
 * (pose ErreurDetectee, pas de hard-stop) : le pattern user
 * "Si ErreurDetectee Alors" reste utilisable, le programme continue, retour
 * = rep vide typee (chaine vide par colonne / sous-controle). Code generique
 * partage Table+ZR : la divergence  vs  est resorbee. */
OWL_ERROR(E_RT_UI_ROW_OOB, "runtime",
          "{control} : ligne {index} hors plage (1..{max}).",
          "{control}: row {index} out of bounds (1..{max}).")
/*  — `TABLE_X[ligne][colonne]` avec un indice de colonne hors plage.
 * Soft-error alignee sur E_RT_UI_ROW_OOB (pose ErreurDetectee, le programme
 * continue, retour Null) : le second indice merite son propre message, sinon
 * l'utilisateur cherche une ligne fautive alors que c'est la colonne. */
OWL_ERROR(E_RT_UI_TABLE_COLUMN_OOB, "runtime",
          "Table : colonne {index} hors plage (1..{max}).",
          "Table: column {index} out of bounds (1..{max}).")
/*  — `SEL_X[i]` / `INT_X[i]` avec un indice d'option hors plage. Le
 * vocabulaire "ligne" de E_RT_UI_ROW_OOB est faux ici : un Selecteur n'a pas
 * de lignes, il a des options. Meme contrat de soft-error (pose ErreurDetectee,
 * le programme continue, retour = option vide typee). {control} porte le kind
 * ET le nom declare : c'est le seul message qui dit lequel des trois selecteurs
 * de la fenetre a deborde. */
OWL_ERROR(E_RT_UI_OPTION_OOB, "runtime",
          "{control} : option {index} hors plage (1..{max}).",
          "{control}: option {index} out of bounds (1..{max}).")
/*  — coche indeterminee (-1) posee sur une option d'Interrupteur qui
 * n'est pas en mode TroisEtats. L'etat indetermine n'existe que si l'option
 * gere trois etats : sans ca, la valeur -1 n'a pas de representation. Soft-error
 * (pose ErreurDetectee, pas de hard-stop) : la coche reste a sa valeur
 * precedente, le programme continue. */
OWL_ERROR(E_RT_UI_OPTION_TRISTATE_REQUIRED, "runtime",
          "{control} : l'état indéterminé (-1) exige que l'option {index} gère "
          "trois états (..TroisÉtats = Vrai). Coche inchangée.",
          "{control}: the indeterminate state (-1) requires option {index} to "
          "support three states (..TriState = True). Checkbox left unchanged.")
/*  — TestSimuleMenu vise une option absente de l'arbre du menu
 * principal affecte a la fenetre. Soft error (pose ErreurDetectee, pas de
 * hard-stop) : le pattern "Si ErreurDetectee Alors" reste utilisable. */
OWL_ERROR(E_RT_UI_MENU_OPTION_UNKNOWN, "runtime",
          "TestSimuleMenu : l'option de menu '{name}' n'existe pas dans "
          "le menu principal de la fenêtre en cours.",
          "TestSimulateMenu: menu option '{name}' does not exist in the current window's main menu.")
/*  — TestSimuleMenu sur une fenetre sans MenuPrincipal affecte.
 * Soft error (pose ErreurDetectee, pas de hard-stop). */
OWL_ERROR(E_RT_UI_WINDOW_NO_MENU, "runtime",
          "TestSimuleMenu : la fenêtre '{window}' n'a pas de menu "
          "principal affecté.",
          "TestSimulateMenu: window '{window}' has no main menu assigned.")
/*  — ecriture de position (..X / ..Y) sur un champ dont la place est
 * calculee par une disposition automatique (pile verticale/horizontale,
 * grille). La position n'est pas reglable a la main : la disposition la
 * recalcule a chaque passe, l'ecriture ne survivrait pas. Soft-error (pose
 * ErreurDetectee, pas de hard-stop) : le champ ne bouge pas. La taille reste,
 * elle, une contrainte reelle et persistante (pas d'erreur). */
OWL_ERROR(E_RT_UI_LAYOUT_POSITION_FIXED, "runtime",
          "Champ '{name}' placé par une disposition automatique : sa position "
          "('{prop}') est calculée par la disposition et ne se règle pas à la "
          "main. Passer le conteneur en disposition libre pour positionner le "
          "champ.",
          "Control '{name}' is placed by an automatic layout: its position "
          "('{prop}') is computed by the layout and cannot be set manually. "
          "Switch the container to free layout to position the control.")
/*  (volet B) — `SEL_X..Options = <valeur>` / `INT_X..Options = ...` avec
 * une valeur qui n'est pas un tableau (typiquement une chaine multi-ligne, quand
 * un `[` en fin de ligne a ouvert une chaine au lieu d'un litteral tableau).
 * Le compilateur ne peut pas l'attraper (affectation de propriete dynamique) ;
 * sans ce message le setter avalait la valeur en silence, laissant les options
 * inchangees. Soft-error (pose ErreurDetectee, pas de hard-stop) : le programme
 * continue et les options existantes sont preservees. Aligne sur le canon
 * "types incompatibles" (une cible tableau exige un tableau). */
OWL_ERROR(E_RT_UI_OPTIONS_NOT_ARRAY, "runtime",
          "{control} : la propriété '{prop}' attend un tableau ; valeur de type "
          "incompatible ignorée. Un littéral tableau tient sur une seule ligne "
          "('[a, b]') — un '[' en fin de ligne ouvre une chaîne multi-lignes.",
          "{control}: property '{prop}' expects an array; incompatible value "
          "type ignored. An array literal fits on a single line ('[a, b]') — "
          "a '[' at end of line opens a multi-line string.")

/* --- Methodes / POO --- */
OWL_ERROR(E_RT_METHOD_NEEDS_CLASS, "runtime",
          "Seules les classes peuvent recevoir des méthodes.",
          "Can only add methods to classes.")
OWL_ERROR(E_RT_ENUM_VALUE_NEEDS_CLASS, "runtime",
          "Valeur d'enum : une classe est attendue sur la pile (erreur interne VM).",
          "OP_ENUM_VALUE: expected class on stack.")
OWL_ERROR(E_RT_STATIC_FIELD_NEEDS_CLASS, "runtime",
          "Champ statique : une classe est attendue sur la pile (erreur interne VM).",
          "OP_STATIC_FIELD: expected class on stack.")
OWL_ERROR(E_RT_ENUM_VALUE_NOT_FOUND, "runtime",
          "Aucun membre de l'énumération '{type}' ne porte la valeur {value}.",
          "No member of enumeration '{type}' has the value {value}.")
OWL_ERROR(E_RT_ENUM_NAME_NOT_FOUND, "runtime",
          "L'énumération '{type}' ne contient aucun membre nommé '{name}'.",
          "Enumeration '{type}' has no member named '{name}'.")
OWL_ERROR(E_RT_ENUM_ARG_NOT_ENUM, "runtime",
          "Le premier argument de '{fn}' doit être un type d'énumération.",
          "The first argument of '{fn}' must be an enumeration type.")
OWL_ERROR(E_RT_MULTI_RETURN_NEEDS_ARRAY, "runtime",
          "Retour multiple : un tableau est attendu.",
          "Multiple return: expected array.")
OWL_ERROR(E_RT_METHOD_BAD_ARITY, "runtime",
          "'{name}' attend {expected} argument(s), reçu {got}.",
          "'{name}' expects {expected} argument(s), got {got}.")
OWL_ERROR(E_RT_UNDEFINED_STATIC_METHOD, "runtime",
          "Méthode statique inconnue '{method}' sur la classe '{class}'.",
          "Undefined static method '{method}' on class '{class}'.")
OWL_ERROR(E_RT_NO_METHOD_FOR_TYPE, "runtime",
          "Ce type ne porte aucune méthode '{method}'.",
          "No method '{method}' for this type.")
/*  — `FEN_X.maProc()` n'est pas une forme d'appel prise en charge.
 * Le message générique orientait vers un problème de type alors que le
 * receveur est une fenêtre parfaitement valide : c'est la forme qui n'existe
 * pas. Les deux formes réellement supportées sont nommées ici. */
OWL_ERROR(E_RT_WINDOW_DOT_CALL_UNSUPPORTED, "runtime",
          "Appeler une procédure sur une fenêtre par '{window}.{method}()' "
          "n'est pas une forme prise en charge. Appeler '{method}()' "
          "directement ; le point double reste réservé aux propriétés "
          "('{window}..Titre').",
          "Calling a procedure on a window with '{window}.{method}()' is not "
          "a supported form. Call '{method}()' directly; the double dot "
          "remains reserved for properties ('{window}..Title').")
OWL_ERROR(E_RT_INSTANCE_NO_CLASS_FOR_METHOD, "runtime",
          "Instance has no class for method '{method}'.",
          "Instance has no class for method '{method}'.")
OWL_ERROR(E_RT_UNDEFINED_METHOD, "runtime",
          "Méthode inconnue '{method}'.",
          "Undefined method '{method}'.")
OWL_ERROR(E_RT_SUPERCLASS_NEEDS_CLASS, "runtime",
          "La super-classe doit être une classe.",
          "Superclass must be a class.")
OWL_ERROR(E_RT_SUBCLASS_NEEDS_CLASS, "runtime",
