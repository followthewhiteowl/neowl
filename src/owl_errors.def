          "Unterminated string interpolation [%...%].")
OWL_ERROR(E_SYNTAX_BRACE_LITERAL_NO_TYPE, "syntax",
          "Littéral { ... } sans type cible. Ajoute le type à gauche "
          "(var est un T = {...}) ou utilise dans une prop typée (Cadre "
          "= {...} dans PROPRIETES).",
          "{ ... } literal without target type. Add the type on the "
          "left (var est un T = {...}) or use within a typed property "
          "(Cadre = {...} in PROPERTIES).")
/* Fallback des trois formes de `{ ... }` : aucune n'est reconnaissable, on
 * les enonce plutot que de ne parler que de l'indirection (forme sur
 * laquelle le parseur retombe). Cas typique : separateur oublie entre la
 * cle et la valeur d'un litteral multilingue. */
OWL_ERROR(E_SYNTAX_BRACE_BLOCK_MALFORMED, "syntax",
          "Bloc { ... } mal formé : attendu '}' pour une indirection "
          "{ nom }, ':' pour une chaîne multilingue { clé: valeur, ... } "
          "ou '=' pour un littéral de type composé { Champ = valeur, ... }.",
          "Malformed { ... } block: expected '}' for an indirection "
          "{ name }, ':' for a multilingual string { key: value, ... } "
          "or '=' for a composite type literal { Field = value, ... }.")
OWL_ERROR(E_SYNTAX_EXPECTED_FIELD_NAME_IN_BRACE, "syntax",
          "Nom de field attendu dans { ... }.",
          "Expected field name in { ... }.")
OWL_ERROR(E_SYNTAX_EXPECTED_EQUAL_AFTER_FIELD, "syntax",
          "'=' attendu après le nom de field.",
          "Expected '=' after field name.")
