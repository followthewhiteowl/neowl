          "PROCEDURE block '{name}' already declared for this window.")
/* DSL de service HTTP — blocs ServiceREST / OpérationHTTP. */
OWL_ERROR(E_SEM_DSL_SERVICE_PROP_UNKNOWN, "semantic",
          "Propriété '{prop}' inconnue pour ServiceREST.",
          "Property '{prop}' unknown for ServiceREST.")
OWL_ERROR(E_SEM_DSL_OPERATION_PROP_UNKNOWN, "semantic",
          "Propriété '{prop}' inconnue pour OpérationHTTP.",
          "Property '{prop}' unknown for OperationHTTP.")
OWL_ERROR(E_SEM_DSL_SERVICE_METHOD_INVALID, "semantic",
          "'{value}' n'est pas une méthode HTTP valide.",
          "'{value}' is not a valid HTTP method.")
OWL_ERROR(E_SEM_DSL_SERVICE_AUTH_INVALID, "semantic",
          "'{value}' n'est pas un schéma d'authentification valide.",
          "'{value}' is not a valid authentication scheme.")
OWL_ERROR(E_SEM_DSL_SERVICE_HOOK_ARITE, "semantic",
          "Le crochet de service '{hook}' ne prend aucun paramètre : il "
          "s'exécute dans le contexte de l'échange (MoiMême), pas avec des "
          "arguments. Retirer la liste de paramètres.",
          "The service hook '{hook}' takes no parameters: it runs in the "
          "exchange context (MySelf), not with arguments. Remove the "
          "parameter list.")
OWL_ERROR(E_SEM_DSL_SERVICE_JWT_HOOK_INTERDIT, "semantic",
          "Le schéma httpAuthJWT valide les jetons de façon déclarative : "
          "un crochet surAuthentification est contradictoire. Retirer l'un des "
          "deux.",
          "The httpAuthJWT scheme validates tokens declaratively: an "
          "surAuthentification hook is contradictory. Remove either one.")
OWL_ERROR(E_SEM_DSL_SERVICE_JWKS_CLE_EXCLUSIVE, "semantic",
          "URLJWKS récupère les clés de vérification à distance ; "
          "ClePubliqueJWT fixe une clé statique. Les deux à la fois sont "
          "contradictoires. Ne garder que l'un des deux.",
          "URLJWKS fetches verification keys remotely; ClePubliqueJWT pins a "
          "static key. Both at once are contradictory. Keep only one.")
OWL_ERROR(E_SEM_DSL_SERVICE_JWKS_HTTP_INTERDIT, "semantic",
          "URLJWKS en http:// n'est autorisée que vers une adresse locale "
          "(127.0.0.1, localhost, ::1) : un endpoint distant doit être en "
          "https:// pour que la clé de vérification arrive chiffrée et "
          "authentifiée.",
          "URLJWKS over http:// is only allowed to a local address "
          "(127.0.0.1, localhost, ::1): a remote endpoint must use https:// so "
          "the verification key arrives encrypted and authenticated.")
OWL_ERROR(E_SEM_DSL_SERVICE_CODE_NOT_IN_RESPONSES, "semantic",
          "Le code d'état '{value}' de CodeÉtat ne figure pas dans les "
          "Réponses déclarées de l'opération.",
          "Status code '{value}' in CodeEtat is not among the operation's "
          "declared Responses.")
OWL_ERROR(E_SEM_DSL_SERVICE_PATH_SEGMENT_INVALID, "semantic",
          "Segment de chemin invalide « {segment} » : un segment doit être "
          "non vide et ne contenir ni « / » ni caractère réservé d'URL.",
          "Invalid path segment '{segment}': a segment must be non-empty and "
          "contain neither '/' nor a reserved URL character.")
OWL_ERROR(E_SEM_DSL_SERVICE_BLOCK_DUPLICATE, "semantic",
          "Service '{name}' déjà déclaré.",
          "Service '{name}' already declared.")
OWL_ERROR(E_SEM_DSL_OPERATION_NAME_DUPLICATE, "semantic",
          "Opération '{name}' déjà déclarée dans ce service.",
          "Operation '{name}' already declared in this service.")
OWL_ERROR(E_SEM_DSL_SERVICE_ROUTE_CONFLICT, "semantic",
          "Les routes des opérations '{a}' et '{b}' sont en conflit : la "
          "requête {example} correspond aux deux sans qu'aucune ne soit plus "
          "spécifique.",
          "The routes of operations '{a}' and '{b}' conflict: the request "
          "{example} matches both without either being more specific.")
OWL_ERROR(E_SEM_DSL_SERVICE_PATH_PARAM_UNBOUND, "semantic",
          "Le paramètre de chemin '{param}' de l'opération '{op}' n'a pas de "
          "paramètre correspondant dans la signature de surRequête.",
          "Path parameter '{param}' of operation '{op}' has no matching "
          "parameter in the surRequete signature.")
OWL_ERROR(E_SEM_DSL_SERVICE_BINDING_SCALAR_NO_SOURCE, "semantic",
          "Le paramètre scalaire '{param}' de l'opération '{op}' n'est déclaré "
          "ni dans Chemin ni dans Requête : aucune source de liaison connue.",
          "Scalar parameter '{param}' of operation '{op}' is declared neither "
          "in Chemin nor in Requete: no known binding source.")
OWL_ERROR(E_SEM_DSL_SERVICE_BINDING_MULTIPLE_BODIES, "semantic",
          "Les paramètres '{a}' et '{b}' de l'opération '{op}' sont deux "
          "candidats au corps de la requête : un seul corps est possible.",
          "Parameters '{a}' and '{b}' of operation '{op}' are both request "
          "body candidates: only one body is allowed.")
OWL_ERROR(E_SEM_DSL_SERVICE_BINDING_MULTIPLE_SOURCES, "semantic",
          "Le paramètre '{param}' de l'opération '{op}' est lié à plusieurs "
          "sources (Chemin et Requête) : un paramètre doit avoir exactement une source.",
          "Parameter '{param}' of operation '{op}' is bound to multiple "
          "sources (path and query): a parameter must have exactly one source.")
OWL_ERROR(E_SEM_DSL_SERVICE_MULTIPART_WITHOUT_FILE, "semantic",
          "L'opération '{op}' déclare ContentType = typeMimeFormulaireMultiPartie "
          "mais aucun paramètre FichierTéléversé n'est présent dans surRequête : "
          "un formulaire multipart doit recevoir au moins un fichier.",
          "Operation '{op}' declares ContentType = typeMimeFormulaireMultiPartie "
          "but no UploadedFile parameter is present in surRequete: a multipart "
          "form must receive at least one file.")
OWL_ERROR(E_SEM_DSL_SERVICE_FILE_WITHOUT_MULTIPART, "semantic",
          "L'opération '{op}' reçoit un paramètre FichierTéléversé mais ne "
          "déclare pas ContentType = typeMimeFormulaireMultiPartie : les deux "
          "sont requis ensemble.",
          "Operation '{op}' receives an UploadedFile parameter but does not "
          "declare ContentType = typeMimeFormulaireMultiPartie: both are "
          "required together.")
OWL_ERROR(E_SEM_DSL_SERVICE_FILE_WITH_BODY, "semantic",
          "L'opération '{op}' ne peut pas combiner un paramètre FichierTéléversé "
          "avec un corps de requête structuré : un formulaire multipart et un "
          "corps JSON sont mutuellement exclusifs.",
          "Operation '{op}' cannot combine an UploadedFile parameter with a "
          "structured request body: a multipart form and a JSON body are "
          "mutually exclusive.")
OWL_ERROR(E_SEM_DSL_SERVICE_WILDCARD_NOT_LAST, "semantic",
          "Le segment catch-all glouton du Chemin de l'opération '{op}' doit "
          "être en dernière position : un catch-all capture tous les segments "
          "finaux, aucun segment ne peut le suivre.",
          "The greedy catch-all segment in the path of operation '{op}' must "
          "be in last position: a catch-all captures every trailing segment, "
          "so no segment may follow it.")
OWL_ERROR(E_SEM_DSL_SERVICE_WILDCARD_MULTIPLE, "semantic",
          "Le Chemin de l'opération '{op}' déclare plusieurs segments catch-all "
          "gloutons : un seul est autorisé, en dernière position.",
          "The path of operation '{op}' declares several greedy catch-all "
          "segments: only one is allowed, in last position.")
OWL_ERROR(E_SEM_DSL_SERVICE_FLUX_WITH_MULTIPART, "semantic",
          "L'opération '{op}' ne peut pas combiner Flux (diffusion progressive "
          "de la réponse) avec ContentType = typeMimeFormulaireMultiPartie "
          "(réception d'un formulaire multipart) : les deux modes sont "
          "incompatibles.",
          "Operation '{op}' cannot combine Flux (progressive response streaming) "
          "with ContentType = typeMimeFormulaireMultiPartie (multipart form "
          "reception): the two modes are incompatible.")
OWL_ERROR(E_SEM_DSL_SERVICE_DELAIMAX_INVALID, "semantic",
          "DélaiMax est une borne en secondes, positive ou nulle (0 = illimité). "
          "Une valeur négative n'a pas de sens.",
          "DelaiMax is a limit in seconds, positive or zero (0 = unlimited). A "
          "negative value is meaningless.")
OWL_ERROR(E_SEM_SERVICE_FILE_ONLY_BLOCK_BEFORE, "semantic",
          "Un fichier-service ne peut contenir que le bloc ServiceREST. "
          "Déplacer cette instruction DANS le bloc ServiceREST (c'est là que "
          "vivent les déclarations et les opérations du service).",
          "A service file may only contain the ServiceREST block. Move this "
          "statement INTO the ServiceREST block (that is where the service's "
          "declarations and operations live).")
OWL_ERROR(E_SEM_SERVICE_FILE_ONLY_BLOCK_AFTER, "semantic",
          "Un fichier-service ne peut contenir que le bloc ServiceREST. "
          "Déplacer cette instruction DANS le bloc ServiceREST, avant son FIN "
          "final (c'est là que vivent les déclarations et les opérations du "
          "service).",
          "A service file may only contain the ServiceREST block. Move this "
          "statement INTO the ServiceREST block, before its final END (that is "
          "where the service's declarations and operations live).")
OWL_ERROR(E_SEM_SERVICE_DUPLICATE_IN_FILE, "semantic",
          "Convention OWL : un fichier ne peut déclarer qu'un seul "
          "ServiceREST. Place chaque service dans son propre fichier .owl.",
          "OWL convention: a file can only declare one ServiceREST. Place "
          "each service in its own .owl file.")
OWL_ERROR(E_SEM_DSL_INITIALISATION_OBSOLETE, "semantic",
          "Bloc 'Initialisation' obsolète : placez le code "
          "d'initialisation directement dans le corps de l'élément.",
          "Obsolete 'Initialization' block: place the initialization "
          "code directly in the element body.")
/*  — les parametres de fenetre passaient autrefois par une PROCEDURE
 * portant le nom de la fenetre. Forme morte : la declaration sur la premiere
 * ligne `FEN_X est une Fenetre(p est un type)` est desormais la seule forme. */
OWL_ERROR(E_SEM_DSL_WINDOW_PARAMS_VIA_PROC, "semantic",
          "Déclaration de paramètres de fenêtre obsolète : une PROCEDURE "
          "nommée comme la fenêtre '{name}' n'est plus acceptée. Déclarer "
          "les paramètres sur la première ligne de la fenêtre.",
          "Obsolete window parameter declaration: a PROCEDURE named after "
          "the window '{name}' is no longer accepted. Declare the "
          "parameters on the window's first line.")
OWL_ERROR(E_SEM_DSL_NESTED_WINDOW_NOT_SUPPORTED, "semantic",
          "Fenêtre imbriquée non supportée à ce jour. Déclarer la "
          "fenêtre au niveau top-level (hors de toute autre Fenêtre).",
          "Nested window not supported yet. Declare the window at "
          "top-level (outside any other Window).")
OWL_ERROR(E_SEM_DSL_TYPE_REJECTED_IN_WINDOW, "semantic",
          "Une {type} ne peut pas être déclarée dans le corps d'une "
          "fenêtre. Déclarer au top-level (fichier séparé ou collection "
          "de procédures globales).",
          "A {type} cannot be declared inside a window body. Declare "
          "at top-level (separate file or global procedure collection).")
OWL_ERROR(E_SEM_DSL_UNKNOWN_WIDGET_TYPE, "semantic",
          "Type de champ inconnu '{name}'. Vérifier l'orthographe du type "
          "de widget (Libellé, Bouton, Saisie, Image, Conteneur, Table…).",
          "Unknown field type '{name}'. Check the widget type spelling "
          "(Label, Button, Input, Image, Container, Table…).")
OWL_ERROR(E_SEM_DSL_PROPRIETES_BLOCK_MISSING_CONTROL, "semantic",
          "Bloc PROPRIETES manquant pour le champ '{name}' (DSL v2 : "
          "'PROPRIETES ... FIN' obligatoire dans chaque widget).",
          "Missing PROPERTIES block for control '{name}' (DSL v2: "
          "'PROPERTIES ... END' is mandatory in every widget).")
OWL_ERROR(E_SEM_DSL_PROPRIETES_BLOCK_MISSING_WINDOW, "semantic",
          "Bloc PROPRIETES manquant pour la fenêtre '{name}' (DSL v2 : "
          "'PROPRIETES ... FIN' obligatoire).",
          "Missing PROPERTIES block for window '{name}' (DSL v2: "
          "'PROPERTIES ... END' is mandatory).")
OWL_ERROR(E_SEM_DSL_CHAMP_PREFIXE_REQUIS, "semantic",
          "Contrôle '{name}' déclaré sans préfixe 'Champ'. Écrire "
          "'{name} est un Champ {genre} ... FIN'.",
          "Control '{name}' declared without the 'Control' prefix. Write "
          "'{name} is a Control {genre} ... END'.")
OWL_ERROR(E_SEM_DSL_FILE_WINDOW_AND_CLASS, "semantic",
          "Convention OWL : un fichier ne peut pas contenir une Fenêtre "
          "et une Classe. Classe '{name}' déjà déclarée ligne {line}. "
          "Place la Fenêtre dans son propre fichier .owl.",
          "OWL convention: a file cannot contain a Window and a Class. "
          "Class '{name}' already declared on line {line}. Place the "
          "Window in its own .owl file.")
OWL_ERROR(E_SEM_DSL_XY_FORBIDDEN_NOT_LIBRE, "semantic",
          "'{name}' : prop X/Y interdite — {parent} n'est pas en "
          "Disposition = dispLibre. Utilise Étire/Marge/Alignement, ou "
          "pose 'Disposition = dispLibre' sur le parent pour conserver "
          "le positionnement absolu.",
          "'{name}': prop X/Y forbidden — {parent} is not in "
          "Layout = dispFree. Use Stretch/Margin/Alignment, or set "
          "'Layout = dispFree' on the parent to preserve absolute "
          "positioning.")
OWL_ERROR(E_SEM_DSL_INLINE_DICT_NOT_MULTILINGUE, "semantic",
          "Littéral inline dict réservé aux slots de type chaîneMultilingue "
          "(slot '{prop}' est typé {type}).",
          "Inline dict literal reserved for multilingualString slots "
          "(slot '{prop}' is typed {type}).")

/* ================================================================
 * SEMANTIC — Etat + reste compiler ( paquet 5)
 *
 * DSL Etat (sub-blocs, props, sub-controls) + sites compiler restants :
 * enum arg unknown, POUR re-eval bornes/pas, QUAND EXCEPTION clauses,
 * statement-level (mot-cle réservé, fonction sans parenthèses, fichier
 * classe pollue, ENFIN gate, RETOUR=val non supporte).
 * ================================================================ */
OWL_ERROR(E_SEM_ENUM_ARG_UNKNOWN, "semantic",
          "L'élément '{arg}' est inconnu ou inaccessible dans ce "
          "contexte. Attendu : un membre de {enumName} ({sample}).",
          "Element '{arg}' is unknown or unavailable in this context. "
          "Expected: a member of {enumName} ({sample}).")
OWL_ERROR(E_SEM_AWS_ACTION_UNKNOWN, "semantic",
          "Symbole d'action AWS '{arg}' inconnu. Attendu : un symbole "
          "aws<Service><Action> connu ({sample}), une chaîne littérale, "
          "ou une variable.",
          "Unknown AWS action symbol '{arg}'. Expected: a known "
          "aws<Service><Action> symbol ({sample}), a string literal, "
          "or a variable.")
OWL_ERROR(E_SEM_FOR_BOUND_REEVAL_TOO_LARGE, "semantic",
          "Borne 'À' (re-évaluation) trop volumineuse : utilisez "
          "'_À_' (évaluation unique) ou stockez la borne dans une "
          "variable locale.",
          "Bound 'TO' (re-evaluation) too large: use '_TO_' (single "
          "evaluation) or store the bound in a local variable.")
OWL_ERROR(E_SEM_FOR_BOUND_REEVAL_COMPLEX, "semantic",
          "Borne 'À' (re-évaluation) complexe non supportée : "
          "utilisez '_À_' (évaluation unique) ou stockez la borne dans "
          "une variable locale.",
          "Bound 'TO' (re-evaluation) complex form not supported: use "
          "'_TO_' (single evaluation) or store the bound in a local "
          "variable.")
OWL_ERROR(E_SEM_FOR_DEPUISFIN_PAS_MUTEX, "semantic",
          "DepuisFin et PAS sont mutuellement exclusifs. Soit "
          "'DepuisFin' (step -1 implicite), soit 'PAS <expr>' explicite.",
          "DepuisFin and STEP are mutually exclusive. Either 'DepuisFin' "
          "(implicit -1 step) or explicit 'STEP <expr>'.")
OWL_ERROR(E_SEM_FOR_STEP_REEVAL_TOO_LARGE, "semantic",
          "Pas 'PAS' (re-évaluation) trop volumineux : utilisez '_PAS_' "
          "(évaluation unique) ou stockez le pas dans une variable "
          "locale.",
          "Step 'STEP' (re-evaluation) too large: use '_STEP_' (single "
          "evaluation) or store the step in a local variable.")
OWL_ERROR(E_SEM_FOR_STEP_REEVAL_COMPLEX, "semantic",
          "Pas 'PAS' (re-évaluation) complexe non supporté : utilisez "
          "'_PAS_' (évaluation unique) ou stockez le pas dans une "
          "variable locale.",
          "Step 'STEP' (re-evaluation) complex form not supported: use "
          "'_STEP_' (single evaluation) or store the step in a local "
          "variable.")
OWL_ERROR(E_SYNTAX_EXCEPTION_FAIRE_ORDER, "syntax",
          "'FAIRE' doit précéder 'SINON' et 'ENFIN'. Ordre attendu : "
          "DANS -> FAIRE -> SINON -> ENFIN -> FIN.",
          "'DO' must precede 'ELSE' and 'FINALLY'. Expected order: "
          "IN -> DO -> ELSE -> FINALLY -> END.")
OWL_ERROR(E_SYNTAX_EXCEPTION_DUPLICATE_ENFIN, "syntax",
          "'ENFIN' déjà déclaré pour ce bloc 'QUAND EXCEPTION DANS' "
          "(un seul 'ENFIN' autorisé).",
          "'FINALLY' already declared for this 'WHEN EXCEPTION IN' "
          "block (only one 'FINALLY' allowed).")
OWL_ERROR(E_SYNTAX_EXCEPTION_SINON_AFTER_ENFIN, "syntax",
          "'SINON' doit précéder 'ENFIN'. Ordre attendu : "
          "DANS -> FAIRE -> SINON -> ENFIN -> FIN.",
          "'ELSE' must precede 'FINALLY'. Expected order: "
          "IN -> DO -> ELSE -> FINALLY -> END.")
OWL_ERROR(E_SYNTAX_EXCEPTION_ENFIN_NOT_IN_GENERAL_FORM, "syntax",
          "'ENFIN' n'est pas autorisé dans la forme générale "
          "'QUAND EXCEPTION'. Utiliser la forme spécifique "
          "'QUAND EXCEPTION DANS ... ENFIN ... FIN' pour un cleanup "
          "garanti.",
          "'FINALLY' is not allowed in the general 'WHEN EXCEPTION' "
          "form. Use the specific form 'WHEN EXCEPTION IN ... FINALLY "
          "... END' for guaranteed cleanup.")
OWL_ERROR(E_SEM_ETAT_CONTROL_PROPRIETES_MISSING, "semantic",
          "Bloc PROPRIETES manquant pour le Champ {genre} '{name}' (DSL "
          "v2 : 'PROPRIETES ... FIN' obligatoire dans chaque Champ d'État).",
          "Missing PROPERTIES block for Control {genre} '{name}' (DSL v2: "
          "'PROPERTIES ... END' is mandatory in every Report Control).")
OWL_ERROR(E_SEM_ETAT_PROP_UNKNOWN_BLOCK, "semantic",
          "Propriété '{prop}' inconnue pour un bloc d'État. Attendu : "
          "Hauteur.",
          "Property '{prop}' unknown for a Report block. Expected: "
          "Height.")
OWL_ERROR(E_SEM_ETAT_PROP_UNKNOWN_TOPLEVEL, "semantic",
          "Propriété '{prop}' inconnue pour État. Attendu : Format, "
          "Orientation, MargeHaut, MargeBas, MargeGauche, MargeDroite.",
          "Property '{prop}' unknown for Report. Expected: Format, "
          "Orientation, TopMargin, BottomMargin, LeftMargin, "
          "RightMargin.")
OWL_ERROR(E_SEM_ETAT_BLOCK_KIND_UNKNOWN, "semantic",
          "Type de bloc État inconnu : '{kind}'. Attendu : "
          "EnTêteDocument, HautDePage, Corps, BasDePage, FinDeDocument, "
          "Itération.",
          "Report block type unknown: '{kind}'. Expected: "
          "DocumentHeader, PageHeader, Body, PageFooter, DocumentFooter, "
          "Iteration.")
OWL_ERROR(E_SEM_ETAT_BLOCK_CANON_DUPLICATE, "semantic",
          "Bloc canon '{kind}' déjà déclaré pour cet État. Un seul "
          "autorisé.",
          "Canon block '{kind}' already declared for this Report. Only "
          "one allowed.")
OWL_ERROR(E_SEM_ETAT_BLOCK_NAME_DUPLICATE, "semantic",
          "Bloc nommé '{name}' déjà déclaré. Chaque bloc doit avoir un "
          "nom unique.",
          "Named block '{name}' already declared. Each block must have "
          "a unique name.")
OWL_ERROR(E_SEM_ETAT_FILE_AND_CLASS, "semantic",
          "Convention OWL : un fichier ne peut pas contenir un État et "
          "une Classe. Classe '{name}' déjà déclarée ligne {line}. "
          "Place l'État dans son propre fichier .owl.",
          "OWL convention: a file cannot contain a Report and a Class. "
          "Class '{name}' already declared on line {line}. Place the "
          "Report in its own .owl file.")
OWL_ERROR(E_SEM_ETAT_FILE_AND_WINDOW, "semantic",
          "Un fichier ne peut pas contenir à la fois un État et une "
          "Fenêtre. Fenêtre déjà déclarée ligne {line}. Place les "
          "Fenêtres et les États dans des fichiers séparés.",
          "A file cannot contain both a Report and a Window. Window "
          "already declared on line {line}. Place Windows and Reports "
          "in separate files.")
OWL_ERROR(E_SEM_ETAT_BODY_NEEDS_CORPS, "semantic",
          "L'État '{name}' doit obligatoirement contenir un bloc Corps "
          "(<nom> est un Corps ... FIN). C'est le seul bloc qui ne peut "
          "être supprimé.",
          "Report '{name}' must contain a Body block (<name> is a "
          "Body ... END). This is the only block that cannot be "
          "removed.")
OWL_ERROR(E_SEM_ETAT_PROCEDURE_DUPLICATE, "semantic",
          "PROCEDURE '{name}' déjà déclarée pour cet État. Une seule "
          "par État.",
          "PROCEDURE '{name}' already declared for this Report. Only "
          "one per Report.")
OWL_ERROR(E_SEM_ETAT_PROC_HELPER_NOT_TOPLEVEL, "semantic",
          "La procédure '{name}' ne peut être déclarée qu'au niveau de "
          "l'État, avant les blocs et contrôles. La déplacer au niveau "
          "supérieur.",
          "Procedure '{name}' can only be declared at the Report level, "
          "before blocks and controls. Move it up to the top level.")
OWL_ERROR(E_SEM_DSL_PROC_HELPER_NOT_TOPLEVEL, "semantic",
          "La procédure '{name}' ne peut être déclarée qu'au niveau de "
          "la Fenêtre, avant les contrôles. La déplacer au niveau "
          "supérieur.",
          "Procedure '{name}' can only be declared at the Window level, "
          "before the controls. Move it up to the top level.")
OWL_ERROR(E_SYNTAX_ETAT_PROPRIETES_EXPECTED_PROP_NAME, "syntax",
          "Dans PROPRIETES État : attendu nom de propriété (ex: Format "
          "= ...).",
          "In Report PROPERTIES: expected property name (e.g., Format = "
          "...).")
OWL_ERROR(E_SEM_STRUCT_SELF_RECURSION, "semantic",
          "Une structure ne peut pas avoir un membre de son propre "
          "type '{type}'. Utilisez une CLASSE (type référence) pour "
          "les listes chaînées / arbres, ou un tableau de {type}.",
          "A structure cannot have a member of its own type '{type}'. "
          "Use a CLASSE (reference type) for linked lists / trees, or "
          "an array of {type}.")
OWL_ERROR(E_SEM_ENFIN_FORBIDDEN_STATEMENT, "semantic",
          "'{keyword}' n'est pas autorisé à l'intérieur d'un bloc "
          "'ENFIN' (FINALLY). Le cleanup ne doit pas interrompre le "
          "flot.",
          "'{keyword}' is not allowed inside a 'FINALLY' block. "
          "Cleanup must not interrupt the flow.")
OWL_ERROR(E_SYNTAX_ENFIN_ORPHAN, "syntax",
          "'ENFIN' n'est valide qu'à l'intérieur d'un bloc 'QUAND "
          "EXCEPTION DANS ... FIN'.",
          "'FINALLY' is only valid inside a 'WHEN EXCEPTION IN ... "
          "END' block.")
OWL_ERROR(E_SYNTAX_TABLEAU_GENERIC_BRACKET, "syntax",
          "Syntaxe générique 'tableau<T>' non supportée. Utiliser "
          "'tableau de <T>' (ex. 'tableau d'entiers').",
          "Generic syntax 'array<T>' is not supported. Use 'array "
          "of <T>' (e.g. 'array of integers').")
/*  — la forme parenthesee etait avalee sans etre lue : l'utilisateur
 * croyait typer sa collection, il obtenait un tableau non type. Refus explicite
 * tant que les options ne sont pas implementees (feature a part). */
OWL_ERROR(E_SYNTAX_ASSOC_ARRAY_PAREN_UNSUPPORTED, "syntax",
          "La forme parenthésée du tableau associatif n'est pas supportée. "
          "Le type des valeurs se déclare avec 'tableau associatif de "
          "<type>' (ex. 'tableau associatif de entiers') ; sans cette "
          "liaison, les valeurs sont hétérogènes. La clé est une chaîne.",
          "The parenthesized form of the associative array is not "
          "supported. The value type is declared with 'associative array of "
          "<type>' (e.g. 'associative array of integers'); without that "
          "binding, values are heterogeneous. The key is a string.")
OWL_ERROR(E_SYNTAX_TABLEAU_INIT_MULTILIGNE, "syntax",
          "Un tableau ne peut pas être initialisé par une chaîne "
          "multi-lignes. Un littéral tableau tient sur une seule "
          "ligne : '[a, b]'. Ici un '[' en fin de ligne a ouvert une "
          "chaîne multi-lignes (fermée par une ligne commençant par "
          "']'), qui a absorbé le code suivant. Mettre les éléments "
          "sur une seule ligne, ou pour une chaîne brute multi-lignes "
          "utiliser une variable de type 'chaîne' (ou des accents "
          "graves `...` avec interpolation).",
          "An array cannot be initialized from a multiline string. An "
          "array literal fits on a single line: '[a, b]'. Here a '[' at "
          "end of line opened a multiline string (closed by a line "
          "starting with ']'), which swallowed the following code. Put "
          "the elements on a single line, or for a raw multiline string "
          "use a 'string' variable (or backticks `...` with "
          "interpolation).")
OWL_ERROR(E_SEM_RETURN_ASSIGN_NOT_SUPPORTED, "semantic",
          "'{keyword} = <valeur>' (assignation différée) non supporté. "
          "Substitut : déclarer une variable locale et faire "
          "'{keyword} <var>' à la sortie.",
          "'{keyword} = <value>' (deferred assignment) not supported. "
          "Substitute: declare a local variable and do '{keyword} "
          "<var>' at exit.")
OWL_ERROR(E_SEM_KEYWORD_AS_VAR_NAME, "semantic",
          "Le mot '{name}' est un mot-clé réservé du langage et ne "
          "peut pas être utilisé comme nom de variable.",
          "The word '{name}' is a reserved language keyword and cannot "
          "be used as a variable name.")
/*  — un tiret dans un nom d'element DSL (Classe/Fenetre/Etat/...) est
 * decoupe par le scanner en IDENT '-' IDENT (le '-' EST l'operateur moins).
 * Sans detection dediee, `cl-Tot est une Classe` part en chemin expression et
 * produit une cascade cryptique. On pointe le nom fautif et on oriente vers
 * l'underscore. */
OWL_ERROR(E_SEM_INVALID_ELEMENT_NAME, "semantic",
          "Nom d'élément invalide '{name}' : le tiret n'est pas "
          "autorisé dans un nom (utiliser '_' à la place).",
          "Invalid element name '{name}': hyphen is not allowed in a "
          "name (use '_' instead).")
OWL_ERROR(E_SEM_BARE_NATIVE_REFERENCE, "semantic",
          "'{name}' est une fonction — ajoute () pour l'appeler, ou "
          "passe-la en argument. Une référence isolée ne fait rien.",
          "'{name}' is a function — add () to call it, or pass it as "
          "an argument. An isolated reference does nothing.")
OWL_ERROR(E_SEM_CLASS_FILE_TOPLEVEL_CODE, "semantic",
          "Convention OWL : un fichier classe ne peut pas contenir de "
          "code runtime top-level. Classe '{name}' déclarée ligne "
          "{line}. Un fichier classe ne contient que la Classe "
          "(déclaration + méthodes inline dans le corps) + commentaires.",
          "OWL convention: a class file cannot contain top-level "
          "runtime code. Class '{name}' declared on line {line}. A "
          "class file only contains the Class (declaration + inline "
          "methods in the body) + comments.")
/*  +  — verrou DSL strict "1 fichier = 1 Fenetre/Etat" :
 * aucun code top-level hors du bloc Fenetre/Etat n'est autorise dans un
 * fichier-fenetre/-etat. Les helpers (PROCEDURE, FONCTION, CONSTANTE,
 * variables) vivent DANS le bloc, au top-level du bloc (hors widget) —
 * meme scope que `PROCEDURE FinInitialisation()`. */
OWL_ERROR(E_SEM_DSL_FENETRE_TOPLEVEL_INTERDIT, "semantic",
          "Un fichier-fenêtre ne peut contenir que le bloc Fenêtre. "
          "Déplacer cette déclaration DANS le bloc Fenêtre, au top-level "
          "(hors widget), comme un PROCEDURE FinInitialisation(). Pour "
          "partager du code entre fichiers, utiliser une classe ou un "
          "fichier voisin dédié.",
          "A window file can only contain the Window block. Move this "
          "declaration INSIDE the Window block, at the block top-level "
          "(outside any widget), like PROCEDURE EndInitialization(). To "
          "share code across files, use a class or a dedicated neighbor "
          "file.")
OWL_ERROR(E_SEM_DSL_ETAT_TOPLEVEL_INTERDIT, "semantic",
          "Un fichier-état ne peut contenir que le bloc État. "
          "Déplacer cette déclaration DANS le bloc État, au top-level "
          "(hors bande/colonne). Pour partager du code entre fichiers, "
          "utiliser une classe ou un fichier voisin dédié.",
          "A report file can only contain the Report block. Move this "
          "declaration INSIDE the Report block, at the block top-level "
          "(outside any band/column). To share code across files, use a "
          "class or a dedicated neighbor file.")
/*  — anti-cascade. Quand des declarations qui devraient vivre DANS
 * le bloc (widgets, bandes) retombent au top-level apres desynchronisation,
 * la cause reelle est presque toujours un bloc ferme trop tot. On pointe la
 * ligne d'OUVERTURE du bloc (pas le token courant, dont la ligne serait
 * trompeuse) et on invite a verifier l'equilibre des FIN. */
OWL_ERROR(E_SEM_DSL_WINDOW_CLOSED_EARLY, "semantic",
          "Bloc probablement fermé trop tôt (ouvert ligne {line}) : des "
          "déclarations qui devraient être à l'intérieur retombent hors du "
          "bloc. Vérifier l'équilibre des FIN à partir de la ligne {line}.",
          "Block likely closed too early (opened on line {line}): "
          "declarations that should be inside fall outside the block. "
          "Check the balance of END starting from line {line}.")
/*  — note agregee : remplace le flood DSL-toplevel par un compteur
 * du surplus, sans le supprimer (l'utilisateur garde l'info sans le bruit). */
OWL_ERROR(E_SEM_DSL_TOPLEVEL_CASCADE_NOTE, "semantic",
          "+ {count} autre(s) déclaration(s) hors bloc — cause probable : "
          "bloc fermé trop tôt ligne {line}.",
          "+ {count} more declaration(s) outside the block — likely cause: "
          "block closed too early on line {line}.")
/*  : variables locales typees enum registry. Check coerce
 * compile-time refuse l'affectation d'une valeur incompatible (cross-enum,
 * entier hors plage sentinel, chaine non-canonical, identifiant inconnu). */
OWL_ERROR(E_SEM_ENUM_VAR_COERCE_CROSS_ENUM, "semantic",
          "Affectation à une variable de type '{targetEnum}' : la "
          "constante '{constName}' appartient à l'enum '{ownerEnum}' "
          "et ne peut pas être affectée ici.",
          "Assignment to a variable of type '{targetEnum}': the "
          "constant '{constName}' belongs to enum '{ownerEnum}' and "
          "cannot be assigned here.")
OWL_ERROR(E_SEM_ENUM_VAR_COERCE_INT_OUT_OF_RANGE, "semantic",
          "Affectation à une variable de type '{targetEnum}' : la "
          "valeur entière {literal} ne correspond à aucune constante "
          "de cet enum.",
          "Assignment to a variable of type '{targetEnum}': the "
          "integer value {literal} does not match any constant of this "
          "enum.")
OWL_ERROR(E_SEM_ENUM_VAR_COERCE_STRING_UNKNOWN, "semantic",
          "Affectation à une variable de type '{targetEnum}' : la "
          "chaîne \"{literal}\" ne correspond à aucune constante de "
          "cet enum. Valeurs possibles : {sample}.",
          "Assignment to a variable of type '{targetEnum}': the "
          "string \"{literal}\" does not match any constant of this "
          "enum. Allowed values: {sample}.")
OWL_ERROR(E_SEM_ENUM_VAR_COERCE_UNKNOWN_IDENT, "semantic",
          "Affectation à une variable de type '{targetEnum}' : "
          "l'identifiant '{ident}' n'est pas une constante connue. "
          "Valeurs possibles : {sample}.",
          "Assignment to a variable of type '{targetEnum}': the "
          "identifier '{ident}' is not a known constant. Allowed "
          "values: {sample}.")
OWL_ERROR(E_SEM_ENUM_TYPE_AS_VALUE, "semantic",
          "'{name}' est un type d'énumération : il ne peut pas être "
          "utilisé comme valeur. Utilisez un membre qualifié, par "
          "exemple {name}.membre.",
          "'{name}' is an enumeration type: it cannot be used as a "
          "value. Use a qualified member instead, e.g. {name}.member.")

/*  — lancement direct d'une fenêtre paramétrée comme point
 * d'entrée (owl FEN_X.owl / GO LOCAL). Deux refus AVANT toute ouverture :
 *   1. au moins un paramètre de type avancé -> lancement direct impossible ;
 *   2. paramètre(s) requis sans valeur en contexte non interactif. */
OWL_ERROR(E_RT_WINDOW_LAUNCH_ADVANCED_PARAM, "runtime",
          "La fenêtre '{window}' déclare un ou plusieurs paramètres de type "
          "avancé : elle ne peut pas être lancée directement. Écrire un "
          "fichier qui l'ouvre avec Ouvre({window}, ...) en fournissant les "
          "valeurs.",
          "Window '{window}' declares one or more advanced-type parameters: "
          "it cannot be launched directly. Write a file that opens it with "
          "Ouvre({window}, ...) providing the values.")
OWL_ERROR(E_RT_WINDOW_LAUNCH_REQUIRED_PARAM_MISSING, "runtime",
          "La fenêtre '{window}' attend le(s) paramètre(s) requis : {params}. "
          "Aucune valeur n'a été fournie et le contexte n'est pas interactif : "
          "fournir les valeurs (par exemple via un fichier qui appelle "
          "Ouvre({window}, ...)).",
          "Window '{window}' expects the required parameter(s): {params}. "
          "No value was provided and the context is not interactive: provide "
          "the values (for example via a file that calls Ouvre({window}, ...)).")

/*  — canal `--arg <nom>=<valeur>` du lancement direct (GO LOCAL).
 * Deux refus dédiés AVANT toute ouverture :
 *   1. `--arg` sans signe '=' (valeur non séparable du nom) ;
 *   2. `--arg` ciblant un paramètre que la fenêtre ne déclare pas. */
OWL_ERROR(E_RT_WINDOW_LAUNCH_ARG_MALFORMED, "runtime",
          "Argument --arg mal formé « {arg} » au lancement de la fenêtre "
          "'{window}' : la syntaxe attendue est --arg <nom>=<valeur> (le "
          "signe '=' est requis pour séparer le nom du paramètre de sa valeur).",
          "Malformed --arg argument \"{arg}\" while launching window "
          "'{window}': the expected syntax is --arg <name>=<value> (the '=' "
          "sign is required to separate the parameter name from its value).")
OWL_ERROR(E_RT_WINDOW_LAUNCH_ARG_UNKNOWN_PARAM, "runtime",
          "La fenêtre '{window}' ne déclare aucun paramètre nommé « {name} » : "
          "l'argument --arg correspondant ne peut pas être affecté. Paramètres "
          "déclarés : {params}.",
          "Window '{window}' declares no parameter named \"{name}\": the "
          "matching --arg argument cannot be bound. Declared parameters: "
          "{params}.")

/*  — lancement direct (`owl <fichier>`) d'un fichier dont le top-level
 * est un bloc DSL qui n'est pas un point d'entree (ni Projet, ni Fenetre). Sans
 * ce refus, un tel fichier sortait en exit 0 silencieux sans rien executer. */
OWL_ERROR(E_RT_ENTRY_NOT_LAUNCHABLE, "runtime",
          "Le fichier déclare '{name}' ({kind}) : ce type ne peut pas être "
          "lancé directement. Lançables : un projet (projet.owl), une "
          "fenêtre, ou un script.",
          "The file declares '{name}' ({kind}): this type cannot be launched "
          "directly. Launchable: a project (projet.owl), a window, or a "
          "script.")

/* ================================================================
 *  — menu classique de fenêtre (MenuPrincipal / SousMenu /
 * OptionMenu / MenuSéparateur). Politique : tout ce qui est déclaré de
 * travers casse à la compilation avec un message actionnable ; rien n'est
 * avalé en silence.
 * ================================================================ */
OWL_ERROR(E_SEM_MENU_NODE_OUTSIDE_MAIN, "semantic",
          "{kind} '{name}' déclaré hors d'un MenuPrincipal. Un élément de "
          "menu se déclare à l'intérieur d'un bloc "
          "'<Nom> est un MenuPrincipal ... FIN'.",
          "{kind} '{name}' declared outside a MainMenu. A menu element must "
          "be declared inside a '<Name> is a MainMenu ... END' block.")
OWL_ERROR(E_SEM_MENU_UNKNOWN_BLOCK, "semantic",
          "Bloc '{name}' inconnu dans {kind}. Blocs acceptés : PROPRIETES, "
          "SousMenu, OptionMenu, MenuSéparateur.",
          "Unknown block '{name}' inside {kind}. Accepted blocks: PROPERTIES, "
          "Submenu, MenuOption, MenuSeparator.")
OWL_ERROR(E_SEM_MENU_OPTION_HAS_CHILDREN, "semantic",
          "OptionMenu '{name}' est un élément terminal : il ne peut pas "
          "contenir de sous-bloc. Utiliser SousMenu pour un menu déroulant.",
          "MenuOption '{name}' is a terminal element: it cannot hold a "
          "nested block. Use Submenu for a drop-down menu.")
OWL_ERROR(E_SEM_MENU_SEPARATOR_HAS_CHILDREN, "semantic",
          "MenuSéparateur '{name}' est un simple trait de séparation : il "
          "ne peut pas contenir de sous-bloc.",
          "MenuSeparator '{name}' is a plain separator line: it cannot hold "
          "a nested block.")
OWL_ERROR(E_SEM_MENU_SUBMENU_HAS_SELECTION, "semantic",
          "SousMenu '{name}' est un conteneur : il ne peut pas porter "
          "PROCEDURE surSélection(). Déclarer surSélection() sur "
          "l'OptionMenu terminal.",
          "Submenu '{name}' is a container: it cannot carry PROCEDURE "
          "onSelection(). Declare onSelection() on the terminal MenuOption.")
OWL_ERROR(E_SEM_MENU_SEPARATOR_HAS_SELECTION, "semantic",
          "MenuSéparateur '{name}' n'est pas une commande : il ne peut pas "
          "porter PROCEDURE surSélection().",
          "MenuSeparator '{name}' is not a command: it cannot carry "
          "PROCEDURE onSelection().")
OWL_ERROR(E_SEM_MENU_PROC_UNKNOWN, "semantic",
          "PROCEDURE '{name}' inconnue dans {kind}. Seul surSélection() est "
          "accepté, et uniquement sur une OptionMenu.",
          "Unknown PROCEDURE '{name}' inside {kind}. Only onSelection() is "
          "accepted, and only on a MenuOption.")
OWL_ERROR(E_SEM_MENU_SUBMENU_NO_CAPTION, "semantic",
          "SousMenu '{name}' déclaré sans Libellé : un menu déroulant doit "
          "porter le texte affiché dans la barre de menus.",
          "Submenu '{name}' declared without Caption: a drop-down menu must "
          "carry the text shown in the menu bar.")
OWL_ERROR(E_SEM_MENU_OPTION_NO_CAPTION, "semantic",
          "OptionMenu '{name}' déclarée sans Libellé : une option de menu "
          "doit porter le texte affiché.",
          "MenuOption '{name}' declared without Caption: a menu option must "
          "carry the text to display.")
OWL_ERROR(E_SEM_MENU_PROP_UNKNOWN, "semantic",
          "Propriété '{prop}' inconnue pour {kind}. Propriétés acceptées : "
          "{allowed}.",
          "Unknown property '{prop}' for {kind}. Accepted properties: "
          "{allowed}.")
OWL_ERROR(E_SEM_MENU_SHORTCUT_MALFORMED, "semantic",
          "Raccourci '{value}' malformé. Forme attendue : des modificateurs "
          "(Ctrl, Alt, Maj) séparés par '+' suivis d'une touche, par exemple "
          "\"Ctrl+N\" ou \"Ctrl+Maj+S\".",
          "Malformed Shortcut '{value}'. Expected form: modifiers (Ctrl, "
          "Alt, Shift) separated by '+' followed by a key, for example "
          "\"Ctrl+N\" or \"Ctrl+Shift+S\".")
OWL_ERROR(E_SEM_MENU_ASSIGN_UNKNOWN, "semantic",
          "MenuPrincipal = '{name}' : identificateur inconnu dans cette "
          "fenêtre. Déclarer un bloc '{name} est un MenuPrincipal ... FIN'.",
          "MainMenu = '{name}': unknown identifier in this window. Declare a "
          "'{name} is a MainMenu ... END' block.")
OWL_ERROR(E_SEM_MENU_ASSIGN_TYPE_MISMATCH, "semantic",
          "MenuPrincipal = '{name}' : type incompatible, '{name}' n'est pas "
          "un MenuPrincipal.",
          "MainMenu = '{name}': incompatible type, '{name}' is not a "
          "MainMenu.")
OWL_ERROR(E_SEM_MENU_ASSIGN_DUPLICATE, "semantic",
          "MenuPrincipal déjà affecté à '{name}' sur cette fenêtre : une "
          "seule affectation autorisée.",
          "MainMenu already assigned to '{name}' on this window: only one "
          "assignment is allowed.")
OWL_ERROR(E_SEM_MENU_ASSIGN_EXPECTED_NAME, "semantic",
          "MenuPrincipal = attend le nom d'un MenuPrincipal déclaré dans "
          "cette fenêtre.",
          "MainMenu = expects the name of a MainMenu declared in this "
          "window.")
OWL_ERROR(E_SEM_MENU_NAME_DUPLICATE, "semantic",
          "'{name}' est déjà déclaré dans la fenêtre '{window}'.",
          "'{name}' is already declared in window '{window}'.")
/*  — doublons de noeuds et d'évènements de menu. Les deux surfaces
 * acceptaient silencieusement l'homonyme : les deux entrées étaient montées
 * mais la résolution par nom n'en atteignait qu'une, et le second bloc
 * d'évènement ne s'exécutait jamais. */
OWL_ERROR(E_SEM_MENU_NODE_NAME_DUPLICATE, "semantic",
          "'{name}' est déjà déclaré dans '{parent}'. Deux éléments de menu "
          "de même parent doivent avoir des noms distincts.",
          "'{name}' is already declared in '{parent}'. Two menu elements "
          "sharing a parent must have distinct names.")
OWL_ERROR(E_SEM_MENU_NODE_EVENT_DUPLICATE, "semantic",
          "Bloc PROCEDURE '{name}' déjà déclaré pour l'élément de menu "
          "'{node}'.",
          "PROCEDURE block '{name}' already declared for menu element "
          "'{node}'.")
/*  — propriété `Style` d'un MenuPrincipal (styleMenuPrincipal). */
OWL_ERROR(E_SEM_MENU_STYLE_BLOCK_OBSOLETE, "semantic",
          "'Style' n'est plus un bloc autonome dans {kind} : déclarer le style "
          "comme propriété dans un bloc PROPRIETES (ex : "
          "Style..Barre..CouleurFond = BleuFoncé, ou Style = { ... }).",
          "'Style' is no longer a standalone block inside {kind}: declare the "
          "style as a property in a PROPERTIES block (e.g. "
          "Style..Bar..BackgroundColor = DarkBlue, or Style = { ... }).")
OWL_ERROR(E_SEM_MENU_STYLE_NO_SURFACE, "semantic",
          "Propriété de style '{prop}' à la racine de la propriété Style sans "
          "surface : préciser Barre, SousMenu ou OptionMenu (ex : Barre..{prop}).",
          "Style property '{prop}' at the root of the Style property without a "
          "surface: specify Bar, Submenu or MenuOption (e.g. Bar..{prop}).")
OWL_ERROR(E_SEM_MENU_STYLE_SURFACE_UNKNOWN, "semantic",
          "Surface de style '{name}' inconnue dans la propriété Style. Surfaces "
          "acceptées : Barre, SousMenu, OptionMenu.",
          "Unknown style surface '{name}' in the Style property. Accepted "
          "surfaces: Bar, Submenu, MenuOption.")
OWL_ERROR(E_SEM_MENU_STYLE_PROP_UNKNOWN, "semantic",
          "Propriété de style '{prop}' inconnue pour la surface {surface}. "
          "Propriétés acceptées : {allowed}.",
          "Unknown style property '{prop}' for surface {surface}. Accepted "
          "properties: {allowed}.")
OWL_ERROR(E_SEM_MENU_STYLE_STATE_ON_STATIC, "semantic",
          "La surface {surface} n'a pas d'états : Etats[...] n'est valide que "
          "sur Barre et OptionMenu.",
          "Surface {surface} has no states: Etats[...] is only valid on Bar "
          "and MenuOption.")
OWL_ERROR(E_SEM_MENU_STYLE_STATE_UNKNOWN, "semantic",
          "État de style '{state}' inconnu. Seul l'état survol est disponible.",
          "Unknown style state '{state}'. Only the hover state is available.")
OWL_ERROR(E_SEM_MENU_STYLE_VALUE_NOT_CONST, "semantic",
          "La valeur de la propriété de style '{prop}' doit être une constante "
          "(couleur, booléen, nombre, texte) : les expressions dynamiques ne "
          "sont pas acceptées dans la propriété Style d'un menu.",
          "The value of style property '{prop}' must be a constant (color, "
          "boolean, number, text): dynamic expressions are not accepted in a "
          "menu Style property.")
OWL_ERROR(E_SEM_MENU_STYLE_VALUE_TYPE, "semantic",
          "Valeur incompatible pour la propriété de style '{prop}'. Une couleur "
          "attend un entier (ex : Bleu, RVB(...)), un attribut de police booléen "
          "attend Vrai/Faux, un nom de police attend un texte.",
          "Incompatible value for style property '{prop}'. A color expects an "
          "integer (e.g. Blue, RGB(...)), a boolean font attribute expects "
          "True/False, a font name expects text.")
OWL_ERROR(E_SEM_MENU_STYLE_SYNTAX, "semantic",
          "Syntaxe invalide dans la propriété Style : attendu "
          "'Style..Surface..Propriété = valeur'.",
          "Invalid syntax in the Style property: expected "
          "'Style..Surface..Property = value'.")
OWL_ERROR(E_SEM_MENU_STYLE_FONT_NO_STATE, "semantic",
          "La police d'un menu se règle uniquement sur l'état de base, pas au "
          "survol.",
          "A menu font can only be set on the base state, not on hover.")
/*  — propriété `Style` d'un Champ Onglet (styleOnglet). Racine =
 * fond du pane (CouleurFond) + deux sous-éléments VoletActif / VoletInactif
 * (Couleur, CouleurFond, Police + état survol). Codes calqués sur le style
 * menu. */
OWL_ERROR(E_SEM_ONGLET_STYLE_ELEMENT_UNKNOWN, "semantic",
          "Sous-élément de style '{name}' inconnu dans la propriété Style d'un "
          "Onglet. Sous-éléments acceptés : CadreExtérieur, VoletActif, VoletInactif.",
          "Unknown style sub-element '{name}' in the Style property of a Tab. "
          "Accepted sub-elements: OuterFrame, ActivePane, InactivePane.")
OWL_ERROR(E_SEM_ONGLET_STYLE_PROP_UNKNOWN, "semantic",
          "Propriété de style '{prop}' inconnue pour {surface}. Propriétés "
          "acceptées : {allowed}.",
          "Unknown style property '{prop}' for {surface}. Accepted properties: "
          "{allowed}.")
OWL_ERROR(E_SEM_ONGLET_STYLE_STATE_ON_ROOT, "semantic",
          "La racine du style Onglet n'a pas d'états : Etats[...] n'est valide "
          "que sur CadreExtérieur, VoletActif et VoletInactif.",
          "The Tab style root has no states: Etats[...] is only valid on "
          "OuterFrame, ActivePane and InactivePane.")
OWL_ERROR(E_SEM_ONGLET_STYLE_SYNTAX, "semantic",
          "Syntaxe invalide dans la propriété Style d'un Onglet : attendu "
          "'Style..VoletActif..Propriété = valeur' ou 'Style..CadreExtérieur..CouleurFond = valeur'.",
          "Invalid syntax in the Style property of a Tab: expected "
          "'Style..ActivePane..Property = value' or 'Style..OuterFrame..BackgroundColor = value'.")
OWL_ERROR(E_SEM_ONGLET_STYLE_VALUE_NOT_CONST, "semantic",
          "La valeur de la propriété de style '{prop}' doit être une constante "
          "(couleur, booléen, nombre, texte) : les expressions dynamiques ne "
          "sont pas acceptées dans la propriété Style d'un Onglet.",
          "The value of style property '{prop}' must be a constant (color, "
          "boolean, number, text): dynamic expressions are not accepted in a "
          "Tab Style property.")
/*  — menu contextuel (clic droit). */
OWL_ERROR(E_SEM_CTXMENU_EMPTY, "semantic",
          "MenuContextuel '{name}' est vide : déclarer au moins un SousMenu ou "
          "une OptionMenu, sinon le menu contextuel n'affiche rien.",
          "ContextMenu '{name}' is empty: declare at least one Submenu or "
          "MenuOption, otherwise the context menu shows nothing.")
OWL_ERROR(E_SEM_CTXMENU_STYLE_BAR, "semantic",
          "La surface Barre n'existe pas sur un MenuContextuel (pas de barre de "
          "menus au clic droit). Styler SousMenu ou OptionMenu.",
          "The Bar surface does not exist on a ContextMenu (a right-click menu "
          "has no menu bar). Style Submenu or MenuOption instead.")
OWL_ERROR(E_SEM_CTXMENU_ASSIGN_UNKNOWN, "semantic",
          "MenuContextuel = '{name}' : identificateur inconnu dans cette "
          "fenêtre. Déclarer un bloc '{name} est un MenuContextuel ... FIN'.",
          "ContextMenu = '{name}': unknown identifier in this window. Declare a "
          "'{name} is a ContextMenu ... END' block.")
OWL_ERROR(E_SEM_CTXMENU_ASSIGN_TYPE_MISMATCH, "semantic",
          "MenuContextuel = '{name}' : type incompatible, '{name}' n'est pas "
          "un MenuContextuel.",
          "ContextMenu = '{name}': incompatible type, '{name}' is not a "
          "ContextMenu.")
OWL_ERROR(E_SEM_CTXMENU_ASSIGN_DUPLICATE, "semantic",
          "MenuContextuel déjà affecté à '{name}' : une seule affectation "
          "autorisée.",
          "ContextMenu already assigned to '{name}': only one assignment is "
          "allowed.")
OWL_ERROR(E_SEM_CTXMENU_ASSIGN_EXPECTED_NAME, "semantic",
          "MenuContextuel = attend le nom d'un MenuContextuel déclaré dans "
          "cette fenêtre.",
          "ContextMenu = expects the name of a ContextMenu declared in this "
          "window.")

/* ================================================================
 * COLLECTION DE PROCÉDURES — bloc DSL
 * `<Nom> est une CollectionDeProcédures ... FIN`.
 * ================================================================ */
OWL_ERROR(E_SEM_COLLECTION_TOPLEVEL_CODE_BEFORE, "semantic",
          "Un fichier de collection de procédures ne peut contenir que son "
          "bloc. Déplacer cette instruction DANS le bloc "
          "CollectionDeProcédures (c'est là que vit le code "
          "d'initialisation).",
          "A procedure-collection file may only contain its block. Move "
          "this statement INTO the ProcedureCollection block (that is "
          "where the initialization code lives).")
OWL_ERROR(E_SEM_COLLECTION_TOPLEVEL_CODE_AFTER, "semantic",
          "Un fichier de collection de procédures ne peut contenir que son "
          "bloc. Déplacer cette instruction DANS le bloc "
          "CollectionDeProcédures, avant son FIN final (c'est là que vit "
          "le code d'initialisation).",
          "A procedure-collection file may only contain its block. Move "
          "this statement INTO the ProcedureCollection block, before its "
          "final END (that is where the initialization code lives).")
OWL_ERROR(E_SEM_COLLECTION_CLASSE_INTERDITE, "semantic",
          "La classe '{name}' ne peut pas être déclarée dans une "
          "collection de procédures. Une classe vit seule dans son propre "
          "fichier .owl.",
          "Class '{name}' cannot be declared inside a procedure "
          "collection. A class lives alone in its own .owl file.")
OWL_ERROR(E_SEM_COLLECTION_FILE_AND_OTHER_BLOCK, "semantic",
          "Un fichier ne peut pas contenir à la fois une collection de "
          "procédures et un autre bloc de premier ordre (Fenêtre, État, "
          "Classe ou Projet). Placer la collection dans son propre "
          "fichier .owl.",
          "A file cannot contain both a procedure collection and another "
          "first-class block (Window, Report, Class or Project). Place "
          "the collection in its own .owl file.")
OWL_ERROR(E_SEM_COLLECTION_DUPLICATE, "semantic",
          "Un seul bloc CollectionDeProcédures est autorisé par fichier.",
          "Only one ProcedureCollection block is allowed per file.")
/*  — les blocs de premier ordre ne s'imbriquent pas (Fenêtre dans
 * Fenêtre et Classe dans Classe sont déjà refusées). La collection était la
 * seule à passer en silence, alors qu'elle corrompt le suivi lexical des
 * membres : tout membre déclaré après le bloc imbriqué disparaissait de
 * l'index sans un mot. */
OWL_ERROR(E_SEM_COLLECTION_NESTED, "semantic",
          "Collection de procédures imbriquée non supportée. Déclarer la "
          "collection '{name}' au niveau top-level, seule dans son propre "
          "fichier .owl.",
          "Nested procedure collection not supported. Declare collection "
          "'{name}' at top-level, alone in its own .owl file.")
/*  — garde de coherence entre l'indexation prealable des membres de
 * collection (scan lexical des fichiers du projet) et le parse reel. Une
 * divergence signifie qu'un membre bien defini est invisible des autres
 * fichiers : sans ce garde, l'appel echouait au runtime, sans diagnostic. */
OWL_ERROR(E_SEM_COLLECTION_MEMBER_NOT_PRESCANNED, "semantic",
          "Le membre '{member}' de la collection '{collection}' n'a pas été "
          "indexé par l'analyse préalable du projet : il ne serait pas "
          "résolu sous son nom nu depuis un autre fichier. Simplifier le nom "
          "du bloc ou la structure de ses blocs imbriqués.",
          "Member '{member}' of collection '{collection}' was not indexed by "
          "the project pre-analysis: it would not resolve under its bare name "
          "from another file. Simplify the block name or the structure of its "
          "inner blocks.")

/* ================================================================
 * WARNING runtime — diagnostics non-bloquants émis pendant l'exécution
 * (canal centralisé, pédagogique).
 * ================================================================ */
/*  — un timer encore actif au moment où le process se termine,
 * sans qu'aucune boucle d'événements ne l'ait jamais déclenché (script CLI
 * sans pompe). Pédagogique : explique pourquoi la procédure n'a jamais
 * tourné et oriente vers une fenêtre ou Temporise. */
OWL_ERROR(W_RT_TIMER_NEVER_FIRED, "warning",
          "Le programme s'est terminé avec {count} timer(s) actif(s) qui "
          "n'ont jamais été déclenchés : un timer ne s'exécute que pendant "
          "une boucle d'événements (fenêtre ouverte) ou un Temporise. Un "
          "script en ligne de commande qui se termine immédiatement ne "
          "laisse jamais le timer tirer.",
          "The program ended with {count} active timer(s) that never "
          "fired: a timer only runs during an event loop (open window) or "
          "a Temporise. A command-line script that exits immediately never "
          "lets the timer tick.")

/* ================================================================
 * SYNTAX — attentes de token du parser
 *
 * Ces codes couvrent les messages qui vivaient en dur dans les appels
 * `consume(TOKEN_X, "...")` de compiler.c : monolingues anglais, hors
 * catalogue, et invisibles pour check_error_centralization.sh dont le
 * perimetre etait defini par NOM d'emetteur (error_at / error_at_current /
 * warning_at / error) et pas par provenance du message. `consume` forward
 * son argument a error_at_current(message) — identifiant, pas litteral —
 * donc le litteral vivait une frame en amont, hors radar.
 *
 * Les formes de symboles citees sont celles du registre : table de
 * mots-cles du scanner (src/scanner.c) et table canon du formatter
 * (src/formatter.c). Rien d'invente.
 *
 * Ajoutes EN FIN de fichier pour ne pas decaler les alias numeriques
 * E0001.. des codes existants (cf. entete).
 * ================================================================ */

OWL_ERROR(E_SYNTAX_EXP_LPAREN_AFTER_DANS, "syntax",
          "'(' attendu après 'DANS'.",
          "Expected '(' after 'IN'.")
OWL_ERROR(E_SYNTAX_EXP_LPAREN_AFTER_BITSHIFT, "syntax",
          "'(' attendu après bitDécaleGauche / bitDécaleDroite.",
          "Expected '(' after bitDécaleGauche / bitDécaleDroite.")
OWL_ERROR(E_SYNTAX_EXP_LPAREN_AFTER_CLASS_NAME, "syntax",
          "'(' attendu après le nom de la classe.",
          "Expected '(' after the class name.")
OWL_ERROR(E_SYNTAX_EXP_LPAREN_AFTER_MEMBER_NAME, "syntax",
          "'(' attendu après le nom de la méthode, du Constructeur ou du "
          "Destructeur.",
          "Expected '(' after the method, Constructeur or Destructeur name.")
OWL_ERROR(E_SYNTAX_EXP_LPAREN_CTOR_ARGS, "syntax",
          "'(' attendu pour les arguments du Constructeur.",
          "Expected '(' for the Constructeur arguments.")
OWL_ERROR(E_SYNTAX_EXP_LPAREN_ANCETRE_CALL, "syntax",
          "'(' attendu pour l'appel à 'ANCETRE' : 'ANCETRE' sert à invoquer "
          "une méthode, pas à lire un champ.",
          "Expected '(' for the 'ANCESTOR' call: 'ANCESTOR' invokes a "
          "method, it does not read a field.")
OWL_ERROR(E_SYNTAX_EXP_RPAREN_DANS_LIST, "syntax",
          "')' attendu après la liste 'DANS'.",
          "Expected ')' after the 'IN' list.")
OWL_ERROR(E_SYNTAX_EXP_RPAREN_BOUCLE_COUNT, "syntax",
          "')' attendu après le nombre d'itérations de 'BOUCLE'.",
          "Expected ')' after the 'LOOP' iteration count.")
OWL_ERROR(E_SYNTAX_EXP_RPAREN_ETAT_PARAMS, "syntax",
          "')' attendu après les paramètres de l'État.",
          "Expected ')' after the Report parameters.")
OWL_ERROR(E_SYNTAX_EXP_RPAREN_EXECUTE_ARGS, "syntax",
          "')' attendu après les arguments de 'Exécute'.",
          "Expected ')' after the 'Execute' arguments.")
OWL_ERROR(E_SYNTAX_EXP_RPAREN_FENETRE_PARAMS, "syntax",
          "')' attendu après les paramètres de la Fenêtre.",
          "Expected ')' after the Window parameters.")
OWL_ERROR(E_SYNTAX_EXP_RPAREN_SORTIR_LEVEL, "syntax",
          "')' attendu après le niveau de 'SORTIR'.",
          "Expected ')' after the 'BREAK' level.")
OWL_ERROR(E_SYNTAX_EXP_RPAREN_ARGS, "syntax",
          "')' attendu après les arguments.",
          "Expected ')' after arguments.")
OWL_ERROR(E_SYNTAX_EXP_RPAREN_BLOCK_NAME, "syntax",
          "')' attendu après le nom de bloc.",
          "Expected ')' after the block name.")
OWL_ERROR(E_SYNTAX_EXP_RPAREN_BLOCK_PARAMS, "syntax",
          "')' attendu après les paramètres du bloc.",
          "Expected ')' after the block parameters.")
OWL_ERROR(E_SYNTAX_EXP_RPAREN_EXPR, "syntax",
          "')' attendu après l'expression.",
          "Expected ')' after the expression.")
OWL_ERROR(E_SYNTAX_EXP_RPAREN_OPERANDS, "syntax",
          "')' attendu après les opérandes.",
          "Expected ')' after the operands.")
OWL_ERROR(E_SYNTAX_EXP_RPAREN_PARAMS, "syntax",
          "')' attendu après les paramètres.",
          "Expected ')' after parameters.")
OWL_ERROR(E_SYNTAX_EXP_RPAREN_RETURN_VALUES, "syntax",
          "')' attendu après les valeurs de retour.",
          "Expected ')' after the return values.")
OWL_ERROR(E_SYNTAX_EXP_RPAREN_VAR_LIST, "syntax",
          "')' attendu après la liste de variables.",
          "Expected ')' after the variable list.")
OWL_ERROR(E_SYNTAX_EXP_STAR_SANDWICH, "syntax",
          "'*' attendu dans le pattern sandwich.",
          "Expected '*' in the sandwich pattern.")
OWL_ERROR(E_SYNTAX_EXP_COMMA_OPERANDS, "syntax",
          "',' attendu entre les opérandes.",
          "Expected ',' between the operands.")
OWL_ERROR(E_SYNTAX_EXP_DOT_AFTER_ANCETRE, "syntax",
          "'.' attendu après 'ANCETRE'.",
          "Expected '.' after 'ANCESTOR'.")
OWL_ERROR(E_SYNTAX_OWL_NS_SIMPLE_DOT, "syntax",
          "Le namespace 'OWL' s'écrit avec un point simple : "
          "'OWL.<fonction>', pas '..'.",
          "The 'OWL' namespace uses a single dot: 'OWL.<function>', not '..'.")
OWL_ERROR(E_SYNTAX_OWL_NS_EXP_NAME, "syntax",
          "Nom de fonction native attendu après 'OWL.'.",
          "Expected a native function name after 'OWL.'.")
OWL_ERROR(E_SYNTAX_EXP_EQUAL_AFTER_VAR_LIST, "syntax",
          "'=' attendu après la liste (variables).",
          "Expected '=' after the (variables) list.")
OWL_ERROR(E_SYNTAX_EXP_EQUAL_PROJET_FIELD, "syntax",
          "'=' attendu après le nom de champ du Projet.",
          "Expected '=' after the Project field name.")
OWL_ERROR(E_SYNTAX_EXP_EQUAL_CONST_NAME, "syntax",
          "'=' attendu après le nom de la constante.",
          "Expected '=' after the constant name.")
OWL_ERROR(E_SYNTAX_EXP_EQUAL_LOOP_VAR, "syntax",
          "'=' attendu après la variable de boucle.",
          "Expected '=' after the loop variable.")
OWL_ERROR(E_SYNTAX_EXP_GT_AGRANDISSEMENT, "syntax",
          "'>' attendu pour fermer <agrandissement>.",
          "Expected '>' to close <agrandissement>.")
OWL_ERROR(E_SYNTAX_EXP_ALORS_AFTER_SINONSI, "syntax",
