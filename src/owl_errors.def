          "widgets, utilise un Conteneur.",
          "Subfield (Label/Button/Input/Table/Container) is not "
          "valid inside a '{kind}'. To nest widgets, use a Container.")
OWL_ERROR(E_SEM_DSL_TOO_MANY_EVENT_PARAMS, "semantic",
          "Trop de paramètres déclarés (max 8).",
          "Too many declared parameters (max 8).")
OWL_ERROR(E_SEM_DSL_EXPECTED_PARAM_NAME_AFTER_LPAREN, "semantic",
          "Attendu nom de paramètre après '('.",
          "Expected parameter name after '('.")
OWL_ERROR(E_SEM_DSL_EXPECTED_EST_AFTER_PARAM, "semantic",
