          "A multilingual string literal is initialized with 'key: value' "
          "(colon), not '='.")

/* ================================================================
 * SEMANTIC — erreurs analyse sémantique compile-time
 * ================================================================ */
/* Texte volontairement distinct de E_RT_DIV_BY_ZERO : les deux etaient
 * rendus a l'identique et rien, dans le message, ne disait si la division
 * avait ete refusee a la compilation ou subie a l'execution. */
OWL_ERROR(E_SEM_DIV_BY_ZERO_CONST, "semantic",
          "Division par zéro : le diviseur est un littéral nul.",
          "Division by zero: the divisor is a zero literal.")

/* --- Control flow context errors --- */
OWL_ERROR(E_SEM_SORTIR_OUTSIDE_LOOP, "semantic",
          "SORTIR utilisé en dehors d'une boucle.",
          "BREAK used outside of a loop.")
OWL_ERROR(E_SEM_SORTIR_TOO_DEEP, "semantic",
          "SORTIR({levels}) demandé mais seulement {available} "
          "niveau(x) de boucle imbriquée(s) disponible(s) ici.",
          "BREAK({levels}) requested but only {available} nested loop "
          "level(s) available here.")
OWL_ERROR(E_SEM_SORTIR_EXPECTS_INTEGER_LITERAL, "semantic",
          "SORTIR(...) attend un nombre littéral entier de niveaux (ex: "
          "SORTIR(2)).",
          "BREAK(...) expects an integer literal level (e.g. BREAK(2)).")
OWL_ERROR(E_SEM_SORTIR_SELON_OUTSIDE_SELON, "semantic",
          "SORTIR SELON utilisé en dehors d'un bloc SELON.",
          "BREAK SWITCH used outside of a SWITCH statement.")
OWL_ERROR(E_SEM_CONTINUER_OUTSIDE_LOOP, "semantic",
          "CONTINUER utilisé en dehors d'une boucle.",
          "CONTINUE used outside of a loop.")
OWL_ERROR(E_SEM_QUAND_EXCEPTION_INSIDE_LOOP, "semantic",
          "'QUAND EXCEPTION' (forme générale) interdit dans une "
          "boucle. Utiliser 'QUAND EXCEPTION DANS ... FAIRE ... FIN' "
          "pour protéger un bloc spécifique.",
          "'WHEN EXCEPTION' (general form) not allowed inside a loop. "
          "Use 'WHEN EXCEPTION IN ... DO ... END' to protect a "
          "specific block.")

/* --- Variable / type declaration semantic errors --- */
OWL_ERROR(E_SEM_CANNOT_ASSIGN_TO_TYPE_NAME, "semantic",
          "Affectation à un nom de type interdite.",
          "Cannot assign to type name.")
OWL_ERROR(E_SEM_DUPLICATE_VAR_IN_SCOPE, "semantic",
          "Une variable de même nom existe déjà dans cette portée.",
          "Already a variable with this name in this scope.")
OWL_ERROR(E_SEM_DUPLICATE_PROC_IN_SCOPE, "semantic",
          "Une procédure de même nom existe déjà dans cette portée.",
          "Already a procedure with this name in this scope.")
OWL_ERROR(E_SEM_VAR_SHADOWS_OUTER_SCOPE, "semantic",
          "La déclaration de '{name}' masque l'identifiant '{name}' "
          "déclaré au top-level (ligne {line}).",
          "Declaration of '{name}' shadows identifier '{name}' declared "
          "at top-level (line {line}).")
OWL_ERROR(E_SEM_VAR_SHADOWS_OUTER_SCOPE_CROSS_FILE, "semantic",
          "La déclaration de '{name}' masque l'identifiant '{name}' "
          "déclaré au top-level dans '{file}' (ligne {line}).",
          "Declaration of '{name}' shadows identifier '{name}' declared "
          "at top-level in '{file}' (line {line}).")
OWL_ERROR(E_SEM_VARIANT_TYPE_REMOVED, "semantic",
          "Le type 'Variant' a été retiré d'OWL. Utilise un type "
          "concret (chaîne, entier, JSON, httpRéponse...) ou ajoute "
          "'?' / '<nullable>' pour supporter Null.",
          "The 'Variant' type has been removed from OWL. Use a concrete "
          "type (string, integer, JSON, httpResponse...) or add '?' / "
          "'<nullable>' to allow Null.")

/* --- POO / method context errors --- */
OWL_ERROR(E_SEM_COLON_MEMBER_OUTSIDE_METHOD, "semantic",
          "':membre' ne peut être utilisé qu'à l'intérieur d'une "
          "méthode.",
          "Cannot use ':member' outside of a method.")
OWL_ERROR(E_SEM_COLON_MEMBER_IN_GLOBAL_METHOD, "semantic",
          "La méthode globale '{class}.<méthode>' ne peut pas utiliser "
          "':' (pas d'instance courante). Utiliser le nom de classe pour "
          "accéder aux membres globaux.",
          "Global method '{class}.<method>' cannot use ':' (no current "
          "instance). Use the class name to access global members.")
OWL_ERROR(E_SEM_COLON_MEMBER_UNKNOWN, "semantic",
          "'{member}' : membre inconnu sur la classe '{class}'.",
          "'{member}' : unknown member on class '{class}'.")
OWL_ERROR(E_SEM_OBJET_OUTSIDE_METHOD, "semantic",
          "'objet' : utilisable uniquement dans le corps d'une méthode "
          "de classe.",
          "'object' can only be used inside the body of a class method.")
OWL_ERROR(E_SEM_OBJET_IN_GLOBAL_METHOD, "semantic",
          "La méthode globale '{class}.{method}' ne peut pas utiliser "
          "'objet' (pas d'instance courante).",
          "Global method '{class}.{method}' cannot use 'object' "
          "(no current instance).")
OWL_ERROR(E_SEM_MOIMEME_IN_MAIN, "semantic",
          "MoiMême : interdit dans le top-level du programme — aucun "
          "champ n'est en cours d'exécution à ce stade. Utilise "
          "MoiMême depuis un handler d'événement, une fenêtre ou un "
          "état.",
          "MySelf: forbidden in top-level of the program — no control is "
          "currently executing at this point. Use MySelf from an event "
          "handler, a window or a report.")
/*  — MonChamp au top-level programme : aucun champ possible. */
OWL_ERROR(E_SEM_MONCHAMP_IN_MAIN, "semantic",
          "MonChamp : interdit dans le top-level du programme — aucun "
          "champ n'est en cours d'exécution à ce stade. Utilise "
          "MonChamp depuis un handler d'événement de champ.",
          "MyControl: forbidden in top-level of the program — no control is "
          "currently executing at this point. Use MyControl from a control's "
          "event handler.")
/*  — MaFenêtre au top-level programme : aucune fenetre ouverte. */
OWL_ERROR(E_SEM_MAFENETRE_IN_MAIN, "semantic",
          "MaFenêtre : interdit dans le top-level du programme — "
          "aucune fenêtre n'est ouverte à ce stade. Utilise MaFenêtre "
