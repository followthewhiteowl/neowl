          "eventDef. Inscrire l'event dans le catalogue.",
          "Event without catalog signature: parameters declared but no "
          "eventDef. Register the event in the catalog.")
OWL_ERROR(E_SEM_DSL_EVENT_TOO_MANY_PARAMS, "semantic",
          "Event '{event}' : {declared} paramètres déclarés, max canon = "
          "{max}. Signature : ({signature}).",
          "Event '{event}': {declared} parameters declared, canonical "
          "max = {max}. Signature: ({signature}).")
OWL_ERROR(E_SEM_DSL_EVENT_PARAM_TYPE_MISMATCH, "semantic",
          "Event '{event}' paramètre {position} ('{name}') : type "
          "attendu '{expected}', trouvé '{got}'.",
          "Event '{event}' parameter {position} ('{name}'): expected "
          "type '{expected}', got '{got}'.")
/*  — DéclencheÉvénement / TriggerEvent : validation compile-time
 * (cible, appartenance de l'événement au widget, arité + type des params). */
OWL_ERROR(E_SEM_EVT_TARGET_UNKNOWN, "semantic",
          "'{name}' : champ cible inconnu. DéclencheÉvénement attend un champ "
          "déclaré (objet) ou son nom en chaîne littérale résoluble.",
          "'{name}': unknown target control. TriggerEvent expects a declared "
          "control (object) or its name as a resolvable string literal.")
OWL_ERROR(E_SEM_EVT_TARGET_STRING_UNKNOWN, "semantic",
          "\"{name}\" : aucun champ de ce nom. La cible en chaîne littérale "
          "doit désigner un champ déclaré.",
          "\"{name}\": no control with this name. A string-literal target must "
          "designate a declared control.")
OWL_ERROR(E_SEM_EVT_NOT_A_CONST, "semantic",
          "'{name}' : attendu une constante d'événement evt* en 2e argument de "
          "DéclencheÉvénement (ex : evtClic, evtAChaqueModification).",
          "'{name}': expected an evt* event constant as the 2nd argument of "
          "TriggerEvent (e.g. evtClick, evtEachChange).")
OWL_ERROR(E_SEM_EVT_NOT_OWNED, "semantic",
          "L'événement '{evt}' n'est pas disponible sur le champ '{target}' "
          "(type {kind}). Choisir un événement propre à ce type de champ.",
          "Event '{evt}' is not available on control '{target}' (kind {kind}). "
          "Pick an event supported by this control kind.")
OWL_ERROR(E_SEM_EVT_PARAM_ARITY, "semantic",
          "L'événement '{evt}' attend {expected} paramètre(s), {got} fourni(s).",
          "Event '{evt}' expects {expected} parameter(s), got {got}.")
OWL_ERROR(E_SEM_EVT_PARAM_TYPE, "semantic",
          "L'événement '{evt}' paramètre {position} : type attendu "
          "'{expected}', trouvé '{got}'.",
          "Event '{evt}' parameter {position}: expected type '{expected}', "
          "got '{got}'.")
OWL_ERROR(E_SEM_DSL_PROC_DUPLICATE_IN_CONTROL, "semantic",
          "Bloc PROCEDURE '{name}' déjà déclaré pour ce champ.",
          "PROCEDURE block '{name}' already declared for this control.")
OWL_ERROR(E_SEM_DSL_PROC_DUPLICATE_IN_WINDOW, "semantic",
