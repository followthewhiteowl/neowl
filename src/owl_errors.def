OWL_ERROR(E_NATIVE_TIMER_ACTIF_READONLY, "native",
          "..Actif est en lecture seule. Utiliser TimerDémarre / TimerArrête "
          "(ou les méthodes .Démarre() / .Arrête()) pour changer l'état du "
          "timer.",
          "..Active is read-only. Use TimerStart / TimerStop (or the "
          ".Start() / .Stop() methods) to change the timer state.")

/* ================================================================
 * IO — erreurs I/O (1 code seed)
 * ================================================================ */
OWL_ERROR(E_IO_FILE_NOT_FOUND, "io",
          "Fichier introuvable : '{path}'.",
          "File not found: '{path}'.")

/* ================================================================
 * WARNING — diagnostics compile-time non-bloquants ( jalon D)
 *
 * Le prefixe W_ distingue visuellement les warnings des erreurs (E_*).
 * Categorie "warning" ajoutee a rule 42. Ces codes sont emis via
 * `owl_emit_warning_at()` qui ne marque PAS parser.hadError.
 * ================================================================ */

/* --- Variables non utilisees / shadowing --- */
OWL_ERROR(W_SEM_VAR_UNUSED, "warning",
          "Variable '{name}' est déclarée mais jamais utilisée.",
          "Variable '{name}' is declared but never used.")
OWL_ERROR(W_SEM_VAR_SHADOWS_CONST, "warning",
          "La variable '{name}' shadow la constante native "
          "'{canonical}'. La constante n'est plus accessible dans ce "
          "scope (la résolution canon casse+accents fait gagner la "
          "variable). Renommer la variable si la constante doit rester "
          "utilisable, ou utiliser une valeur littérale équivalente "
          "(ex. Caract(9) pour TAB).",
          "Variable '{name}' shadows native constant '{canonical}'. "
          "The constant is no longer accessible in this scope (canon case+accents resolution prefers the local variable). "
          "Rename the variable if the constant must remain reachable, or use an equivalent literal (e.g. Caract(9) for TAB).")
/*  — distinct de W_SEM_VAR_SHADOWS_CONST : '{legacy}' n'est plus une
 * constante du registre, seulement une forme acceptee qui vaut CRLF. Le
 * message ne doit donc pas parler de "constante native", et surtout pas
 * nommer CRLF comme la chose masquee : le user n'a pas ecrit CRLF. */
OWL_ERROR(W_SEM_VAR_SHADOWS_EOL_LEGACY, "warning",
          "La variable '{name}' masque la forme héritée '{legacy}', "
          "qui désigne une fin de ligne et vaut '{canonical}'. Dans ce "
          "scope, '{legacy}' résout vers la variable, pas vers une fin "
          "de ligne. Renommer la variable, ou écrire '{canonical}' là "
          "où une fin de ligne est attendue.",
          "Variable '{name}' shadows the legacy form '{legacy}', which stands for an end of line and equals '{canonical}'. "
          "In this scope, '{legacy}' resolves to the variable, not to an end of line. "
          "Rename the variable, or write '{canonical}' where an end of line is expected.")
OWL_ERROR(W_SEM_FIELD_SHADOWS_INHERITED, "warning",
          "Le champ '{field}' de la classe '{class}' masque un champ de "
          "même nom déclaré dans la classe '{parent}' (héritage). "
          "Choisir un nom différent ou retirer la redéclaration.",
          "Field '{field}' of class '{class}' shadows a field of the same "
          "name declared in class '{parent}' (inheritance). Choose a "
          "different name or remove the redeclaration.")
/*  — La methode '{method}' de la classe '{class}' a le meme nom
 * qu'une procedure/fonction globale. Depuis le body d'une methode soeur,
 * l'appel nu `{method}(...)` resout la methode locale (la plus proche
 * gagne) et masque la globale. */
OWL_ERROR(W_SEM_METHOD_SHADOWS_GLOBAL_PROC, "warning",
          "La méthode '{method}' de la classe '{class}' masque une "
          "procédure globale de même nom. Depuis une méthode sœur, "
          "l'appel nu '{method}(...)' résout la méthode locale ; la "
          "globale reste accessible depuis le code hors classe.",
          "Method '{method}' of class '{class}' shadows a global procedure "
          "with the same name. From a sibling method, the bare call "
          "'{method}(...)' resolves to the local method; the global "
          "procedure remains reachable from code outside the class.")

/*  — Icone non-coloriable : pattern direct `icones.X..Couleur = ...`
 * ou variante locale taggee, ou X est classifiee non-coloriable par
 * l'heuristique du catalogue (couleur_modifiable=false). Warning DX
 * pedagogique pour eviter le silent ignore au rendu. */
OWL_ERROR(W_SEM_ICONE_NOT_COLORABLE, "warning",
          "L'icône '{set}/{nom}' n'est pas coloriable. Le SVG embarque "
          "des couleurs fixes ; l'assignation '..Couleur = ...' sera "
          "ignorée au rendu.",
          "Icon '{set}/{nom}' is not colorable. The SVG embeds fixed "
          "colors; the '..Color = ...' assignment will be ignored at "
          "render time.")

/*  — BorneMax/BorneMin (bornes de valeur numerique) declarees sur un
 * Champ Saisie dont l'InputType effectif n'est pas bornable (tout sauf
 * numerique/monetaire/numerique precis). La borne est ignoree en silence au
 * runtime (cf. stdlib_ui.c : validateur pose seulement pour ces 3 types).
 * Message FR fixe ancre sur le token de la borne, quel que soit l'alias
 * source (FR/EN). Cross-propriete : emis apres le parse complet du bloc. */
OWL_ERROR(W_SEM_BOUND_MAX_NOT_NUMERIC, "warning",
          "BorneMax n'a pas d'effet sur ce champ de saisie ; cette borne ne "
          "s'applique qu'aux champs numériques ou monétaires.",
          "MaxValue has no effect on this input field; this bound only "
          "applies to numeric or currency fields.")
OWL_ERROR(W_SEM_BOUND_MIN_NOT_NUMERIC, "warning",
          "BorneMin n'a pas d'effet sur ce champ de saisie ; cette borne ne "
          "s'applique qu'aux champs numériques ou monétaires.",
          "MinValue has no effect on this input field; this bound only "
          "applies to numeric or currency fields.")

/*  (support #378) — ColSpan/RowSpan (fusion de cellules) declares sur
 * un champ dont le parent (fenetre ou conteneur) n'est PAS en
 * Disposition = dispGrille. Ces props n'ont d'effet qu'en grille ; ailleurs
 * (dispVerticale par defaut, dispLibre, dispHorizontale) elles sont ignorees
 * en silence au rendu. Warning non-bloquant, mirroir du check X/Y hors
 * dispLibre. Message ancre sur le canon FR (ColSpan/RowSpan) meme si la source
 * emploie l'alias EN (ColumnSpan) — 2 codes distincts pour la parite bilingue
 * (comme W_SEM_BOUND_MAX/MIN, cf. ). */
OWL_ERROR(W_SEM_COLSPAN_NOT_GRILLE, "warning",
          "'{name}' : ColSpan sans effet — {parent} n'est pas en "
          "Disposition = dispGrille. Retire ColSpan, ou pose "
          "'Disposition = dispGrille' sur le parent pour que le "
          "positionnement en grille s'applique.",
          "'{name}': ColumnSpan has no effect — {parent} is not in "
          "Layout = dispGrid. Remove ColumnSpan, or set "
          "'Layout = dispGrid' on the parent so that grid positioning "
          "applies.")
OWL_ERROR(W_SEM_ROWSPAN_NOT_GRILLE, "warning",
          "'{name}' : RowSpan sans effet — {parent} n'est pas en "
          "Disposition = dispGrille. Retire RowSpan, ou pose "
          "'Disposition = dispGrille' sur le parent pour que le "
          "positionnement en grille s'applique.",
          "'{name}': RowSpan has no effect — {parent} is not in "
          "Layout = dispGrid. Remove RowSpan, or set "
          "'Layout = dispGrid' on the parent so that grid positioning "
          "applies.")

/* --- Litteraux et arguments suspects --- */
OWL_ERROR(W_SEM_ENUM_LITERAL_NUMERIC, "warning",
          "Littéral numérique passé à un paramètre enum "
          "'{enumName}'. Utiliser une constante nommée (ex: {example}) "
          "— sinon piège de magie d'entier.",
          "Numeric literal passed to enum parameter '{enumName}'. Use a "
          "named constant instead (e.g., {example}) — otherwise prone to "
          "integer-magic bugs.")

/*  — Deux champs d'une meme fenetre declarent le meme raccourci
 * clavier (ToucheRaccourci explicite OU mnemonic '&Lettre' du libelle d'un
 * bouton). Warning de lint : le code compile, mais le raccourci est ambigu
 * au runtime (un seul champ le recevra). Emis sur le 2e site. */
OWL_ERROR(W_SEM_SHORTCUT_DUPLICATE, "warning",
          "Raccourci '{raccourci}' déjà utilisé par un autre champ de "
          "cette fenêtre.",
          "Shortcut '{raccourci}' is already used by another field in "
          "this window.")

/*  — le projet a active la propriete opt-in
 * ActiveAvertissementConventionDeNommage : un champ dont le nom ne commence
 * pas par le prefixe canonique de son type
 * declenche cet avertissement. Non bloquant (le champ compile). */
OWL_ERROR(W_SEM_FIELD_NONCANONICAL_PREFIX, "warning",
          "Le champ '{nom}' est un Champ {type} : le préfixe canonique "
          "attendu est '{prefixe}'.",
          "Field '{nom}' is a {type} control: the expected canonical prefix "
          "is '{prefixe}'.")

/* --- Constructions non encore supportees (Fenetre / Etat / Table) --- */
OWL_ERROR(W_SEM_PROP_POSITION_LITERAL_NOT_SUPPORTED, "warning",
          "Propriété '{prop}' (Position) : init littéral non "
          "supporté à ce jour. Skip — defaults appliqués (0, 0).",
          "Property '{prop}' (Position): literal init not yet supported. "
          "Skipped — defaults applied (0, 0).")
OWL_ERROR(W_SEM_PROP_COLUMN_DYNAMIC_NOT_SUPPORTED, "warning",
          "Propriété colonne '{prop}' : expression dynamique non "
          "encore supportée à ce jour. Init ignorée.",
          "Column property '{prop}': dynamic expression not yet "
          "supported. Init ignored.")
OWL_ERROR(W_SEM_PROP_DYNAMIC_NOT_SUPPORTED, "warning",
          "Propriété '{prop}' : expression dynamique non supportée "
          "pour le moment. Init ignorée.",
          "Property '{prop}': dynamic expression not supported yet. "
          "Init ignored.")
OWL_ERROR(W_SEM_FIELD_LOCAL_VAR_IGNORED, "warning",
          "Variable locale au champ : ignorée à ce jour (variables "
          "sont au niveau fenêtre). Skip.",
          "Local variable inside a field: ignored for now (variables "
          "live at window scope). Skipped.")
OWL_ERROR(W_SEM_FIELD_BODY_UNKNOWN, "warning",
          "Construction inconnue dans le corps de champ. Skip ligne.",
          "Unknown construct in field body. Line skipped.")
OWL_ERROR(W_SEM_WINDOW_BODY_UNKNOWN, "warning",
          "Construction inconnue dans le corps de fenêtre. Skip ligne.",
          "Unknown construct in window body. Line skipped.")
OWL_ERROR(W_SEM_PREDEFINED_BLOCK_PARAMS_IGNORED, "warning",
          "Bloc prédéfini '{block}' : arguments non supportés à ce "
          "jour (DemandeMiseAJour avec params sera ajouté plus tard). "
          "Params ignorés.",
          "Predefined block '{block}': arguments not supported yet "
          "(DemandeMiseAJour with params will be added later). Params "
          "ignored.")
OWL_ERROR(W_SEM_ETAT_SUBFIELD_EVENT_PARAMS_IGNORED, "warning",
          "Events de sous-champ d'État : pas de paramètre. Ignorés.",
          "Report sub-field events take no parameter. Ignored.")
OWL_ERROR(W_SEM_DSL_SERVICE_AUTH_NON_APPLIQUEE, "warning",
          "Authentification '{scheme}' déclarée sans handler "
          "'surAuthentification' : le service n'est pas protégé et répond à "
          "toutes les requêtes. Ajouter un handler 'surAuthentification' pour "
          "appliquer le schéma.",
          "Authentication '{scheme}' declared without an 'onAuthentication' "
          "handler: the service is unprotected and answers every request. Add "
          "an 'onAuthentication' handler to enforce the scheme.")

/* ================================================================
 * SEMANTIC — classes / interfaces / heritage ( paquet 1)
 *
 * Sites synthetic tokens autour des declarations de classe et des
 * cross-checks interface/abstrait. Le Token synthetique pointe sur le
 * nom de classe construit a partir des registres g_class_* (pas un
 * Token reel du parser).
 * ================================================================ */
OWL_ERROR(E_SEM_UNKNOWN_TYPE, "semantic",
          "Type inconnu '{name}'. Déclare une "
          "STRUCTURE/CLASSE/ENUMERATION ou vérifie la casse.",
          "Unknown type '{name}'. Declare a STRUCTURE/CLASSE/ENUMERATION "
          "or check the case.")
OWL_ERROR(E_SEM_INTERFACE_METHOD_MISSING, "semantic",
          "La classe '{class}' implémente l'interface '{interface}' "
          "mais ne fournit pas la méthode '{method}' signée dans "
          "l'interface.",
          "Class '{class}' implements interface '{interface}' but does "
          "not provide method '{method}' declared by the interface.")
OWL_ERROR(E_SEM_INTERFACE_PARAM_COUNT_MISMATCH, "semantic",
          "La méthode '{method}' de la classe '{class}' ne respecte pas "
          "la signature de l'interface '{interface}' (attendu : "
          "{expected} paramètre(s), trouvé : {got}).",
          "Method '{method}' of class '{class}' does not match the "
          "interface '{interface}' signature (expected: {expected} "
          "parameter(s), got: {got}).")
OWL_ERROR(E_SEM_INTERFACE_RETURN_TYPE_MISMATCH, "semantic",
          "La méthode '{method}' de la classe '{class}' ne respecte pas "
          "la signature de l'interface '{interface}' (type de retour "
          "attendu : '{expected}', trouvé : '{got}').",
          "Method '{method}' of class '{class}' does not match the "
          "interface '{interface}' signature (expected return type: "
          "'{expected}', got: '{got}').")
OWL_ERROR(E_SEM_INTERFACE_PARAM_TYPE_MISMATCH, "semantic",
          "La méthode '{method}' de la classe '{class}' ne respecte pas "
          "la signature de l'interface '{interface}' (paramètre "
          "{position} : type attendu '{expected}', trouvé '{got}').",
          "Method '{method}' of class '{class}' does not match the "
          "interface '{interface}' signature (parameter {position}: "
          "expected type '{expected}', got '{got}').")
OWL_ERROR(E_SEM_ABSTRACT_METHOD_NOT_REDEFINED, "semantic",
          "La classe '{class}' n'est pas abstraite mais hérite de la "
          "méthode abstraite '{method}' de '{parent}' sans la "
          "redéfinir.",
          "Class '{class}' is not abstract but inherits the abstract "
          "method '{method}' from '{parent}' without redefining it.")

/* ================================================================
 * SEMANTIC — limites bytecode + sites parser tricky ( paquet 2)
 *
 * Limites compile-time internes (chunks bytecode, jump offsets) qui ne
 * sont pas couvertes par owl_limits.def car ce sont des limites
 * encoding bytecode (UINT8/UINT16), pas des limites configurables.
 * Exception : le pool de constantes est declare (MAX_CHUNK_CONSTANTS) — sa
 * valeur est introspectable et le message y renvoie l'utilisateur.
 * ================================================================ */
OWL_ERROR(E_SEM_SCANNER_LEX_ERROR, "semantic",
          "{message}",
          "{message}")
OWL_ERROR(E_SEM_BYTECODE_TOO_MANY_CONSTANTS, "semantic",
          "Trop de constantes dans un même fichier (max 65535). "
          "Voir 'owl explain MAX_CHUNK_CONSTANTS'.",
          "Too many constants in a single file (max 65535). "
          "See 'owl explain MAX_CHUNK_CONSTANTS'.")
OWL_ERROR(E_SEM_INTERNAL_BYTECODE_SHAPE, "semantic",
          "Erreur interne : forme d'instruction inattendue à la génération "
          "du code.",
          "Internal: unexpected instruction shape during code generation.")
OWL_ERROR(E_SEM_BYTECODE_JUMP_TOO_LARGE, "semantic",
          "Trop de code à sauter (offset > 65535).",
          "Too much code to jump over (offset > 65535).")
OWL_ERROR(E_SEM_BYTECODE_LOOP_BODY_TOO_LARGE, "semantic",
          "Corps de boucle trop volumineux (offset > 65535).",
          "Loop body too large (offset > 65535).")
OWL_ERROR(E_SEM_BYTECODE_AVEC_FILTER_TOO_LARGE, "semantic",
          "Condition AVEC trop volumineuse pour un filtre inline.",
          "WITH condition bytecode too large for inline filter.")
OWL_ERROR(E_SEM_OUT_PARAM_NOT_SIMPLE_VAR, "semantic",
          "L'argument out-param doit être une variable simple "
          "(out-param requis pour cette fonction).",
          "Out-param argument must be a simple variable (out-param "
          "required for this function).")
OWL_ERROR(E_SEM_RETURN_KEYWORD_MIX, "semantic",
          "Mélange interdit '{first}' / '{this}' dans le même "
          "traitement. Premier '{first}' vu ligne {line}. Choisir un "
          "seul keyword pour la procédure.",
          "Mixed '{first}' / '{this}' forbidden in the same routine. "
          "First '{first}' seen on line {line}. Pick one keyword for "
          "the procedure.")
OWL_ERROR(E_SYNTAX_WIDGET_TOKEN_AT_STATEMENT_START, "syntax",
          "'{kind}' ne peut pas être en début de statement. Utiliser "
          "la syntaxe 'IDENT est un/une {kind} ... FIN'.",
          "'{kind}' cannot start a statement. Use the syntax "
          "'IDENT is a {kind} ... END'.")

/* ================================================================
 * SEMANTIC — struct/class field & method access ( paquet 3)
 *
 * Sites dot access dynamique : champ inexistant + liste fields,
 * visibilite POO (PRIVE/PROTEGE), discrimination prop/methode +
 * notation point/double-point. La liste des fields/proprietes
 * disponibles est pre-construite cote appelant et injectee comme
 * placeholder unique {fields_list} (strategie -compatible).
 * ================================================================ */
OWL_ERROR(E_SEM_STRUCT_USE_SIMPLE_DOT, "semantic",
          "'{type}' est une structure : utiliser '.{field}' (membre) et "
          "non '..{field}' (propriété).",
          "'{type}' is a structure: use '.{field}' (member) instead of "
          "'..{field}' (property).")
OWL_ERROR(E_SEM_CLASS_USE_SIMPLE_DOT, "semantic",
          "'{type}' est une classe : utiliser '.{field}' (membre) et "
          "non '..{field}' (propriété).",
          "'{type}' is a class: use '.{field}' (member) instead of "
          "'..{field}' (property).")
OWL_ERROR(E_SEM_JSON_USE_SIMPLE_DOT, "semantic",
          "'{field}' est un membre JSON : utiliser '.{field}' (membre) "
          "et non '..{field}' (propriété).",
          "'{field}' is a JSON member: use '.{field}' (member) instead "
          "of '..{field}' (property).")
OWL_ERROR(E_SEM_STRUCT_FIELD_UNKNOWN, "semantic",
          "Champ '{field}' inexistant sur structure '{type}'{fields_list}.",
          "Field '{field}' does not exist on structure '{type}'{fields_list}.")
OWL_ERROR(E_SEM_MEMBER_PRIVATE, "semantic",
          "Le membre '{field}' de la classe '{class}' est PRIVÉ — "
          "accès interdit depuis l'extérieur de la classe.",
          "Member '{field}' of class '{class}' is PRIVATE — access "
          "forbidden from outside the class.")
OWL_ERROR(E_SEM_MEMBER_PROTECTED, "semantic",
          "Le membre '{field}' de la classe '{class}' est PROTÉGÉ — "
          "accès autorisé uniquement depuis la classe ou ses "
          "dérivées.",
          "Member '{field}' of class '{class}' is PROTECTED — access "
          "only allowed from the class or its derivatives.")
OWL_ERROR(E_SEM_PROP_NOT_A_METHOD, "semantic",
          "'{field}' est une propriété de {type}, pas une méthode — "
          "pas d'appel '()'.",
          "'{field}' is a property of {type}, not a method — no '()' call.")
OWL_ERROR(E_SEM_METHOD_USE_SIMPLE_DOT, "semantic",
          "'{field}' est une méthode de {type} — utiliser '.{field}()' "
          "(simple point), pas '..{field}'.",
          "'{field}' is a method of {type} — use '.{field}()' (single "
          "dot), not '..{field}'.")
OWL_ERROR(E_SEM_METHOD_MISSING_PARENS, "semantic",
          "'{field}' est une méthode de {type} — ajoute les parenthèses "
          "'.{field}()' pour l'appeler.",
          "'{field}' is a method of {type} — add parentheses "
          "'.{field}()' to call it.")
OWL_ERROR(E_SEM_PROP_USE_DOUBLE_DOT, "semantic",
          "'{field}' est une propriété de {type} — utiliser '..{field}' "
          "(double point), pas '.{field}'.",
          "'{field}' is a property of {type} — use '..{field}' (double "
          "dot), not '.{field}'.")
OWL_ERROR(E_SEM_PROP_NO_PARENS, "semantic",
          "'{field}' est une propriété de {type}, pas une méthode — "
          "utiliser '..{field}' sans parenthèses.",
          "'{field}' is a property of {type}, not a method — use "
          "'..{field}' without parentheses.")
OWL_ERROR(E_SEM_UNKNOWN_MEMBER, "semantic",
          "Membre '{field}' inexistant sur {type}. Propriétés disponibles : {fields_list}.",
          "Member '{field}' does not exist on {type}. Available "
          "properties: {fields_list}.")
OWL_ERROR(E_SEM_UNKNOWN_MEMBER_NO_FIELDS, "semantic",
          "Membre '{field}' inexistant sur {type}.",
          "Member '{field}' does not exist on {type}.")
OWL_ERROR(E_SEM_CLASS_CONSTANT_READ_ONLY, "semantic",
          "La constante '{field}' de la classe '{class}' est en lecture "
          "seule — modification interdite.",
          "Constant '{field}' of class '{class}' is read-only — "
          "modification forbidden.")
/* Note : pas d'accents a restaurer ici, le legacy disait deja "constante" et
 * "lecture seule" sans accents. */
OWL_ERROR(E_SEM_METHOD_PRIVATE, "semantic",
          "La méthode '{method}' de la classe '{class}' est PRIVÉ — "
          "accès interdit depuis l'extérieur de la classe (déclarée "
          "ligne {line}).",
          "Method '{method}' of class '{class}' is PRIVATE — access "
          "forbidden from outside the class (declared on line {line}).")
OWL_ERROR(E_SEM_METHOD_PROTECTED, "semantic",
          "La méthode '{method}' de la classe '{class}' est PROTÉGÉ "
          "— accès autorisé uniquement depuis la classe ou ses "
          "dérivées (déclarée ligne {line}).",
          "Method '{method}' of class '{class}' is PROTECTED — access "
          "only allowed from the class or its derivatives (declared on "
          "line {line}).")

/* ================================================================
 * SEMANTIC — DSL Fenetre / sous-champs ( paquet 4)
 *
 * Validation prop type/enum/inconnue + body Fenetre + nesting widgets.
 * Codes consolides reutilises sur OwlTypeDef + builtin kind + colonnes.
 * ================================================================ */
OWL_ERROR(E_SEM_DSL_PROP_TYPE_INCOMPATIBLE, "semantic",
          "Propriété '{prop}' attend {expected}, type incompatible.",
          "Property '{prop}' expects {expected}, incompatible type.")
OWL_ERROR(E_SEM_DSL_PROP_VALUE_BARE_WORDS, "semantic",
          "Valeur de la propriété '{prop}' invalide : une valeur littérale "
          "est attendue (guillemets manquants autour d'une chaîne ?).",
          "Invalid value for property '{prop}': a literal value is expected "
          "(missing quotes around a string?).")
OWL_ERROR(E_SEM_DSL_ENUM_VALUE_INVALID, "semantic",
          "'{value}' n'est pas une valeur valide de {enumName}.",
          "'{value}' is not a valid value of {enumName}.")
OWL_ERROR(E_SEM_DSL_PROP_UNKNOWN_FOR_WINDOW, "semantic",
          "Propriété '{prop}' inconnue pour Fenêtre. Lister les propriétés "
          "autorisées avec « owl explain Fenêtre ».",
          "Property '{prop}' unknown for Window. List the allowed "
          "properties with 'owl explain Window'.")
OWL_ERROR(E_SEM_DSL_PROP_UNKNOWN_FOR_KIND, "semantic",
          "Propriété '{prop}' inconnue pour {kind}. Lister les propriétés "
          "autorisées avec « owl explain » suivi du type de l'élément.",
          "Property '{prop}' unknown for {kind}. List the allowed "
          "properties with 'owl explain' followed by the element type.")
OWL_ERROR(E_SEM_DSL_PROP_READONLY_RUNTIME, "semantic",
          "Propriété '{prop}' en lecture seule au runtime : définie en "
          "PROPRIETES (design), elle ne peut pas être réassignée en code "
          "impératif. Modifier l'état du champ à l'exécution via ses "
          "propriétés runtime (..Valeur, ..Contenu) ou ses méthodes "
          "(.Ajoute()).",
          "Property '{prop}' is read-only at runtime: set in PROPERTIES "
          "(design), it cannot be reassigned in imperative code. Change the "
          "field's state at runtime through its runtime properties "
          "(..Value, ..Content) or its methods (.Add()).")
OWL_ERROR(E_SEM_DSL_PROP_IDENTITY_READONLY, "semantic",
          "Propriété '{prop}' en lecture seule : le nom est l'identité "
          "déclarée du champ, fixée par sa déclaration, elle ne peut pas "
          "être réassignée en code.",
          "Property '{prop}' is read-only: the name is the field's declared "
          "identity, fixed by its declaration, and cannot be reassigned in "
          "code.")
OWL_ERROR(E_SEM_DSL_OBJECT_PROP_FIELD_UNKNOWN, "semantic",
          "Champ '{field}' inconnu sur type {type}. Champs disponibles : {fields_list}.",
          "Field '{field}' unknown on type {type}. Available fields: {fields_list}.")
OWL_ERROR(E_SEM_PROJET_METADATA_NOT_CONSTANT, "semantic",
          "Métadonnée projet '{name}' : la valeur doit être une "
          "constante (littéral, constante nommée ou expression "
          "constante), pas un appel de fonction ni une variable. Les "
          "métadonnées du projet doivent rester lisibles sans "
          "exécuter de code.",
          "Project metadata '{name}': the value must be a constant (literal, "
          "named constant or constant expression), not a function call or a "
          "variable. Project metadata must stay readable without running code.")
OWL_ERROR(E_SEM_PROJET_LANGUE_INCONNUE, "semantic",
          "'{langue}' n'est pas une constante langue officielle. Le champ "
          "Langues n'accepte que des constantes langueXxx connues "
          "(langueFran\xc3\xa7" "ais, langueAnglais, langueAllemand...).",
          "'{langue}' is not an official language constant. The Languages "
          "field only accepts known langueXxx constants (langueFrancais, "
          "langueAnglais, langueAllemand...).")
OWL_ERROR(E_SEM_PROJET_LANGUES_DOUBLON, "semantic",
          "La langue '{langue}' est d\xc3\xa9" "clar\xc3\xa9" "e plusieurs fois "
          "dans le champ Langues (doublon apr\xc3\xa8s normalisation BCP 47). "
          "Chaque langue ne doit appara\xc3\xaetre qu'une fois.",
          "Language '{langue}' is declared more than once in the Languages "
          "field (duplicate after BCP 47 normalization). Each language must "
          "appear only once.")
OWL_ERROR(E_SEM_PROJET_LANGUES_SCALAIRE, "semantic",
          "Le champ Langues n'accepte que la forme liste, m\xc3\xaame pour "
          "une seule langue. Utiliser Langues = [langueFran\xc3\xa7" "ais].",
          "The Languages field only accepts the list form, even for a "
          "single language. Use Languages = [languageFrench].")
OWL_ERROR(E_SEM_PROJET_LANGUES_VIDE, "semantic",
          "Le champ Langues doit d\xc3\xa9" "clarer au moins une langue "
          "(ex. : Langues = [langueFran\xc3\xa7" "ais]).",
          "The Languages field must declare at least one language "
          "(e.g. Languages = [languageFrench]).")
OWL_ERROR(E_SEM_PROJET_LANGUES_MANQUANT, "semantic",
          "Le projet doit d\xc3\xa9" "clarer au moins une langue via le champ "
          "Langues (ex. : Langues = [langueFran\xc3\xa7" "ais]).",
          "The project must declare at least one language through the "
          "Languages field (e.g. Languages = [languageFrench]).")
OWL_ERROR(E_SEM_PROJET_PROPRIETES_MANQUANT, "semantic",
          "Bloc PROPRIETES obligatoire dans le Projet '{name}' "
          "('PROPRIETES ... FIN', avec au moins le champ Langues).",
          "PROPERTIES block required in Project '{name}' "
          "('PROPERTIES ... END', with at least the Languages field).")
OWL_ERROR(E_SEM_PROJET_TOPLEVEL_CODE_BEFORE, "semantic",
          "Un fichier-projet ne peut contenir que le bloc Projet. "
          "D\xc3\xa9" "placer cette instruction DANS le bloc Projet, "
          "apr\xc3\xa8s PROPRIETES (c'est l\xc3\xa0 que vit le programme "
          "d'initialisation).",
          "A project file may only contain the Project block. Move this "
          "statement INTO the Project block, after PROPERTIES (that is "
          "where the initialization program lives).")
OWL_ERROR(E_SEM_PROJET_TOPLEVEL_CODE_AFTER, "semantic",
          "Un fichier-projet ne peut contenir que le bloc Projet. "
          "D\xc3\xa9" "placer cette instruction DANS le bloc Projet, "
          "avant son FIN final (c'est l\xc3\xa0 que vit le programme "
          "d'initialisation).",
          "A project file may only contain the Project block. Move this "
          "statement INTO the Project block, before its final END (that is "
          "where the initialization program lives).")
OWL_ERROR(E_SEM_PROJET_USER_PROC_FORBIDDEN, "semantic",
          "La proc\xc3\xa9" "dure '{name}' ne peut pas \xc3\xaatre "
          "d\xc3\xa9" "clar\xc3\xa9" "e dans le bloc Projet. Seul "
          "l'\xc3\xa9v\xc3\xa9nement Fermeture y est autoris\xc3\xa9. "
          "Utiliser une classe ou une collection de proc\xc3\xa9" "dures "
          "pour du code partag\xc3\xa9.",
          "The procedure '{name}' cannot be declared inside the Project "
          "block. Only the Fermeture event is allowed there. Use a class "
          "or a procedure collection for shared code.")
OWL_ERROR(E_SEM_PROJET_BLOC_MANQUANT, "semantic",
          "Un fichier 'projet.owl' (nom r\xc3\xa9serv\xc3\xa9) doit "
          "d\xc3\xa9" "clarer un bloc 'est un Projet ... FIN'. Ajouter la "
          "d\xc3\xa9" "claration du projet, ou renommer le fichier s'il ne "
          "s'agit pas d'un projet.",
          "A file named 'project.owl' (reserved name) must declare an "
          "'is a Project ... END' block. Add the project declaration, or "
          "rename the file if it is not a project.")
OWL_ERROR(E_SEM_PROJET_MARQUEURS_AMBIGUS, "semantic",
          "Deux marqueurs de projet dans ce dossier ('projet.owl' et "
          "'project.owl') : garder une seule graphie.",
          "Two project markers in this folder ('projet.owl' and "
          "'project.owl'): keep a single spelling.")
OWL_ERROR(E_SEM_DUREE_COMPOSANTE_UNKNOWN, "semantic",
          "'{composante}' : composante inconnue pour le type "
          "dur\xc3\xa9" "e. Composantes valides : Jour, Heure, Minute, "
          "Seconde, Milliseconde.",
          "'{composante}': unknown component for the duration type. "
          "Valid components: Jour, Heure, Minute, Seconde, Milliseconde.")
OWL_ERROR(E_SEM_DUREE_COMPOSANTE_DOUBLON, "semantic",
          "Composante '{composante}' d\xc3\xa9" "j\xc3\xa0 pr\xc3\xa9" "sente "
          "dans ce litt\xc3\xa9" "ral dur\xc3\xa9" "e.",
          "Component '{composante}' already present in this duration literal.")
OWL_ERROR(E_SEM_DSL_OBJECT_PROP_SCALAR, "semantic",
          "Type '{type}' attendu, obtenu '{got}'.",
          "Type '{type}' expected, got '{got}'.")
/*  — configuration de séparateurs contradictoire dans un FormatNombre :
 * milliers == décimal (ambigu au dé-formatage) ou un séparateur qui est un
 * chiffre (indistinguable des chiffres du nombre). Levé au compile (bloc Projet)
 * et au runtime (champ Saisie / affectation dynamique). */
OWL_ERROR(E_SEM_FORMAT_NOMBRE_SEP_INVALIDE, "semantic",
          "Configuration FormatNombre invalide : le séparateur '{sep}' est "
          "refusé (les séparateurs de milliers et décimal doivent différer et "
          "ne peuvent pas être un chiffre).",
          "Invalid FormatNombre configuration: separator '{sep}' is refused "
          "(the thousands and decimal separators must differ and cannot be a "
          "digit).")
/*  — configuration FormatMonétaire absurde : un séparateur ou le
 * symbole qui est un chiffre (indistinguable des chiffres du montant), les deux
 * séparateurs identiques, ou le symbole égal à un séparateur (ambigu au
 * reparse). Levé au compile (bloc Projet + champ Saisie inline) et au runtime
 * (config dynamique). Miroir E_SEM_FORMAT_NOMBRE_SEP_INVALIDE, étendu au symbole. */
OWL_ERROR(E_SEM_FORMAT_MONETAIRE_CONFIG_INVALIDE, "semantic",
          "Configuration FormatMonétaire invalide : '{elem}' est refusé (le "
          "symbole et les séparateurs de milliers et décimal doivent être "
          "distincts et ne peuvent pas être un chiffre).",
          "Invalid FormatMonétaire configuration: '{elem}' is refused (the "
          "symbol and the thousands and decimal separators must be distinct and "
          "cannot be a digit).")
OWL_ERROR(E_SEM_DSL_PROP_ENUM_INT_OUT_OF_RANGE, "semantic",
          "Affectation à une propriété de type '{type}' : la valeur "
          "entière {value} ne correspond à aucune constante de cet enum.",
          "Assignment to a property of type '{type}': the integer "
          "value {value} does not match any constant of this enum.")
OWL_ERROR(E_SEM_DSL_CONTROL_NAME_DUPLICATE, "semantic",
          "Champ '{name}' : nom déjà utilisé dans la fenêtre '{window}'.",
          "Field '{name}': name already used in window '{window}'.")
/*  — deux colonnes homonymes coexistaient dans le modèle sans qu'une
 * seule soit atteignable par son nom : la première décalait silencieusement
 * les valeurs positionnelles et n'était jamais relisible. */
OWL_ERROR(E_SEM_DSL_COLUMN_NAME_DUPLICATE, "semantic",
          "Colonne '{name}' : nom déjà utilisé dans le Champ Table "
          "'{table}'.",
          "Column '{name}': name already used in Table field '{table}'.")
OWL_ERROR(E_SEM_DSL_COLONNE_OUTSIDE_TABLE, "semantic",
          "Une 'colonne' n'est valide qu'à l'intérieur d'un Champ Table.",
          "A 'column' is only valid inside a Control Table.")
OWL_ERROR(E_SEM_DSL_TABLE_NO_COLUMN, "semantic",
          "Un champ Table doit déclarer au moins une colonne.",
          "A Table field must declare at least one column.")
OWL_ERROR(E_SEM_DSL_VOLET_OUTSIDE_ONGLET, "semantic",
          "Un 'volet' n'est valide qu'à l'intérieur d'un Champ Onglet.",
          "A 'pane' is only valid inside a Control Tab.")
OWL_ERROR(E_SEM_DSL_ONGLET_NO_VOLET, "semantic",
          "Un champ Onglet doit déclarer au moins un Volet.",
          "A Tab control must declare at least one Pane.")
OWL_ERROR(E_SEM_DSL_VOLET_LIBELLE_MANQUANT, "semantic",
          "Le Volet '{name}' doit déclarer une propriété Libellé (le texte affiché sur l'onglet).",
          "Pane '{name}' must declare a Caption property (the text shown on the tab).")
OWL_ERROR(E_SEM_DSL_ONGLET_VALEUR_HORS_BORNES, "semantic",
          "La propriété Valeur ({value}) doit être comprise entre 1 et {count} (nombre de volets déclarés).",
          "The Value property ({value}) must be between 1 and {count} (number of declared panes).")
OWL_ERROR(E_SEM_DSL_SUBFIELD_NOT_VALID_IN_KIND, "semantic",
          "Sous-champ (Libellé/Bouton/Saisie/Table/Conteneur) n'est pas "
