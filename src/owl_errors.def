          "Variable de position attendue après ','.",
          "Expected a position variable after ','.")
OWL_ERROR(E_SYNTAX_EXP_POSITION_VAR, "syntax",
          "Variable de position attendue après 'POUR TOUTE POSITION'.",
          "Expected a position variable after 'FOR EACH POSITION'.")
OWL_ERROR(E_SYNTAX_EXP_PROC_NAME, "syntax",
          "Nom de PROCEDURE / FONCTION attendu.",
          "Expected a PROCEDURE / FUNCTION name.")
OWL_ERROR(E_SYNTAX_EXP_SUBSTRING_VAR, "syntax",
          "Variable de sous-chaîne attendue après 'POUR TOUTE CHAÎNE'.",
          "Expected a sub-string variable after 'FOR EACH STRING'.")
OWL_ERROR(E_SYNTAX_EXP_SUPERCLASS_NAME, "syntax",
          "Nom de classe parente attendu.",
          "Expected a parent class name.")
OWL_ERROR(E_SYNTAX_EXP_LOOP_VAR_NAME, "syntax",
          "Nom de variable attendu après 'POUR'.",
          "Expected a variable name after 'FOR'.")
OWL_ERROR(E_SYNTAX_EXP_RPAREN_INTERFACE_METHOD_PARAMS, "syntax",
          "')' attendu après les paramètres de la méthode d'Interface.",
          "Expected ')' after the Interface method parameters.")
OWL_ERROR(E_SYNTAX_EXP_FIN_COLLECTION, "syntax",
          "'FIN' attendu après le bloc 'CollectionDeProcédures'.",
          "Expected 'END' after the 'ProcedureCollection' block.")
/*  — une PROCEDURE membre d'une collection sans son FIN propre (seul le
 * FIN d'un bloc interne présent) désynchronisait le comptage de profondeur :
 * les membres suivants sortaient de l'index et l'erreur remontait de travers
 * ('FIN' attendu sur la collection en single-file, cascade de « procédure
 * inconnue » sur les appelants en multi-fichier). Diagnostic nominatif posé sur
 * la déclaration non fermée + recovery (la procédure est refermée au point de
 * détection pour que les membres suivants s'enregistrent normalement). */
OWL_ERROR(E_SYNTAX_FIN_MANQUANT_PROC_COLLECTION, "syntax",
          "'FIN' manquant pour la PROCEDURE '{proc}' de la collection "
          "'{collection}'.",
          "Missing 'END' for PROCEDURE '{proc}' of collection '{collection}'.")
OWL_ERROR(E_SYNTAX_EXP_RBRACE_ICONE, "syntax",
          "'}' attendu après les entrées du littéral Icône.",
          "Expected '}' after the Icon literal entries.")
OWL_ERROR(E_SEM_IMAGE_NOT_ASSIGNABLE_TO_ICONE, "semantic",
          "Impossible d'affecter une valeur de type 'Image' à une variable "
          "de type 'Icône'.",
          "Cannot assign an 'Image' value to an 'Icon' variable.")
OWL_ERROR(E_SYNTAX_THEME_BLOCK_DUPLICATE, "syntax",
          "Un seul bloc 'Thème' est autorisé par fichier.",
          "Only one 'Theme' block is allowed per file.")
OWL_ERROR(E_SYNTAX_CAPACITY_EXCEEDED, "syntax",
          "Capacité dépassée : la limite '{limite}' du compilateur est "
          "atteinte ({max}). Voir 'owl explain {limite}'.",
          "Capacity exceeded: the compiler limit '{limite}' has been "
          "reached ({max}). See 'owl explain {limite}'.")
OWL_ERROR(E_NATIVE_THEME_STYLE_UNKNOWN, "native",
          "Style '{nom}' introuvable : aucun style de ce nom dans le thème "
          "actif. Vérifier l'orthographe, et que le fichier projet désigne "
          "bien un thème (propriété 'Thème').",
          "Style '{nom}' not found: no style with this name in the active "
          "theme. Check the spelling, and that the project file does "
          "designate a theme (property 'Theme').")
/*  — pendant compile-time du code natif ci-dessus. Avertissement et
 * non erreur : le prescan voit les declarations des sources du projet, pas la
 * designation du theme (compiler_projet_designated_theme() rend NULL quand un
 * fichier fenetre est compile seul). Il ne peut donc prouver QUE l'absence de
 * declaration — le message ne dit rien de plus. Un avertissement ne bloque
 * jamais du code valide et remonte en soulignement LSP pendant la frappe. */
/*  — la marge interieure n'a de sens que face a une disposition qui
 * place les champs. En dispLibre chaque champ porte ses propres X/Y : la
 * propriete etait acceptee et sans effet, donc indebuggable. */
OWL_ERROR(E_SEM_DSL_PADDING_FORBIDDEN_LIBRE, "semantic",
          "'{name}' : la propriété '{prop}' est sans effet en "
          "Disposition = dispLibre, où chaque champ est placé par ses propres "
          "X/Y. Retirer '{prop}', ou choisir une disposition qui place les "
          "champs (dispVerticale, dispHorizontale, dispGrille).",
          "'{name}': property '{prop}' has no effect with Layout = dispFree, "
          "where each control is placed by its own X/Y. Remove '{prop}', or "
          "choose a layout that places controls (dispVertical, dispHorizontal, "
          "dispGrid).")
/*  lot 1 — `TABLE_X[ligne].COL_Y` est valide et rend la VALEUR de la
 * cellule. Un `.Prop` de plus compilait et mourait au runtime sur
 * « acces a un champ sur une valeur Null » : le message envoyait chercher un
 * probleme d'initialisation inexistant.
 *
 * Lot 2 : la mise en forme par cellule existe desormais, mais par indice de
 * colonne (`TABLE_X[ligne][colonne]..Couleur`), jamais sur la valeur rendue par
 * `.COL_Y`. Le message pointe donc la forme qui marche, avec un exemple
 * concret. L'ancien conseil `COL_X..Style = STY_Y` est retire : cette forme ne
 * resout pas au runtime (une colonne n'est pas encore un receveur), on
 * envoyait l'utilisateur dans un mur.
 *
 * Le fautif nomme est le CHEMIN, pas la propriete : la propriete ecrite est
 * souvent `Couleur`, qui figure trois lignes plus bas dans les disponibles.
 * Dire « elle ne porte pas de propriete 'Couleur' » puis « disponibles :
 * Couleur » se lit comme une contradiction. L'exemple garde `Couleur` en dur
 * (pas `{prop}`) : interpoler la propriete refusee suggererait qu'un nom
 * arbitraire marcherait sur la forme a deux indices. */
OWL_ERROR(E_SEM_TABLE_CELL_NO_PROP, "semantic",
          "Le chemin '{table}[ligne].{colonne}' désigne la valeur de la "
          "cellule, pas la cellule elle-même : aucune propriété ne s'accroche "
          "à cette valeur. Deux écritures désignent la cellule : "
          "'{table}[1][1]..Couleur = RVB(200, 0, 0)' (ligne puis numéro de "
          "colonne) et '{table}.{colonne}[1]..Couleur = RVB(200, 0, 0)' "
          "(colonne nommée puis ligne). Propriétés disponibles : Couleur et "
          "CouleurFond ; sur toute une ligne, '{table}[1]..Couleur'.",
          "Path '{table}[row].{colonne}' designates the cell value, not the "
          "cell itself: no property attaches to that value. Two forms "
          "designate the cell: '{table}[1][1]..Color = RGB(200, 0, 0)' (row "
          "then column number) and '{table}.{colonne}[1]..Color = "
          "RGB(200, 0, 0)' (named column then row). Available properties: "
          "Color and BackgroundColor; for a whole row, '{table}[1]..Color'.")
/*  lot 1 — `TABLE_X[TABLE_X]` (idiome « ligne courante ») : l'indice
 * est un nom de champ, jamais un numero de ligne. Tombait sur
 * E_RT_INDEX_NEEDS_ARRAY_OR_COMBI, inutile pour un nom de champ. */
OWL_ERROR(E_SEM_TABLE_ROW_INDEX_NOT_NUMBER, "semantic",
          "'{index}' est un nom de champ, pas un numéro de ligne : "
          "'{table}[...]' attend un indice numérique. Pour la ligne "
          "sélectionnée, écrire '{table}[TableSelect({table})]'.",
          "'{index}' is a control name, not a row number: '{table}[...]' "
          "expects a numeric index. For the selected row, write "
          "'{table}[TableSelect({table})]'.")
/*  — `TABLE_X[ligne].<nom>` et `TABLE_X.<nom>[ligne]` acceptaient
 * n'importe quel nom : le descripteur de ligne se comportait en sac de
 * proprietes dynamique (ecrit puis relu sans validation). Le pre-scan ne
 * retenait que { nom, genre } du widget, donc le compilo ignorait quelles
 * colonnes une Table porte — un nom invente, comme une colonne appartenant
 * a une AUTRE Table, passait. */
/*  — un crochet de trop sur une Table. Deux niveaux existent, pas
 * trois : `[ligne]` et `[ligne][colonne]` — la forme colonne-first
 * `.COL_Y[ligne]` designant elle aussi le 2e niveau d'un seul crochet. Au-dela,
 * le receveur est un descripteur de cellule, qui n'est pas indexable : ca
 * tombait sur E_RT_INDEX_NEEDS_ARRAY_OR_COMBI, message vrai sur le fond mais
 * qui laisse chercher un tableau la ou il y a une Table.
 *
 * Le compte de crochets n'est PAS dans le message : il vaut 3 en ligne-first et
 * 2 en colonne-first pour la meme faute, l'annoncer se contredirait. */
OWL_ERROR(E_SEM_TABLE_INDEX_TOO_DEEP, "semantic",
          "Trop d'indices sur la Table '{table}' : la cellule est déjà "
          "entièrement désignée par '{table}[1][1]' (ligne puis numéro de "
          "colonne) ou par '{table}.{colonne}[1]' (colonne nommée puis ligne), "
          "et une ligne entière par '{table}[1]'. Un indice de plus n'a plus "
          "rien à désigner.",
          "Too many indexes on Table '{table}': the cell is already fully "
          "designated by '{table}[1][1]' (row then column number) or by "
          "'{table}.{colonne}[1]' (named column then row), and a whole row by "
          "'{table}[1]'. One more index has nothing left to designate.")
OWL_ERROR(E_SEM_TABLE_CELL_UNKNOWN_COLUMN, "semantic",
          "'{nom}' n'est pas une colonne de la Table '{table}' : une cellule "
          "se désigne par le nom d'une colonne déclarée dans cette Table. "
          "Colonnes de '{table}' : {colonnes}.",
          "'{nom}' is not a column of Table '{table}': a cell is addressed by "
          "the name of a column declared in that Table. Columns of '{table}': "
          "{colonnes}.")
/*  — meme garde de validation que E_SEM_TABLE_CELL_UNKNOWN_COLUMN, mais
 * message dependant du contexte appelant : une fois la cellule (ou la ligne)
 * ENTIEREMENT designee, `..<nom>` ecrit une propriete de mise en forme, pas un
 * nom de colonne. L'ancien message parlait de colonne meme apres deux indices,
 * ce qui envoyait chercher une colonne la ou il fallait corriger la propriete. */
OWL_ERROR(E_SEM_TABLE_CELL_UNKNOWN_PROP, "semantic",
          "'{nom}' n'est pas une propriété de mise en forme de Table : seules "
          "'Couleur' et 'CouleurFond' existent (par exemple "
          "'{table}[1][1]..Couleur = RVB(200, 0, 0)').",
          "'{nom}' is not a Table formatting property: only 'Color' and "
          "'BackgroundColor' exist (for example "
          "'{table}[1][1]..Color = RGB(200, 0, 0)').")
/*  — miroir ZoneRépétée du refus cellule Table : `ZR_X[i].<nom>` doit
 * nommer un enfant declare de CETTE ZoneRépétée. Sans ca le descripteur de
 * ligne se comportait en sac de proprietes (nom invente ou enfant d'une autre
 * ZoneRépétée ecrit puis relu sans un mot). */
OWL_ERROR(E_SEM_ZR_CELL_UNKNOWN_FIELD, "semantic",
          "'{nom}' n'est pas un champ de la ZoneRépétée '{zr}' : une cellule "
          "se désigne par le nom d'un champ déclaré dans cette ZoneRépétée. "
          "Champs de '{zr}' : {champs}.",
          "'{nom}' is not a field of the Looper '{zr}': a cell is addressed by "
          "the name of a field declared in that Looper. Fields of '{zr}': "
          "{champs}.")
/*  — la forme nue `COL_X..Couleur` desucre vers
 * `TABLE_X.COL_X` au compile-time. Deux colonnes homonymes (meme nom, Tables
 * distinctes) ne peuvent pas etre desambiguisees : le canon n'offre pas de
 * forme non indexee `TABLE.COL`, on refuse et on invite a renommer. */
OWL_ERROR(E_SEM_TABLE_COLUMN_BARE_AMBIGUOUS, "semantic",
          "Colonne '{nom}' ambiguë : les Tables {tables} déclarent chacune une "
          "colonne '{nom}'. Renommer l'une des colonnes pour lever "
          "l'ambiguïté.",
          "Ambiguous column '{nom}': Tables {tables} each declare a column "
          "'{nom}'. Rename one of the columns to resolve the ambiguity.")
/*  — une colonne receveur n'accepte a chaud que
 * `Couleur`/`CouleurFond`. Les autres props declaratives (Libelle, Type,
 * Largeur, Visible, Etat) se reglent au bloc PROPRIETES : les affecter a chaud
 * recreerait le no-op silencieux que ce chantier ferme. */
OWL_ERROR(E_SEM_TABLE_COLUMN_PROP_NOT_WRITABLE, "semantic",
          "La propriété '{prop}' de la colonne '{nom}' (Table '{table}') ne "
          "peut pas être modifiée à l'exécution : seules 'Couleur' et "
          "'CouleurFond' s'affectent sur une colonne. '{prop}' se règle dans "
          "le bloc PROPRIETES de la colonne, à la déclaration.",
          "Property '{prop}' of column '{nom}' (Table '{table}') cannot be "
          "assigned at runtime: only 'Color' and 'BackgroundColor' can be set "
          "on a column. '{prop}' is set in the column's PROPRIETES block, at "
          "declaration time.")
OWL_ERROR(W_SEM_THEME_STYLE_UNDECLARED, "warning",
          "Style '{nom}' introuvable : aucun style de ce nom n'est déclaré "
          "dans le projet. Vérifier l'orthographe du nom.",
          "Style '{nom}' not found: no style with this name is declared in "
          "the project. Check the spelling of the name.")
/*  — un bloc thème qu'aucun fichier projet ne désigne est parsé valide
 * mais inerte (, comportement voulu). Ce qui manquait : le dire. La
 * condition d'émission est « AUCUN thème désigné dans le projet », pas « ce
 * bloc-ci n'est pas le désigné » — plusieurs ambiances de réserve coexistant
 * autour d'une seule désignée sont un usage prévu, pas une faute. */
OWL_ERROR(W_SEM_THEME_BLOCK_NOT_DESIGNATED, "warning",
          "Thème '{nom}' inerte : aucun fichier projet ne désigne de thème. "
          "Ses styles nommés ne seront pas résolus par 'theme.<style>' et "
          "resteront sans effet. Ajouter 'Thème = {nom}' aux propriétés du "
          "projet.",
          "Theme '{nom}' is inert: no project file designates a theme. Its "
          "named styles will not resolve through 'theme.<style>' and will "
          "have no effect. Add 'Theme = {nom}' to the project properties.")
/*  — un style de bloc theme n'a pas de nom nu ( : acces
 * UNIQUEMENT via le namespace). Le refus doit orienter : un « variable
 * inconnue » sec sur un nom que l'utilisateur lit dans son fichier est le pire
 * retour possible. Le message nomme le theme proprietaire ET la forme correcte.
 * Emis une fois, au site de lecture, avant le check d'ambiguite (deux blocs
 * declarant un homonyme ne se disputent aucun nom : chacun garde le sien). */
OWL_ERROR(E_SEM_THEME_STYLE_BARE_ACCESS, "semantic",
          "Le style '{nom}' appartient au thème '{theme}' : un style de thème "
          "n'a pas de nom nu, il s'écrit 'theme.{nom}'.",
          "Style '{nom}' belongs to theme '{theme}': a theme style has no bare "
          "name, write it as 'theme.{nom}'.")

/*  — signature d'un callback (..SurToken, ..SurÉpoque, futures)
 * verifiee a la compilation : arite + types de params EXACTS. Le message
 * nomme la procedure fautive, la propriete callback, la signature attendue
 * et celle fournie. */
OWL_ERROR(E_SEM_CALLBACK_SIGNATURE_MISMATCH, "semantic",
          "La procédure '{proc}' ne correspond pas à la signature attendue "
          "par '{prop}' : ({expected}) attendu, ({provided}) fourni.",
          "Procedure '{proc}' does not match the signature expected by "
          "'{prop}': ({expected}) expected, ({provided}) provided.")

/*  — construire un graphe qui se referme sur lui-meme est permis ; le
 * copier faisait descendre value_deep_clone sans fin (SIGSEGV muet, code 139).
 * Le message nomme la cause cote utilisateur (une valeur qui se contient
 * elle-meme), pas le mecanisme interne (recursion / copie profonde bornee). */
OWL_ERROR(E_RT_DEEP_COPY_SELF_CONTAINING, "runtime",
          "Copie impossible : cette valeur se contient elle-même (un de ses "
          "champs renvoie vers elle). Rompre ce lien avant de la copier.",
          "Cannot copy: this value contains itself (one of its fields points "
          "back to it). Break that link before copying it.")
