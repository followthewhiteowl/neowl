CC = gcc
CFLAGS = -Wall -Wextra -Werror -Wno-missing-field-initializers -std=c99 -O2 -I../src

# LSP-specific sources
# lsp_catalog_gen.c is AUTO-GENERATED by `owl --dump-lsp-catalog`.
# Regenerate after any stdlib_*.c DEFS change:
#   ../owl.exe --dump-lsp-catalog > lsp_catalog_gen.c
LSP_SOURCES = lsp_main.c lsp_server.c lsp_handlers.c lsp_json.c lsp_memory.c lsp_catalog.c lsp_catalog_gen.c

# Shared sources from owl runtime (scanner only)
SHARED_SOURCES = ../src/scanner.c

ifeq ($(OS),Windows_NT)
EXE = .exe
else
EXE =
endif

TARGET = owl-lsp$(EXE)

all: $(TARGET)

$(TARGET): $(LSP_SOURCES) $(SHARED_SOURCES)
	$(CC) $(CFLAGS) -o $@ $^

clean:
	rm -f $(TARGET) *.exe

.PHONY: all clean
