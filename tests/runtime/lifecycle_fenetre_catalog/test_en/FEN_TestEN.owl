// Fenêtre voisine — témoin alias EN pour test_lifecycle_fenetre_catalog_en.owl.
//
// Vérifie que les alias EN des lifecycle events Fenêtre (EndInitialization,
// Closing, CloseAuthorization, RequestRefresh) sont acceptés.

FEN_TestEN est une Fenêtre
	PROPRIETES
		Titre       = "Lifecycle EN"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 300
	FIN

	marqueur est une chaîne = ""

	// Alias EN des 4 events
	PROCEDURE EndInitialization()
		marqueur += "EI;"
		// Callback vers script voisin (resolution par nom nu voisinage)
		callback_verifie_en(marqueur)
	FIN

	PROCEDURE Closing()
		marqueur += "CL;"
	FIN

	PROCEDURE CloseAuthorization()
		marqueur += "CA;"
	FIN

	PROCEDURE RequestRefresh()
		marqueur += "RR;"
	FIN
FIN
