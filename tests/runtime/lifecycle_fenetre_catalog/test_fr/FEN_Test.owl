// Fenêtre voisine — ressource pour test_lifecycle_fenetre_catalog.owl.
//
// Témoin conformance catalogue lifecycle Fenêtre : les 4 events canon
// (FinInitialisation, Fermeture, AutorisationFermeture, DemandeMiseAJour)
// + alias EN doivent être acceptés par le compilateur.

FEN_Test est une Fenêtre
	PROPRIETES
		Titre       = "Catalogue lifecycle"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 300
	FIN

	// Variable globale fenêtre pour capturer la séquence d'exécution
	marqueur est une chaîne = ""

	// Event 1 : FinInitialisation (FR canon)
	PROCEDURE FinInitialisation()
		marqueur += "FI;"
		// Callback vers script voisin (resolution par nom nu voisinage)
		callback_verifie(marqueur)
	FIN

	// Event 2 : Fermeture (FR canon)
	PROCEDURE Fermeture()
		marqueur += "FER;"
	FIN

	// Event 3 : AutorisationFermeture (FR canon)
	PROCEDURE AutorisationFermeture()
		marqueur += "AF;"
	FIN

	// Event 4 : DemandeMiseAJour (FR canon)
	PROCEDURE DemandeMiseAJour()
		marqueur += "DM;"
	FIN
FIN
