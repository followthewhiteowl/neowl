//  — trois Champs Onglet identiques, seul l'arrondi des languettes
// change (0, 8, 16). Chacun porte un CadreExtérieur : c'est la présence de
// cet habillage du cadre qui fait remonter le liseré de jonction de la barre
// au ras du bord haut des languettes, là où un coin arrondi le laisse voir.
//
// Le fond rouge du volet actif sert de témoin : sur la ligne du haut, la
// languette plate le couvre entièrement, la languette arrondie laisse
// apparaître le fond de la barre dans ses coins.

FEN_OngletCoinsBarre est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 520
		Hauteur     = 480
		Titre       = "Coins des languettes et liseré de barre"
	FIN

	ONG_Coins0 est un Champ Onglet
		PROPRIETES
			X       = 0
			Y       = 0
			Largeur = 480
			Hauteur = 140
			Valeur  = 1

			Style..CadreExtérieur..CouleurFond      = Blanc
			Style..CadreExtérieur..Cadre..Couleur   = Vert
			Style..CadreExtérieur..Cadre..Epaisseur = 2

			Style..VoletActif..CouleurFond   = Rouge
			Style..VoletActif..Couleur       = Noir
			Style..VoletActif..Arrondi       = 0
			Style..VoletInactif..CouleurFond = Bleu
			Style..VoletInactif..Couleur     = Blanc
			Style..VoletInactif..Arrondi     = 0
		FIN

		VOL_Coins0Un est un Volet
			PROPRIETES
				Libellé     = "Profil"
				Disposition = dispLibre
			FIN
		FIN

		VOL_Coins0Deux est un Volet
			PROPRIETES
				Libellé     = "Options"
				Disposition = dispLibre
			FIN
		FIN
	FIN

	ONG_Coins8 est un Champ Onglet
		PROPRIETES
			X       = 0
			Y       = 160
			Largeur = 480
			Hauteur = 140
			Valeur  = 1

			Style..CadreExtérieur..CouleurFond      = Blanc
			Style..CadreExtérieur..Cadre..Couleur   = Vert
			Style..CadreExtérieur..Cadre..Epaisseur = 2

			Style..VoletActif..CouleurFond   = Rouge
			Style..VoletActif..Couleur       = Noir
			Style..VoletActif..Arrondi       = 8
			Style..VoletInactif..CouleurFond = Bleu
			Style..VoletInactif..Couleur     = Blanc
			Style..VoletInactif..Arrondi     = 8
		FIN

		VOL_Coins8Un est un Volet
			PROPRIETES
				Libellé     = "Profil"
				Disposition = dispLibre
			FIN
		FIN

		VOL_Coins8Deux est un Volet
			PROPRIETES
				Libellé     = "Options"
				Disposition = dispLibre
			FIN
		FIN
	FIN

	ONG_Coins16 est un Champ Onglet
		PROPRIETES
			X       = 0
			Y       = 320
			Largeur = 480
			Hauteur = 140
			Valeur  = 1

			Style..CadreExtérieur..CouleurFond      = Blanc
			Style..CadreExtérieur..Cadre..Couleur   = Vert
			Style..CadreExtérieur..Cadre..Epaisseur = 2

			Style..VoletActif..CouleurFond   = Rouge
			Style..VoletActif..Couleur       = Noir
			Style..VoletActif..Arrondi       = 16
			Style..VoletInactif..CouleurFond = Bleu
			Style..VoletInactif..Couleur     = Blanc
			Style..VoletInactif..Arrondi     = 16
		FIN

		VOL_Coins16Un est un Volet
			PROPRIETES
				Libellé     = "Profil"
				Disposition = dispLibre
			FIN
		FIN

		VOL_Coins16Deux est un Volet
			PROPRIETES
				Libellé     = "Options"
				Disposition = dispLibre
			FIN
		FIN
	FIN
FIN
