// Ressource fenêtre — voisine de test_table_deplace_ligne.owl.
// Une Table à deux colonnes (texte + numérique) et quatre lignes, pour
// exercer le déplacement de lignes headless : move avec décalage de
// l'intervalle, cibles relatives, opération tdEchange, retour = nouvel indice.

FEN_Deplace est une Fenêtre
	PROPRIETES
		Titre       = "Déplacement de lignes"
		Disposition = dispVerticale
		Largeur     = 400
		Hauteur     = 300
	FIN

	TABLE_Lignes est un Champ Table
		PROPRIETES
			Étire = Vrai
		FIN

		COL_Nom est une Colonne
			PROPRIETES
				Libellé = "Nom"
				Type    = colTypeTexte
				Largeur = 100
			FIN
		FIN

		COL_Rang est une Colonne
			PROPRIETES
				Libellé = "Rang"
				Type    = colTypeNumerique
				Largeur = 100
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		Reinit()
	FIN

	PROCEDURE Reinit()
		TableSupprimeTout(TABLE_Lignes)
		TableAjouteLigne(TABLE_Lignes, "Alpha", 10)
		TableAjouteLigne(TABLE_Lignes, "Beta", 20)
		TableAjouteLigne(TABLE_Lignes, "Gamma", 30)
		TableAjouteLigne(TABLE_Lignes, "Delta", 40)
	FIN

	PROCEDURE Nom(n est un entier)
		RENVOYER TABLE_Lignes[n].COL_Nom
	FIN

	PROCEDURE Rang(n est un entier)
		RENVOYER TABLE_Lignes[n].COL_Rang
	FIN

	PROCEDURE Occ()
		RENVOYER TableOccurrence(TABLE_Lignes)
	FIN

	PROCEDURE Deplace(source est un entier, cible est un entier)
		RENVOYER TableDéplaceLigne(TABLE_Lignes, source, cible)
	FIN

	PROCEDURE DeplaceOp(source est un entier, cible est un entier, op est un entier)
		RENVOYER TableDéplaceLigne(TABLE_Lignes, source, cible, op)
	FIN

	PROCEDURE DeplaceEN(source est un entier, cible est un entier)
		RENVOYER TableMoveLine(TABLE_Lignes, source, cible)
	FIN
FIN
