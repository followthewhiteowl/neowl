// Ressource Etat voisine de test_couleurfond_champ.owl -- même mise en
// page que ETAT_CouleurFondChampSans, avec CouleurFond = Bleu posé sur le
// Champ Libellé. Le PDF rendu doit peindre un rectangle plein derrière le
// texte.

ETAT_CouleurFondChampAvec est un État
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	corps est un Corps
		PROPRIETES
			Hauteur = 40
		FIN

		LIB_X est un Champ Libellé
			PROPRIETES
				Libellé      = "STATIQUE"
				X            = 20
				Y            = 10
				Largeur      = 100
				Hauteur      = 15
				CouleurFond  = Bleu
				PoliceNom    = iPoliceLiberationSans
				PoliceTaille = 11
			FIN
		FIN
	FIN
FIN
