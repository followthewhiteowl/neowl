// Ressource Etat voisine de test_couleurfond_champ.owl -- baseline SANS
// CouleurFond sur le Champ Libellé. Sert de référence différentielle pour
// ETAT_CouleurFondChampAvec (même mise en page, seule différence :
// CouleurFond).

ETAT_CouleurFondChampSans est un État
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	corps est un Corps
		PROPRIETES
			Hauteur = 40
		FIN

		LIB_X est un Champ Libellé
			PROPRIETES
				Libellé      = "STATIQUE"
				X            = 20
				Y            = 10
				Largeur      = 100
				Hauteur      = 15
				PoliceNom    = iPoliceLiberationSans
				PoliceTaille = 11
			FIN
		FIN
	FIN
FIN
