// Ressource Etat voisine de test_couleurfond_champ.owl -- référence de
// non-régression : le CouleurFond de bloc (Corps) est déjà peint
// correctement. Sert à garantir que le fix du fond de champ ne casse pas
// le fond de bloc existant.

ETAT_CouleurFondBlocRegression est un État
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	corps est un Corps
		PROPRIETES
			Hauteur     = 40
			CouleurFond = Bleu
		FIN

		LIB_X est un Champ Libellé
			PROPRIETES
				Libellé      = "STATIQUE"
				X            = 20
				Y            = 10
				Largeur      = 100
				Hauteur      = 15
				PoliceNom    = iPoliceLiberationSans
				PoliceTaille = 11
			FIN
		FIN
	FIN
FIN
