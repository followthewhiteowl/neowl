// Verrou : CouleurFond posé sur un Champ Libellé d'Etat doit peindre un
// rectangle plein derrière le texte (opérateurs PDF "re" + "f", précédés
// d'un opérateur couleur). Trois ressources voisines :
//   - ETAT_CouleurFondChampSans     : baseline sans CouleurFond
//   - ETAT_CouleurFondChampAvec     : même mise en page + CouleurFond = Bleu
//   - ETAT_CouleurFondBlocRegression : CouleurFond sur le bloc Corps
//     (référence de non-régression -- déjà peint aujourd'hui)
//
// Stratégie d'assertion différentielle : le flux de contenu décompressé
// AVEC CouleurFond de champ doit différer de celui SANS (un rectangle de
// remplissage en plus). Assertion littérale en complément sur le bloc de
// référence (pattern "scn" + "re" + "f" déjà vert aujourd'hui).

TestModeHeadless(Vrai)

PROCEDURE TrouveMotif(buf est un buffer, motif est une chaîne, depart est un entier)
	nBuf est un entier = Taille(buf)
	motifBuf est un buffer = ChaîneVersBuffer(motif)
	nMotif est un entier = Taille(motifBuf)
	i est un entier = depart
	TANTQUE i <= nBuf - nMotif + 1
		bMatch est un booléen = Vrai
		k est un entier = 0
		TANTQUE k < nMotif ET bMatch
			SI BufferLitOctet(buf, i + k) <> BufferLitOctet(motifBuf, k + 1) ALORS
				bMatch = Faux
			FIN
			k = k + 1
		FIN
		SI bMatch ALORS
			RENVOYER i
		FIN
		i = i + 1
	FIN
	RENVOYER 0
FIN

// Extrait et décompresse le 1er flux de contenu (celui référencé par
// /Contents) du PDF produit. Recherche purement en domaine Buffer
// (BufferLitOctet) pour ne jamais tronquer sur un octet nul du flux
// compressé.
PROCEDURE StreamContenuPDF(chemin est une chaîne)
	buf est un buffer = fChargeBuffer(chemin)
	posContents est un entier = TrouveMotif(buf, "/Contents ", 1)
	i est un entier = posContents + Taille(ChaîneVersBuffer("/Contents "))
	nObj est un entier = 0
	TANTQUE BufferLitOctet(buf, i) >= 48 ET BufferLitOctet(buf, i) <= 57
		nObj = nObj * 10 + (BufferLitOctet(buf, i) - 48)
		i    = i + 1
	FIN
	sMotifObj est une chaîne = "" + nObj + " 0 obj"
	posObj est un entier = TrouveMotif(buf, sMotifObj, 1)
	posStream est un entier = TrouveMotif(buf, "stream", posObj)
	dataStart est un entier = posStream + 6
	SI BufferLitOctet(buf, dataStart) = 13 ALORS
		dataStart = dataStart + 1
	FIN
	SI BufferLitOctet(buf, dataStart) = 10 ALORS
		dataStart = dataStart + 1
	FIN
	posEndstream est un entier = TrouveMotif(buf, "endstream", dataStart)
	nSegTaille est un entier = posEndstream - dataStart
	seg est un buffer = BufferVide(nSegTaille)
	j est un entier = 1
	TANTQUE j <= nSegTaille
		BufferÉcritOctet(seg, j, BufferLitOctet(buf, dataStart + j - 1))
		j = j + 1
	FIN
	decomp est un buffer = Décompresse(seg)
	RENVOYER BufferVersChaîne(decomp, encLatin1)
FIN

iDestination(iPDFGénérique, "tests/runtime/etat_couleurfond_champ/temp_sans.pdf")
iImprimeEtat(ETAT_CouleurFondChampSans)
iFinImprime()

iDestination(iPDFGénérique, "tests/runtime/etat_couleurfond_champ/temp_avec.pdf")
iImprimeEtat(ETAT_CouleurFondChampAvec)
iFinImprime()

iDestination(iPDFGénérique, "tests/runtime/etat_couleurfond_champ/temp_bloc.pdf")
iImprimeEtat(ETAT_CouleurFondBlocRegression)
iFinImprime()

sSans est une chaîne = StreamContenuPDF("tests/runtime/etat_couleurfond_champ/temp_sans.pdf")
sAvec est une chaîne = StreamContenuPDF("tests/runtime/etat_couleurfond_champ/temp_avec.pdf")
sBloc est une chaîne = StreamContenuPDF("tests/runtime/etat_couleurfond_champ/temp_bloc.pdf")

// Bug D : CouleurFond sur un Champ Libellé doit changer le rendu (rectangle
// de remplissage en plus). Aujourd'hui, aucun fond n'est peint : les deux
// flux sont identiques.
dbgVérifieVrai(sAvec <> sSans,
"CouleurFond sur un Champ Libellé change le flux de contenu rendu (rectangle de fond en plus)")

// Le rectangle de fond doit être un remplissage plein : opérateur "re"
// (rectangle) suivi d'un opérateur "f" (fill).
nRectAvec est un entier = Occurrence(sAvec, "re")
nRectSans est un entier = Occurrence(sSans, "re")
dbgVérifieVrai(nRectAvec > nRectSans,
"CouleurFond sur un Champ Libellé ajoute un opérateur rectangle (re) absent de la baseline sans fond")

// Non-régression : le CouleurFond de bloc (Corps) reste peint --
// opérateur couleur bleu "0 0 1 scn" suivi d'un rectangle "re" et d'un
// remplissage "f", motif déjà vert aujourd'hui.
dbgVérifieVrai(Contient(sBloc, "0 0 1 scn"),
"CouleurFond de bloc : opérateur couleur bleu toujours posé (non-régression)")
dbgVérifieVrai(Occurrence(sBloc, "re") > 0,
"CouleurFond de bloc : rectangle de fond toujours peint (non-régression)")

dbgBilanTest()
