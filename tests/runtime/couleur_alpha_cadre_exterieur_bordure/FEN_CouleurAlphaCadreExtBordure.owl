//  (LOT 1) — Style..CadreExtérieur..Cadre..Couleur (bordure) sur un
// Champ Conteneur, posé en instance Couleur translucide (Opacité<255).
// Épaisseur de bordure large (20px) pour un échantillonnage pixel robuste.
//
// Fond de fenêtre ROUGE PUR opaque (RVB(255,0,0)) pour rendre tout mélange
// alpha mesurable au pixel. CouleurFond du conteneur fixée en gris foncé
// opaque (RVB(10,10,10)), distincte du témoin/mélange, pour ne pas ambiguïser
// la lecture de la bordure avec le fond intérieur.
//
// CNT_BordureOpaque : témoin non-régression, bordure VERT PUR (0,255,0)
// sans Opacité.
// CNT_BordureAlpha  : bordure VERT translucide (0,255,0), Opacité=128 —
// vérifie que le mélange source-over avec le fond rouge est bien appliqué.
FEN_CouleurAlphaCadreExtBordure est une Fenêtre
	PROPRIETES
		Titre       = "Alpha CadreExtérieur — bordure"
		Largeur     = 280
		Hauteur     = 260
		Disposition = dispLibre
		CouleurFond = RVB(255, 0, 0)
	FIN

	CNT_BordureOpaque est un Champ Conteneur
		PROPRIETES
			X                                       = 20
			Y                                       = 20
			Largeur                                 = 200
			Hauteur                                 = 100
			Style..CadreExtérieur..CouleurFond      = RVB(10, 10, 10)
			Style..CadreExtérieur..Cadre..Couleur   = RVB(0, 255, 0)
			Style..CadreExtérieur..Cadre..Epaisseur = 20
		FIN
	FIN

	CNT_BordureAlpha est un Champ Conteneur
		PROPRIETES
			X                                       = 20
			Y                                       = 140
			Largeur                                 = 200
			Hauteur                                 = 100
			Style..CadreExtérieur..CouleurFond      = RVB(10, 10, 10)
			Style..CadreExtérieur..Cadre..Couleur   = {Rouge = 0, Vert = 255, Bleu = 0, Opacité = 128}
			Style..CadreExtérieur..Cadre..Epaisseur = 20
		FIN
	FIN
FIN
