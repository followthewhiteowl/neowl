//  — fenêtre témoin pour le fond du cadre extérieur d'un Champ Onglet.
//
// Le fond de fenêtre est un VERT FRANC (RVB(0,200,0)) et le fond du premier
// onglet un BLEU FRANC : aucune couleur du rendu par défaut n'en approche, donc
// lire ce bleu dans le volet prouve que le fond demandé est bien peint, et lire
// autre chose prouve qu'il a été écrasé.
//
// Les quatre champs couvrent les quatre habillages du cadre extérieur :
//   ONG_FondSeul    : un fond, AUCUNE propriété de bordure — le cas qui
//                     régressait (volet rendu noir au lieu du fond demandé) ;
//   ONG_FondBordure : fond + bordure     — combinaison déjà correcte ;
//   ONG_FondArrondi : fond + arrondi     — combinaison déjà correcte ;
//   ONG_Nu          : aucun style        — rendu par défaut intact.

FEN_OngletFondSansBordure est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 520
		Hauteur     = 680
		Titre       = "Fond du cadre extérieur sans bordure"
		CouleurFond = RVB(0, 200, 0)
	FIN

	ONG_FondSeul est un Champ Onglet
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 480
			Hauteur = 110
			Valeur  = 1

			Style..CadreExtérieur..CouleurFond = Bleu
		FIN

		VOL_SeulUn est un Volet
			PROPRIETES
				Libellé     = "Profil"
				Disposition = dispLibre
			FIN
		FIN

		VOL_SeulDeux est un Volet
			PROPRIETES
				Libellé     = "Options"
				Disposition = dispLibre
			FIN
		FIN
	FIN

	ONG_FondBordure est un Champ Onglet
		PROPRIETES
			X       = 10
			Y       = 140
			Largeur = 480
			Hauteur = 110
			Valeur  = 1

			Style..CadreExtérieur..CouleurFond      = Blanc
			Style..CadreExtérieur..Cadre..Couleur   = Vert
			Style..CadreExtérieur..Cadre..Epaisseur = 2
		FIN

		VOL_BordureUn est un Volet
			PROPRIETES
				Libellé     = "Profil"
				Disposition = dispLibre
			FIN
		FIN

		VOL_BordureDeux est un Volet
			PROPRIETES
				Libellé     = "Options"
				Disposition = dispLibre
			FIN
		FIN
	FIN

	ONG_FondArrondi est un Champ Onglet
		PROPRIETES
			X       = 10
			Y       = 270
			Largeur = 480
			Hauteur = 110
			Valeur  = 1

			Style..CadreExtérieur..CouleurFond    = Blanc
			Style..CadreExtérieur..Cadre..Arrondi = 8
		FIN

		VOL_ArrondiUn est un Volet
			PROPRIETES
				Libellé     = "Profil"
				Disposition = dispLibre
			FIN
		FIN

		VOL_ArrondiDeux est un Volet
			PROPRIETES
				Libellé     = "Options"
				Disposition = dispLibre
			FIN
		FIN
	FIN

	ONG_Nu est un Champ Onglet
		PROPRIETES
			X       = 10
			Y       = 400
			Largeur = 480
			Hauteur = 110
			Valeur  = 1
		FIN

		VOL_NuUn est un Volet
			PROPRIETES
				Libellé     = "Profil"
				Disposition = dispLibre
			FIN
		FIN

		VOL_NuDeux est un Volet
			PROPRIETES
				Libellé     = "Options"
				Disposition = dispLibre
			FIN
		FIN
	FIN
FIN
