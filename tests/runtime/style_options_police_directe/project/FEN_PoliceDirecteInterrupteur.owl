// Pendant strict de FEN_PoliceDirecteSelecteur pour l'autre famille de blocs à
// options : mêmes écritures de police, même absence de disposition
// automatique, la coche remplace la puce comme indicateur.
FEN_PoliceDirecteInterrupteur est une Fenêtre
	PROPRIETES
		Titre       = "Police écrite directement — Interrupteur"
		Largeur     = 1600
		Hauteur     = 700
		Disposition = dispLibre
	FIN

	INT_Nu est un Champ Interrupteur
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 200
			Options = ["Alpha", "Bravo", "Charlie"]
		FIN
	FIN

	INT_Style18 est un Champ Interrupteur
		PROPRIETES
			X                                   = 220
			Y                                   = 10
			Largeur                             = 200
			Options                             = ["Alpha", "Bravo", "Charlie"]
			Style..TexteOptions..Police..Taille = 18
		FIN
	FIN

	INT_Plat18 est un Champ Interrupteur
		PROPRIETES
			X            = 430
			Y            = 10
			Largeur      = 200
			Options      = ["Alpha", "Bravo", "Charlie"]
			PoliceTaille = 18
		FIN
	FIN

	INT_Litteral18 est un Champ Interrupteur
		PROPRIETES
			X       = 640
			Y       = 10
			Largeur = 200
			Options = ["Alpha", "Bravo", "Charlie"]
			Police  = { Taille = 18 }
