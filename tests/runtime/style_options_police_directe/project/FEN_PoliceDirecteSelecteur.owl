// Une taille de police peut s'écrire sur un champ de quatre façons : par le
// style, par le raccourci plat, par le littéral composé, par la cascade
// explicite. Les quatre décrivent la même police, donc le même bloc.
//
// Positionnement libre : c'est la seule disposition où la hauteur relevée est
// celle que le bloc se donne. Sous une disposition automatique, le layout
// parent interroge la taille souhaitée du bloc à chaque passe et rattrape de
// lui-même une hauteur restée en arrière — le défaut y est invisible.
FEN_PoliceDirecteSelecteur est une Fenêtre
	PROPRIETES
		Titre       = "Police écrite directement — Sélecteur"
		Largeur     = 1600
		Hauteur     = 700
		Disposition = dispLibre
	FIN

	// Référence : aucune police écrite.
	SEL_Nu est un Champ Sélecteur
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 200
			Options = ["Alpha", "Bravo", "Charlie"]
		FIN
	FIN

	// Étalon : la police par le style, chemin déjà conforme à la loi.
	SEL_Style18 est un Champ Sélecteur
		PROPRIETES
			X                                   = 220
			Y                                   = 10
			Largeur                             = 200
			Options                             = ["Alpha", "Bravo", "Charlie"]
			Style..TexteOptions..Police..Taille = 18
		FIN
	FIN

	// Écriture directe 1/3 : raccourci plat.
	SEL_Plat18 est un Champ Sélecteur
		PROPRIETES
			X            = 430
			Y            = 10
			Largeur      = 200
			Options      = ["Alpha", "Bravo", "Charlie"]
			PoliceTaille = 18
		FIN
	FIN

	// Écriture directe 2/3 : littéral composé.
	SEL_Litteral18 est un Champ Sélecteur
		PROPRIETES
			X       = 640
			Y       = 10
			Largeur = 200
			Options = ["Alpha", "Bravo", "Charlie"]
			Police  = { Taille = 18 }
		FIN
	FIN

	// Écriture directe 3/3 : cascade explicite.
	SEL_Cascade18 est un Champ Sélecteur
		PROPRIETES
			X              = 850
			Y              = 10
			Largeur        = 200
			Options        = ["Alpha", "Bravo", "Charlie"]
			Police..Taille = 18
		FIN
	FIN

	// Seconde taille : la hauteur se dérive de la police, elle n'est pas tabulée.
	SEL_Style24 est un Champ Sélecteur
		PROPRIETES
			X                                   = 1060
			Y                                   = 10
			Largeur                             = 200
			Options                             = ["Alpha", "Bravo", "Charlie"]
			Style..TexteOptions..Police..Taille = 24
		FIN
	FIN

	SEL_Cascade24 est un Champ Sélecteur
		PROPRIETES
			X              = 1270
			Y              = 10
			Largeur        = 200
			Options        = ["Alpha", "Bravo", "Charlie"]
			Police..Taille = 24
		FIN
	FIN

	// Hauteur écrite au-dessus du contenu : elle gagne, police directe ou non.
	SEL_Haute est un Champ Sélecteur
		PROPRIETES
			X              = 10
			Y              = 350
			Largeur        = 200
			Hauteur        = 300
			Options        = ["Alpha", "Bravo", "Charlie"]
			Police..Taille = 18
		FIN
	FIN

	SEL_HauteStyle est un Champ Sélecteur
		PROPRIETES
			X                                   = 220
			Y                                   = 350
			Largeur                             = 200
			Hauteur                             = 300
			Options                             = ["Alpha", "Bravo", "Charlie"]
			Style..TexteOptions..Police..Taille = 18
		FIN
	FIN

	// Écriture après ouverture : la loi vaut aussi en cours d'exécution.
	SEL_Tardif est un Champ Sélecteur
		PROPRIETES
			X       = 430
			Y       = 350
			Largeur = 200
			Options = ["Alpha", "Bravo", "Charlie"]
		FIN
	FIN
FIN
