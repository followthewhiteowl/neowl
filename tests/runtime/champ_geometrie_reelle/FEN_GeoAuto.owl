// Fenêtre voisine — disposition automatique (verticale), 400 x 300, sans marge.
//
// Géométrie attendue une fois la fenêtre montée (mesurée à la capture) :
//   BTN_Etire   : 400 x 30 en (0, 0)      — étiré sur toute la largeur
//   CONT_Boite  : 300 x 100 en (100, 34)  — largeur figée, collé à droite
//   LIB_Dedans  : 120 x 30  en (100, 34)  — enfant du conteneur, donc décalé
//                                           de 100 en X par rapport à la fenêtre
//
// LIB_Dedans est le discriminant du repère : relatif au conteneur il serait
// en (0, 0) ; relatif à la zone client de la fenêtre il est en (100, 34).
// Son fond vert sert de sonde pixel indépendante.

// Les trois relevés faits par FinInitialisation() sont stockés dans des
// variables déclarées par le fichier de test voisin.

FEN_GeoAuto est une Fenêtre
	PROPRIETES
		Titre       = "Géométrie réelle — disposition automatique"
		Largeur     = 400
		Hauteur     = 300
		Disposition = dispVerticale
		Espacement  = 4
		CouleurFond = RVB(5, 5, 5)
	FIN

	BTN_Etire est un Champ Bouton
		PROPRIETES
			Libellé    = "A"
			Hauteur    = 30
			Alignement = alignÉtire
		FIN
	FIN

	CONT_Boite est un Champ Conteneur
		PROPRIETES
			Largeur     = 300
			Hauteur     = 100
			Disposition = dispVerticale
			Alignement  = alignFin
		FIN

		LIB_Dedans est un Champ Libellé
			PROPRIETES
				Libellé                            = "B"
				Largeur                            = 120
				Hauteur                            = 30
				Alignement                         = alignDébut
				Style..CadreExtérieur..CouleurFond = RVB(0, 200, 0)
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		gGeoLargeurFinInit = BTN_Etire..Largeur
		gGeoHauteurFinInit = BTN_Etire..Hauteur
		gGeoYFinInit       = CONT_Boite..Y
	FIN
FIN
