// Fenêtre voisine — disposition libre, 400 x 300.
//
// En disposition libre, la géométrie déclarée EST la géométrie réelle :
//   BTN_Libre  : 200 x 30 en (50, 40)
//
// ONG_Volets porte un volet en disposition libre contenant LIB_Volet. La
// position de LIB_Volet dans la fenêtre n'est pas sa position déclarée
// (10, 10) : elle est décalée par la position de l'onglet, sa barre de
// languettes et le cadre du volet. Son fond vert sert de sonde pixel.

FEN_GeoLibre est une Fenêtre
	PROPRIETES
		Titre       = "Géométrie réelle — disposition libre"
		Largeur     = 400
		Hauteur     = 300
		Disposition = dispLibre
		CouleurFond = RVB(5, 5, 5)
	FIN

	BTN_Libre est un Champ Bouton
		PROPRIETES
			Libellé = "Libre"
			X       = 50
			Y       = 40
			Largeur = 200
			Hauteur = 30
		FIN
	FIN

	ONG_Volets est un Champ Onglet
		PROPRIETES
			X       = 20
			Y       = 100
			Largeur = 300
			Hauteur = 150
		FIN

		VOL_Un est un Volet
			PROPRIETES
				Libellé     = "Un"
				Disposition = dispLibre
			FIN

			LIB_Volet est un Champ Libellé
				PROPRIETES
					Libellé                            = "V"
					X                                  = 10
					Y                                  = 10
					Largeur                            = 120
					Hauteur                            = 30
					Style..CadreExtérieur..CouleurFond = RVB(0, 200, 0)
				FIN
			FIN
		FIN
	FIN
FIN
