// Ressource Etat minimale utilisee par test_visualisateur.owl pour exercer le
// pipeline iDestination(iVisualisateur) -> iImprimeEtat -> iFinImprime en
// mode headless.

ETAT_ApercuSimple est un État
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
		MargeHaut   = 10
		MargeBas    = 10
		MargeGauche = 10
		MargeDroite = 10
	FIN

	corps est un Corps
		PROPRIETES
			Hauteur = 30
		FIN

		LIB_Titre est un Champ Libellé
			PROPRIETES
				Libellé      = "Rapport pour aperçu"
				X            = 20
				Y            = 10
				Largeur      = 120
				Hauteur      = 15
				PoliceNom    = iPoliceLiberationSans
				PoliceTaille = 14
			FIN
		FIN
	FIN
FIN
