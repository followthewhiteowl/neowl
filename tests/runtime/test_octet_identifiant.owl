// 'octet' et 'byte' ne sont pas des mots-cles reserves : ils peuvent servir de
// noms de variables, de parametres et de fonctions ordinaires. (Pour stocker des
// octets bruts, utiliser un buffer ; pour borner une valeur, voir EntierDansPlage.)


// ============================================================================
// 1. 'octet' utilisable comme nom de variable
// ============================================================================

PROCEDURE PUBLIQUE scenario_octet_variable()
	octet est un entier = 5
	dbgVérifieEgalité(octet, 5, "octet (variable entier) = 5")
	octet = octet + 3
	dbgVérifieEgalité(octet, 8, "octet reaffecte = 8")
FIN


// ============================================================================
// 2. 'byte' (alias EN) utilisable comme nom de variable
// ============================================================================

PROCEDURE PUBLIQUE scenario_byte_variable()
	byte est un entier = 42
	dbgVérifieEgalité(byte, 42, "byte (variable entier) = 42")
FIN


// ============================================================================
// 3. 'octet' utilisable comme nom de parametre
// ============================================================================

PROCEDURE doubleOctet(octet est un entier)
	RENVOYER octet * 2
FIN

PROCEDURE PUBLIQUE scenario_octet_parametre()
	dbgVérifieEgalité(doubleOctet(7), 14, "octet en parametre : doubleOctet(7) = 14")
FIN


// ============================================================================
// 4. 'octet' comme variable chaine (au-dela du seul cas entier)
// ============================================================================

PROCEDURE PUBLIQUE scenario_octet_chaine()
	octet est une chaîne = "valeur"
	dbgVérifieEgalité(octet, "valeur", "octet (variable chaine) = valeur")
FIN


dbgBilanTest()
