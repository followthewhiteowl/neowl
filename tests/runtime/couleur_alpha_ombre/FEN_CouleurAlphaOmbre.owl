//  (LOT 3) — opacité sur `Style..CadreExtérieur..Ombre..Couleur`.
// Ombre DURE (Flou = 0 + décalage marqué) pour un oracle net : le flou
// rendrait le pixel imprévisible. Décalage 40/40, assez grand pour isoler
// une zone d'ombre pure, hors du widget lui-même.
//
// Fond de fenêtre ROUGE PUR opaque (RVB(255,0,0)).
//
// BTN_Opaque : ombre BLEUE opaque (entier nu), témoin non-régression.
// BTN_Alpha  : ombre BLEUE translucide (instance Couleur, Opacité=128).
FEN_CouleurAlphaOmbre est une Fenêtre
	PROPRIETES
		Titre       = "Alpha Ombre"
		Largeur     = 260
		Hauteur     = 290
		Disposition = dispLibre
		CouleurFond = RVB(255, 0, 0)
	FIN

	BTN_Opaque est un Champ Bouton
		PROPRIETES
			X       = 20
			Y       = 20
			Largeur = 100
			Hauteur = 50
			Libellé = "Opaque"
			Style   = {
				CadreExtérieur = {
					Ombre = { Couleur = RVB(0, 0, 255), DécalageX = 40, DécalageY = 40, Flou = 0 }
				}
			}
		FIN
	FIN

	BTN_Alpha est un Champ Bouton
		PROPRIETES
			X       = 20
			Y       = 140
			Largeur = 100
			Hauteur = 50
			Libellé = "Alpha"
			Style   = {
				CadreExtérieur = {
					Ombre = {
						Couleur   = {Rouge = 0, Vert = 0, Bleu = 255, Opacité = 128}
						DécalageX = 40
						DécalageY = 40
						Flou      = 0
					}
				}
			}
		FIN
	FIN
FIN
