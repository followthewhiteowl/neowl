// Ressource test  — Etat avec une variable Image declaree au top-level
// et referencee dans la prop Image d'un sous-champ. Voisin lu par
// test_etat_var_toplevel.owl.

ETAT_VarTop est un Etat
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
		MargeHaut   = 15
		MargeBas    = 15
		MargeGauche = 15
		MargeDroite = 15
	FIN

	// Variable Image de niveau 0 (top-level Etat) : n'existe qu'une fois le
	// top-level execute. La prop Image du sous-champ ci-dessous la reference.
	imgLogo est une Image = dCréeImage(120, 120, Blanc)
	dRectangle(imgLogo, 0, 0, 60, 120, RougeClair, RougeClair)
	dRectangle(imgLogo, 60, 0, 120, 120, BleuPastel, BleuPastel)

	corps est un Corps
		PROPRIETES
			Hauteur = 50
		FIN

		IMG est un Champ Image
			PROPRIETES
				X       = 0
				Y       = 0
				Largeur = 40
				Hauteur = 40
				Image   = imgLogo
				Cadrage = cadHomothetique
			FIN
		FIN
	FIN
FIN
