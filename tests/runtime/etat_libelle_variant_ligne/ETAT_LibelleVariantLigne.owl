// Ressource Etat voisine de test_libelle_variant_ligne.owl.
//
// PROCEDURE Lecture pose une valeur de Libellé différente avant chacun des
// 3 rendus du bloc Corps (2 rendus manuels via iImprimeBloc + le rendu
// automatique final) : "A", "AA", "AAA". Chaque ligne doit afficher SA
// valeur, pas la première valeur gelée.

ETAT_LibelleVariantLigne est un État
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	corps est un Corps
		PROPRIETES
			Hauteur = 10
		FIN

		LIB_X est un Champ Libellé
			PROPRIETES
				Libellé      = "A"
				X            = 20
				Y            = 2
				Largeur      = 100
				Hauteur      = 6
				PoliceNom    = iPoliceLiberationSans
				PoliceTaille = 9
			FIN
		FIN
	FIN

	PROCEDURE Lecture()
		LIB_X..Libellé = "A"
		iImprimeBloc("Corps")
		LIB_X..Libellé = "AA"
		iImprimeBloc("Corps")
		LIB_X..Libellé = "AAA"
	FIN
FIN
