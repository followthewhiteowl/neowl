// Fenêtre voisine pour test_widget_image_icone_inline_couleur.
// Vérifie que le brace literal d'Icône à props nommées est accepté en
// valeur de prop widget, et que la Couleur est effectivement portée.

FEN_IconeInline est une Fenêtre
	PROPRIETES
		Titre   = "Test icone inline"
		Largeur = 320
		Hauteur = 200
	FIN

	BTN_Rouge est un Champ Bouton
		PROPRIETES
			Libellé = "Rouge"
			Image   = {icones.close, Couleur = RVB(200, 65, 65)}
		FIN
	FIN

	BTN_Bleu est un Champ Bouton
		PROPRIETES
			Libellé = "Bleu"
			Image   = {
				icones.close,
				Couleur = RVB(20, 80, 200)
			}
		FIN
	FIN

	IMG_Cible est un Champ Image
		PROPRIETES
			Largeur = 64
			Hauteur = 64
			Image   = {icones.add, Couleur = RVB(10, 150, 30)}
		FIN
	FIN
FIN
