// Test du bloc CONSTANTE / CONSTANT (documentation de référence)

CONSTANTE
	TauxTVA = 20
	NomApp  = "Mon Appli"
	Pi_App  = 3.14
	Activé  = Vrai
FIN

dbgVérifieEgalité(TauxTVA, 20, "constante entière")
dbgVérifieEgalité(NomApp, "Mon Appli", "constante chaîne")
dbgVérifieEgalité(Pi_App, 3.14, "constante réelle")
dbgVérifieEgalité(Activé, Vrai, "constante booléenne")

// Utilisation dans une expression
dbgVérifieEgalité(100 * (1 + TauxTVA / 100), 120, "TauxTVA dans une expression")

// Usage dans EvalueExpression — la documentation de référence dit que c'est interdit, mais en
// OWL les CONSTANTE deviennent des globales standard, donc accessibles.
// Divergence assumée (extension OWL).
dbgVérifieEgalité(EvalueExpression("TauxTVA"), 20,
"OWL : CONSTANTE accessible depuis EvalueExpression (extension)")

// Synonyme CONSTANT (sans E)
CONSTANT
	Vrai_aussi = Vrai
FIN
dbgVérifieEgalité(Vrai_aussi, Vrai, "CONSTANT (synonyme)")

dbgBilanTest()
