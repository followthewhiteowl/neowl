// Fenêtre voisine — ressource pour test_masque_affichage_heure.owl
// (, miroir de  sur le type Heure). Trois champs Heure :
// un témoin sans masque (repli défaut, précision tronquée aux minutes), un
// avec masque "HH:MI:SS" (précision secondes préservée), un avec masque à
// séparateurs littéraux non-standards "HHhMImSSs" pour vérifier que la
// relecture est bien DIRIGÉE par les jetons du masque et pas un simple
// détecteur générique (qui ne comprendrait pas "14h30m45s").

FEN_MasqueAffichageHeure est une Fenêtre
	PROPRIETES
		Titre       = "Masque affichage Heure"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 200
	FIN

	SAI_SansMasque est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 10
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieHeure
			Valeur     = ""
		FIN
	FIN

	SAI_MasqueHHMISS est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 50
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieHeure
			Valeur     = ""
		FIN
	FIN

	SAI_MasqueCustom est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 90
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieHeure
			Valeur     = ""
		FIN
	FIN
FIN
