// Fenêtre voisine — ressource pour
// test_table_colonne_type_numerique_monetaire_plat.owl ( lot 3,
// repli PLAT : ni FormatNombre ni FormatMonétaire résolus, ni côté colonne
// — hors-scope assumé —, ni côté projet voisin).
//
// COL_Num : Type = colTypeNumerique, AUCUN masque brut → validée à la frappe,
//           mais affichée SANS formatage (forme plate, pas de décimales
//           forcées ni de séparateur de milliers).
// COL_Mon : Type = colTypeMonétaire, AUCUN masque brut → même contrat,
//           affichée SANS symbole (forme plate monétaire, currency_to_str).

FEN_TableColonneTypeNumeriqueMonetairePlat est une Fenêtre
	PROPRIETES
		Titre = "Colonne type Numérique/Monétaire, repli plat"
	FIN

	TAB_ColTypes est un Champ Table
		PROPRIETES
		FIN

		COL_Num est une Colonne
			PROPRIETES
				Libellé = "Numérique"
				Type    = colTypeNumerique
				Largeur = 140
			FIN
		FIN

		COL_Mon est une Colonne
			PROPRIETES
				Libellé = "Monétaire"
				Type    = colTypeMonétaire
				Largeur = 140
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		TableAjouteLigne(TAB_ColTypes, "1234.5", "1234.5")
	FIN
FIN
