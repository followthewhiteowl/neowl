// Thème désigné par Projet..Thème. Plusieurs styles bouton DIFFÉRENTS : le
// point du test est que chaque widget en reçoive SON style propre, pas celui
// du dernier déclaré.

ThèmeMultiDiff est un Thème
	stylePrimaire est un styleBouton = {
		CadreExtérieur = { CouleurFond = Bleu }
	}
	styleDanger est un styleBouton = {
		CadreExtérieur = { CouleurFond = Rouge }
	}
	styleNeutre est un styleBouton = {
		CadreExtérieur = { CouleurFond = Vert }
	}
FIN
