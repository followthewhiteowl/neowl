// Fenêtre support : plusieurs boutons portant des styles de thème DIFFÉRENTS.
// - Chemin BUILD : le Style est posé en PROPRIETES (application à la
//   construction) — deux styles distincts sur deux boutons.
// - Chemin RUNTIME : le Style est affecté par code (X..Style = theme.X).
// Chaque bouton doit garder SON style distinct.
FEN_MultiStyle est une Fenêtre
	PROPRIETES
		Titre       = "Styles thème multiples distincts"
		Largeur     = 400
		Hauteur     = 320
		Disposition = dispLibre
	FIN

	BTN_A est un Champ Bouton
		PROPRIETES
			X       = 20
			Y       = 20
			Largeur = 300
			Hauteur = 40
			Libellé = "Primaire"
			Style   = theme.stylePrimaire
		FIN
	FIN

	BTN_B est un Champ Bouton
		PROPRIETES
			X       = 20
			Y       = 70
			Largeur = 300
			Hauteur = 40
			Libellé = "Danger"
			Style   = theme.styleDanger
		FIN
	FIN

	BTN_C est un Champ Bouton
		PROPRIETES
			X       = 20
			Y       = 120
			Largeur = 300
			Hauteur = 40
			Libellé = "Runtime"
		FIN
	FIN
FIN
