// =============================================================================
// TEST : Resolution runtime EN->FR des CONSTANTES de la famille langue*
// (, lot A7 - module stdlib_i18n).
//
// Verrouille le contrat bilingue : referencer une langue par sa forme EN
// canon (nameEN pose dans le registre) resout vers EXACTEMENT le meme tag
// BCP 47 que la forme FR canon. La forme EN est un alias runtime-only
// (mirror de l'alias ASCII), pas une 2e entree registre.
//
// Couples couverts (FR canon -> nameEN -> tag BCP 47) :
//   langueFrançais -> languageFrench   (= "fr-FR")
//   langueAnglais  -> languageEnglish  (= "en-US")
//   langueAllemand -> languageGerman   (= "de-DE")
//   langueJaponais -> languageJapanese (= "ja-JP")
//   langueArabe    -> languageArabic   (= "ar-SA")
//
// Deux couches d'assertion par couple : EN == FR, ET EN == valeur exacte.
// =============================================================================

PROCEDURE scenario_const_i18n_en_resout_vers_fr()
	dbgVérifieEgalité(languageFrench, langueFrançais,
	"languageFrench resout vers le meme tag que langueFrançais")
	dbgVérifieEgalité(languageFrench, "fr-FR",
	"languageFrench vaut exactement fr-FR")

	dbgVérifieEgalité(languageEnglish, langueAnglais,
	"languageEnglish resout vers le meme tag que langueAnglais")
	dbgVérifieEgalité(languageEnglish, "en-US",
	"languageEnglish vaut exactement en-US")

	dbgVérifieEgalité(languageGerman, langueAllemand,
	"languageGerman resout vers le meme tag que langueAllemand")
	dbgVérifieEgalité(languageGerman, "de-DE",
	"languageGerman vaut exactement de-DE")

	dbgVérifieEgalité(languageJapanese, langueJaponais,
	"languageJapanese resout vers le meme tag que langueJaponais")
	dbgVérifieEgalité(languageJapanese, "ja-JP",
	"languageJapanese vaut exactement ja-JP")

	dbgVérifieEgalité(languageArabic, langueArabe,
	"languageArabic resout vers le meme tag que langueArabe")
	dbgVérifieEgalité(languageArabic, "ar-SA",
	"languageArabic vaut exactement ar-SA")
FIN
