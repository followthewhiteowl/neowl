// AlignH : alignement horizontal par defaut des enfants.

FEN_AlignH est une Fenêtre
	PROPRIETES
		Titre       = "AlignH defaut"
		Largeur     = 400
		Hauteur     = 300
		Disposition = dispVerticale
		AlignH      = alignCentre
		Espacement  = 10
	FIN
	BTN_A est un Champ Bouton
		PROPRIETES
			Libellé = "Bouton A"
			Largeur = 120
		FIN
	FIN
	BTN_B est un Champ Bouton
		PROPRIETES
			Libellé = "Bouton B"
			Largeur = 80
		FIN
	FIN
	BTN_Override est un Champ Bouton
		PROPRIETES
			Libellé    = "Override"
			Largeur    = 100
			Alignement = alignFin
		FIN
	FIN
FIN
