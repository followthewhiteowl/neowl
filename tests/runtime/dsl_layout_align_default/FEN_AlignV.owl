// AlignV : alignement vertical par defaut des enfants.

FEN_AlignV est une Fenêtre
	PROPRIETES
		Titre       = "AlignV defaut"
		Largeur     = 400
		Hauteur     = 300
		Disposition = dispHorizontale
		AlignV      = alignFin
		Espacement  = 8
	FIN
	LIB_A est un Champ Libellé
		PROPRIETES
			Libellé = "Premier"
			Hauteur = 50
		FIN
	FIN
	LIB_B est un Champ Libellé
		PROPRIETES
			Libellé = "Deuxieme"
			Hauteur = 30
		FIN
	FIN
FIN
