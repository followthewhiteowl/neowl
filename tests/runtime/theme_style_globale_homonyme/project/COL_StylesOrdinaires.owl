// Globale ORDINAIRE homonyme d'un style du thème désigné. En mode projet un
// compagnon plat est un script privé : le partage passe donc par une
// CollectionDeProcédures, dont les membres GLOBAL s'adressent par leur nom nu.
COL_StylesOrdinaires est une CollectionDeProcédures
	GLOBAL
	stAmbiance est un styleSaisie = {
		ZoneSaisie = { CouleurFond = RVB(250, 250, 250) }
	}
FIN
