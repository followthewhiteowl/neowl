// Fenêtre voisine — disposition automatique horizontale, symétrique de
// FEN_GeoEcriture (verticale). Sert à vérifier que le contrat de taille
// (axe de la pile devient une contrainte réelle et persistante) tient
// aussi bien en horizontal qu'en vertical. Fond de couleur sur chaque
// champ pour mesure au pixel, indépendante de la propriété testée.

FEN_GeoEcritureHorizontale est une Fenêtre
	PROPRIETES
		Titre       = "Écriture de géométrie en disposition automatique (horizontale)"
		Largeur     = 400
		Hauteur     = 200
		Disposition = dispHorizontale
		Espacement  = 4
		CouleurFond = RVB(5, 5, 5)
	FIN

	LIB_PileH est un Champ Libellé
		PROPRIETES
			Libellé                            = "P"
			Largeur                            = 30
			Alignement                         = alignÉtire
			Style..CadreExtérieur..CouleurFond = RVB(200, 0, 0)
		FIN
	FIN

	LIB_SuivantH est un Champ Libellé
		PROPRIETES
			Libellé                            = "S"
			Largeur                            = 30
			Hauteur                            = 60
			Alignement                         = alignDébut
			Style..CadreExtérieur..CouleurFond = RVB(0, 200, 0)
		FIN
	FIN
FIN
