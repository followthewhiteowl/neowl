// Fenêtre voisine — disposition automatique (verticale), 400 x 300.
//
// Sert à verrouiller ce que devient une écriture de géométrie quand c'est
// le layout qui place les champs. Les deux champs portent un fond de
// couleur pour que leur position réelle soit mesurable au pixel, sans
// passer par la propriété que l'on teste.

FEN_GeoEcriture est une Fenêtre
	PROPRIETES
		Titre       = "Écriture de géométrie en disposition automatique"
		Largeur     = 400
		Hauteur     = 300
		Disposition = dispVerticale
		Espacement  = 4
		CouleurFond = RVB(5, 5, 5)
	FIN

	LIB_Pile est un Champ Libellé
		PROPRIETES
			Libellé                            = "P"
			Hauteur                            = 30
			Alignement                         = alignÉtire
			Style..CadreExtérieur..CouleurFond = RVB(200, 0, 0)
		FIN
	FIN

	LIB_Suivant est un Champ Libellé
		PROPRIETES
			Libellé                            = "S"
			Hauteur                            = 30
			Largeur                            = 120
			Alignement                         = alignDébut
			Style..CadreExtérieur..CouleurFond = RVB(0, 200, 0)
		FIN
	FIN
FIN
