//  — styleInterrupteur (widget) = struct {CadreExtérieur, TexteOptions,
// Coche, CadreCoche}. CadreExtérieur réutilise styleCadreExtérieur (patron
// Bouton/Image/Libellé). TexteOptions est la brique texte (Couleur/Police) du
// texte de chaque case. Coche et CadreCoche décrivent la marque de coche et sa
// boîte (ajustés selon ce que Qt permet réellement, cf. ticket). Statique
// (pas d'États — comme Image/Libellé).
//
// ROUGE attendu : `styleInterrupteur` n'existe pas encore comme type.

Trace("=== styleInterrupteur (widget) : struct {CadreExtérieur, TexteOptions, Coche, CadreCoche} ===")

STY_Int est un styleInterrupteur

STY_Int..CadreExtérieur..CouleurFond      = GrisFoncé
STY_Int..CadreExtérieur..Cadre..Couleur   = Rouge
STY_Int..CadreExtérieur..Cadre..Epaisseur = 3

dbgVérifieEgalité(STY_Int..CadreExtérieur..CouleurFond, GrisFoncé, "styleInterrupteur..CadreExtérieur..CouleurFond posée")
dbgVérifieEgalité(STY_Int..CadreExtérieur..Cadre..Couleur, Rouge, "styleInterrupteur..CadreExtérieur..Cadre..Couleur (composé)")
dbgVérifieEgalité(STY_Int..CadreExtérieur..Cadre..Epaisseur, 3, "styleInterrupteur..CadreExtérieur..Cadre..Epaisseur (composé)")

STY_Int..TexteOptions..Couleur      = Blanc
STY_Int..TexteOptions..Police..Gras = Vrai

dbgVérifieEgalité(STY_Int..TexteOptions..Couleur, Blanc, "styleInterrupteur..TexteOptions..Couleur posée")
dbgVérifieEgalité(STY_Int..TexteOptions..Police..Gras, Vrai, "styleInterrupteur..TexteOptions..Police..Gras (composé)")

STY_Int..Coche..Couleur = Vert

dbgVérifieEgalité(STY_Int..Coche..Couleur, Vert, "styleInterrupteur..Coche..Couleur posée")

STY_Int..CadreCoche..CouleurFond      = Bleu
STY_Int..CadreCoche..Cadre..Epaisseur = 2

dbgVérifieEgalité(STY_Int..CadreCoche..CouleurFond, Bleu, "styleInterrupteur..CadreCoche..CouleurFond posée")
dbgVérifieEgalité(STY_Int..CadreCoche..Cadre..Epaisseur, 2, "styleInterrupteur..CadreCoche..Cadre..Epaisseur (composé)")

dbgBilanTest()
