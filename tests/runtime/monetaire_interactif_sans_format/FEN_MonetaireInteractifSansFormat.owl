// Fenêtre voisine — champ typSaisieMonétaire SANS FormatMonétaire effectif
// (ni champ ni projet) + champ voisin pour déclencher un focus-out réel via
// DonneFocus.

FEN_MonetaireInteractifSansFormat est une Fenêtre
	PROPRIETES
		Titre       = "Monétaire interactif - sans format (non-régression)"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 160
	FIN

	SAI_Montant est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 10
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieMonétaire
			Valeur     = ""
		FIN
	FIN

	SAI_Autre est un Champ Saisie
		PROPRIETES
			X       = 10
			Y       = 50
			Largeur = 180
			Hauteur = 24
			Valeur  = ""
		FIN
	FIN
FIN
