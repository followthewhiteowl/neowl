// Fenetre voisine pour test_window_icone_catalogue.
// L'icone est declaree depuis le catalogue integre (ObjIcone),
// pas un chemin fichier disque. Avant le fix, ce chemin de
// declaration ignorait silencieusement l'icone catalogue.

FEN_IconeCatalogue est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 300
		Hauteur     = 180
		Titre       = "Icone catalogue fenetre"
		Icone       = icones.save
	FIN

	PROCEDURE PoseIconeCatalogue()
		FEN_IconeCatalogue..Icone = icones.Delete
	FIN

	PROCEDURE PoseIconeFichier(chemin est une chaine)
		FEN_IconeCatalogue..Icone = chemin
	FIN

	PROCEDURE VideIcone()
		FEN_IconeCatalogue..Icone = ""
	FIN
FIN
