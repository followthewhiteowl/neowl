PROCEDURE scenario_image()
	dbgVérifieEgalité(BackgroundSolid, FondPlein, "BackgroundSolid resout vers FondPlein")
	dbgVérifieEgalité(BackgroundTransparent, FondTransparent,
	"BackgroundTransparent resout vers FondTransparent")
	dbgVérifieEgalité(BackgroundHatched, FondHachuré,
	"BackgroundHatched resout vers FondHachure")
	dbgVérifieEgalité(drNoEnlarge, drSansAgrandissement,
	"drNoEnlarge resout vers drSansAgrandissement")
FIN

PROCEDURE scenario_textline()
	dbgVérifieEgalité(TLNormal, TLNormal, "TLNormal (EN==FR) stable")
	dbgVérifieEgalité(TLMultiLine, TLMultiLigne, "TLMultiLine resout vers TLMultiLigne")
FIN

PROCEDURE scenario_xml()
	dbgVérifieEgalité(XMLComment, XMLCommentaire, "XMLComment resout vers XMLCommentaire")
	dbgVérifieEgalité(XMLPITag, XMLBalisePI, "XMLPITag resout vers XMLBalisePI")
FIN

PROCEDURE scenario_erreur()
	dbgVérifieEgalité(errFunction, errFonction, "errFunction resout vers errFonction")
	dbgVérifieEgalité(errNumericCode, errCodeNum, "errNumericCode resout vers errCodeNum")
FIN

PROCEDURE scenario_eol()
	// LF : nameEN == FR (pose benin). Valeur ancree via Caract() pour
	// eviter toute hypothese sur l'echappement \n dans un litteral OWL.
	//
	// Ce scenario porte sur le nameEN DES CONSTANTES. CR n'etant plus une
	// constante, il n'a plus rien a y faire : sa couverture (forme heritee
	// resolue hors registre) vit dans
	// tests/regression/test_eol_lot1_rc_cr_compat.owl.
	dbgVérifieEgalité(LF, Caract(10), "LF vaut le line feed (Caract 10)")
	dbgVérifieEgalité(Taille(LF), 1, "LF fait 1 octet")
FIN

PROCEDURE scenario_durees()
	dbgVérifieEgalité(durationCenti, duréeCentième,
	"durationCenti resout vers dureeCentieme")
	dbgVérifieEgalité(durationMilli, duréeMillième,
	"durationMilli resout vers dureeMillieme")
FIN

PROCEDURE scenario_selecteur()
	dbgVérifieEgalité(selectedRow, ligneSélectionnée,
	"selectedRow resout vers ligneSelectionnee")
FIN

scenario_dialogues()
scenario_alignements()
scenario_mime()
scenario_zip()
scenario_langues()
scenario_fichiers()
scenario_image()
scenario_textline()
scenario_xml()
scenario_erreur()
scenario_eol()
scenario_durees()
scenario_selecteur()
dbgBilanTest()
