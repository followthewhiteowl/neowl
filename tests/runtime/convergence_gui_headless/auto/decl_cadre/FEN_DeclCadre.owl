// Fenêtre voisine — ressource pour test_decl_cadre.owl (canon DSL strict).
//
// Harnais convergence (déclaratif) — Cadre composé. Propriété Cadre posée en
// PROPRIETES doit être lisible en mode test. Valeurs remontées au script test
// via callback_verifie depuis FinInitialisation.

FEN_DeclCadre est une Fenêtre
	PROPRIETES
		Titre       = "Test déclaratif Cadre"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 300
	FIN

	LIB_DeclCadre est un Champ Libellé
		PROPRIETES
			Libellé          = "Cadre déclaratif"
			X                = 50
			Y                = 50
			Largeur          = 300
			Hauteur          = 100
			Cadre..Epaisseur = 5
			Cadre..Couleur   = RVB(255, 0, 0)
			Cadre..Trait     = TraitContinu
		FIN
	FIN

	PROCEDURE FinInitialisation()
		callback_verifie(LIB_DeclCadre..Cadre..Epaisseur,
		LIB_DeclCadre..Cadre..Couleur,
		LIB_DeclCadre..Cadre..Trait)
	FIN
FIN
