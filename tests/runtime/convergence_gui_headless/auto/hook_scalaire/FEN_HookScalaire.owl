// Fenêtre voisine — ressource pour test_hook_scalaire.owl (canon DSL strict).

FEN_HookScalaire est une Fenêtre
	PROPRIETES
		Titre       = "Test hook scalaire"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 300
	FIN

	LIB_HookScalaire est un Champ Libellé
		PROPRIETES
			Libellé = "Initial"
			X       = 50
			Y       = 50
			Largeur = 300
			Hauteur = 50
		FIN

		LIB_HookScalaire..Libellé = "Modifié via hook"
	FIN

	PROCEDURE FinInitialisation()
		callback_verifie(LIB_HookScalaire..Libellé)
	FIN
FIN
