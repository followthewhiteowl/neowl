// Fenêtre voisine — ressource pour test_decl_police.owl (canon DSL strict).

FEN_DeclPolice est une Fenêtre
	PROPRIETES
		Titre       = "Test déclaratif Police"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 300
	FIN

	LIB_DeclPolice est un Champ Libellé
		PROPRIETES
			Libellé        = "Police déclarative"
			X              = 50
			Y              = 50
			Largeur        = 300
			Hauteur        = 100
			Police..Nom    = "Arial"
			Police..Taille = 20
			Police..Gras   = Vrai
		FIN
	FIN

	PROCEDURE FinInitialisation()
		callback_verifie(LIB_DeclPolice..Police..Nom,
		LIB_DeclPolice..Police..Taille,
		LIB_DeclPolice..Police..Gras)
	FIN
FIN
