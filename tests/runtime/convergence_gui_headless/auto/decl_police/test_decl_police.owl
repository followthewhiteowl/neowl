// Harnais convergence (déclaratif) — Police composé.
//
// État actuel : propriété Police posée en PROPRIETES est lue à 0 en mode test.
// État cible : après convergence, la lecture retournera la valeur déclarée.
//
// Pattern : la fenêtre voisine FEN_DeclPolice.owl appelle callback_verifie.

TestModeHeadless(Vrai)

nom est une chaîne = ""
taille est un entier = -1
gras est un booléen = Faux

PROCEDURE callback_verifie(n est une chaîne, t est un entier, g est un booléen)
	nom    = n
	taille = t
	gras   = g
FIN

Ouvre(FEN_DeclPolice)

Trace("=== Déclaratif Police (headless) ===")
Trace("Nom lu     : [" + nom + "] (attendu : Arial après Lot 1)")
Trace("Taille lue : " + taille + " (attendu : 20 après Lot 1)")
Trace("Gras lu    : " + gras + " (attendu : Vrai après Lot 1)")

dbgVérifieEgalité(nom, "Arial", "Déclaratif Police : Nom")
dbgVérifieEgalité(taille, 20, "Déclaratif Police : Taille")
dbgVérifieEgalité(gras, Vrai, "Déclaratif Police : Gras")

Ferme(FEN_DeclPolice)
dbgBilanTest()
