// Fenêtre voisine — ressource pour test_helper_scalaire.owl (canon DSL strict).
//
// Pattern helper : une PROCEDURE locale ConfigureLibelleViaHelper(champ) reçoit
// le champ en paramètre et écrit son Libellé. L'invocation a lieu depuis
// FinInitialisation pour rester dans une zone autorisée par le canon strict.

FEN_HelperScalaire est une Fenêtre
	PROPRIETES
		Titre       = "Test helper scalaire"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 300
	FIN

	LIB_HelperScalaire est un Champ Libellé
		PROPRIETES
			Libellé = "Initial"
			X       = 50
			Y       = 50
			Largeur = 300
			Hauteur = 50
		FIN
	FIN

	PROCEDURE ConfigureLibelleViaHelper(Champ est un Champ)
		Champ..Libellé = "Modifié via helper"
	FIN

	PROCEDURE FinInitialisation()
		ConfigureLibelleViaHelper(LIB_HelperScalaire)
		callback_verifie(LIB_HelperScalaire..Libellé)
	FIN
FIN
