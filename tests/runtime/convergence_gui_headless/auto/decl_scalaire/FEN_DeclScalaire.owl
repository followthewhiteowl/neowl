// Fenêtre voisine — ressource pour test_decl_scalaire.owl (canon DSL strict).

FEN_DeclScalaire est une Fenêtre
	PROPRIETES
		Titre       = "Test déclaratif scalaire"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 300
	FIN

	LIB_DeclScalaire est un Champ Libellé
		PROPRIETES
			Libellé = "Texte déclaratif"
			X       = 50
			Y       = 50
			Largeur = 300
			Hauteur = 50
		FIN
	FIN

	PROCEDURE FinInitialisation()
		callback_verifie(LIB_DeclScalaire..Libellé)
	FIN
FIN
