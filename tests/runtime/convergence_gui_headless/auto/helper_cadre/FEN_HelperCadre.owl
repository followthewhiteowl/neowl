// Fenêtre voisine — ressource pour test_helper_cadre.owl (canon DSL strict).
//
// Pattern helper : une PROCEDURE locale ConfigureCadreViaHelper(champ) reçoit
// le champ en paramètre et écrit ses propriétés. L'invocation a lieu depuis
// FinInitialisation pour rester dans une zone autorisée par le canon strict.

FEN_HelperCadre est une Fenêtre
	PROPRIETES
		Titre       = "Test helper Cadre"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 300
	FIN

	LIB_HelperCadre est un Champ Libellé
		PROPRIETES
			Libellé = "Cadre via helper"
			X       = 50
			Y       = 50
			Largeur = 300
			Hauteur = 100
		FIN
	FIN

	PROCEDURE ConfigureCadreViaHelper(Champ est un Champ)
		Champ..Cadre..Epaisseur = 6
		Champ..Cadre..Couleur   = RVB(0, 0, 255)
		Champ..Cadre..Trait     = TraitDouble
	FIN

	PROCEDURE FinInitialisation()
		ConfigureCadreViaHelper(LIB_HelperCadre)
		callback_verifie(LIB_HelperCadre..Cadre..Epaisseur,
		LIB_HelperCadre..Cadre..Couleur,
		LIB_HelperCadre..Cadre..Trait)
	FIN
FIN
