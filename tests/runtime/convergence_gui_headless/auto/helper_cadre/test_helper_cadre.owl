// Harnais convergence (helper via référence) — Cadre composé.
//
// Pattern : la fenêtre voisine FEN_HelperCadre.owl invoque une PROCEDURE
// locale ConfigureCadreViaHelper(champ) depuis FinInitialisation pour
// factoriser l'écriture des propriétés du Cadre. Les valeurs sont ensuite
// relues et remontées au script test via callback_verifie.

TestModeHeadless(Vrai)

epais est un entier = -1
coul est un entier = -1
trait est un entier = -1

PROCEDURE callback_verifie(e est un entier, c est un entier, t est un entier)
	epais = e
	coul  = c
	trait = t
FIN

Ouvre(FEN_HelperCadre)

Trace("=== Helper Cadre (headless) ===")
Trace("Epaisseur lue : " + epais + " (attendu : 6)")
Trace("Couleur lue   : " + coul + " (attendu : RVB(0,0,255))")
Trace("Trait lu      : " + trait + " (attendu : TraitDouble)")

dbgVérifieEgalité(epais, 6, "Helper Cadre : Epaisseur")
dbgVérifieEgalité(coul, RVB(0, 0, 255), "Helper Cadre : Couleur")
dbgVérifieEgalité(trait, TraitDouble, "Helper Cadre : Trait")

Ferme(FEN_HelperCadre)
dbgBilanTest()
