// Harnais convergence (impératif hook) — Cadre composé.
//
// État actuel : écriture dans le hook Initialisation du champ alimente le
// stockage interne (lisible en mode test) mais n'atteint jamais l'affichage.
// État cible : après convergence (Lot 2), l'écriture impérative est reflétée
// à l'affichage également.
//
// Pattern : la fenêtre voisine FEN_HookCadre.owl appelle callback_verifie.

TestModeHeadless(Vrai)

epais est un entier = -1
coul est un entier = -1
trait est un entier = -1

PROCEDURE callback_verifie(e est un entier, c est un entier, t est un entier)
	epais = e
	coul  = c
	trait = t
FIN

Ouvre(FEN_HookCadre)

Trace("=== Hook Cadre (headless) ===")
Trace("Epaisseur lue : " + epais + " (attendu : 8)")
Trace("Couleur lue   : " + coul + " (attendu : RVB(0,255,0))")
Trace("Trait lu      : " + trait + " (attendu : TraitTiret)")

dbgVérifieEgalité(epais, 8, "Hook Cadre : Epaisseur")
dbgVérifieEgalité(coul, RVB(0, 255, 0), "Hook Cadre : Couleur")
dbgVérifieEgalité(trait, TraitTiret, "Hook Cadre : Trait")

Ferme(FEN_HookCadre)
dbgBilanTest()
