// Fenêtre voisine — ressource pour test_hook_cadre.owl (canon DSL strict).

FEN_HookCadre est une Fenêtre
	PROPRIETES
		Titre       = "Test hook Cadre"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 300
	FIN

	LIB_HookCadre est un Champ Libellé
		PROPRIETES
			Libellé = "Cadre via hook"
			X       = 50
			Y       = 50
			Largeur = 300
			Hauteur = 100
		FIN

		LIB_HookCadre..Cadre..Epaisseur = 8
		LIB_HookCadre..Cadre..Couleur   = RVB(0, 255, 0)
		LIB_HookCadre..Cadre..Trait     = TraitTiret
	FIN

	PROCEDURE FinInitialisation()
		callback_verifie(LIB_HookCadre..Cadre..Epaisseur,
		LIB_HookCadre..Cadre..Couleur,
		LIB_HookCadre..Cadre..Trait)
	FIN
FIN
