// Fenêtre voisine — ressource pour test_helper_police.owl (canon DSL strict).
//
// Pattern helper : une PROCEDURE locale ConfigurePoliceViaHelper(champ) reçoit
// le champ en paramètre et écrit ses propriétés. L'invocation a lieu depuis
// FinInitialisation pour rester dans une zone autorisée par le canon strict.

FEN_HelperPolice est une Fenêtre
	PROPRIETES
		Titre       = "Test helper Police"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 300
	FIN

	LIB_HelperPolice est un Champ Libellé
		PROPRIETES
			Libellé = "Police via helper"
			X       = 50
			Y       = 50
			Largeur = 300
			Hauteur = 100
		FIN
	FIN

	PROCEDURE ConfigurePoliceViaHelper(Champ est un Champ)
		Champ..Police..Nom      = "Verdana"
		Champ..Police..Taille   = 14
		Champ..Police..Souligné = Vrai
	FIN

	PROCEDURE FinInitialisation()
		ConfigurePoliceViaHelper(LIB_HelperPolice)
		callback_verifie(LIB_HelperPolice..Police..Nom,
		LIB_HelperPolice..Police..Taille,
		LIB_HelperPolice..Police..Souligné)
	FIN
FIN
