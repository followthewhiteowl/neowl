// Harnais convergence (helper via référence) — Police composé.
//
// Pattern : la fenêtre voisine FEN_HelperPolice.owl invoque une PROCEDURE
// locale ConfigurePoliceViaHelper(champ) depuis FinInitialisation pour
// factoriser l'écriture des propriétés de la Police. Les valeurs sont ensuite
// relues et remontées au script test via callback_verifie.

TestModeHeadless(Vrai)

nom est une chaîne = ""
taille est un entier = -1
soulignee est un booléen = Faux

PROCEDURE callback_verifie(n est une chaîne, t est un entier, s est un booléen)
	nom       = n
	taille    = t
	soulignee = s
FIN

Ouvre(FEN_HelperPolice)

Trace("=== Helper Police (headless) ===")
Trace("Nom lu        : [" + nom + "] (attendu : Verdana)")
Trace("Taille lue    : " + taille + " (attendu : 14)")
Trace("Souligné lue : " + soulignee + " (attendu : Vrai)")

dbgVérifieEgalité(nom, "Verdana", "Helper Police : Nom")
dbgVérifieEgalité(taille, 14, "Helper Police : Taille")
dbgVérifieEgalité(soulignee, Vrai, "Helper Police : Souligné")

Ferme(FEN_HelperPolice)
dbgBilanTest()
