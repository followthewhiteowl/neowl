// Fenêtre voisine — ressource pour test_hook_police.owl (canon DSL strict).

FEN_HookPolice est une Fenêtre
	PROPRIETES
		Titre       = "Test hook Police"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 300
	FIN

	LIB_HookPolice est un Champ Libellé
		PROPRIETES
			Libellé = "Police via hook"
			X       = 50
			Y       = 50
			Largeur = 300
			Hauteur = 100
		FIN

		LIB_HookPolice..Police..Nom      = "Courier New"
		LIB_HookPolice..Police..Taille   = 16
		LIB_HookPolice..Police..Italique = Vrai
	FIN

	PROCEDURE FinInitialisation()
		callback_verifie(LIB_HookPolice..Police..Nom,
		LIB_HookPolice..Police..Taille,
		LIB_HookPolice..Police..Italique)
	FIN
FIN
