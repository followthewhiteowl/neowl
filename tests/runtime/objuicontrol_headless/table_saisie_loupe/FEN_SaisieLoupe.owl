// Fenêtre voisine — ressource pour test_table_saisie_loupe.owl.
// Table avec deux colonnes pour exercer la saisie loupe programmatique.

FEN_SaisieLoupe est une Fenêtre
	PROPRIETES
		Titre       = "Saisie loupe programmatique"
		Disposition = dispLibre
	FIN

	TAB_Clients est un Champ Table
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 400
			Hauteur = 300
		FIN

		COL_Nom est une Colonne
			PROPRIETES
				Libellé = "Nom"
				Type    = colTypeTexte
				Largeur = 200
			FIN
		FIN

		COL_Ville est une Colonne
			PROPRIETES
				Libellé = "Ville"
				Type    = colTypeTexte
				Largeur = 150
			FIN
		FIN
	FIN
FIN
