// Fenêtre voisine — ressource pour test_valeur_renvoyee_initialisation.owl.
// FinInitialisation ferme immédiatement avec valeur 42 pour test ValeurRenvoyée.

FEN_X est une Fenêtre
	PROPRIETES
		Titre       = "Test ValeurRenvoyee"
		Disposition = dispLibre
	FIN

	// Top-level fenetre (remplace Initialisation) — Ferme immediate avec valeur
	PROCEDURE FinInitialisation()
