// Test: Ouvre() en CLI test execute le top-level de la fenetre.
// Pattern : la fenêtre voisine FEN_X.owl porte la déclaration (avec top-level).

// Modele C  : Ouvre en mode test execute le top-level, skip Qt event loop
Ouvre(FEN_X)

// Apres Ouvre : top-level a peuple les props
dbgVérifieEgalité(SAI_Nom..Valeur, "Initialise", "SAI_Nom..Valeur peuple par top-level")
dbgVérifieVrai(BTN_Action..Visible = Faux, "BTN_Action..Visible modifie par top-level")

Ferme(FEN_X)

dbgBilanTest()
