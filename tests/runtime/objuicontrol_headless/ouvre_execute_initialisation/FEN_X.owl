// Fenêtre voisine — ressource pour test_ouvre_execute_initialisation.owl.
// Le top-level fenêtre peuple SAI_Nom et BTN_Action après matérialisation.

FEN_X est une Fenêtre
	PROPRIETES
		Titre       = "Test Top-level"
		Disposition = dispLibre
	FIN

	SAI_Nom est un Champ Saisie
		PROPRIETES
		FIN
	FIN

	BTN_Action est un Champ Bouton
		PROPRIETES
			Libellé = "Action"
		FIN
	FIN

	// Top-level fenetre (remplace Initialisation)
	SAI_Nom..Valeur     = "Initialise"
	BTN_Action..Visible = Faux
FIN
