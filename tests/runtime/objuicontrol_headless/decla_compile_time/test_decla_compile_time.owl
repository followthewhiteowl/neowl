// Test: ObjUiControl materialize au compile-time, accessible sans Ouvre().
// Pattern : la fenêtre voisine FEN_Demo.owl porte la déclaration.

Ouvre(FEN_Demo)

// Modele C  : Ouvre d'abord, puis acces champs
BTN_OK..Visible = Faux
dbgVérifieVrai(BTN_OK..Visible = Faux, "BTN_OK..Visible assignable et lisible apres Ouvre()")

SAI_Nom..Valeur = "Test"
dbgVérifieEgalité(SAI_Nom..Valeur, "Test", "SAI_Nom..Valeur assignable et lisible apres Ouvre()")

Ferme(FEN_Demo)

dbgBilanTest()
