// Fenêtre voisine — ressource pour test_table_occurrence_affichee.owl.
// Deux tables : une mixte (lignes pleines + vides) et une entièrement pleine.

FEN_Occ est une Fenêtre
	PROPRIETES
		Titre       = "Occurrence lignes non vides"
		Disposition = dispLibre
	FIN

	TAB_Mix est un Champ Table
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 400
			Hauteur = 300
		FIN

		COL_A est une Colonne
			PROPRIETES
				Libellé = "A"
				Type    = colTypeTexte
				Largeur = 150
			FIN
		FIN

		COL_B est une Colonne
			PROPRIETES
				Libellé = "B"
				Type    = colTypeTexte
				Largeur = 150
			FIN
		FIN
	FIN

	TAB_Plein est un Champ Table
		PROPRIETES
			X       = 10
			Y       = 320
			Largeur = 400
			Hauteur = 300
		FIN

		COL_X est une Colonne
			PROPRIETES
				Libellé = "X"
				Type    = colTypeTexte
				Largeur = 150
			FIN
		FIN
	FIN
FIN
