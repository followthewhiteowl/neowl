// Fenêtre voisine — ressource pour test_table_desactive_filtre.owl.
// Deux colonnes (COL_Nom, COL_Ville) pour distinguer "une colonne" vs
// "toutes les colonnes" au retrait.

FEN_Filtre est une Fenêtre
	PROPRIETES
		Titre       = "Desactivation de filtre"
		Disposition = dispLibre
	FIN

	TAB_Donnees est un Champ Table
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 400
			Hauteur = 300
		FIN

		COL_Nom est une Colonne
			PROPRIETES
				Libellé = "Nom"
				Type    = colTypeTexte
				Largeur = 200
			FIN
		FIN

		COL_Ville est une Colonne
			PROPRIETES
				Libellé = "Ville"
				Type    = colTypeTexte
				Largeur = 200
			FIN
		FIN
	FIN
FIN
