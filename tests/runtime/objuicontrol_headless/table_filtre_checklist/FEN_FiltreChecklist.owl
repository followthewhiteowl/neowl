// Fenêtre voisine — ressource pour test_table_filtre_checklist.owl.
// TAB_Filtre : petite table (faible cardinalité) pour le filtre checklist
// IN {set} + intersection avec un filtre op+valeur existant.
// TAB_Grande : une seule colonne à forte cardinalité, pour verrouiller le
// comportement au-delà du seuil (pas de checklist).

FEN_FiltreChecklist est une Fenêtre
	PROPRIETES
		Titre       = "Filtre checklist valeurs distinctes"
		Disposition = dispLibre
	FIN

	TAB_Filtre est un Champ Table
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 400
			Hauteur = 300
		FIN

		COL_Nom est une Colonne
			PROPRIETES
				Libellé = "Nom"
				Type    = colTypeTexte
				Largeur = 150
			FIN
		FIN

		COL_Ville est une Colonne
			PROPRIETES
				Libellé = "Ville"
				Type    = colTypeTexte
				Largeur = 150
			FIN
		FIN
	FIN

	TAB_Grande est un Champ Table
		PROPRIETES
			X       = 10
			Y       = 320
			Largeur = 400
			Hauteur = 300
		FIN

		COL_V est une Colonne
			PROPRIETES
				Libellé = "V"
				Type    = colTypeTexte
				Largeur = 150
			FIN
		FIN
	FIN
FIN
