// Fenêtre voisine — ressource pour test_table_colonnes_filtrees.owl.
// Deux colonnes (COL_Nom, COL_Ville) pour exercer l'etat multi-colonnes
// (une colonne filtree vs plusieurs, retrait via valeur vide).

FEN_Filtre est une Fenêtre
	PROPRIETES
		Titre       = "Colonnes filtrees"
		Disposition = dispLibre
	FIN

	TAB_Donnees est un Champ Table
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 400
			Hauteur = 300
		FIN

		COL_Nom est une Colonne
			PROPRIETES
				Libellé = "Nom"
				Type    = colTypeTexte
				Largeur = 200
			FIN
		FIN

		COL_Ville est une Colonne
			PROPRIETES
				Libellé = "Ville"
				Type    = colTypeTexte
				Largeur = 200
			FIN
		FIN
	FIN
FIN
