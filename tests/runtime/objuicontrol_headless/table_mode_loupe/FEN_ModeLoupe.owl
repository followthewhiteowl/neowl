// Fenêtre voisine — ressource pour test_table_mode_loupe.owl.
// Table avec une colonne pour couvrir la propriété ModeLoupe.

FEN_ModeLoupe est une Fenêtre
	PROPRIETES
		Titre       = "Smoke ModeLoupe"
		Disposition = dispLibre
	FIN

	TAB_Donnees est un Champ Table
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 400
			Hauteur = 300
		FIN

		COL_Nom est une Colonne
			PROPRIETES
				Libellé = "Nom"
				Type    = colTypeTexte
				Largeur = 200
			FIN
		FIN
	FIN
FIN
