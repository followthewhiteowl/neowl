// Fenêtre voisine — ressource pour test_table_active_filtre.owl.
// Table avec une colonne pour smoke des operateurs filtre*.

FEN_Filtre est une Fenêtre
	PROPRIETES
		Titre       = "Smoke TableActiveFiltre"
		Disposition = dispLibre
	FIN

	TAB_Donnees est un Champ Table
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 400
			Hauteur = 300
		FIN

		COL_Nom est une Colonne
			PROPRIETES
				Libellé = "Nom"
				Type    = colTypeTexte
				Largeur = 200
			FIN
		FIN
	FIN
FIN
