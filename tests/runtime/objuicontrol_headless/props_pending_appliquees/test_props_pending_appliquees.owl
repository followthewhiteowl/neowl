// Test: Modele C - assignation props apres Ouvre fonctionne (headless storage).
// Pattern : la fenêtre voisine FEN_X.owl porte la déclaration.

// Modele C  : Ouvre d'abord
Ouvre(FEN_X)

// Assignations apres Ouvre : storage virtuel headless
BTN_OK..Visible = Faux
BTN_OK..Libellé = "Modifie"
SAI_Nom..Valeur = "Marc"

dbgVérifieVrai(BTN_OK..Visible = Faux, "BTN_OK..Visible ecrit/relu apres Ouvre")
dbgVérifieEgalité(BTN_OK..Libellé, "Modifie", "BTN_OK..Libelle ecrit/relu apres Ouvre")
dbgVérifieEgalité(SAI_Nom..Valeur, "Marc", "SAI_Nom..Valeur ecrit/relu apres Ouvre")

Ferme(FEN_X)

dbgBilanTest()
