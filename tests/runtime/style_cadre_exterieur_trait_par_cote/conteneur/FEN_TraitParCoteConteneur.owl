//  — trait de cadre par côté (TraitHaut/TraitBas/TraitGauche/
// TraitDroite) d'un Champ Conteneur. Chaque bord doit porter SA propre
// couleur (canon de référence, type Cadre).
//
// CNT_PerCote : les 4 bords en couleur distincte, épaisseur posée à la fois
// globalement (Epaisseur=12) ET sur chaque Trait* (Epaisseur=12) — la
// surcharge par bord (Couleur/Epaisseur) ne prend le pas qu'avec un
// Epaisseur ou Type propre au bord renseigné.
//
// CNT_Temoin : bordure globale uniforme (Couleur/Epaisseur seuls, aucun
// Trait*) — les 4 bords doivent rester dans la même couleur (non-régression).
FEN_TraitParCoteConteneur est une Fenêtre
	PROPRIETES
		Titre       = "Trait par côté — Conteneur"
		Largeur     = 360
		Hauteur     = 480
		Disposition = dispLibre
		CouleurFond = RVB(10, 10, 10)
	FIN

	CNT_PerCote est un Champ Conteneur
		PROPRIETES
			X                                                    = 20
			Y                                                    = 20
			Largeur                                              = 300
			Hauteur                                              = 200
			Style..CadreExtérieur..Cadre..Couleur                = RVB(1, 2, 3)
			Style..CadreExtérieur..Cadre..Epaisseur              = 12
			Style..CadreExtérieur..Cadre..TraitHaut..Couleur     = RVB(0, 255, 0)
			Style..CadreExtérieur..Cadre..TraitHaut..Epaisseur   = 12
			Style..CadreExtérieur..Cadre..TraitBas..Couleur      = RVB(0, 0, 255)
			Style..CadreExtérieur..Cadre..TraitBas..Epaisseur    = 12
			Style..CadreExtérieur..Cadre..TraitGauche..Couleur   = RVB(255, 255, 0)
			Style..CadreExtérieur..Cadre..TraitGauche..Epaisseur = 12
			Style..CadreExtérieur..Cadre..TraitDroite..Couleur   = RVB(255, 0, 255)
			Style..CadreExtérieur..Cadre..TraitDroite..Epaisseur = 12
		FIN
	FIN

	CNT_Temoin est un Champ Conteneur
		PROPRIETES
			X                                       = 20
			Y                                       = 240
			Largeur                                 = 300
			Hauteur                                 = 200
			Style..CadreExtérieur..Cadre..Couleur   = RVB(80, 80, 80)
			Style..CadreExtérieur..Cadre..Epaisseur = 12
		FIN
	FIN
FIN
