//  — trait de cadre par côté sur un Champ Table (bordure du
// QTableView). Rig GUI réel (TestModeHeadless(Faux) + OuvreSoeur +
// dCopieImageFenêtre + dPixelCouleur), bordure épaisse (12px) pour
// échantillonner un pixel franc SUR chaque bord (hors zone d'en-tête,
// dégradé natif Fusion sur QHeaderView).
//
// ROUGE attendu : les 4 côtés (haut/bas/gauche/droite) de TAB_PerCote
// rendent tous la couleur GLOBALE (Cadre..Couleur), jamais leur propre
// couleur Trait* — owl_table_border_css ne lit que Cadre..Couleur/Epaisseur
// scalaires, ignore les surcharges par côté.

TestModeHeadless(Faux)

OuvreSoeur(FEN_TraitParCoteTable)

img est une Image = dCopieImageFenêtre(FEN_TraitParCoteTable)
dbgVérifieEgalité(img..Valide, Vrai, "capture fenêtre valide")

// --- TAB_PerCote [20,20]-[520,220], épaisseur 12 : bandes internes --------
// haut y=21..31, bas y=209..219, gauche x=20..30, droite x=509..519.
dbgVérifieEgalité(dPixelCouleur(img, 270, 26), RVB(0, 255, 0),
"TAB_PerCote : bord haut = TraitHaut..Couleur RVB(0,255,0)")
dbgVérifieEgalité(dPixelCouleur(img, 270, 214), RVB(0, 0, 255),
"TAB_PerCote : bord bas = TraitBas..Couleur RVB(0,0,255)")
dbgVérifieEgalité(dPixelCouleur(img, 25, 120), RVB(255, 255, 0),
"TAB_PerCote : bord gauche = TraitGauche..Couleur RVB(255,255,0)")
dbgVérifieEgalité(dPixelCouleur(img, 514, 120), RVB(255, 0, 255),
"TAB_PerCote : bord droite = TraitDroite..Couleur RVB(255,0,255)")

// --- TAB_Temoin [20,240]-[520,440], épaisseur 12 : bordure globale seule --
// (non-régression : les 4 bords doivent rester la même couleur globale)
dbgVérifieEgalité(dPixelCouleur(img, 270, 246), RVB(80, 80, 80),
"TAB_Temoin : bord haut = Cadre..Couleur globale RVB(80,80,80), non-régression")
dbgVérifieEgalité(dPixelCouleur(img, 270, 434), RVB(80, 80, 80),
"TAB_Temoin : bord bas = Cadre..Couleur globale RVB(80,80,80), non-régression")
dbgVérifieEgalité(dPixelCouleur(img, 25, 340), RVB(80, 80, 80),
"TAB_Temoin : bord gauche = Cadre..Couleur globale RVB(80,80,80), non-régression")
dbgVérifieEgalité(dPixelCouleur(img, 514, 340), RVB(80, 80, 80),
"TAB_Temoin : bord droite = Cadre..Couleur globale RVB(80,80,80), non-régression")

Ferme(FEN_TraitParCoteTable)
dbgBilanTest()
