//  — trait de cadre par côté sur un Champ Saisie (wrapper
// CadreExtérieur). Rig GUI réel (TestModeHeadless(Faux) + OuvreSoeur +
// dCopieImageFenêtre + dPixelCouleur), bordure épaisse (12px) pour
// échantillonner un pixel franc SUR chaque bord.
//
// ROUGE attendu : les 4 côtés (haut/bas/gauche/droite) de SAI_PerCote
// rendent tous la couleur GLOBALE (Cadre..Couleur), jamais leur propre
// couleur Trait* — l'émetteur du wrapper Saisie ignore les surcharges par
// côté (ne lit que Cadre..Couleur/Epaisseur scalaires).

TestModeHeadless(Faux)

OuvreSoeur(FEN_TraitParCoteSaisie)

img est une Image = dCopieImageFenêtre(FEN_TraitParCoteSaisie)
dbgVérifieEgalité(img..Valide, Vrai, "capture fenêtre valide")

// --- SAI_PerCote [20,20]-[520,80], épaisseur 12 : bandes internes ---------
// haut y=20..31, bas y=69..80, gauche x=20..30, droite x=509..519.
dbgVérifieEgalité(dPixelCouleur(img, 270, 26), RVB(0, 255, 0),
"SAI_PerCote : bord haut = TraitHaut..Couleur RVB(0,255,0)")
dbgVérifieEgalité(dPixelCouleur(img, 270, 74), RVB(0, 0, 255),
"SAI_PerCote : bord bas = TraitBas..Couleur RVB(0,0,255)")
dbgVérifieEgalité(dPixelCouleur(img, 25, 50), RVB(255, 255, 0),
"SAI_PerCote : bord gauche = TraitGauche..Couleur RVB(255,255,0)")
dbgVérifieEgalité(dPixelCouleur(img, 514, 50), RVB(255, 0, 255),
"SAI_PerCote : bord droite = TraitDroite..Couleur RVB(255,0,255)")

// --- SAI_Temoin [20,140]-[520,200], épaisseur 12 : bordure globale seule --
// (non-régression : les 4 bords doivent rester la même couleur globale)
dbgVérifieEgalité(dPixelCouleur(img, 270, 146), RVB(80, 80, 80),
"SAI_Temoin : bord haut = Cadre..Couleur globale RVB(80,80,80), non-régression")
dbgVérifieEgalité(dPixelCouleur(img, 270, 194), RVB(80, 80, 80),
"SAI_Temoin : bord bas = Cadre..Couleur globale RVB(80,80,80), non-régression")
dbgVérifieEgalité(dPixelCouleur(img, 25, 170), RVB(80, 80, 80),
"SAI_Temoin : bord gauche = Cadre..Couleur globale RVB(80,80,80), non-régression")
dbgVérifieEgalité(dPixelCouleur(img, 514, 170), RVB(80, 80, 80),
"SAI_Temoin : bord droite = Cadre..Couleur globale RVB(80,80,80), non-régression")

Ferme(FEN_TraitParCoteSaisie)
dbgBilanTest()
