// Fenêtre voisine — ressource pour test_curseur_garde.owl.
//
// Exerce les DEUX chemins d'application de CurseurSouris au build :
//   1. CurseurSouris direct sur un champ (prop de contrôle, lue par
//      build_control).
//   2. Un Style générique appliqué via ..Style, dont l'application au
//      build passe par apply_style_to_control. Le support de ce Style
//      générique est la Fenêtre elle-même : c'est la surface qui accepte
//      encore le descripteur Style non typé (les champs ont chacun leur
//      styleXxx typé). Support incident — on teste que le chemin
//      d'application ne crashe pas sur les sentinelles, pas la Fenêtre.
//
// Les valeurs de sentinelle (toutes négatives) sont exercées pour
// vérifier qu'aucune ne déclenche un faux reset.

FEN_CurseurGarde est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 400
	FIN

	STY_Survol est un Style
	STY_Survol..Couleur     = Blanc
	STY_Survol..CouleurFond = BleuFoncé

	LIB_Direct00 est un Champ Libellé
		PROPRIETES
			Libellé       = "direct fleche"
			CurseurSouris = curFlèche
		FIN
	FIN
	LIB_Direct01 est un Champ Libellé
		PROPRIETES
			Libellé       = "direct main"
			CurseurSouris = curMain
		FIN
	FIN
	LIB_Direct13 est un Champ Libellé
		PROPRIETES
			Libellé       = "direct tailleNOSE"
			CurseurSouris = curTailleNOSE
		FIN
	FIN

	// Curseur direct de plus (curSablier), sur un champ ordinaire, pour
	// garder cette forme couverte après le déplacement du Style vers la
	// Fenêtre.
	LIB_Direct_Sablier est un Champ Libellé
		PROPRIETES
			Libellé       = "direct sablier"
			CurseurSouris = curSablier
		FIN
	FIN

	// Style générique appliqué à la Fenêtre : seule surface acceptant
	// encore le descripteur Style non typé. Exerce apply_style_to_control.
	FEN_CurseurGarde..Style = STY_Survol
FIN
