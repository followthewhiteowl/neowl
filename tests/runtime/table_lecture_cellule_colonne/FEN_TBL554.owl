// Ressource fenetre pour  — lecture cellule Table par programme,
// forme col-first TBL.COL_Nom[ligne].
// Memes donnees / meme store que table_lecture_cellule (forme ligne-first) : 2 colonnes
// typees COL_Id (numerique) + COL_Nom (texte), peuplees par FinInitialisation.

FEN_TBL554 est une Fenêtre
	PROPRIETES
		Titre       = "Table lecture cellule col-first"
		Disposition = dispLibre
		Largeur     = 600
		Hauteur     = 400
	FIN

	TBL est un Champ Table
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 560
			Hauteur = 340
		FIN

		COL_Id est une Colonne
			PROPRIETES
				Libellé = "Id"
				Type    = colTypeNumerique
				Largeur = 80
			FIN
		FIN

		COL_Nom est une Colonne
			PROPRIETES
				Libellé = "Nom"
				Type    = colTypeTexte
				Largeur = 240
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		TableAjouteLigne(TBL, 1, "Alice")
		TableAjouteLigne(TBL, 2, "Bob")
		cb_0554_init_done()
	FIN

	// PROCEDURE PUBLIQUE : lit TBL.COL_Nom[ligne] (col-first)
	PROCEDURE LireNomCol(nLigne est un entier)
		RENVOYER TBL.COL_Nom[nLigne]
	FIN

	// PROCEDURE PUBLIQUE : lit TBL.COL_Id[ligne] (col-first, type numerique)
	PROCEDURE LireIdCol(nLigne est un entier)
		RENVOYER TBL.COL_Id[nLigne]
	FIN

	// PROCEDURE PUBLIQUE : lit la meme cellule par les deux formes et
	// renvoie Vrai si elles sont egales (symetrie col-first == ligne-first).
	PROCEDURE SymetrieNom(nLigne est un entier)
		RENVOYER (TBL.COL_Nom[nLigne] = TBL[nLigne].COL_Nom)
	FIN
FIN
