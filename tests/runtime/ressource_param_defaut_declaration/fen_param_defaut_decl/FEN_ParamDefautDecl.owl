// Fenetre voisine — ressource pour test_fen_param_defaut_decl.owl.
//
//  : les params declares directement sur `Fenetre(...)` (pas ceux
// d'une PROCEDURE de son body, deja couverts par ) acceptent une
// valeur par defaut litterale. Deux types couverts : chaine + entier.

FEN_ParamDefautDecl est une Fenêtre(sParam est une chaîne = "def", nParam est un entier = 7)
	PROPRIETES
		Titre       = "Temoin defaut params fenetre"
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN

	PROCEDURE FinInitialisation()
		callback_observe_fen(sParam, nParam)
	FIN
FIN
