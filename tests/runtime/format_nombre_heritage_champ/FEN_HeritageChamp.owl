// Fenêtre voisine — ressource pour test_format_nombre_heritage_champ.owl. Un
// seul champ Numérique, volontairement SANS son propre `FormatNombre` : sert
// à prouver que c'est le `FormatNombre` du projet voisin qui pilote
// l'affichage (héritage projet -> champ), et que le round-trip GET
// dé-formate correctement le texte affiché pour restituer une valeur
// numérique exploitable.

FEN_HeritageChamp est une Fenêtre
	PROPRIETES
		Titre       = "FormatNombre héritage champ"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 120
	FIN

	SAI_Num est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 10
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieNum
			Valeur     = ""
		FIN
	FIN
FIN
