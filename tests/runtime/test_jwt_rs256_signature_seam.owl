pwIDAQAB
-----END PUBLIC KEY-----`

// Clé publique d'une paire RSA DISTINCTE (#2, jetable) : utilisée uniquement
// pour prouver que le seam ne valide pas n'importe quoi contre n'importe
// quelle clé.
sCléPubliqueAutre est une chaîne = `-----BEGIN PUBLIC KEY-----
MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAuKwqPrQMr7H6jWqY6vz8
sbty9SeVD6JzZInMnR+W6cqyF9neBhAzvplpoGCi/+kmnySyCQiyNH2pLlv+HNtg
f7jjggVQ5o3lyc3DL5AclWUksiUE4S/Zwo7B4eaEE66KJogZEFr/Qg3jk1RWMD9K
k8Ty0zli04DeWwIL4XFPPkhc2rFS9uzv9Fyxylccoa0HmEM0hiujg9Od3+tlUpHG
bNy41UXrbYNKGfw9XzuAbSIA31SEuLtYbmcjaom8FArvxVtJizli+x47T5x8lKKd
oPHKkB/gXClkUVJ+RrAoER/DjfOemUwOt0TaWMx7DcIwFLCEqVUgOVIiNqbMaD5x
lwIDAQAB
