// Clé publique correspondant exactement à la paire #1 ci-dessus : c'est
// contre elle que la signature de l'assertion DOIT se vérifier.
sCléPubliqueTest est une chaîne = `-----BEGIN PUBLIC KEY-----
MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA2gfV25g5719Ch501u3a/
qz5kjkhC03lawCMf5lA4Ql4yy63PE+orcEOkGsB7k7mhqNZaJs1C+KbaqC1cyRJS
