PROCEDURE avantChaqueTest()
	rep est un httpRéponse
	rep..CodeEtat = 200
	rep..Contenu  = `{"access_token":"atk-jwt-bearer","expires_in":3600}`
	mockHttp      = MockCrée(HTTPEnvoie).Quand().Retourne(rep).Active()
FIN


PROCEDURE apresChaqueTest()
	mockHttp.Désactive()
FIN


// Extrait la valeur de client_assertion dans le corps form-urlencoded
// (le '=' de préfixe évite toute collision avec client_assertion_type, qui
// partage le même préfixe).
PROCEDURE PRIVÉE extraitAssertion(sCorps est une chaîne)
	morceaux   est un tableau de chaînes = ChaîneDécoupe(sCorps, "&")
	sAssertion est une chaîne            = ""
	POUR TOUT morceau DE morceaux
		SI CommencePar(morceau, "client_assertion=") ALORS
			sAssertion = Milieu(morceau, Taille("client_assertion=") + 1)
		FIN
	FIN
	RENVOYER sAssertion
FIN


// L'assertion JWT RS256 émise par AuthIdentifie se vérifie cryptographiquement
// contre la clé publique correspondant exactement à la clé privée utilisée
// pour signer.
PROCEDURE scenario_signature_rs256_valide_contre_bonne_cle()
	jwtP est un JWTParamètres
	jwtP..Émetteur     = "mon-client"
	jwtP..Sujet        = "mon-client"
	jwtP..Consommateur = "https://auth.exemple.test/token"
	jwtP..URLToken     = "https://auth.exemple.test/token"
	jwtP..CléPrivée    = sCléPriveeTest
	jwtP..Cryptage     = jwtRS256

	AuthIdentifie(jwtP)

	reqCapturee est un httpRequête = MockDernierArgument(mockHttp, 1)
	sCorps      est une chaîne     = BufferVersChaîne(reqCapturee..Contenu)
	sAssertion  est une chaîne     = extraitAssertion(sCorps)
	dbgVérifieVrai(Taille(sAssertion) > 0, "client_assertion extrait du corps POST")

	dbgVérifieVrai(__JWTVerifieSignature(sAssertion, sCléPubliqueTest), "signature RS256 valide contre la clé publique correspondante")
FIN


// La même assertion, confrontée à la clé publique d'une AUTRE paire RSA, ne
// valide pas : preuve que le seam exerce une vraie vérification
// cryptographique et ne renvoie pas Vrai indépendamment de la clé fournie.
PROCEDURE scenario_signature_rs256_invalide_contre_mauvaise_cle()
	jwtP est un JWTParamètres
	jwtP..Émetteur     = "mon-client"
	jwtP..Sujet        = "mon-client"
	jwtP..Consommateur = "https://auth.exemple.test/token"
	jwtP..URLToken     = "https://auth.exemple.test/token"
	jwtP..CléPrivée    = sCléPriveeTest
	jwtP..Cryptage     = jwtRS256

	AuthIdentifie(jwtP)

	reqCapturee est un httpRequête = MockDernierArgument(mockHttp, 1)
	sCorps      est une chaîne     = BufferVersChaîne(reqCapturee..Contenu)
	sAssertion  est une chaîne     = extraitAssertion(sCorps)
	dbgVérifieVrai(Taille(sAssertion) > 0, "client_assertion extrait du corps POST")

	dbgVérifieFaux(__JWTVerifieSignature(sAssertion, sCléPubliqueAutre), "signature RS256 ne valide pas contre une clé publique d'une autre paire")
FIN


dbgBilanTest()
