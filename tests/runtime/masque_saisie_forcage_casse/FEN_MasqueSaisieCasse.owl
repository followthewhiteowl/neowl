// Fenêtre de test headless — 3 champs Saisie, un par constante de forçage
// de casse du masque de saisie.

FEN_MasqueSaisieCasse est une Fenêtre
	PROPRIETES
		Titre       = "Masque saisie — forçage de casse"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 300
	FIN

	SAI_Majus est un Champ Saisie
		PROPRIETES
			X            = 20
			Y            = 20
			Largeur      = 200
			MasqueSaisie = maskMajus
		FIN
	FIN

	SAI_Minus est un Champ Saisie
		PROPRIETES
			X            = 20
			Y            = 70
			Largeur      = 200
			MasqueSaisie = maskMinus
		FIN
	FIN

	SAI_PMajus est un Champ Saisie
		PROPRIETES
			X            = 20
			Y            = 120
			Largeur      = 200
			MasqueSaisie = maskPMajus
		FIN
	FIN

	SAI_MotsMajus est un Champ Saisie
		PROPRIETES
			X            = 20
			Y            = 170
			Largeur      = 200
			MasqueSaisie = maskMotsMajus
		FIN
	FIN
FIN
