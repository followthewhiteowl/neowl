//  (Option A) — Style..Image..Etats[survol]..Image et
// Style..Image..Etats[grisé]..Image doivent compiler une fois la collection
// styleImageBoutonEtats (2 slots _Survol/_Grise) installee sur styleImageBouton.
//
// ROUGE ATTENDU aujourd'hui : Style..Image..Etats n'existe pas encore
// ( = commentaire "Etats-ready" seulement, jamais installe). Le
// crochet [etat] sur Style..Image..Etats[...] est actuellement interprete
// comme une indexation invalide sur styleImageBouton lui-meme (message
// "le crochet [etat] doit viser le membre Etats") -> raison exacte a
// regenerer via --check une fois le champ Etats installe (cf. pattern
// documente dans tests/compile-error/style_element_zonesaisie_etat_bidon).

FEN_StyleBoutonImageEtatsCompile est une Fenêtre
	PROPRIETES
		Titre       = "Style bouton image etats compile"
		Disposition = dispLibre
		Largeur     = 420
		Hauteur     = 200
		CouleurFond = RVB(15, 15, 15)
	FIN

	BTN_Survol est un Champ Bouton
		PROPRIETES
			X                                  = 20
			Y                                  = 20
			Largeur                            = 96
			Hauteur                            = 96
			Style..Image..Image                = icones.add
			Style..Image..Etats[survol]..Image = icones.close
		FIN
	FIN

	BTN_Grise est un Champ Bouton
		PROPRIETES
			X                                 = 130
			Y                                 = 20
			Largeur                           = 96
			Hauteur                           = 96
			Style..Image..Image               = icones.add
			Style..Image..Etats[grisé]..Image = icones.close
		FIN
	FIN

	BTN_SurvolColore est un Champ Bouton
		PROPRIETES
			X                                  = 240
			Y                                  = 20
			Largeur                            = 96
			Hauteur                            = 96
			Style..Image..Image                = icones.add
			Style..Image..Etats[survol]..Image = {icones.close, Couleur = RVB(0, 200, 0)}
		FIN
	FIN

	PROCEDURE LitImageBase(nomChamp est une chaîne)
		SI nomChamp = "survol" ALORS
			RENVOYER BTN_Survol..Style..Image..Image
		SINON SI nomChamp = "grise" ALORS
			RENVOYER BTN_Grise..Style..Image..Image
		FIN
		RENVOYER icones.add
	FIN

	PROCEDURE LitImageEtatSurvol()
		RENVOYER BTN_Survol..Style..Image..Etats[survol]..Image
	FIN

	PROCEDURE LitImageEtatGrise()
		RENVOYER BTN_Grise..Style..Image..Etats[grisé]..Image
	FIN

FIN
