//  (Option A) — Style..Image..Etats[survol]/[grisé]..Image doit
// compiler ET stocker/relire la valeur posee. Rendu pixel reel traite a
// part (fragilite offscreen QIcon::Active/Disabled, cf. dossier voisin
// tests/runtime/style_bouton_image_etats/rendu/).
//
// ROUGE ATTENDU : la fenetre voisine ne compile pas encore (collection
// styleImageBoutonEtats absente de styleImageBouton).

TestModeHeadless(Vrai)

Ouvre(FEN_StyleBoutonImageEtatsCompile)

// Round-trip stockage : la valeur de base (Icône) reste inchangee...
imgBaseSurvol est une Icône = LitImageBase("survol")
dbgVérifieEgalité(imgBaseSurvol, icones.add, "BTN_Survol..Style..Image..Image reste icones.add (non ecrase par l'etat)")

imgBaseGrise est une Icône = LitImageBase("grise")
dbgVérifieEgalité(imgBaseGrise, icones.add, "BTN_Grise..Style..Image..Image reste icones.add (non ecrase par l'etat)")

// ...et l'etat survol/grisé stocke bien une valeur DIFFERENTE de la base.
imgEtatSurvol est une Icône = LitImageEtatSurvol()
dbgVérifieEgalité(imgEtatSurvol, icones.close, "BTN_Survol..Style..Image..Etats[survol]..Image = icones.close (stocke/relu)")

imgEtatGrise est une Icône = LitImageEtatGrise()
dbgVérifieEgalité(imgEtatGrise, icones.close, "BTN_Grise..Style..Image..Etats[grisé]..Image = icones.close (stocke/relu)")

Ferme(FEN_StyleBoutonImageEtatsCompile)
dbgBilanTest()
