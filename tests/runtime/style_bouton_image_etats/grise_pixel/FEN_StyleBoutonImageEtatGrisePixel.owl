//  (Option A) — Style..Image..Etats[grisé]..Image doit peindre une
// icône DIFFERENTE une fois BTN..Etat = Grisé posé (QIcon::Disabled swap).
// Etat Grisé est PERSISTANT (setEnabled(false)) -> capturable au pixel
// directement, sans interaction simulée (cf. style_bouton_etat_grise_pixel).
FEN_StyleBoutonImageEtatGrisePixel est une Fenêtre
	PROPRIETES
		Titre       = "Style bouton image état grisé (pixel)"
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 140
		CouleurFond = RVB(10, 10, 10)
	FIN

	BTN_Cible est un Champ Bouton
		PROPRIETES
			X                                 = 20
			Y                                 = 20
			Largeur                           = 96
			Hauteur                           = 96
			Style..Image..Image               = icones.add
			Style..Image..Etats[grisé]..Image = icones.close
		FIN
	FIN
FIN
