// Fenêtre voisine — ressource pour test_type_duree.owl (, Lot D
// « types de saisie » : ajout de typSaisieDurée, approche pragmatique —
// guidage de frappe + bornes UNIQUEMENT pour les formats FIXES ; saisie
// libre pour les formats variables/+N. Quatre champs Durée (un sans masque
// = défaut HH:MI:SS, un masque fixe HH:MI:SS explicite, un masque fixe
// JJ HH:MI:SS avec jours, un masque variable J HH:MI:SS = saisie libre)
// plus un champ Numérique et un champ Texte témoins (non-régression : le
// dispatch TypeSaisie partagé ne doit pas dévier le comportement des
// autres types).

FEN_TypeDuree est une Fenêtre
	PROPRIETES
		Titre       = "Type de saisie Durée"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 260
	FIN

	SAI_Duree est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 10
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieDurée
			Valeur     = ""
		FIN
	FIN

	SAI_DureeJours est un Champ Saisie
		PROPRIETES
			X               = 10
			Y               = 50
			Largeur         = 180
			Hauteur         = 24
			TypeSaisie      = typSaisieDurée
			MasqueAffichage = "JJ HH:MI:SS"
			Valeur          = ""
		FIN
	FIN

	SAI_DureeVariable est un Champ Saisie
		PROPRIETES
			X               = 10
			Y               = 90
			Largeur         = 180
			Hauteur         = 24
			TypeSaisie      = typSaisieDurée
			MasqueAffichage = "J HH:MI:SS"
			Valeur          = ""
		FIN
	FIN

	SAI_Num est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 130
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieNum
			Valeur     = ""
		FIN
	FIN

	SAI_Texte est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 170
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieTexte
			Valeur     = ""
		FIN
	FIN
FIN
