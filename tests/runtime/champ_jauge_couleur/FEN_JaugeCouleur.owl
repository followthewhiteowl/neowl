// Fenêtre voisine — jauges montées (offscreen) pour
// test_champ_jauge_couleur.owl. JAU_Sans n'a JAMAIS de CouleurJauge
// (état non défini attendu = Null) ; JAU_Col sert au round-trip de
// la couleur posée au runtime.

FEN_JaugeCouleur est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 120
	FIN

	// Sans couleur de progression : la lecture doit renvoyer Null.
	JAU_Sans est un Champ Jauge
		PROPRIETES
			X        = 10
			Y        = 10
			Largeur  = 300
			Hauteur  = 24
			BorneMin = 0
			BorneMax = 100
			Valeur   = 40
		FIN
	FIN

	// Couleur posée au runtime : round-trip get/set.
	JAU_Col est un Champ Jauge
		PROPRIETES
			X        = 10
			Y        = 50
			Largeur  = 300
			Hauteur  = 24
			BorneMin = 0
			BorneMax = 100
			Valeur   = 40
		FIN
	FIN
FIN
