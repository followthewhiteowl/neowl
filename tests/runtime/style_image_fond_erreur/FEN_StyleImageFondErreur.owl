//  (ST-B) — image de fond absente ou au format invalide : la
// fenêtre doit s'ouvrir sans crash et replier proprement sur le CouleurFond
// plat du conteneur (défaut neutre, pas de peinture avec des données
// invalides).
//
// ROUGE attendu : `ImageFond` inconnu sur styleCadreExtérieur aujourd'hui —
// erreur sémantique au compile (le fichier ne se lance pas).
FEN_StyleImageFondErreur est une Fenêtre
	PROPRIETES
		Titre       = "Style — image de fond invalide ou absente"
		Largeur     = 300
		Hauteur     = 160
		Disposition = dispLibre
		CouleurFond = RVB(10, 10, 10)
	FIN

	CNT_Absente est un Champ Conteneur
		PROPRIETES
			X                                        = 20
			Y                                        = 20
			Largeur                                  = 100
			Hauteur                                  = 100
			Disposition                              = dispLibre
			Style..CadreExtérieur..CouleurFond       = RVB(80, 80, 80)
			Style..CadreExtérieur..ImageFond..Source = "owl_test_2471_image_fond_absente_xyzzy.png"
		FIN
	FIN

	CNT_FormatInvalide est un Champ Conteneur
		PROPRIETES
			X                                        = 160
			Y                                        = 20
			Largeur                                  = 100
			Hauteur                                  = 100
			Disposition                              = dispLibre
			Style..CadreExtérieur..CouleurFond       = RVB(80, 80, 80)
			Style..CadreExtérieur..ImageFond..Source = fRepTemp() + "/owl_test_2471_image_fond_format_invalide.png"
		FIN
	FIN
FIN
