//  — champ monétaire dont le FormatMonétaire inline est VALIDE
// (symbole '€', milliers ' ' ≠ décimal ',') donc compile sans erreur. Le test
// mute ensuite le symbole ou un séparateur dynamiquement pour forger une config
// absurde à chaud : c'est le repli runtime (fmn_config_from_instance) qui la
// refuse, pas la porte compile-time (celle-ci ne voit que le littéral inline,
// couvert par tests/compile-error/monetaire_*).
FEN_FmnDynamique est une Fenêtre
	PROPRIETES
		Titre       = "FormatMonétaire config dynamique"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 120
	FIN
	SAI_MonDyn est un Champ Saisie
		PROPRIETES
			X               = 10
			Y               = 10
			Largeur         = 180
			Hauteur         = 24
			TypeSaisie      = typSaisieMonétaire
			FormatMonétaire = {Symbole = "€", SéparateurMilliers = " ", SéparateurDécimal = ",", ChiffresAprèsVirgule = 2}
			Valeur          = ""
		FIN
	FIN
FIN
