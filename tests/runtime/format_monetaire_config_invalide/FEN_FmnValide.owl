//  — champ monétaire avec un FormatMonétaire inline sain (symbole '€',
// milliers ' ', décimal ','). Non-régression : aucune erreur ne doit être levée
// à la résolution du format.
FEN_FmnValide est une Fenêtre
	PROPRIETES
		Titre       = "FormatMonétaire valide"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 120
	FIN
	SAI_MonValide est un Champ Saisie
		PROPRIETES
			X               = 10
			Y               = 10
			Largeur         = 180
			Hauteur         = 24
			TypeSaisie      = typSaisieMonétaire
			FormatMonétaire = {Symbole = "€", SéparateurMilliers = " ", SéparateurDécimal = ",", ChiffresAprèsVirgule = 2}
			Valeur          = ""
		FIN
	FIN
FIN
