//  — trois Champs Onglet identiques, à ceci près que chacun sert de
// témoin pour un réglage de la barre d'onglets. Le fond ROUGE de la languette
// active et le fond BLEU de la languette inactive servent de règle graduée :
// leurs frontières en pixels donnent la position de la barre, la largeur des
// languettes et la place du libellé dans la languette.

FEN_OngletBarre est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 640
		Hauteur     = 620
		Titre       = "Réglages de la barre d'onglets"
	FIN

	// Aucun réglage posé : barre en haut, largeur proportionnelle au libellé,
	// libellé centré. C'est la référence « rien de posé ne change rien ».
	ONG_Defaut est un Champ Onglet
		PROPRIETES
			X       = 0
			Y       = 0
			Largeur = 600
			Hauteur = 180

			Style..VoletActif..CouleurFond   = Rouge
			Style..VoletActif..Couleur       = Noir
			Style..VoletInactif..CouleurFond = Bleu
			Style..VoletInactif..Couleur     = Blanc
		FIN

		VOL_DefUn est un Volet
			PROPRIETES
				Libellé     = "Ok"
				Disposition = dispLibre
			FIN
		FIN

		VOL_DefDeux est un Volet
			PROPRIETES
				Libellé     = "Un libellé nettement plus long"
				Disposition = dispLibre
			FIN
		FIN
	FIN

	// Barre déplacée en bas + languettes de largeur égale + libellé aligné en
	// fin de languette : les trois réglages posés à la déclaration.
	ONG_Regle est un Champ Onglet
		PROPRIETES
			X       = 0
			Y       = 200
			Largeur = 600
			Hauteur = 180

			Position          = ongBas
			LargeurVolets     = largeurÉgale
			AlignementLibellé = alignFin

			Style..VoletActif..CouleurFond   = Rouge
			Style..VoletActif..Couleur       = Noir
			Style..VoletInactif..CouleurFond = Bleu
			Style..VoletInactif..Couleur     = Blanc
		FIN

		VOL_RegUn est un Volet
			PROPRIETES
				Libellé     = "Ok"
				Disposition = dispLibre
			FIN
		FIN

		VOL_RegDeux est un Volet
			PROPRIETES
				Libellé     = "Un libellé nettement plus long"
				Disposition = dispLibre
			FIN
		FIN
	FIN

	// Rien de posé à la déclaration : les trois réglages sont écrits après
	// l'ouverture, par programmation.
	ONG_Runtime est un Champ Onglet
		PROPRIETES
			X       = 0
			Y       = 400
			Largeur = 600
			Hauteur = 180

			Style..VoletActif..CouleurFond   = Rouge
			Style..VoletActif..Couleur       = Noir
			Style..VoletInactif..CouleurFond = Bleu
			Style..VoletInactif..Couleur     = Blanc
		FIN

		VOL_RunUn est un Volet
			PROPRIETES
				Libellé     = "Ok"
				Disposition = dispLibre
			FIN
		FIN

		VOL_RunDeux est un Volet
			PROPRIETES
				Libellé     = "Un libellé nettement plus long"
				Disposition = dispLibre
			FIN
		FIN
	FIN
FIN
