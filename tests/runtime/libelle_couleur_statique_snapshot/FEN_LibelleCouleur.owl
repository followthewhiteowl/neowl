// Fenetre voisine pour test_libelle_couleur_statique ( scoping).
// Un Champ Libelle avec Couleur = RVB(255, 0, 0) sur fond sombre.
// La couleur pure (rouge canal unique maximal) permet de detecter la
// presence du texte par comptage de pixels rouges exacts dans la capture.

FEN_LibelleCouleur est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 300
		Hauteur     = 150
		Titre       = "Libelle couleur statique"
		CouleurFond = RVB(20, 20, 20)
	FIN

	LIB_Rouge est un Champ Libellé
		PROPRIETES
			X            = 20
			Y            = 50
			Largeur      = 260
			Hauteur      = 60
			Libellé      = "WWWW"
			Couleur      = RVB(255, 0, 0)
			CouleurFond  = RVB(20, 20, 20)
			PoliceTaille = 18
		FIN
	FIN

FIN
