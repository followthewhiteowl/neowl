// Fenêtre voisine — ressource pour test_zone_repetee_select.owl.
//
// Un Champ ZoneRépétée par programmation, garni de 3 répétitions dans
// FinInitialisation. Sert à exercer la famille canon
// ZoneRépétéeSelect / SelectPlus / SelectMoins / SelectOccurrence.

FEN_ZoneRepeteeSelect est une Fenêtre
	PROPRIETES
		Titre       = "Sélection zone répétée"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 300
	FIN

	ZR_Lignes est un Champ ZoneRépétée
		PROPRIETES
			X                 = 10
			Y                 = 10
			Largeur           = 360
			Hauteur           = 200
			Sens              = zrVertical
			HauteurRepetition = 50
		FIN

		LIB_Vide est un Champ Libellé
			PROPRIETES
				X       = 5
				Y       = 5
				Largeur = 1
				Libellé = ""
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		ZoneRépétéeAjouteLigne(ZR_Lignes)
		ZoneRépétéeAjouteLigne(ZR_Lignes)
		ZoneRépétéeAjouteLigne(ZR_Lignes)
	FIN
FIN
