//  — anti-sur-rejet : un paramètre de Fenêtre `tableau de entier`
// doit toujours compiler et s'exécuter après l'alignement de la
// validation de type.

TestModeHeadless(Vrai)

tabValeurs est un tableau d'entiers
Ajoute(tabValeurs, 1)
Ajoute(tabValeurs, 2)
Ajoute(tabValeurs, 3)

nDimVu est un entier = 0

PROCEDURE callback_type_tableau(nDim est un entier)
	nDimVu = nDim
FIN

Ouvre(FEN_ParamTypeTableau, tabValeurs)

dbgVérifieEgalité(nDimVu, 3, "param tableau toujours accepté et injecté")

Ferme(FEN_ParamTypeTableau)
dbgBilanTest()
