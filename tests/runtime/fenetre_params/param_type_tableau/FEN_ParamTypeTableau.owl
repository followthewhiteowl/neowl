// Fenêtre voisine — ressource pour test_fenetre_param_type_tableau.owl.
//
// Vérifie qu'un paramètre de Fenêtre de type paramétré (`tableau de
// entier`) reste accepté ( : anti-sur-rejet des types composés).

FEN_ParamTypeTableau est une Fenêtre(t est un tableau de entiers)
	PROPRIETES
		Titre       = "Témoin param tableau"
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN

	PROCEDURE FinInitialisation()
		callback_type_tableau(Dimension(t))
	FIN
FIN
