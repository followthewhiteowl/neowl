//  — anti-sur-rejet : un paramètre de Fenêtre builtin avec valeur
// par défaut (`bpar est un booléen = Faux`) doit toujours compiler et
// s'exécuter, une fois la validation de type des paramètres de fenêtre
// alignée sur celle des procédures.

TestModeHeadless(Vrai)

vu_builtin_default est un booléen = Vrai

PROCEDURE callback_builtin_default(b est un booléen)
	vu_builtin_default = b
FIN

Ouvre(FEN_ParamBuiltinDefault)

dbgVérifieEgalité(vu_builtin_default, Faux, "param builtin + défaut toujours accepté et injecté")

Ferme(FEN_ParamBuiltinDefault)
dbgBilanTest()
