// Fenêtre voisine — ressource pour test_fenetre_param_basique.owl.
//
// Vérifie que les paramètres déclarés sur la première ligne du DSL Fenêtre
// sont accessibles depuis le top-level fenêtre, les events et les procédures internes.
//
// Couvre : 2 params typés, portée complète (top-level + event + procédure interne).

FEN_Param_Basique est une Fenêtre(niveau est un entier, etiquette est une chaîne)
	PROPRIETES
		Titre       = "Témoin params compile"
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN

	// Top-level fenêtre : référence aux params (portée globale attendue)
	Trace("init: niveau=" + niveau + " etiquette=" + etiquette)

	PROCEDURE FinInitialisation()
		// Event : même portée que le top-level
		callback_basique("ok")
	FIN

	PROCEDURE LireNiveau()
		// Procédure interne : même portée
		RENVOYER niveau
	FIN
FIN
