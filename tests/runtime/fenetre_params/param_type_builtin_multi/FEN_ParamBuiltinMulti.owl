// Fenêtre voisine — ressource pour test_fenetre_param_builtin_multi.owl.
//
// Vérifie que plusieurs paramètres de Fenêtre builtins (entier + chaîne)
// dans la même déclaration restent acceptés ( : anti-sur-rejet).

FEN_ParamBuiltinMulti est une Fenêtre(n est un entier, s est une chaîne)
	PROPRIETES
		Titre       = "Témoin params builtins multiples"
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN

	PROCEDURE FinInitialisation()
		callback_builtin_multi(n, s)
	FIN
FIN
