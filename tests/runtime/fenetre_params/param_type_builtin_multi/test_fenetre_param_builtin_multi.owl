//  — anti-sur-rejet : plusieurs paramètres builtins de Fenêtre
// (`n est un entier, s est une chaîne`) doivent toujours compiler et
// s'exécuter après l'alignement de la validation de type.

TestModeHeadless(Vrai)

nVu est un entier = 0
sVu est une chaîne = ""

PROCEDURE callback_builtin_multi(n est un entier, s est une chaîne)
	nVu = n
	sVu = s
FIN

Ouvre(FEN_ParamBuiltinMulti, 7, "abc")

dbgVérifieEgalité(nVu, 7, "param entier toujours accepté et injecté")
dbgVérifieEgalité(sVu, "abc", "param chaîne toujours accepté et injecté")

Ferme(FEN_ParamBuiltinMulti)
dbgBilanTest()
