// Fenêtre voisine — ressource pour test_fenetre_param_manquant.owl.
//
// Vérifie que les params non fournis par Ouvre restent à Null (pas de crash,
// pas de valeur fantôme). Contrat : min(param_count, fournis) injectés,
// le reste reste Null.

FEN_Param_Manquant est une Fenêtre(niveau est un entier, etiquette est une chaîne)
	PROPRIETES
		Titre       = "Témoin params manquants"
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN

	PROCEDURE FinInitialisation()
		bNiveauNul est un booléen = (niveau = Null)
		bEtiquetteNulle est un booléen = (etiquette = Null)
		callback_manquants(bNiveauNul, bEtiquetteNulle)
	FIN
FIN
