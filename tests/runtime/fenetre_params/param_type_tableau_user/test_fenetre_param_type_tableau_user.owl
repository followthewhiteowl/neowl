//  — un paramètre de Fenêtre `tableau de <TypeUtilisateur>` doit
// toujours compiler et s'exécuter après l'alignement de la validation du type
// d'élément (le type d'élément inconnu est rejeté ; le type déclaré reste lié).

TestModeHeadless(Vrai)

tabLignes est un tableau de r1160WLigne
l1 est un r1160WLigne
l1.quantite = 3
Ajoute(tabLignes, l1)
l2 est un r1160WLigne
l2.quantite = 4
Ajoute(tabLignes, l2)

nSommeVue est un entier = 0

PROCEDURE callback_tableau_user(nSomme est un entier)
	nSommeVue = nSomme
FIN

Ouvre(FEN_ParamTableauUser, tabLignes)

dbgVérifieEgalité(nSommeVue, 7, "param tableau de type utilisateur accepté, injecté et itéré")

Ferme(FEN_ParamTableauUser)
dbgBilanTest()
