// Fenêtre voisine — ressource pour test_fenetre_param_injection.owl.
//
// Vérifie l'injection des valeurs par Ouvre(FEN_X, val1, val2) avant
// l'exécution du top-level fenêtre.

FEN_Param_Injection est une Fenêtre(niveau est un entier, etiquette est une chaîne)
	PROPRIETES
		Titre       = "Témoin injection params"
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN

	PROCEDURE FinInitialisation()
		// Remonte les valeurs injectées vers le script test via callback voisin
		callback_injection(niveau, etiquette)
	FIN
FIN
