// Ressource Etat pure utilisee par test_etat_parse.owl.
//
// Verifie que le parser accepte la cascade Cadre..Epaisseur /
// Cadre..Couleur dans le bloc PROPRIETES d'un Libelle d'Etat.
// Avant fix : compile-error "= attendu apres nom de prop" (L14590
// compiler.c). Apres fix : compile + execute sans erreur.

ETAT_CadreCascade est un Etat
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	corps est un Corps
		PROPRIETES
			Hauteur = 40
		FIN

		LIB_AvecCadre est un Champ Libellé
			PROPRIETES
				Libellé      = "Bordure rouge 3px (cascade)"
				X            = 20
				Y            = 10
				Largeur      = 100
				Hauteur      = 15
				PoliceNom    = iPoliceLiberationSans
				PoliceTaille = 11
				Cadre..Epaisseur = 3
				Cadre..Couleur = RVB(200, 40, 40)
			FIN
		FIN
	FIN
FIN
