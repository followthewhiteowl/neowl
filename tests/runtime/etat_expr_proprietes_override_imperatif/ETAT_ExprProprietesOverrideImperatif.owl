// Ressource Etat voisine de test_expr_proprietes_override_imperatif.owl.
//
// Garde  : le MÊME contrôle porte à la fois une expression
// PROPRIETES (Libellé = sVal, sVal constant = "ZZZZZ", 5 caractères) ET
// une écriture impérative ..Libellé = par ligne (valeurs "O"/"OO"/"OOO",
// 1+2+3=6 caractères). L'écriture impérative doit toujours primer sur
// l'expression PROPRIETES, ré-évaluée ou non.

ETAT_ExprProprietesOverrideImperatif est un État
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	sVal est une chaîne = "ZZZZZ"

	corps est un Corps
		PROPRIETES
			Hauteur = 10
		FIN

		LIB_X est un Champ Libellé
			PROPRIETES
				Libellé      = sVal
				X            = 20
				Y            = 2
				Largeur      = 100
				Hauteur      = 6
				PoliceNom    = iPoliceLiberationSans
				PoliceTaille = 9
			FIN
		FIN
	FIN

	PROCEDURE Lecture()
		LIB_X..Libellé = "O"
		iImprimeBloc("Corps")
		LIB_X..Libellé = "OO"
		iImprimeBloc("Corps")
		LIB_X..Libellé = "OOO"
	FIN
FIN
