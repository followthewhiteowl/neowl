// Fenêtre voisine — sa taille déclarée est volontairement plus PETITE que la
// taille que sa disposition lui impose : le bouton réclame 420 de haut, la
// fenêtre en déclare 300. À l'écran elle fera donc plus que 300.
//
// C'est le seul cas qui prouve quelque chose : une fenêtre dont la taille
// déclarée est respectée rendrait la même valeur, que la propriété lise le
// fichier de description ou le rendu réel.

FEN_GeoFen est une Fenêtre
	PROPRIETES
		Titre       = "Géométrie réelle d'une fenêtre"
		Largeur     = 400
		Hauteur     = 300
		Disposition = dispVerticale
		Espacement  = 0
		CouleurFond = RVB(5, 5, 5)
	FIN

	BTN_Haut est un Champ Bouton
		PROPRIETES
			Libellé    = "A"
			Hauteur    = 420
			Alignement = alignÉtire
		FIN
	FIN

	PROCEDURE FinInitialisation()
		gFenLargeurFinInit = FEN_GeoFen..Largeur
		gFenHauteurFinInit = FEN_GeoFen..Hauteur
	FIN
FIN
