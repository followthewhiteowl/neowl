// Verrouillage invariant #3 (bilingue FR/EN) : PoliceCharge / FontLoad
// doivent résoudre à la même native et renvoyer la même famille pour le
// même fichier.

sFamilleFR est une chaîne = PoliceCharge("tests/runtime/police_charge_native/police_test_fixture.ttf")
dbgVérifieVrai(ErreurDétectée = Faux, "forme FR : chargement sans erreur")
dbgVérifieVrai(Taille(sFamilleFR) > 0, "forme FR : famille non vide")

sFamilleEN est une chaîne = FontLoad("tests/runtime/police_charge_native/police_test_fixture.ttf")
dbgVérifieVrai(ErreurDétectée = Faux, "forme EN : chargement sans erreur")
dbgVérifieEgalité(sFamilleEN, sFamilleFR, "FontLoad (EN) renvoie la même famille que PoliceCharge (FR) pour le même fichier")

dbgBilanTest()
