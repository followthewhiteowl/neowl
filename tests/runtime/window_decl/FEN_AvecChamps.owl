// Avec sous-champs (chacun a son propre PROPRIETES).

FEN_AvecChamps est une Fenêtre
	PROPRIETES
		Titre       = "Form"
		Disposition = dispLibre
	FIN

	LBL_Nom est un Champ Libellé
		PROPRIETES
			Libellé = "Nom :"
			Largeur = 100
		FIN
	FIN

	SAI_Nom est un Champ Saisie
		PROPRIETES
			Indication = "votre nom"
			Largeur    = 200
		FIN
	FIN

	BTN_OK est un Champ Bouton
		PROPRIETES
			Libellé    = "OK"
			TypeBouton = btnValider
			Largeur    = 100
		FIN
	FIN
FIN
