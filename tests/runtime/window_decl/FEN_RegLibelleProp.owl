// Regression : "Libelle = ..." en propriete de Bouton/Libellé.

FEN_RegLibelleProp est une Fenêtre
	PROPRIETES
		Titre       = ""
		Disposition = dispLibre
	FIN

	BTN_A est un Champ Bouton
		PROPRIETES
			Libellé = "A"
		FIN
	FIN

	LBL_B est un Champ Libellé
		PROPRIETES
			Libellé = "B"
		FIN
	FIN
FIN
