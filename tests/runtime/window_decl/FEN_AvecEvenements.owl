// Avec blocs PROCEDURE predefinis.

FEN_AvecEvenements est une Fenêtre
	PROPRIETES
		Titre       = "Events"
		Disposition = dispLibre
	FIN

	BTN_Action est un Champ Bouton
		PROPRIETES
			Libellé = "Action"
		FIN

		PROCEDURE surClic()
			Trace("clic bouton")
		FIN
	FIN

	SAI_Texte est un Champ Saisie
		PROPRIETES
			Indication = ""
		FIN
		PROCEDURE surAChaqueModification()
		FIN
		PROCEDURE surValidation()
		FIN
	FIN

	PROCEDURE Fermeture()
	FIN

	PROCEDURE AutorisationFermeture()
	FIN
FIN
