// Avec variables propres + capture parametres.

FEN_Complete est une Fenêtre(_loginPreRempli est une chaîne, _mode est un entier)
	PROPRIETES
		Titre       = "Login"
		Disposition = dispLibre
	FIN

	// Préfixe `_` = intentionnellement non utilisé (test de parsing DSL).
	_nbTentatives est un entier
	_sessionToken est une chaîne

	BTN_Login est un Champ Bouton
		PROPRIETES
			Libellé = "Connexion"
		FIN
		PROCEDURE surClic()
		FIN
	FIN
FIN
