// Aliases EN bilingues (keywords structurels + noms de blocs PROCEDURE).

FEN_Anglais est un Window
	PROPRIETES
		Titre       = "EN"
		Disposition = dispLibre
	FIN

	LBL_Greeting est un Champ Label
		PROPRIETES
			Libellé = "Hello"
		FIN

		PROCEDURE onClick()
		FIN
	FIN

	BTN_Go est un Champ Button
		PROPRIETES
			Libellé = "Go"
		FIN

		PROCEDURE onClick()
		FIN
	FIN

	INP_Data est un Champ Input
		PROPRIETES
			Indication = ""
		FIN

		PROCEDURE onEachChange()
		FIN

		PROCEDURE onEntry()
		FIN

		PROCEDURE onExit()
		FIN
	FIN

	PROCEDURE Closing()
	FIN

	PROCEDURE CloseAuthorization()
	FIN

	PROCEDURE RequestRefresh()
	FIN
FIN
