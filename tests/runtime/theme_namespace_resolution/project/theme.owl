// Fichier de thème désigné par Projet..Thème. Bloc `est un Thème` déclarant
// des styles nommés typés en littéral d'instance -- chaque style n'override
// que certains sous-éléments, le reste reste au défaut du template
// (résilience, cf. fixture voisine theme_owl_fichier_styles_nommes).

ThèmeRésolution est un Thème
	boutonPrimaire est un styleBouton = {
		CadreExtérieur = { CouleurFond = Bleu }
	}

	saisieCompacte est un styleSaisie = {
		ZoneSaisie = { RetraitGauche = 2 }
	}
FIN
