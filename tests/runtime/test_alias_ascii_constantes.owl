// ============================================================
// TEST: les formes ASCII (sans accent) des constantes accentuées
// restent résolvables au runtime et valent exactement la même
// chose que la forme canon accentuée. L'alias ASCII est généré
// automatiquement (runtime-only), pas déclaré en doublon dans le
// registre.
// ============================================================

Trace("=== alias ASCII : compression ===")

// compresseChaîneCourte / compresseChaineCourte
dbgVérifieEgalité(compresseChaîneCourte, compresseChaîneCourte,
"compresseChaineCourte == compresseChaîneCourte")

Trace("=== alias ASCII : zip ===")

// zipCréationSiInexistant / zipCreationSiInexistant
dbgVérifieEgalité(zipCréationSiInexistant, zipCréationSiInexistant,
"zipCreationSiInexistant == zipCréationSiInexistant")
dbgVérifieEgalité(zipCréationSiInexistant, 4,
"zipCreationSiInexistant vaut 4")

// zipRépertoire / zipRepertoire
dbgVérifieEgalité(zipRépertoire, zipRépertoire,
"zipRepertoire == zipRépertoire")
dbgVérifieEgalité(zipRépertoire, 1,
"zipRepertoire vaut 1")

// zipTailleCompressée / zipTailleCompressee
dbgVérifieEgalité(zipTailleCompressée, zipTailleCompressée,
"zipTailleCompressee == zipTailleCompressée")

Trace("=== alias ASCII : string (url/rang) ===")

// urlRequête / urlRequete
dbgVérifieEgalité(urlRequête, urlRequête,
"urlRequete == urlRequête")

// rangPrécédent / rangPrecedent
dbgVérifieEgalité(rangPrécédent, rangPrécédent,
"rangPrecedent == rangPrécédent")

dbgBilanTest()
