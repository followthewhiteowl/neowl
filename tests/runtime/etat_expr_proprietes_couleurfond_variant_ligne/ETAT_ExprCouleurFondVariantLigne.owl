// Ressource Etat voisine de test_expr_couleurfond_variant_ligne.owl.
//
// CouleurFond (prop NON-textuelle) est une EXPRESSION dans PROPRIETES
// (CouleurFond = cVal), pas une affectation impérative. cVal change entre
// chaque rendu du bloc Corps (2 rendus manuels via iImprimeBloc + le
// rendu automatique final) : Rouge, Vert, Bleu. Chaque ligne doit peindre
// SA couleur, pas la couleur résolue au 1er rendu.

ETAT_ExprCouleurFondVariantLigne est un État
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	cVal est un entier = Rouge

	corps est un Corps
		PROPRIETES
			Hauteur = 15
		FIN

		LIB_X est un Champ Libellé
			PROPRIETES
				Libellé      = "STATIQUE"
				X            = 20
				Y            = 2
				Largeur      = 100
				Hauteur      = 10
				CouleurFond  = cVal
				PoliceNom    = iPoliceLiberationSans
				PoliceTaille = 9
			FIN
		FIN
	FIN

	PROCEDURE Lecture()
		cVal = Rouge
		iImprimeBloc("Corps")
		cVal = Vert
		iImprimeBloc("Corps")
		cVal = Bleu
	FIN
FIN
