// Fenetre voisine pour test_couleur_police_raccourci.owl.
//  — PoliceCouleur raccourci plat declare doit colorer le texte.
// Meme principe que FEN_CouleurPolice.owl mais via raccourci plat.
//
// Couleurs attendues :
//   Libelle   cyan    RVB(0,255,255) = 16776960
//   Bouton    jaune   RVB(255,255,0) = 65535

FEN_PoliceCouleur est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 450
		Hauteur     = 200
		Titre       = "PoliceCouleur raccourci declare"
	FIN

	// Libelle : raccourci PoliceCouleur (FR) = cyan pur.
	LIB_RaccourciCyan est un Champ Libellé
		PROPRIETES
			X             = 10
			Y             = 10
			Largeur       = 420
			Hauteur       = 50
			Libellé       = "Libelle cyan WWWWWWWWWW"
			CouleurFond   = RVB(20, 20, 20)
			PoliceTaille  = 18
			PoliceCouleur = RVB(0, 255, 255)
		FIN
	FIN

	// Bouton : raccourci PoliceCouleur (FR) = jaune pur.
	// Bouton n'expose pas CouleurFond.
	BTN_RaccourciJaune est un Champ Bouton
		PROPRIETES
			X             = 10
			Y             = 80
			Largeur       = 420
			Hauteur       = 60
			Libellé       = "Bouton jaune WWWWWWWWWW"
			PoliceTaille  = 16
			PoliceCouleur = RVB(255, 255, 0)
		FIN
	FIN
FIN
