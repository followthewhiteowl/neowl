// Ressource fenêtre — voisine de test_table_cellule_colonne_hors_plage.owl.
// Mise en forme de cellule (`TABLE_X[ligne][colonne]..Couleur`) sur un
// indice de colonne hors plage : soft-error dédiée, pas un hard-stop ; le
// programme continue et une écriture légitime ultérieure reste fonctionnelle.

FEN_TableCelluleHorsPlage est une Fenêtre
	PROPRIETES
		Titre       = "Mise en forme cellule hors plage"
		Disposition = dispVerticale
		Largeur     = 400
		Hauteur     = 300
	FIN

	TABLE_Synthese est un Champ Table
		PROPRIETES
			Étire = Vrai
		FIN

		COL_Nom est une Colonne
			PROPRIETES
				Libellé = "Nom"
				Type    = colTypeTexte
				Largeur = 100
			FIN
		FIN

		COL_Tresorerie est une Colonne
			PROPRIETES
				Libellé = "Trésorerie"
				Type    = colTypeNumerique
				Largeur = 100
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		TableAjouteLigne(TABLE_Synthese, "Alice", 100)
		TableAjouteLigne(TABLE_Synthese, "Bob",-50)
	FIN

	PROCEDURE EcritCouleurCellule(ligne est un entier, col est un entier)
		TABLE_Synthese[ligne][col]..Couleur = RVB(200, 0, 0)
	FIN

	PROCEDURE LireCouleurCellule(ligne est un entier, col est un entier)
		RENVOYER TABLE_Synthese[ligne][col]..Couleur
	FIN
FIN
