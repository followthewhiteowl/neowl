// Fenêtre voisine — ressource pour test_unification_plat_style_bouton_pixel.owl.
//
// Porte un Champ Bouton nu (sans CouleurFond déclaré) utilisé pour vérifier
// au pixel que le raccourci plat `BTN..CouleurFond` peint réellement le fond
// du QPushButton (via Style..CadreExtérieur..CouleurFond, ).

FEN_UnifStyleBoutonPixel est une Fenêtre
	PROPRIETES
		Titre       = "Unification Style Bouton — pixel"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 120
		CouleurFond = RVB(10, 10, 10)
	FIN

	BTN_UnifPixel est un Champ Bouton
		PROPRIETES
			X       = 20
			Y       = 20
			Largeur = 300
			Hauteur = 60
			Libellé = "Valider"
		FIN
	FIN
FIN
