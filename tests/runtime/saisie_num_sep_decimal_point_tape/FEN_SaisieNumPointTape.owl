// Fenêtre voisine — champ Saisie num configuré décimal "," / milliers "."
// (config type "8716716785454.55" du ticket ) + champ voisin pour
// déclencher un focus-out réel via DonneFocus.

FEN_SaisieNumPointTape est une Fenêtre
	PROPRIETES
		Titre       = "Saisie num - point tapé = décimal"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 160
	FIN

	SAI_Num est un Champ Saisie
		PROPRIETES
			X            = 10
			Y            = 10
			Largeur      = 180
			Hauteur      = 24
			TypeSaisie   = typSaisieNum
			FormatNombre = {SéparateurMilliers = ".", SéparateurDécimal = ",", ChiffresAprèsVirgule = 4}
			Valeur       = ""
		FIN
	FIN

	SAI_Autre est un Champ Saisie
		PROPRIETES
			X       = 10
			Y       = 50
			Largeur = 180
			Hauteur = 24
			Valeur  = ""
		FIN
	FIN
FIN
