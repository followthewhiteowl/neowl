dbgVérifieEgalité(MonAppFormatMonetaireLectureEn..FormatMonétaire..SéparateurMilliers, " ", "CurrencyFormat (EN, littéral inline props EN) lu via ..FormatMonétaire..SéparateurMilliers (FR)")
dbgVérifieEgalité(MonAppFormatMonetaireLectureEn..FormatMonétaire..ChiffresAprèsVirgule, 2, "CurrencyFormat (EN) : ChiffresAprèsVirgule lu en cascade FR")

dbgBilanTest()
