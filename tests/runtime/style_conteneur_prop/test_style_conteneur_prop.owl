//  — critère d'acceptation clé du ticket (Partie A) :
//   « Une fenêtre déclarant un Conteneur avec
//     Style..CadreExtérieur..CouleurFond + Style..CadreExtérieur..Cadre..Épaisseur
//     compile et se lance. »
//
// Ce test verrouille le compile + lancement headless et la prop Style
// exposée sur le Champ Conteneur (type styleConteneur, un seul sous-élément
// CadreExtérieur).
//
// ROUGE attendu : FEN_ConteneurStyle.owl voisin échoue au --check tant que
// styleConteneur + la prop Style sur Conteneur n'existent pas (compile-fail
// en cascade).

TestModeHeadless(Vrai)

Ouvre(FEN_ConteneurStyle)

CNT_Panneau..Style..CadreExtérieur..CouleurFond = Rouge
dbgVérifieEgalité(CNT_Panneau..Style..CadreExtérieur..CouleurFond, Rouge, "Conteneur..Style..CadreExtérieur..CouleurFond round-trip")

CNT_Panneau..Style..CadreExtérieur..Cadre..Epaisseur = 4
dbgVérifieEgalité(CNT_Panneau..Style..CadreExtérieur..Cadre..Epaisseur, 4, "Conteneur..Style..CadreExtérieur..Cadre..Épaisseur round-trip")

CNT_Panneau..Style..CadreExtérieur..RetraitGauche = 8
dbgVérifieEgalité(CNT_Panneau..Style..CadreExtérieur..RetraitGauche, 8, "Conteneur..Style..CadreExtérieur..RetraitGauche round-trip")

dbgVérifieVrai(Vrai, "fenêtre Conteneur stylée compile et se lance sans crash")

Ferme(FEN_ConteneurStyle)

dbgBilanTest()
