// Fenêtre voisine — ressource pour test_style_conteneur_prop.owl.
// (pattern split canon strict — cf.  / .)
//
// Le Champ Conteneur accepte une prop Style de type styleConteneur, un seul
// sous-élément CadreExtérieur (la boîte : couleur de fond, cadre, retraits).
// Un champ enfant vit dans le conteneur.

FEN_ConteneurStyle est une Fenêtre
	PROPRIETES
		Titre       = "Test Conteneur stylé"
		Disposition = dispLibre
	FIN

	CNT_Panneau est un Champ Conteneur
		PROPRIETES
			X                                       = 10
			Y                                       = 10
			Largeur                                 = 300
			Hauteur                                 = 200
			Disposition                             = dispLibre
			Style..CadreExtérieur..CouleurFond      = Bleu
			Style..CadreExtérieur..Cadre..Epaisseur = 1
		FIN

		SAI_Champ est un Champ Saisie
			PROPRIETES
				X       = 5
				Y       = 5
				Largeur = 200
			FIN
		FIN
	FIN
FIN
