// Fenêtre voisine — ressource pour test_format_monetaire_negatif_parentheses.owl.
// Le champ pose un FormatMonétaire inline avec FormatNégatif = fmnParenthèses
// (style comptable) : un montant NÉGATIF doit être affiché entre parenthèses
// (ex. "(1 234,50 €)"), sans signe '-'.

FEN_FormatMonetaireNegatifParentheses est une Fenêtre
	PROPRIETES
		Titre       = "FormatMonétaire négatif parenthèses"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 120
	FIN

	SAI_Montant est un Champ Saisie
		PROPRIETES
			X               = 10
			Y               = 10
			Largeur         = 180
			Hauteur         = 24
			TypeSaisie      = typSaisieMonétaire
			FormatMonétaire = {Symbole = "€", SéparateurMilliers = " ", SéparateurDécimal = ",", ChiffresAprèsVirgule = 2, FormatNégatif = fmnParenthèses}
			Valeur          = ""
		FIN
	FIN
FIN
