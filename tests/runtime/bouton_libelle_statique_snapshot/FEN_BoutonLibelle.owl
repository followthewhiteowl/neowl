// Fenetre voisine pour test_bouton_libelle_statique ( scoping).
// Deux boutons identiques sauf pour le Libelle, afin de verifier
// que la prop Libelle statique est bien appliquee au rendu.
// Si le Libelle est rendu, les captures des deux boutons different.
// "WWWW" est choisi pour garantir une surface de pixels de texte visible.

FEN_BoutonLibelle est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 300
		Hauteur     = 200
		Titre       = "Bouton libelle statique"
	FIN

	BTN_AvecLibelle est un Champ Bouton
		PROPRIETES
			X       = 10
			Y       = 50
			Largeur = 120
			Hauteur = 60
			Libellé = "WWWW"
		FIN
	FIN

	BTN_SansLibelle est un Champ Bouton
		PROPRIETES
			X       = 150
			Y       = 50
			Largeur = 120
			Hauteur = 60
		FIN
	FIN

FIN
