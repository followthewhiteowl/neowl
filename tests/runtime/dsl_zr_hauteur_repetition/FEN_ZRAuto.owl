// Variante sans HauteurRepetition : calcul auto bounding box.

FEN_ZRAuto est une Fenêtre
	PROPRIETES
		Titre       = "ZR sans override hauteur"
		Largeur     = 500
		Hauteur     = 400
		Disposition = dispLibre
	FIN

	ZR_Auto est un Champ ZoneRépétée
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 480
			Hauteur = 380
			Sens    = zrVertical
		FIN

		LIB_Simple est un Champ Libellé
			PROPRIETES
				X       = 5
				Y       = 5
				Largeur = 200
				Libellé = "Auto"
			FIN
		FIN
	FIN
FIN
