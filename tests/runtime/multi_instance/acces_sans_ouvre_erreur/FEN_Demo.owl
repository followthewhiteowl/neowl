FEN_Demo est une Fenêtre
	PROPRIETES
		Titre       = "Demo Modele C"
		Disposition = dispLibre
	FIN

	BTN_OK est un Champ Bouton
		PROPRIETES
			X       = 10
			Y       = 10
			Libellé = "OK"
		FIN
	FIN
FIN
