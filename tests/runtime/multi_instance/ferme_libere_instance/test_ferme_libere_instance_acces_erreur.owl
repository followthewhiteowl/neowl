// Modele C : Ferme libere l'instance, acces apres Ferme = erreur.
// ( -  : un champ vit dans une instance de fenetre montee)
// Pattern : la fenêtre voisine FEN_Demo.owl porte la déclaration.

Ouvre(FEN_Demo)
BTN_OK..Visible = Faux
dbgVérifieVrai(BTN_OK..Visible = Faux, "Visible ecrit avant Ferme")

Ferme(FEN_Demo)

// Apres Ferme : champ inaccessible, erreur attendue.
ErreurRAZ()
z est un booléen = BTN_OK..Visible
dbgVérifieVrai(ErreurDétectée, "acces champ apres Ferme leve erreur runtime")
dbgVérifieVrai(Position(ErreurInfo(), "aucune fenêtre ouverte") > 0 OU Position(ErreurInfo(), "Ferme") > 0, "message erreur explicite apres Ferme")

dbgBilanTest()
