// Fenêtre voisine — ressource pour test_ouvre_fille_non_modal.owl.
// Le top-level du bouton initialise le libellé (effet observable
// pour valider que OuvreFille a bien exécuté le top-level).

FEN_Fille est une Fenêtre
	PROPRIETES
		Titre       = "Fille Non-Modale"
		Disposition = dispLibre
	FIN

	BTN_F est un Champ Bouton
		PROPRIETES
			X       = 10
			Y       = 10
			Libellé = "initial"
		FIN

		BTN_F..Libellé = "fille initialisee"
	FIN
FIN
