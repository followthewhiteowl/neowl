// Modele C : pollution intra-fichier eliminee, 2 Ouvre/Ferme successifs = etat frais.
// ( -  : chaque montage cree instance fraiche, pas de partage global)
// Pattern : la fenêtre voisine FEN_Demo.owl porte la déclaration.

// Premier montage : modifier Visible a Faux.
Ouvre(FEN_Demo)
BTN_OK..Visible = Faux
dbgVérifieVrai(BTN_OK..Visible = Faux, "premiere instance : Visible = Faux")
Ferme(FEN_Demo)

// Deuxieme montage : nouvelle instance fraiche, Visible par defaut = Vrai.
Ouvre(FEN_Demo)
dbgVérifieVrai(BTN_OK..Visible, "deuxieme instance : Visible = Vrai (etat frais, pas de pollution)")
Ferme(FEN_Demo)

dbgBilanTest()
