// Ferme : pile LIFO. La derniere ouverte devient courante apres pop.
// ( - comportement stack window_stack)
// Pattern : la fenêtre voisine FEN_P.owl porte la déclaration.

OuvreFille(FEN_P)
LIB_P..Libellé = "premiere"
dbgVérifieEgalité(LIB_P..Libellé, "premiere", "instance 1 courante")

OuvreFille(FEN_P)
LIB_P..Libellé = "deuxieme"
dbgVérifieEgalité(LIB_P..Libellé, "deuxieme", "instance 2 courante (derniere ouverte)")

Ferme(FEN_P) // pop instance 2
// Apres pop, instance 1 redevient courante
dbgVérifieEgalité(LIB_P..Libellé, "premiere", "apres pop instance 2, instance 1 redevient courante")

Ferme(FEN_P) // pop instance 1

dbgBilanTest()
