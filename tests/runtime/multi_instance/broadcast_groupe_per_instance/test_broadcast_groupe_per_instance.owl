// Groupe broadcast : affecte uniquement l'instance courante (top du stack).
// ( - multi-instance isolation)
// Pattern : la fenêtre voisine FEN_Multi.owl porte la déclaration.

OuvreSoeur(FEN_Multi)
GR_Tous..Visible = Faux
dbgVérifieVrai(BTN_A..Visible = Faux, "instance 1 courante : groupe broadcast applique sur BTN_A")
dbgVérifieVrai(BTN_B..Visible = Faux, "instance 1 courante : groupe broadcast applique sur BTN_B")

OuvreSoeur(FEN_Multi)
// Nouvelle instance : groupe frais, boutons visibles par defaut
dbgVérifieVrai(BTN_A..Visible, "instance 2 courante : groupe frais, BTN_A visible par defaut")
dbgVérifieVrai(BTN_B..Visible, "instance 2 courante : groupe frais, BTN_B visible par defaut")

Ferme(FEN_Multi) // ferme instance 2
Ferme(FEN_Multi) // ferme instance 1

dbgBilanTest()
