// Fenêtre voisine — ressource pour test_broadcast_groupe_per_instance.owl.
// Multi-instance : groupe par instance, isolation entre instances.

FEN_Multi est une Fenêtre
	PROPRIETES
		Titre       = "Multi Groupe"
		Disposition = dispLibre
	FIN

	BTN_A est un Champ Bouton
		PROPRIETES
			X       = 10
			Y       = 10
			Libellé = "A"
		FIN
	FIN

	BTN_B est un Champ Bouton
		PROPRIETES
			X       = 10
			Y       = 50
			Libellé = "B"
		FIN
	FIN

	GR_Tous est un Groupe = [BTN_A, BTN_B]
FIN
