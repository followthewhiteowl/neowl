// Modele C : Ouvre headless puis acces = OK.
// ( -  : un champ vit dans une instance de fenetre montee)
// Pattern : la fenêtre voisine FEN_Demo.owl porte la déclaration.

Ouvre(FEN_Demo)

// Apres Ouvre : acces aux champs doit marcher.
BTN_OK..Visible = Faux
dbgVérifieVrai(BTN_OK..Visible = Faux, "Visible ecrit apres Ouvre")

BTN_OK..Libellé = "Modifie"
dbgVérifieEgalité(BTN_OK..Libellé, "Modifie", "Libelle ecrit/relu apres Ouvre")

Ferme(FEN_Demo)

dbgBilanTest()
