//  — cascade directe `BTN..Style..CadreExtérieur..Dégradé..Type =
// ...` sur un Champ Bouton (hors Thème, affectation runtime).
//
// ROUGE attendu : `Dégradé` inconnu sur CadreExtérieur aujourd'hui (champ
// inexistant sur styleBouton..CadreExtérieur), et/ou les valeurs d'enum
// dégradéLinéaire/dégradéRadial inconnues (livrées par l'implémenteur).
//
// Le RENDU visuel réel du dégradé est HORS SCOPE : ce test verrouille
// uniquement le compile + round-trip headless de la cascade directe.

TestModeHeadless(Vrai)

Ouvre(FEN_StyleBoutonDegradeCascade)

BTN_Zone..Style..CadreExtérieur..Dégradé..Type = dégradéLinéaire
dbgVérifieEgalité(BTN_Zone..Style..CadreExtérieur..Dégradé..Type, dégradéLinéaire, "cascade directe : Dégradé..Type round-trip")

BTN_Zone..Style..CadreExtérieur..Dégradé..Angle = 90
dbgVérifieEgalité(BTN_Zone..Style..CadreExtérieur..Dégradé..Angle, 90, "cascade directe : Dégradé..Angle round-trip")

BTN_Zone..Style..CadreExtérieur..Dégradé..CouleurDébut = RVB(103, 80, 164)
dbgVérifieEgalité(BTN_Zone..Style..CadreExtérieur..Dégradé..CouleurDébut, RVB(103, 80, 164), "cascade directe : Dégradé..CouleurDébut round-trip")

BTN_Zone..Style..CadreExtérieur..Dégradé..CouleurFin = RVB(29, 27, 32)
dbgVérifieEgalité(BTN_Zone..Style..CadreExtérieur..Dégradé..CouleurFin, RVB(29, 27, 32), "cascade directe : Dégradé..CouleurFin round-trip")

dbgVérifieVrai(Vrai, "fenêtre avec cascade Dégradé compile et se lance sans crash")

Ferme(FEN_StyleBoutonDegradeCascade)

dbgBilanTest()
