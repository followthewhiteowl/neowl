// Fenêtre voisine — champ num SANS FormatNombre (ni champ ni projet), et un
// second champ servant de cible de focus pour déclencher un focus-out réel.

FEN_ReformatNumSansFormat est une Fenêtre
	PROPRIETES
		Titre       = "Reformat num sans format (non-régression)"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 160
	FIN

	SAI_Num est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 10
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieNum
			Valeur     = ""
		FIN
	FIN

	SAI_Autre est un Champ Saisie
		PROPRIETES
			X       = 10
			Y       = 50
			Largeur = 180
			Hauteur = 24
			Valeur  = ""
		FIN
	FIN
FIN
