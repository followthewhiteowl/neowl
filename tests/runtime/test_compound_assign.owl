// ============================================
// TEST: Compound assignments *= /= %=
// ============================================
Trace("=== COMPOUND ASSIGN ===")

// --- Entiers ---
n est un entier = 10
n *= 3
dbgVerifieEgalite(n, 30, "10 *= 3 -> 30")

n /= 2
dbgVerifieEgalite(n, 15, "30 /= 2 -> 15")

n %= 4
dbgVerifieEgalite(n, 3, "15 %= 4 -> 3")

// --- Chaînage ---
m est un entier = 100
m *= 2
m /= 5
m %= 7
dbgVerifieEgalite(m, 40 % 7, "Chaine *= /= %= sur 100")

// --- Reels ---
r est un reel = 12.0
r *= 0.5
dbgVerifieEgalite(r, 6.0, "Reel *=")

r /= 3.0
dbgVerifieEgalite(r, 2.0, "Reel /=")

// --- Champ de structure ---
Box est une structure
    valeur est un entier
FIN

b est un Box
b.valeur = 50
b.valeur *= 2
dbgVerifieEgalite(b.valeur, 100, "Field *= 2")

b.valeur /= 4
dbgVerifieEgalite(b.valeur, 25, "Field /= 4")

b.valeur %= 6
dbgVerifieEgalite(b.valeur, 1, "Field %= 6")

dbgBilanTest()
