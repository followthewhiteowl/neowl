//  — Champ Onglet portant un bloc Style COMPLET (cadre extérieur,
// languette active/inactive, états survol, police grasse, coins arrondis) et
// les trois volets d'un cas réel. Le fond ROUGE de la languette active sert de
// règle graduée : la place du texte noir dedans donne l'alignement du libellé.

FEN_OngletAlignStyle est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 560
		Hauteur     = 260
		Titre       = "Alignement du libellé avec un style posé"
	FIN

	ONG_Style est un Champ Onglet
		PROPRIETES
			X       = 0
			Y       = 0
			Largeur = 520
			Hauteur = 200

			LargeurVolets     = largeurÉgale
			AlignementLibellé = alignFin

			Style..CadreExtérieur..CouleurFond      = Blanc
			Style..CadreExtérieur..Cadre..Couleur   = Vert
			Style..CadreExtérieur..Cadre..Epaisseur = 2
			Style..CadreExtérieur..Cadre..Arrondi   = 6

			Style..VoletActif..CouleurFond  = Rouge
			Style..VoletActif..Couleur      = Noir
			Style..VoletActif..Police..Gras = Vrai
			Style..VoletActif..Arrondi      = 5

			Style..VoletInactif..CouleurFond = Bleu
			Style..VoletInactif..Couleur     = Blanc
			Style..VoletInactif..Arrondi     = 5

			Style..VoletActif..Etats[survol]..Couleur       = JauneClair
			Style..VoletInactif..Etats[survol]..CouleurFond = VertClair
		FIN

		VOL_StyleUn est un Volet
			PROPRIETES
				Libellé     = "Ok"
				Disposition = dispLibre
			FIN
		FIN

		VOL_StyleDeux est un Volet
			PROPRIETES
				Libellé     = "Un libellé nettement plus long"
				Disposition = dispLibre
			FIN
		FIN

		VOL_StyleTrois est un Volet
			PROPRIETES
				Libellé     = "Avancé"
				Disposition = dispLibre
			FIN
		FIN
	FIN
FIN
