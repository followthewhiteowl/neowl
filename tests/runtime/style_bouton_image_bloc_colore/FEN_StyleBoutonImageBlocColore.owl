// Fenetre voisine pour test_style_bouton_image_bloc_colore.
// Mode GUI reel (OuvreSoeur depuis le script test).
//
// Le bloc Icone colore `{icones.X, Couleur = ...}` marche deja sur la prop
// top-level BTN..Image (, widget_image_icone_inline_couleur) et sur
// Style..Image..Image SANS couleur (, style_bouton_image_source).
// Ce fichier verifie que le meme bloc colore fonctionne AUSSI sur la feuille
// Style..Image..Image (pas seulement au top-level).
//
// BTN_TopColore  : bloc colore via la prop top-level Image (oracle : marche
//                  deja, sert de reference de convergence pixel).
// BTN_StyleColore : MEME bloc colore via Style..Image..Image (sujet du
//                  ticket ).
// BTN_StyleAutreCouleur : meme icone, feuille Style, mais couleur DIFFERENTE
//                  — sert de contre-preuve que la couleur est bien portee au
//                  rendu (pas juste l'icone brute).
// BTN_StyleRGB   : meme bloc colore, mais via l'alias EN RGB(...) au lieu de
//                  RVB(...) — verifie que RGB est reconnu dans ce contexte.

FEN_StyleBoutonImageBlocColore est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 420
		Hauteur     = 260
		Titre       = "Style bouton image bloc colore"
		CouleurFond = RVB(15, 15, 15)
	FIN

	BTN_TopColore est un Champ Bouton
		PROPRIETES
			X       = 20
			Y       = 20
			Largeur = 96
			Hauteur = 96
			Image   = {icones.add, Couleur = RVB(240, 15, 15)}
		FIN
	FIN

	BTN_StyleColore est un Champ Bouton
		PROPRIETES
			X                   = 130
			Y                   = 20
			Largeur             = 96
			Hauteur             = 96
			Style..Image..Image = {icones.add, Couleur = RVB(240, 15, 15)}
		FIN
	FIN

	BTN_StyleAutreCouleur est un Champ Bouton
		PROPRIETES
			X                   = 240
			Y                   = 20
			Largeur             = 96
			Hauteur             = 96
			Style..Image..Image = {icones.add, Couleur = RVB(15, 15, 240)}
		FIN
	FIN

	BTN_StyleRGB est un Champ Bouton
		PROPRIETES
			X                   = 20
			Y                   = 130
			Largeur             = 96
			Hauteur             = 96
			Style..Image..Image = {icones.add, Couleur = RGB(240, 15, 15)}
		FIN
	FIN

	PROCEDURE CaptureTopColore()
		RENVOYER dCopieImageChamp(BTN_TopColore)
	FIN

	PROCEDURE CaptureStyleColore()
		RENVOYER dCopieImageChamp(BTN_StyleColore)
	FIN

	PROCEDURE CaptureStyleAutreCouleur()
		RENVOYER dCopieImageChamp(BTN_StyleAutreCouleur)
	FIN

	PROCEDURE CaptureStyleRGB()
		RENVOYER dCopieImageChamp(BTN_StyleRGB)
	FIN

FIN
