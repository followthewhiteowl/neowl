// Fenêtre support : deux paires de boutons partageant le même style de thème.
// - Paire BUILD : le Style est posé en PROPRIETES (application à la construction).
// - Paire RUNTIME : le Style est affecté par code (X..Style = theme.X).
// Le test surcharge un sous-élément d'un bouton et vérifie que son jumeau — et
// la source du thème — restent intacts (copie, pas référence partagée).
FEN_CopieStyle est une Fenêtre
	PROPRIETES
		Titre       = "Isolation copie de style"
		Largeur     = 400
		Hauteur     = 320
		Disposition = dispLibre
	FIN

	BTN_BuildA est un Champ Bouton
		PROPRIETES
			X       = 20
			Y       = 20
			Largeur = 300
			Hauteur = 40
			Libellé = "Build A"
			Style   = theme.boutonPrimaire
		FIN
	FIN

	BTN_BuildB est un Champ Bouton
		PROPRIETES
			X       = 20
			Y       = 70
			Largeur = 300
			Hauteur = 40
			Libellé = "Build B"
			Style   = theme.boutonPrimaire
		FIN
	FIN

	BTN_RunA est un Champ Bouton
		PROPRIETES
			X       = 20
			Y       = 120
			Largeur = 300
			Hauteur = 40
			Libellé = "Run A"
		FIN
	FIN

	BTN_RunB est un Champ Bouton
		PROPRIETES
			X       = 20
			Y       = 170
			Largeur = 300
			Hauteur = 40
			Libellé = "Run B"
		FIN
	FIN
FIN
