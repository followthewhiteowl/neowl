// Fenêtre voisine — ressource pour test_table_colonne_extensible.owl.
// (pattern split canon strict — cf.  / .)
//
// Verrouille la prop ColonneExtensible du Champ Table : contient le NOM
// d'une colonne, le backend ancre cette colonne (stretch) au montage.

FEN_TableExtensible est une Fenêtre
	PROPRIETES
		Titre       = "Test colonne extensible"
		Disposition = dispLibre
	FIN

	TAB_Produits est un Champ Table
		PROPRIETES
			X                 = 10
			Y                 = 10
			Largeur           = 550
			Hauteur           = 350
			ColonneExtensible = "COL_Libelle"
		FIN

		COL_Reference est une Colonne
			PROPRIETES
				Libellé = "Référence"
				Type    = colTypeTexte
				Largeur = 150
			FIN
		FIN

		COL_Libelle est une Colonne
			PROPRIETES
				Libellé = "Libellé"
				Type    = colTypeTexte
				Largeur = 200
			FIN
		FIN
	FIN
FIN
