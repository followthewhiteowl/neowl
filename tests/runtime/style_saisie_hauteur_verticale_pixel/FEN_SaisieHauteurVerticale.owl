//  — un Champ Saisie stylé (qui reçoit le conteneur CadreExtérieur via
// l'always-wrap) ne doit pas ballonner en disposition verticale : il garde la
// même hauteur naturelle qu'un Saisie témoin (non enveloppé). SAI_Temoin porte
// un fond ZoneSaisie mais AUCUN CadreExtérieur -> pas de wrapper. SAI_Stylee
// porte un CadreExtérieur -> wrapper matérialisé (le sujet du bug).
FEN_SaisieHauteurVerticale est une Fenêtre
	PROPRIETES
		Titre       = "Saisie stylée : hauteur en dispVerticale"
		Largeur     = 300
		Hauteur     = 400
		Disposition = dispVerticale
		Espacement  = 8
		CouleurFond = RVB(10, 10, 10)
	FIN

	SAI_Temoin est un Champ Saisie
		PROPRIETES
			Hauteur                        = 60
			Style..ZoneSaisie..CouleurFond = RVB(0, 200, 0)
		FIN
	FIN

	SAI_Stylee est un Champ Saisie
		PROPRIETES
			Hauteur                                 = 60
			Style..ZoneSaisie..CouleurFond          = RVB(0, 0, 200)
			Style..CadreExtérieur..Cadre..Couleur   = RVB(0, 128, 255)
			Style..CadreExtérieur..Cadre..Epaisseur = 4
		FIN
	FIN
FIN
