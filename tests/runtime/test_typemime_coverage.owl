Trace("=== Couverture valeurs MIME des constantes typeMime* ===")

// Chaque constante typeMime* est une chaîne portant la valeur MIME canon.
// On verrouille la valeur exacte de chacune (25 constantes).

// --- Formulaires HTTP ---
dbgVérifieEgalité(typeMimeFormulaireMultiPartie, "multipart/form-data", "typeMimeFormulaireMultiPartie = multipart/form-data")
dbgVérifieEgalité(typeMimeFormulaireSimple, "application/x-www-form-urlencoded", "typeMimeFormulaireSimple = application/x-www-form-urlencoded")

// --- Contenus standards ---
dbgVérifieEgalité(typeMimeGIF, "image/gif", "typeMimeGIF = image/gif")
dbgVérifieEgalité(typeMimeHTML, "text/html", "typeMimeHTML = text/html")
dbgVérifieEgalité(typeMimeJPEG, "image/jpeg", "typeMimeJPEG = image/jpeg")
dbgVérifieEgalité(typeMimeJSON, "application/json", "typeMimeJSON = application/json")
dbgVérifieEgalité(typeMimePDF, "application/pdf", "typeMimePDF = application/pdf")
dbgVérifieEgalité(typeMimePNG, "image/png", "typeMimePNG = image/png")
dbgVérifieEgalité(typeMimeSOAP, "application/soap+xml", "typeMimeSOAP = application/soap+xml")
dbgVérifieEgalité(typeMimeTexte, "text/plain", "typeMimeTexte = text/plain")
dbgVérifieEgalité(typeMimeTexteXML, "text/xml", "typeMimeTexteXML = text/xml")
dbgVérifieEgalité(typeMimeXLS, "application/vnd.ms-excel", "typeMimeXLS = application/vnd.ms-excel")
dbgVérifieEgalité(typeMimeXLSX, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "typeMimeXLSX = xlsx mime")
dbgVérifieEgalité(typeMimeZIP, "application/zip", "typeMimeZIP = application/zip")

// --- OpenDocument / Office moderne / vectoriel ---
dbgVérifieEgalité(typeMimeODP, "application/vnd.oasis.opendocument.presentation", "typeMimeODP = odp mime")
dbgVérifieEgalité(typeMimeODS, "application/vnd.oasis.opendocument.spreadsheet", "typeMimeODS = ods mime")
dbgVérifieEgalité(typeMimeODT, "application/vnd.oasis.opendocument.text", "typeMimeODT = odt mime")
dbgVérifieEgalité(typeMimePPTX, "application/vnd.openxmlformats-officedocument.presentationml.presentation", "typeMimePPTX = pptx mime")
dbgVérifieEgalité(typeMimeSVG, "image/svg+xml", "typeMimeSVG = image/svg+xml")
dbgVérifieEgalité(typeMimeTexteRiche, "application/rtf", "typeMimeTexteRiche = application/rtf")
dbgVérifieEgalité(typeMimeTSV, "text/tab-separated-values", "typeMimeTSV = text/tab-separated-values")

// --- Google Apps ---
dbgVérifieEgalité(typeMimeGglAppsScript, "application/vnd.google-apps.script", "typeMimeGglAppsScript = google-apps.script")
dbgVérifieEgalité(typeMimeGglDocs, "application/vnd.google-apps.document", "typeMimeGglDocs = google-apps.document")
dbgVérifieEgalité(typeMimeGglDrawings, "application/vnd.google-apps.drawing", "typeMimeGglDrawings = google-apps.drawing")
dbgVérifieEgalité(typeMimeGglSheets, "application/vnd.google-apps.spreadsheet", "typeMimeGglSheets = google-apps.spreadsheet")
dbgVérifieEgalité(typeMimeGglSlides, "application/vnd.google-apps.presentation", "typeMimeGglSlides = google-apps.presentation")

// --- Usage réel : la constante pose bien la valeur sur ContentType ---
req est un httpRequête
req..ContentType = typeMimePDF
dbgVérifieEgalité(req..ContentType, "application/pdf", "req..ContentType = typeMimePDF roundtrip")

Trace("=== typeMime coverage OK ===")
