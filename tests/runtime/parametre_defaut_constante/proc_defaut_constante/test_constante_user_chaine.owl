//  — une CONSTANT utilisateur chaine, declaree AVANT la PROCEDURE,
// est acceptee comme valeur par defaut d'un parametre chaine.

CONSTANT
	sLibelleDefaut1304b = "normal"
FIN

PROCEDURE FormateOption1304b(sOption est une chaîne = sLibelleDefaut1304b)
	RENVOYER sOption
FIN

sResultat1304b est une chaîne = FormateOption1304b()
dbgVérifieEgalité(sResultat1304b, "normal", `CONSTANT chaine en defaut de parametre : appel sans argument -> "normal"`)
dbgBilanTest()
