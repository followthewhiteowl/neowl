//  — habiller un Champ Bouton ne doit pas changer sa géométrie. Chaque
// bouton stylé a son jumeau NU au même libellé, à la même police et à la même
// taille déclarée (ou sans taille déclarée) : le nu est l'oracle.
FEN_BoutonTailleStylee est une Fenêtre
	PROPRIETES
		Titre       = "Bouton — un style ne change pas la taille"
		Largeur     = 900
		Hauteur     = 400
		Disposition = dispLibre
		CouleurFond = RVB(10, 10, 10)
	FIN

	// --- Sans taille déclarée : la taille vient de la métrique naturelle du
	// champ. Les trois feuilles mesurées doivent rendre la même que le nu.
	BTSPile est un Champ Conteneur
		PROPRIETES
			X           = 20
			Y           = 20
			Largeur     = 850
			Hauteur     = 120
			Disposition = dispHorizontale
		FIN

		BTSNu est un Champ Bouton
			PROPRIETES
				Libellé = "Valider"
			FIN
		FIN

		BTSCouleurLibelle est un Champ Bouton
			PROPRIETES
				Libellé = "Valider"
				Style..Libellé..Couleur = RVB(255, 0, 0)
			FIN
		FIN

		BTSFondLibelle est un Champ Bouton
			PROPRIETES
				Libellé = "Valider"
				Style..Libellé..CouleurFond = RVB(255, 0, 0)
			FIN
		FIN

		BTSFondCadre est un Champ Bouton
			PROPRIETES
				Libellé = "Valider"
				Style..CadreExtérieur..CouleurFond = RVB(255, 0, 0)
			FIN
		FIN
	FIN

	// --- Taille déclarée PLUS GRANDE que la taille naturelle, sous layout : le
	// style ne doit ni la rogner ni la dépasser.
	BTSPileTaille est un Champ Conteneur
		PROPRIETES
			X           = 20
			Y           = 160
			Largeur     = 500
			Hauteur     = 120
			Disposition = dispHorizontale
		FIN

		BTSGrandNu est un Champ Bouton
			PROPRIETES
				Libellé = "Valider"
				Largeur = 150
				Hauteur = 50
			FIN
		FIN

		BTSGrandStyle est un Champ Bouton
			PROPRIETES
				Libellé = "Valider"
				Largeur = 150
				Hauteur = 50
				Style..Libellé..Couleur = RVB(255, 0, 0)
			FIN
		FIN
	FIN

	// --- En placement libre, taille déclarée PLUS PETITE que la taille
	// naturelle : une taille demandée reste due, même en dessous du naturel.
	BTSPetitNu est un Champ Bouton
		PROPRIETES
			X       = 560
			Y       = 160
			Largeur = 60
			Hauteur = 18
			Libellé = "Valider"
		FIN
	FIN

	BTSPetitStyle est un Champ Bouton
		PROPRIETES
			X       = 660
			Y       = 160
			Largeur = 60
			Hauteur = 18
			Libellé = "Valider"
			Style..Libellé..Couleur = RVB(255, 0, 0)
		FIN
	FIN

	// --- En placement libre sans taille déclarée : le champ occupe la taille
	// par défaut du modèle, stylé comme nu.
	BTSLibreNu est un Champ Bouton
		PROPRIETES
			X       = 560
			Y       = 220
			Libellé = "Valider"
		FIN
	FIN

	BTSLibreStyle est un Champ Bouton
		PROPRIETES
			X       = 700
			Y       = 220
			Libellé = "Valider"
			Style..Libellé..Couleur = RVB(255, 0, 0)
		FIN
	FIN
FIN
