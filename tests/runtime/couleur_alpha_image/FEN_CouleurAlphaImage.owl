//  (LOT 4) — opacité sur `Style..CadreExtérieur..CouleurFond` d'un
// Champ Image. Le Champ Image est un widget mono-élément (QLabel) : le fond
// posé par CadreExtérieur peint directement le widget lui-même (patron
//  Libellé/Bouton), sans wrapper conteneur séparé.
//
// Fond de fenêtre ROUGE PUR opaque (RVB(255,0,0)) : aucun autre widget ne
// recouvre le Champ Image, le fond de fenêtre est donc le backdrop de
// mélange direct.
FEN_CouleurAlphaImage est une Fenêtre
	PROPRIETES
		Titre       = "Alpha Image — CadreExtérieur"
		Largeur     = 460
		Hauteur     = 200
		Disposition = dispLibre
		CouleurFond = RVB(255, 0, 0)
	FIN

	IMG_Opaque est un Champ Image
		PROPRIETES
			X                                  = 20
			Y                                  = 20
			Largeur                            = 400
			Hauteur                            = 60
			Style..CadreExtérieur..CouleurFond = RVB(0, 255, 0)
		FIN
	FIN

	IMG_Alpha est un Champ Image
		PROPRIETES
			X                                  = 20
			Y                                  = 100
			Largeur                            = 400
			Hauteur                            = 60
			Style..CadreExtérieur..CouleurFond = {Rouge = 0, Vert = 255, Bleu = 0, Opacité = 128}
		FIN
	FIN
FIN
