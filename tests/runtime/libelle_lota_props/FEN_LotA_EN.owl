// Lot A EN — forme EN canon.

FEN_LotA_EN est un Window
	PROPRIETES
		Title       = "Lot A EN"
		Width       = 600
		Height      = 400
		Disposition = dispLibre
	FIN

	LIB_FullEN est un Champ Label
		PROPRIETES
			X              = 20
			Y              = 30
			Width          = 400
			Height         = 30
			Caption        = "Full Lot A in EN"
			DisplayEnabled = Vrai
			Altitude       = 1
			MouseCursor    = curSablier
			Ellipsis       = ellipseChemin
			MinHeight      = 20
			MaxHeight      = 60
			MinWidth       = 100
			MaxWidth       = 600
			StatusTip      = "Status bar text"
			TextDirection  = sensDroiteGauche
		FIN
	FIN
FIN
