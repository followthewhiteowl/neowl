// Fenêtre voisine — ressource pour test_window_props_pure_native.owl.
// DSL : appel a une native PURE evalue a compile-time dans un bloc PROPRIETES.

FEN_TestPure est une Fenêtre
	PROPRIETES
		Titre       = "Test pure-eval"
		Largeur     = 400
		Hauteur     = 200
		Disposition = dispLibre
	FIN

	LBL_RougePur est un Champ Libellé
		PROPRIETES
			Libellé = "Rouge pur"
			Couleur = RVB(255, 0, 0)
		FIN
	FIN

	LBL_BleuMixe est un Champ Libellé
		PROPRIETES
			Libellé     = "Bleu via picker"
			Couleur     = RVB(120, 200, 50)
			CouleurFond = RVB(255, 255, 255)
		FIN
	FIN

	LBL_HTMLConv est un Champ Libellé
		PROPRIETES
			Libellé = "Via HTML"
			Couleur = HTMLVersRVB("#FF8800")
		FIN
	FIN

	LBL_TSL est un Champ Libellé
		PROPRIETES
			Libellé = "Teinte/Sat/Lum"
			Couleur = TSL(120, 50, 50)
		FIN
	FIN
FIN
