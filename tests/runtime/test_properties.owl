// Proprietes — methodes getter/setter explicites (plus de convention arity post-).

cRectangle est une Classe
PRIVÉ
	nLargeur est un entier
	nHauteur est un entier

PUBLIC
	PROCEDURE Constructeur(l est un entier, h est un entier)
		:nLargeur = l
		:nHauteur = h
	FIN

	PROCEDURE Surface() : entier
		RENVOYER :nLargeur * :nHauteur
	FIN

	PROCEDURE Largeur() : entier
		RENVOYER :nLargeur
	FIN

	PROCEDURE DefinirLargeur(Val est un entier)
		:nLargeur = Val
	FIN
FIN

PROCEDURE scenario_proprietes_getter_setter()
	oRect est un cRectangle(10, 5)

	// Getter via method call
	dbgVérifieEgalité(oRect.Surface(), 50, "Property getter Surface = 50")

	// Getter
	dbgVérifieEgalité(oRect.Largeur(), 10, "Property getter Largeur = 10")

	// Setter explicite
	oRect.DefinirLargeur(20)
	dbgVérifieEgalité(oRect.Largeur(), 20, "Largeur apres DefinirLargeur = 20")
	dbgVérifieEgalité(oRect.Surface(), 100, "Surface apres setter = 100")
FIN
