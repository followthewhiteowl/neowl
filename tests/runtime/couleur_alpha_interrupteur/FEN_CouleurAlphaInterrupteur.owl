//  (LOT 3) — opacité sur les couleurs du Champ Interrupteur stylé :
// Coche..Couleur (marque cochée), CadreCoche..CouleurFond (fond de la case),
// TexteOptions..Couleur (texte des options).
//
// Fond de fenêtre ROUGE PUR opaque (RVB(255,0,0)) pour rendre tout mélange
// alpha mesurable au pixel. Aucun CadreExtérieur..CouleurFond posé : le fond
// rouge de la fenêtre reste visible derrière les cases/texte (backdrop du
// mélange).
//
// Options = ["IIIIIIIIII"] (glyphes verticaux pleins, dense, comptage fiable
// — patron  test_style_interrupteur_texte_pixel.owl). Police grande
// et grasse pour le texte.
//
// Chaque Interrupteur ne porte qu'UNE option, cochée via ValeurInitiale=1
// pour exercer la marque cochée (Coche..Couleur, ::indicator:checked).
FEN_CouleurAlphaInterrupteur est une Fenêtre
	PROPRIETES
		Titre       = "Alpha Interrupteur"
		Largeur     = 560
		Hauteur     = 420
		Disposition = dispLibre
		CouleurFond = RVB(255, 0, 0)
	FIN

	// --- CadreCoche..CouleurFond : témoin opaque + alpha ---------------------
	INT_CocheOpaque est un Champ Interrupteur
		PROPRIETES
			X                              = 20
			Y                              = 20
			Largeur                        = 520
			Hauteur                        = 60
			Options                        = ["Choix"]
			Style..CadreCoche..CouleurFond = RVB(0, 255, 0)
		FIN
	FIN

	INT_CocheAlpha est un Champ Interrupteur
		PROPRIETES
			X                              = 20
			Y                              = 90
			Largeur                        = 520
			Hauteur                        = 60
			Options                        = ["Choix"]
			Style..CadreCoche..CouleurFond = {Rouge = 0, Vert = 255, Bleu = 0, Opacité = 128}
		FIN
	FIN

	// --- TexteOptions..Couleur : témoin opaque + alpha ------------------------
	INT_TexteOpaque est un Champ Interrupteur
		PROPRIETES
			X                                   = 20
			Y                                   = 160
			Largeur                             = 520
			Hauteur                             = 60
			Options                             = ["IIIIIIIIII"]
			Style..TexteOptions..Couleur        = RVB(0, 255, 0)
			Style..TexteOptions..Police..Taille = 30
			Style..TexteOptions..Police..Gras   = Vrai
		FIN
	FIN

	INT_TexteAlpha est un Champ Interrupteur
		PROPRIETES
			X                                   = 20
			Y                                   = 230
			Largeur                             = 520
			Hauteur                             = 60
			Options                             = ["IIIIIIIIII"]
			Style..TexteOptions..Couleur        = {Rouge = 0, Vert = 255, Bleu = 0, Opacité = 128}
			Style..TexteOptions..Police..Taille = 30
			Style..TexteOptions..Police..Gras   = Vrai
		FIN
	FIN

	// --- Coche..Couleur (marque cochée) : témoin opaque + alpha ---------------
	INT_MarqueOpaque est un Champ Interrupteur
		PROPRIETES
			X                     = 20
			Y                     = 300
			Largeur               = 520
			Hauteur               = 60
			Options               = ["Choix"]
			ValeurInitiale        = 1
			Style..Coche..Couleur = RVB(0, 255, 0)
		FIN
	FIN

	INT_MarqueAlpha est un Champ Interrupteur
		PROPRIETES
			X                     = 20
			Y                     = 370
			Largeur               = 520
			Hauteur               = 40
			Options               = ["Choix"]
			ValeurInitiale        = 1
			Style..Coche..Couleur = {Rouge = 0, Vert = 255, Bleu = 0, Opacité = 128}
		FIN
	FIN
FIN
