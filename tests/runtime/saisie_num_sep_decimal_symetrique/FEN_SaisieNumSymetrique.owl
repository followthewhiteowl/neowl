// Fenêtre voisine — champ Saisie num configuré décimal "." / milliers ","
// (config symétrique inverse de saisie_num_sep_decimal_point_tape), pour
// vérifier que le remap strict-config fonctionne dans les deux sens.

FEN_SaisieNumSymetrique est une Fenêtre
	PROPRIETES
		Titre       = "Saisie num - config symétrique (décimal '.')"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 160
	FIN

	SAI_Num est un Champ Saisie
		PROPRIETES
			X            = 10
			Y            = 10
			Largeur      = 180
			Hauteur      = 24
			TypeSaisie   = typSaisieNum
			FormatNombre = {SéparateurMilliers = ",", SéparateurDécimal = ".", ChiffresAprèsVirgule = 4}
			Valeur       = ""
		FIN
	FIN

	SAI_Autre est un Champ Saisie
		PROPRIETES
			X       = 10
			Y       = 50
			Largeur = 180
			Hauteur = 24
			Valeur  = ""
		FIN
	FIN
FIN
