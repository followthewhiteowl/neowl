//  — config symétrique : décimal "." / milliers ",". L'utilisateur
// tape "1234,56" (avec une virgule) alors que le décimal configuré est le
// point. Modèle strict config : la virgule tapée DOIT être remappée vers le
// séparateur décimal configuré (".") -> résultat 1234.56, PAS 123456
// (virgule confondue avec un séparateur de milliers).

TestModeHeadless(Faux)

OuvreSoeur(FEN_SaisieNumSymetrique)

TestSimuleSaisie(SAI_Num, "1234,56")
DonneFocus(SAI_Autre)

nLu est un réel = SAI_Num..Valeur
dbgVérifieVrai(Abs(nLu - 1234.56) < 0.0001, "config symétrique (décimal '.') : virgule tapée remappée en décimal configuré, 1234.56 relu")

Ferme(FEN_SaisieNumSymetrique)
dbgBilanTest()
