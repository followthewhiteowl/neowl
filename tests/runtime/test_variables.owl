// ============================================
// TEST: Variables, scoping, affectation
// ============================================
Trace("=== VARIABLES ET SCOPING ===")

// --- Declaration et affectation ---
nA est un entier = 10
dbgVérifieEgalité(nA, 10, "Declaration avec init")

nA = 20
dbgVérifieEgalité(nA, 20, "Reassignation")

// --- Scoping: variable locale dans un bloc SI ---
nGlobal est un entier = 100

SI Vrai ALORS
	nLocal est un entier = 42
	dbgVérifieEgalité(nLocal, 42, "Variable locale visible dans bloc")
	dbgVérifieEgalité(nGlobal, 100, "Globale visible dans bloc")
FIN

// La variable globale reste intacte
dbgVérifieEgalité(nGlobal, 100, "Globale intacte apres bloc")

// --- Scoping dans les boucles ---
nTotal est un entier = 0
POUR i = 1 À 5
	nTotal += i
FIN
dbgVérifieEgalité(nTotal, 15, "Somme 1+2+3+4+5 = 15")

// --- Multiple variables ---
nX est un entier = 1
nY est un entier = 2
nZ est un entier = nX + nY
dbgVérifieEgalité(nZ, 3, "Variable = expression avec autres variables")

// --- Chaine reassignment ---
sTexte est une chaîne = "Bonjour"
sTexte = sTexte + " Monde"
dbgVérifieEgalité(sTexte, "Bonjour Monde", "Concat et reassignation chaine")

// --- Booleen reassignment ---
bFlag est un booléen = Vrai
bFlag = Faux
dbgVérifieEgalité(bFlag, Faux, "Booleen reassignment")
bFlag = PAS bFlag
dbgVérifieEgalité(bFlag, Vrai, "PAS sur booleen")

