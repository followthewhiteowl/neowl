// Interfaces — declaration + implementation simple.
// Le cas multi-interface est dans test_interfaces_multi.owl
// (regle OWL 1 classe = 1 fichier).

iAffichable est une Interface
	PROCEDURE Afficher()
FIN

cProduit est une Classe
	implemente iAffichable
PUBLIC
	sNom est une chaîne
	rPrix est un réel

	PROCEDURE Constructeur(sNom est une chaîne, rPrix est un réel)
		:sNom = sNom
		:rPrix = rPrix
	FIN

	PROCEDURE Afficher()
		Trace(:sNom + " : " + :rPrix)
	FIN
FIN

PROCEDURE scenario_interface_simple()
	oProd est un cProduit("Widget", 9.99)
	oProd.Afficher()
	dbgVérifieEgalité(oProd.sNom, "Widget", "Interface impl: member access")
	dbgVérifieVrai(Vrai, "Interface declaration parsed OK")
FIN
