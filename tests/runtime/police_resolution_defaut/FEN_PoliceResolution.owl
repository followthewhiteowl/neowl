// Fenêtre voisine — ressource pour test_police_resolution_defaut.owl.
//
// Cinq libellés, même texte / taille / géométrie, seule la police diffère :
//   LIB_Def       : aucune police  -> doit hériter du défaut applicatif
//                   (Liberation Sans, embarquée).
//   LIB_LibSans   : "Liberation Sans" explicite (chaîne libre).
//   LIB_Serif     : iPoliceTimesNewRoman -> doit résoudre en Liberation Serif.
//   LIB_Mono      : iPoliceCourierNew    -> doit résoudre en Liberation Mono.
//   LIB_ArialCst  : iPoliceArial         -> doit résoudre en Liberation Sans.
// On capture le rendu réel de chaque widget (dCopieImageChamp) pour comparer.

FEN_PoliceResolution est une Fenêtre
	PROPRIETES
		Titre       = "Résolution police"
		Disposition = dispLibre
		Largeur     = 320
		Hauteur     = 340
	FIN

	LIB_Def est un Champ Libellé
		PROPRIETES
			X              = 10
			Y              = 10
			Largeur        = 300
			Hauteur        = 50
			Libellé        = "Illustration Wmg 0123"
			Police..Taille = 24
		FIN
	FIN

	LIB_LibSans est un Champ Libellé
		PROPRIETES
			X              = 10
			Y              = 70
			Largeur        = 300
			Hauteur        = 50
			Libellé        = "Illustration Wmg 0123"
			Police..Taille = 24
			Police..Nom    = "Liberation Sans"
		FIN
	FIN

	LIB_Serif est un Champ Libellé
		PROPRIETES
			X              = 10
			Y              = 130
			Largeur        = 300
			Hauteur        = 50
			Libellé        = "Illustration Wmg 0123"
			Police..Taille = 24
			Police..Nom    = iPoliceTimesNewRoman
		FIN
	FIN

	LIB_Mono est un Champ Libellé
		PROPRIETES
			X              = 10
			Y              = 190
			Largeur        = 300
			Hauteur        = 50
			Libellé        = "Illustration Wmg 0123"
			Police..Taille = 24
			Police..Nom    = iPoliceCourierNew
		FIN
	FIN

	LIB_ArialCst est un Champ Libellé
		PROPRIETES
			X              = 10
			Y              = 250
			Largeur        = 300
			Hauteur        = 50
			Libellé        = "Illustration Wmg 0123"
			Police..Taille = 24
			Police..Nom    = iPoliceArial
		FIN
	FIN

	PROCEDURE CaptureDef() RENVOYER dCopieImageChamp(LIB_Def) FIN
		PROCEDURE CaptureLibSans() RENVOYER dCopieImageChamp(LIB_LibSans) FIN
			PROCEDURE CaptureSerif() RENVOYER dCopieImageChamp(LIB_Serif) FIN
				PROCEDURE CaptureMono() RENVOYER dCopieImageChamp(LIB_Mono) FIN
					PROCEDURE CaptureArialCst() RENVOYER dCopieImageChamp(LIB_ArialCst) FIN
					FIN
