// Neuf blocs d'options identiques (6 options, aucune hauteur déclarée), qui ne
// diffèrent que par le style posé. La hauteur du bloc est donc entièrement
// déterminée par la hauteur d'une ligne d'option :
//
//     Hauteur = 8 + N x ligne + (N-1) x 2      (marges 4+4, espacement 2)
//
// soit, à 6 options, Hauteur = 18 + 6 x ligne.
//
// Les blocs vont par paires : un style sans cadre d'indicateur, et le même
// style avec un cadre sur la coche. Les deux doivent rendre la même hauteur —
// styler l'indicateur change son apparence, pas la géométrie de la ligne.
FEN_LigneInterrupteur est une Fenêtre
	PROPRIETES
		Titre       = "Hauteur de ligne d'option — Interrupteur"
		Largeur     = 400
		Hauteur     = 2000
		Disposition = dispVerticale
	FIN

	INT_Nu est un Champ Interrupteur
		PROPRIETES
			Options = ["Alpha", "Bravo", "Charlie", "Delta", "Echo", "Foxtrot"]
		FIN
	FIN

	INT_P10 est un Champ Interrupteur
		PROPRIETES
			Options                             = ["Alpha", "Bravo", "Charlie", "Delta", "Echo", "Foxtrot"]
			Style..TexteOptions..Police..Taille = 10
		FIN
	FIN

	INT_P10Cadre est un Champ Interrupteur
		PROPRIETES
			Options                             = ["Alpha", "Bravo", "Charlie", "Delta", "Echo", "Foxtrot"]
			Style..TexteOptions..Police..Taille = 10
			Style..CadreCoche..Cadre..Couleur   = RVB(0, 0, 200)
			Style..CadreCoche..Cadre..Epaisseur = 1
		FIN
	FIN

	INT_P14 est un Champ Interrupteur
		PROPRIETES
			Options                             = ["Alpha", "Bravo", "Charlie", "Delta", "Echo", "Foxtrot"]
			Style..TexteOptions..Police..Taille = 14
		FIN
	FIN

	INT_P14Cadre est un Champ Interrupteur
		PROPRIETES
			Options                             = ["Alpha", "Bravo", "Charlie", "Delta", "Echo", "Foxtrot"]
			Style..TexteOptions..Police..Taille = 14
			Style..CadreCoche..Cadre..Couleur   = RVB(0, 0, 200)
			Style..CadreCoche..Cadre..Epaisseur = 1
		FIN
	FIN

	INT_P18 est un Champ Interrupteur
		PROPRIETES
			Options                             = ["Alpha", "Bravo", "Charlie", "Delta", "Echo", "Foxtrot"]
			Style..TexteOptions..Police..Taille = 18
		FIN
	FIN

	INT_P18Cadre est un Champ Interrupteur
		PROPRIETES
			Options                             = ["Alpha", "Bravo", "Charlie", "Delta", "Echo", "Foxtrot"]
			Style..TexteOptions..Police..Taille = 18
			Style..CadreCoche..Cadre..Couleur   = RVB(0, 0, 200)
			Style..CadreCoche..Cadre..Epaisseur = 1
		FIN
	FIN

	// Paire sans police déclarée : seul le fond de la coche est stylé d'un
	// côté, rien de l'autre. Les deux doivent rester à égalité.
	INT_CoulSeule est un Champ Interrupteur
		PROPRIETES
			Options                      = ["Alpha", "Bravo", "Charlie", "Delta", "Echo", "Foxtrot"]
			Style..TexteOptions..Couleur = RVB(200, 0, 0)
		FIN
	FIN

	INT_CoulCadre est un Champ Interrupteur
		PROPRIETES
			Options                             = ["Alpha", "Bravo", "Charlie", "Delta", "Echo", "Foxtrot"]
			Style..TexteOptions..Couleur        = RVB(200, 0, 0)
			Style..CadreCoche..Cadre..Couleur   = RVB(0, 0, 200)
			Style..CadreCoche..Cadre..Epaisseur = 1
		FIN
	FIN
FIN
