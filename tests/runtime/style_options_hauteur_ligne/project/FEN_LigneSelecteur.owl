// Pendant strict de FEN_LigneInterrupteur pour l'autre famille de blocs
// d'options. Même contenu, même absence de hauteur déclarée, et la puce
// remplace la coche comme indicateur stylé.
FEN_LigneSelecteur est une Fenêtre
	PROPRIETES
		Titre       = "Hauteur de ligne d'option — Sélecteur"
		Largeur     = 400
		Hauteur     = 2000
		Disposition = dispVerticale
	FIN

	SEL_Nu est un Champ Sélecteur
		PROPRIETES
			Options = ["Alpha", "Bravo", "Charlie", "Delta", "Echo", "Foxtrot"]
		FIN
	FIN

	SEL_P10 est un Champ Sélecteur
		PROPRIETES
			Options                             = ["Alpha", "Bravo", "Charlie", "Delta", "Echo", "Foxtrot"]
			Style..TexteOptions..Police..Taille = 10
		FIN
	FIN

	SEL_P10Cadre est un Champ Sélecteur
		PROPRIETES
			Options                             = ["Alpha", "Bravo", "Charlie", "Delta", "Echo", "Foxtrot"]
			Style..TexteOptions..Police..Taille = 10
			Style..CadrePuce..Cadre..Couleur    = RVB(0, 0, 200)
			Style..CadrePuce..Cadre..Epaisseur  = 1
		FIN
	FIN

	SEL_P14 est un Champ Sélecteur
		PROPRIETES
			Options                             = ["Alpha", "Bravo", "Charlie", "Delta", "Echo", "Foxtrot"]
			Style..TexteOptions..Police..Taille = 14
		FIN
	FIN

	SEL_P14Cadre est un Champ Sélecteur
		PROPRIETES
			Options                             = ["Alpha", "Bravo", "Charlie", "Delta", "Echo", "Foxtrot"]
			Style..TexteOptions..Police..Taille = 14
			Style..CadrePuce..Cadre..Couleur    = RVB(0, 0, 200)
			Style..CadrePuce..Cadre..Epaisseur  = 1
		FIN
	FIN

	SEL_P18 est un Champ Sélecteur
		PROPRIETES
			Options                             = ["Alpha", "Bravo", "Charlie", "Delta", "Echo", "Foxtrot"]
			Style..TexteOptions..Police..Taille = 18
		FIN
	FIN

	SEL_P18Cadre est un Champ Sélecteur
		PROPRIETES
			Options                             = ["Alpha", "Bravo", "Charlie", "Delta", "Echo", "Foxtrot"]
			Style..TexteOptions..Police..Taille = 18
			Style..CadrePuce..Cadre..Couleur    = RVB(0, 0, 200)
			Style..CadrePuce..Cadre..Epaisseur  = 1
		FIN
	FIN

	SEL_CoulSeule est un Champ Sélecteur
		PROPRIETES
			Options                      = ["Alpha", "Bravo", "Charlie", "Delta", "Echo", "Foxtrot"]
			Style..TexteOptions..Couleur = RVB(200, 0, 0)
		FIN
	FIN

	SEL_CoulCadre est un Champ Sélecteur
		PROPRIETES
			Options                            = ["Alpha", "Bravo", "Charlie", "Delta", "Echo", "Foxtrot"]
			Style..TexteOptions..Couleur       = RVB(200, 0, 0)
			Style..CadrePuce..Cadre..Couleur   = RVB(0, 0, 200)
			Style..CadrePuce..Cadre..Epaisseur = 1
		FIN
	FIN
FIN
