// Fenêtre voisine pour test_theme_saisie_hauteur (levier retraits en layout).
// Mode GUI réel. Deux Champs Saisie empilés (dispVerticale) : un champ témoin nu
// et un champ portant des retraits verticaux. Dans un layout, la hauteur est
// pilotée par le sizeHint : un retrait vertical doit AGRANDIR la boîte (façon
// padding CSS qui augmente la hauteur totale), pas la rogner. Sans correction,
// le retrait rognait le fond (bande ~22 px) ; après correction, le champ à
// retrait est nettement plus haut que le témoin (bande ~50 px), fond plein.

FEN_SaisiePile est une Fenêtre
	PROPRIETES
		Disposition = dispVerticale
		Largeur     = 240
		Hauteur     = 300
		Titre       = "Saisie pile"
		CouleurFond = RVB(15, 15, 15)
	FIN

	SAI_Bare est un Champ Saisie
		PROPRIETES
			Largeur                             = 160
			Style..ZoneSaisie..CouleurFond      = RVB(50, 50, 200)
			Style..ZoneSaisie..Cadre..Epaisseur = 0
		FIN
	FIN

	SAI_Ret est un Champ Saisie
		PROPRIETES
			Largeur                             = 160
			Style..ZoneSaisie..CouleurFond      = RVB(200, 50, 50)
			Style..ZoneSaisie..Cadre..Epaisseur = 0
			Style..ZoneSaisie..RetraitHaut      = 16
			Style..ZoneSaisie..RetraitBas       = 16
		FIN
	FIN
FIN
