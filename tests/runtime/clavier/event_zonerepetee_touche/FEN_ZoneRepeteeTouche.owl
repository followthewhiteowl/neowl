// Ressource fenêtre — voisin de test_event_zonerepetee_touche.owl.
//  lot B : surToucheAppuyée / surToucheRelâchée sur Champ
// ZoneRépétée.

FEN_ZoneRepeteeTouche est une Fenêtre
	PROPRIETES
		Titre       = "ZoneRepeteeTouche offscreen"
		Largeur     = 400
		Hauteur     = 250
		Disposition = dispLibre
	FIN

	nAppuyeeCount est un entier = 0
	nRelacheeCount est un entier = 0
	nDerniereAppuyee est un entier = -1
	nDerniereRelachee est un entier = -1

	ZR_Cible est un Champ ZoneRépétée
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 380
			Hauteur = 150
			Sens    = zrVertical
		FIN

		LIB_Item est un Champ Libellé
			PROPRIETES
				X       = 5
				Y       = 5
				Largeur = 200
				Libellé = "Item"
			FIN
		FIN

		PROCEDURE surToucheAppuyée(nTouche est un entier)
			nAppuyeeCount += 1
			nDerniereAppuyee = nTouche
		FIN

		PROCEDURE surToucheRelâchée(nTouche est un entier)
			nRelacheeCount += 1
			nDerniereRelachee = nTouche
		FIN
	FIN

	PROCEDURE FinInitialisation()
		r est un entier = ZoneRépétéeAjouteLigne(ZR_Cible)
		DonneFocus(ZR_Cible)
		callback_fen_prete()
	FIN

	PROCEDURE LireCompteurs()
		callback_lit_compteurs(nAppuyeeCount, nRelacheeCount, nDerniereAppuyee, nDerniereRelachee)
	FIN
FIN
