// Ressource fenêtre — voisin de test_event_interrupteur_touche.owl.
//  lot B : surToucheAppuyée / surToucheRelâchée sur Champ
// Interrupteur.

FEN_InterrupteurTouche est une Fenêtre
	PROPRIETES
		Titre       = "InterrupteurTouche offscreen"
		Largeur     = 300
		Hauteur     = 150
		Disposition = dispLibre
	FIN

	nAppuyeeCount est un entier = 0
	nRelacheeCount est un entier = 0
	nDerniereAppuyee est un entier = -1
	nDerniereRelachee est un entier = -1

	INT_Cible est un Champ Interrupteur
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 200
			Options = ["Lecture", "Ecriture"]
		FIN

		PROCEDURE surToucheAppuyée(nTouche est un entier)
			nAppuyeeCount += 1
			nDerniereAppuyee = nTouche
		FIN

		PROCEDURE surToucheRelâchée(nTouche est un entier)
			nRelacheeCount += 1
			nDerniereRelachee = nTouche
		FIN
	FIN

	PROCEDURE FinInitialisation()
		DonneFocus(INT_Cible)
		callback_fen_prete()
	FIN

	PROCEDURE LireCompteurs()
		callback_lit_compteurs(nAppuyeeCount, nRelacheeCount, nDerniereAppuyee, nDerniereRelachee)
	FIN
FIN
