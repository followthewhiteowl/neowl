// Ressource fenêtre — voisin de test_event_liste_touche.owl.
//  lot B : surToucheAppuyée / surToucheRelâchée sur Champ Liste.
// Cas d'usage : piloter une Liste aux flèches.

FEN_ListeTouche est une Fenêtre
	PROPRIETES
		Titre       = "ListeTouche offscreen"
		Largeur     = 400
		Hauteur     = 250
		Disposition = dispLibre
	FIN

	nAppuyeeCount est un entier = 0
	nRelacheeCount est un entier = 0
	nDerniereAppuyee est un entier = -1
	nDerniereRelachee est un entier = -1

	LISTE_Cible est un Champ Liste
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 240
			Hauteur = 120
		FIN

		PROCEDURE surToucheAppuyée(nTouche est un entier)
			nAppuyeeCount += 1
			nDerniereAppuyee = nTouche
		FIN

		PROCEDURE surToucheRelâchée(nTouche est un entier)
			nRelacheeCount += 1
			nDerniereRelachee = nTouche
		FIN
	FIN

	PROCEDURE FinInitialisation()
		DonneFocus(LISTE_Cible)
		callback_fen_prete()
	FIN

	PROCEDURE LireCompteurs()
		callback_lit_compteurs(nAppuyeeCount, nRelacheeCount, nDerniereAppuyee, nDerniereRelachee)
	FIN
FIN
