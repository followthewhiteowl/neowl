//  lot B — Event surToucheAppuyée / surToucheRelâchée sur Liste.
// Cas d'usage : piloter une Liste aux flèches. EnvoieTouche poste un vrai
// QKeyEvent. Interdiction DéclencheÉvénement.
//
// ROUGE ATTENDU (compile) : FAM_KEYBOARD_EVENTS n'est pas encore enregistrée
// pour OWL_CONTROL_LISTE -> check_event_signature rejette les procédures
// clavier dans le bloc LISTE_Cible -> le fichier voisin ne compile pas ->
// `owl test` classe ce fichier CRASH tant que le catalogue n'est pas étendu.

TestModeHeadless(Faux)

bLstTouchePrete est un booléen = Faux
nLstAppCap est un entier = 0
nLstRelCap est un entier = 0
nLstDerniereAppCap est un entier = -1
nLstDerniereRelCap est un entier = -1

PROCEDURE callback_fen_prete()
	bLstTouchePrete = Vrai
FIN

PROCEDURE callback_lit_compteurs(nA est un entier, nR est un entier, nDA est un entier, nDR est un entier)
	nLstAppCap         = nA
	nLstRelCap         = nR
	nLstDerniereAppCap = nDA
	nLstDerniereRelCap = nDR
FIN

OuvreSoeur(FEN_ListeTouche)
dbgVérifieVrai(bLstTouchePrete, "FinInitialisation appelée : Liste focusée dès l'ouverture")

// Touche spéciale (flèche bas).
EnvoieTouche(tkBas)

LireCompteurs()
dbgVérifieEgalité(nLstAppCap, 1, "surToucheAppuyée Liste : 1 tir pour tkBas")
dbgVérifieEgalité(nLstDerniereAppCap, tkBas, "surToucheAppuyée Liste : code = tkBas")
dbgVérifieEgalité(nLstRelCap, 1, "surToucheRelâchée Liste : 1 tir pour tkBas")
dbgVérifieEgalité(nLstDerniereRelCap, tkBas, "surToucheRelâchée Liste : code = tkBas")

// Caractère ASCII.
EnvoieTouche(Asc("A"))

LireCompteurs()
dbgVérifieEgalité(nLstAppCap, 2, "surToucheAppuyée Liste : 2 tirs après le caractère 'A'")
dbgVérifieEgalité(nLstDerniereAppCap, Asc("A"), "surToucheAppuyée Liste : code = Asc('A')")
dbgVérifieEgalité(nLstRelCap, 2, "surToucheRelâchée Liste : 2 tirs après le caractère 'A'")
dbgVérifieEgalité(nLstDerniereRelCap, Asc("A"), "surToucheRelâchée Liste : code = Asc('A')")

Ferme(FEN_ListeTouche)
dbgBilanTest()
