//  lot B — Event surToucheAppuyée / surToucheRelâchée sur Combo.
// EnvoieTouche poste un vrai QKeyEvent. Interdiction DéclencheÉvénement.
//
// ROUGE ATTENDU (compile) : FAM_KEYBOARD_EVENTS n'est pas encore enregistrée
// pour OWL_CONTROL_COMBO -> check_event_signature rejette les procédures
// clavier dans le bloc COMBO_Cible -> le fichier voisin ne compile pas ->
// `owl test` classe ce fichier CRASH tant que le catalogue n'est pas étendu.

TestModeHeadless(Faux)

bCbTouchePrete est un booléen = Faux
nCbAppCap est un entier = 0
nCbRelCap est un entier = 0
nCbDerniereAppCap est un entier = -1
nCbDerniereRelCap est un entier = -1

PROCEDURE callback_fen_prete()
	bCbTouchePrete = Vrai
FIN

PROCEDURE callback_lit_compteurs(nA est un entier, nR est un entier, nDA est un entier, nDR est un entier)
	nCbAppCap         = nA
	nCbRelCap         = nR
	nCbDerniereAppCap = nDA
	nCbDerniereRelCap = nDR
FIN

OuvreSoeur(FEN_ComboTouche)
dbgVérifieVrai(bCbTouchePrete, "FinInitialisation appelée : Combo focusé dès l'ouverture")

// Touche spéciale (flèche bas : ouvre/navigue la liste déroulante).
EnvoieTouche(tkBas)

LireCompteurs()
dbgVérifieEgalité(nCbAppCap, 1, "surToucheAppuyée Combo : 1 tir pour tkBas")
dbgVérifieEgalité(nCbDerniereAppCap, tkBas, "surToucheAppuyée Combo : code = tkBas")
dbgVérifieEgalité(nCbRelCap, 1, "surToucheRelâchée Combo : 1 tir pour tkBas")
dbgVérifieEgalité(nCbDerniereRelCap, tkBas, "surToucheRelâchée Combo : code = tkBas")

// Caractère ASCII.
EnvoieTouche(Asc("A"))

LireCompteurs()
dbgVérifieEgalité(nCbAppCap, 2, "surToucheAppuyée Combo : 2 tirs après le caractère 'A'")
dbgVérifieEgalité(nCbDerniereAppCap, Asc("A"), "surToucheAppuyée Combo : code = Asc('A')")
dbgVérifieEgalité(nCbRelCap, 2, "surToucheRelâchée Combo : 2 tirs après le caractère 'A'")
dbgVérifieEgalité(nCbDerniereRelCap, Asc("A"), "surToucheRelâchée Combo : code = Asc('A')")

Ferme(FEN_ComboTouche)
dbgBilanTest()
