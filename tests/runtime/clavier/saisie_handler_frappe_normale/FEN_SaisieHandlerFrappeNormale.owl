// Ressource fenêtre — voisin de test_saisie_handler_frappe_normale.owl.
//  lot B : non-régression — un Champ Saisie qui déclare
// surToucheAppuyée / surToucheRelâchée doit continuer de recevoir la
// frappe normale dans ..Valeur. Le filtre clavier ne doit PAS avaler les
// caractères au profit du seul handler.

FEN_SaisieHandlerFrappeNormale est une Fenêtre
	PROPRIETES
		Titre       = "SaisieHandlerFrappeNormale offscreen"
		Largeur     = 400
		Hauteur     = 150
		Disposition = dispLibre
	FIN

	nAppuyeeCount est un entier = 0

	SAI_AvecHandler est un Champ Saisie
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 300
		FIN

		PROCEDURE surToucheAppuyée(nTouche est un entier)
			nAppuyeeCount += 1
		FIN
	FIN

	PROCEDURE FinInitialisation()
		callback_fen_prete()
	FIN

	PROCEDURE LireAppuyeeCount()
		callback_lit_appuyee_count(nAppuyeeCount)
	FIN
FIN
