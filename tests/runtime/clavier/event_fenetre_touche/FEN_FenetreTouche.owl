// Ressource fenetre — voisin de test_event_fenetre_touche.owl.
// Fenetre avec surToucheAppuyee / surToucheRelachee au niveau fenetre
// (pas sur un champ) pour tester la reception d'events clavier directement
// sur la fenetre (ex: flèches directionnelles pour Snake).

FEN_FenetreTouche est une Fenêtre
	PROPRIETES
		Titre       = "FenetreTouche offscreen"
		Largeur     = 300
		Hauteur     = 200
		Disposition = dispLibre
	FIN

	nFenAppuyeeCount est un entier = 0
	nFenRelacheeCount est un entier = 0
	nFenDerniereAppuyee est un entier = -1
	nFenDerniereRelachee est un entier = -1

	PROCEDURE surToucheAppuyee(nTouche est un entier)
		nFenAppuyeeCount += 1
		nFenDerniereAppuyee = nTouche
		callback_fen_appuyee(nTouche)
	FIN

	PROCEDURE surToucheRelachee(nTouche est un entier)
		nFenRelacheeCount += 1
		nFenDerniereRelachee = nTouche
		callback_fen_relachee(nTouche)
	FIN

	PROCEDURE FinInitialisation()
		callback_fen_touche_prete()
	FIN

	PROCEDURE LireFenCompteurs()
		callback_lit_fen_compteurs(nFenAppuyeeCount, nFenRelacheeCount, nFenDerniereAppuyee, nFenDerniereRelachee)
	FIN
FIN
