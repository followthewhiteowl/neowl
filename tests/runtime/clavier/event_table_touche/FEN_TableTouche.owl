// Ressource fenêtre — voisin de test_event_table_touche.owl.
//  lot B : surToucheAppuyée / surToucheRelâchée sur Champ Table.
// C'est le cas d'usage support d'origine : gérer tkSuppr sur une ligne
// de Table.

FEN_TableTouche est une Fenêtre
	PROPRIETES
		Titre       = "TableTouche offscreen"
		Largeur     = 500
		Hauteur     = 300
		Disposition = dispLibre
	FIN

	nAppuyeeCount est un entier = 0
	nRelacheeCount est un entier = 0
	nDerniereAppuyee est un entier = -1
	nDerniereRelachee est un entier = -1

	TABLE_Cible est un Champ Table
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 460
			Hauteur = 200
		FIN

		COL_Valeur est une Colonne
			PROPRIETES
				Libellé = "Valeur"
				Type    = colTypeTexte
				Largeur = 200
			FIN
		FIN

		PROCEDURE surToucheAppuyée(nTouche est un entier)
			nAppuyeeCount += 1
			nDerniereAppuyee = nTouche
		FIN

		PROCEDURE surToucheRelâchée(nTouche est un entier)
			nRelacheeCount += 1
			nDerniereRelachee = nTouche
		FIN
	FIN

	PROCEDURE FinInitialisation()
		DonneFocus(TABLE_Cible)
		callback_fen_prete()
	FIN

	PROCEDURE LireCompteurs()
		callback_lit_compteurs(nAppuyeeCount, nRelacheeCount, nDerniereAppuyee, nDerniereRelachee)
	FIN
FIN
