// Ressource fenêtre — voisin de test_event_selecteur_touche.owl.
//  lot B : surToucheAppuyée / surToucheRelâchée sur Champ Sélecteur.

FEN_SelecteurTouche est une Fenêtre
	PROPRIETES
		Titre       = "SelecteurTouche offscreen"
		Largeur     = 300
		Hauteur     = 150
		Disposition = dispLibre
	FIN

	nAppuyeeCount est un entier = 0
	nRelacheeCount est un entier = 0
	nDerniereAppuyee est un entier = -1
	nDerniereRelachee est un entier = -1

	SEL_Cible est un Champ Sélecteur
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 200
			Options = ["Un", "Deux", "Trois"]
		FIN

		PROCEDURE surToucheAppuyée(nTouche est un entier)
			nAppuyeeCount += 1
			nDerniereAppuyee = nTouche
		FIN

		PROCEDURE surToucheRelâchée(nTouche est un entier)
			nRelacheeCount += 1
			nDerniereRelachee = nTouche
		FIN
	FIN

	PROCEDURE FinInitialisation()
		DonneFocus(SEL_Cible)
		callback_fen_prete()
	FIN

	PROCEDURE LireCompteurs()
		callback_lit_compteurs(nAppuyeeCount, nRelacheeCount, nDerniereAppuyee, nDerniereRelachee)
	FIN
FIN
