//  lot B — Event surToucheAppuyée / surToucheRelâchée sur Sélecteur.
// EnvoieTouche poste un vrai QKeyEvent. Interdiction DéclencheÉvénement.
//
// ROUGE ATTENDU (compile) : FAM_KEYBOARD_EVENTS n'est pas encore enregistrée
// pour OWL_CONTROL_SELECTEUR -> check_event_signature rejette les procédures
// clavier dans le bloc SEL_Cible -> le fichier voisin ne compile pas ->
// `owl test` classe ce fichier CRASH tant que le catalogue n'est pas étendu.

TestModeHeadless(Faux)

bSelTouchePrete est un booléen = Faux
nSelAppCap est un entier = 0
nSelRelCap est un entier = 0
nSelDerniereAppCap est un entier = -1
nSelDerniereRelCap est un entier = -1

PROCEDURE callback_fen_prete()
	bSelTouchePrete = Vrai
FIN

PROCEDURE callback_lit_compteurs(nA est un entier, nR est un entier, nDA est un entier, nDR est un entier)
	nSelAppCap         = nA
	nSelRelCap         = nR
	nSelDerniereAppCap = nDA
	nSelDerniereRelCap = nDR
FIN

OuvreSoeur(FEN_SelecteurTouche)
dbgVérifieVrai(bSelTouchePrete, "FinInitialisation appelée : Sélecteur focusé dès l'ouverture")

// Touche spéciale (flèche bas : changer d'option).
EnvoieTouche(tkBas)

LireCompteurs()
dbgVérifieEgalité(nSelAppCap, 1, "surToucheAppuyée Sélecteur : 1 tir pour tkBas")
dbgVérifieEgalité(nSelDerniereAppCap, tkBas, "surToucheAppuyée Sélecteur : code = tkBas")
dbgVérifieEgalité(nSelRelCap, 1, "surToucheRelâchée Sélecteur : 1 tir pour tkBas")
dbgVérifieEgalité(nSelDerniereRelCap, tkBas, "surToucheRelâchée Sélecteur : code = tkBas")

// Caractère ASCII (Espace : bascule l'option dans le comportement de référence, ici on vérifie le code transmis).
EnvoieTouche(Asc(" "))

LireCompteurs()
dbgVérifieEgalité(nSelAppCap, 2, "surToucheAppuyée Sélecteur : 2 tirs après le caractère espace")
dbgVérifieEgalité(nSelDerniereAppCap, Asc(" "), "surToucheAppuyée Sélecteur : code = Asc(' ')")
dbgVérifieEgalité(nSelRelCap, 2, "surToucheRelâchée Sélecteur : 2 tirs après le caractère espace")
dbgVérifieEgalité(nSelDerniereRelCap, Asc(" "), "surToucheRelâchée Sélecteur : code = Asc(' ')")

Ferme(FEN_SelecteurTouche)
dbgBilanTest()
