// ============================================
// TEST: GC pressure (reproducers for historical segfaults)
//
// Ces tests stressent l'allocateur avec des boucles longues + allocations
// intermediaires non rootees. Avant les fixes:
//   - concat 3+ operandes + Remplace -> segfault ~500 iter
//   - RegexCherche en boucle (out arrT refait) -> stress GC sur ObjString
// ============================================
Trace("=== GC PRESSURE ===")

// --- Bug 1: concat 3+ operandes avec Remplace ---
sortie1 est une chaîne = ""
POUR i = 1 _A_ 1000
	r est une chaîne = "abc X def"
	r       = Remplace(r, "X", "LONG_REPLACEMENT_STRING")
	sortie1 = sortie1 + r + LF
FIN
dbgVérifieVrai(Taille(sortie1) > 1000, "Concat 3-operandes + Remplace x1000 iter")

// --- Bug 2: RegexCherche en boucle (alloue ObjString a chaque match) ---
total est un entier = 0
POUR i = 1 _A_ 5000
	arrT est un tableau de chaînes
	total += RegexCherche("[INFO] Test value42", "[A-Z]+", arrT)
FIN
dbgVérifieEgalité(total, 10000, "RegexCherche x5000 (2 matches chacun: INFO + T)")

// --- Bug 3: RegexCherche multi-matches en boucle ---
total2 est un entier = 0
POUR i = 1 _A_ 2000
	arrT est un tableau de chaînes
	total2 += RegexCherche("a1 b2 c3", "[a-z][0-9]", arrT)
FIN
dbgVérifieEgalité(total2, 6000, "RegexCherche x2000 (3 matches chacun)")
