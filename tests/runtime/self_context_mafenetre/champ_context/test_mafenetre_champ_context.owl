// MaFenetre dans top-level champ : acces fenetre parente
// Semantique : dans un champ, MaFenetre designe la FENETRE PARENTE, pas le champ.
//
// Pattern : la fenetre voisine FEN_Test.owl appelle callback_verifie depuis
// FinInitialisation pour remonter le Titre lu au script test.

TestModeHeadless(Vrai)

valTitre est une chaîne = ""

PROCEDURE callback_verifie(t est une chaîne)
	valTitre = t
FIN

Ouvre(FEN_Test)

dbgVérifieEgalité(valTitre, "Modifie par champ", "MaFenetre dans top-level champ accede fenetre parente")

Ferme(FEN_Test)
dbgBilanTest()
