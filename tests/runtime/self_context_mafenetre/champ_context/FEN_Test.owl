// Fenêtre voisine — ressource pour test_mafenetre_champ_context.owl.
//
// MaFenetre dans top-level CHAMP : doit désigner la FENÊTRE PARENTE (pas le champ).
// Sémantique : dans un champ, MaFenetre = FEN_Test. Valeur du Titre remontée
// au script test via callback_verifie depuis FinInitialisation.

FEN_Test est une Fenêtre
	PROPRIETES
		Titre       = "Titre initial"
		Disposition = dispLibre
		Largeur     = 300
		Hauteur     = 200
	FIN

	// Champ : son top-level manipule la fenêtre parente via MaFenetre
	BTN_X est un Champ Bouton
		PROPRIETES
			X       = 50
			Y       = 50
			Largeur = 150
			Hauteur = 30
			Libellé = "Bouton"
		FIN

		// TOP-LEVEL CHAMP : MaFenetre desigine FEN_Test (la fenetre parente)
		MaFenêtre..Titre = "Modifie par champ"
	FIN

	PROCEDURE FinInitialisation()
		callback_verifie(FEN_Test..Titre)
	FIN
FIN
