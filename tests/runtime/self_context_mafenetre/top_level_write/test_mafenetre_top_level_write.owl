// MaFenetre dans top-level fenetre : ecriture proprietes (read-after-write).
// Apres impl Lot B : headless_store fenetre doit porter Titre + Largeur modifiees.
//
// Pattern : la fenetre voisine FEN_Test.owl appelle callback_verifie depuis
// FinInitialisation pour remonter Titre + Largeur lus au script test.

TestModeHeadless(Vrai)

valTitre est une chaîne = ""
valLargeur est un entier = -1

PROCEDURE callback_verifie(t est une chaîne, l est un entier)
	valTitre   = t
	valLargeur = l
FIN

Ouvre(FEN_Test)

dbgVérifieEgalité(valTitre, "Nouveau titre", "MaFenetre..Titre write dans top-level fenetre")
dbgVérifieEgalité(valLargeur, 450, "MaFenetre..Largeur write dans top-level fenetre")

Ferme(FEN_Test)
dbgBilanTest()
