// Fenêtre voisine — ressource pour test_mafenetre_top_level_write.owl.
//
// MaFenetre dans top-level FENETRE : ecriture proprietes (read-after-write).
// Apres impl Lot B : headless_store fenetre doit porter Titre + Largeur modifiees.

FEN_Test est une Fenêtre
	PROPRIETES
		Titre       = "Titre initial"
		Disposition = dispLibre
		Largeur     = 300
		Hauteur     = 200
	FIN

	// TOP-LEVEL FENETRE : manipulation via MaFenetre..Prop
	// Semantique : "la fenetre se designe elle-meme"
	MaFenêtre..Titre   = "Nouveau titre"
	MaFenêtre..Largeur = 450

	PROCEDURE FinInitialisation()
		callback_verifie(FEN_Test..Titre, FEN_Test..Largeur)
	FIN
FIN
