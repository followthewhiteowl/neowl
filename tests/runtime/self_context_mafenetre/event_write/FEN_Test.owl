// Fenêtre voisine — ressource pour test_mafenetre_event_write.owl.
//
// MaFenetre dans event FENETRE : FinInitialisation modifie Titre via MaFenetre.

FEN_Test est une Fenêtre
	PROPRIETES
		Titre       = "Titre initial"
		Disposition = dispLibre
		Largeur     = 300
		Hauteur     = 200
	FIN

	// Event fenetre : utilisation MaFenetre pour se modifier puis remontee callback.
	PROCEDURE FinInitialisation()
		MaFenêtre..Titre = "Post-init"
		callback_verifie(FEN_Test..Titre)
	FIN
FIN
