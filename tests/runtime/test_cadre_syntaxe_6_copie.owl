// Cadre Phase 3 syntaxe 6 — lecture + copie d'un Cadre depuis un widget.
// Canon de référence exemple 1 derniere ligne.

src est un Cadre
src..Couleur   = BleuFoncé
src..Epaisseur = 3
src..Arrondi   = 5

// Affectation directe : la variable cible recoit la meme instance
// (ref-shared en V1). Suffisant pour l'usage canon (lire un cadre,
// passer a un widget). Une vraie deep-copy viendra V1.5 si besoin.
copie est un Cadre = src

dbgVérifieEgalité(copie..Couleur, BleuFoncé, "Copie Couleur")
dbgVérifieEgalité(copie..Epaisseur, 3, "Copie Epaisseur")
dbgVérifieEgalité(copie..Arrondi, 5, "Copie Arrondi")

dbgBilanTest()
