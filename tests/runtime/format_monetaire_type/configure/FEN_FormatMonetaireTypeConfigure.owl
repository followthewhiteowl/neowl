// Fenêtre voisine — ressource pour test_format_monetaire_type_configure.owl.
// Le champ pose un `FormatMonétaire` inline CONFIGURÉ (symbole "€", séparateur
// de milliers " ", 2 décimales) : force un affichage clairement différent de
// la forme plate par défaut (symbole présent, séparateur de milliers).

FEN_FormatMonetaireTypeConfigure est une Fenêtre
	PROPRIETES
		Titre       = "FormatMonétaire type - configuré"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 120
	FIN

	SAI_Montant est un Champ Saisie
		PROPRIETES
			X               = 10
			Y               = 10
			Largeur         = 180
			Hauteur         = 24
			TypeSaisie      = typSaisieMonétaire
			FormatMonétaire = {Symbole = "€", SéparateurMilliers = " ", ChiffresAprèsVirgule = 2}
			Valeur          = ""
		FIN
	FIN
FIN
