//  — dispVerticale : la Hauteur figée d'un enfant SANS Étire doit
// être respectée (pas de no-op), et les widgets doivent s'empiler en HAUT
// (l'excédent vertical reste vide en bas, aucun widget ne gonfle). Fenêtre
// haute (400) très supérieure à la somme des Hauteurs déclarées (25+30+16
// espacements) pour matérialiser un large excédent à absorber.
//
// LIB_Cible porte un CadreExtérieur coloré (fond + bordure) comme sonde de
// bord : sans le fix, son wrapper gonfle et son fond envahit tout l'espace
// disponible (~237px observés en investigation) au lieu de rester à 25px.
FEN_DispVertHauteurFigee est une Fenêtre
	PROPRIETES
		Titre       = "dispVerticale : Hauteur figée + empilement haut"
		Largeur     = 300
		Hauteur     = 400
		Disposition = dispVerticale
		Espacement  = 8
		CouleurFond = RVB(5, 5, 5)
	FIN

	LIB_Cible est un Champ Libellé
		PROPRIETES
			Largeur                                 = 200
			Hauteur                                 = 25
			Libellé                                 = "Cible"
			Style..CadreExtérieur..CouleurFond      = RVB(0, 200, 0)
			Style..CadreExtérieur..Cadre..Couleur   = RVB(255, 128, 0)
			Style..CadreExtérieur..Cadre..Epaisseur = 3
		FIN
	FIN

	BTN_Bas est un Champ Bouton
		PROPRIETES
			Largeur                                 = 200
			Hauteur                                 = 30
			Libellé                                 = "Bouton"
			Style..CadreExtérieur..CouleurFond      = RVB(0, 0, 200)
			Style..CadreExtérieur..Cadre..Couleur   = RVB(255, 0, 255)
			Style..CadreExtérieur..Cadre..Epaisseur = 3
		FIN
	FIN
FIN
