//  — symétrique horizontal : la Largeur figée d'un enfant SANS
// Étire doit être respectée en dispHorizontale (pas de no-op), et les
// widgets doivent s'empiler à GAUCHE (l'excédent horizontal reste vide à
// droite). Fenêtre large (500) très supérieure à la somme des Largeurs
// déclarées (60+80+8 espacement) pour matérialiser un large excédent.
FEN_DispHorizLargeurFigee est une Fenêtre
	PROPRIETES
		Titre       = "dispHorizontale : Largeur figée + empilement gauche"
		Largeur     = 500
		Hauteur     = 120
		Disposition = dispHorizontale
		Espacement  = 8
		CouleurFond = RVB(5, 5, 5)
	FIN

	LIB_Cible est un Champ Libellé
		PROPRIETES
			Largeur                                 = 60
			Hauteur                                 = 40
			Libellé                                 = "Cible"
			Style..CadreExtérieur..CouleurFond      = RVB(0, 200, 0)
			Style..CadreExtérieur..Cadre..Couleur   = RVB(255, 128, 0)
			Style..CadreExtérieur..Cadre..Epaisseur = 3
		FIN
	FIN

	BTN_Droite est un Champ Bouton
		PROPRIETES
			Largeur                                 = 80
			Hauteur                                 = 40
			Libellé                                 = "Bouton"
			Style..CadreExtérieur..CouleurFond      = RVB(0, 0, 200)
			Style..CadreExtérieur..Cadre..Couleur   = RVB(255, 0, 255)
			Style..CadreExtérieur..Cadre..Epaisseur = 3
		FIN
	FIN
FIN
