//  — Style sans Couleur de texte sur un Champ Bouton : le texte
// suit le thème (garde `> 0` partagée avec Saisie/Libellé, /).
FEN_StyleBoutonCouleurDefaut est une Fenêtre
	PROPRIETES
		Titre       = "Style Bouton — couleur texte par défaut"
		Largeur     = 560
		Hauteur     = 160
		Disposition = dispLibre
	FIN

	BTN_FondSeul est un Champ Bouton
		PROPRIETES
			X                           = 20
			Y                           = 20
			Largeur                     = 500
			Hauteur                     = 50
			Libellé                     = "Valider"
			Style..Libellé..CouleurFond = RVB(200, 220, 240)
		FIN
	FIN

	BTN_CouleurExplicite est un Champ Bouton
		PROPRIETES
			X                           = 20
			Y                           = 90
			Largeur                     = 500
			Hauteur                     = 50
			Libellé                     = "Annuler"
			Style..Libellé..Couleur     = RVB(255, 0, 0)
			Style..Libellé..CouleurFond = RVB(200, 220, 240)
		FIN
	FIN
FIN
