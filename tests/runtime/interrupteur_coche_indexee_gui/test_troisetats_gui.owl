// Mode TroisÉtats par option, lecture + écriture, et écriture de -1 une fois
// le mode actif, avec de VRAIS widgets Qt montés (hors écran, setTristate).
// La propriété par option n'existe pas encore : ce fichier ne compile pas
// aujourd'hui, rouge attendu.

TestModeHeadless(Faux)

OuvreSoeur(FEN_Interrupteur)

// --- Écriture + lecture du mode, indice littéral, widget réel ---
INT_Perms[1]..TroisÉtats = Vrai
dbgVérifieVrai(INT_Perms[1]..TroisÉtats,
"widget réel : mode TroisÉtats écrit puis relu Vrai")

// --- -1 accepté une fois TroisÉtats actif, widget réel ---
INT_Perms[1] = -1
dbgVérifieEgalité(INT_Perms[1],-1,
"widget réel : état indéterminé (-1) accepté et relu quand TroisÉtats est actif")

Ferme(FEN_Interrupteur)

dbgBilanTest()
