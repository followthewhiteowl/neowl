// Équivalence canon INT_X[n] ≡ INT_X[n]..Valeur, et écriture via la forme
// propriété, avec de VRAIS widgets Qt montés (hors écran). La propriété
// ..Valeur par option n'existe pas encore : ce fichier ne compile pas
// aujourd'hui, rouge attendu.

TestModeHeadless(Faux)

OuvreSoeur(FEN_Interrupteur)

INT_Perms..Valeur = 2 // coche uniquement l'option 2 (bit 1), widget réel

// --- Équivalence nu / ..Valeur, indice littéral ---
dbgVérifieEgalité(INT_Perms[2], INT_Perms[2]..Valeur,
"widget réel : option cochée, nu et ..Valeur rendent la même chose")

// --- Écriture via la forme propriété, indice variable ---
i est un entier = 1
INT_Perms[i]..Valeur = 1
dbgVérifieEgalité(INT_Perms[i]..Valeur, 1,
"widget réel : écriture ..Valeur indice variable, coche relue après écriture")

Ferme(FEN_Interrupteur)

dbgBilanTest()
