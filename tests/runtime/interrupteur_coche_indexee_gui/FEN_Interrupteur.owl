// Ressource fenêtre — voisine des test_*.owl de ce dossier, montée avec de
// vrais widgets Qt (hors écran) via OuvreSoeur. Un Interrupteur à 3 options
// en mode 2 états par défaut.

FEN_Interrupteur est une Fenêtre
	PROPRIETES
		Titre       = "Coches indexées (Interrupteur, widget réel)"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 300
	FIN

	INT_Perms est un Champ Interrupteur
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 240
			Options = [{Libellé = "Lecture", SousLibellé = "Voir"},{Libellé = "Écriture", SousLibellé = "Modifier"},{Libellé = "Suppression", SousLibellé = "Effacer"}]
		FIN
	FIN
FIN
