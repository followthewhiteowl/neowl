// Non-régression : les propriétés Libellé / SousLibellé par option restent
// lisibles ET écrivables avec de VRAIS widgets Qt montés, après
// l'introduction de la coche indexée.

TestModeHeadless(Faux)

OuvreSoeur(FEN_Interrupteur)

dbgVérifieEgalité(INT_Perms[1]..Libellé, "Lecture",
"widget réel : Libellé lu, indice littéral")

i est un entier = 3
dbgVérifieEgalité(INT_Perms[i]..SousLibellé, "Effacer",
"widget réel : SousLibellé lu, indice variable")

INT_Perms[2]..Libellé = "Édition"
dbgVérifieEgalité(INT_Perms[2]..Libellé, "Édition",
"widget réel : Libellé écrit puis relu, indice littéral")

dbgVérifieEgalité(INT_Perms..Occurrence, 3,
"widget réel : l'Interrupteur garde ses 3 options")

Ferme(FEN_Interrupteur)

dbgBilanTest()
