// Écriture de la coche d'une option d'Interrupteur via l'indexation NUE,
// avec de VRAIS widgets Qt montés (hors écran). Aujourd'hui l'affectation
// indexée n'est pas branchée : la première ligne plante à l'exécution — même
// raison qu'en headless (l'écriture nue par option n'est pas encore
// implémentée), rouge attendu.

TestModeHeadless(Faux)

OuvreSoeur(FEN_Interrupteur)

// --- Écriture entière, indice littéral, widget réel ---
INT_Perms[1] = 1
dbgVérifieEgalité(INT_Perms[1], 1,
"widget réel : écriture entière indice littéral, coche relue après écriture")

// --- Écriture entière, indice variable, décoche, widget réel ---
k est un entier = 2
INT_Perms[k] = 0
dbgVérifieEgalité(INT_Perms[k], 0,
"widget réel : écriture entière indice variable, coche relue après écriture")

// --- Écriture booléenne, widget réel ---
INT_Perms[1] = Vrai
dbgVérifieEgalité(INT_Perms[1], 1,
"widget réel : écriture Vrai, coche relue à 1")

Ferme(FEN_Interrupteur)

dbgBilanTest()
