//  — `Style..CadreCoche..X` sur un Champ Interrupteur : la boîte de
// la coche (QCheckBox::indicator), stylable en QSS (background/border). Le
// checkmark lui-même (sous-élément Coche) est souvent une image thémée côté
// Qt — cf. FEN_StyleInterrupteurTexte.owl et le test dédié Coche (structurel,
// pas pixel) pour ce sous-élément séparé.
FEN_StyleInterrupteurCadreCoche est une Fenêtre
	PROPRIETES
		Titre       = "Style Interrupteur — élément CadreCoche"
		Largeur     = 400
		Hauteur     = 120
		Disposition = dispLibre
	FIN

	INT_Coche est un Champ Interrupteur
		PROPRIETES
			X                                   = 20
			Y                                   = 20
			Largeur                             = 300
			Hauteur                             = 60
			Options                             = ["Choix"]
			Style..CadreCoche..CouleurFond      = RVB(0, 200, 0)
			Style..CadreCoche..Cadre..Couleur   = RVB(255, 128, 0)
			Style..CadreCoche..Cadre..Epaisseur = 2
		FIN
	FIN
FIN
