//  — `Style..CadreExtérieur..CouleurFond` / `..Cadre..Couleur` sur
// un Champ Interrupteur : le conteneur qui enveloppe les N QCheckBox (wrapper
// générique, réutilise styleCadreExtérieur). Sous-élément STATIQUE (pas
// d'états), peint en permanence, capturable au pixel sans interaction.
FEN_StyleInterrupteurCadreExterieur est une Fenêtre
	PROPRIETES
		Titre       = "Style Interrupteur — élément CadreExtérieur"
		Largeur     = 560
		Hauteur     = 120
		Disposition = dispLibre
		CouleurFond = RVB(10, 10, 10)
	FIN

	INT_Zone est un Champ Interrupteur
		PROPRIETES
			X                                       = 20
			Y                                       = 20
			Largeur                                 = 500
			Hauteur                                 = 60
			Options                                 = ["Choix"]
			Style..CadreExtérieur..CouleurFond      = RVB(200, 200, 0)
			Style..CadreExtérieur..Cadre..Couleur   = RVB(0, 128, 255)
			Style..CadreExtérieur..Cadre..Epaisseur = 5
		FIN
	FIN
FIN
