// Fenêtre voisine — ressource pour test_monchamp_top_level_write.owl.
//
// MonChamp dans top-level CHAMP : ecriture propriete via alias MonChamp.

FEN_Test est une Fenêtre
	PROPRIETES
		Titre       = "Test MonChamp top-level"
		Disposition = dispLibre
		Largeur     = 300
		Hauteur     = 200
	FIN

	// Champ libelle avec top-level qui utilise MonChamp
	LIB_X est un Champ Libellé
		PROPRIETES
			X       = 50
			Y       = 50
			Largeur = 150
			Hauteur = 30
		FIN

		// TOP-LEVEL CHAMP : utilisation MonChamp..Propriete
		// Usage canonique dev : "un champ s'attribue une valeur a lui-meme"
		MonChamp..Libellé = "init"
	FIN

	PROCEDURE FinInitialisation()
		callback_verifie(LIB_X..Libellé)
	FIN
FIN
