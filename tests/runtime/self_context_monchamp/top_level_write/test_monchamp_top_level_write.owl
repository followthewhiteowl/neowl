// MonChamp dans top-level champ : ecriture propriete.
// MonChamp doit etre cable comme alias vers ObjUiControlRef du champ courant.
//
// Pattern : la fenetre voisine FEN_Test.owl appelle callback_verifie depuis
// FinInitialisation pour remonter le Libelle lu au script test.

TestModeHeadless(Vrai)

valLibelle est une chaîne = ""

PROCEDURE callback_verifie(t est une chaîne)
	valLibelle = t
FIN

Ouvre(FEN_Test)

dbgVérifieEgalité(valLibelle, "init", "MonChamp..Libelle dans top-level champ ecrit la propriete")

Ferme(FEN_Test)
dbgBilanTest()
