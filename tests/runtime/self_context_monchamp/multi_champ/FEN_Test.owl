// Fenêtre voisine — ressource pour test_monchamp_multi_champ.owl.
//
// MonChamp dans plusieurs champs : chaque contexte resout vers le bon champ.

FEN_Test est une Fenêtre
	PROPRIETES
		Titre       = "Test MonChamp multi-champ"
		Disposition = dispLibre
		Largeur     = 300
		Hauteur     = 200
	FIN

	// Champ A
	BTN_A est un Champ Bouton
		PROPRIETES
			X       = 50
			Y       = 50
			Largeur = 100
			Hauteur = 30
		FIN

		// TOP-LEVEL CHAMP A : MonChamp resout vers BTN_A
		MonChamp..Libellé = "A"
	FIN

	// Champ B
	BTN_B est un Champ Bouton
		PROPRIETES
			X       = 50
			Y       = 100
			Largeur = 100
			Hauteur = 30
		FIN

		// TOP-LEVEL CHAMP B : MonChamp resout vers BTN_B
		MonChamp..Libellé = "B"
	FIN

	PROCEDURE FinInitialisation()
		callback_verifie(BTN_A..Libellé, BTN_B..Libellé)
	FIN
FIN
