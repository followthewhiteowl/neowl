// MonChamp dans plusieurs champs : chaque contexte resout vers le bon champ.
// MonChamp doit resoudre dynamiquement au contexte de chaque top-level.
//
// Pattern : la fenetre voisine FEN_Test.owl appelle callback_verifie depuis
// FinInitialisation pour remonter les Libelles A + B lus au script test.

TestModeHeadless(Vrai)

valA est une chaîne = ""
valB est une chaîne = ""

PROCEDURE callback_verifie(libA est une chaîne, libB est une chaîne)
	valA = libA
	valB = libB
FIN

Ouvre(FEN_Test)

dbgVérifieEgalité(valA, "A", "MonChamp dans top-level BTN_A ecrit BTN_A..Libelle")
dbgVérifieEgalité(valB, "B", "MonChamp dans top-level BTN_B ecrit BTN_B..Libelle")

Ferme(FEN_Test)
dbgBilanTest()
