Trace("=== OPERATEUR TERNAIRE ===")

// --- Test 1: Ternaire basique avec condition vraie ---
nVal est un entier = Vrai ? 42 SINON 0
dbgVérifieEgalité(nVal, 42, "Vrai ? 42 SINON 0 = 42")

// --- Test 2: Ternaire basique avec condition fausse ---
nVal2 est un entier = Faux ? 42 SINON 99
dbgVérifieEgalité(nVal2, 99, "Faux ? 42 SINON 99 = 99")

// --- Test 3: Condition avec expression ---
nAge est un entier = 25
sCateg est une chaîne = nAge >= 18 ? "majeur" SINON "mineur"
dbgVérifieEgalité(sCateg, "majeur", "25 >= 18 ? majeur SINON mineur = majeur")

// --- Test 4: Condition fausse avec expression ---
nAge2 est un entier = 12
sCateg2 est une chaîne = nAge2 >= 18 ? "majeur" SINON "mineur"
dbgVérifieEgalité(sCateg2, "mineur", "12 >= 18 ? majeur SINON mineur = mineur")

// --- Test 5: Ternaire dans une expression plus large ---
nX est un entier = 10
nResult est un entier = (nX > 5 ? 100 SINON 200) + 50
dbgVérifieEgalité(nResult, 150, "(10>5 ? 100 SINON 200) + 50 = 150")

// --- Test 6: Ternaire avec des chaines ---
sTest est une chaîne = "oui"
sReponse est une chaîne = sTest = "oui" ? "Accepte" SINON "Refuse"
dbgVérifieEgalité(sReponse, "Accepte", "oui = oui ? Accepte SINON Refuse = Accepte")

// --- Test 7: Ternaire dans Trace (expression inline) ---
nNote est un entier = 15
sMention est une chaîne = nNote >= 16 ? "TB" SINON (nNote >= 14 ? "B" SINON (nNote >= 12 ? "AB" SINON "Passable"))
dbgVérifieEgalité(sMention, "B", "Ternaire imbrique: 15 -> B")

// --- Test 8: Ternaire imbrique - branche vraie ---
nNote2 est un entier = 18
sMention2 est une chaîne = nNote2 >= 16 ? "TB" SINON (nNote2 >= 14 ? "B" SINON "AB")
dbgVérifieEgalité(sMention2, "TB", "Ternaire imbrique: 18 -> TB")

// --- Test 9: Ternaire imbrique - branche profonde ---
nNote3 est un entier = 10
sMention3 est une chaîne = nNote3 >= 16 ? "TB" SINON (nNote3 >= 14 ? "B" SINON (nNote3 >= 12 ? "AB" SINON "Passable"))
dbgVérifieEgalité(sMention3, "Passable", "Ternaire imbrique: 10 -> Passable")

// --- Test 10: Ternaire avec 0 comme falsy ---
nZero est un entier = 0
sZero est une chaîne = nZero ? "non-zero" SINON "zero"
dbgVérifieEgalité(sZero, "zero", "0 ? non-zero SINON zero = zero")

// --- Test 11: Ternaire avec entier non-zero comme truthy ---
nUn est un entier = 1
sUn est une chaîne = nUn ? "non-zero" SINON "zero"
dbgVérifieEgalité(sUn, "non-zero", "1 ? non-zero SINON zero = non-zero")

// --- Test 12: Ternaire avec Null comme falsy ---
sResultNull est une chaîne = Null ? "non-null" SINON "null"
dbgVérifieEgalité(sResultNull, "null", "Null ? non-null SINON null = null")

// --- Test 13: Ternaire comme argument de fonction ---
nA est un entier = 5
nB est un entier = 3
nMax est un entier = nA > nB ? nA SINON nB
dbgVérifieEgalité(nMax, 5, "5 > 3 ? 5 SINON 3 = 5")

// --- Test 14: Ternaire avec calcul dans les branches ---
nInput est un entier = 7
nOutput est un entier = nInput > 10 ? nInput * 2 SINON nInput + 100
dbgVérifieEgalité(nOutput, 107, "7 > 10 ? 7*2 SINON 7+100 = 107")
