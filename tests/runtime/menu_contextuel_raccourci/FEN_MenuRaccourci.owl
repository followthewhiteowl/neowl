// Ressource fenetre — voisin de test_menu_contextuel_raccourci.owl.
// Un menu contextuel partage par deux Saisie (raccourci F4) et un menu
// contextuel de fond attache a la fenetre (raccourci F6). Sert a verifier
// que les raccourcis des OptionMenu firent quand le widget a le focus,
// MENU FERME (pas seulement pendant l'affichage du popup).

FEN_MenuRaccourci est une Fenêtre
	PROPRIETES
		Titre          = "Menu contextuel raccourci offscreen"
		Largeur        = 400
		Hauteur        = 200
		Disposition    = dispLibre
		MenuContextuel = MNU_Fond
	FIN

	MNU_Edition est un MenuContextuel
		OPT_Action est une OptionMenu
			PROPRIETES
				Libellé   = "Action"
				Raccourci = "F4"
			FIN
			PROCEDURE surSélection()
				callback_action_champ(MoiMême..Nom)
			FIN
		FIN
	FIN

	MNU_Fond est un MenuContextuel
		OPT_ActionFond est une OptionMenu
			PROPRIETES
				Libellé   = "ActionFond"
				Raccourci = "F6"
			FIN
			PROCEDURE surSélection()
				callback_action_fond()
			FIN
		FIN
	FIN

	ZS_ZoneA est un Champ Saisie
		PROPRIETES
			X              = 20
			Y              = 20
			Largeur        = 150
			MenuContextuel = MNU_Edition
		FIN
	FIN

	ZS_ZoneB est un Champ Saisie
		PROPRIETES
			X              = 200
			Y              = 20
			Largeur        = 150
			MenuContextuel = MNU_Edition
		FIN
	FIN

	PROCEDURE FinInitialisation()
		callback_fen_prete()
	FIN
FIN
