//  — la « répétition » d'un Sélecteur est la prop Options existante
// (pas un sous-élément Style dédié) : 3 options doivent produire 3
// QRadioButton visibles, chacun avec l'indicator stylé via Style..CadrePuce.
// On tranche la hauteur du champ en 3 bandes horizontales (une par option
// attendue) et on vérifie que CHAQUE bande contient la couleur d'indicator
// posée — preuve structurelle que les N options sont bien rendues, pas
// seulement la première.
//
// ROUGE attendu (assertions pixel) : `Style..CadrePuce..CouleurFond` ne
// compile pas encore (le type styleSélecteur n'existe pas). Cf.
// FEN_StyleSelecteurOptionsRendu.owl.
//
// Le radio exclusif (Valeur = sélection unique) existe déjà côté runtime
// Sélecteur (props Valeur/ValeurInitiale documentées, cf. regression
// champ_selecteur_v1) : l'assertion de sélection unique ci-dessous est donc
// VERTE attendue -- ce n'est pas la stylisation en jeu ici, juste la preuve
// que le radio exclusif fonctionnel n'est pas cassé par l'ajout du Style
// (aucune assertion tautologique : elle vérifie un comportement réel via
// affectation + lecture de Valeur).

TestModeHeadless(Faux)

couleurPuce est un entier = RVB(0, 200, 0)

PROCEDURE CompteCouleurZone(img est une Image, x1 est un entier, y1 est un entier, x2 est un entier, y2 est un entier, couleur est un entier)
	n est un entier = 0
	yy est un entier = y1
	TANTQUE yy < y2
		xx est un entier = x1
		TANTQUE xx < x2
			SI dPixelCouleur(img, xx, yy) = couleur ALORS
				n = n + 1
			FIN
			xx = xx + 1
		FIN
		yy = yy + 1
	FIN
	RENVOYER n
FIN

OuvreSoeur(FEN_StyleSelecteurOptionsRendu)

// Radio exclusif : sélectionner l'option 2 doit se relire tel quel (pas de
// dépendance au Style, comportement déjà existant côté Sélecteur).
SEL_Multi..Valeur = 2
dbgVérifieEgalité(SEL_Multi..Valeur, 2, "Sélecteur : sélection unique (option 2) round-trip")

img est une Image = dCopieImageFenêtre(FEN_StyleSelecteurOptionsRendu)
dbgVérifieEgalité(img..Valide, Vrai, "capture valide")

// SEL_Multi occupe [20,20]-[320,170] : 3 bandes de 50px (une par option).
nbBande1 est un entier = CompteCouleurZone(img, 20, 20, 320, 70, couleurPuce)
nbBande2 est un entier = CompteCouleurZone(img, 20, 70, 320, 120, couleurPuce)
nbBande3 est un entier = CompteCouleurZone(img, 20, 120, 320, 170, couleurPuce)

dbgVérifieVrai(nbBande1 > 5, "option 1 (Un) : indicator stylé visible dans sa bande")
dbgVérifieVrai(nbBande2 > 5, "option 2 (Deux) : indicator stylé visible dans sa bande")
dbgVérifieVrai(nbBande3 > 5, "option 3 (Trois) : indicator stylé visible dans sa bande")

Ferme(FEN_StyleSelecteurOptionsRendu)
dbgBilanTest()
