// Fenêtre voisine — ressource pour test_projet_format_duree_precedence.owl.
// Champ Durée avec MasqueAffichage = "HH:MI:SS" posé explicitement, alors que
// le projet voisin déclare FormatDurée = "HH:MI" : le masque du champ doit
// gagner et préserver les secondes.

FEN_ProjetFormatDureePrecedence est une Fenêtre
	PROPRIETES
		Titre       = "Projet FormatDurée précédence champ"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 120
	FIN

	SAI_Duree est un Champ Saisie
		PROPRIETES
			X               = 10
			Y               = 10
			Largeur         = 180
			Hauteur         = 24
			TypeSaisie      = typSaisieDurée
			MasqueAffichage = "HH:MI:SS"
			Valeur          = ""
		FIN
	FIN
FIN
