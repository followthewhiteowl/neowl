// Fenêtre voisine — ressource pour test_projet_sans_formatduree.owl. Champ
// Durée sans MasqueAffichage, sous un projet qui ne pose pas FormatDurée : doit
// suivre le défaut en dur HH:MI:SS (secondes préservées).

FEN_ProjetSansFormatDuree est une Fenêtre
	PROPRIETES
		Titre       = "Projet sans FormatDurée"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 120
	FIN

	SAI_Duree est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 10
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieDurée
			Valeur     = ""
		FIN
	FIN
FIN
