// Fenêtre voisine — ressource pour test_projet_format_duree_pilote.owl.
// Un seul champ Durée, volontairement SANS MasqueAffichage : sert à prouver
// que c'est le FormatDurée du projet voisin (HH:MI) qui pilote le défaut de
// relecture, tronquant les secondes au lieu du défaut HH:MI:SS qui les préserve.

FEN_ProjetFormatDureePilote est une Fenêtre
	PROPRIETES
		Titre       = "Projet FormatDurée pilote"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 120
	FIN

	SAI_Duree est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 10
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieDurée
			Valeur     = ""
		FIN
	FIN
FIN
