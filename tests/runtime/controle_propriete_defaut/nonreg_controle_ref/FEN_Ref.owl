// Fenêtre ressource pour test_nonreg_controle_ref.owl.
// Expose BTN_Ok (Bouton), SAI_Input (Saisie), et des callbacks
// pour observer les interactions simulées.

FEN_Ref est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 300
		Hauteur     = 200
	FIN

	clicCount est un entier = 0

	BTN_Ok est un Champ Bouton
		PROPRIETES
			X = 10
			Y = 10
		FIN
		PROCEDURE surClic()
			clicCount += 1
		FIN
	FIN

	SAI_Input est un Champ Saisie
		PROPRIETES
			X = 10
			Y = 60
		FIN
	FIN

	PROCEDURE LireClicCount()
		callback_clic(clicCount)
	FIN

FIN
