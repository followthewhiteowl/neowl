// Fenêtre ressource pour test_rhs_assign_valeur.owl.
// Expose SAI_Val (Saisie, defaultProperty="Valeur") et
// SAI_Nom (Saisie, defaultProperty="Valeur").

FEN_Saisie est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 300
		Hauteur     = 150
	FIN

	SAI_Val est un Champ Saisie
		PROPRIETES
			X = 10
			Y = 10
		FIN
	FIN

	SAI_Nom est un Champ Saisie
		PROPRIETES
			X = 10
			Y = 50
		FIN
	FIN

FIN
