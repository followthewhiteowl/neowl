//  — Nom nu widget affecté à une variable déjà déclarée (x = SAI).
// ROUGE ATTENDU (feature non impl) : `x = SAI_Source` doit résoudre
// la valeur ..Valeur du champ, pas l'objet contrôle.
//
// Contextes couverts :
//   1. `s = SAI_Source` (variable chaîne pré-déclarée)       → "bonjour"
//   2. `n = SAI_Source` (variable entier pré-déclarée)        → 99 (coerce)
TestModeHeadless(Vrai)

Ouvre(FEN_AffVar)

SAI_Source..Valeur = "bonjour"

// 1. Affectation à variable chaîne pré-déclarée.
sX est une chaîne = ""
sX = SAI_Source
dbgVérifieEgalité(sX, "bonjour", "SAI nom nu affecté à chaîne pré-déclarée : valeur bonjour")

// 2. Affectation à variable entier après changement valeur.
SAI_Source..Valeur = "99"
nX est un entier = 0
nX = SAI_Source
dbgVérifieEgalité(nX, 99, "SAI nom nu affecté à entier pré-déclaré : coerce vers 99")

Ferme(FEN_AffVar)

dbgBilanTest()
