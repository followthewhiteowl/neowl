// Fenêtre ressource pour test_defaultprop_null.owl.
// Expose TABLE_Items (defaultProperty=NULL) et ITR_Option (Interrupteur, NULL).
// Ces widgets n'ont pas de propriété par défaut scalaire.

FEN_NullProp est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 300
	FIN

	TABLE_Items est un Champ Table
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 200
			Hauteur = 100
		FIN
		COL_Nom est une Colonne
		FIN
	FIN

	ITR_Option est un Champ Interrupteur
		PROPRIETES
			X = 10
			Y = 120
		FIN
	FIN

FIN
