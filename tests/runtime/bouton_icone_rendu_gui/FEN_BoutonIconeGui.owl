// Fenetre voisine pour test_bouton_icone_rendu_gui.
// Mode GUI reel (OuvreSoeur depuis le script test).
// Deux boutons : l'un avec Image = icones.add, l'autre nu.
// Procedures de lecture exposees pour que le script test
// puisse capturer les rendus depuis l'exterieur.

FEN_BoutonIconeGui est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 300
		Hauteur     = 180
		Titre       = "Bouton icone rendu GUI"
		CouleurFond = RVB(15, 15, 15)
	FIN

	BTN_GuiAvecIcone est un Champ Bouton
		PROPRIETES
			X       = 20
			Y       = 50
			Largeur = 96
			Hauteur = 96
			Image   = icones.add
		FIN
	FIN

	BTN_GuiSansIcone est un Champ Bouton
		PROPRIETES
			X       = 160
			Y       = 50
			Largeur = 96
			Hauteur = 96
		FIN
	FIN

	PROCEDURE CaptureAvecIcone()
		RENVOYER dCopieImageChamp(BTN_GuiAvecIcone)
	FIN

	PROCEDURE CaptureSansIcone()
		RENVOYER dCopieImageChamp(BTN_GuiSansIcone)
	FIN

FIN
