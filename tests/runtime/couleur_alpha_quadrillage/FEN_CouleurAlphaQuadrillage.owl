//  (LOT GARDE-FOU) — Style..Quadrillage..Couleur (liseré de grille)
// d'un Champ Table, posé en instance Couleur translucide (Opacité<255).
//
// LignesImpaires/LignesPaires forcées à la MÊME couleur BLANC opaque : le
// liseré de grille est fin (1px, mesuré) et chevauche la frontière entre
// deux lignes — sans backdrop uniforme, le mélange dépendrait du pixel
// voisin (impaire/paire), non déterministe. Lignes hautes (HauteurLigne=40)
// pour un diagnostic pixel plus simple.
FEN_CouleurAlphaQuadrillage est une Fenêtre
	PROPRIETES
		Titre       = "Alpha Table — quadrillage"
		Largeur     = 500
		Hauteur     = 460
		Disposition = dispLibre
		CouleurFond = RVB(255, 255, 255)
	FIN

	TAB_QuadOpaque est un Champ Table
		PROPRIETES
			X                                  = 20
			Y                                  = 20
			Largeur                            = 400
			Hauteur                            = 180
			HauteurLigne                       = 40
			Style..CadreExtérieur..CouleurFond = RVB(255, 255, 255)
			Style..LignesImpaires..CouleurFond = RVB(255, 255, 255)
			Style..LignesPaires..CouleurFond   = RVB(255, 255, 255)
			Style..Quadrillage..Couleur        = RVB(0, 255, 0)
		FIN

		COL_QuadOpaque est une Colonne
			PROPRIETES
				Libellé = "Col"
				Type    = colTypeTexte
				Largeur = 380
			FIN
		FIN
	FIN

	TAB_QuadAlpha est un Champ Table
		PROPRIETES
			X                                  = 20
			Y                                  = 240
			Largeur                            = 400
			Hauteur                            = 180
			HauteurLigne                       = 40
			Style..CadreExtérieur..CouleurFond = RVB(255, 255, 255)
			Style..LignesImpaires..CouleurFond = RVB(255, 255, 255)
			Style..LignesPaires..CouleurFond   = RVB(255, 255, 255)
			Style..Quadrillage..Couleur        = {Rouge = 0, Vert = 255, Bleu = 0, Opacité = 128}
		FIN

		COL_QuadAlpha est une Colonne
			PROPRIETES
				Libellé = "Col"
				Type    = colTypeTexte
				Largeur = 380
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		TableAjouteLigne(TAB_QuadOpaque, "Ligne 0")
		TableAjouteLigne(TAB_QuadOpaque, "Ligne 1")
		TableAjouteLigne(TAB_QuadOpaque, "Ligne 2")
		TableAjouteLigne(TAB_QuadOpaque, "Ligne 3")

		TableAjouteLigne(TAB_QuadAlpha, "Ligne 0")
		TableAjouteLigne(TAB_QuadAlpha, "Ligne 1")
		TableAjouteLigne(TAB_QuadAlpha, "Ligne 2")
		TableAjouteLigne(TAB_QuadAlpha, "Ligne 3")
	FIN
FIN
