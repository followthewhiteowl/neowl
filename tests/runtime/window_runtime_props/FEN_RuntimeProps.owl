// Fenêtre voisine — ressource pour test_window_runtime_props.owl.

FEN_RuntimeProps est une Fenêtre
	PROPRIETES
		Titre       = "Runtime"
		Disposition = dispLibre
	FIN

	LBL_Titre est un Champ Libellé
		PROPRIETES
			Libellé = "Bonjour"
			Largeur = 300
		FIN
	FIN

	SAI_Nom est un Champ Saisie
		PROPRIETES
			Indication = "Nom"
			Largeur    = 200
		FIN
	FIN

	BTN_Action est un Champ Bouton
		PROPRIETES
			Libellé = "Go"
		FIN

		PROCEDURE surClic()
			// Lecture explicite
			t1 est une chaîne = SAI_Nom..Valeur
			// Lecture implicite (Valeur par defaut)
			t2 est une chaîne = SAI_Nom
			// Concat coerce ObjUiControl
			msg est une chaîne = "Bonjour " + SAI_Nom + " !"
			// Ecriture chaine
			LBL_Titre..Libellé = msg
			// Ecriture booleen
			BTN_Action..Visible = Faux
			// Ecriture entier
			SAI_Nom..Largeur = 250
			Trace(t1, t2, msg)
		FIN
	FIN
FIN
