//  (LOT 1) — Style..CadreExtérieur..CouleurFond sur un Champ
// Saisie, posé en instance Couleur translucide (Opacité<255).
//
// Fond de fenêtre ROUGE PUR opaque (RVB(255,0,0)) pour rendre tout mélange
// alpha mesurable au pixel.
//
// SAI_Opaque : témoin non-régression, fond VERT PUR (0,255,0) sans Opacité.
// SAI_Alpha  : fond VERT translucide (0,255,0), Opacité=128 — vérifie que le
// mélange source-over avec le fond rouge est bien appliqué.
FEN_CouleurAlphaCadreExtSaisie est une Fenêtre
	PROPRIETES
		Titre       = "Alpha CadreExtérieur — Saisie"
		Largeur     = 360
		Hauteur     = 200
		Disposition = dispLibre
		CouleurFond = RVB(255, 0, 0)
	FIN

	SAI_Opaque est un Champ Saisie
		PROPRIETES
			X                                  = 20
			Y                                  = 20
			Largeur                            = 300
			Hauteur                            = 50
			Style..CadreExtérieur..CouleurFond = RVB(0, 255, 0)
		FIN
	FIN

	SAI_Alpha est un Champ Saisie
		PROPRIETES
			X                                  = 20
			Y                                  = 100
			Largeur                            = 300
			Hauteur                            = 50
			Style..CadreExtérieur..CouleurFond = {Rouge = 0, Vert = 255, Bleu = 0, Opacité = 128}
		FIN
	FIN
FIN
