//  — Champ Image depuis un fichier webp : le rendu doit afficher le
// contenu réel de l'image, pas rester vide (fond visible derrière).
//
// ROUGE attendu avant impl : le centre du champ reste la couleur de fond
// (magenta) posée via Style..CadreExtérieur..CouleurFond — le format webp
// n'est pas rendu par le pipeline widget actuel.
FEN_RenduImageChampWebp est une Fenêtre
	PROPRIETES
		Titre       = "Champ Image — fichier webp"
		Largeur     = 400
		Hauteur     = 160
		Disposition = dispLibre
		CouleurFond = RVB(10, 10, 10)
	FIN

	IMG_Cible est un Champ Image
		PROPRIETES
			X                                  = 20
			Y                                  = 20
			Largeur                            = 150
			Hauteur                            = 100
			Cadrage                            = cadEtire
			Style..CadreExtérieur..CouleurFond = RVB(255, 0, 255)
			Image                              = fRepTemp() + fSep() + "owl_test_2501_champ_image.webp"
		FIN
	FIN
FIN
