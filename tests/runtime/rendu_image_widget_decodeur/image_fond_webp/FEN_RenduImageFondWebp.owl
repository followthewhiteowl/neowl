//  — Image de fond d'un conteneur depuis un fichier webp : le rendu
// doit afficher le contenu réel de l'image, pas rester vide (fond visible
// derrière).
//
// ROUGE attendu avant impl : le centre du conteneur reste la couleur de
// fond (magenta) — le format webp n'est pas rendu par le pipeline widget
// actuel.
FEN_RenduImageFondWebp est une Fenêtre
	PROPRIETES
		Titre       = "Image de fond — fichier webp"
		Largeur     = 400
		Hauteur     = 160
		Disposition = dispLibre
		CouleurFond = RVB(10, 10, 10)
	FIN

	CNT_Cible est un Champ Conteneur
		PROPRIETES
			X                                         = 20
			Y                                         = 20
			Largeur                                   = 150
			Hauteur                                   = 100
			Disposition                               = dispLibre
			Style..CadreExtérieur..CouleurFond        = RVB(255, 0, 255)
			Style..CadreExtérieur..ImageFond..Source  = fRepTemp() + fSep() + "owl_test_2501_image_fond.webp"
			Style..CadreExtérieur..ImageFond..Cadrage = cadEtire
		FIN
	FIN
FIN
