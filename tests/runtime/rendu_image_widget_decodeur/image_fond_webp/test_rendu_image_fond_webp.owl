//  — Image de fond d'un conteneur depuis un fichier webp : oracle =
// capture pixel réelle (offscreen). Le centre du conteneur ne doit plus
// porter la couleur de fond (magenta), signe que l'image webp s'affiche
// vraiment.
//
// ROUGE attendu avant impl : le centre reste magenta (webp non rendu par le
// pipeline widget actuel). Cf. FEN_RenduImageFondWebp.owl.

TestModeHeadless(Faux)

chemin        est une chaîne = fRepTemp() + fSep() + "owl_test_2501_image_fond.webp"
octetsFixture est un buffer  = fChargeBuffer("tests/runtime/webp_decodage/fixture.webp")
fSauveBuffer(chemin, octetsFixture)

OuvreSoeur(FEN_RenduImageFondWebp)

img est une Image = dCopieImageFenêtre(FEN_RenduImageFondWebp)
dbgVérifieEgalité(img..Valide, Vrai, "capture fenêtre valide")

// CNT_Cible [X=20..170,Y=20..120], centre=(95,70)
cCentre est un entier = dPixelCouleur(img, 95, 70)
dbgVérifieVrai(cCentre <> RVB(255, 0, 255), "le centre du conteneur affiche l'image de fond webp, pas la couleur de fond")

Ferme(FEN_RenduImageFondWebp)
fSupprime(chemin)
dbgBilanTest()
