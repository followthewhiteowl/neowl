//  — Image de fond d'un conteneur depuis un fichier png : contrôle
// de non-régression, ce format est déjà rendu par le pipeline widget
// aujourd'hui.
FEN_RenduImageFondPng est une Fenêtre
	PROPRIETES
		Titre       = "Image de fond — fichier png"
		Largeur     = 400
		Hauteur     = 160
		Disposition = dispLibre
		CouleurFond = RVB(10, 10, 10)
	FIN

	CNT_Cible est un Champ Conteneur
		PROPRIETES
			X                                         = 20
			Y                                         = 20
			Largeur                                   = 150
			Hauteur                                   = 100
			Disposition                               = dispLibre
			Style..CadreExtérieur..CouleurFond        = RVB(255, 0, 255)
			Style..CadreExtérieur..ImageFond..Source  = fRepTemp() + fSep() + "owl_test_2501_image_fond.png"
			Style..CadreExtérieur..ImageFond..Cadrage = cadEtire
		FIN
	FIN
FIN
