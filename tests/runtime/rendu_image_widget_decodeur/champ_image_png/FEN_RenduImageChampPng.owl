//  — Champ Image depuis un fichier png : contrôle de non-régression,
// ce format est déjà rendu par le pipeline widget aujourd'hui.
FEN_RenduImageChampPng est une Fenêtre
	PROPRIETES
		Titre       = "Champ Image — fichier png"
		Largeur     = 400
		Hauteur     = 160
		Disposition = dispLibre
		CouleurFond = RVB(10, 10, 10)
	FIN

	IMG_Cible est un Champ Image
		PROPRIETES
			X                                  = 20
			Y                                  = 20
			Largeur                            = 150
			Hauteur                            = 100
			Cadrage                            = cadEtire
			Style..CadreExtérieur..CouleurFond = RVB(255, 0, 255)
			Image                              = fRepTemp() + fSep() + "owl_test_2501_champ_image.png"
		FIN
	FIN
FIN
