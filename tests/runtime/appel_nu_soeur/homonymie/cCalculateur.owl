//  — appel nu methode soeur (homonymie methode vs globale)

cCalculateur est une Classe
	// ObtenirResultat appelle Calcule nu — doit resoudre la methode soeur (prio locale)
	PROCEDURE ObtenirResultat() : entier
		RENVOYER Calcule(4)
	FIN

	// Methode Calcule — masque la globale homonyme du script voisin
	PROCEDURE Calcule(n est un entier) : entier
		RENVOYER n * 100
	FIN
FIN
