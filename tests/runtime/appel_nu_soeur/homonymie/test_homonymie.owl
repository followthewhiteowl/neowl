//  — appel nu methode soeur (homonymie, test voisin)

// Globale Calcule (homonyme de la methode de classe)
PROCEDURE Calcule(n est un entier) : entier
	RENVOYER n * 10
FIN

// Instance de la classe
c est un cCalculateur
resMethode est un entier = c.ObtenirResultat()

// Appel depuis script (top-level) → resout la globale
resGlobale est un entier = Calcule(4)

dbgVérifieEgalité(resMethode, 400, "appel nu dans methode doit resoudre methode soeur (prio locale)")
dbgVérifieEgalité(resGlobale, 40, "appel nu dans script doit resoudre globale")

// Warning compile-time intentionnel (methode homonyme d'une globale) = feature testee.
__dbgAvertissementAttendu("masque une procédure globale", "homonymie methode/globale Calcule — resolution appel-nu (feat/0502)")
dbgBilanTest()
