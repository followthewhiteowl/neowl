//  — appel nu methode soeur (dispatch virtuel, classe mere)

cMere est une Classe
	PROCEDURE Calcule(n est un entier) : entier
		RENVOYER n * 10
	FIN

	// ObtenirResultat appelle Calcule nu — doit dispatcher vers la version instance reelle
	PROCEDURE ObtenirResultat() : entier
		RENVOYER Calcule(5)
	FIN
FIN
