//  — appel nu methode soeur (simple)
//
// Avant  : Demarre() appelle Calcule() nu → erreur compile
// "Calcule : fonction/procedure inconnue ou inaccessible".
// Apres  : OK, resolution sur methode soeur.

cMoteur est une Classe
	// ObtenirResultat appelle Calcule definie PLUS BAS, SANS ':'
	PROCEDURE ObtenirResultat() : entier
		RENVOYER Calcule(2)
	FIN

	// Calcule definie APRES son call-site
	PROCEDURE Calcule(n est un entier) : entier
		RENVOYER n * 10
	FIN
FIN
