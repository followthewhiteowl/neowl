//  — appel nu methode soeur (transitif mixte nu + ':')

cMachine est une Classe
	// A appelle B nu
	PROCEDURE EtapeUne() : entier
		RENVOYER EtapeDeux()
	FIN

	// EtapeDeux appelle EtapeTrois avec ':' explicite (coexistence)
	PROCEDURE EtapeDeux() : entier
		RENVOYER :EtapeTrois() + 1
	FIN

	// EtapeTrois defini APRES (ordre independant)
	PROCEDURE EtapeTrois() : entier
		RENVOYER 10
	FIN
FIN
