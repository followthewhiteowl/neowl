// Fenêtre voisine — ressource pour test_masque_affichage_date.owl (,
// propriété MasqueAffichage/DisplayMask sur le champ Date). Trois champs Date :
// un témoin sans masque (repli JJ/MM/AAAA), un avec masque ISO (AAAA-MM-JJ),
// un avec masque US (MM/JJ/AAAA) pour vérifier que la saisie est bien
// interprétée selon l'ordre de jetons du masque posé (pas un ordre générique
// figé JJ/MM/AAAA).

FEN_MasqueAffichageDate est une Fenêtre
	PROPRIETES
		Titre       = "Masque affichage Date"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 200
	FIN

	SAI_SansMasque est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 10
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieDate
			Valeur     = ""
		FIN
	FIN

	SAI_MasqueISO est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 50
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieDate
			Valeur     = ""
		FIN
	FIN

	SAI_MasqueUS est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 90
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieDate
			Valeur     = ""
		FIN
	FIN
FIN
