// Fenetre voisine pour test_bouton_mnemonic_raccourci.owl.
// Couvre le mnemonic '&Lettre' du libelle (Alt+lettre) et la propriete
// ToucheRaccourci en chaine (Alt/Ctrl/Shift + combinaisons).

FEN_Mnemonic est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 320
		Titre       = "Mnemonic et raccourci"
	FIN

	// Mnemonic seul : '&' devant O => Alt+O attendu, sans ToucheRaccourci.
	BTN_Mnemo est un Champ Bouton
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 200
			Hauteur = 40
			Libellé = "&Ouvrir"
		FIN
	FIN

	// Raccourci explicite Ctrl+S.
	BTN_Explicite est un Champ Bouton
		PROPRIETES
			X               = 10
			Y               = 60
			Largeur         = 200
			Hauteur         = 40
			Libellé         = "Sauvegarder"
			ToucheRaccourci = "Ctrl+S"
		FIN
	FIN

	// Raccourci explicite Alt+O (non-regression du cas Alt existant).
	BTN_AltExpl est un Champ Bouton
		PROPRIETES
			X               = 10
			Y               = 110
			Largeur         = 200
			Hauteur         = 40
			Libellé         = "Options"
			ToucheRaccourci = "Alt+P"
		FIN
	FIN

	// Combinaison a trois touches (non-regression combos).
	BTN_Combo est un Champ Bouton
		PROPRIETES
			X               = 10
			Y               = 160
			Largeur         = 200
			Hauteur         = 40
			Libellé         = "Truc"
			ToucheRaccourci = "Ctrl+Shift+T"
		FIN
	FIN

	// Mnemonic ET raccourci explicite : l'explicite l'emporte.
	BTN_MnemoOverride est un Champ Bouton
		PROPRIETES
			X               = 10
			Y               = 210
			Largeur         = 200
			Hauteur         = 40
			Libellé         = "&Fermer"
			ToucheRaccourci = "Ctrl+W"
		FIN
	FIN
FIN
