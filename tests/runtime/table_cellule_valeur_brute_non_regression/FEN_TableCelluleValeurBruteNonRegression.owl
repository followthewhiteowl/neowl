// Fenêtre voisine — ressource pour
// test_table_cellule_valeur_brute_non_regression.owl. Colonne
// formatée (Date + MasqueAffichage) volontairement choisie pour que le
// brut ≠ affiché soit observable si jamais la forme valeur se mettait à
// renvoyer l'affiché par erreur.

FEN_TableCelluleValeurBruteNonRegression est une Fenêtre
	PROPRIETES
		Titre = "Cellule — non-régression valeur brute"
	FIN

	TABLE_Dates est un Champ Table
		PROPRIETES
		FIN

		COL_Date est une Colonne
			PROPRIETES
				Libellé         = "Date"
				Type            = colTypeDate
				Largeur         = 140
				MasqueAffichage = "AAAA-MM-JJ"
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		TableAjouteLigne(TABLE_Dates, "12/09/2026")
	FIN
FIN
