// Styles nommés consommés par le script voisin. Chaque état porte une teinte
// distincte de la base pour que la relecture désigne sans ambiguïté sa source.

ThèmeRelectureEtats est un Thème
	stRelSaisie est un styleSaisie = {
		ZoneSaisie = {
			CouleurFond = RVB(255, 255, 255)
			Etats       = {
				Survol = { CouleurFond = RVB(200, 10, 10) }
				Focus  = { CouleurFond = RVB(10, 200, 10) }
			}
		}
	}

	stRelOnglet est un styleOnglet = {
		VoletActif = {
			CouleurFond = RVB(255, 255, 255)
			Etats       = {
				Survol = { CouleurFond = RVB(10, 10, 200) }
			}
		}
	}
FIN
