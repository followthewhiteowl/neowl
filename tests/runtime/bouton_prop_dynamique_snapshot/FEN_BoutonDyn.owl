// Fenetre voisine pour test_bouton_prop_dynamique ( scoping).
// Un Champ Image dont l'icone est assignee dynamiquement dans
// FinInitialisation depuis une variable globale gIconeDyn.
// Si la prop dynamique est bien re-evaluee a l'ouverture (acquis
// de ), l'image est valide apres Ouvre.

FEN_BoutonDyn est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 150
		Titre       = "Bouton prop dynamique"
	FIN

	gIconeDyn est une Icône = icones.save

	IMG_Dyn est un Champ Image
		PROPRIETES
			X       = 50
			Y       = 40
			Largeur = 96
			Hauteur = 96
		FIN
	FIN

	PROCEDURE FinInitialisation()
		IMG_Dyn..Image = gIconeDyn
	FIN

	PROCEDURE LireImageValide()
		RENVOYER IMG_Dyn..Image..Valide
	FIN

	PROCEDURE CaptureImgDyn()
		RENVOYER dCopieImageChamp(IMG_Dyn)
	FIN

FIN
