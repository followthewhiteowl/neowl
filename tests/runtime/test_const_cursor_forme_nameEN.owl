//  — Track B : alias EN runtime des constantes curseurs / selModeAffichage / Forme.
// Verifie que la forme EN resout au runtime vers la MEME valeur que la
// forme FR canon (alias EN auto-genere par le registry via .nameEN).
//
// ROUGE ATTENDU avant pose des .nameEN : les formes EN (curArrow, selSubCaption,
// formeNone, ...) ne resolvent pas encore -> symbole inconnu.
// Une fois .nameEN pose, chaque alias EN == valeur FR canon.

TestModeHeadless(Vrai)

// --- Curseurs : EN resout vers la valeur FR canon ---
dbgVérifieEgalité(curArrow, curFlèche, "curArrow == curFlèche")
dbgVérifieEgalité(curHand, curMain, "curHand == curMain")
dbgVérifieEgalité(curSystemHand, curMainSystème, "curSystemHand == curMainSystème")
dbgVérifieEgalité(curCaret, curCaret, "curCaret == curCaret (EN==FR benin)")
dbgVérifieEgalité(curCross, curCroix, "curCross == curCroix")
dbgVérifieEgalité(curWait, curSablier, "curWait == curSablier")
dbgVérifieEgalité(curHelp, curAide, "curHelp == curAide")
dbgVérifieEgalité(curForbidden, curInterdit, "curForbidden == curInterdit")
dbgVérifieEgalité(curUpArrow, curHFlèche, "curUpArrow == curHFlèche")
dbgVérifieEgalité(curSize, curTaille, "curSize == curTaille")
dbgVérifieEgalité(curSizeNS, curTailleNS, "curSizeNS == curTailleNS")
dbgVérifieEgalité(curSizeWE, curTailleOE, "curSizeWE == curTailleOE")
dbgVérifieEgalité(curSizeNESW, curTailleNESO, "curSizeNESW == curTailleNESO")
dbgVérifieEgalité(curSizeNWSE, curTailleNOSE, "curSizeNWSE == curTailleNOSE")

// --- selModeAffichage : EN resout vers la valeur FR canon ---
dbgVérifieEgalité(selStandard, selStandard, "selStandard == selStandard (EN==FR benin)")
dbgVérifieEgalité(selSubCaption, selSousLib, "selSubCaption == selSousLib")
dbgVérifieEgalité(selVista, selVista, "selVista == selVista (EN==FR benin)")
dbgVérifieEgalité(selVistaSubCaption, selVistaSousLib, "selVistaSubCaption == selVistaSousLib")

// --- Forme : EN resout vers la valeur FR canon ---
dbgVérifieEgalité(formeNone, formeAucune, "formeNone == formeAucune")
dbgVérifieEgalité(formeSquare, formeCarree, "formeSquare == formeCarree")
dbgVérifieEgalité(formeCircle, formeCercle, "formeCircle == formeCercle")

// --- Valeurs absolues figees (sentinelles) : ancre la valeur exacte cote EN ---
dbgVérifieEgalité(curArrow,-2147468544, "curArrow vaut la sentinelle curFlèche")
dbgVérifieEgalité(curWait,-2147468539, "curWait vaut la sentinelle curSablier")
dbgVérifieEgalité(selStandard,-2147471616, "selStandard vaut sa sentinelle")
dbgVérifieEgalité(selVista,-2147471614, "selVista vaut sa sentinelle")
dbgVérifieEgalité(formeNone,-2147472128, "formeNone vaut la sentinelle formeAucune")
dbgVérifieEgalité(formeCircle,-2147472126, "formeCircle vaut la sentinelle formeCercle")

dbgBilanTest()
