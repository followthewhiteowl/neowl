// Fenêtre voisine — ressource pour
// test_table_colonne_type_heure.owl ( lot 2, câblage colTypeHeure
// sur le framework type-driven de colonne posé par ).
//
// COL_Heure       : Type = colTypeHeure, AUCUN masque brut déclaré → doit être
//                   pilotée par le format heure défaut projet (HH:MI, mesuré
//                   src/stdlib_ui.c L1745), donc dériver masque + validateur
//                   de plages (miroir Saisie +).
// COL_HeureMasque : Type = colTypeHeure ET MasqueSaisie brut déclaré → le
//                   masque brut explicite reste un override bas-niveau
//                   (comportement , non affecté par ce ticket).
// COL_Texte       : Type = colTypeTexte, aucun masque/validateur → non-
//                   régression (toute saisie acceptée, pas de contrainte).

FEN_TableColonneTypeHeure est une Fenêtre
	PROPRIETES
		Titre = "Colonne type Heure, masque + validation"
	FIN

	TAB_ColTypes est un Champ Table
		PROPRIETES
		FIN

		COL_Heure est une Colonne
			PROPRIETES
				Libellé = "Heure"
				Type    = colTypeHeure
				Largeur = 140
			FIN
		FIN

		COL_HeureMasque est une Colonne
			PROPRIETES
				Libellé      = "Heure (masque brut)"
				Type         = colTypeHeure
				Largeur      = 140
				MasqueSaisie = "99-99"
			FIN
		FIN

		COL_Texte est une Colonne
			PROPRIETES
				Libellé = "Texte"
				Type    = colTypeTexte
				Largeur = 140
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		TableAjouteLigne(TAB_ColTypes, "14:30", "14-30", "abc")
	FIN
FIN
