//  (LOT 1) — Style..CadreExtérieur..CouleurFond sur un Champ
// Bouton FLAT (aucun Dégradé posé), instance Couleur translucide
// (Opacité<255). Cas exact rapporté : un dégradé actif masquerait le
// CouleurFond uni (le fond dégradé prime), donc AUCUN Dégradé n'est posé
// ici pour isoler l'alpha du CouleurFond.
//
// Fond de fenêtre ROUGE PUR opaque (RVB(255,0,0)) pour rendre tout mélange
// alpha mesurable au pixel.
//
// BTN_Opaque : témoin non-régression, fond VERT PUR (0,255,0) sans Opacité.
// BTN_Alpha  : fond VERT translucide (0,255,0), Opacité=128 — cas exact du
// dev (bouton flat, fond translucide ignoré).
FEN_CouleurAlphaCadreExtBoutonFlat est une Fenêtre
	PROPRIETES
		Titre       = "Alpha CadreExtérieur — Bouton flat"
		Largeur     = 360
		Hauteur     = 220
		Disposition = dispLibre
		CouleurFond = RVB(255, 0, 0)
	FIN

	BTN_Opaque est un Champ Bouton
		PROPRIETES
			X                                  = 20
			Y                                  = 20
			Largeur                            = 300
			Hauteur                            = 60
			Libellé                            = "Opaque"
			Style..CadreExtérieur..CouleurFond = RVB(0, 255, 0)
		FIN
	FIN

	BTN_Alpha est un Champ Bouton
		PROPRIETES
			X                                  = 20
			Y                                  = 110
			Largeur                            = 300
			Hauteur                            = 60
			Libellé                            = "Alpha"
			Style..CadreExtérieur..CouleurFond = {Rouge = 0, Vert = 255, Bleu = 0, Opacité = 128}
		FIN
	FIN
FIN
