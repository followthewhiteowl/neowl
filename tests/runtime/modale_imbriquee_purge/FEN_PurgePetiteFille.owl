// Troisième niveau d'imbrication : ouverte depuis un gestionnaire de la fille
// de deuxième niveau, elle-même ouverte depuis un gestionnaire de la parente.

FEN_PurgePetiteFille est une Fenêtre
	PROPRIETES
		Titre       = "Purge petite-fille"
		Largeur     = 280
		Hauteur     = 160
		Disposition = dispLibre
	FIN

	CMB_Choix3 est un Champ Combo
		PROPRIETES
			X       = 10
			Y       = 20
			Largeur = 200
			Hauteur = 30
		FIN
	FIN

	SAI_G est un Champ Saisie
		PROPRIETES
			X       = 10
			Y       = 70
			Largeur = 200
		FIN

		PROCEDURE surEntrée()
			callback_petite_fille_entree()
			Ferme(FEN_PurgePetiteFille)
		FIN
	FIN

	PROCEDURE FinInitialisation()
		DonneFocus(SAI_G)
	FIN
FIN
