// Fenêtre fille du deuxième cycle : elle ouvre à son tour une petite-fille
// avant de se fermer, ce qui donne deux niveaux d'imbrication empilés.

FEN_PurgeFille2 est une Fenêtre
	PROPRIETES
		Titre       = "Purge fille niveau 2"
		Largeur     = 300
		Hauteur     = 180
		Disposition = dispLibre
	FIN

	CMB_Choix2 est un Champ Combo
		PROPRIETES
			X       = 10
			Y       = 20
			Largeur = 200
			Hauteur = 30
		FIN
	FIN

	SAI_F2 est un Champ Saisie
		PROPRIETES
			X       = 10
			Y       = 70
			Largeur = 200
		FIN

		PROCEDURE surEntrée()
			callback_fille2_entree()
			Ouvre(FEN_PurgePetiteFille)
			callback_retour_petite_fille()
			Ferme(FEN_PurgeFille2)
		FIN
	FIN

	PROCEDURE FinInitialisation()
		DonneFocus(SAI_F2)
	FIN
FIN
