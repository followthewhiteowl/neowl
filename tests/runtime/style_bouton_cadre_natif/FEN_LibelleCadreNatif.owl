//  — `Style..CadreExtérieur` sur un Champ Libellé (widget mono) doit
// être la bordure DU QLabel lui-même, pas un wrapper conteneur séparé.
FEN_LibelleCadreNatif est une Fenêtre
	PROPRIETES
		Titre       = "Libellé — cadre natif"
		Largeur     = 400
		Hauteur     = 120
		Disposition = dispLibre
		CouleurFond = RVB(10, 10, 10)
	FIN

	LIB_Cadre est un Champ Libellé
		PROPRIETES
			X                                       = 20
			Y                                       = 20
			Largeur                                 = 300
			Hauteur                                 = 60
			Libellé                                 = "Texte"
			Style..CadreExtérieur..CouleurFond      = RVB(200, 200, 0)
			Style..CadreExtérieur..Cadre..Couleur   = RVB(0, 128, 255)
			Style..CadreExtérieur..Cadre..Epaisseur = 5
		FIN
	FIN
FIN
