//  — `Style..CadreExtérieur..CouleurFond/Cadre` sur un Champ Bouton
// doit peindre la bordure et le fond DIRECTEMENT sur le QPushButton (widget
// mono-élément), pas sur un wrapper conteneur séparé.
//
// ROUGE attendu : aujourd'hui le cadre est appliqué sur le wrapper généré par
// `owl_ui_control_ensure_wrapper` (/0864) — la feuille de style du
// QPushButton lui-même ne contient ni le fond ni la bordure du CadreExtérieur.
// Cf. FEN_BoutonCadreNatif.owl.

TestModeHeadless(Faux)

OuvreSoeur(FEN_BoutonCadreNatif)

feuille est une chaîne = __DebugFeuilleStyle(BTN_Cadre)

dbgVérifieVrai(Contient(feuille, "border") ET (Contient(feuille, "0,128,255") OU Contient(feuille, "0, 128, 255")),
"Style..CadreExtérieur..Cadre..Couleur/Epaisseur : la bordure est portée par la feuille de style du QPushButton lui-même")

dbgVérifieVrai(Contient(feuille, "background-color") ET (Contient(feuille, "200,200,0") OU Contient(feuille, "200, 200, 0")),
"Style..CadreExtérieur..CouleurFond : le fond est porté par la feuille de style du QPushButton lui-même")

Ferme(FEN_BoutonCadreNatif)
dbgBilanTest()
