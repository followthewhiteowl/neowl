//  — `Style..CadreExtérieur` sur un Champ Bouton (widget mono) doit
// être la bordure DU QPushButton lui-même, pas un wrapper conteneur séparé.
FEN_BoutonCadreNatif est une Fenêtre
	PROPRIETES
		Titre       = "Bouton — cadre natif"
		Largeur     = 400
		Hauteur     = 120
		Disposition = dispLibre
		CouleurFond = RVB(10, 10, 10)
	FIN

	BTN_Cadre est un Champ Bouton
		PROPRIETES
			X                                       = 20
			Y                                       = 20
			Largeur                                 = 300
			Hauteur                                 = 60
			Libellé                                 = "Valider"
			Style..CadreExtérieur..CouleurFond      = RVB(200, 200, 0)
			Style..CadreExtérieur..Cadre..Couleur   = RVB(0, 128, 255)
			Style..CadreExtérieur..Cadre..Epaisseur = 5
		FIN
	FIN
FIN
