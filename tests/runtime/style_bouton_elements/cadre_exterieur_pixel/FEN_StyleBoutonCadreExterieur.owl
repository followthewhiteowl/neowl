//  — `Style..CadreExtérieur..CouleurFond` / `..Cadre..Couleur` sur
// un Champ Bouton : le conteneur qui enveloppe le QPushButton (wrapper
// générique, /). Sous-élément STATIQUE (pas d'états),
// peint en permanence, capturable au pixel sans interaction.
FEN_StyleBoutonCadreExterieur est une Fenêtre
	PROPRIETES
		Titre       = "Style Bouton — élément CadreExtérieur"
		Largeur     = 560
		Hauteur     = 120
		Disposition = dispLibre
		CouleurFond = RVB(10, 10, 10)
	FIN

	BTN_Zone est un Champ Bouton
		PROPRIETES
			X                                       = 20
			Y                                       = 20
			Largeur                                 = 500
			Hauteur                                 = 60
			Libellé                                 = "Valider"
			Style..CadreExtérieur..CouleurFond      = RVB(200, 200, 0)
			Style..CadreExtérieur..Cadre..Couleur   = RVB(0, 128, 255)
			Style..CadreExtérieur..Cadre..Epaisseur = 5
		FIN
	FIN
FIN
