// ============================================
// TEST: Types de base et conversions implicites
// ============================================
Trace("=== TYPES ET CONVERSIONS ===")

// --- Entiers ---
nZero est un entier = 0
nPositif est un entier = 42
nNegatif est un entier = -7
nGrand est un entier = 999999

dbgVérifieEgalité(nZero, 0, "Entier zero")
dbgVérifieEgalité(nPositif, 42, "Entier positif")
dbgVérifieEgalité(nNegatif,-7, "Entier negatif")
dbgVérifieEgalité(nGrand, 999999, "Grand entier")

// --- Entier hex ---
nHex est un entier = 0xFF
dbgVérifieEgalité(nHex, 255, "Entier hexadecimal 0xFF")

nHex2 est un entier = 0x10
dbgVérifieEgalité(nHex2, 16, "Entier hexadecimal 0x10")

// --- Reels ---
rPi est un réel = 3.14
rNegatif est un réel = -0.5
rZero est un réel = 0.0

dbgVérifieEgalité(rPi, 3.14, "Reel pi")
dbgVérifieEgalité(rNegatif,-0.5, "Reel negatif")
dbgVérifieEgalité(rZero, 0.0, "Reel zero")

// --- Chaines ---
sVide est une chaîne = ""
sHello est une chaîne = "Hello"
sAvecEscape est une chaîne = "ligne1\nligne2"

dbgVérifieEgalité(sVide, "", "Chaine vide")
dbgVérifieEgalité(sHello, "Hello", "Chaine simple")
dbgVérifieEgalité(Taille(sVide), 0, "Taille chaine vide")
dbgVérifieEgalité(Taille(sHello), 5, "Taille chaine Hello")

// --- Booleens ---
bVrai est un booléen = Vrai
bFaux est un booléen = Faux

dbgVérifieEgalité(bVrai, Vrai, "Booleen Vrai")
dbgVérifieEgalité(bFaux, Faux, "Booleen Faux")
dbgVérifieDifférence(bVrai, bFaux, "Vrai <> Faux")

// --- Null sur variable nullable ---
vNull est une chaîne? = Null
dbgVérifieEgalité(vNull, Null, "chaine? = Null")

// --- Conversion implicite: nombre vers chaine (via +) ---
sConcat est une chaîne = "Age: " + 42
dbgVérifieEgalité(sConcat, "Age: 42", "Concat string + entier")

sConcat2 est une chaîne = "Pi: " + 3.14
dbgVérifieEgalité(sConcat2, "Pi: 3.14", "Concat string + reel")

sConcat3 est une chaîne = "Bool: " + Vrai
dbgVérifieEgalité(sConcat3, "Bool: 1", "Concat string + booleen")

// --- Conversion entier <-> reel dans les operations ---
rMixte est un réel = 10 + 0.5
dbgVérifieEgalité(rMixte, 10.5, "Entier + reel = reel")

// --- Valeur par defaut ---
// Variables non-init = zero-typed (canon de référence), pas Null. Pour Null distinct,
// utiliser le `?` postfix (entier?, chaine?, etc.).
nDefault est un entier
dbgVérifieEgalité(nDefault, 0, "Entier non initialise = 0 (zero-typed)")

// Note: un entier non init = 0, pas Null.
// A terme on devra emettre la valeur par defaut du type.

