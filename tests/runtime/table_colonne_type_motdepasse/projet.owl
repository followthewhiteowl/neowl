//  lot 5 — projet avec FormatNombre/FormatMonétaire/FormatDate/
// FormatHeure/FormatDurée configurés (superset des projets  lot 3 et
//  lot 4), pour verrouiller en un seul coup que l'ajout de
// colTypeMotDePasse à l'enum colTypes ne dégrade aucun des 5 types "valeur"
// déjà câblés ni la colonne Texte.

MonAppTableColMotDePasseProjet est un Projet
	PROPRIETES
		Langues         = [langueFrançais]
		FormatNombre    = {ChiffresAprèsVirgule = 2, SéparateurMilliers = " ", SéparateurDécimal = ","}
		FormatMonétaire = {Symbole = "€", SéparateurMilliers = " ", SéparateurDécimal = ",", ChiffresAprèsVirgule = 2}
		FormatDate      = "JJ/MM/AAAA"
		FormatHeure     = "HH:MI"
		FormatDurée     = "HH:MI:SS"
	FIN
FIN
