// Fenêtre voisine — ressource pour test_event_champ_bilingue_en.owl.
//
// Cas EN : un Control Image avec onLeftButtonDown et un Control Button
// avec onClick. Le compilateur accepte ces handlers (reconnaissance
// bilingue), mais le câblage runtime au clic simulé est en cause
//.

FEN_EventChampEN is a Window
	PROPERTIES
		Title  = "Event champ EN"
		Layout = dispFree
		Width  = 300
		Height = 300
	END

	IMG_Canvas is a Control Image
		PROPERTIES
			X      = 0
			Y      = 0
			Width  = 200
			Height = 200
		END
		PROCEDURE onLeftButtonDown(nX is an integer, nY is an integer)
			callback_image_clic(nX, nY)
		END
	END

	BTN_OK is a Control Button
		PROPERTIES
			X = 0
			Y = 220
		END
		PROCEDURE onClick()
			callback_bouton_clic()
		END
	END
END
