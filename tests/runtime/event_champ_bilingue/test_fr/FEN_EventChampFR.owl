// Fenêtre voisine — ressource pour test_event_champ_bilingue_fr.owl.
//
// Témoin FR (canon) : un Champ Image avec surBoutonGauche et un Champ
// Bouton avec surClic doivent câbler leur callback au clic simulé.

FEN_EventChampFR est une Fenêtre
	PROPRIETES
		Titre       = "Event champ FR"
		Disposition = dispLibre
		Largeur     = 300
		Hauteur     = 300
	FIN

	IMG_Canvas est un Champ Image
		PROPRIETES
			X       = 0
			Y       = 0
			Largeur = 200
			Hauteur = 200
		FIN
		PROCEDURE surBoutonGauche(nX est un entier, nY est un entier)
			callback_image_clic(nX, nY)
		FIN
	FIN

	BTN_OK est un Champ Bouton
		PROPRIETES
			X = 0
			Y = 220
		FIN
		PROCEDURE surClic()
			callback_bouton_clic()
		FIN
	FIN
FIN
