//  — projet avec FormatMonétaire configuré (2 décimales, séparateurs),
// hérité par le champ voisin. Sert de frontière pour le test du formatage de
// ContenuInitial monétaire à l'ouverture (miroir  côté num).

MonAppMonetaireInteractifContenuInitial est un Projet
	PROPRIETES
		Langues         = [langueFrançais]
		FormatMonétaire = {Symbole = "€", SéparateurMilliers = " ", SéparateurDécimal = ",", ChiffresAprèsVirgule = 2}
	FIN
FIN
