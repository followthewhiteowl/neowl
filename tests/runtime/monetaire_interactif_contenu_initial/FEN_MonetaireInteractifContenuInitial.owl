// Fenêtre voisine — champ typSaisieMonétaire avec un ContenuInitial à 3
// décimales (pas de Valeur posée) : sert à prouver que le format effectif
// (hérité du projet, 2 décimales) est appliqué DÈS L'OUVERTURE, pas
// seulement au SET programmatique (miroir  côté num).

FEN_MonetaireInteractifContenuInitial est une Fenêtre
	PROPRIETES
		Titre       = "Monétaire interactif - ContenuInitial"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 120
	FIN

	SAI_Montant est un Champ Saisie
		PROPRIETES
			X              = 10
			Y              = 10
			Largeur        = 180
			Hauteur        = 24
			TypeSaisie     = typSaisieMonétaire
			ContenuInitial = "1234567.891"
		FIN
	FIN
FIN
