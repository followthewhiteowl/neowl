//  — sous-attribut Dégradé (FR) / Gradient (EN) sur CadreExtérieur
// (styleBouton). Round-trip via Thème.
ThèmeDegrade est un Thème
	boutonDegradeLineaire est un styleBouton = {
		CadreExtérieur = {
			Dégradé = {
				Type         = dégradéLinéaire
				Angle        = 90
				CouleurDébut = RVB(103, 80, 164)
				CouleurFin   = RVB(29, 27, 32)
			}
		}
	}

	boutonDegradeRadial est un styleBouton = {
		CadreExtérieur = {
			Dégradé = {
				Type         = dégradéRadial
				CouleurDébut = RVB(255, 0, 0)
				CouleurFin   = RVB(0, 0, 255)
			}
		}
	}

	boutonSansDegrade est un styleBouton = {
		CadreExtérieur = { CouleurFond = Blanc }
	}

	boutonGlowEN est un styleBouton = {
		CadreExtérieur = {
			Gradient = {
				Type       = gradientLinear
				Angle      = 45
				StartColor = RVB(0, 255, 255)
				EndColor   = RVB(255, 0, 255)
			}
		}
	}

	boutonTroisBlocs est un styleBouton = {
		CadreExtérieur = {
			Cadre   = { Arrondi = 16 }
			Ombre   = { Couleur = Noir, DécalageX = 0, DécalageY = 6, Flou = 16, Étendue = 2 }
			Dégradé = {
				Type         = dégradéLinéaire
				Angle        = 0
				CouleurDébut = RVB(10, 20, 30)
				CouleurFin   = RVB(40, 50, 60)
			}
		}
	}
FIN
