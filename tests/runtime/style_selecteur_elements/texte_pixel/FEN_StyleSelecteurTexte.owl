//  — `Style..TexteOptions..Couleur` doit peindre réellement le texte
// des options du Champ Sélecteur. Grosse police grasse (glyphes denses ->
// pixels de coeur capturables), fond blanc, une seule option "IIIIIIIIII"
// (glyphes verticaux pleins, comptage fiable).
FEN_StyleSelecteurTexte est une Fenêtre
	PROPRIETES
		Titre       = "Style Sélecteur — texte des options"
		Largeur     = 560
		Hauteur     = 150
		Disposition = dispLibre
		CouleurFond = RVB(255, 255, 255)
	FIN

	SEL_Rouge est un Champ Sélecteur
		PROPRIETES
			X                                   = 20
			Y                                   = 20
			Largeur                             = 520
			Hauteur                             = 100
			Options                             = ["IIIIIIIIII"]
			Style..CadreExtérieur..CouleurFond  = RVB(255, 255, 255)
			Style..TexteOptions..Couleur        = RVB(255, 0, 0)
			Style..TexteOptions..Police..Taille = 30
			Style..TexteOptions..Police..Gras   = Vrai
		FIN
	FIN
FIN
