//  — `Style..CadrePuce..X` sur un Champ Sélecteur : la boîte du
// rond radio (QRadioButton::indicator), stylable en QSS (background/border).
// Le rond lui-même (sous-élément Puce) est souvent une image thémée côté
// Qt — cf. FEN_StyleSelecteurTexte.owl et le test dédié Puce (structurel,
// pas pixel) pour ce sous-élément séparé.
FEN_StyleSelecteurCadrePuce est une Fenêtre
	PROPRIETES
		Titre       = "Style Sélecteur — élément CadrePuce"
		Largeur     = 400
		Hauteur     = 120
		Disposition = dispLibre
	FIN

	SEL_Puce est un Champ Sélecteur
		PROPRIETES
			X                                  = 20
			Y                                  = 20
			Largeur                            = 300
			Hauteur                            = 60
			Options                            = ["Choix"]
			Style..CadrePuce..CouleurFond      = RVB(0, 200, 0)
			Style..CadrePuce..Cadre..Couleur   = RVB(255, 128, 0)
			Style..CadrePuce..Cadre..Epaisseur = 2
		FIN
	FIN
FIN
