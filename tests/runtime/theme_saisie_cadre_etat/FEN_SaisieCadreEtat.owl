//  — le cadre d'ÉTAT (focus) d'un Champ Saisie doit suivre l'arrondi de
// la pilule, pas rendre CARRÉ (même classe que le Bouton).
//
// Config du bug : Hauteur=44 avec un état Focus dont le Cadre porte Arrondi=24
// (rayon > moitié de la hauteur = 22). Le clamp  ne bornait QUE la règle
// de base ; le fragment `:focus` gardait son rayon brut → coins CARRÉS au focus.
//
// SAI_Leurre capte le focus automatique à l'ouverture ; SAI_Focus ne le reçoit
// que via DonneFocus.
FEN_SaisieCadreEtat est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 140
		Titre       = "Saisie cadre état focus"
		CouleurFond = RVB(15, 15, 15)
	FIN

	SAI_Leurre est un Champ Saisie
		PROPRIETES
			X       = 30
			Y       = 100
			Largeur = 120
			Hauteur = 30
		FIN
	FIN

	SAI_Focus est un Champ Saisie
		PROPRIETES
			X                                                 = 30
			Y                                                 = 30
			Largeur                                           = 120
			Hauteur                                           = 44
			Style..ZoneSaisie..CouleurFond                    = RVB(50, 50, 200)
			Style..ZoneSaisie..Cadre..Epaisseur               = 0
			Style..ZoneSaisie..Cadre..Arrondi                 = 24
			Style..ZoneSaisie..Etats[focus]..Cadre..Epaisseur = 3
			Style..ZoneSaisie..Etats[focus]..Cadre..Couleur   = RVB(150, 0, 200)
			Style..ZoneSaisie..Etats[focus]..Cadre..Arrondi   = 24
		FIN
	FIN
FIN
