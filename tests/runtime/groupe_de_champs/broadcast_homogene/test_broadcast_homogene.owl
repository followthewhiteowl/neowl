// Test: broadcast sur groupe homogène (3 boutons), propriétés Visible et Grise.
// Pattern : la fenêtre voisine FEN_DemoBroadcast.owl porte la déclaration.

Ouvre(FEN_DemoBroadcast)

// Tous visibles au départ
dbgVérifieVrai(BTN_Alpha..Visible, "BTN_Alpha visible au départ")
dbgVérifieVrai(BTN_Beta..Visible, "BTN_Beta visible au départ")
dbgVérifieVrai(BTN_Gamma..Visible, "BTN_Gamma visible au départ")

// Broadcast Visible = Faux
GR_Boutons..Visible = Faux

dbgVérifieVrai(BTN_Alpha..Visible = Faux, "BTN_Alpha invisible après broadcast")
dbgVérifieVrai(BTN_Beta..Visible = Faux, "BTN_Beta invisible après broadcast")
dbgVérifieVrai(BTN_Gamma..Visible = Faux, "BTN_Gamma invisible après broadcast")

// Broadcast Grise = Vrai
GR_Boutons..Grisé = Vrai

dbgVérifieVrai(BTN_Alpha..Grisé, "BTN_Alpha grisé après broadcast")
dbgVérifieVrai(BTN_Beta..Grisé, "BTN_Beta grisé après broadcast")
dbgVérifieVrai(BTN_Gamma..Grisé, "BTN_Gamma grisé après broadcast")

Ferme(FEN_DemoBroadcast)

dbgBilanTest()
