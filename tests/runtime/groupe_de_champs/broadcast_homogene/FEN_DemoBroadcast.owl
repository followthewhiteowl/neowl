// Fenêtre voisine — ressource pour test_broadcast_homogene.owl.
// Groupe homogène de 3 boutons pour test broadcast Visible/Grise.

FEN_DemoBroadcast est une Fenêtre
	PROPRIETES
		Titre       = "Test Broadcast Homogene"
		Disposition = dispLibre
	FIN

	BTN_Alpha est un Champ Bouton
		PROPRIETES
			Libellé = "Alpha"
			Visible = Vrai
			Grisé   = Faux
		FIN
	FIN

	BTN_Beta est un Champ Bouton
		PROPRIETES
			Libellé = "Beta"
			Visible = Vrai
			Grisé   = Faux
		FIN
	FIN

	BTN_Gamma est un Champ Bouton
		PROPRIETES
			Libellé = "Gamma"
			Visible = Vrai
			Grisé   = Faux
		FIN
	FIN

	GR_Boutons est un Groupe = [BTN_Alpha, BTN_Beta, BTN_Gamma]
FIN
