// Test: propriété ..Groupe en écriture (assigner/retirer groupes).
// Pattern : la fenêtre voisine FEN_DemoGroupeEcriture.owl porte la déclaration.

Ouvre(FEN_DemoGroupeEcriture)

// BTN_Cible initialement dans aucun groupe
dbgVérifieEgalité(BTN_Cible..Groupe..Occurrence, 0, "BTN_Cible dans 0 groupe initialement")

// Assigner à GR_Premier
BTN_Cible..Groupe = [GR_Premier]
dbgVérifieEgalité(BTN_Cible..Groupe..Occurrence, 1, "BTN_Cible dans 1 groupe après assign")
dbgVérifieEgalité(GR_Premier..Occurrence, 1, "GR_Premier contient 1 membre")

// Remplacer par GR_Second (écrase l'appartenance précédente)
BTN_Cible..Groupe = [GR_Second]
dbgVérifieEgalité(BTN_Cible..Groupe..Occurrence, 1, "BTN_Cible dans 1 groupe après remplacement")
dbgVérifieEgalité(GR_Premier..Occurrence, 0, "GR_Premier vide après retrait automatique")
dbgVérifieEgalité(GR_Second..Occurrence, 1, "GR_Second contient 1 membre")

// Retirer de tous les groupes
BTN_Cible..Groupe = []
dbgVérifieEgalité(BTN_Cible..Groupe..Occurrence, 0, "BTN_Cible dans 0 groupe après []")
dbgVérifieEgalité(GR_Second..Occurrence, 0, "GR_Second vide après retrait")

Ferme(FEN_DemoGroupeEcriture)

dbgBilanTest()
