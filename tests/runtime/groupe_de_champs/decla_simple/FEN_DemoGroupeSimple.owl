// Fenêtre voisine — ressource pour test_decla_simple.owl.
// Déclaration Groupe vide, avec init littérale.

FEN_DemoGroupeSimple est une Fenêtre
	PROPRIETES
		Titre       = "Test Groupe Simple"
		Disposition = dispLibre
	FIN

	BTN_OK est un Champ Bouton
		PROPRIETES
			Libellé = "OK"
			X       = 10
			Y       = 10
			Largeur = 100
			Hauteur = 30
		FIN
	FIN

	BTN_Annuler est un Champ Bouton
		PROPRIETES
			Libellé = "Annuler"
			X       = 120
			Y       = 10
			Largeur = 100
			Hauteur = 30
		FIN
	FIN

	GR_Vide est un Groupe
	GR_Boutons est un Groupe = [BTN_OK, BTN_Annuler]
FIN
