// Test: déclaration Groupe vide, avec init littérale, et propriété ..Occurrence.
// Pattern : la fenêtre voisine FEN_DemoGroupeSimple.owl porte la déclaration.

Ouvre(FEN_DemoGroupeSimple)

// Groupe vide au départ
dbgVérifieEgalité(GR_Vide..Occurrence, 0, "Groupe vide doit avoir 0 membre")

// Groupe initialisé avec tableau littéral
dbgVérifieEgalité(GR_Boutons..Occurrence, 2, "Groupe avec init littérale contient 2 boutons")

Ferme(FEN_DemoGroupeSimple)

dbgBilanTest()
