// Fenêtre voisine — ressource pour test_broadcast_mixte.owl.
// Groupe hétérogène (Bouton + Saisie + Libellé) pour test broadcast Valeur.

FEN_DemoMixte est une Fenêtre
	PROPRIETES
		Titre       = "Test Broadcast Mixte No-Op"
		Disposition = dispLibre
	FIN

	BTN_Action est un Champ Bouton
		PROPRIETES
			Libellé = "Action"
		FIN
	FIN

	SAI_Nom est un Champ Saisie
		PROPRIETES
			Indication = "Nom"
		FIN
	FIN

	LBL_Info est un Champ Libellé
		PROPRIETES
			Libellé = "Information"
		FIN
	FIN

	GR_Mixte est un Groupe = [BTN_Action, SAI_Nom, LBL_Info]
FIN
