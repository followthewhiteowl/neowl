// Test: broadcast sur groupe hétérogène (Bouton + Saisie + Libellé).
// Propriété ..Valeur appliquée -> seule la Saisie réagit, autres no-op silencieux.
// Pattern : la fenêtre voisine FEN_DemoMixte.owl porte la déclaration.

Ouvre(FEN_DemoMixte)

// Saisie vide au départ
dbgVérifieVrai(SAI_Nom..Valeur = "", "SAI_Nom vide initialement")

// Broadcast Valeur sur groupe mixte
// Seule SAI_Nom (dont le catalogue expose Valeur) réagit
// BTN_Action et LBL_Info n'exposent pas Valeur -> no-op silencieux
GR_Mixte..Valeur = "Valeur broadcast"

dbgVérifieVrai(SAI_Nom..Valeur = "Valeur broadcast", "SAI_Nom reçoit le broadcast")

// Pas d'erreur runtime, pas de warning, valeurs exactes sur les autres inchangées
// (test négatif — on vérifie qu'aucune exception n'est levée)

Ferme(FEN_DemoMixte)

dbgBilanTest()
