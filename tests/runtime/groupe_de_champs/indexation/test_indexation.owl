// Test: indexation [i] retourne le membre, ordre d'insertion préservé.
// Pattern : la fenêtre voisine FEN_DemoIndexation.owl porte la déclaration.

Ouvre(FEN_DemoIndexation)

// Indexation base 1 (convention de référence)
premier est un Champ = GR_Sequence[1]
deuxieme est un Champ = GR_Sequence[2]
troisieme est un Champ = GR_Sequence[3]

dbgVérifieVrai(premier = BTN_Un, "GR_Sequence[1] = BTN_Un")
dbgVérifieVrai(deuxieme = BTN_Deux, "GR_Sequence[2] = BTN_Deux")
dbgVérifieVrai(troisieme = BTN_Trois, "GR_Sequence[3] = BTN_Trois")

// Ordre préservé après ajout dynamique
GR_Dynamique est un Groupe
Ajoute(GR_Dynamique, BTN_Trois)
Ajoute(GR_Dynamique, BTN_Un)
Ajoute(GR_Dynamique, BTN_Deux)

dbgVérifieVrai(GR_Dynamique[1] = BTN_Trois, "GR_Dynamique[1] = BTN_Trois")
dbgVérifieVrai(GR_Dynamique[2] = BTN_Un, "GR_Dynamique[2] = BTN_Un")
dbgVérifieVrai(GR_Dynamique[3] = BTN_Deux, "GR_Dynamique[3] = BTN_Deux")

Ferme(FEN_DemoIndexation)

dbgBilanTest()
