// Fenêtre voisine — ressource pour test_indexation.owl.
// 3 boutons et un groupe pour test indexation [i].

FEN_DemoIndexation est une Fenêtre
	PROPRIETES
		Titre       = "Test Indexation Groupe"
		Disposition = dispLibre
	FIN

	BTN_Un est un Champ Bouton
		PROPRIETES
			Libellé = "Un"
		FIN
	FIN

	BTN_Deux est un Champ Bouton
		PROPRIETES
			Libellé = "Deux"
		FIN
	FIN

	BTN_Trois est un Champ Bouton
		PROPRIETES
			Libellé = "Trois"
		FIN
	FIN

	GR_Sequence est un Groupe = [BTN_Un, BTN_Deux, BTN_Trois]
FIN
