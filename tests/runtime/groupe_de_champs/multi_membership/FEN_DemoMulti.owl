// Fenêtre voisine — ressource pour test_multi_membership.owl.
// Un champ peut appartenir à plusieurs groupes simultanément.

FEN_DemoMulti est une Fenêtre
	PROPRIETES
		Titre       = "Test Multi-Membership"
		Disposition = dispLibre
	FIN

	BTN_Partage est un Champ Bouton
		PROPRIETES
			Libellé = "Partagé"
			Visible = Vrai
		FIN
	FIN

	BTN_Autre est un Champ Bouton
		PROPRIETES
			Libellé = "Autre"
			Visible = Vrai
		FIN
	FIN

	GR_Actions est un Groupe = [BTN_Partage, BTN_Autre]
	GR_Essentiels est un Groupe = [BTN_Partage]
FIN
