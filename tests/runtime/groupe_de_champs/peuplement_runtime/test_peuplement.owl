// Test: Ajoute, Supprime (par indice), SupprimeTout, Cherche, indexation [i].
// Pattern : la fenêtre voisine FEN_DemoPeuplement.owl porte la déclaration.

Ouvre(FEN_DemoPeuplement)

// Groupe vide au départ
dbgVérifieEgalité(GR_Dynamique..Occurrence, 0, "Groupe initialement vide")

// Ajout de membres
Ajoute(GR_Dynamique, BTN_Premier)
dbgVérifieEgalité(GR_Dynamique..Occurrence, 1, "1 membre après Ajoute")

Ajoute(GR_Dynamique, BTN_Deuxieme)
Ajoute(GR_Dynamique, BTN_Troisieme)
dbgVérifieEgalité(GR_Dynamique..Occurrence, 3, "3 membres après 3 Ajoute")

// Cherche retourne indice (base 1, convention de référence)
nIndice est un entier = Cherche(GR_Dynamique, BTN_Deuxieme)
dbgVérifieEgalité(nIndice, 2, "Cherche BTN_Deuxieme retourne indice 2")

// Indexation [i] retourne le membre
champTrouve est un Champ = GR_Dynamique[2]
dbgVérifieVrai(champTrouve = BTN_Deuxieme, "GR_Dynamique[2] pointe bien BTN_Deuxieme")

// Supprime par indice (retire le 2ème = BTN_Deuxieme)
Supprime(GR_Dynamique, 2)
dbgVérifieEgalité(GR_Dynamique..Occurrence, 2, "2 membres après Supprime indice 2")
dbgVérifieEgalité(Cherche(GR_Dynamique, BTN_Deuxieme),-1, "BTN_Deuxieme non trouvé après suppression")

// SupprimeTout
SupprimeTout(GR_Dynamique)
dbgVérifieEgalité(GR_Dynamique..Occurrence, 0, "Groupe vide après SupprimeTout")

Ferme(FEN_DemoPeuplement)

dbgBilanTest()
