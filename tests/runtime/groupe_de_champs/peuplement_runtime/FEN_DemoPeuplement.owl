// Fenêtre voisine — ressource pour test_peuplement.owl.
// 3 boutons et un groupe dynamique pour test Ajoute/Supprime/Cherche.

FEN_DemoPeuplement est une Fenêtre
	PROPRIETES
		Titre       = "Test Peuplement Groupe"
		Disposition = dispLibre
	FIN

	BTN_Premier est un Champ Bouton
		PROPRIETES
			Libellé = "Premier"
		FIN
	FIN

	BTN_Deuxieme est un Champ Bouton
		PROPRIETES
			Libellé = "Deuxieme"
		FIN
	FIN

	BTN_Troisieme est un Champ Bouton
		PROPRIETES
			Libellé = "Troisieme"
		FIN
	FIN

	GR_Dynamique est un Groupe
FIN
