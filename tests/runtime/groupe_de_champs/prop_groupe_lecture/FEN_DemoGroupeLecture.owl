// Fenêtre voisine — ressource pour test_prop_groupe_lecture.owl.
// Propriété ..Groupe en lecture retourne tableau de Groupe.

FEN_DemoGroupeLecture est une Fenêtre
	PROPRIETES
		Titre       = "Test Propriété Groupe Lecture"
		Disposition = dispLibre
	FIN

	BTN_Solo est un Champ Bouton
		PROPRIETES
			Libellé = "Solo"
		FIN
	FIN

	BTN_Multi est un Champ Bouton
		PROPRIETES
			Libellé = "Multi"
		FIN
	FIN

	GR_Alpha est un Groupe = [BTN_Multi]
	GR_Beta est un Groupe = [BTN_Multi]
FIN
