// Test: propriété ..Groupe en lecture retourne tableau de Groupe.
// Pattern : la fenêtre voisine FEN_DemoGroupeLecture.owl porte la déclaration.

Ouvre(FEN_DemoGroupeLecture)

// BTN_Solo n'appartient à aucun groupe
tabGroupesSolo est un tableau de Groupe = BTN_Solo..Groupe
dbgVérifieEgalité(tabGroupesSolo..Occurrence, 0, "BTN_Solo dans 0 groupe")

// BTN_Multi appartient à 2 groupes
tabGroupesMulti est un tableau de Groupe = BTN_Multi..Groupe
dbgVérifieEgalité(tabGroupesMulti..Occurrence, 2, "BTN_Multi dans 2 groupes")

// Vérifier identité (ordre non garanti par spec, donc test ensembliste)
nTrouveAlpha est un entier = Cherche(tabGroupesMulti, GR_Alpha)
nTrouveBeta est un entier = Cherche(tabGroupesMulti, GR_Beta)
dbgVérifieVrai(nTrouveAlpha > 0, "GR_Alpha trouvé dans BTN_Multi..Groupe")
dbgVérifieVrai(nTrouveBeta > 0, "GR_Beta trouvé dans BTN_Multi..Groupe")

Ferme(FEN_DemoGroupeLecture)

dbgBilanTest()
