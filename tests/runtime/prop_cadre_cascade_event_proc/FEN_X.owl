// Fenêtre voisine — ressource pour test_prop_cadre_cascade_event_proc.owl.
// Verifie que l'introduction du type OWL_PROP_TYPE_OBJECT ne casse pas les
// cascades existantes sur la prop Cadre d'un widget accessibles depuis une
// procedure d'evenement.

FEN_X est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN

	cadreCarte est un Cadre

	LIB_Avec est un Champ Libellé
		PROPRIETES
			X       = 10
			Y       = 10
			Libellé = "test"
		FIN
	FIN

	PROCEDURE FinInitialisation()
		cadreCarte..Couleur    = BleuClair
		cadreCarte..Epaisseur  = 2
		cadreCarte..Trait      = TraitContinu
		cadreCarte..Arrondi    = 4
		LIB_Avec..Cadre        = cadreCarte
		LIB_Avec..Cadre..Bords = BordBas
	FIN
FIN
