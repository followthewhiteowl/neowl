// Fenêtre voisine — ressource pour test_unification_image_bouton_gui.owl
//. Deux boutons identiques : BTN_A pose l'icone via
// Style..Image..Image puis l'ecrase via le plat BTN..Image (dernier écrit
// gagne) ; BTN_B pose directement la meme icone finale via le plat. Les
// deux doivent rendre pixel-identiques si l'unification tient en mode GUI
// reel (pas seulement dans le store headless).

FEN_UnifImageBoutonGui est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 300
		Hauteur     = 140
		Titre       = "Unification image bouton GUI"
		CouleurFond = RVB(15, 15, 15)
	FIN

	BTN_A est un Champ Bouton
		PROPRIETES
			X                   = 20
			Y                   = 20
			Largeur             = 96
			Hauteur             = 96
			Style..Image..Image = icones.close
		FIN
	FIN

	BTN_B est un Champ Bouton
		PROPRIETES
			X       = 140
			Y       = 20
			Largeur = 96
			Hauteur = 96
			Image   = icones.add
		FIN
	FIN

	PROCEDURE EcraseImagePlatSurA()
		BTN_A..Image = icones.add
	FIN

	PROCEDURE CaptureA()
		RENVOYER dCopieImageChamp(BTN_A)
	FIN

	PROCEDURE CaptureB()
		RENVOYER dCopieImageChamp(BTN_B)
	FIN

FIN
