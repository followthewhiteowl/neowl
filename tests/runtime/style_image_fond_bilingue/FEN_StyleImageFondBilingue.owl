//  (ST-B) — cascade directe sur un Champ Bouton, pour vérifier le
// round-trip bilingue de la nouvelle feuille `ImageFond` / `BackgroundImage`
// (`CadreExtérieur` / `OuterFrame`). Même patron que la cascade Etats
// CadreExtérieur.
FEN_StyleImageFondBilingue est une Fenêtre
	PROPRIETES
		Titre       = "Style CadreExtérieur — image de fond bilingue"
		Largeur     = 300
		Hauteur     = 120
		Disposition = dispLibre
	FIN

	BTN_Zone est un Champ Bouton
		PROPRIETES
			X       = 20
			Y       = 20
			Largeur = 200
			Hauteur = 60
			Libellé = "Valider"
		FIN
	FIN
FIN
