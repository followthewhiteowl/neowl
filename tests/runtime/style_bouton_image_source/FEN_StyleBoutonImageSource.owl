// Fenetre voisine pour test_style_bouton_image_source.
// Mode GUI reel (OuvreSoeur depuis le script test).
//
// BTN_StylePlat pose l'icone via BTN..Image (chemin deja couvert, )
// et sert d'oracle de rendu pixel : la meme icone au meme endroit doit
// produire la meme capture pixel.
// BTN_StyleImage pose la MEME icone via Style..Image..Image (nouvelle
// feuille, ) — c'est le sujet du test.
// BTN_Nu ne porte aucune icone, sert de contre-preuve (rendu different).

FEN_StyleBoutonImageSource est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 300
		Hauteur     = 180
		Titre       = "Style bouton image source"
		CouleurFond = RVB(15, 15, 15)
	FIN

	BTN_StylePlat est un Champ Bouton
		PROPRIETES
			X       = 20
			Y       = 20
			Largeur = 96
			Hauteur = 96
			Image   = icones.add
		FIN
	FIN

	BTN_StyleImage est un Champ Bouton
		PROPRIETES
			X                   = 130
			Y                   = 20
			Largeur             = 96
			Hauteur             = 96
			Style..Image..Image = icones.add
		FIN
	FIN

	BTN_Nu est un Champ Bouton
		PROPRIETES
			X       = 20
			Y       = 130
			Largeur = 96
			Hauteur = 96
		FIN
	FIN

	PROCEDURE CaptureStylePlat()
		RENVOYER dCopieImageChamp(BTN_StylePlat)
	FIN

	PROCEDURE CaptureStyleImage()
		RENVOYER dCopieImageChamp(BTN_StyleImage)
	FIN

	PROCEDURE CaptureNu()
		RENVOYER dCopieImageChamp(BTN_Nu)
	FIN

FIN
