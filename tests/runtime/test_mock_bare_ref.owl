Trace("=== MOCK bare function reference ===")

// Form 1: legacy string
m1 est un MockNative = MockCrée("Trace")
dbgVérifieVrai(m1 <> Null, "MockCrée(""Trace"") works")

// Form 2: bare function reference — compile-time checked
m2 est un MockNative = MockCrée(Trace)
dbgVérifieVrai(m2 <> Null, "MockCrée(Trace) bare ref works")

// Both must produce equivalent mocks (same underlying native)
MockQuand(m2)
MockAvec(m2, MockTout)
MockRetourne(m2, Null)
MockActive(m2)
Trace("should-not-print-A")
MockDésactive(m2)
MockVerifyCount(m2, 1)

// HTTP with bare ref
mockHTTP est un MockNative = MockCrée(HTTPEnvoie)
dbgVérifieVrai(mockHTTP <> Null, "MockCrée(HTTPEnvoie) bare ref works")

dbgBilanTest()
