// Fenêtre voisine — ressource pour test_table_ajoute_ligne_indice.owl.
// Table à deux colonnes pour vérifier l'indice retourné par TableAjouteLigne.

FEN_AjoutIndice est une Fenêtre
	PROPRIETES
		Titre       = "Indice ligne ajoutée"
		Disposition = dispLibre
	FIN

	TAB_Data est un Champ Table
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 400
			Hauteur = 300
		FIN

		COL_A est une Colonne
			PROPRIETES
				Libellé = "A"
				Type    = colTypeTexte
				Largeur = 150
			FIN
		FIN

		COL_B est une Colonne
			PROPRIETES
				Libellé = "B"
				Type    = colTypeTexte
				Largeur = 150
			FIN
		FIN
	FIN
FIN
