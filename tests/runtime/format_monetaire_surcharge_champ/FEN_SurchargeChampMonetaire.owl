// Fenêtre voisine — ressource pour test_format_monetaire_surcharge_champ.owl.
// Champ Monétaire avec son PROPRE `FormatMonétaire` inline (symbole "$"),
// alors que le projet voisin déclare un `FormatMonétaire` à symbole "€" : le
// format du champ doit gagner.

FEN_SurchargeChampMonetaire est une Fenêtre
	PROPRIETES
		Titre       = "FormatMonétaire surcharge champ"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 120
	FIN

	SAI_Montant est un Champ Saisie
		PROPRIETES
			X               = 10
			Y               = 10
			Largeur         = 180
			Hauteur         = 24
			TypeSaisie      = typSaisieMonétaire
			FormatMonétaire = {Symbole = "$", SéparateurMilliers = " ", ChiffresAprèsVirgule = 2}
			Valeur          = ""
		FIN
	FIN
FIN
