// Fenêtre voisine — ressource pour test_format_monetaire_projet_defaut.owl.
// Champ Monétaire sans FormatMonétaire propre, sous un projet qui ne pose pas
// FormatMonétaire non plus : doit suivre le défaut plat actuel
// (non-régression).

FEN_ProjetFormatMonetaireDefaut est une Fenêtre
	PROPRIETES
		Titre       = "Projet sans FormatMonétaire - défaut"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 120
	FIN

	SAI_Montant est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 10
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieMonétaire
			Valeur     = ""
		FIN
	FIN
FIN
