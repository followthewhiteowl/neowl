//  — un Champ Onglet stylé (cadre du volet) mais sans aucune couleur
// de volet posée ne doit pas rendre ses languettes en noir plein.
//
// ONG_PaneSeul  : un style de cadre de volet (Arrondi + Epaisseur) est posé,
//                 mais aucune couleur de volet (VoletActif/VoletInactif) ne
//                 l'est. C'est le cas qui régresse : le fond de la bande de
//                 languettes bascule en noir plein, texte illisible.
// ONG_VoletColo : même style de cadre de volet, PLUS des couleurs de volet
//                 posées. Doit rester correctement rendu (non-régression).
//
// Les deux champs partagent les mêmes libellés de volet ("Profil"/"Options")
// pour que la largeur des languettes soit comparable entre les deux captures.

FEN_OngletLanguetteNonColoree est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 520
		Hauteur     = 400
		Titre       = "Languette d'onglet non colorée"
		CouleurFond = RVB(0, 200, 0)
	FIN

	ONG_PaneSeul est un Champ Onglet
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 480
			Hauteur = 160
			Valeur  = 1

			Style..CadreExtérieur..CouleurFond      = Blanc
			Style..CadreExtérieur..Cadre..Couleur   = Vert
			Style..CadreExtérieur..Cadre..Epaisseur = 2
		FIN

		VOL_PaneSeulUn est un Volet
			PROPRIETES
				Libellé     = "Profil"
				Disposition = dispLibre
			FIN
		FIN

		VOL_PaneSeulDeux est un Volet
			PROPRIETES
				Libellé     = "Options"
				Disposition = dispLibre
			FIN
		FIN
	FIN

	ONG_VoletColo est un Champ Onglet
		PROPRIETES
			X       = 10
			Y       = 210
			Largeur = 480
			Hauteur = 160
			Valeur  = 1

			Style..CadreExtérieur..CouleurFond      = Blanc
			Style..CadreExtérieur..Cadre..Couleur   = Vert
			Style..CadreExtérieur..Cadre..Epaisseur = 2

			Style..VoletActif..CouleurFond   = Rouge
			Style..VoletActif..Couleur       = Noir
			Style..VoletInactif..CouleurFond = Bleu
			Style..VoletInactif..Couleur     = Blanc
		FIN

		VOL_VoletColoUn est un Volet
			PROPRIETES
				Libellé     = "Profil"
				Disposition = dispLibre
			FIN
		FIN

		VOL_VoletColoDeux est un Volet
			PROPRIETES
				Libellé     = "Options"
				Disposition = dispLibre
			FIN
		FIN
	FIN
FIN
