// Ressource fenêtre — voisine de test_table_colonne_graphie_croisee.owl.
// Une colonne au nom accentué (COL_Clé) et une au nom nu (COL_Nom), pour
// vérifier que chacune est atteignable dans les deux graphies.

FEN_ColGraphie est une Fenêtre
	PROPRIETES
		Titre       = "Colonne, graphies croisées"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 300
	FIN

	TBL_G est un Champ Table
		PROPRIETES
			X       = 5
			Y       = 5
			Largeur = 300
			Hauteur = 200
		FIN

		COL_Clé est une Colonne
			PROPRIETES
				Libellé = "Clé"
				Type    = colTypeTexte
				Largeur = 80
			FIN
		FIN

		COL_Nom est une Colonne
			PROPRIETES
				Libellé = "Nom"
				Type    = colTypeTexte
				Largeur = 80
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		TableAjouteLigne(TBL_G, "valeurClé", "valeurNom")
	FIN

	// Forme ligne d'abord : TBL[ligne].COLONNE
	PROCEDURE LigneAccentAccent()
		RENVOYER TBL_G[1].COL_Clé
	FIN

	PROCEDURE LigneAccentNu()
		RENVOYER TBL_G[1].COL_Cle
	FIN

	PROCEDURE LigneNuNu()
		RENVOYER TBL_G[1].COL_Nom
	FIN

	PROCEDURE LigneNuAccent()
		RENVOYER TBL_G[1].COL_Nóm
	FIN

	// Forme colonne d'abord : TBL.COLONNE[ligne]
	PROCEDURE ColAccentAccent()
		RENVOYER TBL_G.COL_Clé[1]
	FIN

	PROCEDURE ColAccentNu()
		RENVOYER TBL_G.COL_Cle[1]
	FIN
FIN
