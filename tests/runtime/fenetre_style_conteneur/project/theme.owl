// Fichier de thème désigné par Projet..Thème. Deux styles de conteneur
// distincts pour vérifier la réaffectation (sémantique COPIE, ).
ThèmeFenetreStyle est un Thème
	fondFenêtre est un styleConteneur = {
		CadreExtérieur = { CouleurFond = Bleu }
	}
	fondFenêtreAlt est un styleConteneur = {
		CadreExtérieur = { CouleurFond = JauneClair }
	}
FIN
