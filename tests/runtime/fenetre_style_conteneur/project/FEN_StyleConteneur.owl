// Fenêtre support pour vérifier le Style thémable (styleConteneur) affecté
// via theme.X, ainsi que sa coexistence avec CouleurFond plat.
FEN_StyleConteneur est une Fenêtre
	PROPRIETES
		Titre       = "Fenêtre stylée via le thème"
		Largeur     = 480
		Hauteur     = 320
		CouleurFond = Rouge
		Style       = theme.fondFenêtre
	FIN
FIN
