// Fenêtre voisine — ressource pour test_table_colonne_receveur_masquesaisie.owl.
// (pattern split canon strict — cf.  / .)
//
//  Path B — la forme nue `COL_A..MasqueSaisie` devient un VRAI receveur
// au runtime (stockage sur la colonne), au même titre que `COL_A..Couleur`
//.  amendé : le récepteur colonne n'est plus « couleur
// seule » mais « props à canon documenté + chemin d'application Qt » — le
// masque de saisie a désormais un chemin d'application (createEditor du
// delegate colonne, Path A).

FEN_ColonneReceveurMasqueSaisie est une Fenêtre
	PROPRIETES
		Titre = "Colonne receveur masque de saisie"
	FIN

	TABLE_Receveur est un Champ Table
		PROPRIETES
		FIN

		COL_Code est une Colonne
			PROPRIETES
				Libellé = "Code"
				Type    = colTypeTexte
				Largeur = 100
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		TableAjouteLigne(TABLE_Receveur, "")
	FIN

	// Écriture forme nue, propriété FR.
	PROCEDURE EcritMasqueSaisie(m est une chaîne)
		COL_Code..MasqueSaisie = m
	FIN

	// Lecture forme nue, propriété FR.
	PROCEDURE LireMasqueSaisie()
		RENVOYER COL_Code..MasqueSaisie
	FIN

	// Lecture forme nue, propriété EN (bilingue, Règle 6.3).
	PROCEDURE LireMasqueSaisieEN()
		RENVOYER COL_Code..InputMask
	FIN

	// Écriture via la propriété EN, relue en FR (parité bilingue croisée).
	PROCEDURE EcritMasqueSaisieEN(m est une chaîne)
		COL_Code..InputMask = m
	FIN
FIN
