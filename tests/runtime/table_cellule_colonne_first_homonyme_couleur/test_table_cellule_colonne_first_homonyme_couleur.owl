// Une Table qui déclare une colonne littéralement nommée 'Couleur', adressée
// en colonne-first : au niveau valeur, la colonne 'Couleur' garde la
// priorité ; au niveau cellule, la mise en forme reste fonctionnelle.

TestModeHeadless(Vrai)

Ouvre(FEN_ColFirstHomonyme)

dbgVérifieEgalité(LireValeurColFirst(1), "rouge-fonce",
"colonne-first, valeur : la colonne 'Couleur' est lue, pas une mise en forme")

EcritMiseEnFormeColFirst(1, 555)
dbgVérifieEgalité(LireMiseEnFormeColFirst(1), 555,
"colonne-first, mise en forme : fonctionne malgré l'homonymie")

dbgVérifieEgalité(LireValeurColFirst(1), "rouge-fonce",
"colonne-first, valeur : inchangée après l'écriture de la mise en forme")

Ferme(FEN_ColFirstHomonyme)

dbgBilanTest()
