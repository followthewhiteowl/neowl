// Ressource fenêtre — voisine de test_table_cellule_colonne_first_homonyme_couleur.owl.
// Une Table qui déclare une colonne littéralement nommée 'Couleur', adressée
// en colonne-first : la VALEUR de la colonne garde la priorité tant qu'aucune
// propriété n'est demandée, et la mise en forme fonctionne quand même.

FEN_ColFirstHomonyme est une Fenêtre
	PROPRIETES
		Titre       = "Colonne-first, colonne nommée Couleur"
		Disposition = dispVerticale
		Largeur     = 400
		Hauteur     = 300
	FIN

	TABLE_Homonyme est un Champ Table
		PROPRIETES
			Étire = Vrai
		FIN

		Couleur est une Colonne
			PROPRIETES
				Libellé = "Couleur"
				Type    = colTypeTexte
				Largeur = 100
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		TableAjouteLigne(TABLE_Homonyme, "rouge-fonce")
	FIN

	PROCEDURE LireValeurColFirst(ligne est un entier)
		RENVOYER TABLE_Homonyme.Couleur[ligne]
	FIN

	PROCEDURE EcritMiseEnFormeColFirst(ligne est un entier, v est un entier)
		TABLE_Homonyme.Couleur[ligne]..Couleur = v
	FIN

	PROCEDURE LireMiseEnFormeColFirst(ligne est un entier)
		RENVOYER TABLE_Homonyme.Couleur[ligne]..Couleur
	FIN
FIN
