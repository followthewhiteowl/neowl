// Fenêtre voisine — ressource pour
// test_table_colonne_masque_affichage_roundtrip.owl. Une seule
// colonne Date portant MasqueAffichage à la déclaration.

FEN_TableColonneMasqueAffichageRoundtrip est une Fenêtre
	PROPRIETES
		Titre = "Colonne — masque d'affichage, lecture via accesseur"
	FIN

	TAB_ColRoundtrip est un Champ Table
		PROPRIETES
		FIN

		COL_Date est une Colonne
			PROPRIETES
				Libellé         = "Date"
				Type            = colTypeDate
				Largeur         = 140
				MasqueAffichage = "AAAA-MM-JJ"
			FIN
		FIN
	FIN
FIN
