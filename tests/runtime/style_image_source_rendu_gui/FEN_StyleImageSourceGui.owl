//  — la source de l'image (IMG..Image, top-level, patron Bouton
// ) et le Style (IMG..Style..CadreExtérieur, la boîte) coexistent
// sur le même Champ Image sans se marcher dessus. Rendu GUI réel (widgets
// Qt montés, offscreen) pour prouver que l'icône est bien rasterisée en
// même temps que le cadre stylé est appliqué au widget.
FEN_StyleImageSourceGui est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 300
		Hauteur     = 180
		Titre       = "Style Image — source + cadre"
		CouleurFond = RVB(15, 15, 15)
	FIN

	IMG_AvecIconeEtCadre est un Champ Image
		PROPRIETES
			X                                       = 20
			Y                                       = 20
			Largeur                                 = 96
			Hauteur                                 = 96
			Image                                   = icones.add
			Style..CadreExtérieur..Cadre..Couleur   = RVB(0, 128, 255)
			Style..CadreExtérieur..Cadre..Epaisseur = 4
		FIN
	FIN

	IMG_SansIcone est un Champ Image
		PROPRIETES
			X                                       = 160
			Y                                       = 20
			Largeur                                 = 96
			Hauteur                                 = 96
			Style..CadreExtérieur..Cadre..Couleur   = RVB(0, 128, 255)
			Style..CadreExtérieur..Cadre..Epaisseur = 4
		FIN
	FIN

	PROCEDURE CaptureAvecIcone()
		RENVOYER dCopieImageChamp(IMG_AvecIconeEtCadre)
	FIN

	PROCEDURE CaptureSansIcone()
		RENVOYER dCopieImageChamp(IMG_SansIcone)
	FIN

FIN
