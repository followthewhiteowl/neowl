//  — fenêtre support pour le round-trip Style typé du Champ Image.
FEN_ImageStyle est une Fenêtre
	PROPRIETES
		Titre       = "Image stylée"
		Largeur     = 400
		Hauteur     = 160
		Disposition = dispLibre
	FIN

	IMG_Style est un Champ Image
		PROPRIETES
			X       = 20
			Y       = 20
			Largeur = 300
			Hauteur = 100
		FIN
	FIN
FIN
