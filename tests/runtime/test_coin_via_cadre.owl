// Verifie que les sous-objets Coin/Trait restent accessibles via leur
// parent Cadre, independamment du fait qu'ils soient maintenant aussi
// declarables standalone. Pas de regression sur le routage parent → enfant.

ca est un Cadre
ca..CoinHautGauche..Largeur = 5
ca..CoinHautDroite..Hauteur = 6
ca..CoinBasGauche..Largeur  = 7
ca..CoinBasDroite..Hauteur  = 8

dbgVérifieEgalité(ca..CoinHautGauche..Largeur, 5, "Cadre..CoinHautGauche..Largeur")
dbgVérifieEgalité(ca..CoinHautDroite..Hauteur, 6, "Cadre..CoinHautDroite..Hauteur")
dbgVérifieEgalité(ca..CoinBasGauche..Largeur, 7, "Cadre..CoinBasGauche..Largeur")
dbgVérifieEgalité(ca..CoinBasDroite..Hauteur, 8, "Cadre..CoinBasDroite..Hauteur")

// Sous-objets Trait par bord
ca..TraitHaut..Epaisseur = 2
ca..TraitBas..Couleur    = 255
ca..TraitGauche..Type    = TraitPointillé

dbgVérifieEgalité(ca..TraitHaut..Epaisseur, 2, "Cadre..TraitHaut..Epaisseur")
dbgVérifieEgalité(ca..TraitBas..Couleur, 255, "Cadre..TraitBas..Couleur")
dbgVérifieEgalité(ca..TraitGauche..Type, TraitPointillé, "Cadre..TraitGauche..Type")

dbgBilanTest()
