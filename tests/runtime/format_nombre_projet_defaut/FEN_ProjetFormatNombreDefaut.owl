// Fenêtre voisine — ressource pour test_format_nombre_projet_defaut.owl.
// Champ Numérique sans FormatNombre propre, sous un projet qui ne pose pas
// FormatNombre non plus : doit suivre le défaut plat actuel (non-régression).

FEN_ProjetFormatNombreDefaut est une Fenêtre
	PROPRIETES
		Titre       = "Projet sans FormatNombre - défaut"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 120
	FIN

	SAI_Num est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 10
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieNum
			Valeur     = ""
		FIN
	FIN
FIN
