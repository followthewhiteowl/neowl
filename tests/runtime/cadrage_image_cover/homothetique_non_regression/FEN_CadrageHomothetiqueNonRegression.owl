//  — non-régression : cadrage homothétique doit continuer à
// letterboxer (bandes), distinct du cadrage cover introduit par ce ticket.
// Image large (499x116) dans un champ haut (200x300) : l'image se cale sur
// la largeur, des bandes subsistent en haut et en bas.
FEN_CadrageHomothetiqueNonRegression est une Fenêtre
	PROPRIETES
		Titre       = "Champ Image — cadrage homothétique"
		Largeur     = 400
		Hauteur     = 340
		Disposition = dispLibre
		CouleurFond = RVB(10, 10, 10)
	FIN

	IMG_Cible est un Champ Image
		PROPRIETES
			X                                  = 20
			Y                                  = 20
			Largeur                            = 200
			Hauteur                            = 300
			Cadrage                            = cadHomothetique
			Style..CadreExtérieur..CouleurFond = RVB(255, 0, 255)
			Image                              = fRepTemp() + fSep() + "owl_test_2502_champ_image_homothetique.webp"
		FIN
	FIN
FIN
