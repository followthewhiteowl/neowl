//  — Champ Image, cadrage cover : l'image remplit tout le champ en
// préservant son ratio, le débord est rogné. Image large (499x116) dans un
// champ haut (200x300) : aucune bande ne doit subsister.
//
// ROUGE attendu avant impl : `cadRempli` n'existe pas encore dans l'enum
// cadrage — le fichier ne compile pas.
FEN_CadrageCoverChampImage est une Fenêtre
	PROPRIETES
		Titre       = "Champ Image — cadrage cover"
		Largeur     = 400
		Hauteur     = 340
		Disposition = dispLibre
		CouleurFond = RVB(10, 10, 10)
	FIN

	IMG_Cible est un Champ Image
		PROPRIETES
			X                                  = 20
			Y                                  = 20
			Largeur                            = 200
			Hauteur                            = 300
			Cadrage                            = cadRempli
			Style..CadreExtérieur..CouleurFond = RVB(255, 0, 255)
			Image                              = fRepTemp() + fSep() + "owl_test_2502_champ_image_cover.webp"
		FIN
	FIN
FIN
