//  — Image de fond d'un conteneur, cadrage cover : l'image remplit
// tout le conteneur en préservant son ratio, le débord est rogné. Image large
// (499x116) dans un conteneur haut (200x300) : aucune bande ne doit subsister.
//
// ROUGE attendu avant impl : `cadRempli` n'existe pas encore dans l'enum
// cadrage — le fichier ne compile pas.
FEN_CadrageCoverImageFond est une Fenêtre
	PROPRIETES
		Titre       = "Image de fond — cadrage cover"
		Largeur     = 400
		Hauteur     = 340
		Disposition = dispLibre
		CouleurFond = RVB(10, 10, 10)
	FIN

	CNT_Cible est un Champ Conteneur
		PROPRIETES
			X                                         = 20
			Y                                         = 20
			Largeur                                   = 200
			Hauteur                                   = 300
			Disposition                               = dispLibre
			Style..CadreExtérieur..CouleurFond        = RVB(255, 0, 255)
			Style..CadreExtérieur..ImageFond..Source  = fRepTemp() + fSep() + "owl_test_2502_image_fond_cover.webp"
			Style..CadreExtérieur..ImageFond..Cadrage = cadRempli
		FIN
	FIN
FIN
