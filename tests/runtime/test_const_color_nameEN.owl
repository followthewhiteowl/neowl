// =============================================================================
// TEST : Resolution runtime EN->FR des CONSTANTES de la famille Couleur
// (, lot A7 - module stdlib_color).
//
// Verrouille le contrat bilingue : referencer une couleur predefinie par sa
// forme EN canon (nameEN pose dans le registre) resout vers EXACTEMENT la
// meme valeur entiere que la forme FR canon. La forme EN est un alias
// runtime-only (mirror de l'alias ASCII), pas une 2e entree registre.
//
// Couples couverts (FR canon -> nameEN -> valeur entiere) :
//   Argent        -> Silver       (= 12632256)
//   JauneOr       -> Gold         (= 55295)
//   GrisClair     -> LightGray    (= 12632256)
//   RougePastel   -> PastelRed    (= 10066431)
//   BleuClair     -> LightBlue    (= 16711680)
//
// Deux couches d'assertion par couple : EN == FR, ET EN == valeur exacte.
// =============================================================================

PROCEDURE scenario_const_color_en_resout_vers_fr()
	dbgVérifieEgalité(Silver, Argent,
	"Silver resout vers la meme valeur que Argent")
	dbgVérifieEgalité(Silver, 12632256,
	"Silver vaut exactement 12632256 (#C0C0C0)")

	dbgVérifieEgalité(Gold, JauneOr,
	"Gold resout vers la meme valeur que JauneOr")
	dbgVérifieEgalité(Gold, 55295,
	"Gold vaut exactement 55295 (#FFD700)")

	dbgVérifieEgalité(LightGray, GrisClair,
	"LightGray resout vers la meme valeur que GrisClair")
	dbgVérifieEgalité(LightGray, 12632256,
	"LightGray vaut exactement 12632256 (#C0C0C0)")

	dbgVérifieEgalité(PastelRed, RougePastel,
	"PastelRed resout vers la meme valeur que RougePastel")
	dbgVérifieEgalité(PastelRed, 10066431,
	"PastelRed vaut exactement 10066431 (#FF9999)")

	dbgVérifieEgalité(LightBlue, BleuClair,
	"LightBlue resout vers la meme valeur que BleuClair")
	dbgVérifieEgalité(LightBlue, 16711680,
	"LightBlue vaut exactement 16711680 (#0000FF)")
FIN
