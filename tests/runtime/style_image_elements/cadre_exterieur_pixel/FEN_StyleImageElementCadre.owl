//  — `Style..CadreExtérieur..*` sur un Champ Image autonome : le
// Champ Image est un widget mono-élément (QLabel), la boîte du
// CadreExtérieur est portée DIRECTEMENT par le widget (pas de wrapper
// conteneur séparé, patron ).
FEN_StyleImageElementCadre est une Fenêtre
	PROPRIETES
		Titre       = "Style Image — élément CadreExtérieur"
		Largeur     = 400
		Hauteur     = 120
		Disposition = dispLibre
		CouleurFond = RVB(10, 10, 10)
	FIN

	IMG_X est un Champ Image
		PROPRIETES
			X                                       = 20
			Y                                       = 20
			Largeur                                 = 300
			Hauteur                                 = 60
			Style..CadreExtérieur..CouleurFond      = RVB(200, 200, 0)
			Style..CadreExtérieur..Cadre..Couleur   = RVB(0, 128, 255)
			Style..CadreExtérieur..Cadre..Epaisseur = 5
		FIN
	FIN
FIN
