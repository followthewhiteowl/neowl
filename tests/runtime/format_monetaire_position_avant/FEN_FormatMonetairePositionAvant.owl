// Fenêtre voisine — ressource pour test_format_monetaire_position_avant.owl.
// Le champ pose un FormatMonétaire inline avec PositionSymbole = posAvant :
// le symbole "€" doit être affiché DEVANT le montant (ex. "€ 1 234,50"),
// contrairement au défaut posAprès.

FEN_FormatMonetairePositionAvant est une Fenêtre
	PROPRIETES
		Titre       = "FormatMonétaire position avant"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 120
	FIN

	SAI_Montant est un Champ Saisie
		PROPRIETES
			X               = 10
			Y               = 10
			Largeur         = 180
			Hauteur         = 24
			TypeSaisie      = typSaisieMonétaire
			FormatMonétaire = {Symbole = "€", PositionSymbole = posAvant, SéparateurMilliers = " ", SéparateurDécimal = ",", ChiffresAprèsVirgule = 2}
			Valeur          = ""
		FIN
	FIN
FIN
