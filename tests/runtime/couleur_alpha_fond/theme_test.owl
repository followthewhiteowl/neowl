// Fichier de thème désigné par Projet..Thème (couleur_alpha_fond).
//
// conteneurGlass = le chemin « glassmorphisme » qui compte :
// un CadreExtérieur..CouleurFond posé avec une INSTANCE Couleur (littéral
// { Rouge=…, Vert=…, Bleu=…, Opacité=… }) plutôt qu'un entier RVB nu, pour
// que le canal Opacité survive jusqu'au rendu via la cascade de Style.
ThèmeCouleurAlphaFond est un Thème
	blancTranslucide est une Couleur = {Rouge = 255, Vert = 255, Bleu = 255, Opacité = 128}

	conteneurGlass est un styleConteneur = {
		CadreExtérieur = {
			CouleurFond = blancTranslucide
		}
	}
FIN
