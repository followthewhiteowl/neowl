// Fenêtre voisine — ressource pour test_couleur_alpha_fond.owl.
//
// Fond de fenêtre ROUGE PUR opaque (RVB(255,0,0)), pour que tout mélange
// alpha posé par-dessus soit mesurable au pixel (canal Vert/Bleu = alpha
// exact, cf. calcul dans le test voisin).
//
// CNT_Glass : le chemin qui compte (cascade de Style via theme.X) — un
// Champ Conteneur stylé avec Style = theme.conteneurGlass, dont le
// CadreExtérieur..CouleurFond est une INSTANCE Couleur (Opacité=128).
//
// SAI_Direct : le chemin SET direct sur le contrôle (CouleurFond flat,
// pas de Style) — Champ Saisie muté au runtime par le test voisin, pour
// exercer les 3 formes (entier nu opaque / instance Couleur opaque /
// instance Couleur translucide) sur le MÊME contrôle.

FEN_CouleurAlphaFond est une Fenêtre
	PROPRIETES
		Titre       = "Couleur alpha fond"
		Largeur     = 400
		Hauteur     = 200
		Disposition = dispLibre
		CouleurFond = RVB(255, 0, 0)
	FIN

	CNT_Glass est un Champ Conteneur
		PROPRIETES
			X       = 20
			Y       = 20
			Largeur = 150
			Hauteur = 100
			Style   = theme.conteneurGlass
		FIN
	FIN

	SAI_Direct est un Champ Saisie
		PROPRIETES
			X       = 200
			Y       = 20
			Largeur = 150
			Hauteur = 40
		FIN
	FIN
FIN
