// PoliceCharge(chemin) : fichier absent / format invalide -> erreur runtime
// propre (pas de crash), famille renvoyée vide. Verrouillage du cas erreur.

// ============================================================================
// Fichier absent
// ============================================================================
ErreurRAZ()
sFamilleAbsente est une chaîne = PoliceCharge("tests/runtime/police_charge_native/police_inexistante_12345.ttf")
dbgVérifieVrai(ErreurInfo() <> "", "fichier de police absent -> erreur levée")
dbgVérifieEgalité(sFamilleAbsente, "", "fichier de police absent -> famille vide renvoyée")

// ============================================================================
// Format invalide (fichier présent mais pas une police)
// ============================================================================
ErreurRAZ()
sFamilleInvalide est une chaîne = PoliceCharge("tests/runtime/police_charge_native/fixture_format_invalide.ttf")
dbgVérifieVrai(ErreurInfo() <> "", "fichier présent mais format invalide -> erreur levée")
dbgVérifieEgalité(sFamilleInvalide, "", "format invalide -> famille vide renvoyée")

dbgBilanTest()
