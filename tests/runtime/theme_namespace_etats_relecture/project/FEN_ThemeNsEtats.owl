// Support du troisième chemin de lecture : un style monté sur un champ.

FEN_ThemeNsEtats est une Fenêtre
	PROPRIETES
		Titre       = "Relecture d'états par le namespace du thème"
		Largeur     = 400
		Hauteur     = 160
		Disposition = dispLibre
	FIN

	SAI_NsEtats est un Champ Saisie
		PROPRIETES
			X       = 20
			Y       = 20
			Largeur = 300
			Hauteur = 30
		FIN
	FIN

	BTN_NsEtats est un Champ Bouton
		PROPRIETES
			X       = 20
			Y       = 70
			Largeur = 300
			Hauteur = 40
			Libellé = "Valider"
		FIN
	FIN
FIN
