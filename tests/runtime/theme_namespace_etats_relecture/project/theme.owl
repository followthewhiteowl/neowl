// Deux familles de style, chacune avec une propriété de base et des états
// portant une teinte distincte : la valeur relue désigne sans ambiguïté sa
// source (base ou état, et quel état).

ThèmeNsEtats est un Thème
	stNsSaisie est un styleSaisie = {
		ZoneSaisie = {
			CouleurFond = RVB(255, 255, 255)
			Etats       = {
				Survol = { CouleurFond = RVB(200, 10, 10) }
				Focus  = { CouleurFond = RVB(10, 200, 10) }
			}
		}
	}

	stNsBouton est un styleBouton = {
		CadreExtérieur = {
			CouleurFond = RVB(50, 50, 50)
			Etats       = {
				Survol = { CouleurFond = RVB(10, 10, 200) }
				Appuyé = { CouleurFond = RVB(0, 200, 0) }
			}
		}
	}
FIN
