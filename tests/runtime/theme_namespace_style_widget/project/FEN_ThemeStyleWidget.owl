// Fenêtre support pour vérifier l'affectation d'un style résolu via le
// namespace `theme.X` à un champ Bouton.
FEN_ThemeStyleWidget est une Fenêtre
	PROPRIETES
		Titre       = "Bouton stylé via le thème"
		Largeur     = 400
		Hauteur     = 160
		Disposition = dispLibre
	FIN

	BTN_Valider est un Champ Bouton
		PROPRIETES
			X       = 20
			Y       = 20
			Largeur = 300
			Hauteur = 40
			Libellé = "Valider"
		FIN
	FIN
FIN
