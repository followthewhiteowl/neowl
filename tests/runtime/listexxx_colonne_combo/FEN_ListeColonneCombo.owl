// Fenêtre voisine — ressource partagée de tests\runtime\listexxx_colonne_combo.
//
// Une colonne combo (COL_Ville) SANS liste déclarée (démarre vide, pour que
// ListeAjoute/ListeXxx soient la SEULE source de la liste dans les
// scénarios de ce dossier), sur une Table à 1 ligne, et un Champ Combo
// autonome (CMB_Autonome) pour le garde-fou de non-régression .

FEN_ListeColonneCombo est une Fenêtre
	PROPRIETES
		Titre       = "Liste colonne combo"
		Largeur     = 300
		Hauteur     = 220
		Disposition = dispLibre
	FIN

	TABLE_Villes est un Champ Table
		PROPRIETES
			Étire = Vrai
		FIN

		COL_Ville est une Colonne
			PROPRIETES
				Libellé = "Ville"
				Type    = colTypeCombo
				Largeur = 160
			FIN
		FIN
	FIN

	CMB_Autonome est un Champ Combo
		PROPRIETES
			X       = 10
			Y       = 170
			Largeur = 240
			Hauteur = 25
		FIN
	FIN

	PROCEDURE FinInitialisation()
		TableAjouteLigne(TABLE_Villes, "L1")
	FIN
FIN
