// Fenêtre voisine — jauges verticales avec texte, montées offscreen pour
// test_champ_jauge_texte_vertical.owl. Le rendu du texte pivoté n'est pas
// vérifiable en pixels (offscreen), on couvre ici le non-crash du paint et
// le round-trip des valeurs sur les deux chemins verticaux (linéaire + symétrique).

FEN_JaugeTexteVertical est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 300
		Hauteur     = 260
	FIN

	// Verticale linéaire avec texte personnalisé (chemin non-symétrique).
	JAU_TxtLin est un Champ Jauge
		PROPRIETES
			X          = 10
			Y          = 10
			Largeur    = 24
			Hauteur    = 200
			Vertical   = Vrai
			BorneMin   = 0
			BorneMax   = 10
			Valeur     = 7
			TexteJauge = "7 / 10"
		FIN
	FIN

	// Verticale symétrique avec texte (chemin custom paint).
	JAU_TxtSym est un Champ Jauge
		PROPRIETES
			X          = 60
			Y          = 10
			Largeur    = 24
			Hauteur    = 200
			Vertical   = Vrai
			Symétrique = Vrai
			BorneMin   = -50
			BorneMax   = 50
			Valeur     = 20
			TexteJauge = "+20"
		FIN
	FIN
FIN
