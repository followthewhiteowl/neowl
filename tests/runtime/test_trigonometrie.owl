// Test des fonctions trigonométriques canon de référence (degrés)

// Cosinus (utilise EgaliteRéel pour les valeurs proche-zéro qui font de
// l'epsilon flottant : Cos(90°) ≈ 6e-17 sur libc standard)
dbgVérifieEgalité(Cosinus(0), 1, "Cos(0°) = 1")
dbgVérifieÉgalitéRéel(Cosinus(90), 0, "Cos(90°) ≈ 0", 1e-10)
dbgVérifieEgalité(Cosinus(180),-1, "Cos(180°) = -1")
dbgVérifieEgalité(Cosinus(360), 1, "Cos(360°) = 1")

// Sinus
dbgVérifieEgalité(Sinus(0), 0, "Sin(0°) = 0")
dbgVérifieEgalité(Sinus(90), 1, "Sin(90°) = 1")
dbgVérifieÉgalitéRéel(Sinus(180), 0, "Sin(180°) ≈ 0", 1e-10)

// Tang
dbgVérifieEgalité(Tang(0), 0, "Tan(0°) = 0")
dbgVérifieÉgalitéRéel(Tang(45), 1, "Tan(45°) ≈ 1", 1e-10)

// Inverses
dbgVérifieEgalité(ArcCosinus(0), 90, "ArcCos(0) = 90°")
dbgVérifieEgalité(ArcCosinus(1), 0, "ArcCos(1) = 0°")
dbgVérifieEgalité(ArcSinus(0), 0, "ArcSin(0) = 0°")
dbgVérifieEgalité(ArcSinus(1), 90, "ArcSin(1) = 90°")
dbgVérifieEgalité(ArcTang(1), 45, "ArcTan(1) = 45°")
dbgVérifieEgalité(ArcTang(0), 0, "ArcTan(0) = 0°")

// ArcTang2 — 4 quadrants
dbgVérifieEgalité(ArcTang2(0, 1), 0, "ArcTang2(0, +x) = 0° (axe x positif)")
dbgVérifieEgalité(ArcTang2(1, 1), 45, "ArcTang2(1, 1) = 45°")
dbgVérifieEgalité(ArcTang2(1, 0), 90, "ArcTang2(+y, 0) = 90° (axe y positif)")

// Identité Pythagoricienne : sin² + cos² = 1
dbgVérifieÉgalitéRéel(Sinus(30) * Sinus(30) + Cosinus(30) * Cosinus(30),
1, "sin²(30°) + cos²(30°) = 1", 1e-10)
dbgVérifieÉgalitéRéel(Sinus(60) * Sinus(60) + Cosinus(60) * Cosinus(60),
1, "sin²(60°) + cos²(60°) = 1", 1e-10)

// Cohérence Tan = Sin/Cos
dbgVérifieÉgalitéRéel(Tang(30), Sinus(30) / Cosinus(30),
"Tan(30°) = Sin(30°) / Cos(30°)", 1e-10)

dbgBilanTest()
