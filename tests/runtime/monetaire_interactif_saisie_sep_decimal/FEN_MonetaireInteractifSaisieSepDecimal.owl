// Fenêtre voisine — champ Saisie monétaire configuré décimal "," / milliers
// "." (config type "8716716785454.55" du ticket , miroir monétaire)
// + champ voisin pour déclencher un focus-out réel via DonneFocus.

FEN_MonetaireInteractifSaisieSepDecimal est une Fenêtre
	PROPRIETES
		Titre       = "Monétaire interactif - saisie stricte décimal"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 160
	FIN

	SAI_Montant est un Champ Saisie
		PROPRIETES
			X               = 10
			Y               = 10
			Largeur         = 180
			Hauteur         = 24
			TypeSaisie      = typSaisieMonétaire
			FormatMonétaire = {SéparateurMilliers = ".", SéparateurDécimal = ",", ChiffresAprèsVirgule = 2}
			Valeur          = ""
		FIN
	FIN

	SAI_Autre est un Champ Saisie
		PROPRIETES
			X       = 10
			Y       = 50
			Largeur = 180
			Hauteur = 24
			Valeur  = ""
		FIN
	FIN
FIN
