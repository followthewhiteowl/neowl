//  — reproduction du shrink : un Champ Bouton STYLÉ (Style présent,
// même juste une CouleurFond de CadreExtérieur) rend plus court qu'un
// Bouton PLAT (aucune prop Style) déclarant la même Hauteur. Le seed d'une
// Police par défaut sur le chemin Style ne devrait pas changer la géométrie
// rendue du QPushButton vs le chemin plat.
FEN_StyleBoutonHauteurFigee est une Fenêtre
	PROPRIETES
		Titre       = "Style Bouton — Hauteur figée (anti-shrink)"
		Largeur     = 400
		Hauteur     = 200
		Disposition = dispLibre
		CouleurFond = RVB(10, 10, 10)
	FIN

	BTN_Plat est un Champ Bouton
		PROPRIETES
			X       = 20
			Y       = 20
			Largeur = 300
			Hauteur = 60
			Libellé = "Plat"
		FIN
	FIN

	BTN_Style est un Champ Bouton
		PROPRIETES
			X                                  = 20
			Y                                  = 100
			Largeur                            = 300
			Hauteur                            = 60
			Libellé                            = "Stylé"
			Style..CadreExtérieur..CouleurFond = RVB(0, 200, 0)
		FIN
	FIN
FIN
