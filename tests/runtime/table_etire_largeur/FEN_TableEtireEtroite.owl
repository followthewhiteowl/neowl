// Ressource — garde-fou : fenêtre ÉTROITE (300px), colonnes totalisant
// PLUS que la fenêtre (180+150+120 = 450px > 300px). Le scroll horizontal
// est légitime ici : la Table ne doit jamais dépasser la largeur de sa
// fenêtre, même Étire=Vrai. Verrouille qu'un futur fix n'invente pas une
// largeur de Table supérieure à celle de la fenêtre.
FEN_TableEtireEtroite est une Fenêtre
	PROPRIETES
		Titre   = "Table étirée — fenêtre étroite (scroll légitime)"
		Largeur = 300
		Hauteur = 300
	FIN

	TAB_EtireEtroite est un Champ Table
		PROPRIETES
			Étire = Vrai
		FIN

		COL_Nom est une Colonne
			PROPRIETES
				Libellé = "Nom"
				Type    = colTypeTexte
				Largeur = 180
			FIN
		FIN

		COL_Statut est une Colonne
			PROPRIETES
				Libellé = "Statut"
				Type    = colTypeTexte
				Largeur = 150
			FIN
		FIN

		COL_Priorite est une Colonne
			PROPRIETES
				Libellé = "Priorité"
				Type    = colTypeTexte
				Largeur = 120
			FIN
		FIN
	FIN
FIN
