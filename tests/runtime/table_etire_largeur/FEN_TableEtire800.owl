// Ressource — sœur de FEN_TableEtire520 : même Table Étire=Vrai, mêmes
// colonnes (180+150+120 = 450px), fenêtre plus large (800px). La largeur
// de la Table doit suivre celle de la fenêtre, donc être strictement
// supérieure à celle mesurée côté FEN_TableEtire520.
FEN_TableEtire800 est une Fenêtre
	PROPRIETES
		Titre   = "Table étirée — fenêtre 800"
		Largeur = 800
		Hauteur = 300
	FIN

	TAB_Etire800 est un Champ Table
		PROPRIETES
			Étire = Vrai
		FIN

		COL_Nom est une Colonne
			PROPRIETES
				Libellé = "Nom"
				Type    = colTypeTexte
				Largeur = 180
			FIN
		FIN

		COL_Statut est une Colonne
			PROPRIETES
				Libellé = "Statut"
				Type    = colTypeTexte
				Largeur = 150
			FIN
		FIN

		COL_Priorite est une Colonne
			PROPRIETES
				Libellé = "Priorité"
				Type    = colTypeTexte
				Largeur = 120
			FIN
		FIN
	FIN
FIN
