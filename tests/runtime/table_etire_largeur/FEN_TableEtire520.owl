// Ressource — Champ Table Étire=Vrai, 3 colonnes texte totalisant 450px
// (180+150+120), fenêtre 520px. Sœur de FEN_TableEtire800 (même Table,
// même colonnes, fenêtre plus large) : prouve que la largeur de la Table
// doit suivre celle de sa fenêtre, pas rester bloquée à une valeur fixe.
FEN_TableEtire520 est une Fenêtre
	PROPRIETES
		Titre   = "Table étirée — fenêtre 520"
		Largeur = 520
		Hauteur = 300
	FIN

	TAB_Etire520 est un Champ Table
		PROPRIETES
			Étire = Vrai
		FIN

		COL_Nom est une Colonne
			PROPRIETES
				Libellé = "Nom"
				Type    = colTypeTexte
				Largeur = 180
			FIN
		FIN

		COL_Statut est une Colonne
			PROPRIETES
				Libellé = "Statut"
				Type    = colTypeTexte
				Largeur = 150
			FIN
		FIN

		COL_Priorite est une Colonne
			PROPRIETES
				Libellé = "Priorité"
				Type    = colTypeTexte
				Largeur = 120
			FIN
		FIN
	FIN
FIN
