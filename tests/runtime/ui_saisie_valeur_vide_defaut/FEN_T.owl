// Fenêtre voisine — ressource pour test_saisie_valeur_vide_defaut.owl.
//
// Une Saisie texte jamais alimentée. On lit ..Valeur sans jamais y avoir
// écrit : le défaut doit être une vraie chaîne vide (typée), pas un Null
// déguisé qui afficherait vide mais échouerait au test `= ""`.

FEN_T est une Fenêtre
	PROPRIETES
		Titre       = "Saisie valeur vide"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 200
	FIN

	SAI_X est un Champ Saisie
		PROPRIETES
			X       = 50
			Y       = 50
			Largeur = 200
		FIN
	FIN
FIN
