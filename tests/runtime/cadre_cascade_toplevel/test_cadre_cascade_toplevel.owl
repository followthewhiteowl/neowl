// Cascade composee top-level ( deblocage runtime)
// Avant deblocage : crash "Only struct instances have fields" car getter Cadre
// retourne placeholder sans storage.
// Apres deblocage : getter retourne l'instance reelle depuis storage,
// round-trip valide.
//
// Pattern : la fenêtre voisine FEN_X.owl porte la déclaration.

// Cascade top-level : assign + read-back round-trip
// Modele C : monter la fenetre avant d'acceder aux champs.
Ouvre(FEN_X)

LIB_X..Cadre..Epaisseur = 3
dbgVérifieEgalité(LIB_X..Cadre..Epaisseur, 3, "round-trip Epaisseur")

LIB_X..Cadre..Couleur = RougeClair
dbgVérifieEgalité(LIB_X..Cadre..Couleur, RougeClair, "round-trip Couleur")

LIB_X..Cadre..Arrondi = 8
dbgVérifieEgalité(LIB_X..Cadre..Arrondi, 8, "round-trip Arrondi")

LIB_X..Cadre..Trait = TraitDouble
dbgVérifieEgalité(LIB_X..Cadre..Trait, TraitDouble, "round-trip Trait")

LIB_X..Cadre..Bords = BordHaut + BordBas
dbgVérifieEgalité(LIB_X..Cadre..Bords, BordHaut + BordBas, "round-trip Bords")

Ferme(FEN_X)

dbgBilanTest()
