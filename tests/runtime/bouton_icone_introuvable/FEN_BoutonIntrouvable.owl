// Fenêtre voisine pour test_bouton_icone_introuvable.
// Quatre boutons sur fond de fenêtre sombre :
//   BTN_FichierAbsent : Image = "inexistant.png"  (chemin disque introuvable)
//   BTN_CatInconnu    : Image = "icones.zorglub"   (référence catalogue inconnue)
//   BTN_Valide        : Image = icones.add         (référence catalogue valide)
//   BTN_Ref           : bouton nu (comparaison pixel non-régression)
// La construction exerce les deux branches défensives de la résolution
// d'icône (fichier / catalogue) : diagnostic stderr, pas d'icône, pas d'erreur.

FEN_BoutonIntrouvable est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 500
		Hauteur     = 200
		Titre       = "Bouton icône introuvable"
		CouleurFond = RVB(15, 15, 15)
	FIN

	BTN_FichierAbsent est un Champ Bouton
		PROPRIETES
			X       = 10
			Y       = 50
			Largeur = 96
			Hauteur = 96
			Image   = "inexistant.png"
		FIN
	FIN

	BTN_CatInconnu est un Champ Bouton
		PROPRIETES
			X       = 120
			Y       = 50
			Largeur = 96
			Hauteur = 96
			Image   = "icones.zorglub"
		FIN
	FIN

	BTN_Valide est un Champ Bouton
		PROPRIETES
			X       = 250
			Y       = 50
			Largeur = 96
			Hauteur = 96
			Image   = icones.add
		FIN
	FIN

	BTN_Ref est un Champ Bouton
		PROPRIETES
			X       = 380
			Y       = 50
			Largeur = 96
			Hauteur = 96
		FIN
	FIN

FIN
