// utils.owl - Collection de procedures utilitaires

PROCEDURE Saluer(sNom est une chaîne)
	Trace("Salut " + sNom)
FIN

PROCEDURE Additionner(nA est un entier, nB est un entier) : entier
	RENVOYER nA + nB
FIN

PROCEDURE Multiplier(nA est un entier, nB est un entier) : entier
	RENVOYER nA * nB
FIN
