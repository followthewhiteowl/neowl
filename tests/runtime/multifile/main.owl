// main.owl - Point d'entree du projet multi-fichiers

PROCEDURE Main()
	// Test 1: appel de procedures depuis utils.owl
	Saluer("Roger")

	// Test 2: fonctions avec retour depuis utils.owl
	nRes est un entier = Additionner(10, 32)
	dbgVérifieVrai(nRes = 42, "Additionner cross-file")

	nMul est un entier = Multiplier(6, 7)
	dbgVérifieVrai(nMul = 42, "Multiplier cross-file")

	// Test 3: classe depuis cPersonne.owl
	oP est un cPersonne("Roger", 1600)
	dbgVérifieVrai(oP.sNom = "Roger", "Cross-file class field sNom")
	dbgVérifieVrai(oP.nAge = 1600, "Cross-file class field nAge")
	oP.Presenter()

	// Test 4: variables globales du main accessibles
	dbgVérifieVrai(gProjet = "MultiTest", "Global variable from main")

	Trace("=== Multi-file tests: 5 passed ===")
FIN

// Variable globale du projet
gProjet est une chaîne = "MultiTest"
