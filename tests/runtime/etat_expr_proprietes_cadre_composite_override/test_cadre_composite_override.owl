// Mesure (, follow-up  — limite ) : une cascade
// impérative sur un SOUS-CHAMP de composite (LIB_X..Cadre..Couleur = Vert)
// doit rester sticky sur tous les rendus du bloc Corps, même quand la
// prop Cadre entière reste posée en EXPRESSION dynamique
// (Cadre = { Couleur = cVal, ... }) et que cVal change ENSUITE.
//
// La ressource ETAT_CadreCompositeOverride vit dans le voisin
// ETAT_CadreCompositeOverride.owl : Lecture() fait
//   cVal = Rouge ; LIB_X..Cadre..Couleur = Vert ; iImprimeBloc (R1)
//   cVal = Bleu ; iImprimeBloc (R2)
// puis le rendu automatique final du Corps (R3) a lieu après Lecture().
//
// Cible correcte : le bord (Cadre, opérateur de stroke) est Vert sur les
// 3 rendus — la cascade impérative écrase l'expression PROPRIETES.
//
// MESURE (avant impl) : le clobber est TOTAL, pas partiel — Vert
// n'apparaît JAMAIS sur le bord. R1 peint Rouge (cVal au moment de
// l'expression, l'override impératif qui le précède est déjà ignoré
// dès le 1er rendu) et R2/R3 peignent Bleu. Contrairement au cas
// scalaire (CouleurFond, ) où headless_override_keys protège
// au moins R1, l'écriture impérative sur le sous-champ composite
// (LIB_X..Cadre..Couleur =) n'a ici AUCUN effet observable : elle
// écrit sur l'ObjInstance du sous-champ, jamais consultée par la
// résolution PROPRIETES qui réévalue l'expression Cadre = {...} à
// chaque rendu.

TestModeHeadless(Vrai)

PROCEDURE TrouveMotif(buf est un buffer, motif est une chaîne, depart est un entier)
	nBuf est un entier = Taille(buf)
	motifBuf est un buffer = ChaîneVersBuffer(motif)
	nMotif est un entier = Taille(motifBuf)
	i est un entier = depart
	TANTQUE i <= nBuf - nMotif + 1
		bMatch est un booléen = Vrai
		k est un entier = 0
		TANTQUE k < nMotif ET bMatch
			SI BufferLitOctet(buf, i + k) <> BufferLitOctet(motifBuf, k + 1) ALORS
				bMatch = Faux
			FIN
			k = k + 1
		FIN
		SI bMatch ALORS
			RENVOYER i
		FIN
		i = i + 1
	FIN
	RENVOYER 0
FIN

// Extrait et décompresse le 1er flux de contenu (celui référencé par
// /Contents) du PDF produit. Recherche purement en domaine Buffer
// (BufferLitOctet) pour ne jamais tronquer sur un octet nul du flux
// compressé.
PROCEDURE StreamContenuPDF(chemin est une chaîne)
	buf est un buffer = fChargeBuffer(chemin)
	posContents est un entier = TrouveMotif(buf, "/Contents ", 1)
	i est un entier = posContents + Taille(ChaîneVersBuffer("/Contents "))
	nObj est un entier = 0
	TANTQUE BufferLitOctet(buf, i) >= 48 ET BufferLitOctet(buf, i) <= 57
		nObj = nObj * 10 + (BufferLitOctet(buf, i) - 48)
		i    = i + 1
	FIN
	sMotifObj est une chaîne = "" + nObj + " 0 obj"
	posObj est un entier = TrouveMotif(buf, sMotifObj, 1)
	posStream est un entier = TrouveMotif(buf, "stream", posObj)
	dataStart est un entier = posStream + 6
	SI BufferLitOctet(buf, dataStart) = 13 ALORS
		dataStart = dataStart + 1
	FIN
	SI BufferLitOctet(buf, dataStart) = 10 ALORS
		dataStart = dataStart + 1
	FIN
	posEndstream est un entier = TrouveMotif(buf, "endstream", dataStart)
	nSegTaille est un entier = posEndstream - dataStart
	seg est un buffer = BufferVide(nSegTaille)
	j est un entier = 1
	TANTQUE j <= nSegTaille
		BufferÉcritOctet(seg, j, BufferLitOctet(buf, dataStart + j - 1))
		j = j + 1
	FIN
	decomp est un buffer = Décompresse(seg)
	RENVOYER BufferVersChaîne(decomp, encLatin1)
FIN

iDestination(iPDFGénérique, "tests/runtime/etat_expr_proprietes_cadre_composite_override/temp.pdf")
iImprimeEtat(ETAT_CadreCompositeOverride)
iFinImprime()

sContenu est une chaîne = StreamContenuPDF("tests/runtime/etat_expr_proprietes_cadre_composite_override/temp.pdf")

// Bord (Cadre = stroke) : opérateur "SCN" MAJUSCULE précédé de "CS"
// (stroking colour space + colour, motif "<r> <g> <b> SCN"). Le fond
// (CouleurFond = fill) utilise "scn" minuscule — pas notre sujet ici,
// on ne compte QUE le stroke pour ne pas confondre bord et fond.
nRougeBord est un entier = Occurrence(sContenu, "1 0 0 SCN")
nVertBord est un entier = Occurrence(sContenu, "0 1 0 SCN")
nBleuBord est un entier = Occurrence(sContenu, "0 0 1 SCN")

dbgVérifieVrai(nVertBord >= 1,
"la cascade impérative LIB_X..Cadre..Couleur = Vert doit apparaître au moins une fois sur le bord")
dbgVérifieVrai(nRougeBord = 0,
"le bord ne doit JAMAIS peindre Rouge : la cascade impérative Vert doit gagner sur la valeur initiale de cVal résolue par l'expression PROPRIETES")
dbgVérifieVrai(nBleuBord = 0,
"le bord ne doit JAMAIS repasser Bleu : l'expression PROPRIETES (Cadre = {Couleur = cVal}) ne doit pas clobber la cascade impérative sur le sous-champ")

dbgBilanTest()
