//  — variante bilingue : la forme EN Color(...) du littéral couleur
// est acceptée dans la propriété Style d'un MenuPrincipal au même titre que Couleur(...).

FEN_MenuCouleurLitteraleEN est une Fenêtre
	PROPRIETES
		Titre         = "Menu custom colors"
		Largeur       = 500
		Hauteur       = 300
		Disposition   = dispLibre
		MenuPrincipal = MNU_CustomEN
	FIN

	MNU_CustomEN est un MenuPrincipal
		PROPRIETES
			Style..Submenu..BackgroundColor = Color(50, 60, 70)
			Style..Submenu..BorderColor     = Color(80, 90, 100, 120)
		FIN

		SM_Fichier est un SousMenu
			PROPRIETES
				Libellé = "&File"
			FIN

			OPT_Quitter est une OptionMenu
				PROPRIETES
					Libellé = "&Quit"
				FIN
			FIN
		FIN
	FIN
FIN
