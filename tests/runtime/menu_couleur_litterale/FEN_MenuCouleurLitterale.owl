//  — propriété Style d'un MenuPrincipal avec des littéraux Couleur(...)
// const-foldés (teintes custom, alpha optionnel), en plus des couleurs nommées.
// Fenêtre voisine ouverte en OuvreSoeur par le test QSS (widgets Qt réels).

FEN_MenuCouleurLitterale est une Fenêtre
	PROPRIETES
		Titre         = "Menu couleurs custom"
		Largeur       = 500
		Hauteur       = 300
		Disposition   = dispLibre
		MenuPrincipal = MNU_Custom
	FIN

	MNU_Custom est un MenuPrincipal
		PROPRIETES
			Style..Barre..CouleurFond = Couleur(10, 20, 30)
			Style..Barre..Couleur     = Couleur(245, 245, 245)

			Style..SousMenu..CouleurFond    = Couleur(30, 30, 40, 180)
			Style..SousMenu..CouleurBordure = Couleur(200, 100, 50)

			Style..OptionMenu..Couleur = Couleur(240, 240, 240)
		FIN

		SM_Fichier est un SousMenu
			PROPRIETES
				Libellé = "&Fichier"
			FIN

			OPT_Quitter est une OptionMenu
				PROPRIETES
					Libellé = "&Quitter"
				FIN
			FIN
		FIN
	FIN
FIN
