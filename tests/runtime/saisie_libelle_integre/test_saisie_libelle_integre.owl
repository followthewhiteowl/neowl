//  Phase 1 — Libellé intégré + LargeurLibellé sur champ Saisie (headless).
//
// ROUGE ATTENDU : Libellé et LargeurLibellé ne sont pas encore dans PROPS_INPUT
// (src/ui_catalog.c:339). Le compilateur émet :
//   Propriété 'Libellé' inconnue pour Saisie.
//   Propriété 'LargeurLibellé' inconnue pour Saisie.
// Bonne raison : prop inconnue au compile-time (et dans FEN voisine).
//
// Couverture :
//   - Défauts : Libellé vide (""), LargeurLibellé = 0 (INT non initialisé)
//   - DSL littéral dans PROPRIETES : relu correctement après Ouvre
//   - Set/get runtime headless via store virtuel
//   - Formes EN bilingues : Caption ↔ Libellé, LabelWidth ↔ LargeurLibellé
//   - Cohérence alias : set FR → get EN et set EN → get FR
//
// Note défaut LargeurLibellé : 0 retenu comme oracle (INT store non initialisé).
// Si l'implémenteur choisit un défaut différent (ex : -1 = auto), ajuster l'oracle.

Ouvre(FEN_SaisieLibelleIntegre)

// --- Défauts (SAI_Vide : aucun Libellé/LargeurLibellé dans PROPRIETES) ---
dbgVérifieEgalité(SAI_Vide..Libellé, "", "Libellé intégré : défaut = chaîne vide")
dbgVérifieEgalité(SAI_Vide..Caption, "", "Caption (EN) : défaut = chaîne vide")
dbgVérifieEgalité(SAI_Vide..LargeurLibellé, 0, "LargeurLibellé : défaut = 0 (INT store non initialisé)")
dbgVérifieEgalité(SAI_Vide..LabelWidth, 0, "LabelWidth (EN) : défaut = 0")

// --- DSL littéral : valeurs relues depuis PROPRIETES après Ouvre ---
dbgVérifieEgalité(SAI_Avec..Libellé, "Nom :", "DSL littéral Libellé vaut Nom : relu après Ouvre")
dbgVérifieEgalité(SAI_Avec..Caption, "Nom :", "Caption (EN) lit la même prop que Libellé")
dbgVérifieEgalité(SAI_Avec..LargeurLibellé, 80, "DSL LargeurLibellé = 80 relu après Ouvre")
dbgVérifieEgalité(SAI_Avec..LabelWidth, 80, "LabelWidth (EN) lit la même prop que LargeurLibellé")

// --- Set/get runtime : Libellé (FR) ---
SAI_Avec..Libellé = "Prénom :"
dbgVérifieEgalité(SAI_Avec..Libellé, "Prénom :", "Libellé setter/getter headless")

// --- Alias EN Caption → lecture FR ---
SAI_Avec..Caption = "Last name:"
dbgVérifieEgalité(SAI_Avec..Caption, "Last name:", "Caption setter/getter headless")
dbgVérifieEgalité(SAI_Avec..Libellé, "Last name:", "set Caption → get Libellé : alias cohérent")

// --- Set/get runtime : LargeurLibellé (FR) ---
SAI_Avec..LargeurLibellé = 120
dbgVérifieEgalité(SAI_Avec..LargeurLibellé, 120, "LargeurLibellé setter/getter headless")

// --- Alias EN LabelWidth → lecture FR ---
SAI_Avec..LabelWidth = 100
dbgVérifieEgalité(SAI_Avec..LabelWidth, 100, "LabelWidth setter/getter headless")
dbgVérifieEgalité(SAI_Avec..LargeurLibellé, 100, "set LabelWidth → get LargeurLibellé : alias cohérent")

// --- Libellé réinitialisé à vide ---
SAI_Avec..Libellé = ""
dbgVérifieEgalité(SAI_Avec..Libellé, "", "Libellé réinitialisé à chaîne vide")

Ferme(FEN_SaisieLibelleIntegre)
dbgBilanTest()
