// Classe qui implemente iAffichable.

cProduit est une Classe
	implemente iAffichable
PUBLIC
	sNom est une chaîne
	rPrix est un réel

	PROCEDURE Constructeur(sNom est une chaîne, rPrix est un réel)
		:sNom = sNom
		:rPrix = rPrix
	FIN

	PROCEDURE Afficher()
		Trace(:sNom + " : " + :rPrix)
	FIN
FIN
