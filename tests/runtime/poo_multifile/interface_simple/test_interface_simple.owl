// Test conformite interface simple (iAffichable / cProduit).

PROCEDURE scenario_interface_simple_conforme()
	oProd est un cProduit("Widget", 9.99)
	oProd.Afficher()
	dbgVérifieEgalité(oProd.sNom, "Widget", "Interface conforme : membre accessible")
	dbgVérifieVrai(Vrai, "Interface simple implementee correctement")
FIN
