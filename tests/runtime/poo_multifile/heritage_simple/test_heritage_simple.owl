// @sujet heritage cross-file basique
// @résumé validation convention poo_multifile/<scenario>/ : cChat herite cAnimal multi-file

PROCEDURE scenario_heritage_basique()
	// Instanciation via constructeur enfant
	oChat est un cChat("Felix", Vrai)

	// Acces membre herite (sNom vient de cAnimal)
	dbgVérifieEgalité(oChat.sNom, "Felix", "Membre herite accessible")

	// Acces membre propre
	dbgVérifieEgalité(oChat.bInterieur, Vrai, "Membre propre accessible")

	// Surcharge methode : cChat.Presenter() doit executer version enfant
	oChat.Presenter()
	// (pas d'assertion sur Trace — juste verifier que ca execute sans runtime error)
FIN

PROCEDURE scenario_second_instance()
	// Valider independance instances
	oChat1 est un cChat("Moustache", Vrai)
	oChat2 est un cChat("Tigre", Faux)

	dbgVérifieDifférence(oChat1.sNom, oChat2.sNom, "Instances independantes")
	dbgVérifieDifférence(oChat1.bInterieur, oChat2.bInterieur, "Membres propres independants")
FIN
