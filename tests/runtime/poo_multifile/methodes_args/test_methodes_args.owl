// @sujet methodes externes cross-file avec 0/1/2/N args
// @resume reproduction bug  : methode 1-arg introuvable cross-file (enregistree comme __set_)

PROCEDURE scenario_cross_file_0_arg()
	oM est un cMethodes(10)
	dbgVérifieEgalité(oM.Lire(), 10, "Methode 0-arg retour OK cross-file")
FIN

PROCEDURE scenario_cross_file_1_arg()
	oM est un cMethodes(10)
	oM.Definir(42)
	dbgVérifieEgalité(oM.Lire(), 42, "Methode 1-arg assigne cross-file")
FIN

PROCEDURE scenario_cross_file_2_args()
	oM est un cMethodes(10)
	oM.Ajouter(5, 7)
	dbgVérifieEgalité(oM.Lire(), 12, "Methode 2-args calcule somme cross-file")
FIN

PROCEDURE scenario_cross_file_3_args_avec_return()
	oM est un cMethodes(10)
	nRes est un entier = oM.Calculer("+", 8, 3)
	dbgVérifieEgalité(nRes, 11, "Methode 3-args retour addition cross-file")
	nRes = oM.Calculer("*", 4, 5)
	dbgVérifieEgalité(nRes, 20, "Methode 3-args retour multiplication cross-file")
FIN
