// Classe pour tester methodes inline avec arguments cross-file
cMethodes est une Classe
	nValeur est un entier

	PROCEDURE Constructeur(v est un entier)
		:nValeur = v
	FIN

	PROCEDURE Lire() : entier
		RENVOYER :nValeur
	FIN

	PROCEDURE Definir(Val est un entier)
		:nValeur = Val
	FIN

	PROCEDURE Ajouter(x est un entier, y est un entier)
		:nValeur = x + y
	FIN

	PROCEDURE Calculer(op est une chaîne, x est un entier, y est un entier) : entier
		SI op = "+" ALORS
			RENVOYER x + y
		SINON SI op = "*" ALORS
			RENVOYER x * y
		SINON
			RENVOYER 0
		FIN
	FIN
FIN
