// Classe cPersonne avec champs PUBLIC, CONSTRUCTEUR inline (params defauts),
// methodes PUBLIC + PRIVE + PROTEGE, Destructeur inline.
// Canon de référence :  methodes inline obligatoires.
cPersonne est une Classe
PUBLIC
	sNom est une chaîne
	nAge est un entier

	//  : Constructeur inline avec parametres par defaut (multi-arity).
	// Appelable : cPersonne(), cPersonne("Dupont"), cPersonne("Dupont", 30)
	PROCEDURE Constructeur(nomInit est une chaîne = "inconnu", ageInit est un entier = 0)
		:sNom = nomInit
		:nAge = ageInit
	FIN

	// Methode publique
	PROCEDURE SePresenter()
		Trace(:sNom + " a " + :nAge + " ans.")
	FIN

	// Methode publique avec retour
	PROCEDURE ObtenirNom() : chaîne
		RENVOYER :sNom
	FIN

	// Methode public qui appelle methode PRIVE interne
	PROCEDURE Vieillir(annees est un entier)
		POUR i = 1 À annees
			:AugmenterAge()
		FIN
	FIN

PRIVÉ
	// Methode privee (interne seulement)
	PROCEDURE AugmenterAge()
		:nAge = :nAge + 1
	FIN

PROTÉGÉ
	// Methode protegee (derivee peut appeler)
	PROCEDURE ReinitialiserAge()
		:nAge = 0
	FIN

PUBLIC
	// Destructeur inline
	PROCEDURE Destructeur()
		Trace("liberation cPersonne: " + :sNom)
	FIN
FIN
