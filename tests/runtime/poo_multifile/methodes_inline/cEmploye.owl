// Classe cEmploye herite cPersonne, override methode, appelle Ancetre.M()
// depuis methode inline.
cEmploye est une Classe Hérite cPersonne
PUBLIC
	sService est une chaîne

	// Constructeur avec parametres par defaut (appel implicite ctor parent 0-arg)
	PROCEDURE Constructeur(nomInit est une chaîne = "inconnu", serviceInit est une chaîne = "general")
		:sNom = nomInit
		:sService = serviceInit
		:nAge = 25 // defaut employe
	FIN

	// Override SePresenter (virtual par defaut)
	PROCEDURE SePresenter()
		Trace(:sNom + ", employe au service " + :sService + ", " + :nAge + " ans.")
	FIN

	// Methode qui appelle la version parent via Ancetre
	PROCEDURE SePresenteAvecAncetre()
		Ancetre.SePresenter()
		Trace("Service: " + :sService)
	FIN

	// Methode qui appelle methode locale via :
	PROCEDURE AfficherDetails()
		:SePresenter()
	FIN

	// Methode qui appelle methode protegee de la classe parente
	PROCEDURE ResetAge()
		:ReinitialiserAge()
	FIN

	// Destructeur override : appelle d'abord le destructeur parent via Ancetre.
	PROCEDURE Destructeur()
		Trace("liberation cEmploye: " + :sNom + ", service " + :sService)
		Ancetre.Destructeur()
	FIN
FIN
