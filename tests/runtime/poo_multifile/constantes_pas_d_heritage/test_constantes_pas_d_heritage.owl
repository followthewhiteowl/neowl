// @sujet constantes de classe et heritage — accessibles via le nom du parent
// @resume confirme l'alignement avec staticFields :
//         la constante VERSION du parent reste accessible via cBaseConst.VERSION,
//         la constante NIVEAU de la derivee via cDeriveeConst.NIVEAU,
//         et les deux espaces de noms restent distincts.

PROCEDURE scenario_constante_parent_via_nom_parent()
	dbgVérifieEgalité(cBaseConst.VERSION, 42,
	"Constante du parent accessible via cBaseConst.VERSION")
FIN

PROCEDURE scenario_constante_derivee_propre()
	dbgVérifieEgalité(cDeriveeConst.NIVEAU, 7,
	"Constante propre a la derivee accessible via cDeriveeConst.NIVEAU")
FIN

PROCEDURE scenario_constantes_independantes()
	// Les deux constantes vivent dans des espaces de noms distincts par classe.
	dbgVérifieDifférence(cBaseConst.VERSION, cDeriveeConst.NIVEAU,
	"Constantes parent et derivee distinctes")
FIN
