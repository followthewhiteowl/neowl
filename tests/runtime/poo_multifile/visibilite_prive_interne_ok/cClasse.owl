// Classe avec membre PRIVE et methode publique qui y accede (acces interne = OK).
cClasse est une Classe
PRIVÉ
	nState est un entier

PUBLIC
	PROCEDURE Constructeur(valeur est un entier)
		:nState = valeur
	FIN

	PROCEDURE GetState() : entier
		// Acces interne a membre PRIVE = autorise
		RENVOYER :nState
	FIN

	PROCEDURE DefinirState(valeur est un entier)
		// Modification interne membre PRIVE = autorise
		:nState = valeur
	FIN
FIN
