// @sujet visibilite PRIVE acces interne cross-file
// @résumé methode publique de la classe accede au membre PRIVE (OK)

PROCEDURE scenario_prive_interne_cross_file()
	// Instanciation
	o est un cClasse(42)

	// Lecture via methode publique (acces interne au PRIVE = OK)
	dbgVérifieEgalité(o.GetState(), 42, "Acces interne PRIVE via getter OK")

	// Modification via methode publique (acces interne = OK)
	o.DefinirState(99)
	dbgVérifieEgalité(o.GetState(), 99, "Modification interne PRIVE via setter OK")
FIN
