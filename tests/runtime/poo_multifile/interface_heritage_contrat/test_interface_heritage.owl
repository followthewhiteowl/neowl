// Test heritage contrat interface (cChild herite de cBase qui implemente iBase).

PROCEDURE scenario_heritage_contrat_interface()
	oChild est un cChild(10)
	nRes est un entier = oChild.Executer()
	dbgVérifieEgalité(nRes, 20, "Heritage contrat : methode heritee conforme")
	dbgVérifieVrai(Vrai, "Heritage classe implique heritage contrat interface")
FIN
