// Classe implementant 2 interfaces (multi-interface).

cItem est une Classe
	implemente iNommable
	implemente iValorisable
PUBLIC
	sNom est une chaîne
	nVal est un entier

	PROCEDURE Constructeur(s est une chaîne, n est un entier)
		:sNom = s
		:nVal = n
	FIN

	PROCEDURE GetNom() : chaîne
		RENVOYER :sNom
	FIN

	PROCEDURE GetValeur() : entier
		RENVOYER :nVal
	FIN
FIN
