// Test conformite multi-interface (iNommable + iValorisable).

PROCEDURE scenario_multi_interface_conforme()
	oItem est un cItem("Epee", 150)
	dbgVérifieEgalité(oItem.GetNom(), "Epee", "Multi-interface : GetNom conforme")
	dbgVérifieEgalité(oItem.GetValeur(), 150, "Multi-interface : GetValeur conforme")
	dbgVérifieVrai(Vrai, "Multi-interface implementee correctement")
FIN
