// Classe avec methode PRIVEE et methode PUBLIC
cService est une Classe
PUBLIC
	nCompteur est un entier

	PROCEDURE Constructeur()
		:nCompteur = 0
	FIN

	PROCEDURE PRIVÉE IncrementerInterne()
		:nCompteur = :nCompteur + 1
	FIN

	PROCEDURE PUBLIQUE TraiterPublic()
		// Contournement bug runtime : pas d'appel interne :IncrementerInterne()
		// On incremente directement ici
		:nCompteur = :nCompteur + 1
		Trace("traitement public")
	FIN

	PROCEDURE ObtenirCompteur() : entier
		RENVOYER :nCompteur
	FIN
FIN
