// Classe derivee : valide que ':HelperParent()' resout via la chaine
// superclass (comme 'obj.HelperParent()' aujourd'hui).
cBar est une Classe
	Hérite de cFoo

	PROCEDURE Constructeur()
		:n = 0
	FIN

	PROCEDURE BumpViaParent()
		// :Bump() est definie sur cFoo, doit etre resolue par dispatch superclass
		:Bump()
	FIN

	PROCEDURE AddViaParent(x est un entier)
		:Add(x)
	FIN
FIN
