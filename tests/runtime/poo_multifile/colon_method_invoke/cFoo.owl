// Classe pour tester l'appel interne via :M()
// Verifie que ':methode()' propage correctement 'this' a la methode appelee.
cFoo est une Classe
PUBLIC
	n est un entier = 0
	s est une chaîne = ""

	PROCEDURE Constructeur()
		:n = 0
		:s = ""
	FIN

	PROCEDURE Bump()
		:n = :n + 1
	FIN

	PROCEDURE BumpTwice()
		:Bump()
		:Bump()
	FIN

	PROCEDURE Add(x est un entier)
		:n = :n + x
	FIN

	PROCEDURE Combine(x est un entier, y est un entier)
		:n = x * y
	FIN

	PROCEDURE AddViaCombine(x est un entier, y est un entier)
		:Combine(x, y)
	FIN

	PROCEDURE AppendDot()
		:s = :s + "."
	FIN

	PROCEDURE AppendThree()
		:AppendDot()
		:AppendDot()
		:AppendDot()
	FIN
FIN
