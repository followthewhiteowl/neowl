// Classe utilitaire avec methodes globales (statiques).
// Appelables sans instance : cMath.Carre(7).
cMath est une Classe
	GLOBAL
	nPi est un réel = 3.14

	PROCEDURE GLOBALE Carre(n est un entier) : entier
		RENVOYER n * n
	FIN

	PROCEDURE GLOBALE Cube(n est un entier) : entier
		// Une methode globale peut appeler une autre methode globale de la meme classe.
		RENVOYER cMath.Carre(n) * n
	FIN

	PROCEDURE GLOBALE AireCercle(r est un réel) : réel
		// Une methode globale lit un membre global de la meme classe.
		RENVOYER cMath.nPi * r * r
	FIN
FIN
