// @sujet methode GLOBALE (statique) — appel via cClasse.Methode() sans instance
// @resume validations methode globale standalone, chainage, lecture membre global

PROCEDURE scenario_appel_simple()
	r est un entier = cMath.Carre(7)
	dbgVérifieEgalité(r, 49, "cMath.Carre(7) renvoie 49 sans instance")

	r2 est un entier = cMath.Carre(0)
	dbgVérifieEgalité(r2, 0, "cMath.Carre(0) renvoie 0")

	r3 est un entier = cMath.Carre(-5)
	dbgVérifieEgalité(r3, 25, "cMath.Carre(-5) renvoie 25")
FIN

PROCEDURE scenario_appel_chaine()
	// Une methode globale qui appelle une autre methode globale.
	c est un entier = cMath.Cube(4)
	dbgVérifieEgalité(c, 64, "cMath.Cube(4) = 64 (appel interne a Carre)")
FIN

PROCEDURE scenario_methode_lit_membre_global()
	// Methode globale qui lit un membre global de la meme classe.
	rAire est un réel = cMath.AireCercle(2.0)
	// 3.14 * 2 * 2 = 12.56
	dbgVérifieEgalité(rAire, 12.56, "cMath.AireCercle(2.0) lit nPi global")
FIN
