// @sujet visibilite PUBLIC par defaut
// @résumé validation acces externe membre PUBLIC (ou defaut sans keyword)

PROCEDURE scenario_acces_externe_public()
	// Instanciation
	oAnimal est un cAnimal("Felix")

	// Acces externe direct au membre PUBLIC sNom
	dbgVérifieEgalité(oAnimal.sNom, "Felix", "Acces externe membre PUBLIC OK")

	// Modification externe
	oAnimal.sNom = "Rex"
	dbgVérifieEgalité(oAnimal.sNom, "Rex", "Modification externe membre PUBLIC OK")

	// Appel methode (les methodes sont publiques par defaut)
	oAnimal.Presenter()
FIN
