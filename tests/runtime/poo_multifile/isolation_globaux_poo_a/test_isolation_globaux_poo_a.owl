// @sujet smoke pollution tables globales POO compile-time (cote A)
// @résumé declare cIsoCible (abstraite) + cIsoCibleConcret (derivee). Le
//          dossier voisin _b/ redeclare cIsoCible en classe NORMALE et doit
//          pouvoir l'instancier — c'est le vrai smoke. Ici on verifie juste
//          que A compile et tourne correctement.

PROCEDURE scenario_iso_a_abstraite_via_derivee()
	// cIsoCible est abstraite : instanciation directe interdite (canon de référence).
	// On instancie la derivee concrete, qui herite et redefinit Calcule().
	oObj est un cIsoCibleConcret(7, 3)

	dbgVérifieEgalité(oObj.nValeur, 7, "Champ herite de cIsoCible accessible")
	dbgVérifieEgalité(oObj.nFacteur, 3, "Champ propre cIsoCibleConcret accessible")
	dbgVérifieEgalité(oObj.Calcule(), 21, "Methode abstraite redefinie execute concretement")
FIN
