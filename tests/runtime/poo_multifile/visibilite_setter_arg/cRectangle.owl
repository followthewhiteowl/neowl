// Classe Rectangle avec getters/setters convention naming distinct.
cRectangle est une Classe
PRIVÉ
	nLargeur est un entier
	nHauteur est un entier

PUBLIC
	PROCEDURE Constructeur(l est un entier, h est un entier)
		:nLargeur = l
		:nHauteur = h
	FIN

	PROCEDURE Largeur() : entier
		RENVOYER :nLargeur
	FIN

	PROCEDURE DefinirLargeur(Val est un entier)
		:nLargeur = Val
	FIN

	PROCEDURE Hauteur() : entier
		RENVOYER :nHauteur
	FIN

	PROCEDURE DefinirHauteur(Val est un entier)
		:nHauteur = Val
	FIN

	PROCEDURE Surface() : entier
		RENVOYER :nLargeur * :nHauteur
	FIN
FIN
