// @sujet convention getter/setter naming distinct cross-file
// @résumé validation methode externe avec arg cross-file (post-)

PROCEDURE scenario_setter_arg_cross_file()
	// Instanciation
	oRect est un cRectangle(10, 5)

	// Getters
	dbgVérifieEgalité(oRect.Largeur(), 10, "Getter Largeur cross-file OK")
	dbgVérifieEgalité(oRect.Hauteur(), 5, "Getter Hauteur cross-file OK")
	dbgVérifieEgalité(oRect.Surface(), 50, "Surface initiale = 50")

	// Setters avec args (convention naming distinct post-)
	oRect.DefinirLargeur(20)
	oRect.DefinirHauteur(8)

	// Verification
	dbgVérifieEgalité(oRect.Largeur(), 20, "Setter DefinirLargeur cross-file OK")
	dbgVérifieEgalité(oRect.Hauteur(), 8, "Setter DefinirHauteur cross-file OK")
	dbgVérifieEgalité(oRect.Surface(), 160, "Surface apres setters = 160")
FIN
