// Classe avec membre GLOBAL (partage par toutes les instances).
// Le membre 'nTotal' est unique pour la classe, pas duplique par instance.
cCompteur est une Classe
	GLOBAL
	nTotal est un entier = 0
PUBLIC
	sNom est une chaîne

	PROCEDURE Constructeur(nom est une chaîne)
		:sNom = nom
		cCompteur.nTotal = cCompteur.nTotal + 1
	FIN
FIN
