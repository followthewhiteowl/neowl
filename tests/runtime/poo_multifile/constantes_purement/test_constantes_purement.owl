// Verifie qu'une classe purement-constante d'un autre fichier
// est bien reconnue par le prescan multifile.

PROCEDURE scenario_acces_constante_cross_file()
	dbgVérifieEgalité(cConstantesOnly.K_MAX, 100, "K_MAX cross-file")
	dbgVérifieEgalité(cConstantesOnly.K_MIN, 0, "K_MIN cross-file")
FIN

PROCEDURE scenario_constantes_dans_expression()
	total est un entier = cConstantesOnly.K_MAX + cConstantesOnly.K_MIN
	dbgVérifieEgalité(total, 100, "somme constantes cross-file")
FIN
