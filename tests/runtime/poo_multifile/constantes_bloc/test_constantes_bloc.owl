// @sujet bloc CONSTANT avec plusieurs constantes (entiers + chaine)
// @resume les 3 constantes du bloc sont lisibles sans instance et conservent
//         leurs valeurs exactes

PROCEDURE scenario_lecture_trois_constantes()
	dbgVérifieEgalité(cConfig.K, 5, "cConfig.K = 5")
	dbgVérifieEgalité(cConfig.J, 10, "cConfig.J = 10")
	dbgVérifieEgalité(cConfig.Nom, "OWL", "cConfig.Nom = OWL")
FIN

PROCEDURE scenario_constantes_independantes()
	// Modifier une variable locale n'affecte pas la constante de classe.
	k_local est un entier = cConfig.K + 100
	dbgVérifieEgalité(k_local, 105, "Variable locale issue de cConfig.K + 100 = 105")
	dbgVérifieEgalité(cConfig.K, 5, "cConfig.K inchange apres copie locale")
FIN
