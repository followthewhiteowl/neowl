// @sujet constante de classe declaree en ligne unique
// @resume cMath.PI accessible sans instance, valeur exacte 3.14159

PROCEDURE scenario_lecture_directe_sans_instance()
	// Acces direct via le nom de classe, sans avoir instancie cMath.
	dbgVérifieEgalité(cMath.PI, 3.14159, "cMath.PI lit la valeur de la constante")
FIN

PROCEDURE scenario_lecture_apres_usage_local()
	// La constante reste stable apres calculs locaux.
	rayon est un réel = 2.0
	circ est un réel = 2.0 * cMath.PI * rayon
	dbgVérifieEgalité(circ, 12.56636, "Calcul utilisant cMath.PI donne le bon resultat")
	dbgVérifieEgalité(cMath.PI, 3.14159, "cMath.PI inchange apres usage")
FIN
