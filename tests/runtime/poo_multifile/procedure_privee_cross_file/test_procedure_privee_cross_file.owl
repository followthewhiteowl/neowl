// @sujet visibilite procedures PRIVEE top-level cross-file
// @resume procedure PRIVEE appelable uniquement depuis le fichier de declaration

PROCEDURE scenario_procedure_privee_meme_fichier()
	// ModuleA_Publique() appelle HelperSecret() en interne (meme fichier) -> OK
	ModuleA_Publique()
	dbgVérifieVrai(Vrai, "procedure PRIVEE appelable depuis le meme fichier")
FIN

PROCEDURE scenario_procedure_publique_cross_file()
	// ModuleA_Publique est PUBLIC, donc appelable depuis test
	ModuleA_Publique()
	dbgVérifieVrai(Vrai, "procedure PUBLIC appelable cross-file")
FIN

// Edge cases PRIVE
PROCEDURE scenario_procedure_privee_appels_multiples()
	// Verifier que l'appel multiple d'une PUBLIC qui appelle PRIVEE interne fonctionne
	ModuleA_Publique()
	ModuleA_Publique()
	ModuleA_Publique()
	dbgVérifieVrai(Vrai, "procedure PRIVEE appelable multiples fois via PUBLIC")
FIN
