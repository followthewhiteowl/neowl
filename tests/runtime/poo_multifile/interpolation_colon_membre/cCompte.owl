// Classe cCompte : champs d'instance interpoles via `:champ` dans une chaine
// formattee `%"..."`. Sert le scenario  — interpolation d'un membre
// d'instance dans une methode.
cCompte est une Classe
PUBLIC
	sProprietaire est une chaîne
	mSolde est un monétaire

	PROCEDURE Constructeur(nom est une chaîne, solde est un monétaire)
		:sProprietaire = nom
		:mSolde = solde
	FIN

	// Cas central : interpolation de DEUX membres d'instance via `:` dans
	// la meme chaine formattee.
	PROCEDURE Resume() : chaîne
		RENVOYER %"[%:sProprietaire%] : [%:mSolde%]"
	FIN

	// Mix : interpolation membre `:` + variable locale + litteral.
	PROCEDURE ResumeAvecLocale(prefixe est une chaîne) : chaîne
		RENVOYER %"[%prefixe%]/[%:sProprietaire%]"
	FIN

	// Cas degenere : un seul membre interpolé entoure de litteraux.
	PROCEDURE NomEntreCrochets() : chaîne
		RENVOYER %"<[%:sProprietaire%]>"
	FIN
FIN
