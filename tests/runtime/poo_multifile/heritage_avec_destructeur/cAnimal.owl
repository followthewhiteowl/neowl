// Classe parent complete pour tests heritage (restauration couverture test_oop)
cAnimal est une Classe
PUBLIC
	sNom est une chaîne
	nAge est un entier

	PROCEDURE Constructeur(nom est une chaîne, Age est un entier)
		:sNom = nom
		:nAge = Age
	FIN

	PROCEDURE Presenter()
		Trace("Je suis " + :sNom + ", " + :nAge + " ans")
	FIN

	PROCEDURE GetNom() : chaîne
		RENVOYER :sNom
	FIN
FIN
