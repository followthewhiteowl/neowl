// @sujet heritage complet cross-file (restauration couverture test_oop)
// @résumé valide membre herite + methode heritee + surcharge + modification membre

PROCEDURE scenario_heritage_complet()
	// Instanciation cChat avec constructeur appel parent
	oChat est un cChat("Felix", 2, Vrai)

	// Membre herite accessible
	dbgVérifieEgalité(oChat.sNom, "Felix", "Membre herite sNom")
	dbgVérifieEgalité(oChat.nAge, 2, "Membre herite nAge")

	// Membre propre accessible
	dbgVérifieEgalité(oChat.bInterieur, Vrai, "Membre propre bInterieur")

	// Methode heritee accessible (GetNom vient de cAnimal)
	dbgVérifieEgalité(oChat.GetNom(), "Felix", "Methode heritee GetNom")

	// Surcharge methode Presenter (cChat.Presenter doit executer version enfant)
	oChat.Presenter()
FIN

PROCEDURE scenario_modification_membre()
	// Valider modification membre herite
	oChat est un cChat("Rex", 3, Faux)
	oChat.nAge = 4
	dbgVérifieEgalité(oChat.nAge, 4, "Modification membre herite")
FIN

PROCEDURE scenario_instances_independantes()
	// Valider independance instances (heritage)
	oChat1 est un cChat("Moustache", 5, Vrai)
	oChat2 est un cChat("Tigre", 7, Faux)

	dbgVérifieDifférence(oChat1.sNom, oChat2.sNom, "Instances independantes nom")
	dbgVérifieDifférence(oChat1.nAge, oChat2.nAge, "Instances independantes age")
	dbgVérifieDifférence(oChat1.bInterieur, oChat2.bInterieur, "Instances independantes membre propre")
FIN
