// Classe enfant complete herite cAnimal
cChat est une Classe
	Hérite de cAnimal
	bInterieur est un booléen

	PROCEDURE Constructeur(nom est une chaîne, Age est un entier, interieur est un booléen)
		Constructeur cAnimal(nom, Age)
		:bInterieur = interieur
	FIN

	PROCEDURE Presenter()
		Trace("Miaou! Je suis " + :sNom)
	FIN
FIN
