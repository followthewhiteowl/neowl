// Classe derivee de cBase, accede au membre PROTEGE du parent.
cDerive est une Classe
	Hérite de cBase

	PROCEDURE Constructeur(valeur est un entier)
		Constructeur cBase(valeur)
	FIN

	PROCEDURE PublicGetShared() : entier
		// Acces au membre PROTEGE du parent = autorise dans classe derivee
		RENVOYER :nShared
	FIN

	PROCEDURE PublicSetShared(valeur est un entier)
		// Modification membre PROTEGE du parent = autorise dans classe derivee
		:nShared = valeur
	FIN
FIN
