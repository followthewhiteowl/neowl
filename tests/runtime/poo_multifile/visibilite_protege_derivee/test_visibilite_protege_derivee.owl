// @sujet visibilite PROTEGE dans classe derivee cross-file
// @résumé classe derivee accede au membre PROTEGE du parent (OK)

PROCEDURE scenario_protege_derivee_cross_file()
	// Instanciation classe derivee
	o est un cDerive(77)

	// Lecture via methode publique de la derivee (acces PROTEGE parent = OK)
	dbgVérifieEgalité(o.PublicGetShared(), 77, "Acces PROTEGE parent depuis derivee OK")

	// Modification via methode publique de la derivee
	o.PublicSetShared(88)
	dbgVérifieEgalité(o.PublicGetShared(), 88, "Modification PROTEGE parent depuis derivee OK")
FIN
