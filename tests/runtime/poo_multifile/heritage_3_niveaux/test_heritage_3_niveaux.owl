// @sujet heritage cross-file sur chaine de 4 niveaux
// @résumé valide que `Herite de` suit la chaine au-dela du 1er niveau

PROCEDURE scenario_chaine_4_niveaux()
	// Instanciation de la feuille : doit traverser 3 niveaux d'ancetres.
	oChat est un cChat("Felix", Vrai)

	// Champ propre (cChat).
	dbgVérifieEgalité(oChat.bInterieur, Vrai, "Champ propre cChat accessible")

	// Champ herite niveau 1 (cMammifere).
	dbgVérifieEgalité(oChat.bPoils, Vrai, "Champ herite niveau 1 (cMammifere)")

	// Champ herite niveau 2 (cAnimal).
	dbgVérifieEgalité(oChat.sNom, "Felix", "Champ herite niveau 2 (cAnimal)")

	// Champ herite niveau 3 (cVivant).
	dbgVérifieEgalité(oChat.bEnVie, Vrai, "Champ herite niveau 3 (cVivant)")
FIN

PROCEDURE scenario_instance_independante()
	// Deux instances pour valider que la chaine ne fuit pas d'etat.
	oChat1 est un cChat("Moustache", Vrai)
	oChat2 est un cChat("Tigre", Faux)

	dbgVérifieDifférence(oChat1.sNom, oChat2.sNom, "Instances independantes (sNom)")
	dbgVérifieDifférence(oChat1.bInterieur, oChat2.bInterieur, "Instances independantes (bInterieur)")
	dbgVérifieEgalité(oChat1.bEnVie, oChat2.bEnVie, "bEnVie partage la meme valeur initiale")
FIN
