// Feuille de la chaine : concrete, redefinit Aire() (heritee de cFigure).

cFigurePolygoneCarre est une Classe
	Hérite de cFigurePolygone
PUBLIC
	rCote est un réel

	PROCEDURE Constructeur(nom est une chaîne, cote est un réel)
		Constructeur cFigurePolygone(nom, 4)
		:rCote = cote
	FIN

	PROCEDURE Aire() : réel
		RENVOYER :rCote * :rCote
	FIN
FIN
