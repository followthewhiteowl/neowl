// Test chaine cFigure (abstraite) -> cFigurePolygone (abstraite) ->
// cFigurePolygoneCarre (concrete). Le dernier redefinit Aire() et devient
// instanciable. Les deux ancetres restent abstraits.

PROCEDURE scenario_abstraite_chaine_heritage()
	oCarre est un cFigurePolygoneCarre("carre1", 3.0)

	// Membre herite niveau 2 (cFigure).
	dbgVérifieEgalité(oCarre.sNom, "carre1", "Membre herite cFigure -> feuille")

	// Membre herite niveau 1 (cFigurePolygone).
	dbgVérifieEgalité(oCarre.nbCotes, 4, "Membre herite cFigurePolygone -> feuille")

	// Membre propre.
	dbgVérifieEgalité(oCarre.rCote, 3.0, "Membre propre feuille accessible")

	// Aire() redefinie au niveau feuille.
	rAire est un réel = oCarre.Aire()
	dbgVérifieEgalité(rAire, 9.0, "Aire() redefinie chaine heritage")
FIN
