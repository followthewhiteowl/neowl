// @sujet operateur d'introspection "est <Classe>" avec chaine d'heritage
// @résumé obj est cClasse renvoie Vrai si obj est instance ou derivee de cClasse

PROCEDURE scenario_est_classe_direct()
	oChat est un cChat("Felix")
	bResultat est un booléen = (oChat est cChat)
	dbgVérifieEgalité(bResultat, Vrai,
	"oChat est cChat -> Vrai (type exact)")
FIN

PROCEDURE scenario_est_classe_parent_via_heritage()
	oChat est un cChat("Felix")
	bResultat est un booléen = (oChat est cAnimal)
	dbgVérifieEgalité(bResultat, Vrai,
	"oChat est cAnimal -> Vrai (chaine heritage)")
FIN

PROCEDURE scenario_est_classe_sens_inverse()
	oAnimal est un cAnimal("Generic")
	bResultat est un booléen = (oAnimal est cChat)
	dbgVérifieEgalité(bResultat, Faux,
	"oAnimal est cChat -> Faux (parent n'est pas enfant)")
FIN

PROCEDURE scenario_est_classe_freres()
	oChat est un cChat("Felix")
	bResultat est un booléen = (oChat est cChien)
	dbgVérifieEgalité(bResultat, Faux,
	"oChat est cChien -> Faux (classes soeurs)")
FIN

PROCEDURE scenario_est_classe_dans_si()
	oChat est un cChat("Felix")
	sCateg est une chaîne = "inconnu"
	SI oChat est cAnimal ALORS
		sCateg = "animal"
	FIN
	dbgVérifieEgalité(sCateg, "animal",
	"est <Classe> utilisable dans condition SI")
FIN
