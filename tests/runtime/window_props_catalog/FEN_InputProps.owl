// Toutes les props Saisie.

FEN_InputProps est une Fenêtre
	PROPRIETES
		Titre       = "Input"
		Disposition = dispLibre
	FIN

	SAI_Nom est un Champ Saisie
		PROPRIETES
			Largeur     = 200
			Hauteur     = 25
			Valeur      = ""
			TypeSaisie  = typSaisieTexte
			Indication  = "Votre nom"
			MaxLongueur = 50
			Etat        = Actif
			Visible     = Vrai
			Grisé       = Faux
		FIN
	FIN

	SAI_MotDePasse est un Champ Saisie
		PROPRIETES
			TypeSaisie = typSaisieMotDePasse
			Indication = "Mot de passe"
		FIN
	FIN
FIN
