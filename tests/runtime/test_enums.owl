Trace("=== ENUMERATIONS ===")

// Enum simple avec auto-increment
eCouleur est une Énumération
	Rouge
	Vert
	Bleu
FIN

// Test acces aux valeurs
dbgVérifieEgalité(eCouleur.Rouge..Nom, "Rouge", "Enum Rouge..Nom")
dbgVérifieEgalité(eCouleur.Rouge..Valeur, 0, "Enum Rouge..Valeur = 0")
dbgVérifieEgalité(eCouleur.Vert..Valeur, 1, "Enum Vert..Valeur = 1")
dbgVérifieEgalité(eCouleur.Bleu..Valeur, 2, "Enum Bleu..Valeur = 2")
dbgVérifieEgalité(eCouleur.Bleu..Nom, "Bleu", "Enum Bleu..Nom")

// Enum avec valeurs explicites
eStatut est une Énumération
	Actif   = 10
	Inactif = 20
	EnPause = 30
FIN

dbgVérifieEgalité(eStatut.Actif..Valeur, 10, "Enum Actif..Valeur = 10")
dbgVérifieEgalité(eStatut.Inactif..Valeur, 20, "Enum Inactif..Valeur = 20")
dbgVérifieEgalité(eStatut.EnPause..Valeur, 30, "Enum EnPause..Valeur = 30")
dbgVérifieEgalité(eStatut.Actif..Nom, "Actif", "Enum Actif..Nom")

// Enum avec valeurs string
eMessage est une Énumération
	OK     = "Succes"
	Erreur = "Echec"
FIN

dbgVérifieEgalité(eMessage.OK..Valeur, "Succes", "Enum string value")
dbgVérifieEgalité(eMessage.OK..Nom, "OK", "Enum string ..Nom")

// Variable de type enum
c est un eCouleur = eCouleur.Vert
dbgVérifieEgalité(c..Nom, "Vert", "Var enum ..Nom")
dbgVérifieEgalité(c..Valeur, 1, "Var enum ..Valeur")
