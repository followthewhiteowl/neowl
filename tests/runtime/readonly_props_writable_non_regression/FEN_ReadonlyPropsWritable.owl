// Fenêtre voisine — ressource compile-only pour
// test_readonly_props_writable_non_regression.owl.
// Combo, Liste, Saisie : propriétés qui restent écrivables au runtime
// (Valeur, Contenu, Largeur, Libellé) — non-régression , le flag
// read-only-runtime ne doit viser QUE ContenuInitial/ValeurInitiale.
FEN_ReadonlyPropsWritable est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
	FIN
	CMB_X est un Champ Combo
		PROPRIETES
			X              = 10
			Y              = 10
			Largeur        = 200
			Hauteur        = 25
			ContenuInitial = `A
B
C`
		FIN
	FIN
	LISTE_X est un Champ Liste
		PROPRIETES
			X              = 10
			Y              = 50
			Largeur        = 200
			Hauteur        = 100
			ContenuInitial = `A
B
C`
		FIN
	FIN
	SAI_X est un Champ Saisie
		PROPRIETES
			X              = 10
			Y              = 160
			Largeur        = 200
			Hauteur        = 25
			ContenuInitial = "depart"
		FIN
	FIN
FIN
