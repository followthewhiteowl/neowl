//  — non-régression : le flag read-only-runtime ne vise QUE
// ContenuInitial/ValeurInitiale. Les autres propriétés (Valeur, Contenu,
// Largeur, Libellé) restent assignables en code impératif sur Combo,
// Liste, Saisie.

Ouvre(FEN_ReadonlyPropsWritable)

CMB_X..Largeur   = 220
LISTE_X..Largeur = 220
LISTE_X..Contenu = "X" + LF + "Y"
SAI_X..Valeur    = "saisi"
SAI_X..Libellé   = "Champ"

dbgVérifieEgalité(CMB_X..Largeur, 220, "Combo : ..Largeur reste assignable au runtime")
dbgVérifieEgalité(LISTE_X..Largeur, 220, "Liste : ..Largeur reste assignable au runtime")
dbgVérifieEgalité(LISTE_X..Contenu, "X" + LF + "Y", "Liste : ..Contenu reste assignable au runtime")
dbgVérifieEgalité(SAI_X..Valeur, "saisi", "Saisie : ..Valeur reste assignable au runtime")
dbgVérifieEgalité(SAI_X..Libellé, "Champ", "Saisie : ..Libellé reste assignable au runtime")

Ferme(FEN_ReadonlyPropsWritable)
dbgBilanTest()
