// Cadre Phase 3 syntaxe 4/5 — chained 3 niveaux sur sous-objets
// Coin* (Largeur/Hauteur) et Trait* (Couleur/Epaisseur/Type).
// Canon de référence exemple 2/3.

monCadre est un Cadre
monCadre..Couleur   = RougeClair
monCadre..Epaisseur = 5

// Coin asymetriques
monCadre..CoinHautGauche..Largeur = 12
monCadre..CoinHautGauche..Hauteur = 8
monCadre..CoinBasDroite..Largeur  = 4
monCadre..CoinBasDroite..Hauteur  = 4

dbgVérifieEgalité(monCadre..CoinHautGauche..Largeur, 12, "CoinHG..Largeur")
dbgVérifieEgalité(monCadre..CoinHautGauche..Hauteur, 8, "CoinHG..Hauteur")
dbgVérifieEgalité(monCadre..CoinBasDroite..Largeur, 4, "CoinBD..Largeur")
dbgVérifieEgalité(monCadre..CoinBasDroite..Hauteur, 4, "CoinBD..Hauteur")

// Per-bord (canon de référence exemple 3)
monCadre..TraitBas..Type      = TraitTiret
monCadre..TraitBas..Couleur   = RougeFoncé
monCadre..TraitBas..Epaisseur = 2

dbgVérifieEgalité(monCadre..TraitBas..Type, TraitTiret, "TraitBas..Type")
dbgVérifieEgalité(monCadre..TraitBas..Couleur, RougeFoncé, "TraitBas..Couleur")
dbgVérifieEgalité(monCadre..TraitBas..Epaisseur, 2, "TraitBas..Epaisseur")

dbgBilanTest()
