// Ordre inverse : la cascade précède l'affectation du style entier, qui la
// remet donc à zéro. La relecture doit renvoyer la valeur du style nommé.

FEN_OngletRelectureInverse est une Fenêtre
	PROPRIETES
		Titre       = "Relecture, cascade puis style entier"
		Largeur     = 420
		Hauteur     = 200
		Disposition = dispLibre
	FIN

	ONG_Inverse est un Champ Onglet
		PROPRIETES
			X                              = 10
			Y                              = 10
			Largeur                        = 380
			Hauteur                        = 120
			Valeur                         = 1
			Style..VoletActif..CouleurFond = JauneClair
			Style                          = theme.ongDemo
		FIN

		VOL_C est un Volet
			PROPRIETES
				Libellé     = "C"
				Disposition = dispLibre
			FIN
		FIN
	FIN
FIN
