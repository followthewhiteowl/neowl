// Deux Champs Onglet consommant le même style nommé : l'un tel quel, l'autre
// avec une cascade qui surcharge une seule propriété.

FEN_OngletRelecture est une Fenêtre
	PROPRIETES
		Titre       = "Relecture du style d'un onglet"
		Largeur     = 420
		Hauteur     = 300
		Disposition = dispLibre
	FIN

	ONG_Theme est un Champ Onglet
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 380
			Hauteur = 120
			Valeur  = 1
			Style   = theme.ongDemo
		FIN

		VOL_A est un Volet
			PROPRIETES
				Libellé     = "A"
				Disposition = dispLibre
			FIN
		FIN
	FIN

	ONG_Surcharge est un Champ Onglet
		PROPRIETES
			X                              = 10
			Y                              = 150
			Largeur                        = 380
			Hauteur                        = 120
			Valeur                         = 1
			Style                          = theme.ongDemo
			Style..VoletActif..CouleurFond = JauneClair
		FIN

		VOL_B est un Volet
			PROPRIETES
				Libellé     = "B"
				Disposition = dispLibre
			FIN
		FIN
	FIN
FIN
