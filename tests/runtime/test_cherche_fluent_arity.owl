// Formes valides de Cherche en natif ET en chainé.
// @sujet arité Cherche : formes 2/3/4 args acceptées, chaînée droppe le receveur
// @resume verrouille que les syntaxes valides compilent ET donnent le bon indice

arr est un tableau de chaînes
Ajoute(arr, "alpha")
Ajoute(arr, "beta")
Ajoute(arr, "gamma")

// Forme native 2-arg : Cherche(tableau, valeur)
dbgVérifieEgalité(Cherche(arr, "beta"), 2, "natif 2-arg : beta a l'indice 2")

// Forme native 3-arg : Cherche(tableau, mode, valeur) — mode ignoré
dbgVérifieEgalité(Cherche(arr, tcLineairePremier, "gamma"), 3, "natif 3-arg : gamma indice 3")

// Forme chaînée : arr.Cherche(valeur) — receveur implicite
dbgVérifieEgalité(arr.Cherche("alpha"), 1, "chaîné 1-arg : alpha indice 1")

// Forme chaînée avec mode : arr.Cherche(mode, valeur)
dbgVérifieEgalité(arr.Cherche(tcLineairePremier, "beta"), 2, "chaîné 2-arg : beta indice 2")

// Valeur absente : -1
dbgVérifieEgalité(arr.Cherche("absent"),-1, "chaîné : absent = -1")

dbgBilanTest()
