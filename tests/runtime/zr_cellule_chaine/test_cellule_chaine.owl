//  — ZoneRepetee / Saisie : la cellule doit rendre TOUJOURS une chaine.
//
// Contrat identique a SAI..Valeur (/0527) : quelle que soit la valeur
// ecrite par programme dans ZRT[i].ZS_Num (entier, reel, booleen, chaine),
// la relecture renvoie une chaine. L'operateur + discrimine le type :
//   chaine + 1 = concat ("421"), entier + 1 = arithmetique (43).
//
// IMPORTANT — piege de type : ne pas stocker le retour dans une variable
// declaree "est une chaine". OWL coerce a l'affectation vers le type declare,
// ce qui masquerait le bug (42 stocke brut -> affecte a chaine -> converti).
// Les assertions cles passent la valeur DIRECTEMENT depuis la PROCEDURE
// (SetGetEntier(), SetGetReel(), etc.) pour lire le type brut du store.
//
// ROUGE ATTENDU sur les cas entier / reel / booleen tant que le runtime
// rend la valeur typee brute (le store ZR ne coerce pas encore).
// VERT ATTENDU d'emblee : chaine, seed (vide), Libelle (non-regression), OOB.
//
// Ce test verrouille :
//   1. SET entier 42   -> valeur brute + 1 == "421" (concat, ROUGE attendu)
//   2. SET reel 3.5    -> valeur brute + 1.0 == "3.51" (concat, ROUGE attendu)
//   3. SET booleen Vrai -> valeur brute + 0 == "10" (concat, ROUGE attendu)
//   4. SET chaine "hello" -> valeur brute == "hello" (VERT attendu d'emblee)
//   5. Seed (jamais set) -> valeur brute == ""         (VERT attendu d'emblee)
//   6. Non-regression Libelle : SET "Alice" -> valeur == "Alice" (VERT)
//   7. OOB ZRT[2] sur 1 ligne -> ErreurDetectee (VERT attendu d'emblee)

TestModeHeadless(Vrai)

init_done_0557 est un booléen = Faux

PROCEDURE cb_0557_init_done()
	init_done_0557 = Vrai
FIN

Ouvre(FEN_ZR557)

dbgVérifieVrai(init_done_0557, "FinInitialisation FEN_ZR557 executee")

// --- Cas 6 : seed (lire avant tout SET pour ne pas contaminer) ---
// Seed : aucun SET prealable, la cellule est initialisee chaine vide dans le
// build headless (zr_build_headless_rep -> inst_field_set_str -> "").
// Ce cas est vert d'emblee car la rep headless part toujours de "".
dbgVérifieEgalité(LireSeed(), "", "ZRT[1].ZS_Num jamais set -> chaine vide (seed)")

// --- Cas 1 : entier par programme (ROUGE attendu avant fix) ---
// Assertion cle : valeur brute du store (pas de variable chaine intermediaire).
// Apres fix : SetGetEntier() renvoie une chaine "42", + 1 concatene -> "421".
// Avant fix  : SetGetEntier() renvoie un entier 42, + 1 additionne -> 43.
dbgVérifieEgalité(SetGetEntier() + 1, "421", "ZRT[1].ZS_Num = 42 -> chaine -> + 1 = 421 (concat, pas arith)")

// --- Cas 3 : reel par programme (ROUGE attendu avant fix) ---
// Sonde discriminante : chaine "3.5" + 1.0 concatene -> "3.51" (ROUGE attendu).
// Reel brut 3.5 + 1.0 = 4.5 (arithmetique). Ne PAS tester + "x" : reel + chaine
// promeut aussi en concat "3.5x" -> pas de discrimination avant/apres fix.
// Note : chaine(1.0) = "1" en OWL (zero de queue supprime), donc "3.5"+"1" = "3.51".
dbgVérifieEgalité(SetGetReel() + 1.0, "3.51", "ZRT[1].ZS_Num = 3.5 -> chaine -> + 1.0 concat = 3.51")

// --- Cas 4 : booleen par programme (ROUGE attendu avant fix) ---
// Coercion booleen -> chaine OWL : Vrai -> "1" (cf. contrat  SAI..Valeur)
// Sonde discriminante : booleen Vrai brut + 0 = 1 (arithmetique, ROUGE attendu).
// Chaine "1" + 0 = "10" (concat). Ne PAS tester + "x" : Vrai+"x" et "1"+"x"
// donnent tous les deux "1x" (pas de discrimination).
dbgVérifieEgalité(SetGetBooleen() + 0, "10", "ZRT[1].ZS_Num = Vrai -> chaine 1 -> + 0 concat = 10 (pas arith 1)")

// --- Cas 5 : chaine inchangee (VERT attendu d'emblee) ---
dbgVérifieEgalité(SetGetChaine(), "hello", "ZRT[1].ZS_Num = hello -> relu chaine hello")

// --- Cas 7 : non-regression Libelle (VERT attendu d'emblee) ---
dbgVérifieEgalité(SetGetLibelle(), "Alice", "ZRT[1].LIB_Txt = Alice -> relu Alice (non-regression)")

// --- Cas 8 : OOB ZRT[2] sur 1 ligne (VERT attendu d'emblee) ---
ErreurRAZ()
sOOB est une chaîne = LireOOB()
bOOB est un booléen = ErreurDétectée
dbgVérifieVrai(bOOB, "ZRT[2].ZS_Num sur 1 ligne -> ErreurDetectee (OOB)")

Ferme(FEN_ZR557)

dbgBilanTest()
