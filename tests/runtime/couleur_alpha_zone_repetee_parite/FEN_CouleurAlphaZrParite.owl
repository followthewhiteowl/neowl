//  (LOT 4) — opacité sur `Style..LignesImpaires`/`LignesPaires`
// (fond alterné) et `Style..Séparateur..Couleur` (trait entre répétitions)
// d'un Champ ZoneRépétée.
//
// Backdrop de mélange : Style..CadreExtérieur..CouleurFond = RVB(255,0,0)
// (entier nu, opaque, HORS bug lot 4) peint le cadre du widget ; toute
// répétition sans fond propre laisse voir ce rouge.
FEN_CouleurAlphaZrParite est une Fenêtre
	PROPRIETES
		Titre       = "Alpha Zone répétée — parité + séparateur"
		Largeur     = 460
		Hauteur     = 340
		Disposition = dispLibre
		CouleurFond = RVB(255, 0, 0)
	FIN

	ZR_ParSepOpaque est un Champ ZoneRépétée
		PROPRIETES
			X                                  = 20
			Y                                  = 20
			Largeur                            = 400
			Hauteur                            = 140
			Sens                               = zrVertical
			HauteurRepetition                  = 50
			Style..CadreExtérieur..CouleurFond = RVB(255, 0, 0)
			Style..LignesImpaires..CouleurFond = RVB(0, 255, 0)
			Style..LignesPaires..CouleurFond   = RVB(0, 255, 0)
			Style..Séparateur..Couleur         = RVB(255, 255, 0)
		FIN

		LIB_Vide1 est un Champ Libellé
			PROPRIETES
				X       = 5
				Y       = 5
				Largeur = 1
				Libellé = ""
			FIN
		FIN
	FIN

	ZR_ParSepAlpha est un Champ ZoneRépétée
		PROPRIETES
			X                                  = 20
			Y                                  = 180
			Largeur                            = 400
			Hauteur                            = 140
			Sens                               = zrVertical
			HauteurRepetition                  = 50
			Style..CadreExtérieur..CouleurFond = RVB(255, 0, 0)
			Style..LignesImpaires..CouleurFond = {Rouge = 0, Vert = 255, Bleu = 0, Opacité = 128}
			Style..LignesPaires..CouleurFond   = {Rouge = 0, Vert = 255, Bleu = 0, Opacité = 128}
			Style..Séparateur..Couleur         = {Rouge = 255, Vert = 255, Bleu = 0, Opacité = 128}
		FIN

		LIB_Vide2 est un Champ Libellé
			PROPRIETES
				X       = 5
				Y       = 5
				Largeur = 1
				Libellé = ""
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		j est un entier

		POUR i = 1 À 4
			j = ZoneRépétéeAjouteLigne(ZR_ParSepOpaque)
			j = ZoneRépétéeAjouteLigne(ZR_ParSepAlpha)
		FIN
	FIN
FIN
