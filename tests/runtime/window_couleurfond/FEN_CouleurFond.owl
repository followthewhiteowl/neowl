// Fenêtre voisine — ressource pour test_window_couleurfond.owl.
//
// CouleurFond est désormais une propriété de Fenêtre (déclaratif +
// runtime). Le fond est appliqué au widget central via stylesheet ;
// la valeur est aussi conservée dans le store de l'instance fenêtre,
// donc relisible via ..CouleurFond.

FEN_CouleurFond est une Fenêtre
	PROPRIETES
		Titre       = "Fond colore"
		Largeur     = 240
		Hauteur     = 160
		CouleurFond = RVB(200, 220, 240)
	FIN
FIN
