//  — cascade directe `BTN..Style..CadreExtérieur..Etats[état]..X = ...`
// sur un Champ Bouton (hors Thème, affectation runtime).
FEN_StyleCadreExterieurEtatsCascade est une Fenêtre
	PROPRIETES
		Titre       = "Style CadreExtérieur — cascade Etats"
		Largeur     = 400
		Hauteur     = 120
		Disposition = dispLibre
	FIN

	BTN_Zone est un Champ Bouton
		PROPRIETES
			X       = 20
			Y       = 20
			Largeur = 300
			Hauteur = 60
			Libellé = "Valider"
		FIN
	FIN
FIN
