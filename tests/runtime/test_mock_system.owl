Trace("=== MOCK SYSTEM ===")

// Test 1: Create mock and simple exact matching
mockTrace est un MockNative = MockCreate(Trace)
MockWhen(mockTrace)
MockWith(mockTrace, "test123")
MockReturns(mockTrace, Null)
MockActivate(mockTrace)
Trace("test123")
MockVerifyCount(mockTrace, 1)
dbgVérifieEgalité(1, 1, "exact match works")
MockDeactivate(mockTrace)

// Test 2: Pattern MockStartsWith
MockReset(mockTrace)
MockWhen(mockTrace)
MockWith(mockTrace, MockStartsWith("prefix"))
MockReturns(mockTrace, Null)
MockActivate(mockTrace)
Trace("prefix_suite")
MockVerifyCount(mockTrace, 1)
dbgVérifieEgalité(1, 1, "MockStartsWith works")
MockDeactivate(mockTrace)

// Test 3: Pattern MockContains
MockReset(mockTrace)
MockWhen(mockTrace)
MockWith(mockTrace, MockContains("middle"))
MockReturns(mockTrace, Null)
MockActivate(mockTrace)
Trace("start_middle_end")
MockVerifyCount(mockTrace, 1)
dbgVérifieEgalité(1, 1, "MockContains works")
MockDeactivate(mockTrace)

// Test 4: Pattern MockEndsWith
MockReset(mockTrace)
MockWhen(mockTrace)
MockWith(mockTrace, MockEndsWith("end"))
MockReturns(mockTrace, Null)
MockActivate(mockTrace)
Trace("start_end")
MockVerifyCount(mockTrace, 1)
dbgVérifieEgalité(1, 1, "MockEndsWith works")
MockDeactivate(mockTrace)

// Test 5: Pattern MockAny
MockReset(mockTrace)
MockWhen(mockTrace)
MockWith(mockTrace, MockAny)
MockReturns(mockTrace, Null)
MockActivate(mockTrace)
Trace("anything goes")
MockVerifyCount(mockTrace, 1)
dbgVérifieEgalité(1, 1, "MockAny pattern works")
MockDeactivate(mockTrace)

dbgBilanTest()
