// Verrouillage : forme fluente de génération d'image code-barres.
//  - cb.VersImage()  (FR, point simple = méthode préfixe)
//  - cb.ToImage()    (EN)
// coexistent avec la fonction globale CodeBarreVersImage(cb) et produisent
// le même rendu (mêmes dimensions).

cb est un CodeBarres
cb..TypeCodeBarres = CB_QRCODE
cb..Contenu        = "https://www.example.com/fluent"

imgGlobale est une Image = CodeBarreVersImage(cb)
imgFluenteFR est une Image = cb.VersImage()
imgFluenteEN est une Image = cb.ToImage()

dbgVérifieVrai(imgFluenteFR..Valide, "cb.VersImage() - Image valide")
dbgVérifieVrai(imgFluenteEN..Valide, "cb.ToImage() - Image valide")

// Le rendu fluent est identique au rendu global (mêmes dimensions exactes).
dbgVérifieEgalité(imgFluenteFR..Largeur, imgGlobale..Largeur, "cb.VersImage() - même largeur que CodeBarreVersImage")
dbgVérifieEgalité(imgFluenteFR..Hauteur, imgGlobale..Hauteur, "cb.VersImage() - même hauteur que CodeBarreVersImage")
dbgVérifieEgalité(imgFluenteEN..Largeur, imgGlobale..Largeur, "cb.ToImage() - même largeur que CodeBarreVersImage")
dbgVérifieEgalité(imgFluenteEN..Hauteur, imgGlobale..Hauteur, "cb.ToImage() - même hauteur que CodeBarreVersImage")

dbgBilanTest()
