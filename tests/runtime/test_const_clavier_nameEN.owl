//  — Track B : alias EN runtime des constantes clavier tk*/te*.
// Verifie que la forme EN resout au runtime vers la MEME valeur que la
// forme FR canon (alias EN auto-genere par le registry via .nameEN).
//
// ROUGE ATTENDU avant migration : les formes EN qui n'existaient pas
// encore (aucune ici — toutes posees), mais surtout valeurs exactes
// figees. Une fois .nameEN pose, chaque alias EN == valeur FR.

TestModeHeadless(Vrai)

// --- Touches speciales tk* : EN == FR (valeur exacte) ---
dbgVérifieEgalité(tkUp, tkHaut, "tkUp == tkHaut")
dbgVérifieEgalité(tkDown, tkBas, "tkDown == tkBas")
dbgVérifieEgalité(tkLeft, tkGauche, "tkLeft == tkGauche")
dbgVérifieEgalité(tkRight, tkDroite, "tkRight == tkDroite")
dbgVérifieEgalité(tkEsc, tkEchap, "tkEsc == tkEchap")
dbgVérifieEgalité(tkEnter, tkEntrée, "tkEnter == tkEntrée")
dbgVérifieEgalité(tkBackspace, tkRetourArrière, "tkBackspace == tkRetourArrière")
dbgVérifieEgalité(tkDelete, tkSuppr, "tkDelete == tkSuppr")
dbgVérifieEgalité(tkHome, tkDébut, "tkHome == tkDébut")
dbgVérifieEgalité(tkEnd, tkFin, "tkEnd == tkFin")
dbgVérifieEgalité(tkPageUp, tkPagePréc, "tkPageUp == tkPagePréc")
dbgVérifieEgalité(tkPageDown, tkPageSuiv, "tkPageDown == tkPageSuiv")
dbgVérifieEgalité(tkShift, tkMaj, "tkShift == tkMaj")
dbgVérifieEgalité(tkInsert, tkInsér, "tkInsert == tkInsér")
dbgVérifieEgalité(tkCapsLock, tkVerrMaj, "tkCapsLock == tkVerrMaj")
dbgVérifieEgalité(tkNumLock, tkVerrNum, "tkNumLock == tkVerrNum")
dbgVérifieEgalité(tkScrollLock, tkArrêtDéfil, "tkScrollLock == tkArrêtDéfil")
dbgVérifieEgalité(tkPrintScreen, tkImprÉcran, "tkPrintScreen == tkImprÉcran")
dbgVérifieEgalité(tkContextMenu, tkMenuContextuel, "tkContextMenu == tkMenuContextuel")

// --- Valeurs absolues figees (codes Qt::Key) ---
dbgVérifieEgalité(tkEnter, 16777220, "tkEnter vaut 0x01000004")
dbgVérifieEgalité(tkUp, 16777235, "tkUp vaut 0x01000013")
dbgVérifieEgalité(tkSpace, 32, "tkSpace vaut le code ASCII 32")

// --- EN == FR par construction (re-set benin, doit resoudre) ---
dbgVérifieEgalité(tkTab, 16777217, "tkTab vaut 0x01000001")
dbgVérifieEgalité(tkF1, 16777264, "tkF1 vaut 0x01000030")
dbgVérifieEgalité(tkF24, 16777287, "tkF24 vaut 0x01000047")

// --- Modifieurs te* : EN == FR (prefixe te garde), valeurs partagees tk* ---
dbgVérifieEgalité(teShift, tkMaj, "teShift partage la valeur de tkMaj")
dbgVérifieEgalité(teControl, tkCtrl, "teControl partage la valeur de tkCtrl")
dbgVérifieEgalité(teAlt, tkAlt, "teAlt partage la valeur de tkAlt")
dbgVérifieEgalité(teEsc, tkEchap, "teEsc partage la valeur de tkEchap")
dbgVérifieEgalité(teLeftButton, teBoutonG, "teLeftButton == teBoutonG")
dbgVérifieEgalité(teRightButton, teBoutonD, "teRightButton == teBoutonD")
dbgVérifieEgalité(teLeftButton, 33554432, "teLeftButton vaut 0x02000000")

dbgBilanTest()
