// Etat voisin — ressource pour test_etat_params.owl.
// Syntaxe `est un Etat(<params>)` avec params globaux d'Etat.

ETAT_Facture est un Etat(client est une chaîne, montantTotal est un réel)
	PROPRIETES
		Format = formatA4
	FIN

	intro est un EnTeteDocument
		// Les params 'client' et 'montantTotal' sont accessibles ici
		// comme globales de l'Etat (compile-time validation OK).
		Trace("Client : " + client)
	FIN

	ligne est un Corps
		Trace("Montant : " + montantTotal)
	FIN

	PROCEDURE Filtre()
		// Accessibles aussi depuis les PROCEDURE Etat.
		RENVOYER Taille(client) > 0
	FIN

	PROCEDURE Fermeture()
		Trace("Etat ferme pour client : " + client)
	FIN
FIN
