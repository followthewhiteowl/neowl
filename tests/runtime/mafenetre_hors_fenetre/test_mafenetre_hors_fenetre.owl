// MaFenêtre utilisée au niveau programme (aucune fenêtre ouverte) : erreur
// runtime. MaFenêtre est un mot-clé dynamique résolu à l'exécution vers la
// fenêtre courante ; sans fenêtre ouverte, il pose ErreurDétectée sans
// interrompre le programme (soft error).

TestModeHeadless(Vrai)

ErreurRAZ()
Trace(MaFenêtre)

bErreur est un booléen = ErreurDétectée
dbgVérifieVrai(bErreur, "MaFenêtre sans fenêtre ouverte pose ErreurDétectée")

sMsg est une chaîne = ErreurInfo(errMessage)
dbgVérifieVrai(
Contient(sMsg, "MaFenêtre") OU Contient(sMsg, "fenêtre") OU Contient(sMsg, "fenetre"),
"Le message d'erreur mentionne MaFenêtre ou fenêtre"
)
