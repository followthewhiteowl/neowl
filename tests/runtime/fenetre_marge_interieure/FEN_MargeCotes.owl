// Marge intérieure par côté sur une fenêtre habillée, et marge intérieure
// d'un Conteneur lui aussi habillé : la même propriété doit produire le même
// effet sur les deux, qu'un Style soit posé ou non.
//
// Fenêtre : marge 10 partout, sauf 44 à gauche.
// Conteneur (seul enfant, donc placé en 44, 10) : marge 40 uniforme.
// Le champ du conteneur tombe donc en (84, 50) dans la fenêtre.

FEN_MargeCotes est une Fenêtre
	PROPRIETES
		Titre         = "Marge intérieure par côté"
		Largeur       = 400
		Hauteur       = 300
		Disposition   = dispVerticale
		Espacement    = 0
		Padding       = 10
		PaddingGauche = 44
		Style         = {
			CadreExtérieur = { CouleurFond = RVB(5, 5, 5) }
		}
	FIN

	CONT_Habille est un Champ Conteneur
		PROPRIETES
			Largeur     = 200
			Hauteur     = 120
			Disposition = dispVerticale
			Espacement  = 0
			Padding     = 40
			Alignement  = alignDébut
			Style       = {
				CadreExtérieur = { CouleurFond = RVB(30, 30, 60) }
			}
		FIN

		LIB_Dedans est un Champ Libellé
			PROPRIETES
				Libellé    = "D"
				Largeur    = 80
				Hauteur    = 20
				Alignement = alignDébut
			FIN
		FIN
	FIN
FIN
