// Fenêtre habillée par un Style et portant une marge intérieure de 26.
// Le champ est le premier de la pile : sa position dans la zone client de la
// fenêtre EST la marge appliquée. Son fond vert sert de sonde pixel
// indépendante de la propriété lue.

FEN_MargePetite est une Fenêtre
	PROPRIETES
		Titre       = "Marge intérieure — 26"
		Largeur     = 400
		Hauteur     = 300
		Disposition = dispVerticale
		Espacement  = 0
		Padding     = 26
		Style       = {
			CadreExtérieur = { CouleurFond = RVB(5, 5, 5) }
		}
	FIN

	LIB_Petite est un Champ Libellé
		PROPRIETES
			Libellé                            = "P"
			Largeur                            = 120
			Hauteur                            = 30
			Alignement                         = alignDébut
			Style..CadreExtérieur..CouleurFond = RVB(0, 200, 0)
		FIN
	FIN
FIN
