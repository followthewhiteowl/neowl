// Arbitrage entre la marge intérieure déclarée sur la Fenêtre et le retrait
// porté par son Style, en présence d'un liseré.
//
//   · Gauche : le Style ne dit rien -> la marge de la fenêtre (60) s'applique,
//              plus l'épaisseur du liseré (3) -> 63.
//   · Haut   : le Style dit 8 -> le retrait du Style prime sur la marge de la
//              fenêtre, plus l'épaisseur du liseré -> 11.

FEN_MargeCadre est une Fenêtre
	PROPRIETES
		Titre       = "Marge intérieure et liseré"
		Largeur     = 400
		Hauteur     = 300
		Disposition = dispVerticale
		Espacement  = 0
		Padding     = 60
		Style       = {
			CadreExtérieur = {
				CouleurFond = RVB(5, 5, 5)
				RetraitHaut = 8
				Cadre       = { Couleur = RVB(200, 0, 0), Epaisseur = 3 }
			}
		}
	FIN

	LIB_Cadre est un Champ Libellé
		PROPRIETES
			Libellé    = "C"
			Largeur    = 80
			Hauteur    = 20
			Alignement = alignDébut
		FIN
	FIN
FIN
