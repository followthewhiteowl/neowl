// Contre-épreuve de FEN_MargePetite : même fenêtre, même style, seule la
// valeur de la marge change (60 au lieu de 26). Deux valeurs différentes
// doivent donner deux rendus différents — c'est ce que le défaut ne faisait
// pas : la marge était la même, quelle que soit la valeur écrite.

FEN_MargeGrande est une Fenêtre
	PROPRIETES
		Titre       = "Marge intérieure — 60"
		Largeur     = 400
		Hauteur     = 300
		Disposition = dispVerticale
		Espacement  = 0
		Padding     = 60
		Style       = {
			CadreExtérieur = { CouleurFond = RVB(5, 5, 5) }
		}
	FIN

	LIB_Grande est un Champ Libellé
		PROPRIETES
			Libellé                            = "G"
			Largeur                            = 120
			Hauteur                            = 30
			Alignement                         = alignDébut
			Style..CadreExtérieur..CouleurFond = RVB(0, 200, 0)
		FIN
	FIN
FIN
