// Fenêtre voisine — ressource pour test_format_nombre_type_configure.owl. Le
// champ pose un `FormatNombre` inline CONFIGURÉ (séparateur milliers " ",
// séparateur décimal ",", 2 décimales) : force un arrondi et une sortie
// formatée clairement différente de la forme plate par défaut.

FEN_FormatNombreTypeConfigure est une Fenêtre
	PROPRIETES
		Titre       = "FormatNombre type - configuré"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 120
	FIN

	SAI_Num est un Champ Saisie
		PROPRIETES
			X            = 10
			Y            = 10
			Largeur      = 180
			Hauteur      = 24
			TypeSaisie   = typSaisieNum
			FormatNombre = {SéparateurMilliers = " ", SéparateurDécimal = ",", ChiffresAprèsVirgule = 2}
			Valeur       = ""
		FIN
	FIN
FIN
