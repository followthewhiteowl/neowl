//  — en mode projet, le segment <app> de fRepDonnéesUtilisateur et
// fRepDonnéesCommun est dérivé de l'identifiant du bloc "est un Projet" de
// la frontière courante (RepertoiresSystemeAppLock), au même titre que
// ProjetInfo(piNomProjet). Aucun chemin en dur : seule la racine globale
// (dépendante de la machine) + le nom du projet (connu, contrôlé par la
// fixture) sont composés pour former l'attendu.

globalUser est une chaîne = fRepGlobalUtilisateur()
dataUser est une chaîne = fRepDonnéesUtilisateur()
attenduUser est une chaîne = globalUser + fSep() + "RepertoiresSystemeAppLock"
dbgVérifieEgalité(dataUser, attenduUser, "fRepDonnéesUtilisateur segmente avec le nom du projet en cours")

globalCommon est une chaîne = fRepGlobalCommun()
dataCommon est une chaîne = fRepDonnéesCommun()
attenduCommon est une chaîne = globalCommon + fSep() + "RepertoiresSystemeAppLock"
dbgVérifieEgalité(dataCommon, attenduCommon, "fRepDonnéesCommun segmente avec le nom du projet en cours")

dbgVérifieEgalité(ProjetInfo(piNomProjet), "RepertoiresSystemeAppLock", "cohérence avec ProjetInfo(piNomProjet) déjà verrouillé (feat/1701)")

dbgBilanTest()
