// Fenêtre voisine — ressource pour test_champ_prefixe_fen.owl.
//
// Valide que les 10 contrôles posables en Fenêtre acceptent
// la syntaxe `IDENT est un Champ <Genre>`.
//  : préfixe Champ obligatoire devant tout OwlControlKind.

FEN_ChampPrefixe est une Fenêtre
	PROPRIETES
		Titre       = "Test Champ prefixe"
		Largeur     = 400
		Hauteur     = 600
		Disposition = dispLibre
	FIN

	LBL_Titre est un Champ Libellé
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 200
			Hauteur = 20
			Libellé = "Libellé"
		FIN
	FIN

	BTN_OK est un Champ Bouton
		PROPRIETES
			X       = 10
			Y       = 40
			Largeur = 100
			Hauteur = 30
			Libellé = "OK"
		FIN
	FIN

	SAI_Nom est un Champ Saisie
		PROPRIETES
			X       = 10
			Y       = 80
			Largeur = 200
			Hauteur = 30
		FIN
	FIN

	IMG_Logo est un Champ Image
		PROPRIETES
			X       = 10
			Y       = 120
			Largeur = 100
			Hauteur = 80
		FIN
	FIN

	LST_Elements est un Champ Liste
		PROPRIETES
			X       = 10
			Y       = 210
			Largeur = 200
			Hauteur = 80
		FIN
	FIN

	CMB_Choix est un Champ Combo
		PROPRIETES
			X       = 10
			Y       = 300
			Largeur = 200
			Hauteur = 30
		FIN
	FIN

	SEL_Mode est un Champ Sélecteur
		PROPRIETES
			X       = 10
			Y       = 340
			Largeur = 200
			Hauteur = 50
		FIN
	FIN

	INT_Options est un Champ Interrupteur
		PROPRIETES
			X       = 10
			Y       = 400
			Largeur = 200
			Hauteur = 50
		FIN
	FIN

	CNT_Panneau est un Champ Conteneur
		PROPRIETES
			X       = 10
			Y       = 460
			Largeur = 200
			Hauteur = 60
		FIN
	FIN

	ZR_Lignes est un Champ ZoneRépétée
		PROPRIETES
			X       = 220
			Y       = 10
			Largeur = 160
			Hauteur = 200
		FIN
	FIN

	TBL_Donnees est un Champ Table
		PROPRIETES
			X       = 220
			Y       = 220
			Largeur = 160
			Hauteur = 100
		FIN

		COL_A est une Colonne
			PROPRIETES
				Libellé = "A"
			FIN
		FIN
	FIN
FIN
