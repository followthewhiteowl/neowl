// Formes valides de Position (, famille chaine).
// @sujet arité Position : 2/3/4 args acceptés, formes natives valides
// @resume verrouille que les syntaxes valides donnent la bonne position

s est une chaîne = "abcabc"

// 2 args : Position(s, recherche)
dbgVérifieEgalité(Position(s, "b"), 2, "2-arg : premier 'b' en position 2")

// 3 args : Position(s, recherche, départ)
dbgVérifieEgalité(Position(s, "b", 3), 5, "3-arg : 'b' depuis position 3 -> 5")

// 4 args : Position(s, recherche, départ, option) — DepuisFin = dernier 'b'
dbgVérifieEgalité(Position(s, "b", 6, DepuisFin), 5, "4-arg : DepuisFin -> dernier 'b' en 5")

dbgBilanTest()
