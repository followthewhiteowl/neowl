// Fenêtre voisine — ressource pour test_controle.owl (canon DSL strict).
//
// Cascade homonyme dans un CONTRÔLE (pas juste Fenêtre) : le refactor
// compile-time doit s'appliquer au parser de contrôle aussi. Les valeurs
// lues sont remontées au script test via callback_verifie (déclaré dans
// le voisin test_controle.owl).

FEN_Controle est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 200
		Titre       = "Test cascade homonyme contrôle"
	FIN

	LIB_Test est un Champ Libellé
		PROPRIETES
			X                = 20
			Y                = 20
			Largeur          = 150
			Hauteur          = 40
			Libellé          = "Libellé avec cadre"
			Cadre..Epaisseur = 3
			Cadre..Couleur   = BleuClair
		FIN
	FIN

	PROCEDURE FinInitialisation()
		callback_verifie(LIB_Test..Cadre..Epaisseur, LIB_Test..Cadre..Couleur)
	FIN
FIN
