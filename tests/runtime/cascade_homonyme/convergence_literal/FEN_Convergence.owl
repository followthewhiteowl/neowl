// Fenêtre voisine — ressource pour test_convergence_literal.owl (canon DSL strict).
//
// 2 cascades homonymes (Cadre..Epaisseur + Cadre..Couleur) doivent produire
// le MÊME résultat que la forme littérale (Cadre = {...}). Les valeurs sont
// remontées au script test via callback_verifie (déclaré dans le voisin).

FEN_Convergence est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 300
		Titre       = "Test convergence cascade/littéral"
	FIN

	LIB_Cascade est un Champ Libellé
		PROPRIETES
			X                = 20
			Y                = 20
			Libellé          = "Cascade homonyme"
			Cadre..Epaisseur = 3
			Cadre..Couleur   = RougeClair
		FIN
	FIN

	LIB_Litteral est un Champ Libellé
		PROPRIETES
			X       = 20
			Y       = 60
			Libellé = "Forme littérale"
			Cadre   = {Epaisseur = 3, Couleur = RougeClair}
		FIN
	FIN

	PROCEDURE FinInitialisation()
		callback_verifie(LIB_Cascade..Cadre..Epaisseur, LIB_Cascade..Cadre..Couleur,
		LIB_Litteral..Cadre..Epaisseur, LIB_Litteral..Cadre..Couleur)
	FIN
FIN
