// Fenêtre voisine — ressource pour test_niveau_2_profond.owl (canon DSL strict).
//
// Niveau 2 — sous-sous-objet (CoinHautGauche..Largeur + ..Hauteur). 2 cascades
// homonymes `Cadre..CoinHautGauche..Largeur=5` + `Cadre..CoinHautGauche..Hauteur=5`.
// Le refactor compile-time doit préserver les deux sous-champs niveau 2.
// Valeurs remontées au script test via callback_verifie.

FEN_Niveau2 est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 200
		Titre       = "Test cascade niveau 2 (profond)"
	FIN

	LIB_Niveau2 est un Champ Libellé
		PROPRIETES
			X                              = 20
			Y                              = 20
			Libellé                        = "Coin arrondi — 2 cascades homonymes niveau 2"
			Cadre..CoinHautGauche..Largeur = 5
			Cadre..CoinHautGauche..Hauteur = 5
		FIN
	FIN

	PROCEDURE FinInitialisation()
		callback_verifie(LIB_Niveau2..Cadre..CoinHautGauche..Largeur,
		LIB_Niveau2..Cadre..CoinHautGauche..Hauteur)
	FIN
FIN
