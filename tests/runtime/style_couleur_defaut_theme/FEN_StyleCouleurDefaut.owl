//  — cible : champs stylés SANS Couleur de texte explicite. Un Style
// qui ne pose qu'une CouleurFond (ou un Cadre) ne doit PAS forcer la police en
// noir : la couleur de base doit rester non-posée pour suivre le thème (palette
// applicative). Un champ témoin pose une Couleur explicite (doit primer).

FEN_StyleCouleurDefaut est une Fenêtre
	PROPRIETES
		Titre       = "Couleur défaut suit le thème"
		Largeur     = 560
		Hauteur     = 220
		Disposition = dispLibre
	FIN

	// Style SANS Couleur : uniquement un fond. La police doit suivre le thème.
	SAI_FondSeul est un Champ Saisie
		PROPRIETES
			X                              = 20
			Y                              = 20
			Largeur                        = 500
			Hauteur                        = 60
			Style..ZoneSaisie..CouleurFond = RVB(200, 220, 240)
		FIN
	FIN

	// Témoin : Couleur explicite (> 0). Doit rester ancrée sur QLineEdit.
	SAI_CouleurExplicite est un Champ Saisie
		PROPRIETES
			X                              = 20
			Y                              = 100
			Largeur                        = 500
			Hauteur                        = 60
			Style..ZoneSaisie..Couleur     = RVB(255, 0, 0)
			Style..ZoneSaisie..CouleurFond = RVB(200, 220, 240)
		FIN
	FIN
FIN
