FEN_X est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN
	LIB_X est un Champ Libellé
		PROPRIETES
			X       = 10
			Y       = 10
			Libellé = "test"
			Cadre   = {
				Couleur   = BleuFoncé
				Epaisseur = 2
				Arrondi   = 6
			}
		FIN
	FIN
FIN
