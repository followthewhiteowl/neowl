// Ressource fenêtre — voisine de test_table_echange_ligne.owl.
// Une Table à deux colonnes (texte + numérique) et quatre lignes, pour
// exercer l'échange de lignes headless : lecture des cellules après le swap,
// invariance des lignes non impliquées, invariance du nombre de lignes.

FEN_Echange est une Fenêtre
	PROPRIETES
		Titre       = "Échange de lignes"
		Disposition = dispVerticale
		Largeur     = 400
		Hauteur     = 300
	FIN

	TABLE_Lignes est un Champ Table
		PROPRIETES
			Étire = Vrai
		FIN

		COL_Nom est une Colonne
			PROPRIETES
				Libellé = "Nom"
				Type    = colTypeTexte
				Largeur = 100
			FIN
		FIN

		COL_Rang est une Colonne
			PROPRIETES
				Libellé = "Rang"
				Type    = colTypeNumerique
				Largeur = 100
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		TableAjouteLigne(TABLE_Lignes, "Alpha", 10)
		TableAjouteLigne(TABLE_Lignes, "Beta", 20)
		TableAjouteLigne(TABLE_Lignes, "Gamma", 30)
		TableAjouteLigne(TABLE_Lignes, "Delta", 40)
	FIN

	PROCEDURE Nom(n est un entier)
		RENVOYER TABLE_Lignes[n].COL_Nom
	FIN

	PROCEDURE Rang(n est un entier)
		RENVOYER TABLE_Lignes[n].COL_Rang
	FIN

	PROCEDURE Occ()
		RENVOYER TableOccurrence(TABLE_Lignes)
	FIN

	PROCEDURE Echange(source est un entier, cible est un entier)
		TableEchangeLigne(TABLE_Lignes, source, cible)
	FIN

	PROCEDURE EchangeEN(source est un entier, cible est un entier)
		TableSwapLine(TABLE_Lignes, source, cible)
	FIN
FIN
