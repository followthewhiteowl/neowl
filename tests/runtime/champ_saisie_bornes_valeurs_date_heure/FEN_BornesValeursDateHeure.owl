// Fenêtre voisine — ressource pour test_bornes_valeurs_date_heure.owl
// (, validateur de plages sur les VALEURS d'un champ date/heure, en
// plus du masque de frappe ). Quatre champs : un Date (masque
// implicite JJ/MM/AAAA), un Heure (masque posé au script HH:MI:SS), un Date à
// jetons NOMMÉS (mois en lettres, hors-scope validateur) et un Numérique
// témoin (non-régression : le validateur ne doit affecter que Date/Heure).

FEN_BornesValeursDateHeure est une Fenêtre
	PROPRIETES
		Titre       = "Bornes valeurs Date/Heure"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 220
	FIN

	SAI_Date est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 10
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieDate
			Valeur     = ""
		FIN
	FIN

	SAI_Heure est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 50
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieHeure
			Valeur     = ""
		FIN
	FIN

	SAI_DateNommee est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 90
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieDate
			Valeur     = ""
		FIN
	FIN

	SAI_Num est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 130
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieNum
			Valeur     = ""
		FIN
	FIN
FIN
