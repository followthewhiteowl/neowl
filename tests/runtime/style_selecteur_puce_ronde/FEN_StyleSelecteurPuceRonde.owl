// Un Champ Sélecteur dont la puce (QRadioButton::indicator) est stylée via
// CadrePuce (bordure, sans arrondi explicite). La puce d'un sélecteur est
// conceptuellement ronde : styler l'indicator remplace le glyphe natif rond
// par une boîte QSS, qui doit rester circulaire (border-radius = moitié de la
// taille) faute d'arrondi demandé.
FEN_StyleSelecteurPuceRonde est une Fenêtre
	PROPRIETES
		Titre       = "Style Sélecteur — puce ronde"
		Largeur     = 400
		Hauteur     = 140
		Disposition = dispLibre
	FIN

	SEL_Puce est un Champ Sélecteur
		PROPRIETES
			X                                  = 20
			Y                                  = 20
			Largeur                            = 300
			Hauteur                            = 90
			Options                            = ["Un", "Deux"]
			Style..CadrePuce..Cadre..Couleur   = RVB(210, 204, 236)
			Style..CadrePuce..Cadre..Epaisseur = 2
		FIN
	FIN
FIN
