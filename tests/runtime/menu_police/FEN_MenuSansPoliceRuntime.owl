// Non-régression : un menu stylé UNIQUEMENT en couleurs (aucune police posée)
// ne doit PAS voir sa police touchée -> la barre garde la police héritée par
// défaut, pas la famille d'un menu voisin. Vérifié en lisant la police de la
// barre (elle ne contient aucune des familles embarquées iPolice posées
// ailleurs).

FEN_MenuSansPoliceRuntime est une Fenêtre
	PROPRIETES
		Titre         = "Menu sans police"
		Largeur       = 600
		Hauteur       = 400
		Disposition   = dispLibre
		MenuPrincipal = MNU_SansPolice
	FIN

	MNU_SansPolice est un MenuPrincipal
		PROPRIETES
			Style..Barre..CouleurFond = Couleur(10, 20, 30)
		FIN

		SM_Fichier est un SousMenu
			PROPRIETES
				Libellé = "&Fichier"
			FIN

			OPT_Quitter est une OptionMenu
				PROPRIETES
					Libellé = "&Quitter"
				FIN
			FIN
		FIN
	FIN
FIN
