//  — fenêtre témoin pour le fond de la bande de languettes.
//
// Le fond de fenêtre est un VERT FRANC (RVB(0,200,0)) : aucune couleur du
// rendu système ni du style des languettes n'en approche, donc lire ce vert
// dans la bande prouve qu'elle laisse voir la fenêtre, et lire autre chose
// prouve qu'un fond parasite y est peint.
//
// ONG_Stylise : languettes habillées (poser un style déclenche la feuille de
//               style du champ, donc la déclaration de transparence).
// ONG_Nu      : aucun style — le rendu par défaut doit rester strictement
//               intact.
//
// Les deux champs sont identiques par ailleurs (mêmes libellés, mêmes
// dimensions, même volet actif) pour que leurs captures soient comparables
// pixel à pixel.

FEN_OngletBandeFond est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 520
		Hauteur     = 400
		Titre       = "Fond de la bande de languettes"
		CouleurFond = RVB(0, 200, 0)
	FIN

	ONG_Stylise est un Champ Onglet
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 480
			Hauteur = 160
			Valeur  = 1

			Style..CadreExtérieur..CouleurFond      = Blanc
			Style..CadreExtérieur..Cadre..Couleur   = Vert
			Style..CadreExtérieur..Cadre..Epaisseur = 2

			Style..VoletActif..CouleurFond   = Rouge
			Style..VoletActif..Couleur       = Noir
			Style..VoletInactif..CouleurFond = Bleu
			Style..VoletInactif..Couleur     = Blanc
		FIN

		VOL_StyliseUn est un Volet
			PROPRIETES
				Libellé     = "Profil"
				Disposition = dispLibre
			FIN
		FIN

		VOL_StyliseDeux est un Volet
			PROPRIETES
				Libellé     = "Options"
				Disposition = dispLibre
			FIN
		FIN
	FIN

	ONG_Nu est un Champ Onglet
		PROPRIETES
			X       = 10
			Y       = 210
			Largeur = 480
			Hauteur = 160
			Valeur  = 1
		FIN

		VOL_NuUn est un Volet
			PROPRIETES
				Libellé     = "Profil"
				Disposition = dispLibre
			FIN
		FIN

		VOL_NuDeux est un Volet
			PROPRIETES
				Libellé     = "Options"
				Disposition = dispLibre
			FIN
		FIN
	FIN
FIN
