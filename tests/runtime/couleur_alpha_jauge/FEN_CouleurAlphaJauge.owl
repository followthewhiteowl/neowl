//  (LOT 4) — opacité sur `Style..Libellé..Couleur` (texte % affiché
// sur un Champ Jauge). Ce texte est peint via QPen/QPalette (owl_jauge_draw_text),
// pas via QSS `color:` — cf. owl_ui.h ~L1260-1261.
//
// CadreExtérieur..CouleurFond ET Remplissage..CouleurFond sont posés à la
// MÊME couleur opaque (rouge pur) sur chaque jauge : le texte % est ainsi
// peint sur un fond ROUGE uniforme, que le trait "50%" chevauche la piste ou
// le remplissage (Valeur=50 -> le remplissage occupe la moitié gauche du
// widget horizontal).
FEN_CouleurAlphaJauge est une Fenêtre
	PROPRIETES
		Titre       = "Alpha Jauge — texte %"
		Largeur     = 360
		Hauteur     = 180
		Disposition = dispLibre
		CouleurFond = RVB(255, 0, 0)
	FIN

	JAU_Opaque est un Champ Jauge
		PROPRIETES
			X                                  = 20
			Y                                  = 20
			Largeur                            = 300
			Hauteur                            = 50
			BorneMin                           = 0
			BorneMax                           = 100
			Valeur                             = 50
			Style..CadreExtérieur..CouleurFond = RVB(255, 0, 0)
			Style..Remplissage..CouleurFond    = RVB(255, 0, 0)
			Style..Libellé..Couleur            = RVB(0, 255, 0)
			Style..Libellé..Police..Taille     = 24
			Style..Libellé..Police..Gras       = Vrai
		FIN
	FIN

	JAU_Alpha est un Champ Jauge
		PROPRIETES
			X                                  = 20
			Y                                  = 100
			Largeur                            = 300
			Hauteur                            = 50
			BorneMin                           = 0
			BorneMax                           = 100
			Valeur                             = 50
			Style..CadreExtérieur..CouleurFond = RVB(255, 0, 0)
			Style..Remplissage..CouleurFond    = RVB(255, 0, 0)
			Style..Libellé..Couleur            = {Rouge = 0, Vert = 255, Bleu = 0, Opacité = 128}
			Style..Libellé..Police..Taille     = 24
			Style..Libellé..Police..Gras       = Vrai
		FIN
	FIN
FIN
