// Cadre Phase 5 — exercice complet : 5 scalaires + 4 Coin* + 4 Trait*.
// Single source of truth pour les sous-objets canon de référence.

monCadre est un Cadre

// Scalaires
monCadre..Couleur   = RougeClair
monCadre..Epaisseur = 3
monCadre..Trait     = TraitDouble
monCadre..Arrondi   = 5
monCadre..Bords     = BordHaut + BordDroite + BordBas + BordGauche

// 4 Coins
monCadre..CoinHautGauche..Largeur = 8
monCadre..CoinHautGauche..Hauteur = 6
monCadre..CoinHautDroite..Largeur = 4
monCadre..CoinHautDroite..Hauteur = 4
monCadre..CoinBasGauche..Largeur  = 2
monCadre..CoinBasGauche..Hauteur  = 2
monCadre..CoinBasDroite..Largeur  = 0
monCadre..CoinBasDroite..Hauteur  = 0

// 4 Traits per-bord
monCadre..TraitHaut..Type      = TraitContinu
monCadre..TraitHaut..Couleur   = BleuFoncé
monCadre..TraitHaut..Epaisseur = 4
monCadre..TraitBas..Type       = TraitTiret
monCadre..TraitBas..Couleur    = RougeFoncé
monCadre..TraitBas..Epaisseur  = 2
monCadre..TraitGauche..Type    = TraitPointillé
monCadre..TraitDroite..Type    = TraitDouble

// Verifie que tout est lisible
dbgVérifieEgalité(monCadre..Couleur, RougeClair, "scalar Couleur")
dbgVérifieEgalité(monCadre..Epaisseur, 3, "scalar Epaisseur")
dbgVérifieEgalité(monCadre..Trait, TraitDouble, "scalar Trait")
dbgVérifieEgalité(monCadre..CoinHautGauche..Largeur, 8, "CoinHG..Largeur")
dbgVérifieEgalité(monCadre..CoinHautGauche..Hauteur, 6, "CoinHG..Hauteur")
dbgVérifieEgalité(monCadre..CoinHautDroite..Largeur, 4, "CoinHD..Largeur")
dbgVérifieEgalité(monCadre..CoinBasGauche..Largeur, 2, "CoinBG..Largeur")
dbgVérifieEgalité(monCadre..TraitHaut..Type, TraitContinu, "TraitHaut..Type")
dbgVérifieEgalité(monCadre..TraitHaut..Couleur, BleuFoncé, "TraitHaut..Couleur")
dbgVérifieEgalité(monCadre..TraitHaut..Epaisseur, 4, "TraitHaut..Epaisseur")
dbgVérifieEgalité(monCadre..TraitBas..Type, TraitTiret, "TraitBas..Type")
dbgVérifieEgalité(monCadre..TraitGauche..Type, TraitPointillé, "TraitGauche..Type")
dbgVérifieEgalité(monCadre..TraitDroite..Type, TraitDouble, "TraitDroite..Type")

dbgBilanTest()
