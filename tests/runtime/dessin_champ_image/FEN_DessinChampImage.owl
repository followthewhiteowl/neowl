// Fenêtre voisine — ressource pour test_dessin_champ_image.owl (,
// dessin direct sur un Champ Image via dDébutDessin/d*/dFinDessin, parité
// canon : plus besoin de passer par une variable Image intermédiaire).
//
// IMG_Cible : aucune propriété Image déclarée — le backing dessinable doit
// être créé à la demande par dDébutDessin, dimensionné sur Largeur×Hauteur.

FEN_DessinChampImage est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 300
		Hauteur     = 300
		Titre       = "Dessin direct sur un Champ Image"
	FIN

	IMG_Cible est un Champ Image
		PROPRIETES
			X           = 10
			Y           = 10
			Largeur     = 100
			Hauteur     = 100
			CouleurFond = Blanc
		FIN
	FIN
FIN
