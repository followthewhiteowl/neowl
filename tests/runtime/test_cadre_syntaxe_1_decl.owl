// Cadre Phase 3 syntaxe 1 — declaration + assignation des sous-props.
// Canon de référence exemple 1 (premieres lignes).

monCadre est un Cadre
monCadre..Couleur   = RougeClair
monCadre..Epaisseur = 5
monCadre..Trait     = TraitContinu
monCadre..Arrondi   = 6
monCadre..Bords     = BordHaut + BordBas

dbgVérifieEgalité(monCadre..Couleur, RougeClair, "Couleur set OK")
dbgVérifieEgalité(monCadre..Epaisseur, 5, "Epaisseur set OK")
dbgVérifieEgalité(monCadre..Trait, TraitContinu, "Trait set OK")
dbgVérifieEgalité(monCadre..Arrondi, 6, "Arrondi set OK")
dbgVérifieEgalité(monCadre..Bords, BordHaut + BordBas, "Bords set OK")

dbgBilanTest()
