//  — cascade directe `BTN..Style..CadreExtérieur..Ombre..Flou = ...`
// sur un Champ Bouton (hors Thème, affectation runtime).
//
// ROUGE attendu : `Ombre` inconnu sur CadreExtérieur aujourd'hui (champ
// inexistant sur styleBouton..CadreExtérieur).
//
// Le RENDU visuel réel de l'ombre est HORS SCOPE : ce test verrouille
// uniquement le compile + round-trip headless de la cascade directe.

TestModeHeadless(Vrai)

Ouvre(FEN_StyleBoutonOmbreCascade)

BTN_Zone..Style..CadreExtérieur..Ombre..Couleur = Bleu
dbgVérifieEgalité(BTN_Zone..Style..CadreExtérieur..Ombre..Couleur, Bleu, "cascade directe : Ombre..Couleur round-trip")

BTN_Zone..Style..CadreExtérieur..Ombre..DécalageX = 2
dbgVérifieEgalité(BTN_Zone..Style..CadreExtérieur..Ombre..DécalageX, 2, "cascade directe : Ombre..DécalageX round-trip")

BTN_Zone..Style..CadreExtérieur..Ombre..DécalageY = 4
dbgVérifieEgalité(BTN_Zone..Style..CadreExtérieur..Ombre..DécalageY, 4, "cascade directe : Ombre..DécalageY round-trip")

BTN_Zone..Style..CadreExtérieur..Ombre..Flou = 10
dbgVérifieEgalité(BTN_Zone..Style..CadreExtérieur..Ombre..Flou, 10, "cascade directe : Ombre..Flou round-trip")

BTN_Zone..Style..CadreExtérieur..Ombre..Étendue = 1
dbgVérifieEgalité(BTN_Zone..Style..CadreExtérieur..Ombre..Étendue, 1, "cascade directe : Ombre..Étendue round-trip")

dbgVérifieVrai(Vrai, "fenêtre avec cascade Ombre compile et se lance sans crash")

Ferme(FEN_StyleBoutonOmbreCascade)

dbgBilanTest()
