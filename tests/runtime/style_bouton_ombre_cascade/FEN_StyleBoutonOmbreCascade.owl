//  — support pour la cascade directe
// `BTN..Style..CadreExtérieur..Ombre..Flou = ...` sur un Champ Bouton.
FEN_StyleBoutonOmbreCascade est une Fenêtre
	PROPRIETES
		Titre       = "Style Bouton — cascade Ombre"
		Largeur     = 400
		Hauteur     = 120
		Disposition = dispLibre
	FIN

	BTN_Zone est un Champ Bouton
		PROPRIETES
			X       = 20
			Y       = 20
			Largeur = 300
			Hauteur = 60
			Libellé = "Valider"
		FIN
	FIN
FIN
