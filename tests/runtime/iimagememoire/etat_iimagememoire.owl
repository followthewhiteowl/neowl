// Ressource Etat utilisee par test_iimagememoire.owl.
//
// Etat A4 portrait simple sur 2 pages : un libelle par page. On force
// 2 pages via PROCEDURE Lecture qui imprime explicitement le Corps,
// fait un iSautePage(), puis laisse le Corps auto de iImprimeEtat
// produire la 2e page.

ETAT_DeuxPages est un Etat
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
		MargeHaut   = 10
		MargeBas    = 10
		MargeGauche = 10
		MargeDroite = 10
	FIN

	corps est un Corps
		PROPRIETES
			Hauteur = 30
		FIN

		LIB_Titre est un Champ Libelle
			PROPRIETES
				Libelle      = "Page rasterisee"
				X            = 20
				Y            = 10
				Largeur      = 120
				Hauteur      = 15
				PoliceNom    = iPoliceLiberationSans
				PoliceTaille = 14
			FIN
		FIN
	FIN

	// Imprime le Corps une 1ere fois puis force un saut de page avant
	// que iImprimeEtat ne fasse l'impression Corps auto (page 2).
	PROCEDURE Lecture()
		iImprimeBloc("corps")
		iSautePage()
	FIN
FIN
