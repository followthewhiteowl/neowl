// Fenêtre voisine — champ Saisie num SANS FormatNombre (ni champ ni projet),
// pour vérifier que le comportement plat (point = décimal naturel) reste
// inchangé après le fix strict-config.

FEN_SaisieNumPlat est une Fenêtre
	PROPRIETES
		Titre       = "Saisie num - format plat (non-régression)"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 160
	FIN

	SAI_Num est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 10
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieNum
			Valeur     = ""
		FIN
	FIN

	SAI_Autre est un Champ Saisie
		PROPRIETES
			X       = 10
			Y       = 50
			Largeur = 180
			Hauteur = 24
			Valeur  = ""
		FIN
	FIN
FIN
