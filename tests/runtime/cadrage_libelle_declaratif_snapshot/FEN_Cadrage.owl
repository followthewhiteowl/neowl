// Fenetre voisine pour le test d'alignement de texte d'un Libelle.
// Deux libelles identiques sauf le cadrage horizontal : l'un colle le
// texte a droite, l'autre a gauche. Le fond plein permet de localiser
// les pixels de texte par capture.

FEN_Cadrage est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 200
		Titre       = "Cadrage Libelle"
	FIN
	LIB_Droite est un Champ Libellé
		PROPRIETES
			X                 = 20
			Y                 = 20
			Largeur           = 300
			Hauteur           = 50
			Libellé           = "ABCDEFGHIJKLMNOP"
			CadrageHorizontal = chDroite
			CouleurFond       = RVB(50, 50, 50)
		FIN
	FIN
	LIB_Gauche est un Champ Libellé
		PROPRIETES
			X                 = 20
			Y                 = 90
			Largeur           = 300
			Hauteur           = 50
			Libellé           = "ABCDEFGHIJKLMNOP"
			CadrageHorizontal = chGauche
			CouleurFond       = RVB(50, 50, 50)
		FIN
	FIN
	LIB_Bas est un Champ Libellé
		PROPRIETES
			X                 = 20
			Y                 = 150
			Largeur           = 300
			Hauteur           = 80
			Libellé           = "ABCDEFGHIJKLMNOP"
			CadrageHorizontal = chGauche
			CadrageVertical   = cvBas
			CouleurFond       = RVB(50, 50, 50)
		FIN
	FIN
FIN
