//  : type de retour de procédure typé sur un type utilisateur
// homonyme. La valeur renvoyée doit exposer le membre utilisateur
// (Marqueur), pas les propriétés du type intégré masqué.
PROCEDURE construitCouleur(sValeur est une chaîne) : Couleur
	res est un Couleur
	res.Marqueur = sValeur
	RENVOYER res
FIN

r est un Couleur = construitCouleur("retourné")
dbgVérifieEgalité(r.Marqueur, "retourné", "membre utilisateur accessible sur la valeur de retour")

dbgBilanTest()
