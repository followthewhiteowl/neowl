//  : variable simple typée sur un type utilisateur homonyme.
// Le membre utilisateur (Marqueur) doit rester lisible/écrivable après
// plusieurs affectations successives — pas seulement au premier accès.
c est un Couleur
c.Marqueur = "premier"
dbgVérifieEgalité(c.Marqueur, "premier", "premiere affectation lue correctement")

c.Marqueur = "second"
dbgVérifieEgalité(c.Marqueur, "second", "seconde affectation lue correctement")

dbgBilanTest()
