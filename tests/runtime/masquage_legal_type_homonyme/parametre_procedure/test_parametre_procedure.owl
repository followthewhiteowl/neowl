//  : paramètre de procédure typé sur un type utilisateur homonyme.
// Le membre utilisateur (Marqueur) doit être accessible en lecture et en
// écriture à travers le paramètre.
PROCEDURE marque(p est un Couleur, sValeur est une chaîne)
	p.Marqueur = sValeur
	dbgVérifieEgalité(p.Marqueur, sValeur, "membre utilisateur accessible via paramètre")
FIN

c est un Couleur
marque(c, "paramétré")

dbgBilanTest()
