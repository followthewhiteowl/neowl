//  — Champ CodeBarres : déclaration + props canon dans une Fenêtre.
// Calque du Champ Image : mêmes props génériques (X/Y/Largeur/Hauteur/
// Visible/Etat) + props canon du type CodeBarres (TypeCodeBarres/Contenu/
// CorrectionErreur, ).
//
// ROUGE attendu : le widget 'Champ CodeBarres' n'existe pas encore
// (compile-fail : contrôle inconnu / prop inconnue sur ce contrôle).

Ouvre(FEN_ChampCodeBarres)

dbgVérifieEgalité(LireTypeCodeBarres(), CB_QRCODE,
"CBA_Test : TypeCodeBarres posé = CB_QRCODE")
dbgVérifieEgalité(LireContenu(), "https://www.example.com/champ",
"CBA_Test : Contenu posé")
dbgVérifieEgalité(LireCorrectionErreur(), 2,
"CBA_Test : CorrectionErreur posée")
dbgVérifieEgalité(LireLargeur(), 150,
"CBA_Test : Largeur posée (prop générique de Champ)")
dbgVérifieEgalité(LireHauteur(), 150,
"CBA_Test : Hauteur posée (prop générique de Champ)")
dbgVérifieEgalité(LireVisible(), Vrai,
"CBA_Test : Visible posé (prop générique de Champ)")

Ferme(FEN_ChampCodeBarres)
dbgBilanTest()
