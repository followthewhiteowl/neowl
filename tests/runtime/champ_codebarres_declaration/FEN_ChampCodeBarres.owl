// Fenêtre voisine — ressource pour test_champ_codebarres_declaration.owl.
// Calque strict du Champ Image : mêmes props génériques de
// géométrie/état + les props canon du type CodeBarres.

FEN_ChampCodeBarres est une Fenêtre
	PROPRIETES
		Titre       = "Test déclaration Champ CodeBarres"
		Largeur     = 400
		Hauteur     = 300
		Disposition = dispLibre
	FIN

	CBA_Test est un Champ CodeBarres
		PROPRIETES
			X                = 10
			Y                = 10
			Largeur          = 150
			Hauteur          = 150
			TypeCodeBarres   = CB_QRCODE
			Contenu          = "https://www.example.com/champ"
			CorrectionErreur = 2
			Visible          = Vrai
			Etat             = Actif
		FIN
	FIN

	PROCEDURE LireTypeCodeBarres()
		RENVOYER CBA_Test..TypeCodeBarres
	FIN

	PROCEDURE LireContenu()
		RENVOYER CBA_Test..Contenu
	FIN

	PROCEDURE LireCorrectionErreur()
		RENVOYER CBA_Test..CorrectionErreur
	FIN

	PROCEDURE LireLargeur()
		RENVOYER CBA_Test..Largeur
	FIN

	PROCEDURE LireHauteur()
		RENVOYER CBA_Test..Hauteur
	FIN

	PROCEDURE LireVisible()
		RENVOYER CBA_Test..Visible
	FIN
FIN
