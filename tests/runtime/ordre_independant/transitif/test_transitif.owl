//  — ordre-independant transitif (3 niveaux)
//
// Appel top-level -> HelperMilieu (defini plus bas) -> HelperBas (defini encore plus bas)
// Avant  : erreur compile "HelperMilieu : fonction/procedure inconnue"
// Apres  : OK, les 3 procedures resolues en pre-passe.

res est une chaîne = HelperMilieu("debut")

dbgVérifieEgalité(res, "debut > milieu > bas", "chaine transitive doit fonctionner")
dbgBilanTest()

// PROCEDURE MILIEU appelle HelperBas defini PLUS BAS
PROCEDURE HelperMilieu(s est une chaîne) : chaîne
	RENVOYER s + " > " + HelperBas("milieu")
FIN

// PROCEDURE BAS (fin de chaine)
PROCEDURE HelperBas(s est une chaîne) : chaîne
	RENVOYER s + " > bas"
FIN
