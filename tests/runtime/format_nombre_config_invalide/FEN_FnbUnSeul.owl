//  — champ numérique avec un seul séparateur défini (décimal ',',
// milliers vide). Non-régression : un seul séparateur n'est jamais un conflit.
FEN_FnbUnSeul est une Fenêtre
	PROPRIETES
		Titre       = "FormatNombre un seul séparateur"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 120
	FIN
	SAI_UnSeul est un Champ Saisie
		PROPRIETES
			X            = 10
			Y            = 10
			Largeur      = 180
			Hauteur      = 24
			TypeSaisie   = typSaisieNum
			FormatNombre = {SéparateurDécimal = ",", ChiffresAprèsVirgule = 2}
			Valeur       = ""
		FIN
	FIN
FIN
