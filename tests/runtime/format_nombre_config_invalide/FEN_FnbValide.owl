//  — champ numérique avec un FormatNombre inline sain (milliers=' ',
// décimal=','). Non-régression : aucune erreur ne doit être levée.
FEN_FnbValide est une Fenêtre
	PROPRIETES
		Titre       = "FormatNombre valide"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 120
	FIN
	SAI_Valide est un Champ Saisie
		PROPRIETES
			X            = 10
			Y            = 10
			Largeur      = 180
			Hauteur      = 24
			TypeSaisie   = typSaisieNum
			FormatNombre = {SéparateurMilliers = " ", SéparateurDécimal = ",", ChiffresAprèsVirgule = 2}
			Valeur       = ""
		FIN
	FIN
FIN
