// Fenêtre voisine — ressource partagée des tests de contrat de
// tests\runtime\table_colonne_combo_contrat\.
//
// Une Table à deux colonnes : COL_Libellé (texte, rang 1) et COL_Pays
// (combo, rang 2), assez pour exercer les trois formes d'adressage de
// cellule déjà documentées (ligne-first, virgule, colonne-first) sur la
// propriété `..Contenu` d'une colonne combo.

FEN_TableColonneCombo est une Fenêtre
	PROPRIETES
		Titre   = "Lot"
		Largeur = 360
		Hauteur = 220
	FIN

	TABLE_Lot est un Champ Table
		PROPRIETES
			Étire = Vrai
		FIN

		COL_Libellé est une Colonne
			PROPRIETES
				Libellé = "Libellé"
				Type    = colTypeTexte
				Largeur = 160
			FIN
		FIN

		COL_Pays est une Colonne
			PROPRIETES
				Libellé = "Pays"
				Type    = colTypeCombo
				Contenu = `France
Belgique
Suisse`
				Largeur = 160
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		TableAjouteLigne(TABLE_Lot, "Un", "France")
		TableAjouteLigne(TABLE_Lot, "Deux", "Belgique")
	FIN
FIN
