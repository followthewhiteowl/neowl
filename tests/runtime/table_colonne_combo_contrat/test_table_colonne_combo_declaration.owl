// Contrat 1+2+7 (feat colonne combo) : une Colonne déclarée avec
// `Type = colTypeCombo` expose sa liste par défaut via `..Contenu` au
// niveau colonne, et la valeur sélectionnée d'une cellule reste lisible
// par l'accès valeur normal (`TABLE[ligne].COL`, store ligne-first,
// inchangé par l'ajout de la colonne combo).

TestModeHeadless(Faux)

PROCEDURE PUBLIQUE scenario_colonne_combo_declarable_avec_contenu_par_defaut()
	OuvreSoeur(FEN_TableColonneCombo)

	dbgVérifieEgalité(COL_Pays..Contenu, `France
Belgique
Suisse`,
	"une colonne de type combo expose la liste déclarée dans son bloc PROPRIETES")

	dbgVérifieEgalité(TABLE_Lot[1].COL_Pays, "France",
	"la valeur sélectionnée d'une cellule combo reste lisible par l'accès valeur normal")

	Ferme(FEN_TableColonneCombo)
FIN
