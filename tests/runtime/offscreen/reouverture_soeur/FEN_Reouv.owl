// Ressource fenetre — voisin de test_reouverture_soeur.owl.
// Classe /0522 : apres Ferme + re-OuvreSoeur, les handlers
// de la seconde instance doivent fonctionner (pas de bindings zombies
// de la premiere instance). Teste avec un champ Saisie et surAChaqueModification.

FEN_Reouv est une Fenêtre
	PROPRIETES
		Titre       = "Reouverture soeur"
		Largeur     = 300
		Hauteur     = 200
		Disposition = dispLibre
	FIN

	nModifInstance est un entier = 0

	SAI_Champ est un Champ Saisie
		PROPRIETES
			X       = 20
			Y       = 20
			Largeur = 200
		FIN
		PROCEDURE surAChaqueModification()
			nModifInstance += 1
			callback_modif_reouv(nModifInstance)
		FIN
	FIN

	PROCEDURE FinInitialisation()
		nModifInstance = 0
		callback_reouv_prete()
	FIN
FIN
