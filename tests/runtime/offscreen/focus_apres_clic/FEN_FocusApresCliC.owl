// Ressource fenetre — voisin de test_focus_apres_clic.owl.
// Fenetre avec un Bouton et un champ Saisie. Verifie que DonneFocus(SAI_Texte)
// dans surClic repose le focus clavier sur le champ (classe ).

FEN_FocusApresCliC est une Fenêtre
	PROPRIETES
		Titre       = "Focus apres clic"
		Largeur     = 400
		Hauteur     = 200
		Disposition = dispLibre
	FIN

	nEntreeSaisie est un entier = 0

	BTN_Action est un Champ Bouton
		PROPRIETES
			X       = 20
			Y       = 20
			Largeur = 100
			Libellé = "Action"
		FIN
		PROCEDURE surClic()
			// Apres clic bouton, le focus Qt est sur le bouton.
			// DonneFocus doit le reposer sur la Saisie.
			DonneFocus(SAI_Texte)
		FIN
	FIN

	SAI_Texte est un Champ Saisie
		PROPRIETES
			X       = 20
			Y       = 60
			Largeur = 200
		FIN
		PROCEDURE surEntrée()
			nEntreeSaisie += 1
			callback_entree_saisie(nEntreeSaisie)
		FIN
	FIN
FIN
