// Ressource fenetre — voisin de test_timer_reel.owl.
// Fenetre avec un timer 50ms. Chaque tic incremente nTics et appelle
// callback_tic au script test. Le timer est arme dans FinInitialisation.

FEN_TimerReel est une Fenêtre
	PROPRIETES
		Titre       = "Timer reel offscreen"
		Largeur     = 300
		Hauteur     = 200
		Disposition = dispLibre
	FIN

	nTics est un entier = 0
	tTimer est un Timer

	PROCEDURE FinInitialisation()
		PROCEDURE ActionTic()
			nTics += 1
			callback_tic(nTics)
		FIN
		tTimer..Intervalle = 50
		tTimer..Procédure  = ActionTic
		tTimer..Répète     = Vrai
		TimerDémarre(tTimer)
	FIN

	PROCEDURE ArretTimer()
		TimerArrête(tTimer)
	FIN
FIN
