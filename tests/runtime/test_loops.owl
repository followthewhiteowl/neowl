Trace("=== SORTIR / CONTINUER ===")

// SORTIR in BOUCLE
n est un entier = 0
BOUCLE
	n++
	SI n >= 5 ALORS
		SORTIR
	FIN
FIN
dbgVérifieEgalité(n, 5, "SORTIR from BOUCLE at 5")

// SORTIR in POUR
nSum est un entier = 0
POUR i = 1 À 100
	SI i > 10 ALORS
		SORTIR
	FIN
	nSum += i
FIN
dbgVérifieEgalité(nSum, 55, "SORTIR from POUR after 10")

// CONTINUER in POUR (skip odd numbers)
nEven est un entier = 0
POUR i = 1 À 10
	SI i % 2 = 1 ALORS
		CONTINUER
	FIN
	nEven += i
FIN
dbgVérifieEgalité(nEven, 30, "CONTINUER skip odd: 2+4+6+8+10=30")

// SORTIR in TANTQUE
nW est un entier = 0
TANTQUE Vrai
	nW++
	SI nW = 7 ALORS
		SORTIR
	FIN
FIN
dbgVérifieEgalité(nW, 7, "SORTIR from TANTQUE at 7")

// Nested loops with SORTIR
nOuter est un entier = 0
POUR i = 1 À 5
	POUR j = 1 À 5
		SI j = 3 ALORS
			SORTIR
		FIN
	FIN
	nOuter++
FIN
dbgVérifieEgalité(nOuter, 5, "SORTIR inner loop, outer continues")

// CONTINUER in TANTQUE
nSkip est un entier = 0
nCount est un entier = 0
TANTQUE nCount < 10
	nCount++
	SI nCount % 3 = 0 ALORS
		CONTINUER
	FIN
	nSkip++
FIN
dbgVérifieEgalité(nSkip, 7, "CONTINUER in TANTQUE: skip multiples of 3")

