// Ressource test  — Etat baseline identique SANS Champ CodeBarres.
// Sert de reference de taille PDF face a ETAT_CBAvec. Voisin lu par
// test_etat_codebarre.owl.

ETAT_CBSans est un Etat
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
		MargeHaut   = 15
		MargeBas    = 15
		MargeGauche = 15
		MargeDroite = 15
	FIN

	corps est un Corps
		PROPRIETES
			Hauteur = 55
		FIN

		LIB_Titre est un Champ Libellé
			PROPRIETES
				Libellé = "Code-barres en Etat"
				X       = 0
				Y       = 0
				Largeur = 170
				Hauteur = 10
			FIN
		FIN
	FIN
FIN
