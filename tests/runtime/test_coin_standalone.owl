// Verifie que Coin est declarable comme type composé standalone
// (corrige le pattern d'avant ou il etait orphelin du registry —
// declarable seulement via Cadre..CoinX).

c est un Coin
c..Largeur = 10
c..Hauteur = 20
dbgVérifieEgalité(c..Largeur, 10, "Coin standalone — Largeur")
dbgVérifieEgalité(c..Hauteur, 20, "Coin standalone — Hauteur")

// Pareil pour Trait
t est un Trait
t..Couleur   = 16711680 // bleu
t..Epaisseur = 2
t..Type      = TraitTiret
dbgVérifieEgalité(t..Couleur, 16711680, "Trait standalone — Couleur")
dbgVérifieEgalité(t..Epaisseur, 2, "Trait standalone — Epaisseur")
dbgVérifieEgalité(t..Type, TraitTiret, "Trait standalone — Type=TraitTiret")

// Et Option (item Sélecteur/Combo/Liste)
o est un Option
o..Libellé        = "Pomme"
o..ValeurRenvoyée = "POM"
dbgVérifieEgalité(o..Libellé, "Pomme", "Option standalone — Libellé")
dbgVérifieEgalité(o..ValeurRenvoyée, "POM", "Option standalone — ValeurRenvoyée")

dbgBilanTest()
