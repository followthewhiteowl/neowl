// Fenetre voisine pour le test de couleur de texte declaree sur des
// widgets a options/items (Selecteur, Liste, Combo, Interrupteur).
//
// Chaque widget porte une CouleurFond sombre distincte et une Couleur de
// texte vive et pure (un seul canal a 255 ou deux canaux), afin que la
// capture pixel puisse localiser sans ambiguite les pixels de texte au
// coeur des glyphes (la couleur pure y est preservee malgre l'antialiasing
// sur les bords).

FEN_CouleurWidgets est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 480
		Titre       = "Couleur widgets declaree"
	FIN

	// Selecteur : texte jaune pur RVB(255,255,0) sur fond sombre.
	SEL_Test est un Champ Sélecteur
		PROPRIETES
			X           = 10
			Y           = 10
			Largeur     = 360
			Hauteur     = 100
			Options     = ["Alpha", "Bravo", "Charlie"]
			Couleur     = RVB(255, 255, 0)
			CouleurFond = RVB(20, 20, 20)
		FIN
	FIN

	// Liste : texte vert pur RVB(0,255,0) sur fond sombre.
	LST_Test est un Champ Liste
		PROPRIETES
			X       = 10
			Y       = 120
			Largeur = 360
			Hauteur = 100
			Contenu = `Pomme
Banane
Cerise`
			Couleur     = RVB(0, 255, 0)
			CouleurFond = RVB(20, 20, 20)
		FIN
	FIN

	// Combo : texte magenta pur RVB(255,0,255) sur fond sombre. Le texte
	// affiche (ligne selectionnee) est le sujet du pixel-check.
	CMB_Test est un Champ Combo
		PROPRIETES
			X            = 10
			Y            = 230
			Largeur      = 360
			Hauteur      = 40
			PoliceTaille = 16
			Contenu      = `Janvier
Fevrier
Decembre WWWWWWWW`
			ValeurInitiale = 3
			Couleur        = RVB(255, 0, 255)
			CouleurFond    = RVB(20, 20, 20)
		FIN
	FIN

	// Interrupteur : texte cyan pur RVB(0,255,255) sur fond sombre.
	INT_Test est un Champ Interrupteur
		PROPRIETES
			X           = 10
			Y           = 280
			Largeur     = 360
			Hauteur     = 100
			Options     = ["Lecture", "Ecriture", "Execution"]
			Couleur     = RVB(0, 255, 255)
			CouleurFond = RVB(20, 20, 20)
		FIN
	FIN
FIN
