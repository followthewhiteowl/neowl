//  — deux Champs Onglet au style identique (languette active ROUGE en
// police grasse, languettes inactives BLEUES), qui ne different que par le mode
// de largeur des languettes. Les deux fonds servent de regle graduee : les
// frontieres rouge/bleu donnent la largeur de chaque languette en pixels.

FEN_OngletLargeurPolice est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 640
		Hauteur     = 420
		Titre       = "Largeur des languettes et police du volet actif"
	FIN

	// Largeur égale : toutes les languettes se calent sur la plus large.
	ONG_Egal est un Champ Onglet
		PROPRIETES
			X       = 0
			Y       = 0
			Largeur = 600
			Hauteur = 180

			LargeurVolets = largeurÉgale

			Style..VoletActif..CouleurFond   = Rouge
			Style..VoletActif..Couleur       = Noir
			Style..VoletActif..Police..Gras  = Vrai
			Style..VoletInactif..CouleurFond = Bleu
			Style..VoletInactif..Couleur     = Blanc
		FIN

		VOL_EgalUn est un Volet
			PROPRIETES
				Libellé     = "Ok"
				Disposition = dispLibre
			FIN
		FIN

		VOL_EgalDeux est un Volet
			PROPRIETES
				Libellé     = "Un libellé nettement plus long"
				Disposition = dispLibre
			FIN
		FIN

		VOL_EgalTrois est un Volet
			PROPRIETES
				Libellé     = "Avancé"
				Disposition = dispLibre
			FIN
		FIN
	FIN

	// Même style, largeur proportionnelle : chaque languette épouse son texte.
	ONG_Prop est un Champ Onglet
		PROPRIETES
			X       = 0
			Y       = 200
			Largeur = 600
			Hauteur = 180

			LargeurVolets = largeurProportionnelle

			Style..VoletActif..CouleurFond   = Rouge
			Style..VoletActif..Couleur       = Noir
			Style..VoletActif..Police..Gras  = Vrai
			Style..VoletInactif..CouleurFond = Bleu
			Style..VoletInactif..Couleur     = Blanc
		FIN

		VOL_PropUn est un Volet
			PROPRIETES
				Libellé     = "Ok"
				Disposition = dispLibre
			FIN
		FIN

		VOL_PropDeux est un Volet
			PROPRIETES
				Libellé     = "Un libellé nettement plus long"
				Disposition = dispLibre
			FIN
		FIN

		VOL_PropTrois est un Volet
			PROPRIETES
				Libellé     = "Avancé"
				Disposition = dispLibre
			FIN
		FIN
	FIN
FIN
