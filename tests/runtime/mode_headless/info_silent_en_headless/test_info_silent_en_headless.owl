// Info silent en mode headless : ne plante pas, ne bloque pas.
// OWL n'a pas de type 'variant' generique pour capturer le retour,
// on verifie que la sequence s'execute sans erreur (assertion finale).
TestModeHeadless(Vrai)

Info("salut")
Info("deuxieme")
Info("troisieme")
dbgVérifieVrai(Vrai, "3 appels Info en headless OK (pas de blocage, pas d'erreur)")
