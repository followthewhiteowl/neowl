// dChargeImage doit renvoyer une erreur explicite et lisible quand on lui
// passe un fichier .heic ou .heif. Format non pris en charge — pas de
// décodeur embarqué dans OWL.

img1 est une Image = dChargeImage("photo.heic")
dbgVérifieEgalité(img1..Valide, Faux, "HEIC: chargement marqué invalide")
dbgVérifieVrai(ErreurInfo() <> "", "ErreurInfo capture erreur apres echec")

img2 est une Image = dChargeImage("photo.HEIF")
dbgVérifieEgalité(img2..Valide, Faux, "HEIF maj: chargement marqué invalide")
dbgVérifieVrai(ErreurInfo() <> "", "ErreurInfo capture erreur apres echec")
