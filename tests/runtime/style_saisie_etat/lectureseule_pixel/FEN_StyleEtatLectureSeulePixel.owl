//  — Style[lectureSeule] réconcilié avec Etat = AffichageSeulement
// (setReadOnly(true) sur Saisie → pseudo-classe Qt :read-only).
FEN_StyleEtatLectureSeulePixel est une Fenêtre
	PROPRIETES
		Titre       = "Style état lecture seule"
		Largeur     = 560
		Hauteur     = 120
		Disposition = dispLibre
		CouleurFond = RVB(10, 10, 10)
	FIN

	SAI_Cible est un Champ Saisie
		PROPRIETES
			X                                                        = 20
			Y                                                        = 20
			Largeur                                                  = 500
			Hauteur                                                  = 60
			Style..ZoneSaisie..Etats[lectureSeule]..CouleurFond      = RVB(255, 0, 255)
			Style..ZoneSaisie..Etats[lectureSeule]..Cadre..Couleur   = RVB(255, 165, 0)
			Style..ZoneSaisie..Etats[lectureSeule]..Cadre..Epaisseur = 3
		FIN
	FIN
FIN
