//  — variable nue styleSaisie déclarée au TOP-LEVEL d'un body de
// fenêtre. Le pattern « construire un sty réutilisable puis l'appliquer,
// états compris » doit résoudre le type de la variable comme en script plat.
// Les surcharges d'état vivent sur `sty..ZoneSaisie..Etats[état]..X` (le
// crochet [état] cible le membre Etats de la zone de saisie).
FEN_StyleEtatVarNue est une Fenêtre
	PROPRIETES
		Titre       = "Style état variable nue"
		Largeur     = 200
		Hauteur     = 100
		Disposition = dispLibre
	FIN

	SAI_VN est un Champ Saisie
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 150
		FIN
	FIN

	// Variable nue de la fenêtre, surchargée par état, appliquée au champ.
	sty est un styleSaisie
	sty..CouleurFond                            = RVB(30, 60, 90)
	sty..ZoneSaisie..Etats[survol]..CouleurFond = RVB(0, 255, 0)
	sty..ZoneSaisie..Etats[focus]..Couleur      = RVB(200, 0, 0)

	SAI_VN..Style..CouleurFond                            = sty..CouleurFond
	SAI_VN..Style..ZoneSaisie..Etats[survol]..CouleurFond = sty..ZoneSaisie..Etats[survol]..CouleurFond
	SAI_VN..Style..ZoneSaisie..Etats[focus]..Couleur      = sty..ZoneSaisie..Etats[focus]..Couleur
FIN
