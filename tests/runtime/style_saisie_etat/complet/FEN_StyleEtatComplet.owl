//  — affectation COMPLETE d'un état de la zone de saisie :
// SAI..Style..ZoneSaisie..Etats[focus] = unStyleZoneSaisieBase (toutes ses
// propriétés s'appliquent d'un coup, pas juste un sous-champ isolé). Champ nu,
// sans Style déclaré dans les PROPRIETES : tout vient du script.
FEN_StyleEtatComplet est une Fenêtre
	PROPRIETES
		Titre       = "Style état complet"
		Largeur     = 560
		Hauteur     = 120
		Disposition = dispLibre
		CouleurFond = RVB(10, 10, 10)
	FIN

	SAI_Complet est un Champ Saisie
		PROPRIETES
			X       = 20
			Y       = 20
			Largeur = 500
			Hauteur = 60
		FIN
	FIN
FIN
