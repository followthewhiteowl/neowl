//  — Style[grisé] réconcilié avec Etat = Grisé (Qt :disabled).
// Fenêtre voisine dédiée : Etat est un état PERSISTANT (posé une fois, pas
// transitoire comme le survol souris) → capturable au pixel directement,
// sans DonneFocus ni simulation. SAI_Cible reçoit le style d'état ; aucun
// champ leurre nécessaire ici (Etat ne se propage pas par focus implicite).
FEN_StyleEtatGrisePixel est une Fenêtre
	PROPRIETES
		Titre       = "Style état grisé"
		Largeur     = 560
		Hauteur     = 120
		Disposition = dispLibre
		CouleurFond = RVB(10, 10, 10)
	FIN

	SAI_Cible est un Champ Saisie
		PROPRIETES
			X                                                 = 20
			Y                                                 = 20
			Largeur                                           = 500
			Hauteur                                           = 60
			Style..ZoneSaisie..Etats[grisé]..CouleurFond      = RVB(0, 255, 0)
			Style..ZoneSaisie..Etats[grisé]..Cadre..Couleur   = RVB(0, 128, 255)
			Style..ZoneSaisie..Etats[grisé]..Cadre..Epaisseur = 3
		FIN
	FIN
FIN
