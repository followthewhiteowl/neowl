// Etat voisin — ressource pour test_etat_decl_basic.owl.
// Smoke test : declaration d'Etat compile sans erreur (V2 MVP, pas de runtime).

ETAT_FactureMin est un Etat
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
		MargeHaut   = 20
		MargeBas    = 20
		MargeGauche = 20
		MargeDroite = 20
	FIN

	intro est un EnTeteDocument
		PROPRIETES
			Hauteur = 40
		FIN
		Trace("EnTete document")
	FIN

	haut est un HautDePage
		PROPRIETES
			Hauteur     = 15
			Visible     = Vrai
			CouleurFond = BleuClair
		FIN
		Trace("Haut de page")
	FIN

	ligne est un Corps
		Trace("Corps")
	FIN

	bas est un BasDePage
		Trace("Bas de page")
	FIN

	totaux est une FinDeDocument
		Trace("Fin du document")
	FIN

	separateur est une Iteration
		Trace("Bloc d'iteration libre")
	FIN

	PROCEDURE Filtre()
		// Pas de parametre magique — les params Etat sont des globales
		// accessibles partout (cf 'est un Etat(<params>)' sous-chantier 2A).
		RENVOYER Vrai
	FIN

	PROCEDURE Fermeture()
		Trace("Etat ferme")
	FIN
FIN
