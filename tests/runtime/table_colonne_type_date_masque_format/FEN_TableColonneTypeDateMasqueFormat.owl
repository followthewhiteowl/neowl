// Fenêtre voisine — ressource pour
// test_table_colonne_type_date_masque_format.owl ( lot 1, framework
// type-driven de colonne + câblage Date).
//
// COL_Date       : Type = colTypeDate, AUCUN masque brut déclaré → doit être
//                  piloté par le format date défaut projet (JJ/MM/AAAA), donc
//                  dériver masque + validateur de plages (miroir Saisie
//                  +).
// COL_DateMasque : Type = colTypeDate ET MasqueSaisie brut déclaré → le
//                  masque brut explicite reste un override bas-niveau
//                  (comportement , non affecté par ce ticket).
// COL_Texte      : Type = colTypeTexte, aucun masque → non-régression.
// COL_Numerique  : Type = colTypeNumerique, aucun masque → non-régression
//                  (hors-scope , câblage futur feat suivant).
// COL_Booleen    : Type = colTypeBooleen, aucun masque → non-régression.

FEN_TableColonneTypeDateMasqueFormat est une Fenêtre
	PROPRIETES
		Titre = "Colonne type Date, masque piloté par format"
	FIN

	TAB_ColTypes est un Champ Table
		PROPRIETES
		FIN

		COL_Date est une Colonne
			PROPRIETES
				Libellé = "Date"
				Type    = colTypeDate
				Largeur = 140
			FIN
		FIN

		COL_DateMasque est une Colonne
			PROPRIETES
				Libellé      = "Date (masque brut)"
				Type         = colTypeDate
				Largeur      = 140
				MasqueSaisie = "99-99-9999"
			FIN
		FIN

		COL_Texte est une Colonne
			PROPRIETES
				Libellé = "Texte"
				Type    = colTypeTexte
				Largeur = 140
			FIN
		FIN

		COL_Numerique est une Colonne
			PROPRIETES
				Libellé = "Numérique"
				Type    = colTypeNumerique
				Largeur = 140
			FIN
		FIN

		COL_Booleen est une Colonne
			PROPRIETES
				Libellé = "Booléen"
				Type    = colTypeBooleen
				Largeur = 100
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		TableAjouteLigne(TAB_ColTypes, "12/09/2026", "12-09-2026", "abc", 42, Vrai)
	FIN
FIN
