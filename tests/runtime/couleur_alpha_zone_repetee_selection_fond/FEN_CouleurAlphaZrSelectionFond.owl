//  (LOT 4) — opacité sur `Style..LigneSélectionnée..CouleurFond`
// (fond de la répétition sélectionnée) d'un Champ ZoneRépétée.
FEN_CouleurAlphaZrSelectionFond est une Fenêtre
	PROPRIETES
		Titre       = "Alpha Zone répétée — sélection (fond)"
		Largeur     = 460
		Hauteur     = 340
		Disposition = dispLibre
		CouleurFond = RVB(255, 0, 0)
	FIN

	ZR_SelFondOpaque est un Champ ZoneRépétée
		PROPRIETES
			X                                     = 20
			Y                                     = 20
			Largeur                               = 400
			Hauteur                               = 140
			Sens                                  = zrVertical
			HauteurRepetition                     = 50
			Style..CadreExtérieur..CouleurFond    = RVB(255, 0, 0)
			Style..LigneSélectionnée..CouleurFond = RVB(0, 255, 0)
		FIN

		LIB_Vide3 est un Champ Libellé
			PROPRIETES
				X       = 5
				Y       = 5
				Largeur = 1
				Libellé = ""
			FIN
		FIN
	FIN

	ZR_SelFondAlpha est un Champ ZoneRépétée
		PROPRIETES
			X                                     = 20
			Y                                     = 180
			Largeur                               = 400
			Hauteur                               = 140
			Sens                                  = zrVertical
			HauteurRepetition                     = 50
			Style..CadreExtérieur..CouleurFond    = RVB(255, 0, 0)
			Style..LigneSélectionnée..CouleurFond = {Rouge = 0, Vert = 255, Bleu = 0, Opacité = 128}
		FIN

		LIB_Vide4 est un Champ Libellé
			PROPRIETES
				X       = 5
				Y       = 5
				Largeur = 1
				Libellé = ""
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		j est un entier

		j                                   = ZoneRépétéeAjouteLigne(ZR_SelFondOpaque)
		j                                   = ZoneRépétéeAjouteLigne(ZR_SelFondOpaque)
		ZoneRépétéeSelectPlus(ZR_SelFondOpaque, 2)

		j                                  = ZoneRépétéeAjouteLigne(ZR_SelFondAlpha)
		j                                  = ZoneRépétéeAjouteLigne(ZR_SelFondAlpha)
		ZoneRépétéeSelectPlus(ZR_SelFondAlpha, 2)
	FIN
FIN
