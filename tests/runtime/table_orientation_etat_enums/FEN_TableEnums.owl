// Fenêtre voisine — ressource pour test_table_orientation_etat_enums.owl.
// (pattern split canon strict — cf.  / .)
//
// Verrouille les enums orientationsTable (Vertical) et etatsTableInitial
// (EnSaisie / Grisé / Sélection / NiSaisieNiSélection) déclarés directement
// dans PROPRIETES du Champ Table, au même titre que Orientation et
// EtatInitial.

FEN_TableEnums est une Fenêtre
	PROPRIETES
		Titre       = "Test enums Table"
		Disposition = dispLibre
	FIN

	TAB_Vertical est un Champ Table
		PROPRIETES
			X           = 10
			Y           = 10
			Largeur     = 300
			Hauteur     = 200
			Orientation = Vertical
			EtatInitial = EnSaisie
		FIN

		COL_A est une Colonne
			PROPRIETES
				Libellé = "A"
			FIN
		FIN
	FIN

	TAB_Grise est un Champ Table
		PROPRIETES
			X           = 10
			Y           = 220
			Largeur     = 300
			Hauteur     = 200
			Orientation = Vertical
			EtatInitial = Grisé
		FIN

		COL_A est une Colonne
			PROPRIETES
				Libellé = "A"
			FIN
		FIN
	FIN

	TAB_Selection est un Champ Table
		PROPRIETES
			X           = 320
			Y           = 10
			Largeur     = 300
			Hauteur     = 200
			Orientation = Vertical
			EtatInitial = Sélection
		FIN

		COL_A est une Colonne
			PROPRIETES
				Libellé = "A"
			FIN
		FIN
	FIN

	TAB_NiSaisieNiSelection est un Champ Table
		PROPRIETES
			X           = 320
			Y           = 220
			Largeur     = 300
			Hauteur     = 200
			Orientation = Vertical
			EtatInitial = NiSaisieNiSélection
		FIN

		COL_A est une Colonne
			PROPRIETES
				Libellé = "A"
			FIN
		FIN
	FIN
FIN
