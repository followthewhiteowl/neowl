// Fenêtre voisine — même config que saisie_num_sep_decimal_point_tape
// (décimal "," / milliers "."), pour vérifier la cohérence : taper le
// séparateur décimal CONFIGURÉ directement doit donner le même résultat que
// taper le point du pavé numérique.

FEN_SaisieNumVirguleTape est une Fenêtre
	PROPRIETES
		Titre       = "Saisie num - virgule tapée = décimal configuré"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 160
	FIN

	SAI_Num est un Champ Saisie
		PROPRIETES
			X            = 10
			Y            = 10
			Largeur      = 180
			Hauteur      = 24
			TypeSaisie   = typSaisieNum
			FormatNombre = {SéparateurMilliers = ".", SéparateurDécimal = ",", ChiffresAprèsVirgule = 4}
			Valeur       = ""
		FIN
	FIN

	SAI_Autre est un Champ Saisie
		PROPRIETES
			X       = 10
			Y       = 50
			Largeur = 180
			Hauteur = 24
			Valeur  = ""
		FIN
	FIN
FIN
