// Fenêtre voisine — ressource pour test_window_runtime_window_props.owl.

FEN_TestProps est une Fenêtre
	PROPRIETES
		Titre       = "Test"
		Largeur     = 400
		Hauteur     = 300
		Disposition = dispLibre
	FIN

	BTN_Modifie est un Champ Bouton
		PROPRIETES
			Libellé = "Modifier la fenetre"
		FIN

		PROCEDURE surClic()
			// Lectures
			t est une chaîne = FEN_TestProps..Titre
			l est un entier = FEN_TestProps..Largeur
			h est un entier = FEN_TestProps..Hauteur
			x est un entier = FEN_TestProps..X
			y est un entier = FEN_TestProps..Y
			v est un booléen = FEN_TestProps..Visible
			g est un booléen = FEN_TestProps..Grisé

			// Ecritures
			FEN_TestProps..Titre   = "Modifie"
			FEN_TestProps..Largeur = 600
			FEN_TestProps..Hauteur = 450
			FEN_TestProps..X       = 50
			FEN_TestProps..Y       = 80
			FEN_TestProps..Visible = Vrai
			FEN_TestProps..Grisé   = Faux
			FEN_TestProps..Icone   = "icon.png"

			Trace(t, l, h, x, y, v, g)
		FIN
	FIN
FIN
