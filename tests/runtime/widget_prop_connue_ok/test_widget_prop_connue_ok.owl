// Non-regression  : les proprietes connues sur widgets doivent
// continuer de fonctionner normalement apres correction du fallback silencieux.
// Couvre : Saisie..Valeur (lecture/ecriture), Bouton..Libelle, Libelle..Libelle,
//          ..Largeur (entier), ..Visible (booleen).

Ouvre(FEN_PropConnue)

// --- Saisie..Valeur : lecture valeur initiale ---
dbgVérifieEgalité(SAI_Champ..Valeur, "init", "Saisie..Valeur initiale = init")

// --- Saisie..Valeur : ecriture puis relecture ---
SAI_Champ..Valeur = "modif"
dbgVérifieEgalité(SAI_Champ..Valeur, "modif", "Saisie..Valeur apres ecriture = modif")

// --- Bouton..Libelle : lecture ---
dbgVérifieEgalité(BTN_Ok..Libellé, "OK", "Bouton..Libelle initial = OK")

// --- Libelle..Libelle : lecture ---
dbgVérifieEgalité(LIB_Info..Libellé, "info", "Libelle..Libelle initial = info")

// --- Saisie..Largeur : lecture entiere ---
dbgVérifieEgalité(SAI_Champ..Largeur, 150, "Saisie..Largeur = 150")

// --- Saisie..Visible : lecture booleen ---
dbgVérifieEgalité(SAI_Champ..Visible, Vrai, "Saisie..Visible = Vrai par defaut")

Ferme(FEN_PropConnue)
dbgBilanTest()
