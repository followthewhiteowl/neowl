// Ressource État minimale pour  — enchaînement du MEME État
// plusieurs fois. Un Corps + un Libellé en texte sombre sur fond blanc,
// géométrie connue pour permettre une mesure de contenu par pixel.

ETAT_RepeteSimple est un État
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
		MargeHaut   = 10
		MargeBas    = 10
		MargeGauche = 10
		MargeDroite = 10
	FIN

	Corps est un Corps
		PROPRIETES
			Hauteur = 30
		FIN

		LIB_RepeteSimple est un Champ Libellé
			PROPRIETES
				Libellé       = "Page imprimee"
				X             = 20
				Y             = 10
				Largeur       = 120
				Hauteur       = 15
				PoliceNom     = iPoliceLiberationSans
				PoliceTaille  = 14
				PoliceCouleur = Noir
			FIN
		FIN
	FIN
FIN
