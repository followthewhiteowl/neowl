//  — la constante de classe cstNombre, declaree dans un bloc CONSTANTE
// interne, est lue en NOM NU dans le constructeur (:iVal = 23 + Val(cstNombre))
// et dans une methode (RENVOYER Val(cstNombre)). Valeurs attendues : 42 et 65.
o est un cConstTest
dbgVérifieEgalité(o.ValeurConstante(), 42, "1291 : cstNombre en nom nu (methode) -> 42")
dbgVérifieEgalité(o.ValeurInit(), 65, "1291 : cstNombre en nom nu (constructeur) -> 23+42")
dbgBilanTest()
