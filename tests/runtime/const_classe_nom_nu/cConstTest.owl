//  (support #212) — une constante declaree dans un bloc CONSTANTE a
// l'INTERIEUR de la classe doit etre utilisable en NOM NU dans le constructeur
// et les methodes (pas seulement via Classe.const, ni seulement si declaree
// au-dessus de la classe).
cConstTest est une Classe
	iVal est un entier

	CONSTANTE
		cstNombre = "42"
	FIN

	PROCEDURE Constructeur()
		// nom nu dans le constructeur : etait 'variable inconnue ou inaccessible'
		:iVal = 23 + Val(cstNombre)
	FIN

	PROCEDURE ValeurInit() : entier
		RENVOYER :iVal
	FIN

	PROCEDURE ValeurConstante() : entier
		// nom nu dans une methode
		RENVOYER Val(cstNombre)
	FIN
FIN
