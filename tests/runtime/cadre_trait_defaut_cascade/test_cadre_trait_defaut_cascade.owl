//  — cascade Cadre sur widget sans Trait explicite herite le defaut
// TraitContinu (round-trip top-level, pas de rendu pixel).
//
// Pattern : la fenêtre voisine FEN_X.owl porte la déclaration.

Ouvre(FEN_X)

// Test 1 : cascade sans Trait explicite → Trait par défaut = TraitContinu.
// (pose seulement Epaisseur + Couleur, relit Trait)
LIB_X..Cadre..Epaisseur = 3
LIB_X..Cadre..Couleur   = RVB(200, 40, 40)
dbgVérifieEgalité(LIB_X..Cadre..Trait, TraitContinu, "Cascade Cadre sans Trait : défaut = TraitContinu")

// Test 2 : poser Trait=TraitAucun explicitement via cascade → survit.
LIB_X..Cadre..Trait = TraitAucun
dbgVérifieEgalité(LIB_X..Cadre..Trait, TraitAucun, "Trait explicite TraitAucun via cascade : préservé")

Ferme(FEN_X)
dbgBilanTest()
