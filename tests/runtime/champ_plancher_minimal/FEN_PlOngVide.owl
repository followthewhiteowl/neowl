// Champ Onglet réduit au strict minimum du langage : un seul volet, vide.
// Sert de référence au chrome de l'onglet (barre de languettes + cadre).

FEN_PlOngVide est une Fenêtre
	PROPRIETES
		Titre       = "Plancher — onglet nu"
		Largeur     = 1
		Hauteur     = 1
		Disposition = dispVerticale
	FIN

	ONG_PlVide est un Champ Onglet
		PROPRIETES
		FIN

		VOL_PlVideA est un Volet
			PROPRIETES
				Libellé = "A"
			FIN
		FIN
	FIN
FIN
