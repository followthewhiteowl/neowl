// Champ Onglet dont l'unique languette ne porte AUCUN libellé.
// Sert de borne basse à la question « la largeur plancher suit-elle le
// texte des languettes ? ».

FEN_PlOngLibVide est une Fenêtre
	PROPRIETES
		Titre       = "Plancher — onglet, languette sans libellé"
		Largeur     = 1
		Hauteur     = 1
		Disposition = dispVerticale
	FIN

	ONG_PlLibVide est un Champ Onglet
		PROPRIETES
		FIN

		VOL_PlLibVideA est un Volet
			PROPRIETES
				Libellé = ""
			FIN
		FIN
	FIN
FIN
