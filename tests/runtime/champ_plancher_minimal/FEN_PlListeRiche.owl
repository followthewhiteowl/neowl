// Même famille défilante, mais chargée : grande police et éléments longs
// ajoutés à l'exécution. Sert à vérifier que le plancher ne bouge pas.

FEN_PlListeRiche est une Fenêtre
	PROPRIETES
		Titre       = "Plancher — liste chargée"
		Largeur     = 1
		Hauteur     = 1
		Disposition = dispVerticale
	FIN

	LST_PlRiche est un Champ Liste
		PROPRIETES
			Police = { Nom = "Arial", Taille = 28 }
		FIN
	FIN
FIN
