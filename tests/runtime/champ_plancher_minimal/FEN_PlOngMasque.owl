// Le volet affiché est vide ; le volet MASQUÉ porte un champ défilant.
// C'est le cas qui agrandit la fenêtre à l'exécution sans que rien ne
// l'annonce à l'écran.

FEN_PlOngMasque est une Fenêtre
	PROPRIETES
		Titre       = "Plancher — onglet, volet masqué"
		Largeur     = 1
		Hauteur     = 1
		Disposition = dispVerticale
	FIN

	ONG_PlMasque est un Champ Onglet
		PROPRIETES
		FIN

		VOL_PlMasqueA est un Volet
			PROPRIETES
				Libellé = "A"
			FIN
		FIN

		VOL_PlMasqueB est un Volet
			PROPRIETES
				Libellé = "B"
				Visible = Faux
			FIN

			LST_PlMasque est un Champ Liste
				PROPRIETES
				FIN
			FIN
		FIN
	FIN
FIN
