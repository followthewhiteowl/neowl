// Champ Onglet à deux languettes portant des libellés délibérément très longs.
// Borne haute de la même question : deux languettes larges au lieu d'une
// languette d'un caractère.

FEN_PlOngLibLongs est une Fenêtre
	PROPRIETES
		Titre       = "Plancher — onglet, libellés longs"
		Largeur     = 1
		Hauteur     = 1
		Disposition = dispVerticale
	FIN

	ONG_PlLibLongs est un Champ Onglet
		PROPRIETES
		FIN

		VOL_PlLibLongsA est un Volet
			PROPRIETES
				Libellé = "Préférences générales de l'application"
			FIN
		FIN

		VOL_PlLibLongsB est un Volet
			PROPRIETES
				Libellé = "Paramètres avancés de connexion au serveur"
			FIN
		FIN
	FIN
FIN
