// Trois familles de champs pointant un style de thème introuvable. Deux
// d'entre elles enchaînent en plus une cascade `Style..<brique>..<feuille>`
// par-dessus la référence non résolue : c'est cette combinaison qui doit
// rester inoffensive.
FEN_ThemeNonResolu est une Fenêtre
	PROPRIETES
		Titre   = "Style de thème non résolu"
		Largeur = 480
		Hauteur = 320
	FIN

	SAI_Orpheline est un Champ Saisie
		PROPRIETES
			Style                          = theme.saisiePrincipale
			Style..ZoneSaisie..CouleurFond = Rouge
		FIN
	FIN

	BTN_Orphelin est un Champ Bouton
		PROPRIETES
			Libellé                            = "Valider"
			Style                              = theme.boutonPrimaire
			Style..CadreExtérieur..CouleurFond = Bleu
		FIN
	FIN

	LIB_Orphelin est un Champ Libellé
		PROPRIETES
			Libellé = "Sans cascade"
			Style   = theme.libelléTitre
		FIN
	FIN

	LIB_Sain est un Champ Libellé
		PROPRIETES
			Libellé     = "Sans style"
			CouleurFond = JauneClair
		FIN
	FIN
FIN
