// Equivalence raccourcis plats ⇔ cascade composee Police (COEUR )
// ROUGE attendu aujourd'hui : les raccourcis et la cascade sont deconnectes.
// Apres impl : l'instance Police devient la source de verite unique, les deux
// voies d'acces sont strictement equivalentes.
//
// Pattern : la fenêtre voisine FEN_X.owl porte la déclaration.

Ouvre(FEN_X)

// --- Test 1 : PoliceNom (raccourci → cascade) ---
LIB_X..PoliceNom = "Verdana"
dbgVérifieEgalité(LIB_X..Police..Nom, "Verdana", "raccourci PoliceNom visible via cascade")

// --- Test 2 : PoliceNom (cascade → raccourci) ---
LIB_X..Police..Nom = "Courier New"
dbgVérifieEgalité(LIB_X..PoliceNom, "Courier New", "cascade Nom visible via raccourci PoliceNom")

// --- Test 3 : PoliceTaille (raccourci → cascade) ---
LIB_X..PoliceTaille = 18
dbgVérifieEgalité(LIB_X..Police..Taille, 18, "raccourci PoliceTaille visible via cascade")

// --- Test 4 : PoliceTaille (cascade → raccourci) ---
LIB_X..Police..Taille = 24
dbgVérifieEgalité(LIB_X..PoliceTaille, 24, "cascade Taille visible via raccourci PoliceTaille")

// --- Test 5 : PoliceGras (cascade → raccourci) ---
LIB_X..Police..Gras = Vrai
dbgVérifieEgalité(LIB_X..PoliceGras, Vrai, "cascade Gras visible via raccourci PoliceGras")

// --- Test 6 : PoliceItalique (raccourci → cascade) ---
LIB_X..PoliceItalique = Vrai
dbgVérifieEgalité(LIB_X..Police..Italique, Vrai, "raccourci PoliceItalique visible via cascade")

// --- Test 7 : PoliceSoulignée (raccourci → cascade) ---
LIB_X..PoliceSoulignée = Vrai
dbgVérifieEgalité(LIB_X..Police..Souligné, Vrai, "raccourci PoliceSoulignée visible via cascade")

// --- Test 8 : PoliceBarrée (cascade → raccourci) ---
LIB_X..Police..Barré = Vrai
dbgVérifieEgalité(LIB_X..PoliceBarrée, Vrai, "cascade Barré visible via raccourci PoliceBarrée")

// --- Test 9 : Forme EN (FontName) ---
LIB_X..FontName = "Arial"
dbgVérifieEgalité(LIB_X..Font..Name, "Arial", "forme EN FontName ⇔ Font..Name")

Ferme(FEN_X)
dbgBilanTest()
