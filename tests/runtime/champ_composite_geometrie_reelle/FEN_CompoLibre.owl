// Ressource — placement libre. Un champ à libellé intégré et son jumeau nu,
// même géométrie déclarée : le nu est l'oracle.
FEN_CompoLibre est une Fenêtre
	PROPRIETES
		Titre       = "Composite — placement libre"
		Largeur     = 420
		Hauteur     = 220
		Disposition = dispLibre
		CouleurFond = RVB(10, 10, 10)
	FIN

	CGLNu est un Champ Saisie
		PROPRIETES
			X       = 20
			Y       = 20
			Largeur = 280
			Hauteur = 30
		FIN
	FIN

	CGLLbl est un Champ Saisie
		PROPRIETES
			X              = 20
			Y              = 70
			Largeur        = 280
			Hauteur        = 30
			Libellé        = "Nom :"
			LargeurLibellé = 80
		FIN
	FIN

	// Cible de la sonde pixel : le fond du CadreExtérieur est peint sur toute la
	// boîte du champ, libellé compris. Le fond visible sous le libellé prouve
	// que la boîte commence à l'abscisse déclarée et que le libellé a la place
	// d'exister.
	CGLLblFond est un Champ Saisie
		PROPRIETES
			X                                  = 20
			Y                                  = 120
			Largeur                            = 280
			Hauteur                            = 30
			Libellé                            = "Nom :"
			LargeurLibellé                     = 80
			Style..Libellé..CouleurFond        = RVB(255, 0, 0)
		FIN
	FIN
FIN
