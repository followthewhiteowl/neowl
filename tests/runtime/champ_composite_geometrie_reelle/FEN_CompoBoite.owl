// Ressource — dans un conteneur. Le conteneur est décalé : un champ posé
// dedans rend sa position absolue dans la fenêtre (repère canon), et le
// composite doit être à fleur du bord gauche du conteneur.
FEN_CompoBoite est une Fenêtre
	PROPRIETES
		Titre       = "Composite — dans un conteneur"
		Largeur     = 700
		Hauteur     = 300
		Disposition = dispLibre
	FIN

	CGBBoite est un Champ Conteneur
		PROPRIETES
			X           = 40
			Y           = 30
			Largeur     = 600
			Hauteur     = 60
			Disposition = dispHorizontale
		FIN

		CGBLbl est un Champ Saisie
			PROPRIETES
				Largeur        = 250
				Libellé        = "Nom :"
				LargeurLibellé = 80
			FIN
		FIN

		CGBNu est un Champ Saisie
			PROPRIETES
				Largeur = 200
			FIN
		FIN
	FIN
FIN
