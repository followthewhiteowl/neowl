// Ressource — pile horizontale, le contexte incriminé. Le premier champ de la
// pile est à fleur du bord gauche ; chaque champ a une largeur déclarée, sauf
// le dernier couple laissé à sa largeur naturelle.
FEN_CompoPileH est une Fenêtre
	PROPRIETES
		Titre       = "Composite — pile horizontale"
		Largeur     = 900
		Hauteur     = 200
		Disposition = dispHorizontale
	FIN

	CGHLbl est un Champ Saisie
		PROPRIETES
			Largeur        = 250
			Libellé        = "Nom :"
			LargeurLibellé = 80
		FIN
	FIN

	CGHCombo est un Champ Combo
		PROPRIETES
			Largeur = 250
			Libellé = "Choix"
			Contenu = ["Alpha", "Beta"]
		FIN
	FIN

	// Couple à largeur naturelle : la boîte du composite est plus large que
	// celle du jumeau nu, puisqu'elle contient en plus le libellé.
	CGHLblAuto est un Champ Saisie
		PROPRIETES
			Libellé        = "Nom :"
			LargeurLibellé = 80
		FIN
	FIN

	CGHNuAuto est un Champ Saisie
		PROPRIETES
			Visible = Vrai
		FIN
	FIN
FIN
