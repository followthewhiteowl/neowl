// Ressource — pile horizontale trop étroite pour ses champs : la rangée est
// saturée et chaque champ est comprimé. C'est le cas où la zone de frappe d'un
// champ à libellé intégré tombe à sa largeur minimale.
FEN_CompoPileHEtroite est une Fenêtre
	PROPRIETES
		Titre       = "Composite — pile horizontale saturée"
		Largeur     = 200
		Hauteur     = 200
		Disposition = dispHorizontale
	FIN

	CGELbl est un Champ Saisie
		PROPRIETES
			Libellé        = "Nom :"
			LargeurLibellé = 80
		FIN
	FIN

	CGENu est un Champ Saisie
		PROPRIETES
			Visible = Vrai
		FIN
	FIN
FIN
