// Fenêtre voisine — ressource pour test_couleur_litteral_inline_fond.owl
// (, lot L3.5).
//
// Fond de fenêtre ROUGE PUR opaque (RVB(255,0,0)), pour que tout mélange
// alpha posé par-dessus soit mesurable au pixel (cf. calcul dans le test
// voisin).
//
// CNT_Glass : chemin cascade de Style (theme.conteneurGlass), littéral
// couleur imbriqué DIRECT (pas de variable intermédiaire).
//
// SAI_Direct : chemin SET direct sur le contrôle, muté au runtime par le
// test voisin avec un littéral couleur posé DIRECTEMENT sur la propriété.
FEN_CouleurLitteralInlineFond est une Fenêtre
	PROPRIETES
		Titre       = "Couleur littéral inline fond"
		Largeur     = 400
		Hauteur     = 200
		Disposition = dispLibre
		CouleurFond = RVB(255, 0, 0)
	FIN

	CNT_Glass est un Champ Conteneur
		PROPRIETES
			X       = 20
			Y       = 20
			Largeur = 150
			Hauteur = 100
			Style   = theme.conteneurGlass
		FIN
	FIN

	SAI_Direct est un Champ Saisie
		PROPRIETES
			X       = 200
			Y       = 20
			Largeur = 150
			Hauteur = 40
		FIN
	FIN
FIN
