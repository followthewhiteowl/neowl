// Fichier de thème désigné par Projet..Thème (couleur_litteral_inline_fond).
//
// Différence avec le thème voisin de tests/runtime/couleur_alpha_fond/ :
// ici le littéral couleur est posé DIRECTEMENT, IMBRIQUÉ dans le bloc
// CadreExtérieur, SANS variable intermédiaire (, lot L3.5).
ThèmeCouleurLitteralInlineFond est un Thème
	conteneurGlass est un styleConteneur = {
		CadreExtérieur = {
			CouleurFond = {Rouge = 255, Vert = 255, Bleu = 255, Opacité = 128}
		}
	}
FIN
