// Constantes de cadrage pour l'affichage d'une Image dans un Libelle
// (et plus tard un Champ Image dedie). Trois valeurs au choix :
//   cadCentre        — taille native, centre, debord coupe (defaut)
//   cadEtire         — deforme pour remplir le champ
//   cadHomothetique  — scale en preservant le ratio, centre, bandes

// Invariant : les 3 valeurs sont definies et distinctes.
dbgVérifieDifférence(cadCentre, cadEtire, "cadCentre != cadEtire")
dbgVérifieDifférence(cadEtire, cadHomothetique, "cadEtire != cadHomothetique")
dbgVérifieDifférence(cadCentre, cadHomothetique, "cadCentre != cadHomothetique")
