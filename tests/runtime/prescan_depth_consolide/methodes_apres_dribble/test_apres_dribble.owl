//  — prescan depth consolide (methodes apres dribble)
// Script appelle les 3 methodes via instance. Avant fix, la resolution de Finalise
// (3e methode) pouvait etre polluee par le dribble des methodes precedentes.

t est un cTransformeur

sCat est une chaîne = t.Categorise(2)
nCumul est un entier = t.Cumule(5)
nFinal est un entier = t.Finalise(10)

dbgVérifieEgalité(sCat, "moyen", "methode Categorise avec SELON doit fonctionner")
dbgVérifieEgalité(nCumul, 15, "methode Cumule avec TANTQUE doit fonctionner (1+2+3+4+5)")
dbgVérifieEgalité(nFinal, 20, "methode Finalise apres 2 methodes avec blocs doit etre resolue")
dbgBilanTest()
