//  — prescan depth consolide (methodes apres dribble)
// Classe avec 3 methodes : les 2 premieres contiennent SELON+TANTQUE (bloqueraient
// tracker avant fix), la 3e doit etre resolue correctement via instance.

cTransformeur est une Classe
	// Methode 1 : contient SELON (avant fix, dribblait depth)
	PROCEDURE Categorise(n est un entier) : chaîne
		SELON n
			CAS 1
			RENVOYER "petit"
			CAS 2, 3
			RENVOYER "moyen"
			AUTRE CAS
			RENVOYER "grand"
		FIN
	FIN

	// Methode 2 : contient TANTQUE (avant fix, dribblait depth)
	PROCEDURE Cumule(max est un entier) : entier
		nAcc est un entier = 0
		nI est un entier = 1
		TANTQUE nI <= max
			nAcc += nI
			nI++
		FIN
		RENVOYER nAcc
	FIN

	// Methode 3 : avant fix, risque pollution si tracker dribble apres methode 2
	PROCEDURE Finalise(x est un entier) : entier
		RENVOYER x * 2
	FIN
FIN
