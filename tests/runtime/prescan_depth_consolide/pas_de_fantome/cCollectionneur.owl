//  — prescan depth consolide (pas de fantome)
// Classe avec methode contenant POUR+SI imbriques, puis 2e methode Traiter

cCollectionneur est une Classe
	// Methode 1 : contient POUR+SI imbriques (avant fix, dribblait depth)
	PROCEDURE MajListe(aListe est un tableau de chaînes) : chaîne
		sAcc est une chaîne = ""
		POUR nI = 1 À aListe..Occurrence
			SI Taille(aListe[nI]) > 0 ALORS
				sAcc += aListe[nI] + ";"
			FIN
		FIN
		RENVOYER sAcc
	FIN

	// Methode 2 : avant fix, exportee comme SYM_PROCEDURE top-level fantome
	// (le POUR>SI de MajListe faisait retomber depth a 0 a tort)
	PROCEDURE Traiter(x est un entier) : entier
		RENVOYER x + 100
	FIN
FIN
