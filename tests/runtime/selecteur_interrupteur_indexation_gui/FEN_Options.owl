// Ressource fenêtre — voisine de test_selecteur_interrupteur_indexation_gui.owl.
// Mêmes options que la version headless du dossier
// tests/regression/selecteur_interrupteur_indexation/, mais ce dossier-ci
// existe pour être ouvert avec de vrais widgets Qt (montés hors écran).

FEN_Options est une Fenêtre
	PROPRIETES
		Titre       = "Options indexées (widgets réels)"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 300
	FIN

	SEL_Livraison est un Champ Sélecteur
		PROPRIETES
			X             = 10
			Y             = 10
			Largeur       = 240
			ModeAffichage = selSousLib
			Options       = [{Libellé = "Express", SousLibellé = "Sous 24h", ValeurRenvoyée = "exp"},{Libellé = "Standard", SousLibellé = "Sous 5 jours", ValeurRenvoyée = "std"},{Libellé = "Eco", SousLibellé = "Sous 10 jours", ValeurRenvoyée = "eco"}]
		FIN
	FIN

	INT_Perms est un Champ Interrupteur
		PROPRIETES
			X       = 10
			Y       = 130
			Largeur = 240
			Options = [{Libellé = "Lecture", SousLibellé = "Voir"},{Libellé = "Écriture", SousLibellé = "Modifier"},{Libellé = "Suppression", SousLibellé = "Effacer"}]
		FIN
	FIN
FIN
