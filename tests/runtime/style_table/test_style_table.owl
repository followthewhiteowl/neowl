//  — type composite styleTable (Lot 1 : fondations backend).
// Vérifie que styleTable existe avec ses 8 sous-éléments :
//   CadreExtérieur, TitreColonne, LibelléLignes, LignesPaires, LignesImpaires,
//   LigneSélectionnée, LigneSurvolée, Quadrillage.
//
// ROUGE attendu : le type styleTable n'existe pas encore (compile-fail :
// type styleTable inconnu).

Trace("=== styleTable : type composite 8 sous-éléments ===")

STY_Table est un styleTable
STY_Table..CadreExtérieur..CouleurFond    = JauneClair
STY_Table..TitreColonne..Couleur          = Blanc
STY_Table..LibelléLignes..Couleur         = Noir
STY_Table..LignesPaires..CouleurFond      = GrisClair
STY_Table..LignesImpaires..CouleurFond    = Blanc
STY_Table..LigneSélectionnée..CouleurFond = Bleu
STY_Table..LigneSurvolée..CouleurFond     = JauneClair
STY_Table..Quadrillage..Couleur           = GrisFoncé

dbgVérifieEgalité(STY_Table..CadreExtérieur..CouleurFond, JauneClair, "styleTable : CadreExtérieur..CouleurFond posée")
dbgVérifieEgalité(STY_Table..TitreColonne..Couleur, Blanc, "styleTable : TitreColonne..Couleur posée")
dbgVérifieEgalité(STY_Table..LibelléLignes..Couleur, Noir, "styleTable : LibelléLignes..Couleur posée")
dbgVérifieEgalité(STY_Table..LignesPaires..CouleurFond, GrisClair, "styleTable : LignesPaires..CouleurFond posée")
dbgVérifieEgalité(STY_Table..LignesImpaires..CouleurFond, Blanc, "styleTable : LignesImpaires..CouleurFond posée")
dbgVérifieEgalité(STY_Table..LigneSélectionnée..CouleurFond, Bleu, "styleTable : LigneSélectionnée..CouleurFond posée")
dbgVérifieEgalité(STY_Table..LigneSurvolée..CouleurFond, JauneClair, "styleTable : LigneSurvolée..CouleurFond posée")
dbgVérifieEgalité(STY_Table..Quadrillage..Couleur, GrisFoncé, "styleTable : Quadrillage..Couleur posée")

dbgBilanTest()
