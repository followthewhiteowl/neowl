// Verifie que les alias EN des constantes Table resolvent vers la meme
// valeur que leur forme FR canon (invariant bilingue).

PROCEDURE scenario_alias_en_table()
	// toAffichee -> toDisplayed
	dbgVérifieEgalité(toDisplayed, toAffichée,
	"toDisplayed doit valoir la meme chose que toAffichée")
	// tsColonne -> tsColumn
	dbgVérifieEgalité(tsColumn, tsColonne,
	"tsColumn doit valoir la meme chose que tsColonne")
	// tiNumLigne -> tiRowNum
	dbgVérifieEgalité(tiRowNum, tiNumLigne,
	"tiRowNum doit valoir la meme chose que tiNumLigne")
	// taPremier -> taFirst
	dbgVérifieEgalité(taFirst, taPremier,
	"taFirst doit valoir la meme chose que taPremier")
	// tdEchange -> tdSwap
	dbgVérifieEgalité(tdSwap, tdEchange,
	"tdSwap doit valoir la meme chose que tdEchange")
	// colTypeTexte -> colTypeText
	dbgVérifieEgalité(colTypeText, colTypeTexte,
	"colTypeText doit valoir la meme chose que colTypeTexte")
FIN

PROCEDURE scenario_valeur_exacte()
	// tdEchange vaut 1 ; son alias EN tdSwap doit valoir exactement 1.
	dbgVérifieEgalité(tdSwap, 1,
	"tdSwap doit valoir 1 (valeur de tdEchange)")
FIN
