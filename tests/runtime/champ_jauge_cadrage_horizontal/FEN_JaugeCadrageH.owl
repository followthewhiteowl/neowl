// Fenêtre voisine — jauges horizontales dont le texte % est cadré à
// gauche / à droite, plus un témoin au cadrage par défaut (centre).
// Montées offscreen pour test_champ_jauge_cadrage_horizontal.owl.
//
// Rig de localisation pixel : Valeur = 0 => aucune portion remplie (pas de
// chunk), toute la barre rend la couleur de fond (CouleurFond) de manière
// uniforme. Le texte est peint par-dessus dans une couleur contrastée. On
// localise le centroïde des pixels de texte sur la ligne médiane.

FEN_JaugeCadrageH est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 340
		Hauteur     = 220
		Titre       = "Cadrage horizontal du texte de la jauge"
	FIN

	JAU_Gauche est un Champ Jauge
		PROPRIETES
			X                 = 20
			Y                 = 20
			Largeur           = 300
			Hauteur           = 40
			BorneMin          = 0
			BorneMax          = 100
			Valeur            = 0
			TexteJauge        = "MMMMMM"
			CouleurFond       = RVB(30, 30, 30)
			Couleur           = RVB(230, 0, 0)
			CadrageHorizontal = chGauche
		FIN
	FIN

	JAU_Droite est un Champ Jauge
		PROPRIETES
			X                 = 20
			Y                 = 80
			Largeur           = 300
			Hauteur           = 40
			BorneMin          = 0
			BorneMax          = 100
			Valeur            = 0
			TexteJauge        = "MMMMMM"
			CouleurFond       = RVB(30, 30, 30)
			Couleur           = RVB(230, 0, 0)
			CadrageHorizontal = chDroite
		FIN
	FIN

	// Témoin : aucun CadrageHorizontal déclaré -> centre par défaut
	// (comportement historique inchangé).
	JAU_Centre est un Champ Jauge
		PROPRIETES
			X           = 20
			Y           = 140
			Largeur     = 300
			Hauteur     = 40
			BorneMin    = 0
			BorneMax    = 100
			Valeur      = 0
			TexteJauge  = "MMMMMM"
			CouleurFond = RVB(30, 30, 30)
			Couleur     = RVB(230, 0, 0)
		FIN
	FIN
FIN
