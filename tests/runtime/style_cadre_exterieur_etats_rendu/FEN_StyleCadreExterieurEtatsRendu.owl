//  — Lot 2 (rendu runtime) : `Style..CadreExtérieur..Etats[état]`
// doit produire des règles QSS `:hover/:focus/:pressed/:disabled` sur le
// Champ Bouton. Le modèle (Lot 1) compile déjà ; ce fichier vérifie le RENDU.
FEN_StyleCadreExterieurEtatsRendu est une Fenêtre
	PROPRIETES
		Titre       = "Style CadreExtérieur — rendu d'états"
		Largeur     = 400
		Hauteur     = 120
		Disposition = dispLibre
		CouleurFond = RVB(10, 10, 10)
	FIN

	BTN_Zone est un Champ Bouton
		PROPRIETES
			X       = 20
			Y       = 20
			Largeur = 300
			Hauteur = 60
			Libellé = "Valider"
			Style   = {
				CadreExtérieur = {
					CouleurFond = RVB(80, 80, 80)
					Dégradé     = {
						Type         = dégradéLinéaire
						CouleurDébut = RVB(10, 10, 10)
						CouleurFin   = RVB(20, 20, 20)
					}
					Cadre = { Arrondi = 12 }
					Etats = {
						Survol = {
							Dégradé     = { CouleurDébut = RVB(255, 0, 0) }
							CouleurFond = RVB(200, 0, 0)
						}
						Focus  = { Cadre = { Couleur = RVB(0, 128, 255) } }
						Appuyé = { CouleurFond = RVB(0, 200, 0) }
						Grisé  = { CouleurFond = RVB(120, 120, 120) }
					}
				}
			}
		FIN
	FIN
FIN
