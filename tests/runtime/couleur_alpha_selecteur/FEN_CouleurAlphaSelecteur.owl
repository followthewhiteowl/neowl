//  (LOT 3) — opacité sur les couleurs du Champ Sélecteur stylé :
// Puce..Couleur (marque sélectionnée), CadrePuce..CouleurFond (fond du
// rond), TexteOptions..Couleur (texte des options).
//
// Fond de fenêtre ROUGE PUR opaque (RVB(255,0,0)) pour rendre tout mélange
// alpha mesurable au pixel. Aucun CadreExtérieur..CouleurFond posé : le fond
// rouge de la fenêtre reste visible derrière les puces/texte (backdrop du
// mélange).
//
// Options = ["IIIIIIIIII"] (glyphes verticaux pleins, dense, comptage fiable
// — patron  test_style_interrupteur_texte_pixel.owl). Police grande
// et grasse pour le texte.
//
// Chaque Sélecteur ne porte qu'UNE option, sélectionnée via
// ValeurInitiale=1 pour exercer la marque sélectionnée (Puce..Couleur,
// ::indicator:checked).
FEN_CouleurAlphaSelecteur est une Fenêtre
	PROPRIETES
		Titre       = "Alpha Sélecteur"
		Largeur     = 560
		Hauteur     = 420
		Disposition = dispLibre
		CouleurFond = RVB(255, 0, 0)
	FIN

	// --- CadrePuce..CouleurFond : témoin opaque + alpha -----------------------
	SEL_PuceOpaque est un Champ Sélecteur
		PROPRIETES
			X                             = 20
			Y                             = 20
			Largeur                       = 520
			Hauteur                       = 60
			Options                       = ["Choix"]
			Style..CadrePuce..CouleurFond = RVB(0, 255, 0)
		FIN
	FIN

	SEL_PuceAlpha est un Champ Sélecteur
		PROPRIETES
			X                             = 20
			Y                             = 90
			Largeur                       = 520
			Hauteur                       = 60
			Options                       = ["Choix"]
			Style..CadrePuce..CouleurFond = {Rouge = 0, Vert = 255, Bleu = 0, Opacité = 128}
		FIN
	FIN

	// --- TexteOptions..Couleur : témoin opaque + alpha ------------------------
	SEL_TexteOpaque est un Champ Sélecteur
		PROPRIETES
			X                                   = 20
			Y                                   = 160
			Largeur                             = 520
			Hauteur                             = 60
			Options                             = ["IIIIIIIIII"]
			Style..TexteOptions..Couleur        = RVB(0, 255, 0)
			Style..TexteOptions..Police..Taille = 30
			Style..TexteOptions..Police..Gras   = Vrai
		FIN
	FIN

	SEL_TexteAlpha est un Champ Sélecteur
		PROPRIETES
			X                                   = 20
			Y                                   = 230
			Largeur                             = 520
			Hauteur                             = 60
			Options                             = ["IIIIIIIIII"]
			Style..TexteOptions..Couleur        = {Rouge = 0, Vert = 255, Bleu = 0, Opacité = 128}
			Style..TexteOptions..Police..Taille = 30
			Style..TexteOptions..Police..Gras   = Vrai
		FIN
	FIN

	// --- Puce..Couleur (marque sélectionnée) : témoin opaque + alpha ----------
	SEL_MarqueOpaque est un Champ Sélecteur
		PROPRIETES
			X                    = 20
			Y                    = 300
			Largeur              = 520
			Hauteur              = 60
			Options              = ["Choix"]
			ValeurInitiale       = 1
			Style..Puce..Couleur = RVB(0, 255, 0)
		FIN
	FIN

	SEL_MarqueAlpha est un Champ Sélecteur
		PROPRIETES
			X                    = 20
			Y                    = 370
			Largeur              = 520
			Hauteur              = 40
			Options              = ["Choix"]
			ValeurInitiale       = 1
			Style..Puce..Couleur = {Rouge = 0, Vert = 255, Bleu = 0, Opacité = 128}
		FIN
	FIN
FIN
