// ============================================
// TEST: fixes des gaps trouvés dans le showcase
// ============================================
Trace("=== SHOWCASE GAPS ===")

// --- Gap #1: return type user-defined ---
Box est une Structure
	valeur est un entier
FIN

FONCTION MakeBox(v est un entier) : Box
	b est un Box
	b.valeur = v
	RENVOYER b
FIN

b est un Box = MakeBox(42)
dbgVérifieEgalité(b.valeur, 42, "Return type user-defined accepté")

// --- Gap #2: RETOUR top-level ---
// Testable au niveau du compilateur: pas d'erreur "Cannot return from top-level"
// (si on arrivait ici, ça prouve que le compile a passé)
dbgVérifieVrai(Vrai, "Top-level RETOUR autorisé (compile clean)")

// --- Gap #5: continuation de ligne avec _ ---
concat est une chaîne = "pre" + _
"fix"
dbgVérifieEgalité(concat, "prefix", "Continuation de ligne _")

long_expr est un entier = 10 + _
20 + _
30
dbgVérifieEgalité(long_expr, 60, "Continuation numérique")

// --- _A_ et _PAS_ ---
n est un entier = 3
somme est un entier = 0
POUR i = 1 _A_ n
	somme += i
FIN
dbgVérifieEgalité(somme, 6, "_A_ fonctionne")

produit est un entier = 1
POUR i = 2 _A_ 5 _PAS_ 1
	produit *= i
FIN
dbgVérifieEgalité(produit, 120, "_A_ + _PAS_ combinés")

descendant est un entier = 0
POUR i = 10 À 1 _PAS_ - 1
	descendant += i
FIN
dbgVérifieEgalité(descendant, 55, "A avec _PAS_")

// --- Taille() sur tableau JSON ---
j est un JSON = ChaîneVersJSON("[1, 2, 3, 4, 5]")
dbgVérifieEgalité(Taille(j), 5, "Taille sur JSON array")

obj est un JSON = ChaîneVersJSON("{""a"":1, ""b"":2, ""c"":3}")
dbgVérifieEgalité(Taille(obj), 3, "Taille sur JSON object")

dbgBilanTest()
