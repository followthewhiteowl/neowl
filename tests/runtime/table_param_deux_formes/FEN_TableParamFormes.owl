// Fenêtre voisine — ressource pour test_table_param_deux_formes.owl.
//
//  : verrouille que le 1er paramètre des natives Table accepte
// TOUJOURS les deux formes d'appel (référence de champ ET nom en chaîne),
// avant que ce paramètre soit retypé de "tout" vers "Champ Table".
//
// Un champ Table vide, peuplé par le script test via les deux formes.

FEN_TableParamFormes est une Fenêtre
	PROPRIETES
		Titre       = "Articles"
		Disposition = dispLibre
	FIN

	TAB_Articles est un Champ Table
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 300
			Hauteur = 200
		FIN

		COL_Nom est une Colonne
			PROPRIETES
				Libellé = "Nom"
				Type    = colTypeTexte
				Largeur = 200
			FIN
		FIN
	FIN
FIN
