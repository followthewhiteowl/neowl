// Cascade composee top-level Police ( convergence)
// ROUGE attendu aujourd'hui : Police est encore VARIANT string.
// Apres impl : getter retourne l'instance reelle depuis storage, round-trip
// valide sur tous les sous-champs.
//
// Pattern : la fenêtre voisine FEN_X.owl porte la déclaration.

Ouvre(FEN_X)

// Cascade top-level : assign + read-back round-trip
LIB_X..Police..Nom = "Arial"
dbgVérifieEgalité(LIB_X..Police..Nom, "Arial", "round-trip Nom")

LIB_X..Police..Taille = 14
dbgVérifieEgalité(LIB_X..Police..Taille, 14, "round-trip Taille")

LIB_X..Police..Gras = Vrai
dbgVérifieEgalité(LIB_X..Police..Gras, Vrai, "round-trip Gras")

LIB_X..Police..Italique = Vrai
dbgVérifieEgalité(LIB_X..Police..Italique, Vrai, "round-trip Italique")

LIB_X..Police..Souligné = Faux
dbgVérifieEgalité(LIB_X..Police..Souligné, Faux, "round-trip Souligné")

LIB_X..Police..Barré = Faux
dbgVérifieEgalité(LIB_X..Police..Barré, Faux, "round-trip Barré")

LIB_X..Police..Couleur = RougeClair
dbgVérifieEgalité(LIB_X..Police..Couleur, RougeClair, "round-trip Couleur")

Ferme(FEN_X)
dbgBilanTest()
