//  — Track B : alias EN runtime des constantes d'enums UI.
// Verifie que la forme EN resout au runtime vers la MEME valeur que la
// forme FR canon (alias EN auto-genere par le registry via .nameEN).
//
// ROUGE ATTENDU avant migration : les formes EN n'existent pas encore
// (Undefined symbol). Une fois .nameEN pose, chaque alias EN == valeur FR.

TestModeHeadless(Vrai)

// --- TypeBouton : btn* ---
dbgVérifieEgalité(btnNormal, btnNormal, "btnNormal (EN==FR) resout")
dbgVérifieEgalité(btnValidate, btnValider, "btnValidate == btnValider")
dbgVérifieEgalité(btnInterrupt, btnInterruption, "btnInterrupt == btnInterruption")
dbgVérifieEgalité(btnAbort, btnAbandon, "btnAbort == btnAbandon")
dbgVérifieEgalité(btnHelp, btnAide, "btnHelp == btnAide")

// --- TypeSaisie : prefixe traduit typSaisie -> typeInput ---
dbgVérifieEgalité(typeInputText, typSaisieTexte, "typeInputText == typSaisieTexte")
dbgVérifieEgalité(typeInputPassword, typSaisieMotDePasse, "typeInputPassword == typSaisieMotDePasse")
dbgVérifieEgalité(typeInputMultiline, typSaisieMultiligne, "typeInputMultiline == typSaisieMultiligne")

// --- Disposition : disp* ---
dbgVérifieEgalité(dispVertical, dispVerticale, "dispVertical == dispVerticale")
dbgVérifieEgalité(dispHorizontal, dispHorizontale, "dispHorizontal == dispHorizontale")
dbgVérifieEgalité(dispGrid, dispGrille, "dispGrid == dispGrille")
dbgVérifieEgalité(dispFree, dispLibre, "dispFree == dispLibre")

// --- Alignement : align* ---
dbgVérifieEgalité(alignStart, alignDébut, "alignStart == alignDébut")
dbgVérifieEgalité(alignCenter, alignCentre, "alignCenter == alignCentre")
dbgVérifieEgalité(alignEnd, alignFin, "alignEnd == alignFin")
dbgVérifieEgalité(alignStretch, alignÉtire, "alignStretch == alignÉtire")

// --- Cadrage image : cad* ---
dbgVérifieEgalité(cadCenter, cadCentre, "cadCenter == cadCentre")
dbgVérifieEgalité(cadStretch, cadEtire, "cadStretch == cadEtire")
dbgVérifieEgalité(cadProportional, cadHomothetique, "cadProportional == cadHomothetique")

// --- Ellipse : ellipse* ---
dbgVérifieEgalité(ellipseNone, ellipseInactive, "ellipseNone == ellipseInactive")
dbgVérifieEgalité(ellipseEnd, ellipseFin, "ellipseEnd == ellipseFin")
dbgVérifieEgalité(ellipsePath, ellipseChemin, "ellipsePath == ellipseChemin")

// --- toastDuree : toast* (toastLong EN==FR) ---
dbgVérifieEgalité(toastShort, toastCourt, "toastShort == toastCourt")
dbgVérifieEgalité(toastLong, toastLong, "toastLong (EN==FR) resout")

// --- Etat : valeurs sans prefixe ---
dbgVérifieEgalité(Active, Actif, "Active == Actif")
dbgVérifieEgalité(DisplayOnly, AffichageSeulement, "DisplayOnly == AffichageSeulement")
dbgVérifieEgalité(Inactive, Inactif, "Inactive == Inactif")
dbgVérifieEgalité(Grayed, Grisé, "Grayed == Grisé")
dbgVérifieEgalité(Invisible, Invisible, "Invisible (EN==FR) resout")

dbgBilanTest()
