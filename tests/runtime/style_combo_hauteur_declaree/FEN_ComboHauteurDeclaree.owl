//  — la Hauteur déclarée d'un Champ Combo doit être respectée que le
// champ porte un style ou non. Chaque combo stylé a son jumeau nu à la même
// hauteur déclarée : le nu est l'oracle, le stylé doit rendre pareil.
FEN_ComboHauteurDeclaree est une Fenêtre
	PROPRIETES
		Titre       = "Combo — hauteur déclarée"
		Largeur     = 500
		Hauteur     = 620
		Disposition = dispLibre
		CouleurFond = RVB(10, 10, 10)
	FIN

	// --- Hauteur déclarée AU-DESSUS de la taille naturelle du combo.
	CHDNu40 est un Champ Combo
		PROPRIETES
			X       = 20
			Y       = 20
			Largeur = 200
			Hauteur = 40
			Contenu = ["Alpha", "Beta"]
		FIN
	FIN

	CHDStyle40 est un Champ Combo
		PROPRIETES
			X                              = 250
			Y                              = 20
			Largeur                        = 200
			Hauteur                        = 40
			Contenu                        = ["Alpha", "Beta"]
			Style..ZoneSaisie..CouleurFond = RVB(255, 0, 0)
		FIN
	FIN

	// --- Hauteur déclarée égale à la valeur usuelle (le plafond historique
	// valait exactement la taille naturelle, ce qui masquait le défaut).
	CHDNu25 est un Champ Combo
		PROPRIETES
			X       = 20
			Y       = 90
			Largeur = 200
			Hauteur = 25
			Contenu = ["Alpha", "Beta"]
		FIN
	FIN

	CHDStyle25 est un Champ Combo
		PROPRIETES
			X                              = 250
			Y                              = 90
			Largeur                        = 200
			Hauteur                        = 25
			Contenu                        = ["Alpha", "Beta"]
			Style..ZoneSaisie..CouleurFond = RVB(255, 0, 0)
		FIN
	FIN

	// --- Hauteur déclarée EN DESSOUS de la taille naturelle (le seul sens que
	// le champ stylé honorait déjà : à préserver).
	CHDNu18 est un Champ Combo
		PROPRIETES
			X       = 20
			Y       = 140
			Largeur = 200
			Hauteur = 18
			Contenu = ["Alpha", "Beta"]
		FIN
	FIN

	CHDStyle18 est un Champ Combo
		PROPRIETES
			X                              = 250
			Y                              = 140
			Largeur                        = 200
			Hauteur                        = 18
			Contenu                        = ["Alpha", "Beta"]
			Style..ZoneSaisie..CouleurFond = RVB(255, 0, 0)
		FIN
	FIN

	// --- Sans hauteur déclarée : stylé et nu rendent la même taille.
	CHDNuLibre est un Champ Combo
		PROPRIETES
			X       = 20
			Y       = 190
			Largeur = 200
			Contenu = ["Alpha", "Beta"]
		FIN
	FIN

	CHDStyleLibre est un Champ Combo
		PROPRIETES
			X                              = 250
			Y                              = 190
			Largeur                        = 200
			Contenu                        = ["Alpha", "Beta"]
			Style..ZoneSaisie..CouleurFond = RVB(255, 0, 0)
		FIN
	FIN

	// --- Style qui habille le CadreExtérieur et pose un libellé intégré : le
	// champ est alors enveloppé pour de bon, la hauteur reste due.
	CHDStyleCadre est un Champ Combo
		PROPRIETES
			X                                  = 20
			Y                                  = 240
			Largeur                            = 300
			Hauteur                            = 40
			Libellé                            = "Choix"
			Contenu                            = ["Alpha", "Beta"]
			Style..CadreExtérieur..CouleurFond = RVB(0, 0, 255)
			Style..ZoneSaisie..CouleurFond     = RVB(255, 0, 0)
		FIN
	FIN

	// --- Cible de la sonde pixel : un cadre posé fait basculer le champ sur le
	// modèle de boîte, son fond est alors une aplat franche — comparable au
	// pixel près, contrairement au dégradé que peint le chrome natif quand
	// seule une couleur de fond est demandée.
	CHDStylePlein est un Champ Combo
		PROPRIETES
			X                                   = 20
			Y                                   = 530
			Largeur                             = 200
			Hauteur                             = 40
			Contenu                             = ["Alpha", "Beta"]
			Style..ZoneSaisie..CouleurFond      = RVB(255, 0, 0)
			Style..ZoneSaisie..Cadre..Couleur   = RVB(0, 255, 0)
			Style..ZoneSaisie..Cadre..Epaisseur = 2
		FIN
	FIN

	// --- Même exigence sous layout : la hauteur figée par la pile vaut aussi
	// pour le champ stylé.
	CHDPile est un Champ Conteneur
		PROPRIETES
			X           = 20
			Y           = 310
			Largeur     = 300
			Hauteur     = 200
			Disposition = dispVerticale
		FIN

		CHDEnPileNu est un Champ Combo
			PROPRIETES
				Hauteur = 40
				Contenu = ["Alpha", "Beta"]
			FIN
		FIN

		CHDEnPileStyle est un Champ Combo
			PROPRIETES
				Hauteur                        = 40
				Contenu                        = ["Alpha", "Beta"]
				Style..ZoneSaisie..CouleurFond = RVB(255, 0, 0)
			FIN
		FIN
	FIN
FIN
