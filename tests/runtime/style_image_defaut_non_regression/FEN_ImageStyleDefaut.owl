//  — Champ Image sans Style du tout : les propriétés top-level
// pré-existantes (CouleurFond, Image, Cadrage) doivent continuer de
// fonctionner à l'identique une fois la prop Style ajoutée au registre.
FEN_ImageStyleDefaut est une Fenêtre
	PROPRIETES
		Titre       = "Image stylée — défaut / non-régression"
		Largeur     = 400
		Hauteur     = 160
		Disposition = dispLibre
	FIN

	IMG_SansStyle est un Champ Image
		PROPRIETES
			X           = 20
			Y           = 20
			Largeur     = 150
			Hauteur     = 60
			CouleurFond = RVB(50, 50, 50)
			Cadrage     = cadHomothetique
		FIN
	FIN

	IMG_CadreSeul est un Champ Image
		PROPRIETES
			X                                  = 200
			Y                                  = 20
			Largeur                            = 150
			Hauteur                            = 60
			Style..CadreExtérieur..CouleurFond = GrisClair
		FIN
	FIN
FIN
