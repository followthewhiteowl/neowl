// Fenêtre voisine — ressource compile-only pour
// test_style_interrupteur_defaut_non_regression.owl.
FEN_InterrupteurStyleDefaut est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
	FIN

	INT_SansStyle est un Champ Interrupteur
		PROPRIETES
			X           = 10
			Y           = 10
			Largeur     = 240
			Hauteur     = 60
			Options     = ["Un", "Deux"]
			CouleurFond = RVB(50, 50, 50)
			Couleur     = RVB(0, 0, 0)
		FIN
	FIN

	INT_CadreSeul est un Champ Interrupteur
		PROPRIETES
			X                                  = 10
			Y                                  = 90
			Largeur                            = 240
			Hauteur                            = 60
			Options                            = ["Solo"]
			Style..CadreExtérieur..CouleurFond = RVB(220, 220, 220)
		FIN
	FIN
FIN
