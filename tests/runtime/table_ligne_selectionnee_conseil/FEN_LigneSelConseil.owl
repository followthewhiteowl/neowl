// Fenêtre voisine — ressource pour test_table_ligne_selectionnee_conseil.owl.
//
// Un Champ Table à une colonne, garni de trois lignes. Le test exerce la
// forme d'accès à la ligne sélectionnée « TABLE[TableSelect(TABLE)] »
// (celle que le diagnostic « nom de champ, pas un numéro de ligne » propose
// à l'utilisateur), sur des widgets réellement montés.

FEN_LigneSelConseil est une Fenêtre
	PROPRIETES
		Disposition = dispVerticale
		Largeur     = 400
		Hauteur     = 300
	FIN
	TABLE_Synthese est un Champ Table
		PROPRIETES
			Étire = Vrai
		FIN
		COL_Nom est une Colonne
			PROPRIETES
				Libellé = "Nom"
				Type    = colTypeTexte
				Largeur = 200
			FIN
		FIN
	FIN
	PROCEDURE FinInitialisation()
		TableAjouteLigne(TABLE_Synthese, "Alpha")
		TableAjouteLigne(TABLE_Synthese, "Bravo")
		TableAjouteLigne(TABLE_Synthese, "Charlie")
	FIN
FIN
