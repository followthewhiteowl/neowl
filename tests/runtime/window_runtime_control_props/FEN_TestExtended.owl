// Fenêtre voisine — ressource pour test_window_runtime_control_props.owl.
// DSL v2 : runtime read+write des proprietes etendues sur les 3 controles.

FEN_TestExtended est une Fenêtre
	PROPRIETES
		Titre       = "Test"
		Disposition = dispLibre
	FIN

	LBL_Texte est un Champ Libellé
		PROPRIETES
			Libellé     = "Bonjour"
			TypeLibellé = TLNormal
			Couleur     = 0x205080
			CouleurFond = 0xF0F0F0
		FIN
	FIN

	SAI_Nom est un Champ Saisie
		PROPRIETES
			Indication  = "Tapez votre nom"
			MaxLongueur = 32
			Etat        = Actif
			TypeSaisie  = typSaisieTexte
			Bulle       = "Identifiant"
		FIN
	FIN

	BTN_Action est un Champ Bouton
		PROPRIETES
			Libellé    = "Go"
			TypeBouton = btnValider
			Bulle      = "Action principale"
		FIN

		PROCEDURE surClic()
			// Lectures Libelle
			tl est un entier = LBL_Texte..TypeLibellé
			cl est un entier = LBL_Texte..Couleur
			cf est un entier = LBL_Texte..CouleurFond
			bl est une chaîne = LBL_Texte..Bulle

			// Ecritures Libelle
			LBL_Texte..TypeLibellé = TLMultiLigne
			LBL_Texte..Couleur     = 0xFF0000
			LBL_Texte..CouleurFond = 0xFFFFFF
			LBL_Texte..Bulle       = "Texte affiche"

			// Lectures Bouton
			tb est un entier = BTN_Action..TypeBouton
			sc est une chaîne = BTN_Action..ToucheRaccourci
			img est une chaîne = BTN_Action..Image
			bb est une chaîne = BTN_Action..Bulle

			// Ecritures Bouton
			BTN_Action..TypeBouton      = btnAbandon
			BTN_Action..ToucheRaccourci = "Ctrl+G"
			BTN_Action..Image           = ""
			BTN_Action..Bulle           = "Modifie"

			// Lectures Saisie
			ind est une chaîne = SAI_Nom..Indication
			ml est un entier = SAI_Nom..MaxLongueur
			ls est un entier = SAI_Nom..Etat
			ts est un entier = SAI_Nom..TypeSaisie
			bs est une chaîne = SAI_Nom..Bulle

			// Ecritures Saisie
			SAI_Nom..Indication  = "Nouveau placeholder"
			SAI_Nom..MaxLongueur = 100
			SAI_Nom..Etat        = AffichageSeulement
			SAI_Nom..TypeSaisie  = typSaisieMotDePasse
			SAI_Nom..Bulle       = "Saisie protegee"

			Trace(tl, cl, cf, bl, tb, sc, img, bb, ind, ml, ls, ts, bs)
		FIN
	FIN
FIN
