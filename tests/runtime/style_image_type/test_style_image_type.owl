//  — styleImage (widget) = struct {CadreExtérieur}. Le Champ Image
// est un affichage statique (QLabel + pixmap), donc pas d'États de style
// (pas de surcharge Actif/Inactif/Grisé) — comme le Libellé.
//
// Pas de sous-élément « Image » dans le Style : la source de l'image est la
// prop top-level Image du Champ Image (chemin | Image | Icône), pas le Style
// (patron Bouton, ). Le Style se limite à la boîte : CadreExtérieur.
//
// ROUGE attendu : `styleImage` n'existe pas encore comme type.

Trace("=== styleImage (widget) : struct {CadreExtérieur} ===")

STY_Img est un styleImage

STY_Img..CadreExtérieur..CouleurFond      = GrisFoncé
STY_Img..CadreExtérieur..Cadre..Couleur   = Rouge
STY_Img..CadreExtérieur..Cadre..Epaisseur = 3
STY_Img..CadreExtérieur..RetraitGauche    = 4

dbgVérifieEgalité(STY_Img..CadreExtérieur..CouleurFond, GrisFoncé, "styleImage..CadreExtérieur..CouleurFond posée")
dbgVérifieEgalité(STY_Img..CadreExtérieur..Cadre..Couleur, Rouge, "styleImage..CadreExtérieur..Cadre..Couleur (composé)")
dbgVérifieEgalité(STY_Img..CadreExtérieur..Cadre..Epaisseur, 3, "styleImage..CadreExtérieur..Cadre..Epaisseur (composé)")
dbgVérifieEgalité(STY_Img..CadreExtérieur..RetraitGauche, 4, "styleImage..CadreExtérieur..RetraitGauche posé")

dbgBilanTest()
