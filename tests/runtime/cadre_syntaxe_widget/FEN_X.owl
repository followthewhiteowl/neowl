// Cadre Phase 3 syntaxes 2 + 3 — assignation a un widget via DSL Fenetre.
// monCadre est declare au top-level du bloc Fenetre (hors widget), avant
// le widget qui le reference. LIB_X..Cadre = monCadre reste ainsi une
// assignation DECLARATIVE dans le bloc PROPRIETES du widget frere :
//   Cadre = monCadre            (assigne tout le cadre)
// Un fichier-fenetre ne peut contenir que le bloc Fenetre : la decl de
// monCadre vit donc DANS le bloc, pas avant lui.

FEN_X est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN

	monCadre est un Cadre
	monCadre..Couleur   = RougeClair
	monCadre..Epaisseur = 5
	monCadre..Trait     = TraitContinu
	monCadre..Arrondi   = 6
	monCadre..Bords     = BordHaut + BordBas

	LIB_X est un Champ Libellé
		PROPRIETES
			X       = 10
			Y       = 10
			Libellé = "test"
			Cadre   = monCadre
		FIN
	FIN
FIN
