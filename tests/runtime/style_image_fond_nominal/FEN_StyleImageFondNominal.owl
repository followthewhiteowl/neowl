//  (ST-B) — nouvelle feuille `ImageFond` sur `Style..CadreExtérieur` :
// une image de fond réelle, pas seulement une couleur ou un dégradé. Deux
// conteneurs identiques, un seul avec `ImageFond..Source` posée : le rendu doit
// différer (la couleur de l'image de fond doit apparaître au centre).
//
// ROUGE attendu : `ImageFond` inconnu sur styleCadreExtérieur aujourd'hui —
// erreur sémantique au compile (le fichier ne se lance pas).
FEN_StyleImageFondNominal est une Fenêtre
	PROPRIETES
		Titre       = "Style — image de fond (nominal)"
		Largeur     = 400
		Hauteur     = 160
		Disposition = dispLibre
		CouleurFond = RVB(10, 10, 10)
	FIN

	CNT_AvecImage est un Champ Conteneur
		PROPRIETES
			X                                         = 20
			Y                                         = 20
			Largeur                                   = 150
			Hauteur                                   = 100
			Disposition                               = dispLibre
			Style..CadreExtérieur..ImageFond..Source  = fRepTemp() + "/owl_test_2471_image_fond_nominal.png"
			Style..CadreExtérieur..ImageFond..Cadrage = cadEtire
		FIN
	FIN

	CNT_SansImage est un Champ Conteneur
		PROPRIETES
			X           = 200
			Y           = 20
			Largeur     = 150
			Hauteur     = 100
			Disposition = dispLibre
		FIN
	FIN
FIN
