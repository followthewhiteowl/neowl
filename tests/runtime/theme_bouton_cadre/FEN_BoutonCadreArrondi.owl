// Fenêtre voisine pour test_theme_bouton_cadre.
// Mode GUI réel (OuvreSoeur). Un Champ Bouton stylé avec un CadreExtérieur
// arrondi sans liseré (Epaisseur=0, Arrondi>0) : le motif « fond arrondi
// plein » d'un style thémé. Positionné en dispLibre à coordonnées fixes pour
// une lecture pixel déterministe.
//
// Config du bug  : Hauteur=44 avec Arrondi=24 (rayon > moitié de la
// hauteur). Un QPushButton sans liseré rendait alors ses coins CARRÉS.

FEN_BoutonCadreArrondi est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 120
		Titre       = "Bouton cadre arrondi"
		CouleurFond = RVB(15, 15, 15)
	FIN

	BTN_Arrondi est un Champ Bouton
		PROPRIETES
			X       = 30
			Y       = 30
			Largeur = 120
			Hauteur = 44
			Style   = {
				Libellé        = { Couleur = RVB(255, 255, 255) }
				CadreExtérieur = {
					CouleurFond = RVB(50, 50, 200)
					Cadre       = { Epaisseur = 0, Arrondi = 24 }
				}
			}
		FIN
	FIN

	PROCEDURE CaptureBouton()
		RENVOYER dCopieImageChamp(BTN_Arrondi)
	FIN
FIN
