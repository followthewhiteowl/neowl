// Thème désigné par le projet. Les deux styles existent bel et bien : la
// fenêtre compagnon en cite un troisième, orthographié de travers.
ThèmeMalOrthographié est un Thème
	saisiePrincipale est un styleSaisie = {
		ZoneSaisie = { CouleurFond = Bleu }
	}

	boutonPrimaire est un styleBouton = {
		CadreExtérieur = { CouleurFond = VioletClair }
	}
FIN
