// `saisiePrincipal` : le style du thème s'appelle `saisiePrincipale`. Un « e »
// manquant suffit à rendre la référence non résolue, alors même que le thème
// est correctement désigné par le projet.
FEN_ThemeTypo est une Fenêtre
	PROPRIETES
		Titre   = "Nom de style mal orthographié"
		Largeur = 480
		Hauteur = 320
	FIN

	SAI_Typo est un Champ Saisie
		PROPRIETES
			Style                          = theme.saisiePrincipal
			Style..ZoneSaisie..CouleurFond = Rouge
		FIN
	FIN

	SAI_Correcte est un Champ Saisie
		PROPRIETES
			Style = theme.saisiePrincipale
		FIN
	FIN

	BTN_Correct est un Champ Bouton
		PROPRIETES
			Libellé                            = "Valider"
			Style                              = theme.boutonPrimaire
			Style..CadreExtérieur..CouleurFond = OrangeClair
		FIN
	FIN
FIN
