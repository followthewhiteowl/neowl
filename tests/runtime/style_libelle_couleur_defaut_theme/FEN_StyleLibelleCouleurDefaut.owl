//  — cible : Champ Libellé stylé SANS Couleur de texte explicite.
// Un Style qui ne pose qu'une CouleurFond ne doit pas forcer le texte en
// noir : la couleur de base doit rester non-posée pour suivre le thème
// (garde `> 0` acquise , canal QSS ). Un champ témoin pose
// une Couleur explicite (doit primer).
FEN_StyleLibelleCouleurDefaut est une Fenêtre
	PROPRIETES
		Titre       = "Libellé — couleur défaut suit le thème"
		Largeur     = 560
		Hauteur     = 220
		Disposition = dispLibre
	FIN

	// Style SANS Couleur : uniquement un fond. Le texte doit suivre le thème.
	LIB_FondSeul est un Champ Libellé
		PROPRIETES
			X                           = 20
			Y                           = 20
			Largeur                     = 500
			Hauteur                     = 60
			Libellé                     = "Fond seul"
			Style..Libellé..CouleurFond = RVB(200, 220, 240)
		FIN
	FIN

	// Témoin : Couleur explicite (> 0). Doit rester ancrée sur le QLabel.
	LIB_CouleurExplicite est un Champ Libellé
		PROPRIETES
			X                           = 20
			Y                           = 100
			Largeur                     = 500
			Hauteur                     = 60
			Libellé                     = "Couleur explicite"
			Style..Libellé..Couleur     = RVB(255, 0, 0)
			Style..Libellé..CouleurFond = RVB(200, 220, 240)
		FIN
	FIN
FIN
