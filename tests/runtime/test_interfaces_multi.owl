// Interfaces — heritage multiple (une classe implemente N interfaces).
// Compagnon de test_interfaces.owl (regle OWL 1 classe = 1 fichier).

iNommable est une Interface
	PROCEDURE GetNom() : chaîne
FIN

iValorisable est une Interface
	PROCEDURE GetValeur() : entier
FIN

cItem est une Classe
	implemente iNommable
	implemente iValorisable
PUBLIC
	sNom est une chaîne
	nVal est un entier

	PROCEDURE Constructeur(s est une chaîne, n est un entier)
		:sNom = s
		:nVal = n
	FIN

	PROCEDURE GetNom() : chaîne
		RENVOYER :sNom
	FIN

	PROCEDURE GetValeur() : entier
		RENVOYER :nVal
	FIN
FIN

PROCEDURE scenario_interface_multi()
	oItem est un cItem("Epee", 150)
	dbgVérifieEgalité(oItem.GetNom(), "Epee", "Multi-interface: GetNom()")
	dbgVérifieEgalité(oItem.GetValeur(), 150, "Multi-interface: GetValeur()")
FIN
