//  — Champ Combo vs Champ Saisie avec le MÊME style de zone de saisie.
// Positions fixes (dispLibre) pour un scan de zone précis depuis le test.
// Hauteur 25 déclarée partout ; le test sonde malgré tout la géométrie réelle
// des champs via ..Y / ..Hauteur, pour que ses sondes pixel restent sur le
// champ et non sur le fond de fenêtre.
FEN_ComboCadreZoneSaisie est une Fenêtre
	PROPRIETES
		Titre       = "Combo — cadre de la zone de saisie"
		Largeur     = 400
		Hauteur     = 300
		Disposition = dispLibre
		CouleurFond = RVB(10, 10, 10)
	FIN

	SAI_Ref est un Champ Saisie
		PROPRIETES
			X                                   = 20
			Y                                   = 20
			Largeur                             = 200
			Hauteur                             = 25
			Style..ZoneSaisie..CouleurFond      = RVB(255, 0, 0)
			Style..ZoneSaisie..Cadre..Couleur   = RVB(0, 255, 0)
			Style..ZoneSaisie..Cadre..Epaisseur = 3
			Style..ZoneSaisie..Cadre..Arrondi   = 10
		FIN
	FIN

	CMB_Cible est un Champ Combo
		PROPRIETES
			X                                   = 20
			Y                                   = 80
			Largeur                             = 200
			Hauteur                             = 25
			Contenu                             = ["Alpha", "Beta"]
			Style..ZoneSaisie..CouleurFond      = RVB(255, 0, 0)
			Style..ZoneSaisie..Cadre..Couleur   = RVB(0, 255, 0)
			Style..ZoneSaisie..Cadre..Epaisseur = 3
			Style..ZoneSaisie..Cadre..Arrondi   = 10
		FIN
	FIN

	// Arrondi plus grand que la demi-hauteur : Qt jette les rayons qui ne
	// tiennent pas dans la boîte, le rendu doit rester une pilule (rayon borné).
	CMB_Pilule est un Champ Combo
		PROPRIETES
			X                                   = 20
			Y                                   = 140
			Largeur                             = 200
			Hauteur                             = 25
			Contenu                             = ["Alpha", "Beta"]
			Style..ZoneSaisie..CouleurFond      = RVB(255, 0, 0)
			Style..ZoneSaisie..Cadre..Couleur   = RVB(0, 255, 0)
			Style..ZoneSaisie..Cadre..Epaisseur = 3
			Style..ZoneSaisie..Cadre..Arrondi   = 18
		FIN
	FIN

	// Témoin sans style : aucune couleur du style ne doit fuiter dessus.
	CMB_Nu est un Champ Combo
		PROPRIETES
			X       = 20
			Y       = 200
			Largeur = 200
			Hauteur = 25
			Contenu = ["Alpha", "Beta"]
		FIN
	FIN
FIN
