//  — Ombre portée sur la ZoneSaisie (le QLineEdit) d'un Champ Saisie.
// L'ombre décore le champ interne, comme le CadreExtérieur le fait déjà sur
// boutons/conteneurs. Quatre champs pour couvrir : ombre floue, ombre dure
// (Flou 0 + décalage, néobrutalisme, cf. ), non-régression de l'ombre
// CadreExtérieur (qui reste effective), et absence d'ombre.
//
// ROUGE ACTUEL : champ 'Ombre' inconnu sur styleZoneSaisie (sous-objet absent
// avant ) — erreur SÉMANTIQUE au compile.
FEN_StyleElementZoneSaisieOmbre est une Fenêtre
	PROPRIETES
		Titre       = "Style élément ZoneSaisie — ombre"
		Largeur     = 400
		Hauteur     = 360
		Disposition = dispLibre
		CouleurFond = RVB(245, 245, 240)
	FIN

	SAI_Floue est un Champ Saisie
		PROPRIETES
			X                                   = 30
			Y                                   = 20
			Largeur                             = 300
			Hauteur                             = 50
			Style..ZoneSaisie..Ombre..Couleur   = RVB(0, 0, 0)
			Style..ZoneSaisie..Ombre..DécalageY = 4
			Style..ZoneSaisie..Ombre..Flou      = 12
		FIN
	FIN

	SAI_Dure est un Champ Saisie
		PROPRIETES
			X                                   = 30
			Y                                   = 100
			Largeur                             = 300
			Hauteur                             = 50
			Style..ZoneSaisie..Ombre..Couleur   = RVB(0, 0, 0)
			Style..ZoneSaisie..Ombre..DécalageX = 6
			Style..ZoneSaisie..Ombre..DécalageY = 6
			Style..ZoneSaisie..Ombre..Flou      = 0
		FIN
	FIN

	// Non-régression : l'ombre du CadreExtérieur reste appliquée au champ.
	SAI_CadreOmbre est un Champ Saisie
		PROPRIETES
			X                                  = 30
			Y                                  = 180
			Largeur                            = 300
			Hauteur                            = 50
			Style..CadreExtérieur..Ombre..Flou = 8
		FIN
	FIN

	SAI_Vide est un Champ Saisie
		PROPRIETES
			X       = 30
			Y       = 260
			Largeur = 300
			Hauteur = 50
		FIN
	FIN
FIN
