//  — raccourci `Style..CouleurFond` ≡ `Style..ZoneSaisie..CouleurFond`.
// Deux champs cote à cote : SAI_Raccourci utilise la forme raccourcie,
// SAI_Explicite la forme complète, même couleur — les deux doivent peindre
// identiquement leur zone.
FEN_StyleElementRaccourci est une Fenêtre
	PROPRIETES
		Titre       = "Style élément raccourci"
		Largeur     = 560
		Hauteur     = 200
		Disposition = dispLibre
		CouleurFond = RVB(10, 10, 10)
	FIN

	SAI_Raccourci est un Champ Saisie
		PROPRIETES
			X                  = 20
			Y                  = 20
			Largeur            = 500
			Hauteur            = 60
			Style..CouleurFond = RVB(0, 220, 100)
		FIN
	FIN

	SAI_Explicite est un Champ Saisie
		PROPRIETES
			X                              = 20
			Y                              = 100
			Largeur                        = 500
			Hauteur                        = 60
			Style..ZoneSaisie..CouleurFond = RVB(0, 220, 100)
		FIN
	FIN
FIN
