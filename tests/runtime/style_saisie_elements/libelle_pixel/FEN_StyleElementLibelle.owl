//  — `Style..Libellé..CouleurFond` : sous-élément statique (QLabel
// intégré à gauche de la zone de saisie, cf. ). Pas d'états sur ce
// sous-élément (peint en permanence, capturable au pixel sans interaction).
FEN_StyleElementLibelle est une Fenêtre
	PROPRIETES
		Titre       = "Style élément Libellé"
		Largeur     = 560
		Hauteur     = 120
		Disposition = dispLibre
		CouleurFond = RVB(10, 10, 10)
	FIN

	SAI_Zone est un Champ Saisie
		PROPRIETES
			X                           = 20
			Y                           = 20
			Largeur                     = 500
			Hauteur                     = 60
			Libellé                     = "Nom"
			LargeurLibellé              = 100
			Style..Libellé..CouleurFond = RVB(200, 0, 200)
		FIN
	FIN
FIN
