//  — `Style..ZoneSaisie..Couleur` (couleur du TEXTE de la zone de
// saisie) doit être effectif au runtime. Trois champs, même fond blanc et même
// grosse police grasse (glyphes denses -> pixels de coeur capturables) :
//   SAI_Rouge  : Couleur directe rouge, Police SANS couleur explicite
//                -> texte ROUGE (la Police non-configurée ne doit pas clobber).
//   SAI_Bleu   : Couleur directe rouge + Police..Couleur bleu explicite
//                -> texte BLEU (la Police explicite prime).
//   SAI_Defaut : aucune couleur -> texte défaut (noir), ni rouge ni bleu.
//
// La grosse police (Taille 40, Gras) via Style..ZoneSaisie..Police garantit
// que la Police est bien "présente mais Couleur non posée" pour SAI_Rouge :
// c'est exactement le cas qui clobberait la couleur du texte avant le fix.
FEN_StyleElementZoneSaisieTexte est une Fenêtre
	PROPRIETES
		Titre       = "Style élément ZoneSaisie — couleur texte"
		Largeur     = 560
		Hauteur     = 320
		Disposition = dispLibre
		CouleurFond = RVB(255, 255, 255)
	FIN

	SAI_Rouge est un Champ Saisie
		PROPRIETES
			X                                 = 20
			Y                                 = 20
			Largeur                           = 520
			Hauteur                           = 70
			Valeur                            = "8888888888"
			Style..ZoneSaisie..CouleurFond    = RVB(255, 255, 255)
			Style..ZoneSaisie..Couleur        = RVB(255, 0, 0)
			Style..ZoneSaisie..Police..Taille = 40
			Style..ZoneSaisie..Police..Gras   = Vrai
		FIN
	FIN

	SAI_Bleu est un Champ Saisie
		PROPRIETES
			X                                  = 20
			Y                                  = 110
			Largeur                            = 520
			Hauteur                            = 70
			Valeur                             = "8888888888"
			Style..ZoneSaisie..CouleurFond     = RVB(255, 255, 255)
			Style..ZoneSaisie..Couleur         = RVB(255, 0, 0)
			Style..ZoneSaisie..Police..Couleur = RVB(0, 0, 255)
			Style..ZoneSaisie..Police..Taille  = 40
			Style..ZoneSaisie..Police..Gras    = Vrai
		FIN
	FIN

	SAI_Defaut est un Champ Saisie
		PROPRIETES
			X                                 = 20
			Y                                 = 200
			Largeur                           = 520
			Hauteur                           = 70
			Valeur                            = "8888888888"
			Style..ZoneSaisie..CouleurFond    = RVB(255, 255, 255)
			Style..ZoneSaisie..Police..Taille = 40
			Style..ZoneSaisie..Police..Gras   = Vrai
		FIN
	FIN
FIN
