//  — `Style..ZoneSaisie..Etats[grisé]` réconcilié avec Etat = Grisé
// (Qt :disabled). Fenêtre voisine dédiée : Etat est un état PERSISTANT
// (posé une fois) → capturable au pixel directement, sans simulation.
//
// ROUGE ACTUEL : `..Etats[grisé]..` = crochet au milieu d'une cascade
// déclarative, non parsé aujourd'hui ("'=' attendu apres le nom de field").
FEN_StyleElementZoneSaisieGrise est une Fenêtre
	PROPRIETES
		Titre       = "Style élément ZoneSaisie grisé"
		Largeur     = 560
		Hauteur     = 120
		Disposition = dispLibre
		CouleurFond = RVB(10, 10, 10)
	FIN

	SAI_Cible est un Champ Saisie
		PROPRIETES
			X                                                 = 20
			Y                                                 = 20
			Largeur                                           = 500
			Hauteur                                           = 60
			Style..ZoneSaisie..Etats[grisé]..CouleurFond      = RVB(0, 255, 0)
			Style..ZoneSaisie..Etats[grisé]..Cadre..Couleur   = RVB(0, 128, 255)
			Style..ZoneSaisie..Etats[grisé]..Cadre..Epaisseur = 3
		FIN
	FIN
FIN
