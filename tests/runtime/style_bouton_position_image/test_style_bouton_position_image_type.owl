//  lot B — styleBouton = struct {Libellé, Image, CadreExtérieur}.
// Nouveau sous-élément Image (léger, feuille Position uniquement en V1).
// Style..Image..Position accepte l'enum E_PositionImageBouton (6 valeurs,
// préfixe posBtnImage*/posBtnTexteSeul), défaut posBtnImageGauche.
//
// ROUGE attendu : le sous-élément `Image` n'existe pas encore sur
// styleBouton (seuls LibelléEtImage/CadreExtérieur existent à ce jour) ni
// l'enum E_PositionImageBouton. Compile-fail attendu tant que l'impl
// (rename Libellé + sous-élément Image + enum) n'est pas posée.

Trace("=== styleBouton..Image..Position : enum E_PositionImageBouton ===")

STY_Btn est un styleBouton

// --- Défaut : posBtnImageGauche quand Position non posée ---
dbgVérifieEgalité(STY_Btn..Image..Position, posBtnImageGauche, "styleBouton..Image..Position : défaut posBtnImageGauche")

// --- Round-trip : chaque valeur de l'enum se pose et se relit ---
STY_Btn..Image..Position = posBtnImageDroite
dbgVérifieEgalité(STY_Btn..Image..Position, posBtnImageDroite, "styleBouton..Image..Position = posBtnImageDroite relu")

STY_Btn..Image..Position = posBtnImageHaut
dbgVérifieEgalité(STY_Btn..Image..Position, posBtnImageHaut, "styleBouton..Image..Position = posBtnImageHaut relu")

STY_Btn..Image..Position = posBtnImageBas
dbgVérifieEgalité(STY_Btn..Image..Position, posBtnImageBas, "styleBouton..Image..Position = posBtnImageBas relu")

STY_Btn..Image..Position = posBtnImageSeule
dbgVérifieEgalité(STY_Btn..Image..Position, posBtnImageSeule, "styleBouton..Image..Position = posBtnImageSeule relu")

STY_Btn..Image..Position = posBtnTexteSeul
dbgVérifieEgalité(STY_Btn..Image..Position, posBtnTexteSeul, "styleBouton..Image..Position = posBtnTexteSeul relu")

// Retour à la valeur par défaut explicite, pour vérifier qu'elle se pose
// aussi comme n'importe quelle autre valeur de l'enum (pas seulement lue
// en tant que défaut implicite).
STY_Btn..Image..Position = posBtnImageGauche
dbgVérifieEgalité(STY_Btn..Image..Position, posBtnImageGauche, "styleBouton..Image..Position = posBtnImageGauche relu (explicite)")

dbgBilanTest()
