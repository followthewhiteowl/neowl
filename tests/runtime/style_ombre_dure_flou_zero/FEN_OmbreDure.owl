//  — Fenêtre de test : ombres DURES (Flou = 0 + décalage), style
// néobrutaliste. Une ombre dure = un décalage net sans flou. Elle doit être
// rendue par un QGraphicsDropShadowEffect à rayon de flou 0.
//
// - BTN_Dure     : ombre dure de base (Flou 0, décalage 6/6) + Ombre de survol
//                  floue (Flou 12) pour exercer le swap dynamique.
// - BTN_DureGrise: ombre dure + Etat Grisé (coexistence effet Qt / grisé QSS).
// - BTN_Floue    : ombre floue classique (Flou 20), non-régression.
// - BTN_Vide     : ombre totalement vide (tout à 0) : aucun effet attendu.
FEN_OmbreDure est une Fenêtre
	PROPRIETES
		Titre       = "Ombres dures — néobrutalisme"
		Largeur     = 400
		Hauteur     = 340
		Disposition = dispLibre
		CouleurFond = RVB(245, 245, 240)
	FIN

	BTN_Dure est un Champ Bouton
		PROPRIETES
			X       = 30
			Y       = 20
			Largeur = 300
			Hauteur = 60
			Libellé = "Dure"
			Style   = {
				CadreExtérieur = {
					CouleurFond = RVB(255, 220, 60)
					Cadre       = { Épaisseur = 3, Couleur = RVB(0, 0, 0) }
					Ombre       = { Couleur = RVB(0, 0, 0), DécalageX = 6, DécalageY = 6, Flou = 0 }
					Etats       = {
						Survol = {
							Ombre = { Couleur = RVB(0, 0, 0), DécalageX = 6, DécalageY = 6, Flou = 12 }
						}
					}
				}
			}
		FIN
	FIN

	BTN_DureGrise est un Champ Bouton
		PROPRIETES
			X       = 30
			Y       = 100
			Largeur = 300
			Hauteur = 60
			Libellé = "Dure + grisé"
			Etat    = Grisé
			Style   = {
				CadreExtérieur = {
					CouleurFond = RVB(255, 220, 60)
					Cadre       = { Épaisseur = 3, Couleur = RVB(0, 0, 0) }
					Ombre       = { Couleur = RVB(0, 0, 0), DécalageX = 6, DécalageY = 6, Flou = 0 }
				}
			}
		FIN
	FIN

	BTN_Floue est un Champ Bouton
		PROPRIETES
			X       = 30
			Y       = 180
			Largeur = 300
			Hauteur = 60
			Libellé = "Floue"
			Style   = {
				CadreExtérieur = {
					CouleurFond = RVB(120, 100, 240)
					Cadre       = { Arrondi = 16 }
					Ombre       = { Couleur = RVB(150, 140, 210), DécalageX = 0, DécalageY = 8, Flou = 20 }
				}
			}
		FIN
	FIN

	BTN_Vide est un Champ Bouton
		PROPRIETES
			X       = 30
			Y       = 260
			Largeur = 300
			Hauteur = 60
			Libellé = "Sans ombre"
			Style   = {
				CadreExtérieur = {
					CouleurFond = RVB(230, 230, 230)
					Ombre       = { Couleur = RVB(0, 0, 0), DécalageX = 0, DécalageY = 0, Flou = 0 }
				}
			}
		FIN
	FIN
FIN
