//  — Style..Libellé..Etats[survol/appuyé/focus] : états transitoires
// (souris/clavier), aucun event Qt postable en headless (hover/pressed/focus
// ne se simulent pas sans interaction réelle). Vérifié par lecture de la
// feuille QSS générée pour le champ (cf. décision documentée ).
FEN_StyleBoutonEtatQss est une Fenêtre
	PROPRIETES
		Titre       = "Style Bouton — états QSS"
		Largeur     = 560
		Hauteur     = 120
		Disposition = dispLibre
		CouleurFond = RVB(10, 10, 10)
	FIN

	BTN_Etats est un Champ Bouton
		PROPRIETES
			X                                              = 20
			Y                                              = 20
			Largeur                                        = 500
			Hauteur                                        = 60
			Libellé                                        = "Valider"
			Style..Libellé..Etats[survol]..CouleurFond     = RVB(0, 255, 0)
			Style..Libellé..Etats[appuyé]..CouleurFond     = RVB(255, 0, 0)
			Style..Libellé..Etats[focus]..Cadre..Couleur   = RVB(0, 128, 255)
			Style..Libellé..Etats[focus]..Cadre..Epaisseur = 3
		FIN
	FIN
FIN
