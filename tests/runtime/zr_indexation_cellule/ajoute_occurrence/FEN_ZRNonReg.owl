// Fenêtre ressource pour test_zr_ajoute_occurrence.owl.
// Vérifie que ZoneRépétéeAjouteLigne + Occurrence fonctionnent toujours
// (non-régression — ce chemin était déjà opérationnel avant ).

FEN_ZRNonReg est une Fenêtre
	PROPRIETES
		Titre       = "ZR non-régression occurrence"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 300
	FIN

	ZR_NR est un Champ ZoneRépétée
		PROPRIETES
			X                 = 10
			Y                 = 10
			Largeur           = 380
			Hauteur           = 260
			Sens              = zrVertical
			HauteurRepetition = 35
		FIN

		LIB_Item est un Champ Libellé
			PROPRIETES
				X       = 5
				Y       = 6
				Largeur = 360
				Libellé = ""
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		// On teste les retours de ZoneRépétéeAjouteLigne (1-based)
		r1 est un entier = ZoneRépétéeAjouteLigne(ZR_NR)
		r2 est un entier = ZoneRépétéeAjouteLigne(ZR_NR)
		r3 est un entier = ZoneRépétéeAjouteLigne(ZR_NR)
		cb_nr_resultats(r1, r2, r3)
		// Note : r1/r2/r3 sont des variables locales (entier), pas le mot-cle "A"
	FIN
FIN
