// Fenêtre ressource pour test_zr_multi_colonnes.owl.
// ZR avec template à 2 types de sous-champs : Libellé + Saisie.
// FinInitialisation peuple 2 lignes, script voisin vérifie les valeurs.

FEN_ZRMultiCol est une Fenêtre
	PROPRIETES
		Titre       = "ZR multi-colonnes"
		Disposition = dispLibre
		Largeur     = 600
		Hauteur     = 300
	FIN

	ZR_Multi est un Champ ZoneRépétée
		PROPRIETES
			X                 = 10
			Y                 = 10
			Largeur           = 580
			Hauteur           = 260
			Sens              = zrVertical
			HauteurRepetition = 45
		FIN

		// Colonne 1 : libellé (affiché, lecture seule côté user)
		LIB_Label est un Champ Libellé
			PROPRIETES
				X       = 5
				Y       = 10
				Largeur = 120
				Libellé = ""
			FIN
		FIN

		// Colonne 2 : saisie (valeur modifiable)
		SAI_Valeur est un Champ Saisie
			PROPRIETES
				X       = 130
				Y       = 8
				Largeur = 240
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		// Ligne 1
		j1 est un entier = ZoneRépétéeAjouteLigne(ZR_Multi)
		ZR_Multi[j1].LIB_Label = "Produit A"
		ZR_Multi[j1].SAI_Valeur = "100"

		// Ligne 2
		j2 est un entier = ZoneRépétéeAjouteLigne(ZR_Multi)
		ZR_Multi[j2].LIB_Label = "Produit B"
		ZR_Multi[j2].SAI_Valeur = "250"

		cb_multi_done()
	FIN

	// Procédures publiques de lecture invocables par nom nu
	PROCEDURE LireLabel(n est un entier)
		RENVOYER ZR_Multi[n].LIB_Label
	FIN

	PROCEDURE LireValeur(n est un entier)
		RENVOYER ZR_Multi[n].SAI_Valeur
	FIN
FIN
