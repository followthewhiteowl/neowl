//  — deux Champs Onglet identiques (mêmes couleurs, mêmes libellés),
// l'un avec un arrondi de languette, l'autre sans. Le fond rouge du volet
// actif sert de règle graduée : la hauteur de la bande rouge EST la hauteur
// de la languette rendue.

FEN_OngletArrondiHauteur est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 520
		Hauteur     = 420
		Titre       = "Hauteur des languettes (arrondi vs plat)"
	FIN

	ONG_HautArrondi est un Champ Onglet
		PROPRIETES
			X       = 0
			Y       = 0
			Largeur = 480
			Hauteur = 180
			Valeur  = 1

			Style..VoletActif..CouleurFond   = Rouge
			Style..VoletActif..Couleur       = Noir
			Style..VoletInactif..CouleurFond = Bleu
			Style..VoletInactif..Couleur     = Blanc
			Style..VoletActif..Arrondi       = 8
			Style..VoletInactif..Arrondi     = 8
		FIN

		VOL_ArrondiUn est un Volet
			PROPRIETES
				Libellé     = "Profil"
				Disposition = dispLibre
			FIN
		FIN

		VOL_ArrondiDeux est un Volet
			PROPRIETES
				Libellé     = "Options"
				Disposition = dispLibre
			FIN
		FIN
	FIN

	ONG_HautPlat est un Champ Onglet
		PROPRIETES
			X       = 0
			Y       = 200
			Largeur = 480
			Hauteur = 180
			Valeur  = 1

			Style..VoletActif..CouleurFond   = Rouge
			Style..VoletActif..Couleur       = Noir
			Style..VoletInactif..CouleurFond = Bleu
			Style..VoletInactif..Couleur     = Blanc
		FIN

		VOL_PlatUn est un Volet
			PROPRIETES
				Libellé     = "Profil"
				Disposition = dispLibre
			FIN
		FIN

		VOL_PlatDeux est un Volet
			PROPRIETES
				Libellé     = "Options"
				Disposition = dispLibre
			FIN
		FIN
	FIN
FIN
