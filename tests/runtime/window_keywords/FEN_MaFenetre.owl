// MaFenetre dans toutes les PROCEDURE d'une fenetre.

FEN_MaFenetre est une Fenêtre
	PROPRIETES
		Titre       = "Test MaFenetre"
		Disposition = dispLibre
	FIN

	PROCEDURE Fermeture()
		Trace(MaFenêtre)
	FIN

	BTN_OK est un Champ Bouton
		PROPRIETES
			Libellé = "OK"
		FIN

		PROCEDURE surClic()
			Trace(MaFenêtre)
		FIN
	FIN
FIN
