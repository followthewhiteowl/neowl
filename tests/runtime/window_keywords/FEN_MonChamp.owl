// MonChamp dans les PROCEDURE de champ.

FEN_MonChamp est une Fenêtre
	PROPRIETES
		Titre       = "Test MonChamp"
		Disposition = dispLibre
	FIN

	LBL_Nom est un Champ Libellé
		PROPRIETES
			Libellé = "Nom :"
		FIN

		PROCEDURE surClic()
			Trace(MonChamp)
		FIN
	FIN

	BTN_Action est un Champ Bouton
		PROPRIETES
			Libellé = "Action"
		FIN

		PROCEDURE surClic()
			Trace(MonChamp)
			Trace(MaFenêtre)
		FIN
	FIN

	SAI_Nom est un Champ Saisie
		PROPRIETES
			Indication = ""
		FIN

		PROCEDURE surAChaqueModification()
			Trace(MonChamp)
		FIN

		PROCEDURE surValidation()
			Trace(MonChamp)
		FIN
	FIN
FIN
