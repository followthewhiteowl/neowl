//  phase 1b — Champ CodeBarres : Option (bitfield), CadrageHorizontal
// /CadrageVertical, Style dédié.
//
// ROUGE attendu (Option / CadrageHorizontal / CadrageVertical) : ces props ne
// sont pas encore câblées sur le contrôle CodeBarres (compile-fail : propriété
// inconnue sur ce type de champ).
//
// Style..CadreExtérieur..CouleurFond compile déjà aujourd'hui (le champ Style
// existe depuis la phase 1a, backé par le type styleImage partagé) : verrou
// documentaire, pas un rougissement attendu ici. Le style dédié styleCodeBarre
// (dissocié de styleImage) est invisible à un test boîte noire tant que sa
// structure de champs reste identique (CadreExtérieur..CouleurFond).

Ouvre(FEN_ChampCodeBarresOptionsCadrage)

dbgVérifieEgalité(LireOption(), CB_SansTexte,
"CBA_Opt : Option = CB_SansTexte")
dbgVérifieEgalité(LireCadrageHorizontal(), chCentre,
"CBA_Opt : CadrageHorizontal = chCentre")
dbgVérifieEgalité(LireCadrageVertical(), cvMilieu,
"CBA_Opt : CadrageVertical = cvMilieu")
dbgVérifieEgalité(LireOptionCombo(), CB_SansTexte + CB_90,
"CBA_Combo : Option combine CB_SansTexte + CB_90 (champ de bits)")
dbgVérifieEgalité(LireStyleCouleurFond(), RVB(0, 255, 0),
"CBA_Style : Style..CadreExtérieur..CouleurFond posé")

Ferme(FEN_ChampCodeBarresOptionsCadrage)
dbgBilanTest()
