// Fenêtre voisine — ressource pour test_champ_codebarres_options_cadrage.owl.
//  phase 1b : Option (bitfield combinable, singulier — pendant du
// Options du type CodeBarres), CadrageHorizontal/CadrageVertical (mêmes
// enums chXxx/cvXxx que les autres champs), Style dédié (CadreExtérieur).

FEN_ChampCodeBarresOptionsCadrage est une Fenêtre
	PROPRIETES
		Titre       = "Test Option/Cadrage Champ CodeBarres"
		Largeur     = 400
		Hauteur     = 400
		Disposition = dispLibre
	FIN

	CBA_Opt est un Champ CodeBarres
		PROPRIETES
			X                 = 10
			Y                 = 10
			Largeur           = 150
			Hauteur           = 150
			TypeCodeBarres    = CB_CODE128
			Contenu           = "OWL-OPT"
			Option            = CB_SansTexte
			CadrageHorizontal = chCentre
			CadrageVertical   = cvMilieu
		FIN
	FIN

	CBA_Combo est un Champ CodeBarres
		PROPRIETES
			X              = 10
			Y              = 170
			Largeur        = 150
			Hauteur        = 150
			TypeCodeBarres = CB_CODE128
			Contenu        = "OWL-COMBO"
			Option         = CB_SansTexte + CB_90
		FIN
	FIN

	CBA_Style est un Champ CodeBarres
		PROPRIETES
			X                                  = 170
			Y                                  = 10
			Largeur                            = 150
			Hauteur                            = 150
			TypeCodeBarres                     = CB_QRCODE
			Contenu                            = "OWL-STYLE"
			Style..CadreExtérieur..CouleurFond = RVB(0, 255, 0)
		FIN
	FIN

	PROCEDURE LireOption()
		RENVOYER CBA_Opt..Option
	FIN

	PROCEDURE LireCadrageHorizontal()
		RENVOYER CBA_Opt..CadrageHorizontal
	FIN

	PROCEDURE LireCadrageVertical()
		RENVOYER CBA_Opt..CadrageVertical
	FIN

	PROCEDURE LireOptionCombo()
		RENVOYER CBA_Combo..Option
	FIN

	PROCEDURE LireStyleCouleurFond()
		RENVOYER CBA_Style..Style..CadreExtérieur..CouleurFond
	FIN
FIN
