//  — Fenêtre de test : un Bouton stylé dont l'ombre portée change
// selon l'état d'interaction (Etats.Survol.Ombre / Etats.Appuyé.Ombre).
// Flou distinct par état pour lire la transition sans ambiguïté :
// base=20, survol=34, appuyé=8.
FEN_OmbreEtat est une Fenêtre
	PROPRIETES
		Titre       = "Ombre dynamique — survol / appui"
		Largeur     = 400
		Hauteur     = 140
		Disposition = dispLibre
		CouleurFond = RVB(240, 240, 245)
	FIN

	BTN_Zone est un Champ Bouton
		PROPRIETES
			X       = 30
			Y       = 30
			Largeur = 300
			Hauteur = 70
			Libellé = "Valider"
			Style   = {
				CadreExtérieur = {
					CouleurFond = RVB(120, 100, 240)
					Cadre       = { Arrondi = 16 }
					Ombre       = { Couleur = RVB(150, 140, 210), DécalageX = 0, DécalageY = 8, Flou = 20 }
					Etats       = {
						Survol = {
							Ombre = { Couleur = RVB(140, 130, 205), DécalageX = 0, DécalageY = 12, Flou = 34 }
						}
						Appuyé = {
							Ombre = { Couleur = RVB(130, 120, 200), DécalageX = 0, DécalageY = 3, Flou = 8 }
						}
					}
				}
			}
		FIN
	FIN
FIN
