// Fenêtre voisine — ressource pour test_v15_a_var_ref_in_proprietes.owl.
// V1.5-A : variable reference dans PROPRIETES. La variable monCadre est
// déclarée comme variable globale fenêtre, visible dans PROPRIETES des champs.

FEN_X est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN

	monCadre est un Cadre = {
		Couleur   = RougeFoncé
		Epaisseur = 2
		Arrondi   = 4
	}

	LIB_X est un Champ Libellé
		PROPRIETES
			X       = 10
			Y       = 10
			Libellé = "test"
			Cadre   = monCadre
		FIN
	FIN
FIN
