// Fenêtre voisine — trois Champs Jauge horizontale pour
// test_champ_jauge_texte_masque.owl. Le texte % est peint en jaune
// (Style..Libellé..Couleur) sur une piste/remplissage gris foncé, ce qui
// rend les pixels d'encre du texte comptables :
//   - JAU_Auto   : TexteJauge NON posé  -> pourcentage automatique ("50%") affiché.
//   - JAU_Masque : TexteJauge = ""      -> texte masqué (aucun pixel d'encre).
//   - JAU_Custom : TexteJauge = "ABC"   -> texte personnalisé affiché.
// Valeur 50 : le remplissage gris reste distinct du jaune du texte.
FEN_JaugeTexteMasque est une Fenêtre
	PROPRIETES
		Titre       = "Jauge — texte masqué"
		Largeur     = 360
		Hauteur     = 220
		Disposition = dispLibre
		CouleurFond = RVB(10, 10, 10)
	FIN

	JAU_Auto est un Champ Jauge
		PROPRIETES
			X                                  = 20
			Y                                  = 20
			Largeur                            = 300
			Hauteur                            = 40
			BorneMin                           = 0
			BorneMax                           = 100
			Valeur                             = 50
			Style..CadreExtérieur..CouleurFond = RVB(30, 30, 30)
			Style..Remplissage..CouleurFond    = RVB(60, 60, 60)
			Style..Libellé..Couleur            = RVB(255, 255, 0)
			Style..Libellé..Police..Taille     = 20
		FIN
	FIN

	JAU_Masque est un Champ Jauge
		PROPRIETES
			X                                  = 20
			Y                                  = 90
			Largeur                            = 300
			Hauteur                            = 40
			BorneMin                           = 0
			BorneMax                           = 100
			Valeur                             = 50
			TexteJauge                         = ""
			Style..CadreExtérieur..CouleurFond = RVB(30, 30, 30)
			Style..Remplissage..CouleurFond    = RVB(60, 60, 60)
			Style..Libellé..Couleur            = RVB(255, 255, 0)
			Style..Libellé..Police..Taille     = 20
		FIN
	FIN

	JAU_Custom est un Champ Jauge
		PROPRIETES
			X                                  = 20
			Y                                  = 160
			Largeur                            = 300
			Hauteur                            = 40
			BorneMin                           = 0
			BorneMax                           = 100
			Valeur                             = 50
			TexteJauge                         = "ABC"
			Style..CadreExtérieur..CouleurFond = RVB(30, 30, 30)
			Style..Remplissage..CouleurFond    = RVB(60, 60, 60)
			Style..Libellé..Couleur            = RVB(255, 255, 0)
			Style..Libellé..Police..Taille     = 20
		FIN
	FIN
FIN
