//  (LOT GARDE-FOU) — Style..Remplissage..CouleurFond (barre remplie)
// d'un Champ Jauge, posé en instance Couleur translucide (Opacité<255).
//
// Piste (CadreExtérieur..CouleurFond) ROUGE opaque servant de backdrop pour
// le mélange du remplissage. Valeur=100 (BorneMax=100) : la barre remplit
// tout le widget, sampling simple sur toute la surface intérieure.
FEN_CouleurAlphaJaugeRemplissage est une Fenêtre
	PROPRIETES
		Titre       = "Alpha Jauge — remplissage"
		Largeur     = 360
		Hauteur     = 180
		Disposition = dispLibre
		CouleurFond = RVB(255, 0, 0)
	FIN

	JAU_RemplissageOpaque est un Champ Jauge
		PROPRIETES
			X                                  = 20
			Y                                  = 20
			Largeur                            = 300
			Hauteur                            = 50
			BorneMin                           = 0
			BorneMax                           = 100
			Valeur                             = 100
			Style..CadreExtérieur..CouleurFond = RVB(255, 0, 0)
			Style..Remplissage..CouleurFond    = RVB(0, 200, 0)
		FIN
	FIN

	JAU_RemplissageAlpha est un Champ Jauge
		PROPRIETES
			X                                  = 20
			Y                                  = 100
			Largeur                            = 300
			Hauteur                            = 50
			BorneMin                           = 0
			BorneMax                           = 100
			Valeur                             = 100
			Style..CadreExtérieur..CouleurFond = RVB(255, 0, 0)
			Style..Remplissage..CouleurFond    = {Rouge = 0, Vert = 255, Bleu = 0, Opacité = 128}
		FIN
	FIN
FIN
