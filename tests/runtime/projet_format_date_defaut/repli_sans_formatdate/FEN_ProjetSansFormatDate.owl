// Fenêtre voisine — ressource pour test_projet_sans_formatdate.owl. Champ
// Date sans MasqueAffichage, sous un projet qui ne pose pas FormatDate :
// doit suivre le défaut en dur JJ/MM/AAAA.

FEN_ProjetSansFormatDate est une Fenêtre
	PROPRIETES
		Titre       = "Projet sans FormatDate"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 120
	FIN

	SAI_Date est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 10
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieDate
			Valeur     = ""
		FIN
	FIN
FIN
