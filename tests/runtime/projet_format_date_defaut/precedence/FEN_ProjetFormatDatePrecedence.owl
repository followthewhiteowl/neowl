// Fenêtre voisine — ressource pour test_projet_format_date_precedence.owl.
// Champ Date avec MasqueAffichage = "JJ/MM/AAAA" posé explicitement, alors
// que le projet voisin déclare FormatDate = "MM/JJ/AAAA" : le masque du
// champ doit gagner.

FEN_ProjetFormatDatePrecedence est une Fenêtre
	PROPRIETES
		Titre       = "Projet FormatDate précédence champ"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 120
	FIN

	SAI_Date est un Champ Saisie
		PROPRIETES
			X               = 10
			Y               = 10
			Largeur         = 180
			Hauteur         = 24
			TypeSaisie      = typSaisieDate
			MasqueAffichage = "JJ/MM/AAAA"
			Valeur          = ""
		FIN
	FIN
FIN
