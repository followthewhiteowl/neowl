// Fenêtre voisine — ressource pour test_projet_format_heure_precedence.owl.
// Champ Heure avec MasqueAffichage = "HH:MI:SS" posé explicitement, alors que
// le projet voisin déclare FormatHeure = "HH:MI" : le masque du champ doit
// gagner et préserver les secondes.

FEN_ProjetFormatHeurePrecedence est une Fenêtre
	PROPRIETES
		Titre       = "Projet FormatHeure précédence champ"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 120
	FIN

	SAI_Heure est un Champ Saisie
		PROPRIETES
			X               = 10
			Y               = 10
			Largeur         = 180
			Hauteur         = 24
			TypeSaisie      = typSaisieHeure
			MasqueAffichage = "HH:MI:SS"
			Valeur          = ""
		FIN
	FIN
FIN
