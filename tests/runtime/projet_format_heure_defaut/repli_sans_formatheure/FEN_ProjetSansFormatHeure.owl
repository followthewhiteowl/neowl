// Fenêtre voisine — ressource pour test_projet_sans_formatheure.owl. Champ
// Heure sans MasqueAffichage, sous un projet qui ne pose pas FormatHeure :
// doit suivre le défaut en dur HH:MI (secondes tronquées).

FEN_ProjetSansFormatHeure est une Fenêtre
	PROPRIETES
		Titre       = "Projet sans FormatHeure"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 120
	FIN

	SAI_Heure est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 10
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieHeure
			Valeur     = ""
		FIN
	FIN
FIN
