// Fenêtre voisine — ressource pour test_projet_format_heure_pilote.owl.
// Un seul champ Heure, volontairement SANS MasqueAffichage : sert à prouver
// que c'est le FormatHeure du projet voisin (HH:MI:SS) qui pilote le défaut
// de relecture, préservant les secondes au lieu du défaut tronqué HH:MI.

FEN_ProjetFormatHeurePilote est une Fenêtre
	PROPRIETES
		Titre       = "Projet FormatHeure pilote"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 120
	FIN

	SAI_Heure est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 10
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieHeure
			Valeur     = ""
		FIN
	FIN
FIN
