// Fenêtre voisine — ressource pour test_etat_inactif_non_grise.owl.
// Porte un Bouton (contrôle SANS lecture-seule native) et une Saisie
// (lecture-seule native) pour couvrir les deux chemins de l'Etat unifié.

FEN_EtatInactif est une Fenêtre
	PROPRIETES
		Titre       = "Etat Inactif"
		Disposition = dispLibre
	FIN

	BTN_Test est un Champ Bouton
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 120
			Hauteur = 30
			Libellé = "Test"
		FIN
	FIN

	SAI_Test est un Champ Saisie
		PROPRIETES
			X       = 10
			Y       = 50
			Largeur = 120
			Hauteur = 30
		FIN
	FIN
FIN
