// Fenêtre voisine — ressource pour
// test_table_colonne_type_numerique_monetaire.owl ( lot 3, câblage
// colTypeNumerique + colTypeMonétaire sur le framework type-driven de colonne
// posé par  : INPUT (validateur) + AFFICHAGE (format défaut/projet).
//
// COL_Num     : Type = colTypeNumerique, AUCUN masque brut déclaré → validée
//               à la frappe par un validateur numérique, et affichée (hors
//               édition) selon FormatNombre projet (séparateurs/décimales).
// COL_Mon     : Type = colTypeMonétaire, AUCUN masque brut déclaré → même
//               contrat côté validateur, affichée selon FormatMonétaire
//               projet (symbole + séparateurs + décimales).
// COL_Texte   : Type = colTypeTexte, aucun masque/validateur/format → non-
//               régression (saisie et affichage inchangés).

FEN_TableColonneTypeNumeriqueMonetaire est une Fenêtre
	PROPRIETES
		Titre = "Colonne type Numérique/Monétaire, input + affichage"
	FIN

	TAB_ColTypes est un Champ Table
		PROPRIETES
		FIN

		COL_Num est une Colonne
			PROPRIETES
				Libellé = "Numérique"
				Type    = colTypeNumerique
				Largeur = 140
			FIN
		FIN

		COL_Mon est une Colonne
			PROPRIETES
				Libellé = "Monétaire"
				Type    = colTypeMonétaire
				Largeur = 140
			FIN
		FIN

		COL_Texte est une Colonne
			PROPRIETES
				Libellé = "Texte"
				Type    = colTypeTexte
				Largeur = 140
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		TableAjouteLigne(TAB_ColTypes, "1234.56", "1234.56", "abc")
	FIN
FIN
