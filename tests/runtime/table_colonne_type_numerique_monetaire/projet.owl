//  lot 3 — projet avec FormatNombre ET FormatMonétaire configurés
// (miroir exact tests/runtime/format_monetaire_heritage_champ et
// format_nombre_heritage_champ, mais côté colonne de Table plutôt que Champ
// Saisie). Pilote l'AFFICHAGE des colonnes colTypeNumerique/colTypeMonétaire
// de la fenêtre voisine (format défaut/projet, pas d'override par colonne —
// hors-scope assumé du ticket).

MonAppTableColNumMonProjet est un Projet
	PROPRIETES
		Langues         = [langueFrançais]
		FormatNombre    = {ChiffresAprèsVirgule = 2, SéparateurMilliers = " ", SéparateurDécimal = ","}
		FormatMonétaire = {Symbole = "€", SéparateurMilliers = " ", SéparateurDécimal = ",", ChiffresAprèsVirgule = 2}
	FIN
FIN
