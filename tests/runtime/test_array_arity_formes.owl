// test_array_arity_formes.owl
// Verrouille les formes d'arite discretes des natives tableau
// migrees depuis une signature variadique masquee : chaque forme valide
// continue de compiler ET de s'executer correctement.

PROCEDURE PUBLIQUE test_trie_formes()
	t est un tableau d'entiers = [3, 1, 2]
	// 1 arg : tri croissant par defaut
	Trie(t)
	dbgVérifieEgalité(t[1], 1, "Trie 1 arg : croissant")
	dbgVérifieEgalité(t[3], 3, "Trie 1 arg : dernier")
	// 2 args : mode explicite
	Trie(t, ttDecroissant)
	dbgVérifieEgalité(t[1], 3, "Trie 2 args : decroissant")
	dbgVérifieEgalité(t[3], 1, "Trie 2 args : dernier")
FIN

PROCEDURE PUBLIQUE test_trie_forme_methode()
	t est un tableau d'entiers = [5, 4, 6]
	t.Trie()
	dbgVérifieEgalité(t[1], 4, "Trie methode 1 arg")
	t.Trie(ttDecroissant)
	dbgVérifieEgalité(t[1], 6, "Trie methode 2 args")
FIN

PROCEDURE PUBLIQUE test_tableau_info_formes()
	t est un tableau d'entiers = [10, 20, 30]
	// 2 args : info simple
	dbgVérifieEgalité(TableauInfo(t, tiNombreTotal), 3, "TableauInfo 2 args")
	dbgVérifieEgalité(TableauInfo(t, tiNombreDimensions), 1, "TableauInfo dimensions")
FIN

PROCEDURE PUBLIQUE test_tableau_cherche_formes()
	t est un tableau d'entiers = [7, 8, 9]
	// 2 args : tableau + valeur
	dbgVérifieEgalité(TableauCherche(t, 8), 2, "TableauCherche 2 args trouve")
	dbgVérifieEgalité(TableauCherche(t, 99),-1, "TableauCherche 2 args absent")
	// 3 args : tableau + mode + valeur
	dbgVérifieEgalité(TableauCherche(t, tcLineaire, 9), 3, "TableauCherche 3 args")
FIN

PROCEDURE PUBLIQUE test_verifie_formes()
	tousVrais est un tableau de booléens = [Vrai, Vrai, Vrai]
	mixte est un tableau de booléens = [Vrai, Faux, Vrai]
	// 1 arg : test direct des valeurs
	dbgVérifieVrai(VérifieTousVrai(tousVrais), "VerifieTousVrai 1 arg")
	dbgVérifieFaux(VérifieTousVrai(mixte), "VerifieTousVrai 1 arg mixte")
	// 2 args : prédicat
	nombres est un tableau d'entiers = [2, 4, 6]
	dbgVérifieVrai(VérifieTousVrai(nombres, v => v > 0), "VerifieTousVrai 2 args")
FIN
