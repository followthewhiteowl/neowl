// Ressource fenêtre — voisine de test_table_cellule_colonne_homonyme_couleur.owl.
// Une Table peut déclarer une colonne littéralement nommée 'Couleur' : au
// niveau LIGNE, la VALEUR de cette colonne garde la priorité (chemin déjà
// livré, jamais masqué) ; au niveau CELLULE, la mise en forme fonctionne
// quand même.

FEN_TableColonneHomonyme est une Fenêtre
	PROPRIETES
		Titre       = "Colonne nommée Couleur"
		Disposition = dispVerticale
		Largeur     = 400
		Hauteur     = 300
	FIN

	TABLE_Homonyme est un Champ Table
		PROPRIETES
			Étire = Vrai
		FIN

		Couleur est une Colonne
			PROPRIETES
				Libellé = "Couleur"
				Type    = colTypeTexte
				Largeur = 100
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		TableAjouteLigne(TABLE_Homonyme, "rouge-fonce")
	FIN

	PROCEDURE LireLigneCouleur(ligne est un entier)
		RENVOYER TABLE_Homonyme[ligne]..Couleur
	FIN

	PROCEDURE EcritLigneCouleur(ligne est un entier, v est un entier)
		TABLE_Homonyme[ligne]..Couleur = v
	FIN

	PROCEDURE EcritCelluleCouleur(ligne est un entier, col est un entier, v est un entier)
		TABLE_Homonyme[ligne][col]..Couleur = v
	FIN

	PROCEDURE LireCelluleCouleur(ligne est un entier, col est un entier)
		RENVOYER TABLE_Homonyme[ligne][col]..Couleur
	FIN
FIN
