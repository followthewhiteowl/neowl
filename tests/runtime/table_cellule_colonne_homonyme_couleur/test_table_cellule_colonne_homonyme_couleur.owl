// Une Table qui déclare une colonne littéralement nommée 'Couleur' : au
// niveau ligne, la VALEUR de la colonne gagne (ce chemin de lecture de
// cellule existe déjà, il ne doit jamais être masqué par la mise en forme) ;
// au niveau cellule, la mise en forme reste fonctionnelle.

TestModeHeadless(Vrai)

Ouvre(FEN_TableColonneHomonyme)

dbgVérifieEgalité(LireLigneCouleur(1), "rouge-fonce",
"niveau ligne : la valeur de la colonne 'Couleur' est lue, pas une mise en forme")

EcritLigneCouleur(1, 999)
dbgVérifieEgalité(LireLigneCouleur(1), 999,
"niveau ligne : l'écriture remplace la valeur de la colonne")

EcritCelluleCouleur(1, 1, 555)
dbgVérifieEgalité(LireCelluleCouleur(1, 1), 555,
"niveau cellule : la mise en forme fonctionne malgré l'homonymie")

Ferme(FEN_TableColonneHomonyme)

dbgBilanTest()
