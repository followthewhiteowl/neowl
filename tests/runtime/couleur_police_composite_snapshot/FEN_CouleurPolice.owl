// Fenetre voisine pour test_couleur_police_composite_snapshot.owl.
//  — Police..Couleur declare doit colorer le texte sur
// Libelle, Bouton, Saisie. Fond sombre sur Libelle/Saisie (Bouton
// n'expose pas CouleurFond). Couleurs vives pures.
//
// Couleurs attendues (BGR-packe = identique RVB(R,V,B)) :
//   Libelle  rouge  RVB(255,0,0)  = 255
//   Bouton   vert   RVB(0,255,0)  = 65280   (fond Qt-defaut, glyphes verts)
//   Saisie   bleu   RVB(0,0,255)  = 16711680

FEN_CouleurPolice est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 450
		Hauteur     = 280
		Titre       = "Police Couleur declaree"
	FIN

	// Libelle : Police..Couleur = rouge pur. Fond sombre, taille 18.
	LIB_PoliceRouge est un Champ Libellé
		PROPRIETES
			X               = 10
			Y               = 10
			Largeur         = 420
			Hauteur         = 50
			Libellé         = "Texte libelle rouge WWWWWWWW"
			CouleurFond     = RVB(20, 20, 20)
			Police..Taille  = 18
			Police..Couleur = RVB(255, 0, 0)
		FIN
	FIN

	// Bouton : seul chemin de couleur = Police..Couleur. Texte long, taille 16.
	// Bouton n'a pas CouleurFond -> fond Qt-defaut (gris clair). On verifie
	// uniquement la presence de pixels verts purs (glyphes).
	BTN_PoliceVert est un Champ Bouton
		PROPRIETES
			X               = 10
			Y               = 80
			Largeur         = 420
			Hauteur         = 60
			Libellé         = "Bouton vert WWWWWWWWWW"
			Police..Taille  = 16
			Police..Couleur = RVB(0, 255, 0)
		FIN
	FIN

	// Saisie : seul chemin de couleur = Police..Couleur. Texte long, taille 16.
	// Saisie..Valeur est la prop de contenu.
	// Saisie n'expose pas CouleurFond -> fond Qt-defaut (blanc). On verifie
	// uniquement la presence de pixels bleus purs (glyphes).
	SAI_PoliceBleu est un Champ Saisie
		PROPRIETES
			X               = 10
			Y               = 160
			Largeur         = 420
			Hauteur         = 50
			Valeur          = "Saisie bleue WWWWWWWWWW"
			Police..Taille  = 16
			Police..Couleur = RVB(0, 0, 255)
		FIN
	FIN
FIN
