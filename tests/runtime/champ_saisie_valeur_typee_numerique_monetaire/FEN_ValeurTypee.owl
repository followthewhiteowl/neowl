// Fenêtre voisine — ressource pour test_valeur_typee_numerique_monetaire.owl.
//
// Cinq champs de saisie : Numérique et Monétaire (, valeur typée +
// formatage) plus Texte / MotDePasse / Multiligne (garde-fou non-régression :
// leur ..Valeur DOIT rester une chaîne malgré le changement cross-cutting du
// chemin partagé real_ui_get_prop/set_prop).

FEN_ValeurTypee est une Fenêtre
	PROPRIETES
		Titre       = "Valeur typée numérique / monétaire"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 260
	FIN

	SAI_Num est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 10
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieNum
			Valeur     = ""
		FIN
	FIN

	SAI_Monetaire est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 50
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieMonétaire
			Valeur     = ""
		FIN
	FIN

	SAI_Texte est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 90
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieTexte
			Valeur     = ""
		FIN
	FIN

	SAI_MotDePasse est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 130
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieMotDePasse
			Valeur     = ""
		FIN
	FIN

	SAI_Multiligne est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 170
			Largeur    = 180
			Hauteur    = 60
			TypeSaisie = typSaisieMultiligne
			Valeur     = ""
		FIN
	FIN
FIN
