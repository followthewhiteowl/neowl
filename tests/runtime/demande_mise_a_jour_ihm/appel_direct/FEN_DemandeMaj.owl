// Fenêtre voisine — ressource pour test_appel_direct.owl.
//
// DemandeMiseAJour sans paramètre : témoin du déclenchement de base par la
// native DemandeMiseAJourIHM sur la fenêtre courante.

FEN_DemandeMaj est une Fenêtre
	PROPRIETES
		Titre       = "Demande de mise à jour"
		Disposition = dispLibre
		Largeur     = 300
		Hauteur     = 200
	FIN

	PROCEDURE DemandeMiseAJour()
		callback_verifie("DM;")
	FIN
FIN
