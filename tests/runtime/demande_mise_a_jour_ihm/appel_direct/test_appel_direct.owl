//  — DemandeMiseAJourIHM() déclenche l'event DemandeMiseAJour de la
// fenêtre courante.
//
// ROUGE ATTENDU (pré-impl) : la native DemandeMiseAJourIHM n'existe pas
// encore côté OWL (compile-error, symbole inconnu).

TestModeHeadless(Vrai)

seq est une chaîne = ""

PROCEDURE callback_verifie(s est une chaîne)
	seq += s
FIN

Ouvre(FEN_DemandeMaj)

DemandeMiseAJourIHM()
dbgVérifieEgalité(seq, "DM;", "DemandeMiseAJourIHM déclenche DemandeMiseAJour sur la fenêtre courante")

Ferme(FEN_DemandeMaj)
dbgBilanTest()
