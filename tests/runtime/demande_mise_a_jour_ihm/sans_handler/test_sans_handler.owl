//  — DemandeMiseAJourIHM() sur une fenêtre sans handler
// DemandeMiseAJour déclaré : pas de crash, pas d'erreur posée.
//
// ROUGE ATTENDU (pré-impl) : la native DemandeMiseAJourIHM n'existe pas
// encore côté OWL (compile-error, symbole inconnu).

TestModeHeadless(Vrai)

Ouvre(FEN_DemandeMajSansHandler)

DemandeMiseAJourIHM()
bErr est un booléen = ErreurDétectée
dbgVérifieVrai(bErr = Faux, "DemandeMiseAJourIHM sans handler déclaré : aucune erreur posée")

Ferme(FEN_DemandeMajSansHandler)
dbgBilanTest()
