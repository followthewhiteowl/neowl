// Fenetre voisine pour test_icone_non_regression.
// Verrouille deux acquis anterieur a  :
//   -  : l'icone est bien rendue (pixels non-fond presents).
//   -  : la couleur de l'icone est preservee (pas de blanc force).
// Un Bouton et un Champ Image avec icone coloree (icones.github_icon).
// Fond sombre pour distinguer les pixels d'icone.

FEN_IcoNonReg est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 350
		Hauteur     = 200
		Titre       = "Icone non-regression"
		CouleurFond = RVB(15, 15, 15)
	FIN

	BTN_IcoColore est un Champ Bouton
		PROPRIETES
			X       = 20
			Y       = 50
			Largeur = 100
			Hauteur = 80
			Image   = icones.github_icon
		FIN
	FIN

	IMG_IcoColore est un Champ Image
		PROPRIETES
			X           = 160
			Y           = 50
			Largeur     = 100
			Hauteur     = 100
			Image       = icones.github_icon
			CouleurFond = RVB(30, 30, 30)
		FIN
	FIN

FIN
