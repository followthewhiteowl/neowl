// Fenetre voisine pour test_icone_override_taille.
// Quatre boutons : deux avec icone (auto vs override), deux boutons nus de reference.
//   BTN_Auto     : Hauteur=96, icone auto-adaptee (~96px)
//   BTN_NuAuto   : Hauteur=96, sans icone (reference pour BTN_Auto)
//   BTN_Override : Hauteur=96, icone forcee a 32px via ImageTaille=32
//   BTN_NuOvr    : Hauteur=96, sans icone (reference pour BTN_Override)
//
// La diff pixel entre btn-avec et btn-nu de meme hauteur isole les pixels d'icone,
// en neutralisant le chrome du QPushButton (cadre arrondi, padding, fond).
// Auto   : nbDiff_Auto   ≈ 704  (icone ~96px)
// Override: nbDiff_Override ≈ 144 (icone 32px)

FEN_IcoOverride est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 600
		Hauteur     = 250
		Titre       = "Icone override taille"
		CouleurFond = RVB(15, 15, 15)
	FIN

	// Bouton de reference : icone auto-adaptee (selon Hauteur=96).
	BTN_Auto est un Champ Bouton
		PROPRIETES
			X       = 20
			Y       = 50
			Largeur = 120
			Hauteur = 96
			Image   = icones.add
		FIN
	FIN

	// Bouton nu de reference (meme geometrie que BTN_Auto).
	BTN_NuAuto est un Champ Bouton
		PROPRIETES
			X       = 160
			Y       = 50
			Largeur = 120
			Hauteur = 96
		FIN
	FIN

	// Bouton avec override : icone forcee a 32px quelle que soit la hauteur.
	// ImageTaille (EN: ImageSize) = entier pixels, 0 = auto-adapte.
	BTN_Override est un Champ Bouton
		PROPRIETES
			X           = 320
			Y           = 50
			Largeur     = 120
			Hauteur     = 96
			Image       = icones.add
			ImageTaille = 32
		FIN
	FIN

	// Bouton nu de reference (meme geometrie que BTN_Override).
	BTN_NuOvr est un Champ Bouton
		PROPRIETES
			X       = 460
			Y       = 50
			Largeur = 120
			Hauteur = 96
		FIN
	FIN

FIN
