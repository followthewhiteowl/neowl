// Fenetre voisine pour test_icone_adaptative_bouton.
// Quatre boutons : deux avec icone (icones.add), deux boutons nus de reference.
//   BTN_AvecH80  : Hauteur=80, icone (> 64px pour eviter clipping Qt)
//   BTN_NuH80   : Hauteur=80, sans icone (reference)
//   BTN_AvecH150 : Hauteur=150, icone
//   BTN_NuH150  : Hauteur=150, sans icone (reference)
//
// Les boutons avec et sans icone de meme hauteur ont des geometries identiques.
// La difference pixel = zones d'icone. Si 64px fixe : diff_80 ≈ diff_150.
// Apres fix (adaptatif) : diff_80 << diff_150.
//
// IMPORTANT : Hauteur > 64px pour eviter le clipping Qt qui masquerait le bug.

FEN_IcoBtnAdaptatif est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 600
		Hauteur     = 300
		Titre       = "Icone adaptative bouton"
		CouleurFond = RVB(15, 15, 15)
	FIN

	BTN_AvecH80 est un Champ Bouton
		PROPRIETES
			X       = 10
			Y       = 100
			Largeur = 120
			Hauteur = 80
			Image   = icones.add
		FIN
	FIN

	BTN_NuH80 est un Champ Bouton
		PROPRIETES
			X       = 150
			Y       = 100
			Largeur = 120
			Hauteur = 80
		FIN
	FIN

	BTN_AvecH150 est un Champ Bouton
		PROPRIETES
			X       = 300
			Y       = 30
			Largeur = 140
			Hauteur = 150
			Image   = icones.add
		FIN
	FIN

	BTN_NuH150 est un Champ Bouton
		PROPRIETES
			X       = 455
			Y       = 30
			Largeur = 140
			Hauteur = 150
		FIN
	FIN

FIN
