// Fenetre voisine pour test_icone_adaptative_champ_image.
// Deux Champs Image de tailles differentes avec la meme icone (icones.add).
//   IMG_Petit : 60x60  — icone doit etre rasterisee a ~60px
//   IMG_Grand : 160x160 — icone doit etre rasterisee a ~160px
//
// Avant fix (64px fixe) : les deux champs contiennent la meme icone 64px
//   → bbox_Petit ≈ bbox_Grand (identiques ou proches) → ratio ≈ 1.0.
// Apres fix (adaptatif) : icone 60px dans Petit, 160px dans Grand
//   → bbox_Grand >> bbox_Petit → ratio > 1.8.
//
// Fond sombre pour distinguer les pixels d'icone du fond du champ.

FEN_IcoImgAdaptative est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 300
		Titre       = "Icone adaptative champ image"
		CouleurFond = RVB(15, 15, 15)
	FIN

	// Champ Image petit : 60x60.
	IMG_Petit est un Champ Image
		PROPRIETES
			X           = 20
			Y           = 20
			Largeur     = 60
			Hauteur     = 60
			Image       = icones.add
			CouleurFond = RVB(30, 30, 30)
		FIN
	FIN

	// Champ Image grand : 160x160.
	IMG_Grand est un Champ Image
		PROPRIETES
			X           = 120
			Y           = 20
			Largeur     = 160
			Hauteur     = 160
			Image       = icones.add
			CouleurFond = RVB(30, 30, 30)
		FIN
	FIN

FIN
