// Ressource Etat voisine de test_expr_proprietes_statique_regression.owl.
//
// Non-régression ( — dégel) : Libellé est un LITTÉRAL constant
// dans PROPRIETES ("FIXE", pas une expression sur variable). Le Corps est
// imprimé 3 fois (2 rendus manuels via iImprimeBloc + le rendu
// automatique final) : les 3 rendus doivent afficher IDENTIQUEMENT
// "FIXE", que la ré-évaluation par rendu de bloc soit active ou non.

ETAT_ExprProprietesStatiqueRegression est un État
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	corps est un Corps
		PROPRIETES
			Hauteur = 10
		FIN

		LIB_X est un Champ Libellé
			PROPRIETES
				Libellé      = "FIXE"
				X            = 20
				Y            = 2
				Largeur      = 100
				Hauteur      = 6
				PoliceNom    = iPoliceLiberationSans
				PoliceTaille = 9
			FIN
		FIN
	FIN

	PROCEDURE Lecture()
		iImprimeBloc("Corps")
		iImprimeBloc("Corps")
	FIN
FIN
