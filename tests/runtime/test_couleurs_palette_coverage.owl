// @sujet : Constantes de palette couleur (valeurs packées)
// @résumé : Couverture des constantes de couleurs nommées de la palette. Chaque constante est un entier = valeur RGB packée (R + V*256 + B*65536). On vérifie la valeur exacte de chaque teinte. CouleurDéfaut est un sentinel (valeur négative dédiée à la couleur par défaut/système), distinct d'un RGB normal.

// Couleurs neutres / métalliques. Valeurs packées exactes de la palette.
PROCEDURE scenario_palette_neutres()
	dbgVérifieEgalité(Argent, 12632256, "Argent = #C0C0C0 packé")
	dbgVérifieEgalité(Bronze, 3309517, "Bronze = #CD7F32 packé")
FIN


// Famille Cyan : clair / foncé / pastel.
PROCEDURE scenario_palette_cyan()
	dbgVérifieEgalité(CyanClair, 16776960, "CyanClair packé")
	dbgVérifieEgalité(CyanFoncé, 8421376, "CyanFoncé packé")
	dbgVérifieEgalité(CyanPastel, 16777113, "CyanPastel packé")
FIN


// Famille Magenta : clair / foncé / pastel.
PROCEDURE scenario_palette_magenta()
	dbgVérifieEgalité(MagentaClair, 16711935, "MagentaClair packé")
	dbgVérifieEgalité(MagentaFoncé, 8388736, "MagentaFoncé packé")
	dbgVérifieEgalité(MagentaPastel, 16751103, "MagentaPastel packé")
FIN


// Famille Marron : clair / foncé / pastel.
PROCEDURE scenario_palette_marron()
	dbgVérifieEgalité(MarronClair, 2763429, "MarronClair packé")
	dbgVérifieEgalité(MarronFoncé, 10584, "MarronFoncé packé")
	dbgVérifieEgalité(MarronPastel, 6510979, "MarronPastel packé")
