// Famille Violet : clair / foncé / pastel.
PROCEDURE scenario_palette_violet()
	dbgVérifieEgalité(VioletClair, 15631086, "VioletClair packé")
	dbgVérifieEgalité(VioletFoncé, 13828244, "VioletFoncé packé")
	dbgVérifieEgalité(VioletPastel, 13212107, "VioletPastel packé")
