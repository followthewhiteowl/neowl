// Teintes isolées de la palette : jaune foncé et rouge pastel.
PROCEDURE scenario_palette_diverses()
	dbgVérifieEgalité(JauneFoncé, 32896, "JauneFoncé packé")
	dbgVérifieEgalité(RougePastel, 10066431, "RougePastel packé")
FIN


// Décomposition RGB d'une couleur de palette : la valeur packée encode
// R sur bits 0-7, V sur 8-15, B sur 16-23. CyanClair = 16776960 = 0xFFFF00,
// soit Rouge=0, Vert=255, Bleu=255 (encodage BGR : l'octet de poids faible
// est le Rouge). Vérifie que la valeur exacte se décompose correctement,
// en renfort de l'assertion sur valeur brute.
PROCEDURE scenario_palette_decomposition_rgb()
	c est une Couleur = CyanClair
	dbgVérifieEgalité(c..Rouge, 0, "CyanClair composante Rouge")
	dbgVérifieEgalité(c..Vert, 255, "CyanClair composante Vert")
	dbgVérifieEgalité(c..Bleu, 255, "CyanClair composante Bleu")
	dbgVérifieEgalité(c..Couleur, 16776960, "CyanClair valeur packée via type Couleur")
FIN


// CouleurDéfaut : cas spécial. Ce n'est PAS un RGB normal mais un sentinel
// signalant « couleur par défaut / système ». Sa valeur entière dédiée est
// négative (-2), voisine du sentinel iSystème (-3). On verrouille la valeur
// exacte du sentinel.
PROCEDURE scenario_couleur_defaut_sentinel()
	dbgVérifieEgalité(CouleurDéfaut,-2, "CouleurDéfaut = sentinel -2 (couleur par défaut, pas un RGB)")
FIN
