// dispHorizontale + AlignH/AlignV.

FEN_Horiz est une Fenêtre
	PROPRIETES
		Disposition = dispHorizontale
		AlignH      = alignFin
		AlignV      = alignCentre
		Espacement  = 8
	FIN
	BTN_OK est un Champ Bouton
		PROPRIETES
			Libellé = "OK"
			Largeur = 80
		FIN
	FIN
	BTN_KO est un Champ Bouton
		PROPRIETES
			Libellé    = "Annuler"
			Alignement = alignDébut
		FIN
	FIN
FIN
