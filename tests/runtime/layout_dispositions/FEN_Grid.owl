// dispGrille + ColSpan/RowSpan.

FEN_Grid est une Fenêtre
	PROPRIETES
		Disposition = dispGrille
		Colonnes    = 3
		Lignes      = 2
		Espacement  = 4
	FIN
	BTN_1 est un Champ Bouton
		PROPRIETES
			Libellé = "1"
		FIN
	FIN
	BTN_2 est un Champ Bouton
		PROPRIETES
			Libellé = "2"
		FIN
	FIN
	BTN_3 est un Champ Bouton
		PROPRIETES
			Libellé = "3"
		FIN
	FIN
	BTN_4 est un Champ Bouton
		PROPRIETES
			Libellé = "4"
			ColSpan = 2
		FIN
	FIN
	BTN_5 est un Champ Bouton
		PROPRIETES
			Libellé = "5"
			RowSpan = 1
		FIN
	FIN
FIN
