// Fenêtre voisine — ressource pour test_guidage_frappe_date_heure.owl
// (, guidage de frappe date/heure via masque de saisie Qt dérivé du
// format effectif). Cinq champs : deux Date (un sans masque = défaut
// JJ/MM/AAAA implicite, un avec masque à jetons NOMMÉS pour le cas de repli
// hors-scope), un Heure (masque HH:MI:SS posé au script), un Numérique et un
// Texte témoins (non-régression : le guidage ne doit affecter que Date/Heure).

FEN_GuidageFrappeDateHeure est une Fenêtre
	PROPRIETES
		Titre       = "Guidage frappe Date/Heure"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 220
	FIN

	SAI_DateDefaut est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 10
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieDate
			Valeur     = ""
		FIN
	FIN

	SAI_DateNommee est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 50
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieDate
			Valeur     = ""
		FIN
	FIN

	SAI_Heure est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 90
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieHeure
			Valeur     = ""
		FIN
	FIN

	SAI_Num est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 130
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieNum
			Valeur     = ""
		FIN
	FIN

	SAI_Texte est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 170
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieTexte
			Valeur     = ""
		FIN
	FIN
FIN
