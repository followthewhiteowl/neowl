//  — sous-attribut Ombre (FR) / Shadow (EN) sur CadreExtérieur
// (styleBouton). Portée Phase 2 : CadreExtérieur seul.
ThèmeOmbre est un Thème
	boutonÉlevé est un styleBouton = {
		CadreExtérieur = {
			Ombre = {
				Couleur   = Noir
				DécalageX = 0
				DécalageY = 6
				Flou      = 16
				Étendue   = 2
			}
		}
	}

	boutonGlowEN est un styleBouton = {
		CadreExtérieur = {
			Shadow = {
				Color   = CyanClair
				OffsetX = 0
				OffsetY = 0
				Blur    = 24
				Spread  = 3
			}
		}
	}

	boutonSansOmbre est un styleBouton = {
		CadreExtérieur = { CouleurFond = Blanc }
	}
FIN
