// Fenêtre voisine — ressource pour test_table_props_couverture.owl.
//
// Couverture des propriétés communes de champ portées par le Champ Table :
//   - Etat (dont la valeur AffichageSansSélection, spécifique Table),
//   - Libellé (Caption).
//
// Rig GUI réel obligatoire (TestModeHeadless(Faux)) : la désactivation de la
// sélection utilisateur ne se mesure que sur des widgets Qt réellement montés.

FEN_TablePropsCouv est une Fenêtre
	PROPRIETES
		Titre       = "Couverture props Table"
		Disposition = dispLibre
		Largeur     = 700
		Hauteur     = 300
	FIN

	TAB_Decl est un Champ Table
		PROPRIETES
			X            = 10
			Y            = 10
			Largeur      = 300
			Hauteur      = 200
			Libellé      = "Synthèse"
			Etat         = AffichageSansSélection
		FIN

		COL_A est une Colonne
			PROPRIETES
				Libellé = "A"
			FIN
		FIN
	FIN

	TAB_Beh est un Champ Table
		PROPRIETES
			X       = 380
			Y       = 10
			Largeur = 300
			Hauteur = 200
		FIN

		COL_N est une Colonne
			PROPRIETES
				Libellé = "Nom"
				Largeur = 200
			FIN
		FIN
	FIN

	SAI_NonTable est un Champ Saisie
		PROPRIETES
			X       = 10
			Y       = 220
			Valeur  = ""
		FIN
	FIN

	PROCEDURE FinInitialisation()
		TableAjouteLigne(TAB_Beh, "Alpha")
		TableAjouteLigne(TAB_Beh, "Bravo")
		TableAjouteLigne(TAB_Beh, "Charlie")
	FIN
FIN
