// Fenêtre voisine — ressource pure pour test_init_declarative.owl.
// SAI_Client initialise `refClient` directement dans son bloc PROPRIETES ;
// BTN_Valider initialise `codeInterne` avec une chaîne pour exercer la
// coercition déclarative chaîne -> entier au moment de l'init.
FEN_PropsInit est une Fenêtre
	PROPRIETES
		Titre       = "Props init déclarative"
		Largeur     = 320
		Hauteur     = 240
		Disposition = dispLibre
	FIN

	SAI_Client est un Champ de Saisie
		PROPRIETES
			X         = 10
			Y         = 10
			Largeur   = 150
			Hauteur   = 30
			refClient = "C-4087"
		FIN
	FIN

	BTN_Valider est un Champ Bouton
		PROPRIETES
			Libellé     = "Valider"
			X           = 10
			Y           = 50
			Largeur     = 100
			Hauteur     = 30
			codeInterne = "42"
		FIN
	FIN
FIN
