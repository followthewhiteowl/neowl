// Fenêtre voisine — ressource pure pour test_declaration_usage.owl.
// Porte un Champ de Saisie, un Champ Bouton et un Champ Table pour exercer
// l'universalité des props custom (tous kinds + Fenêtre elle-même).

FEN_PropsPerso est une Fenêtre
	PROPRIETES
		Titre       = "Props perso"
		Largeur     = 320
		Hauteur     = 240
		Disposition = dispLibre
	FIN

	SAI_Client est un Champ de Saisie
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 150
			Hauteur = 30
		FIN
	FIN

	BTN_Valider est un Champ Bouton
		PROPRIETES
			Libellé = "Valider"
			X       = 10
			Y       = 50
			Largeur = 100
			Hauteur = 30
		FIN
	FIN

	TABLE_Clients est un Champ Table
		PROPRIETES
			X       = 10
			Y       = 90
			Largeur = 280
			Hauteur = 120
		FIN

		COL_Nom est une Colonne
			PROPRIETES
				Libellé = "Nom"
				Type    = colTypeTexte
				Largeur = 280
			FIN
		FIN
	FIN
FIN
