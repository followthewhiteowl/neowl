// Fenêtre voisine — ressource pure pour test_coercion.owl.
// Porte un Champ de Saisie unique pour exercer la coercition des
// propriétés custom à l'affectation.
FEN_PropsCoercion est une Fenêtre
	PROPRIETES
		Titre       = "Props coercion"
		Largeur     = 300
		Hauteur     = 200
		Disposition = dispLibre
	FIN

	SAI_Client est un Champ de Saisie
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 150
			Hauteur = 30
		FIN
	FIN
FIN
