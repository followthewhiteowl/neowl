// Ressource Etat pure utilisee par test_parite.owl.
//
// Deux sous-champs Libelle dans le meme Corps :
//   - LIB_Fr porte l'event en francais (AvantImpression) -> temoin.
//   - LIB_En porte le meme event en anglais (BeforePrint).
// A l'impression (iImprimeEtat imprime le Corps 1x), les deux events
// doivent se declencher a parite : le nom source EN doit se ranger sous
// le meme canon que le FR pour que le cablage runtime le retrouve.

ETAT_Parite est un Etat
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	corps est un Corps
		PROPRIETES
			Hauteur = 40
		FIN

		LIB_Fr est un Champ Libelle
			PROPRIETES
				Libelle = "FR"
				X       = 20
				Y       = 10
				Largeur = 100
				Hauteur = 15
			FIN

			PROCEDURE AvantImpression()
				callback_fr()
			FIN
		FIN

		LIB_En est un Champ Libelle
			PROPRIETES
				Libelle = "EN"
				X       = 20
				Y       = 25
				Largeur = 100
				Hauteur = 15
			FIN

			PROCEDURE BeforePrint()
				callback_en()
			FIN
		FIN
	FIN
FIN
