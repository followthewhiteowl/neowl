// Fenêtre voisine — ressource pour test_table_natives_resolve.owl.

FEN_Test est une Fenêtre
	PROPRIETES
		Largeur     = 400
		Hauteur     = 300
		Disposition = dispVerticale
	FIN

	TABLE_Items est un Champ Table
		PROPRIETES
			Largeur = 380
			Hauteur = 250
		FIN

		COL_Nom est une Colonne
			PROPRIETES
				Libellé = "Nom"
				Type    = colTypeTexte
				Largeur = 200
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		// Forme reference directe (forme preferee post-)
		TableAjouteLigne(TABLE_Items, "Alpha")
		TableAjouteLigne(TABLE_Items, "Beta")

		// Forme nom (string) — doc promet "reference ou nom"
		TableAjouteLigne("TABLE_Items", "Gamma")

		// TableSupprime
		TableSupprime(TABLE_Items, 1)

		// TableModifieLigne
		TableAjouteLigne(TABLE_Items, "Delta")
		TableModifieLigne(TABLE_Items, 1, "Epsilon")

		// TableSupprimeTout
		TableSupprimeTout(TABLE_Items)
	FIN
FIN
