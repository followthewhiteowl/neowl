// Fenêtre voisine — ressource pour test_prescan_widget_order_normal.owl.
// Widget declare AVANT la procedure qui l'utilise.

FEN_OrdreNormal est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 300
		Hauteur     = 200
	FIN

	// Widget declare EN PREMIER
	LIB_X est un Champ Libellé
		PROPRIETES
			X       = 10
			Y       = 10
			Libellé = "initial"
		FIN
	FIN

	// Code top-level declare APRES le widget
	LIB_X..Libellé   = "modifie apres"
	LIB_X..PoliceNom = "Verdana"

	PROCEDURE RemonteEtat()
		callback_etat(LIB_X..Libellé, LIB_X..PoliceNom)
	FIN
FIN
