// Test : prescan widgets - non-regression ordre normal.
// Widget declare AVANT la procedure qui l'utilise : doit continuer de marcher
// (vert aujourd'hui ET apres prescan).
//
// Pattern : la fenêtre voisine FEN_OrdreNormal.owl porte la déclaration.

TestModeHeadless(Vrai)

libelleObs est une chaîne = ""
policeObs est une chaîne = ""

PROCEDURE callback_etat(l est une chaîne, p est une chaîne)
	libelleObs = l
	policeObs  = p
FIN

Ouvre(FEN_OrdreNormal)
RemonteEtat()

dbgVérifieEgalité(libelleObs, "modifie apres", "ordre normal : proc apres widget OK")
dbgVérifieEgalité(policeObs, "Verdana", "ordre normal : sous-champ acces OK")

dbgBilanTest()
