//  — `Style..CadreExtérieur..CouleurFond` / `..Cadre..Couleur` sur
// un Champ Libellé autonome : le conteneur qui enveloppe le widget (même
// principe que le Saisie, cf. ). Pas de CouleurFond posée sur le
// sous-élément Libellé ici : seule la bordure du conteneur doit être visible.
FEN_StyleLibelleElementCadre est une Fenêtre
	PROPRIETES
		Titre       = "Style Libellé — élément CadreExtérieur"
		Largeur     = 400
		Hauteur     = 120
		Disposition = dispLibre
		CouleurFond = RVB(10, 10, 10)
	FIN

	LIB_X est un Champ Libellé
		PROPRIETES
			X                                       = 20
			Y                                       = 20
			Largeur                                 = 300
			Hauteur                                 = 60
			Libellé                                 = "Texte"
			Style..CadreExtérieur..CouleurFond      = RVB(200, 200, 0)
			Style..CadreExtérieur..Cadre..Couleur   = RVB(0, 128, 255)
			Style..CadreExtérieur..Cadre..Epaisseur = 5
		FIN
	FIN
FIN
