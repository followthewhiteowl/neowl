// Fenêtre voisine — ressource compile-only dédiée au garde-fou GUI de ce
// dossier (distincte de FEN_ComboHeadless pour éviter toute collision de
// nom de champ avec les tests headless purs).
FEN_ComboHeadlessGuard est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
	FIN

	COMBO_HeadlessGuard est un Champ Combo
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 240
			Hauteur = 25
		FIN
	FIN
FIN
