// Menus contextuels : mêmes trois cas que le menu principal (thème seul,
// thème puis cascade, cascade puis thème). Un menu contextuel n'a pas de
// surface Barre : seules SousMenu et OptionMenu sont habillées.

FEN_MenuThemeContextuel est une Fenêtre
	PROPRIETES
		Titre       = "Menus contextuels stylés par le thème"
		Largeur     = 400
		Hauteur     = 200
		Disposition = dispLibre
	FIN

	MNU_Ctx est un MenuContextuel
		PROPRIETES
			Style = theme.ctxSombre
		FIN

		OPT_Copier est une OptionMenu
			PROPRIETES
				Libellé = "Copier"
			FIN
		FIN
	FIN

	MNU_CtxSurcharge est un MenuContextuel
		PROPRIETES
			Style                        = theme.ctxSombre
			Style..SousMenu..CouleurFond = JauneClair
		FIN

		OPT_Coller est une OptionMenu
			PROPRIETES
				Libellé = "Coller"
			FIN
		FIN
	FIN

	MNU_CtxInverse est un MenuContextuel
		PROPRIETES
			Style..SousMenu..CouleurFond = JauneClair
			Style                        = theme.ctxSombre
		FIN

		OPT_Couper est une OptionMenu
			PROPRIETES
				Libellé = "Couper"
			FIN
		FIN
	FIN

	SAI_Cible est un Champ Saisie
		PROPRIETES
			X              = 10
			Y              = 10
			Largeur        = 200
			Hauteur        = 25
			MenuContextuel = MNU_Ctx
		FIN
	FIN
FIN
