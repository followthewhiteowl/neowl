// Style du thème PUIS cascade : la cascade gagne sur la seule propriété
// qu'elle pose, tout le reste du thème est conservé.

FEN_MenuThemeSurcharge est une Fenêtre
	PROPRIETES
		Titre         = "Menu principal thème + surcharge"
		Largeur       = 500
		Hauteur       = 300
		Disposition   = dispLibre
		MenuPrincipal = MNU_Surcharge
	FIN

	MNU_Surcharge est un MenuPrincipal
		PROPRIETES
			Style                     = theme.menuSombre
			Style..Barre..CouleurFond = JauneClair
		FIN

		SM_Fichier est un SousMenu
			PROPRIETES
				Libellé = "&Fichier"
			FIN

			OPT_Quitter est une OptionMenu
				PROPRIETES
					Libellé = "&Quitter"
				FIN
			FIN
		FIN
	FIN
FIN
