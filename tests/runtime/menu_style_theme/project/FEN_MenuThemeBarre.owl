// Un MenuPrincipal consomme un style nommé du thème, sans aucune cascade.
// Toutes les surfaces (Barre, SousMenu, OptionMenu) doivent venir du thème.

FEN_MenuThemeBarre est une Fenêtre
	PROPRIETES
		Titre         = "Menu principal stylé par le thème"
		Largeur       = 500
		Hauteur       = 300
		Disposition   = dispLibre
		MenuPrincipal = MNU_Theme
	FIN

	MNU_Theme est un MenuPrincipal
		PROPRIETES
			Style = theme.menuSombre
		FIN

		SM_Fichier est un SousMenu
			PROPRIETES
				Libellé = "&Fichier"
			FIN

			OPT_Quitter est une OptionMenu
				PROPRIETES
					Libellé = "&Quitter"
				FIN
			FIN
		FIN
	FIN
FIN
