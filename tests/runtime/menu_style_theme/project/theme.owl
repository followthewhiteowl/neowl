// Catalogue de styles nommés consommé par les menus voisins. Chaque teinte est
// distincte pour que la feuille de style mesurée identifie sans ambiguïté la
// surface d'où elle vient.

ThèmeMenuStyle est un Thème
	menuSombre est un styleMenuPrincipal = {
		Barre = {
			Couleur     = Argent
			CouleurFond = MarronFoncé
		}
		SousMenu = {
			CouleurFond    = BleuFoncé
			CouleurBordure = Bronze
		}
		OptionMenu = {
			Couleur     = JauneOr
			CouleurFond = VertFoncé
		}
	}

	ctxSombre est un styleMenuContextuel = {
		SousMenu = {
			CouleurFond    = MagentaFoncé
			CouleurBordure = RosePastel
		}
		OptionMenu = {
			Couleur     = CyanFoncé
			CouleurFond = VioletFoncé
		}
	}
FIN
