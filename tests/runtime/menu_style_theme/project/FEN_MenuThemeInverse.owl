// Cascade PUIS style du thème : l'affectation de la propriété entière remet à
// zéro les cascades antérieures, le thème gagne donc partout.

FEN_MenuThemeInverse est une Fenêtre
	PROPRIETES
		Titre         = "Menu principal cascade puis thème"
		Largeur       = 500
		Hauteur       = 300
		Disposition   = dispLibre
		MenuPrincipal = MNU_Inverse
	FIN

	MNU_Inverse est un MenuPrincipal
		PROPRIETES
			Style..Barre..CouleurFond = JauneClair
			Style                     = theme.menuSombre
		FIN

		SM_Fichier est un SousMenu
			PROPRIETES
				Libellé = "&Fichier"
			FIN

			OPT_Quitter est une OptionMenu
				PROPRIETES
					Libellé = "&Quitter"
				FIN
			FIN
		FIN
	FIN
FIN
