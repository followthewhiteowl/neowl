// Fenêtre voisine — ressource pour test_format_monetaire_heritage_champ.owl.
// Un seul champ Monétaire, volontairement SANS son propre `FormatMonétaire` :
// sert à prouver que c'est le `FormatMonétaire` du projet voisin qui pilote
// l'affichage (héritage projet -> champ), et que le round-trip GET dé-formate
// correctement le texte affiché (symbole + séparateur) pour restituer une
// valeur monétaire exacte.

FEN_HeritageChampMonetaire est une Fenêtre
	PROPRIETES
		Titre       = "FormatMonétaire héritage champ"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 120
	FIN

	SAI_Montant est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 10
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieMonétaire
			Valeur     = ""
		FIN
	FIN
FIN
