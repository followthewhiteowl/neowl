// Fichier de thème désigné par Projet..Thème. Style de base partagé,
// utilisé par plusieurs widgets pour vérifier que la surcharge posée sur
// l'un d'eux n'affecte ni ses jumeaux ni la source du thème (isolation).

ThèmeSurchargeStyle est un Thème
	bp est un styleBouton = {
		CadreExtérieur = {
			CouleurFond = Blanc
			Dégradé     = {
				Type         = dégradéLinéaire
				CouleurDébut = RVB(126, 103, 187)
				CouleurFin   = RVB(94, 72, 150)
			}
			Ombre = {
				Couleur   = Noir
				DécalageX = 0
				DécalageY = 6
				Flou      = 16
				Étendue   = 2
			}
		}
	}
FIN
