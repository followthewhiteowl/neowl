//  (LOT 4) — opacité sur `Style..CadreInterne..Cadre..Couleur`
// (bordure de chaque répétition) d'un Champ ZoneRépétée.
FEN_CouleurAlphaZrCadreInterne est une Fenêtre
	PROPRIETES
		Titre       = "Alpha Zone répétée — CadreInterne (bordure)"
		Largeur     = 460
		Hauteur     = 340
		Disposition = dispLibre
		CouleurFond = RVB(255, 0, 0)
	FIN

	ZR_CadreInterneOpaque est un Champ ZoneRépétée
		PROPRIETES
			X                                     = 20
			Y                                     = 20
			Largeur                               = 400
			Hauteur                               = 140
			Sens                                  = zrVertical
			HauteurRepetition                     = 50
			Style..CadreExtérieur..CouleurFond    = RVB(255, 0, 0)
			Style..CadreInterne..Cadre..Couleur   = RVB(0, 255, 0)
			Style..CadreInterne..Cadre..Epaisseur = 6
		FIN

		LIB_Vide7 est un Champ Libellé
			PROPRIETES
				X       = 5
				Y       = 5
				Largeur = 1
				Libellé = ""
			FIN
		FIN
	FIN

	ZR_CadreInterneAlpha est un Champ ZoneRépétée
		PROPRIETES
			X                                     = 20
			Y                                     = 180
			Largeur                               = 400
			Hauteur                               = 140
			Sens                                  = zrVertical
			HauteurRepetition                     = 50
			Style..CadreExtérieur..CouleurFond    = RVB(255, 0, 0)
			Style..CadreInterne..Cadre..Couleur   = {Rouge = 0, Vert = 255, Bleu = 0, Opacité = 128}
			Style..CadreInterne..Cadre..Epaisseur = 6
		FIN

		LIB_Vide8 est un Champ Libellé
			PROPRIETES
				X       = 5
				Y       = 5
				Largeur = 1
				Libellé = ""
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		j est un entier

		j = ZoneRépétéeAjouteLigne(ZR_CadreInterneOpaque)
		j = ZoneRépétéeAjouteLigne(ZR_CadreInterneOpaque)

		j = ZoneRépétéeAjouteLigne(ZR_CadreInterneAlpha)
		j = ZoneRépétéeAjouteLigne(ZR_CadreInterneAlpha)
	FIN
FIN
