//  — une couleur de fond demandée SANS cadre doit rendre l'aplat exact.
// Le Champ Combo peignait un dégradé à la place : mesuré #FE8282 en haut et
// #FB6363 en bas pour un RVB(255, 0, 0) demandé — la couleur écrite
// n'apparaissait nulle part. Les autres familles (Saisie, Bouton, Libellé,
// Liste, Interrupteur, Sélecteur) rendaient déjà l'aplat : elles sont ici comme
// oracles, elles bornent la portée du défaut.
FEN_ComboFondSansCadre est une Fenêtre
	PROPRIETES
		Titre       = "Fond sans cadre"
		Largeur     = 500
		Hauteur     = 580
		Disposition = dispLibre
		CouleurFond = RVB(10, 10, 10)
	FIN

	// --- Le défaut : fond demandé par le style typé, aucun cadre.
	CFSStyle est un Champ Combo
		PROPRIETES
			X                              = 20
			Y                              = 20
			Largeur                        = 200
			Hauteur                        = 40
			Contenu                        = ["Alpha", "Beta"]
			Style..ZoneSaisie..CouleurFond = RVB(255, 0, 0)
		FIN
	FIN

	// --- Même défaut par la propriété directe (chemin de feuille distinct).
	CFSDirect est un Champ Combo
		PROPRIETES
			X           = 20
			Y           = 80
			Largeur     = 200
			Hauteur     = 40
			Contenu     = ["Alpha", "Beta"]
			CouleurFond = RVB(255, 0, 0)
		FIN
	FIN

	// --- Cas déjà correct : un cadre posé. Ne pas le casser.
	CFSCadre est un Champ Combo
		PROPRIETES
			X                                   = 20
			Y                                   = 140
			Largeur                             = 200
			Hauteur                             = 40
			Contenu                             = ["Alpha", "Beta"]
			Style..ZoneSaisie..CouleurFond      = RVB(255, 0, 0)
			Style..ZoneSaisie..Cadre..Couleur   = RVB(0, 255, 0)
			Style..ZoneSaisie..Cadre..Epaisseur = 2
		FIN
	FIN

	// --- Jumeau nu : aucun style demandé, le champ garde son habillage d'origine.
	CFSNu est un Champ Combo
		PROPRIETES
			X       = 20
			Y       = 200
			Largeur = 200
			Hauteur = 40
			Contenu = ["Alpha", "Beta"]
		FIN
	FIN

	// --- Dégradé EXPLICITEMENT demandé : c'est une fonctionnalité, elle doit
	// rendre un vrai dégradé (et pas l'habillage d'origine du champ).
	CFSDegrade est un Champ Combo
		PROPRIETES
			X                                            = 20
			Y                                            = 260
			Largeur                                      = 200
			Hauteur                                      = 40
			Contenu                                      = ["Alpha", "Beta"]
			Style..CadreExtérieur..Dégradé..Type         = dégradéLinéaire
			Style..CadreExtérieur..Dégradé..Angle        = 90
			Style..CadreExtérieur..Dégradé..CouleurDébut = RVB(255, 0, 0)
			Style..CadreExtérieur..Dégradé..CouleurFin   = RVB(0, 0, 255)
		FIN
	FIN

	// --- Oracles : familles qui rendaient déjà l'aplat sans cadre.
	CFSSaisie est un Champ Saisie
		PROPRIETES
			X                              = 20
			Y                              = 320
			Largeur                        = 200
			Hauteur                        = 40
			Style..ZoneSaisie..CouleurFond = RVB(255, 0, 0)
		FIN
	FIN

	CFSBouton est un Champ Bouton
		PROPRIETES
			X                                  = 20
			Y                                  = 380
			Largeur                            = 200
			Hauteur                            = 40
			Libellé                            = "OK"
			Style..CadreExtérieur..CouleurFond = RVB(255, 0, 0)
		FIN
	FIN

	CFSLibelle est un Champ Libellé
		PROPRIETES
			X                                  = 20
			Y                                  = 440
			Largeur                            = 200
			Hauteur                            = 40
			Libellé                            = "Texte"
			Style..CadreExtérieur..CouleurFond = RVB(255, 0, 0)
		FIN
	FIN

	CFSListe est un Champ Liste
		PROPRIETES
			X                                  = 20
			Y                                  = 500
			Largeur                            = 200
			Hauteur                            = 40
			Style..CadreExtérieur..CouleurFond = RVB(255, 0, 0)
		FIN
	FIN

	CFSInter est un Champ Interrupteur
		PROPRIETES
			X                                  = 250
			Y                                  = 20
			Largeur                            = 200
			Hauteur                            = 40
			Options                            = ["X"]
			Style..CadreExtérieur..CouleurFond = RVB(255, 0, 0)
		FIN
	FIN

	CFSSelect est un Champ Sélecteur
		PROPRIETES
			X                                  = 250
			Y                                  = 80
			Largeur                            = 200
			Hauteur                            = 40
			Options                            = ["X"]
			Style..CadreExtérieur..CouleurFond = RVB(255, 0, 0)
		FIN
	FIN
FIN
