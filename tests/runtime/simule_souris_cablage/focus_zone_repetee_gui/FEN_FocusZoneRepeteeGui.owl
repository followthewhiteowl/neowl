// Ressource fenêtre — voisin de test_focus_zone_repetee_gui.owl.
//  : parité GUI/headless de surEntrée / surSortie sur ZoneRépétée.

FEN_FocusZoneRepeteeGui est une Fenêtre
	PROPRIETES
		Titre       = "FocusZoneRepeteeGui offscreen"
		Largeur     = 400
		Hauteur     = 250
		Disposition = dispLibre
	FIN

	nEntreeCount est un entier = 0
	nSortieCount est un entier = 0

	SAI_Focus est un Champ Saisie
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 200
		FIN
	FIN

	ZR_Focus est un Champ ZoneRépétée
		PROPRIETES
			X       = 10
			Y       = 50
			Largeur = 380
			Hauteur = 150
			Sens    = zrVertical
		FIN

		LIB_Item est un Champ Libellé
			PROPRIETES
				X       = 5
				Y       = 5
				Largeur = 200
				Libellé = "Item"
			FIN
		FIN

		PROCEDURE surEntrée()
			nEntreeCount += 1
		FIN

		PROCEDURE surSortie()
			nSortieCount += 1
		FIN
	FIN

	PROCEDURE FinInitialisation()
		r est un entier = ZoneRépétéeAjouteLigne(ZR_Focus)
		callback_focus_zr_gui_prete()
	FIN

	PROCEDURE DonnerFocusZr()
		DonneFocus(ZR_Focus)
	FIN

	PROCEDURE DonnerFocusSaisie()
		DonneFocus(SAI_Focus)
	FIN

	PROCEDURE LireCompteursFocusZrGui()
		callback_focus_zr_gui_compteurs(nEntreeCount, nSortieCount)
	FIN
FIN
