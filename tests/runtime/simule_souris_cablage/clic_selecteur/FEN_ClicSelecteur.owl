// Ressource fenêtre — voisin de test_clic_selecteur.owl.
//  lot 2 : surClic / surDoubleClic sur un Champ Sélecteur.

FEN_ClicSelecteur est une Fenêtre
	PROPRIETES
		Titre       = "ClicSelecteur offscreen"
		Largeur     = 300
		Hauteur     = 150
		Disposition = dispLibre
	FIN

	nSelClicCount est un entier = 0
	nSelDoubleClicCount est un entier = 0

	SEL_Cible est un Champ Sélecteur
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 200
			Options = ["Un", "Deux", "Trois"]
		FIN

		PROCEDURE surClic()
			nSelClicCount += 1
		FIN

		PROCEDURE surDoubleClic()
			nSelDoubleClicCount += 1
		FIN
	FIN

	PROCEDURE FinInitialisation()
		callback_sel_clic_prete()
	FIN

	PROCEDURE LireCompteursSelClic()
		callback_sel_clic_compteurs(nSelClicCount, nSelDoubleClicCount)
	FIN
FIN
