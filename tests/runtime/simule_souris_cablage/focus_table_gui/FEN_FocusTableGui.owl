// Ressource fenêtre — voisin de test_focus_table_gui.owl.
//  : parité GUI/headless de surEntrée / surSortie sur Table.
// (le headless fonctionne déjà, cf. tests/scenarios/ui/event_table_focus)

FEN_FocusTableGui est une Fenêtre
	PROPRIETES
		Titre       = "FocusTableGui offscreen"
		Largeur     = 500
		Hauteur     = 300
		Disposition = dispLibre
	FIN

	nEntreeCount est un entier = 0
	nSortieCount est un entier = 0

	SAI_Focus est un Champ Saisie
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 200
		FIN
	FIN

	TABLE_Focus est un Champ Table
		PROPRIETES
			X       = 10
			Y       = 50
			Largeur = 460
			Hauteur = 200
		FIN

		COL_Valeur est une Colonne
			PROPRIETES
				Libellé = "Valeur"
				Type    = colTypeTexte
				Largeur = 200
			FIN
		FIN

		PROCEDURE surEntrée()
			nEntreeCount += 1
		FIN

		PROCEDURE surSortie()
			nSortieCount += 1
		FIN
	FIN

	PROCEDURE FinInitialisation()
		callback_focus_table_gui_prete()
	FIN

	PROCEDURE DonnerFocusTable()
		DonneFocus(TABLE_Focus)
	FIN

	PROCEDURE DonnerFocusSaisie()
		DonneFocus(SAI_Focus)
	FIN

	PROCEDURE LireCompteursFocusTableGui()
		callback_focus_table_gui_compteurs(nEntreeCount, nSortieCount)
	FIN
FIN
