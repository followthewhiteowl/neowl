// Ressource fenêtre — voisin de test_headless_temoin.owl.
//  : témoin de non-régression du comportement headless de
// TestSimuleSouris. Réutilise Libellé (aucun câblage Qt côté GUI), la
// cible la plus exigeante pour prouver que le mode headless reste
// indépendant de tout câblage réel.

FEN_HeadlessTemoin est une Fenêtre
	PROPRIETES
		Titre       = "HeadlessTemoin"
		Largeur     = 300
		Hauteur     = 150
		Disposition = dispLibre
	FIN

	nClicCount est un entier = 0

	LIB_Cible est un Champ Libellé
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 200
			Libellé = "Cible"
		FIN

		PROCEDURE surClic()
			nClicCount += 1
		FIN
	FIN

	PROCEDURE LireCompteurClicHeadless()
		callback_headless_temoin_compteur(nClicCount)
	FIN
FIN
