// Ressource fenêtre — voisin de test_clic_interrupteur.owl.
//  lot 2 : surClic / surDoubleClic sur un Champ Interrupteur.

FEN_ClicInterrupteur est une Fenêtre
	PROPRIETES
		Titre       = "ClicInterrupteur offscreen"
		Largeur     = 300
		Hauteur     = 150
		Disposition = dispLibre
	FIN

	nIntClicCount est un entier = 0
	nIntDoubleClicCount est un entier = 0

	INT_Cible est un Champ Interrupteur
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 200
			Options = ["Lecture", "Ecriture"]
		FIN

		PROCEDURE surClic()
			nIntClicCount += 1
		FIN

		PROCEDURE surDoubleClic()
			nIntDoubleClicCount += 1
		FIN
	FIN

	PROCEDURE FinInitialisation()
		callback_int_clic_prete()
	FIN

	PROCEDURE LireCompteursIntClic()
		callback_int_clic_compteurs(nIntClicCount, nIntDoubleClicCount)
	FIN
FIN
