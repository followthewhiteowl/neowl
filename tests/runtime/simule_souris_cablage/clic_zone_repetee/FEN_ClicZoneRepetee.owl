// Ressource fenêtre — voisin de test_clic_zone_repetee.owl.
//  lot 2 : surClic / surDoubleClic sur un Champ ZoneRépétée.

FEN_ClicZoneRepetee est une Fenêtre
	PROPRIETES
		Titre       = "ClicZoneRepetee offscreen"
		Largeur     = 400
		Hauteur     = 250
		Disposition = dispLibre
	FIN

	nZrClicCount est un entier = 0
	nZrDoubleClicCount est un entier = 0

	ZR_Cible est un Champ ZoneRépétée
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 380
			Hauteur = 200
			Sens    = zrVertical
		FIN

		LIB_Item est un Champ Libellé
			PROPRIETES
				X       = 5
				Y       = 5
				Largeur = 200
				Libellé = "Item"
			FIN
		FIN

		PROCEDURE surClic()
			nZrClicCount += 1
		FIN

		PROCEDURE surDoubleClic()
			nZrDoubleClicCount += 1
		FIN
	FIN

	PROCEDURE FinInitialisation()
		r est un entier = ZoneRépétéeAjouteLigne(ZR_Cible)
		callback_zr_clic_prete()
	FIN

	PROCEDURE LireCompteursZrClic()
		callback_zr_clic_compteurs(nZrClicCount, nZrDoubleClicCount)
	FIN
FIN
