// Ressource fenêtre — voisin de test_clic_bouton.owl.
// surClic / surDoubleClic sur un Champ Bouton.

FEN_ClicBouton est une Fenêtre
	PROPRIETES
		Titre       = "ClicBouton offscreen"
		Largeur     = 300
		Hauteur     = 150
		Disposition = dispLibre
	FIN

	nBtnClicCount est un entier = 0
	nBtnDoubleClicCount est un entier = 0

	BTN_Cible est un Champ Bouton
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 200
			Hauteur = 40
			Libellé = "Cible"
		FIN

		PROCEDURE surClic()
			nBtnClicCount += 1
		FIN

		PROCEDURE surDoubleClic()
			nBtnDoubleClicCount += 1
		FIN
	FIN

	PROCEDURE FinInitialisation()
		callback_btn_clic_prete()
	FIN

	PROCEDURE LireCompteursBtnClic()
		callback_btn_clic_compteurs(nBtnClicCount, nBtnDoubleClicCount)
	FIN
FIN
