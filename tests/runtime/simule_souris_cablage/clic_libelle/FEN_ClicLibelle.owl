// Ressource fenêtre — voisin de test_clic_libelle.owl.
//  lot 2 : surClic / surDoubleClic sur un Champ Libellé.

FEN_ClicLibelle est une Fenêtre
	PROPRIETES
		Titre       = "ClicLibelle offscreen"
		Largeur     = 300
		Hauteur     = 150
		Disposition = dispLibre
	FIN

	nLibClicCount est un entier = 0
	nLibDoubleClicCount est un entier = 0

	LIB_Cible est un Champ Libellé
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 200
			Libellé = "Cible"
		FIN

		PROCEDURE surClic()
			nLibClicCount += 1
		FIN

		PROCEDURE surDoubleClic()
			nLibDoubleClicCount += 1
		FIN
	FIN

	PROCEDURE FinInitialisation()
		callback_lib_clic_prete()
	FIN

	PROCEDURE LireCompteursLibClic()
		callback_lib_clic_compteurs(nLibClicCount, nLibDoubleClicCount)
	FIN
FIN
