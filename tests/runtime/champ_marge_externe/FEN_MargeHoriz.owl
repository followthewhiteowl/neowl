// Fenêtre voisine — pile horizontale sans espacement. Aucun champ ne déclare
// de taille : la marge ne doit pas non plus être avalée par la taille
// naturelle, elle doit écarter le champ de ses voisins sans le grossir.
//
// Les trois libellés portent le même texte : leur largeur naturelle est donc
// la même, et toute différence de largeur trahirait une marge appliquée à
// l'intérieur.

FEN_MargeHoriz est une Fenêtre
	PROPRIETES
		Titre       = "Marges externes — pile horizontale"
		Largeur     = 400
		Hauteur     = 200
		Disposition = dispHorizontale
		Espacement  = 0
		Padding     = 0
		CouleurFond = RVB(5, 5, 5)
	FIN

	LIB_G est un Champ Libellé
		PROPRIETES
			Libellé = "abc"
		FIN
	FIN

	LIB_M est un Champ Libellé
		PROPRIETES
			Libellé     = "abc"
			MargeGauche = 12
			MargeDroite = 18
		FIN
	FIN

	LIB_D est un Champ Libellé
		PROPRIETES
			Libellé = "abc"
		FIN
	FIN
FIN
