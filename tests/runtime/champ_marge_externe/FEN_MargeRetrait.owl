// Fenêtre voisine — marge externe et retrait intérieur sur le même champ.
//
// Les deux réglages sont voisins de nom mais opposés de sens : le retrait
// pousse le texte vers l'intérieur du champ, la marge écarte le champ de ses
// voisins. Ils doivent coexister sans s'effacer l'un l'autre.
//
// LIB_RefRetrait et LIB_AvecMarge portent le même texte et les mêmes retraits :
// leur taille doit être identique. Seule leur position diffère.

FEN_MargeRetrait est une Fenêtre
	PROPRIETES
		Titre       = "Marge externe et retrait intérieur"
		Largeur     = 400
		Hauteur     = 200
		Disposition = dispVerticale
		Espacement  = 0
		Padding     = 0
		CouleurFond = RVB(5, 5, 5)
	FIN

	LIB_RefRetrait est un Champ Libellé
		PROPRIETES
			Libellé       = "retrait"
			RetraitGauche = 10
			RetraitHaut   = 4
		FIN
	FIN

	LIB_AvecMarge est un Champ Libellé
		PROPRIETES
			Libellé       = "retrait"
			RetraitGauche = 10
			RetraitHaut   = 4
			MargeGauche   = 30
		FIN
	FIN
FIN
