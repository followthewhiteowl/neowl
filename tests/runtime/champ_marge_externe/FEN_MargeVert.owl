// Fenêtre voisine — pile verticale sans espacement ni retrait de fenêtre :
// toute la géométrie observée vient donc des seules marges des champs.
//
// Géométrie attendue (X, Y relatifs à la zone client de la fenêtre) :
//   LIB_Haut   : 80 x 20 en (0,  0)     — aucune marge
//   LIB_Marge  : 80 x 20 en (30, 45)    — MargeGauche 30, MargeHaut 25
//   LIB_Bas    : 80 x 20 en (0,  70)    — poussé par la MargeBas 5 du voisin
//   LIB_Uni    : 80 x 20 en (7,  97)    — Marge groupée 7
//   LIB_Over   : 80 x 20 en (7,  144)   — Marge 7, MargeHaut 20 qui l'emporte
//   LIB_Fin    : 80 x 20 en (0,  171)   — poussé par la marge basse 7
//
// Tous les champs déclarent une taille : c'est le cas où la marge était
// entièrement avalée. La taille déclarée doit rester exactement 80 x 20.

FEN_MargeVert est une Fenêtre
	PROPRIETES
		Titre       = "Marges externes — pile verticale"
		Largeur     = 400
		Hauteur     = 300
		Disposition = dispVerticale
		Espacement  = 0
		Padding     = 0
		CouleurFond = RVB(5, 5, 5)
	FIN

	LIB_Haut est un Champ Libellé
		PROPRIETES
			Libellé = "haut"
			Largeur = 80
			Hauteur = 20
		FIN
	FIN

	LIB_Marge est un Champ Libellé
		PROPRIETES
			Libellé                            = "marge"
			Largeur                            = 80
			Hauteur                            = 20
			MargeGauche                        = 30
			MargeHaut                          = 25
			MargeBas                           = 5
			Style..CadreExtérieur..CouleurFond = RVB(0, 200, 0)
		FIN
	FIN

	LIB_Bas est un Champ Libellé
		PROPRIETES
			Libellé = "bas"
			Largeur = 80
			Hauteur = 20
		FIN
	FIN

	LIB_Uni est un Champ Libellé
		PROPRIETES
			Libellé = "uniforme"
			Largeur = 80
			Hauteur = 20
			Marge   = 7
		FIN
	FIN

	LIB_Over est un Champ Libellé
		PROPRIETES
			Libellé   = "override"
			Largeur   = 80
			Hauteur   = 20
			Marge     = 7
			MargeHaut = 20
		FIN
	FIN

	LIB_Fin est un Champ Libellé
		PROPRIETES
			Libellé = "fin"
			Largeur = 80
			Hauteur = 20
		FIN
	FIN
FIN
