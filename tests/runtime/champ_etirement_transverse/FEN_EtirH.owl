// Ressource — pile horizontale. L'axe principal est horizontal (la largeur),
// l'axe transverse est vertical (la hauteur). C'est donc `Alignement =
// alignÉtire` qui doit remplir la hauteur, et `Étire` qui doit absorber la
// largeur restante.
FEN_EtirH est une Fenêtre
	PROPRIETES
		Titre       = "Étirement — pile horizontale"
		Largeur     = 900
		Hauteur     = 300
		Disposition = dispHorizontale
	FIN

	ETH_Nature est un Champ Saisie
		PROPRIETES
			Visible = Vrai
		FIN
	FIN

	ETH_AlignEtire est un Champ Saisie
		PROPRIETES
			Alignement = alignÉtire
		FIN
	FIN

	// Jumeau à libellé intégré : la boîte du composite doit s'étirer comme
	// celle du champ nu.
	ETH_Compo est un Champ Saisie
		PROPRIETES
			Libellé        = "Nom :"
			LargeurLibellé = 80
			Alignement     = alignÉtire
		FIN
	FIN

	ETH_Etire est un Champ Saisie
		PROPRIETES
			Étire = Vrai
		FIN
	FIN
FIN
