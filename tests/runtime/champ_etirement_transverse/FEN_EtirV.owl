// Ressource — pile verticale. Les axes sont inversés : l'axe transverse est
// horizontal (la largeur). Le remplissage transverse y fonctionne déjà, cette
// fenêtre en verrouille la non-régression.
FEN_EtirV est une Fenêtre
	PROPRIETES
		Titre       = "Étirement — pile verticale"
		Largeur     = 400
		Hauteur     = 300
		Disposition = dispVerticale
	FIN

	ETV_Nature est un Champ Saisie
		PROPRIETES
			Visible = Vrai
		FIN
	FIN

	ETV_AlignEtire est un Champ Saisie
		PROPRIETES
			Alignement = alignÉtire
		FIN
	FIN

	ETV_Compo est un Champ Saisie
		PROPRIETES
			Libellé        = "Nom :"
			LargeurLibellé = 80
			Alignement     = alignÉtire
		FIN
	FIN
FIN
