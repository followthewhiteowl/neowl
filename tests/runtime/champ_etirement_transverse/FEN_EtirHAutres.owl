// Ressource — pile horizontale, mêmes axes que FEN_EtirH (transverse = hauteur),
// mais peuplée d'autres natures de champ que la Saisie. Le remplissage transverse
// ne dépend pas de l'orientation de la pile : il dépend de la nature du champ, et
// c'est cette lecture-là que la fenêtre verrouille.
//
// Chaque champ étiré est accompagné d'un témoin de même nature qui, lui, ne
// demande rien. Sans les témoins, une assertion « hauteur = 300 » ne dirait pas
// si la pile étire à la demande ou si elle étire tout le monde.
FEN_EtirHAutres est une Fenêtre
	PROPRIETES
		Titre       = "Étirement transverse — autres natures de champ"
		Largeur     = 900
		Hauteur     = 300
		Disposition = dispHorizontale
	FIN

	// Témoin conteneur : une Hauteur déclarée, aucune consigne d'étirement.
	// La hauteur déclarée est honorée, la pile ne distribue pas ses 300 px.
	ETA_ConteneurTemoin est un Champ Conteneur
		PROPRIETES
			Largeur = 100
			Hauteur = 40
		FIN
	FIN

	ETA_ConteneurEtire est un Champ Conteneur
		PROPRIETES
			Largeur    = 100
			Alignement = alignÉtire
		FIN
	FIN

	// Témoin libellé : sans consigne, un champ reste accroché au début de l'axe
	// transverse et garde sa hauteur naturelle.
	ETA_LibelleTemoin est un Champ Libellé
		PROPRIETES
			Libellé = "Témoin"
		FIN
	FIN

	ETA_LibelleEtire est un Champ Libellé
		PROPRIETES
			Libellé    = "Étiré"
			Alignement = alignÉtire
		FIN
	FIN
FIN
