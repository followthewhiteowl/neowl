// Couleur et CouleurFond coexistent sur une même cellule : écrire l'une ne
// doit jamais écraser l'autre, dans les deux ordres.

TestModeHeadless(Vrai)

Ouvre(FEN_TableCoexistence)

EcritCouleur(1, 1, 111)
dbgVérifieEgalité(LireCouleur(1, 1), 111, "Couleur posée seule")

EcritCouleurFond(1, 1, 222)
dbgVérifieEgalité(LireCouleur(1, 1), 111, "CouleurFond posée ensuite : Couleur inchangée")
dbgVérifieEgalité(LireCouleurFond(1, 1), 222, "CouleurFond posée ensuite : lue correctement")

EcritCouleur(1, 1, 333)
dbgVérifieEgalité(LireCouleur(1, 1), 333, "Couleur reposée : nouvelle valeur lue")
dbgVérifieEgalité(LireCouleurFond(1, 1), 222, "Couleur reposée : CouleurFond toujours inchangée")

Ferme(FEN_TableCoexistence)

dbgBilanTest()
