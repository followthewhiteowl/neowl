// Ressource fenêtre — voisine de test_table_cellule_mise_en_forme_coexistence.owl.
// Couleur et CouleurFond sont deux propriétés indépendantes d'une même
// cellule : écrire l'une ne doit jamais effacer l'autre.

FEN_TableCoexistence est une Fenêtre
	PROPRIETES
		Titre       = "Coexistence Couleur / CouleurFond"
		Disposition = dispVerticale
		Largeur     = 400
		Hauteur     = 300
	FIN

	TABLE_Coexist est un Champ Table
		PROPRIETES
			Étire = Vrai
		FIN

		COL_Nom est une Colonne
			PROPRIETES
				Libellé = "Nom"
				Type    = colTypeTexte
				Largeur = 100
			FIN
		FIN

		COL_Val est une Colonne
			PROPRIETES
				Libellé = "Val"
				Type    = colTypeNumerique
				Largeur = 100
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		TableAjouteLigne(TABLE_Coexist, "Alice", 10)
	FIN

	PROCEDURE EcritCouleur(ligne est un entier, col est un entier, v est un entier)
		TABLE_Coexist[ligne][col]..Couleur = v
	FIN

	PROCEDURE EcritCouleurFond(ligne est un entier, col est un entier, v est un entier)
		TABLE_Coexist[ligne][col]..CouleurFond = v
	FIN

	PROCEDURE LireCouleur(ligne est un entier, col est un entier)
		RENVOYER TABLE_Coexist[ligne][col]..Couleur
	FIN

	PROCEDURE LireCouleurFond(ligne est un entier, col est un entier)
		RENVOYER TABLE_Coexist[ligne][col]..CouleurFond
	FIN
FIN
