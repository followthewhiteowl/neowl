// Fenêtre voisine — ressource pour test_sans_handler.owl.
//
// Aucun handler AutorisationFermeture déclaré : témoin de non-régression
// du chemin de fermeture existant (owl_ui_window_on_close).

FEN_SansHandler est une Fenêtre
	PROPRIETES
		Titre       = "Sans handler d'autorisation"
		Disposition = dispLibre
		Largeur     = 300
		Hauteur     = 200
	FIN

	PROCEDURE Fermeture()
		callback_verifie("FER;")
	FIN
FIN
