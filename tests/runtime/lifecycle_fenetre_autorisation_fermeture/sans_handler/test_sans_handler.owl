//  — non-régression : une fenêtre SANS handler AutorisationFermeture
// se ferme comme avant (un seul Ferme() suffit, Fermeture tire normalement).
//
// VERT ATTENDU avant ET après l'impl : ce test verrouille le comportement
// préexistant du chemin owl_ui_window_on_close, il ne cible pas la feature
// nouvelle.

TestModeHeadless(Vrai)

seq est une chaîne = ""

PROCEDURE callback_verifie(s est une chaîne)
	seq += s
FIN

Ouvre(FEN_SansHandler)

Ferme(FEN_SansHandler)
dbgVérifieEgalité(seq, "FER;", "sans handler AutorisationFermeture, un seul Ferme() ferme et déclenche Fermeture")

dbgBilanTest()
