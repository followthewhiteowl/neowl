// Fenêtre voisine — ressource pour test_gui_parite_fermeture.owl.
//
// Aucun handler AutorisationFermeture : isole la parité GUI/headless sur
// Fermeture seule (chemin owl_ui_window_on_close / closeEvent Qt).

FEN_GuiFermeture est une Fenêtre
	PROPRIETES
		Titre       = "Parité GUI Fermeture"
		Disposition = dispLibre
		Largeur     = 300
		Hauteur     = 200
	FIN

	PROCEDURE Fermeture()
		callback_verifie("FER;")
	FIN
FIN
