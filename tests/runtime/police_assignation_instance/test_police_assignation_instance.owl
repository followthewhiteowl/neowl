// Assignation d'instance Police complete
// ROUGE attendu aujourd'hui : Police est encore VARIANT string.
// Apres impl : l'assignation d'une instance Police preparee applique tous les
// sous-champs au widget, visibles via les deux voies d'acces.
//
// Pattern : la fenêtre voisine FEN_X.owl porte la déclaration.

Ouvre(FEN_X)

// Preparer une instance Police complete
maPolice est un Police
maPolice..Nom      = "Courier New"
maPolice..Taille   = 12
maPolice..Gras     = Vrai
maPolice..Italique = Faux
maPolice..Souligné = Vrai
maPolice..Barré    = Faux
maPolice..Couleur  = BleuFoncé

// Assigner l'instance au widget
LIB_X..Police = maPolice

// Verifier visibilite via cascade
dbgVérifieEgalité(LIB_X..Police..Nom, "Courier New", "instance.Nom visible via cascade")
dbgVérifieEgalité(LIB_X..Police..Taille, 12, "instance.Taille visible via cascade")
dbgVérifieEgalité(LIB_X..Police..Gras, Vrai, "instance.Gras visible via cascade")
dbgVérifieEgalité(LIB_X..Police..Italique, Faux, "instance.Italique visible via cascade")
dbgVérifieEgalité(LIB_X..Police..Souligné, Vrai, "instance.Souligné visible via cascade")
dbgVérifieEgalité(LIB_X..Police..Barré, Faux, "instance.Barré visible via cascade")
dbgVérifieEgalité(LIB_X..Police..Couleur, BleuFoncé, "instance.Couleur visible via cascade")

// Verifier visibilite via raccourcis
dbgVérifieEgalité(LIB_X..PoliceNom, "Courier New", "instance.Nom visible via raccourci PoliceNom")
dbgVérifieEgalité(LIB_X..PoliceTaille, 12, "instance.Taille visible via raccourci PoliceTaille")
dbgVérifieEgalité(LIB_X..PoliceGras, Vrai, "instance.Gras visible via raccourci PoliceGras")
dbgVérifieEgalité(LIB_X..PoliceItalique, Faux, "instance.Italique visible via raccourci PoliceItalique")
dbgVérifieEgalité(LIB_X..PoliceSoulignée, Vrai, "instance.Souligné visible via raccourci PoliceSoulignée")
dbgVérifieEgalité(LIB_X..PoliceBarrée, Faux, "instance.Barré visible via raccourci PoliceBarrée")

Ferme(FEN_X)
dbgBilanTest()
