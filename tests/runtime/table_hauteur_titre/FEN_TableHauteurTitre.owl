// Fenêtre voisine — ressource pour test_table_hauteur_titre.owl.
// (pattern split canon strict — cf.  / .)
//
// Quatre Tables qui couvrent les quatre états de la hauteur d'en-tête :
//   TAB_Nu      : aucun libellé de colonne, HauteurTitre non déclarée
//                 -> bande d'en-tête naturelle (le cas qui coûtait un
//                    contournement : aucune façon de la retirer).
//   TAB_Masque  : aucun libellé, HauteurTitre = 0 -> en-tête masqué.
//   TAB_Fixe    : libellés présents, HauteurTitre = 40 -> hauteur imposée.
//   TAB_Ref     : libellés présents, HauteurTitre non déclarée -> témoin de
//                 non-régression, doit rester identique à TAB_Nu.

FEN_TableHauteurTitre est une Fenêtre
	PROPRIETES
		Titre       = "Hauteur d'en-tête d'un Champ Table"
		Disposition = dispLibre
	FIN

	TAB_Nu est un Champ Table
		PROPRIETES
			X            = 10
			Y            = 10
			Largeur      = 300
			Hauteur      = 300
			HauteurLigne = 20
		FIN

		COL_NuA est une Colonne
			PROPRIETES
				Libellé = ""
				Type    = colTypeTexte
				Largeur = 140
			FIN
		FIN

		COL_NuB est une Colonne
			PROPRIETES
				Libellé = ""
				Type    = colTypeTexte
				Largeur = 140
			FIN
		FIN
	FIN

	TAB_Masque est un Champ Table
		PROPRIETES
			X            = 320
			Y            = 10
			Largeur      = 300
			Hauteur      = 300
			HauteurLigne = 20
			HauteurTitre = 0
		FIN

		COL_MasqueA est une Colonne
			PROPRIETES
				Libellé = ""
				Type    = colTypeTexte
				Largeur = 140
			FIN
		FIN

		COL_MasqueB est une Colonne
			PROPRIETES
				Libellé = ""
				Type    = colTypeTexte
				Largeur = 140
			FIN
		FIN
	FIN

	TAB_Fixe est un Champ Table
		PROPRIETES
			X            = 630
			Y            = 10
			Largeur      = 300
			Hauteur      = 300
			HauteurLigne = 20
			HauteurTitre = 40
		FIN

		COL_FixeA est une Colonne
			PROPRIETES
				Libellé = "Référence"
				Type    = colTypeTexte
				Largeur = 140
			FIN
		FIN

		COL_FixeB est une Colonne
			PROPRIETES
				Libellé = "Stock"
				Type    = colTypeNumerique
				Largeur = 140
			FIN
		FIN
	FIN

	TAB_Ref est un Champ Table
		PROPRIETES
			X            = 940
			Y            = 10
			Largeur      = 300
			Hauteur      = 300
			HauteurLigne = 20
		FIN

		COL_RefA est une Colonne
			PROPRIETES
				Libellé = "Référence"
				Type    = colTypeTexte
				Largeur = 140
			FIN
		FIN

		COL_RefB est une Colonne
			PROPRIETES
				Libellé = "Stock"
				Type    = colTypeNumerique
				Largeur = 140
			FIN
		FIN
	FIN
FIN
