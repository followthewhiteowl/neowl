// Ressource DSL pour test_widget_bilingue_en.owl.
//
// Mini-fenetre 100% EN : verrouille le contrat « DSL widget bilingue ».
// - Copule EN sur sous-declarations de controle (Front A)
// - Prefixe Control EN (Front B)
// - Kinds EN : Label, Button, Input (Front D)
// - Proprietes EN : Caption, Width, Height, Color, Visible (Front C)
// - VALEURS d'enum EN : Layout = dispFree (Front E)
//
// Statut attendu AVANT impl Front E : ROUGE (la valeur EN dispFree est
// rejetee tant que la validation de valeur d'enum DSL n'est pas bilingue).
// Statut attendu APRES impl Front E : VERT (--check propre).

FEN_WidgetBilingueEN is a Window
	PROPERTIES
		Title  = "Widget EN Test"
		Width  = 400
		Height = 300
		Layout = dispFree
	END

	LBL_Greeting is a Control Label
		PROPERTIES
			Caption = "Hello, world."
			X       = 10
			Y       = 10
			Width   = 200
			Height  = 24
			Color   = 0x000000
			Visible = True
		END
	END

	BTN_OK is a Control Button
		PROPERTIES
			Caption = "OK"
			X       = 10
			Y       = 44
			Width   = 80
			Height  = 30
		END

		PROCEDURE onClick()
			Trace("BTN_OK clicked")
		END
	END

	SAI_Input is a Control Input
		PROPERTIES
			X      = 10
			Y      = 84
			Width  = 200
			Height = 30
		END
	END
END
