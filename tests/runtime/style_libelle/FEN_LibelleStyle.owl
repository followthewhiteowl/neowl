//  — fenêtre support pour le round-trip Style typé du Champ Libellé.
FEN_LibelleStyle est une Fenêtre
	PROPRIETES
		Titre       = "Libellé stylé"
		Largeur     = 400
		Hauteur     = 160
		Disposition = dispLibre
	FIN

	LIB_Style est un Champ Libellé
		PROPRIETES
			X       = 20
			Y       = 20
			Largeur = 300
			Hauteur = 40
			Libellé = "Texte"
		FIN
	FIN
FIN
