//  (ST-B) — défaut neutre STRICT de la nouvelle feuille `ImageFond` sur
// `Style..CadreExtérieur` : `ImageFond..Source` vide ne doit rien peindre. Un
// conteneur n'ayant jamais connu la prop (CNT_Reference) doit rendre
// IDENTIQUE à un conteneur qui la pose explicitement, mais vide
// (CNT_AvecImageVide). C'est la garantie « sans rien casser » du ticket.
//
// ROUGE attendu : `ImageFond` inconnu sur styleCadreExtérieur aujourd'hui —
// erreur sémantique au compile (le fichier ne se lance pas).
FEN_StyleImageFondDefautNonRegression est une Fenêtre
	PROPRIETES
		Titre       = "Style — image de fond, défaut neutre"
		Largeur     = 400
		Hauteur     = 160
		Disposition = dispLibre
		CouleurFond = RVB(10, 10, 10)
	FIN

	CNT_Reference est un Champ Conteneur
		PROPRIETES
			X                                  = 20
			Y                                  = 20
			Largeur                            = 150
			Hauteur                            = 100
			Disposition                        = dispLibre
			Style..CadreExtérieur..CouleurFond = RVB(80, 80, 80)
		FIN
	FIN

	CNT_AvecImageVide est un Champ Conteneur
		PROPRIETES
			X                                        = 200
			Y                                        = 20
			Largeur                                  = 150
			Hauteur                                  = 100
			Disposition                              = dispLibre
			Style..CadreExtérieur..CouleurFond       = RVB(80, 80, 80)
			Style..CadreExtérieur..ImageFond..Source = ""
		FIN
	FIN
FIN
