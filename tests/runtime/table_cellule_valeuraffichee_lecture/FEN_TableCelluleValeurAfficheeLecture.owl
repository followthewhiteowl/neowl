// Fenêtre voisine — ressource pour
// test_table_cellule_valeuraffichee_lecture.owl. Une colonne Date
// avec un masque d'affichage explicite : le rendu affiché
// diverge de la valeur brute stockée, le cas d'usage visé par ..ValeurAffichée.

FEN_TableCelluleValeurAfficheeLecture est une Fenêtre
	PROPRIETES
		Titre = "Cellule — lecture ValeurAffichée sur colonne formatée"
	FIN

	TABLE_Dates est un Champ Table
		PROPRIETES
		FIN

		COL_Date est une Colonne
			PROPRIETES
				Libellé         = "Date"
				Type            = colTypeDate
				Largeur         = 140
				MasqueAffichage = "AAAA-MM-JJ"
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		TableAjouteLigne(TABLE_Dates, "12/09/2026")
	FIN
FIN
