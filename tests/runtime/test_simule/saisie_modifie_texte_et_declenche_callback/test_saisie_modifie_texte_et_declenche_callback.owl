// TestSimuleSaisie ecrit dans Texte + declenche Modification.
TestModeHeadless(Vrai)

texteObs est une chaîne = ""
valeurModifObs est une chaîne = ""

PROCEDURE callback_texte(t est une chaîne, v est une chaîne)
	texteObs       = t
	valeurModifObs = v
FIN

Ouvre(FEN_Demo)

RemonteTexte()
dbgVérifieEgalité(texteObs, "", "Texte vide au depart")

TestSimuleSaisie(SAI_Nom, "Marc")
RemonteTexte()
dbgVérifieEgalité(texteObs, "Marc", "Texte ecrit dans Saisie")
dbgVérifieEgalité(valeurModifObs, "Marc", "callback Modification declenche avec nouvelle valeur")

Ferme(FEN_Demo)

dbgBilanTest()
