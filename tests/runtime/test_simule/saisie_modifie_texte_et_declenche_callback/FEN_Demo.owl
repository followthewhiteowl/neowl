// Fenêtre voisine — ressource pour
// test_saisie_modifie_texte_et_declenche_callback.owl.

FEN_Demo est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN

	valeurModif est une chaîne = ""

	SAI_Nom est un Champ Saisie
		PROPRIETES
			X = 10
			Y = 10
		FIN
		PROCEDURE surAChaqueModification()
			valeurModif = SAI_Nom..Valeur
		FIN
	FIN

	PROCEDURE RemonteTexte()
		callback_texte(SAI_Nom..Valeur, valeurModif)
	FIN
FIN
