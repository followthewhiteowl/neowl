// Fenêtre voisine — ressource pour test_bouton_droit_coords.owl.
// Variables fenêtre mutées par le callback surBoutonDroit + procédure
// RemonteEtat() qui appelle callback_etat pour transmettre au script.

FEN_Demo est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 200
	FIN

	xRecu est un entier = -1
	yRecu est un entier = -1
	declenche est un booléen = Faux

	IMG_Cible est un Champ Image
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 100
			Hauteur = 100
		FIN
		PROCEDURE surBoutonDroit(x est un entier, y est un entier)
			xRecu     = x
			yRecu     = y
			declenche = Vrai
		FIN
	FIN

	PROCEDURE RemonteEtat()
		callback_etat(declenche, xRecu, yRecu)
	FIN
FIN
