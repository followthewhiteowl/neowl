// TestSimuleSouris(IMG, BoutonDroit, x, y) declenche surBoutonDroit
// avec les coordonnees fournies.
// Pattern : FEN_Demo.owl voisin + callback_etat pour remontée au script.
TestModeHeadless(Vrai)

declencheObs est un booléen = Faux
xObs est un entier = -1
yObs est un entier = -1

PROCEDURE callback_etat(d est un booléen, x est un entier, y est un entier)
	declencheObs = d
	xObs         = x
	yObs         = y
FIN

Ouvre(FEN_Demo)

RemonteEtat()
dbgVérifieFaux(declencheObs, `non declenche au depart`)

TestSimuleSouris(IMG_Cible, BoutonDroit, 17, 99)
RemonteEtat()
dbgVérifieVrai(declencheObs, `surBoutonDroit declenche`)
dbgVérifieVrai(xObs = 17, `x recu = 17`)
dbgVérifieVrai(yObs = 99, `y recu = 99`)

Ferme(FEN_Demo)

dbgBilanTest()
