// Fenêtre voisine — ressource pour le test de référence qualifiée
// cross-fichier (FEN_Form.SAI_Nom).

FEN_Form est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN

	valeurModif est une chaîne = ""

	SAI_Nom est un Champ Saisie
		PROPRIETES
			X = 10
			Y = 10
		FIN
		PROCEDURE surAChaqueModification()
			valeurModif = SAI_Nom..Valeur
		FIN
	FIN
FIN
