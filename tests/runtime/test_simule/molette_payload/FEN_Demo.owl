// Fenêtre voisine — ressource pour test_molette_payload.owl.

FEN_Demo est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 200
	FIN

	mvtRecu est un entier = 0
	xRecu est un entier = -1
	yRecu est un entier = -1

	IMG_Cible est un Champ Image
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 100
			Hauteur = 100
		FIN
		PROCEDURE surMolette(mouvement est un entier, x est un entier, y est un entier)
			mvtRecu = mouvement
			xRecu   = x
			yRecu   = y
		FIN
	FIN

	PROCEDURE RemonteEtat()
		callback_etat(mvtRecu, xRecu, yRecu)
	FIN
FIN
