// TestSimuleSouris declenche le callback Clic.
// Pattern : la fenêtre voisine FEN_Demo.owl porte la déclaration et
// expose une procédure RemonteDrapeau() qui appelle callback_drapeau
// pour transmettre l'état muté par le callback Clic.
TestModeHeadless(Vrai)

drapeauObserve est un booléen = Faux

PROCEDURE callback_drapeau(b est un booléen)
	drapeauObserve = b
FIN

Ouvre(FEN_Demo)

RemonteDrapeau()
dbgVérifieFaux(drapeauObserve, `drapeau Faux au depart`)

TestSimuleSouris(BTN_OK, ClicGauche)
RemonteDrapeau()
dbgVérifieVrai(drapeauObserve, `callback Clic declenche par TestSimuleSouris`)

Ferme(FEN_Demo)

dbgBilanTest()
