// Fenêtre voisine — ressource pour test_clic_declenche_callback.owl.
// Variable globale fenêtre + procédure publique LireDrapeau() pour
// remonter l'état au script (le drapeau est muté par le callback Clic).

FEN_Demo est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN

	drapeau est un booléen = Faux

	BTN_OK est un Champ Bouton
		PROPRIETES
			X = 10
			Y = 10
		FIN
		PROCEDURE surClic()
			drapeau = Vrai
		FIN
	FIN

	PROCEDURE RemonteDrapeau()
		callback_drapeau(drapeau)
	FIN
FIN
