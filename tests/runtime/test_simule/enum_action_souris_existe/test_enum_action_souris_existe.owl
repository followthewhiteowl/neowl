// Verifie que l'enum ActionSouris est registry-side
TestModeHeadless(Vrai)

// On peut stocker dans une variable typee enum
act1 est un entier = ClicGauche
dbgVérifieVrai(act1 = ClicGauche, `ClicGauche assigne ET compare`)

act2 est un entier = DoubleClicDroit
dbgVérifieVrai(act2 = DoubleClicDroit, `DoubleClicDroit assigne ET compare`)

act3 est un entier = ClicDroit
dbgVérifieVrai(act3 = ClicDroit, `ClicDroit assigne ET compare`)

act4 est un entier = DoubleClicGauche
dbgVérifieVrai(act4 = DoubleClicGauche, `DoubleClicGauche assigne ET compare`)
