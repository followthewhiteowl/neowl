// TestSimuleSouris declenche le callback DoubleClic.
TestModeHeadless(Vrai)

drapeauObs est un booléen = Faux

PROCEDURE callback_drapeau(b est un booléen)
	drapeauObs = b
FIN

Ouvre(FEN_Demo)

RemonteDrapeau()
dbgVérifieFaux(drapeauObs, `drapeau Faux au depart`)

TestSimuleSouris(BTN_OK, DoubleClicGauche)
RemonteDrapeau()
dbgVérifieVrai(drapeauObs, `callback DoubleClic declenche`)

Ferme(FEN_Demo)

dbgBilanTest()
