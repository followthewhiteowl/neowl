// Fenêtre voisine — ressource pour test_double_clic_declenche_callback.owl.

FEN_Demo est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN

	drapeau est un booléen = Faux

	BTN_OK est un Champ Bouton
		PROPRIETES
			X = 10
			Y = 10
		FIN
		PROCEDURE surDoubleClic()
			drapeau = Vrai
		FIN
	FIN

	PROCEDURE RemonteDrapeau()
		callback_drapeau(drapeau)
	FIN
FIN
