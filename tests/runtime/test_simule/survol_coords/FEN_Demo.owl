// Fenêtre voisine — ressource pour test_survol_coords.owl.

FEN_Demo est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 200
	FIN

	xRecu est un entier = -1
	yRecu est un entier = -1
	compteur est un entier = 0

	IMG_Cible est un Champ Image
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 100
			Hauteur = 100
		FIN
		PROCEDURE surSurvol(x est un entier, y est un entier)
			xRecu    = x
			yRecu    = y
			compteur = compteur + 1
		FIN
	FIN

	PROCEDURE RemonteEtat()
		callback_etat(compteur, xRecu, yRecu)
	FIN
FIN
