// TestSimuleSouris(IMG, SurvolSouris, x, y) declenche surSurvol avec les
// coordonnees fournies.
TestModeHeadless(Vrai)

compteurObs est un entier = 0
xObs est un entier = -1
yObs est un entier = -1

PROCEDURE callback_etat(c est un entier, x est un entier, y est un entier)
	compteurObs = c
	xObs        = x
	yObs        = y
FIN

Ouvre(FEN_Demo)

TestSimuleSouris(IMG_Cible, SurvolSouris, 25, 50)
RemonteEtat()
dbgVérifieVrai(compteurObs = 1, `surSurvol declenche une fois`)
dbgVérifieVrai(xObs = 25, `x recu = 25`)
dbgVérifieVrai(yObs = 50, `y recu = 50`)

Ferme(FEN_Demo)

dbgBilanTest()
