// Fenêtre voisine avec un champ Saisie niché dans un Conteneur. Ressource
// pour le test de référence qualifiée vers un champ niché
// (FEN_Panneau.SAI_Cmd où SAI_Cmd vit dans BAR_Haut).

FEN_Panneau est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 300
		Hauteur     = 200
	FIN

	BAR_Haut est un Champ Conteneur
		PROPRIETES
			X           = 0
			Y           = 0
			Disposition = dispLibre
		FIN
		SAI_Cmd est un Champ Saisie
			PROPRIETES
				X = 10
				Y = 10
			FIN
		FIN
	FIN
FIN
