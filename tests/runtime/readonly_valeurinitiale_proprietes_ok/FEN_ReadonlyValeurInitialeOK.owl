// Fenêtre voisine — ressource compile-only pour
// test_readonly_valeurinitiale_proprietes_ok.owl.
// ValeurInitiale + ContenuInitial coexistent dans le bloc PROPRIETES (design)
// des Champs Combo et Liste : non-régression  (le mécanisme
// read-only-runtime ne doit pas gêner l'écriture design-init).
FEN_ReadonlyValeurInitialeOK est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
	FIN
	CMB_X est un Champ Combo
		PROPRIETES
			X              = 10
			Y              = 10
			Largeur        = 200
			Hauteur        = 25
			ContenuInitial = `A
B
C`
			ValeurInitiale = "B"
		FIN
	FIN
	LISTE_X est un Champ Liste
		PROPRIETES
			X              = 10
			Y              = 50
			Largeur        = 200
			Hauteur        = 100
			ContenuInitial = `A
B
C`
			ValeurInitiale = "B"
		FIN
	FIN
FIN
