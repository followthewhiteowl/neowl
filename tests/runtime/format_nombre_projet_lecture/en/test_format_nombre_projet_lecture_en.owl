//  — la forme EN `NumberFormat` du champ projet (littéral inline en
// props EN) est reconnue comme alias bilingue de `FormatNombre` : la valeur
// est lisible en cascade sous le nom canon FR `..FormatNombre..
// SéparateurMilliers`, une seule instance stockée.
//
// ROUGE attendu : ni `FormatNombre` ni `NumberFormat` n'existent au
// catalogue aujourd'hui -> échec de compilation du projet.owl voisin.

dbgVérifieEgalité(MonAppFormatNombreLectureEn..FormatNombre..SéparateurMilliers, " ", "NumberFormat (EN, littéral inline props EN) lu via ..FormatNombre..SéparateurMilliers (FR)")
dbgVérifieEgalité(MonAppFormatNombreLectureEn..FormatNombre..ChiffresAprèsVirgule, 2, "NumberFormat (EN) : ChiffresAprèsVirgule lu en cascade FR")

dbgBilanTest()
