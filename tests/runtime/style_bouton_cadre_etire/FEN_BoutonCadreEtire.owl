//  — combo minimal : un Champ Bouton avec Style..CadreExtérieur..Cadre
// visible + Alignement=alignÉtire, dans une fenêtre dispVerticale à côté
// d'autres widgets. Canon : Étire remplit l'axe TRANSVERSE (horizontal en
// dispVerticale), la taille figée de l'axe principal (Hauteur) est
// respectée. BTN_Temoin (même Style, sans Étire) sert de référence non
// étirée pour distinguer "pleine largeur par défaut Qt" de "étirement réel
// dû à Alignement=alignÉtire".
FEN_BoutonCadreEtire est une Fenêtre
	PROPRIETES
		Titre       = "Bouton CadreExtérieur étiré"
		Largeur     = 300
		Hauteur     = 240
		Disposition = dispVerticale
		CouleurFond = RVB(10, 10, 10)
	FIN

	LIB_Avant est un Champ Libellé
		PROPRIETES
			Largeur = 100
			Hauteur = 25
			Libellé = "Avant"
		FIN
	FIN

	BTN_Cadre est un Champ Bouton
		PROPRIETES
			Largeur                                 = 100
			Hauteur                                 = 30
			Libellé                                 = "Bouton"
			Alignement                              = alignÉtire
			Style..CadreExtérieur..CouleurFond      = RVB(0, 200, 0)
			Style..CadreExtérieur..Cadre..Couleur   = RVB(255, 128, 0)
			Style..CadreExtérieur..Cadre..Epaisseur = 5
		FIN
	FIN

	BTN_Temoin est un Champ Bouton
		PROPRIETES
			Largeur                                 = 100
			Hauteur                                 = 30
			Libellé                                 = "Témoin"
			Style..CadreExtérieur..CouleurFond      = RVB(0, 0, 200)
			Style..CadreExtérieur..Cadre..Couleur   = RVB(255, 0, 255)
			Style..CadreExtérieur..Cadre..Epaisseur = 5
		FIN
	FIN

	LIB_Apres est un Champ Libellé
		PROPRIETES
			Largeur = 100
			Hauteur = 25
			Libellé = "Apres"
		FIN
	FIN
FIN
