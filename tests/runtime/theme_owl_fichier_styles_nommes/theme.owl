//  lot 1 : theme.owl (nom réservé) = fichier déclarant des styles
// typés NOMMÉS, pattern identique à `STY_X est un styleBouton` déjà
// fonctionnel (/). Le catalogue nommé du thème ne
// renseigne QUE ce qu'il override — les autres sous-éléments restent aux
// défauts du template styleXxx (résilience à l'évolution du modèle, cf.
// ticket "Vision future").

// boutonPrimaire : override partiel — seul CadreExtérieur..CouleurFond est
// posé, tout le reste (Libellé, Cadre..Epaisseur, Retraits...) reste au défaut.
boutonPrimaire est un styleBouton
boutonPrimaire..CadreExtérieur..CouleurFond = Bleu

// saisieCompacte : override partiel sur un autre type de style, sous-élément
// différent (ZoneSaisie), pour prouver la généralité du pattern.
saisieCompacte est un styleSaisie
saisieCompacte..ZoneSaisie..RetraitGauche = 2
