//  — `Style..TexteOptions..CouleurFond` (fond du texte des options)
// doit se retrouver dans la feuille QSS appliquée au QRadioButton, exactement
// comme `Style..TexteOptions..Couleur` (couleur du texte). Vérification
// structurelle via __DebugFeuilleStyle, même patron que
// style_interrupteur_texteoptions_couleurfond.
//
// ROUGE attendu : `Style..TexteOptions..*` ne compile pas encore sur le
// Champ Sélecteur (le type styleSélecteur n'existe pas) — les DEUX
// assertions Couleur/CouleurFond rougissent (contrairement au pendant
// Interrupteur où Couleur passait déjà : ici rien n'est câblé côté
// Sélecteur, aucune voie partielle n'existe encore).

TestModeHeadless(Faux)

OuvreSoeur(FEN_StyleSelecteurTexteOptionsCouleurFond)

feuille est une chaîne = __DebugFeuilleStyle(SEL_TexteFond)

dbgVérifieVrai(Contient(feuille, "QRadioButton"), "Style..TexteOptions : la feuille QSS cible bien QRadioButton")

dbgVérifieVrai(Contient(feuille, "255, 0, 0") OU Contient(feuille, "#ff0000"), "Style..TexteOptions..Couleur : couleur du texte des options présente dans la feuille")

dbgVérifieVrai(Contient(feuille, "0, 200, 0") OU Contient(feuille, "#00c800"), "Style..TexteOptions..CouleurFond : fond du texte des options présent dans la feuille")

Ferme(FEN_StyleSelecteurTexteOptionsCouleurFond)
dbgBilanTest()
