// Fenêtre voisine — ressource pour test_parite_headless_fininit_fermeture.owl.
//
// Témoin parité headless : FinInitialisation + Fermeture doivent se déclencher
// en headless (comme en GUI). Remontée au script via callback_verifie au
// FinInitialisation (la lecture après Fermeture n'est pas possible — fenêtre détruite).

FEN_Test_Parite_HL est une Fenêtre
	PROPRIETES
		Titre       = "Témoin parité headless"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 300
	FIN

	// Variable globale fenêtre (portée FEN_Test_Parite_HL — visible dans ses champs/events/procédures)
	marqueurEvents est une chaîne = ""

	PROCEDURE FinInitialisation()
		// Accès à la variable globale fenêtre (portée parent) : nom nu, pas FEN..
		marqueurEvents += "FININIT,"
		callback_verifie(marqueurEvents)
	FIN

	PROCEDURE Fermeture()
		// Accès à la variable globale fenêtre (portée parent) : nom nu, pas FEN..
		marqueurEvents += "FERMETURE"
	FIN
FIN
