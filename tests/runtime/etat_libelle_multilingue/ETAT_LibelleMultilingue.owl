// Etat voisin — ressource pour test_etat_libelle_multilingue.owl.
// Un littéral colon-brace multilingue en bloc PROPRIETES d'un widget dans
// le corps d'un Etat doit résoudre sa cible comme en Fenêtre (cf. mirror
// tests/scenarios/ui/langue_hotswitch/FEN_HotSwitchLangue.owl, déjà vert).

ETAT_LibelleMultilingue est un Etat
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	corps est un Corps
		PROPRIETES
			Hauteur = 40
		FIN

		LIB_Titre est un Champ Libellé
			PROPRIETES
				Libellé = {langueFrançais: "Bonjour", langueAnglais: "Hello"}
			FIN
		FIN

		callback_observe("libelle:" + LIB_Titre..Libellé)
	FIN
FIN
