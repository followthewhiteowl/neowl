// Ressource Etat voisine de test_expr_libelle_variant_ligne.owl.
//
// Le Libellé est une EXPRESSION dans PROPRIETES (Libellé = sVal), pas une
// affectation impérative ..Libellé =. sVal change entre chaque rendu du
// bloc Corps (2 rendus manuels via iImprimeBloc + le rendu automatique
// final) : "A", "AA", "AAA". Chaque ligne doit afficher la valeur courante
// de l'expression, pas la valeur résolue au 1er rendu.

ETAT_ExprLibelleVariantLigne est un État
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	sVal est une chaîne = "A"

	corps est un Corps
		PROPRIETES
			Hauteur = 10
		FIN

		LIB_X est un Champ Libellé
			PROPRIETES
				Libellé      = sVal
				X            = 20
				Y            = 2
				Largeur      = 100
				Hauteur      = 6
				PoliceNom    = iPoliceLiberationSans
				PoliceTaille = 9
			FIN
		FIN
	FIN

	PROCEDURE Lecture()
		sVal = "A"
		iImprimeBloc("Corps")
		sVal = "AA"
		iImprimeBloc("Corps")
		sVal = "AAA"
	FIN
FIN
