Trace("=== REGEX ARITY (formes valides RegexRemplace 3/4 args) ===")

// Forme à 3 arguments : remplacement global simple.
dbgVérifieEgalité(RegexRemplace("hello world", "world", "OWL"),
"hello OWL", "remplace 3 args")

// Forme à 4 arguments : drapeau 'i' (insensible à la casse).
dbgVérifieEgalité(RegexRemplace("HELLO world", "hello", "bye", "i"),
"bye world", "remplace 4 args, flag i")

// Remplacement sans correspondance : chaîne inchangée.
dbgVérifieEgalité(RegexRemplace("abc", "xyz", "ZZZ"),
"abc", "remplace 3 args, pas de match")

Trace("=== REGEX ARITY OK ===")
