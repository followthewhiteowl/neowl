// Fenêtre voisine — deux champs Saisie : SAI_Num (typSaisieNum, format
// hérité du projet) et SAI_Autre (cible de DonneFocus pour déclencher un
// focus-out réel sur SAI_Num).

FEN_ReformatNumFrappeBlur est une Fenêtre
	PROPRIETES
		Titre       = "Reformat num frappe+blur"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 160
	FIN

	SAI_Num est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 10
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieNum
			Valeur     = ""
		FIN
	FIN

	SAI_Autre est un Champ Saisie
		PROPRIETES
			X       = 10
			Y       = 50
			Largeur = 180
			Hauteur = 24
			Valeur  = ""
		FIN
	FIN
FIN
