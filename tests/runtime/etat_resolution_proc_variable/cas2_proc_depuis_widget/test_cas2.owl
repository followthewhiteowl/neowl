//  cas 2 — PROCEDURE top-level d Etat appelee depuis un widget.
// ROUGE ATTENDU : le runtime ne resout pas les procs top-level d Etat
// depuis le code top-level d un widget de section.
// La ressource ETAT_Cas2 vit dans le voisin ETAT_Cas2.owl.

TestModeHeadless(Vrai)

seqCas2 est une chaîne = ""

PROCEDURE callback_observe(s est une chaîne)
	seqCas2 += s
FIN

iDestination(iPDFGénérique, "tests/runtime/etat_resolution_proc_variable/cas2_proc_depuis_widget/temp.pdf")
iImprimeEtat(ETAT_Cas2)
iFinImprime()

Trace("seqCas2 : [" + seqCas2 + "]")

// Apres fix : Double(7) = 14.
dbgVérifieEgalité(seqCas2, "c2:14",
"Proc top-level Etat appelee depuis widget de section : resultat correct")

dbgBilanTest()
