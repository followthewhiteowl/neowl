// Ressource Etat pure —  cas 2.
// Verifie qu une PROCEDURE top-level d Etat est appelable depuis
// le top-level d un widget (Champ Libelle) dans une section.
// Actuellement rouge : l appel echoue avec
// "Seules les fonctions et procedures peuvent etre appelees."
// Apres fix : Double(7) doit donner 14.
// Observation via callback_observe() (resolu par voisinage mode script).

ETAT_Cas2 est un Etat
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	// PROCEDURE top-level de l Etat : le sujet du test.
	PROCEDURE Double(n est un entier)
		RENVOYER n * 2
	FIN

	corps est un Corps
		PROPRIETES
			Hauteur = 50
		FIN

		LIB_Widget est un Champ Libellé
			PROPRIETES
				Libellé      = "Widget test"
				X            = 10
				Y            = 10
				Largeur      = 100
				Hauteur      = 15
				PoliceNom    = iPoliceLiberationSans
				PoliceTaille = 11
			FIN

			// Appel de la proc top-level de l Etat depuis le top-level du widget.
			res est un entier = Double(7)
			callback_observe("c2:" + res)
		FIN
	FIN
FIN
