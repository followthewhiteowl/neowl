// Fenêtre voisine pour test_arbre_icone_rendu_gui.
// Mode GUI réel (OuvreSoeur depuis le script test).
//
// Peuple l'arbre à l'initialisation avec :
//   - un nœud à fils ("Documents") -> icône dossier par défaut attendue
//   - une feuille de ce nœud ("Documents" TAB "Rapport") -> aucune icône
//   - un nœud avec images Null, Null ("Vide") -> aucune icône
//   - un nœud avec images de catalogue personnalisées ("Spécial") -> icône présente

FEN_ArbreIconeGui est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 300
		Hauteur     = 300
		Titre       = "Icônes de nœud"
	FIN

	ARBRE_IconeGui est un Champ Arbre
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 260
			Hauteur = 260
		FIN
	FIN

	PROCEDURE FinInitialisation()
		ArbreAjoute(ARBRE_IconeGui, "Documents" + TAB + "Rapport")
		ArbreAjoute(ARBRE_IconeGui, "Vide", Null, Null)
		ArbreAjoute(ARBRE_IconeGui, "Spécial", "icones.star", "icones.star")
	FIN

FIN
