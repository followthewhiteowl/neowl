// Fenêtre voisine — widgets Jauge montés (offscreen) pour
// test_champ_jauge_runtime.owl. Trois variantes : horizontale, verticale,
// symétrique, toutes avec des bornes explicites pour exercer le bornage.

FEN_JaugeRuntime est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 260
	FIN

	// Horizontale — bornes [0, 100].
	JAU_H est un Champ Jauge
		PROPRIETES
			X        = 10
			Y        = 10
			Largeur  = 300
			Hauteur  = 24
			BorneMin = 0
			BorneMax = 100
			Valeur   = 40
		FIN
	FIN

	// Verticale — bornes [0, 10].
	JAU_V est un Champ Jauge
		PROPRIETES
			X        = 340
			Y        = 10
			Largeur  = 24
			Hauteur  = 200
			Vertical = Vrai
			BorneMin = 0
			BorneMax = 10
			Valeur   = 3
		FIN
	FIN

	// Symétrique — bornes [-50, 50], progression depuis le centre.
	JAU_Sym est un Champ Jauge
		PROPRIETES
			X          = 10
			Y          = 60
			Largeur    = 300
			Hauteur    = 24
			Symétrique = Vrai
			BorneMin   = -50
			BorneMax   = 50
			Valeur     = 0
		FIN
	FIN
FIN
