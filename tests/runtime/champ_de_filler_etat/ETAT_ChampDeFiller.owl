// État voisin — ressource pour test_champ_de_filler_etat.owl.
//
// Valide que le filler optionnel `de` entre `Champ` et le genre est
// accepté dans un bloc Corps d'État.

ETAT_ChampDeFiller est un État
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	Corps est un Corps
		PROPRIETES
			Hauteur = 80
		FIN

		LBL_AvecDe est un Champ de Libellé
			PROPRIETES
				X       = 10
				Y       = 10
				Largeur = 180
				Hauteur = 10
				Libellé = "Avec de"
			FIN
		FIN

		LBL_SansDe est un Champ Libellé
			PROPRIETES
				X       = 10
				Y       = 30
				Largeur = 180
				Hauteur = 10
				Libellé = "Sans de"
			FIN
		FIN
	FIN
FIN
