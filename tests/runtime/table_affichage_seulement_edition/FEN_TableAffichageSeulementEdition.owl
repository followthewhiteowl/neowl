// Fenêtre voisine — ressource pour test_table_affichage_seulement_edition.owl.
//
// Quatre Champ Table pour verrouiller le blocage RÉEL de l'édition texte au
// double-clic (bug ) :
//   - TAB_Normal        : défaut (aucune colonne/table en AffichageSeulement),
//                         documente que l'édition reste possible par défaut.
//   - TAB_ColRO         : COL_B en Etat = AffichageSeulement (colonne seule).
//   - TAB_Runtime       : défaut à la construction, basculé au runtime par le
//                         script test (..Etat = AffichageSeulement puis Actif).
//   - TAB_ConstructionRO: Etat = AffichageSeulement déclaré en PROPRIETES dès
//                         la construction (variante optionnelle du cas 3).
//
// Rig GUI réel obligatoire (TestModeHeadless(Faux)) : l'éditabilité Qt
// (ItemIsEditable + edit-triggers de la vue) n'existe que sur un widget
// matérialisé.

FEN_TableAffichageSeulementEdition est une Fenêtre
	PROPRIETES
		Titre       = "Affichage seulement — édition Table"
		Disposition = dispLibre
		Largeur     = 900
		Hauteur     = 320
	FIN

	TAB_Normal est un Champ Table
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 200
			Hauteur = 140
		FIN

		COL_A est une Colonne
			PROPRIETES
				Libellé = "A"
				Largeur = 90
			FIN
		FIN

		COL_B est une Colonne
			PROPRIETES
				Libellé = "B"
				Largeur = 90
			FIN
		FIN
	FIN

	TAB_ColRO est un Champ Table
		PROPRIETES
			X       = 230
			Y       = 10
			Largeur = 200
			Hauteur = 140
		FIN

		COL_A est une Colonne
			PROPRIETES
				Libellé = "A"
				Largeur = 90
			FIN
		FIN

		COL_B est une Colonne
			PROPRIETES
				Libellé = "B"
				Largeur = 90
				Etat    = AffichageSeulement
			FIN
		FIN
	FIN

	TAB_Runtime est un Champ Table
		PROPRIETES
			X       = 450
			Y       = 10
			Largeur = 200
			Hauteur = 140
		FIN

		COL_A est une Colonne
			PROPRIETES
				Libellé = "A"
				Largeur = 90
			FIN
		FIN

		COL_B est une Colonne
			PROPRIETES
				Libellé = "B"
				Largeur = 90
			FIN
		FIN
	FIN

	TAB_ConstructionRO est un Champ Table
		PROPRIETES
			X       = 670
			Y       = 10
			Largeur = 200
			Hauteur = 140
			Etat    = AffichageSeulement
		FIN

		COL_A est une Colonne
			PROPRIETES
				Libellé = "A"
				Largeur = 90
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		TableAjouteLigne(TAB_Normal, "Alpha", "Un")
		TableAjouteLigne(TAB_Normal, "Bravo", "Deux")

		TableAjouteLigne(TAB_ColRO, "Alpha", "Un")
		TableAjouteLigne(TAB_ColRO, "Bravo", "Deux")

		TableAjouteLigne(TAB_Runtime, "Alpha", "Un")
		TableAjouteLigne(TAB_Runtime, "Bravo", "Deux")

		TableAjouteLigne(TAB_ConstructionRO, "Alpha")
		TableAjouteLigne(TAB_ConstructionRO, "Bravo")
	FIN
FIN
