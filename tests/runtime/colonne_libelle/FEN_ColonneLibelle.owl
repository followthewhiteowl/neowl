// Fenêtre voisine — ressource pour test_colonne_libelle.owl.

FEN_ColonneLibelle est une Fenêtre
	PROPRIETES
		Titre       = "Test Colonne Libelle multilingue"
		Largeur     = 600
		Hauteur     = 400
		Disposition = dispLibre
	FIN

	TAB_Clients est un Champ Table
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 550
			Hauteur = 350
		FIN

		// Backward-compat : chaine simple acceptee (coerce auto au runtime)
		COL_Nom est une Colonne
			PROPRIETES
				Libellé = "Nom"
				Type    = colTypeTexte
				Largeur = 150
			FIN
		FIN

		COL_Prenom est une Colonne
			PROPRIETES
				Libellé = "Prénom"
				Type    = colTypeTexte
				Largeur = 150
			FIN
		FIN

		COL_Email est une Colonne
			PROPRIETES
				Libellé = "Email"
				Type    = colTypeTexte
				Largeur = 200
			FIN
		FIN
	FIN
FIN
