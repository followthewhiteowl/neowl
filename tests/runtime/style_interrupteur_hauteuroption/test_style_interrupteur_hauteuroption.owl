//  — prop `HauteurOption` (INT, px ; 0 = auto) sur le Champ
// Interrupteur : hauteur de chaque ligne d'option. Calque le patron d'une
// prop INT existante de l'Interrupteur (NombreColonne, cf.
// tests/regression/champ_interrupteur_v1) : posee en PROPRIETES,
// relue sur l'instance.
//
// ROUGE attendu : `HauteurOption` n'existe pas encore dans le catalogue de
// props du Champ Interrupteur (PROPS_INTERRUPTEUR_FIELD, src/ui_catalog.c)
// -- compile-fail (propriete inconnue) sur INT_Fixe..HauteurOption = 40.

Ouvre(FEN_StyleInterrupteurHauteurOption)

dbgVérifieEgalité(INT_Fixe..HauteurOption, 40, "HauteurOption : posee en PROPRIETES, relue sur l'instance")

// Defaut : 0 = auto/dynamique (pas de hauteur fixe imposee).
dbgVérifieEgalité(INT_Auto..HauteurOption, 0, "HauteurOption : defaut 0 (auto) quand non renseignee")

INT_Auto..HauteurOption = 0
dbgVérifieEgalité(INT_Auto..HauteurOption, 0, "HauteurOption = 0 explicite : round-trip auto")

Ferme(FEN_StyleInterrupteurHauteurOption)
dbgBilanTest()
