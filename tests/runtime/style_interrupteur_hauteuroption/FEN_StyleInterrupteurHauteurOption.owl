//  — prop `HauteurOption` (INT, px ; 0 = hauteur naturelle/auto) sur
// le Champ Interrupteur : hauteur de chaque ligne d'option.
FEN_StyleInterrupteurHauteurOption est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
	FIN

	INT_Fixe est un Champ Interrupteur
		PROPRIETES
			X             = 10
			Y             = 10
			Largeur       = 240
			Hauteur       = 150
			Options       = ["Un", "Deux", "Trois"]
			HauteurOption = 40
		FIN
	FIN

	INT_Auto est un Champ Interrupteur
		PROPRIETES
			X       = 260
			Y       = 10
			Largeur = 240
			Hauteur = 150
			Options = ["Un", "Deux"]
		FIN
	FIN
FIN
