// Fenêtre voisine — trois Champs Jauge horizontale pour
// test_style_jauge_element_libelle_pixel.owl :
//   - JAU_Couleur  : Style..Libellé..Couleur distinctive, pour vérifier que
//     le texte % est peint dans cette couleur.
//   - JAU_Petit / JAU_Grand : même couleur de texte, seule
//     Style..Libellé..Police..Taille diffère (8 vs 32), pour vérifier que la
//     taille de police influe sur le rendu (plus de pixels d'encre).
// BorneMin/BorneMax [0,100], Valeur 50 : le texte "50%" reste centré dans le
// widget quel que soit le remplissage.
FEN_StyleJaugeElementsLibelle est une Fenêtre
	PROPRIETES
		Titre       = "Style Jauge — éléments (libellé)"
		Largeur     = 360
		Hauteur     = 240
		Disposition = dispLibre
		CouleurFond = RVB(10, 10, 10)
	FIN

	JAU_Couleur est un Champ Jauge
		PROPRIETES
			X                                  = 20
			Y                                  = 20
			Largeur                            = 300
			Hauteur                            = 40
			BorneMin                           = 0
			BorneMax                           = 100
			Valeur                             = 50
			Style..CadreExtérieur..CouleurFond = RVB(30, 30, 30)
			Style..Remplissage..CouleurFond    = RVB(60, 60, 60)
			Style..Libellé..Couleur            = RVB(255, 255, 0)
			Style..Libellé..Police..Taille     = 20
		FIN
	FIN

	JAU_Petit est un Champ Jauge
		PROPRIETES
			X                                  = 20
			Y                                  = 90
			Largeur                            = 300
			Hauteur                            = 40
			BorneMin                           = 0
			BorneMax                           = 100
			Valeur                             = 50
			Style..CadreExtérieur..CouleurFond = RVB(30, 30, 30)
			Style..Remplissage..CouleurFond    = RVB(60, 60, 60)
			Style..Libellé..Couleur            = RVB(0, 255, 255)
			Style..Libellé..Police..Taille     = 8
		FIN
	FIN

	JAU_Grand est un Champ Jauge
		PROPRIETES
			X                                  = 20
			Y                                  = 160
			Largeur                            = 300
			Hauteur                            = 60
			BorneMin                           = 0
			BorneMax                           = 100
			Valeur                             = 50
			Style..CadreExtérieur..CouleurFond = RVB(30, 30, 30)
			Style..Remplissage..CouleurFond    = RVB(60, 60, 60)
			Style..Libellé..Couleur            = RVB(0, 255, 255)
			Style..Libellé..Police..Taille     = 32
		FIN
	FIN
FIN
