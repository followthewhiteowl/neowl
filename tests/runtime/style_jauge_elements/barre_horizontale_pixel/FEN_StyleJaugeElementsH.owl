// Fenêtre voisine — Champ Jauge horizontale avec Style..Remplissage
// et Style..CadreExtérieur (piste) posés, pour test_style_jauge_elements_
// barre_horizontale_pixel.owl. BorneMin/BorneMax [0,100], Valeur 60 : la
// portion remplie occupe la gauche, la piste la droite.
FEN_StyleJaugeElementsH est une Fenêtre
	PROPRIETES
		Titre       = "Style Jauge — éléments (horizontale)"
		Largeur     = 360
		Hauteur     = 100
		Disposition = dispLibre
		CouleurFond = RVB(10, 10, 10)
	FIN

	JAU_H est un Champ Jauge
		PROPRIETES
			X                                  = 20
			Y                                  = 20
			Largeur                            = 300
			Hauteur                            = 30
			BorneMin                           = 0
			BorneMax                           = 100
			Valeur                             = 60
			Style..CadreExtérieur..CouleurFond = RVB(200, 200, 200)
			Style..Remplissage..CouleurFond    = RVB(220, 0, 0)
		FIN
	FIN
FIN
