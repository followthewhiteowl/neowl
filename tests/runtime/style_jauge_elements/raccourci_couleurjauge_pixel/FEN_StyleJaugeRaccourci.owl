// Fenêtre voisine — deux Jauges identiques (mêmes bornes/valeur), l'une
// stylée via `..CouleurJauge` (raccourci à plat, existant), l'autre via
// `Style..Remplissage..CouleurFond` (nouveau chemin styleJauge), même couleur.
// Sert à prouver que le raccourci et le style produisent le même
// remplissage — non-cassant (cf. design verrouillé ).
FEN_StyleJaugeRaccourci est une Fenêtre
	PROPRIETES
		Titre       = "Style Jauge — raccourci vs style"
		Largeur     = 360
		Hauteur     = 160
		Disposition = dispLibre
		CouleurFond = RVB(10, 10, 10)
	FIN

	JAU_Raccourci est un Champ Jauge
		PROPRIETES
			X            = 20
			Y            = 20
			Largeur      = 300
			Hauteur      = 30
			BorneMin     = 0
			BorneMax     = 100
			Valeur       = 60
			CouleurJauge = RVB(0, 0, 220)
		FIN
	FIN

	JAU_Style est un Champ Jauge
		PROPRIETES
			X                               = 20
			Y                               = 80
			Largeur                         = 300
			Hauteur                         = 30
			BorneMin                        = 0
			BorneMax                        = 100
			Valeur                          = 60
			Style..Remplissage..CouleurFond = RVB(0, 0, 220)
		FIN
	FIN
FIN
