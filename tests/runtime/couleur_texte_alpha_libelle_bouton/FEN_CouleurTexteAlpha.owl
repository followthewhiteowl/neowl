//  — cible : couleur de TEXTE (fg) posée en instance Couleur avec
// Opacité<255 sur Libellé et Bouton. Fond de chaque champ fixé en rouge pur
// opaque (RVB(255,0,0)) pour que le mélange source-over soit mesurable au
// pixel dans le coeur des glyphes.
//
// LIB_Opaque : témoin non-régression, texte VERT PUR (0,255,0) sans Opacité.
// LIB_Alpha  : le bug — texte VERT (0,255,0), Opacité=128.
// BTN_Alpha  : même bug sur un Bouton (cas exact ticket).
FEN_CouleurTexteAlpha est une Fenêtre
	PROPRIETES
		Titre       = "Couleur texte alpha"
		Largeur     = 500
		Hauteur     = 420
		Disposition = dispLibre
		CouleurFond = RVB(255, 0, 0)
	FIN

	LIB_Opaque est un Champ Libellé
		PROPRIETES
			X                       = 20
			Y                       = 20
			Largeur                 = 460
			Hauteur                 = 100
			Libellé                 = "WWWW"
			PoliceTaille            = 48
			PoliceGras              = Vrai
			CouleurFond             = RVB(255, 0, 0)
			Style..Libellé..Couleur = RVB(0, 255, 0)
		FIN
	FIN

	LIB_Alpha est un Champ Libellé
		PROPRIETES
			X                       = 20
			Y                       = 140
			Largeur                 = 460
			Hauteur                 = 100
			Libellé                 = "WWWW"
			PoliceTaille            = 48
			PoliceGras              = Vrai
			CouleurFond             = RVB(255, 0, 0)
			Style..Libellé..Couleur = {Rouge = 0, Vert = 255, Bleu = 0, Opacité = 128}
		FIN
	FIN

	BTN_Alpha est un Champ Bouton
		PROPRIETES
			X                       = 20
			Y                       = 260
			Largeur                 = 460
			Hauteur                 = 100
			Libellé                 = "WWWW"
			PoliceTaille            = 48
			PoliceGras              = Vrai
			CouleurFond             = RVB(255, 0, 0)
			Style..Libellé..Couleur = {Rouge = 0, Vert = 255, Bleu = 0, Opacité = 128}
		FIN
	FIN
FIN
