// Fenetre voisine pour test_bouton_icone_statique.
// Quatre champs sur fond de fenetre sombre :
//   BTN_AvecMono    : Bouton avec Image = icones.add (mono, ui)
//   BTN_SansMono    : Bouton sans Image (reference nue)
//   BTN_AvecCouleur : Bouton avec Image = icones.github_icon (couleur, marques)
//   IMG_Guard       : Champ Image avec Image = icones.add (chemin garde)
//
// Methode oracle : comparer les captures BTN_AvecMono vs BTN_SansMono
// pixel par pixel. Si l'icone est rendue, les images different. Si la
// regression  est active, les deux sont identiques (diff = 0).
// Meme logique pour BTN_AvecCouleur vs BTN_SansMono.
// IMG_Guard doit produire une capture avec pixels non-fond (deja vert).

FEN_BoutonIcone est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 500
		Hauteur     = 200
		Titre       = "Bouton icone statique"
		CouleurFond = RVB(15, 15, 15)
	FIN

	BTN_AvecMono est un Champ Bouton
		PROPRIETES
			X       = 10
			Y       = 50
			Largeur = 96
			Hauteur = 96
			Image   = icones.add
		FIN
	FIN

	BTN_SansMono est un Champ Bouton
		PROPRIETES
			X       = 120
			Y       = 50
			Largeur = 96
			Hauteur = 96
		FIN
	FIN

	BTN_AvecCouleur est un Champ Bouton
		PROPRIETES
			X       = 230
			Y       = 50
			Largeur = 96
			Hauteur = 96
			Image   = icones.github_icon
		FIN
	FIN

	IMG_Guard est un Champ Image
		PROPRIETES
			X           = 380
			Y           = 50
			Largeur     = 96
			Hauteur     = 96
			Image       = icones.add
			CouleurFond = RVB(15, 15, 15)
		FIN
	FIN

FIN
