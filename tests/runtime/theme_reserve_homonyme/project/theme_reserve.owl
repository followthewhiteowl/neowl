// Ambiance de réserve : même nom de style que l'ambiance active, valeurs
// différentes. Aucune de ses valeurs ne doit atteindre le namespace.
ThèmeRéserveHomonyme est un Thème
	boutonCommun est un styleBouton = {
		CadreExtérieur = { CouleurFond = RVB(200, 210, 220) }
	}
	saisieRéserve est un styleSaisie = {
		ZoneSaisie = { CouleurFond = RVB(230, 240, 250) }
	}
FIN
