// Fenêtre voisine — ressource pour test_fuite_formatdate_poseur.owl. Champ
// Date sans masque explicite, sous un projet qui pose FormatDate = "MM/JJ/AAAA".

FEN_FuiteFormatDatePoseur est une Fenêtre
	PROPRIETES
		Titre       = "Projet poseur FormatDate"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 120
	FIN

	SAI_Date est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 10
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieDate
			Valeur     = ""
		FIN
	FIN
FIN
