// Fenêtre voisine — ressource pour test_fuite_formatdate_sans_projet.owl.
// Champ Date sans masque explicite, sous un contexte SCRIPT (pas de
// projet.owl ancêtre ici) qui ne pose aucun FormatDate.

FEN_FuiteFormatDateSansProjet est une Fenêtre
	PROPRIETES
		Titre       = "Sans projet, sans FormatDate"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 120
	FIN

	SAI_Date est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 10
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieDate
			Valeur     = ""
		FIN
	FIN
FIN
