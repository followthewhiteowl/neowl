// Fenêtre ressource pour test_nonreg_controle_ref.owl.
// Reflète le pattern de controle_propriete_defaut/nonreg_controle_ref.

FEN_RefCtrl est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 300
		Hauteur     = 200
	FIN

	clicCount552 est un entier = 0

	BTN_Ok552 est un Champ Bouton
		PROPRIETES
			X = 10
			Y = 10
		FIN
		PROCEDURE surClic()
			clicCount552 += 1
		FIN
	FIN

	SAI_Input552 est un Champ Saisie
		PROPRIETES
			X = 10
			Y = 60
		FIN
	FIN

	PROCEDURE LireClicCount552()
		cb_clic552(clicCount552)
	FIN

FIN
