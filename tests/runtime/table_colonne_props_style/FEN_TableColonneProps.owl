// Fenêtre voisine — ressource pour test_table_colonne_props_style.owl.
// (pattern split canon strict — cf.  / .)
//
// Verrouille l'ensemble des props posées par le ticket  (Lot 1) :
//   Table   : Orientation, EtatInitial, HauteurLigne, Style (+ Visible déjà
//             existant).
//   Colonne : Visible, Etat, Style (+ Libellé/Type/Largeur déjà existants).

FEN_TableColonneProps est une Fenêtre
	PROPRIETES
		Titre       = "Test props Table + Colonne stylées"
		Disposition = dispLibre
	FIN

	TAB_Produits est un Champ Table
		PROPRIETES
			X                                  = 10
			Y                                  = 10
			Largeur                            = 550
			Hauteur                            = 350
			Visible                            = Vrai
			Orientation                        = Vertical
			EtatInitial                        = EnSaisie
			HauteurLigne                       = 24
			Style..CadreExtérieur..CouleurFond = Blanc
		FIN

		COL_Reference est une Colonne
			PROPRIETES
				Libellé                      = "Référence"
				Type                         = colTypeTexte
				Largeur                      = 150
				Visible                      = Vrai
				Etat                         = Actif
				Style..TitreColonne..Couleur = Noir
			FIN
		FIN

		COL_Stock est une Colonne
			PROPRIETES
				Libellé = "Stock"
				Type    = colTypeNumerique
				Largeur = 100
				Visible = Faux
				Etat    = Grisé
			FIN
		FIN
	FIN
FIN
