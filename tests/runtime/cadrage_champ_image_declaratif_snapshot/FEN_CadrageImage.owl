// Fenetre voisine pour le test de cadrage declare d'un Champ Image.
// Une image source NON carree (200x80, rouge unie) est affichee dans deux
// Champs Image carres identiques (200x200) qui ne different que par le
// Cadrage. cadEtire deforme l'image pour remplir tout le cadre (les bords
// haut/bas portent du rouge). cadHomothetique preserve le ratio 200x80 :
// l'image occupe une bande centrale, les bords haut/bas restent du fond.

FEN_CadrageImage est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 500
		Hauteur     = 500
		Titre       = "Cadrage Champ Image"
	FIN

	// Image source 200x80 rouge unie (ratio large, non carre).
	imgSrc est une Image = dCréeImage(200, 80, RougeClair)

	IMG_Etire est un Champ Image
		PROPRIETES
			X           = 20
			Y           = 20
			Largeur     = 200
			Hauteur     = 200
			Cadrage     = cadEtire
			Image       = imgSrc
			CouleurFond = RVB(50, 50, 50)
		FIN
	FIN

	IMG_Homo est un Champ Image
		PROPRIETES
			X           = 250
			Y           = 20
			Largeur     = 200
			Hauteur     = 200
			Cadrage     = cadHomothetique
			Image       = imgSrc
			CouleurFond = RVB(50, 50, 50)
		FIN
	FIN
FIN
