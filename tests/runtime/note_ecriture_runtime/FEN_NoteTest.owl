FEN_NoteTest est une Fenêtre
	PROPRIETES
		Titre       = "Note test"
		Largeur     = 300
		Hauteur     = 200
		Disposition = dispLibre
	FIN

	BTN_OK est un Champ Bouton
		PROPRIETES
			Libellé = "OK"
			X       = 20
			Y       = 20
		FIN
	FIN

	//  — ecriture runtime de ..Note (store-only) sur un champ et sur la
	// fenetre ; la relecture doit etre correcte et AUCUN message "[ui] Ecriture
	// runtime ... non supportee" ne doit sortir (widget Qt monte offscreen).
	PROCEDURE FinInitialisation()
		BTN_OK..Note       = "note bouton"
		FEN_NoteTest..Note = "note fenetre"
		dbgVérifieEgalité(BTN_OK..Note, "note bouton", "1282 ..Note bouton relu")
		dbgVérifieEgalité(FEN_NoteTest..Note, "note fenetre", "1282 ..Note fenetre relu")
	FIN
FIN
