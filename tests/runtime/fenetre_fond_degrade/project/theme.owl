// Thème désigné par Projet..Thème. Un styleConteneur dont le CadreExtérieur
// porte un Dégradé vertical (Angle 90 = haut->bas) aux couleurs franches
// (rouge -> bleu) pour rendre la transition détectable au pixel.
ThèmeFondDegrade est un Thème
	fondDegradeVertical est un styleConteneur = {
		CadreExtérieur = {
			Dégradé = {
				Type         = dégradéLinéaire
				Angle        = 90
				CouleurDébut = RVB(255, 0, 0)
				CouleurFin   = RVB(0, 0, 255)
			}
		}
	}
FIN
