// Lot inline literal — expressions complexes dans les valeurs de fields.
// RVB(...), opérateurs, références à variables, calculs.

baseEpaisseur est un entier = 2

// RVB() en valeur
c1 est un Cadre = {
	Couleur   = RVB(180, 30, 30)
	Epaisseur = baseEpaisseur + 1
	Bords     = BordHaut + BordDroite + BordBas + BordGauche
}

dbgVérifieEgalité(c1..Epaisseur, 3, "expression arithm Epaisseur")
dbgVérifieEgalité(c1..Bords, 15, "expression combinee Bords (BordTous)")

// Reference a une variable
maCouleur est un entier = JauneOr
c2 est un Cadre = {
	Couleur = maCouleur
}

dbgVérifieEgalité(c2..Couleur, JauneOr, "ref variable Couleur")

dbgBilanTest()
