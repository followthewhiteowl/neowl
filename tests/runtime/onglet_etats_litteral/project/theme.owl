// Style d'onglet nommé portant les surcharges d'état de ses volets sous la
// forme littérale `Etats = { Survol = { ... } }`, celle des autres familles de
// style. Sans elle, un thème ne peut décrire qu'un volet amputé de ses états.

ThèmeOngletEtatsLitteral est un Thème
	ongEtats est un styleOnglet = {
		VoletActif = {
			CouleurFond = Blanc
			Couleur     = Noir
			Etats       = {
				Survol = {
					CouleurFond = RVB(255, 0, 255)
					Couleur     = RVB(0, 255, 255)
				}
			}
		}
		VoletInactif = {
			CouleurFond = Bleu
			Couleur     = Blanc
			Etats       = {
				Survol = { CouleurFond = RVB(255, 128, 0) }
			}
		}
	}
FIN
