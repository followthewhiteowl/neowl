// Trois Champs Onglet strictement identiques par ailleurs (mêmes libellés,
// mêmes dimensions, même volet actif), habillés du MÊME style écrit de trois
// façons :
//
//   ONG_Cascade  : cascade ligne à ligne `Style..VoletActif..Etats[survol]..X`
//   ONG_Litteral : littéral inline `Style = { VoletActif = { Etats = {
//                  Survol = { ... } } } }`
//   ONG_Theme    : style nommé du thème, lui-même écrit en littéral
//
// Les couleurs d'état sont franches et sans voisine (magenta, cyan, orange) :
// les lire dans la feuille de style désigne sans ambiguïté leur origine.

FEN_OngletEtatsLitteral est une Fenêtre
	PROPRIETES
		Titre       = "États d'un volet, trois écritures"
		Largeur     = 520
		Hauteur     = 560
		Disposition = dispLibre
	FIN

	ONG_Cascade est un Champ Onglet
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 480
			Hauteur = 160
			Valeur  = 1

			Style..VoletActif..CouleurFond                  = Blanc
			Style..VoletActif..Couleur                      = Noir
			Style..VoletActif..Etats[survol]..CouleurFond   = RVB(255, 0, 255)
			Style..VoletActif..Etats[survol]..Couleur       = RVB(0, 255, 255)
			Style..VoletInactif..CouleurFond                = Bleu
			Style..VoletInactif..Couleur                    = Blanc
			Style..VoletInactif..Etats[survol]..CouleurFond = RVB(255, 128, 0)
		FIN

		VOL_CascadeUn est un Volet
			PROPRIETES
				Libellé     = "Profil"
				Disposition = dispLibre
			FIN
		FIN

		VOL_CascadeDeux est un Volet
			PROPRIETES
				Libellé     = "Options"
				Disposition = dispLibre
			FIN
		FIN
	FIN

	ONG_Litteral est un Champ Onglet
		PROPRIETES
			X       = 10
			Y       = 190
			Largeur = 480
			Hauteur = 160
			Valeur  = 1

			Style = {
				VoletActif = {
					CouleurFond = Blanc
					Couleur     = Noir
					Etats       = {
						Survol = {
							CouleurFond = RVB(255, 0, 255)
							Couleur     = RVB(0, 255, 255)
						}
					}
				}
				VoletInactif = {
					CouleurFond = Bleu
					Couleur     = Blanc
					Etats       = {
						Survol = { CouleurFond = RVB(255, 128, 0) }
					}
				}
			}
		FIN

		VOL_LitteralUn est un Volet
			PROPRIETES
				Libellé     = "Profil"
				Disposition = dispLibre
			FIN
		FIN

		VOL_LitteralDeux est un Volet
			PROPRIETES
				Libellé     = "Options"
				Disposition = dispLibre
			FIN
		FIN
	FIN

	ONG_Theme est un Champ Onglet
		PROPRIETES
			X       = 10
			Y       = 370
			Largeur = 480
			Hauteur = 160
			Valeur  = 1
			Style   = theme.ongEtats
		FIN

		VOL_ThemeUn est un Volet
			PROPRIETES
				Libellé     = "Profil"
				Disposition = dispLibre
			FIN
		FIN

		VOL_ThemeDeux est un Volet
			PROPRIETES
				Libellé     = "Options"
				Disposition = dispLibre
			FIN
		FIN
	FIN
FIN
