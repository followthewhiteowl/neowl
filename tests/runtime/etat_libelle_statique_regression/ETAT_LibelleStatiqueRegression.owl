// Ressource Etat voisine de test_libelle_statique_regression.owl --
// aucune écriture runtime sur le Champ Libellé : la valeur PROPRIETES
// doit rester celle rendue dans le PDF (comportement déjà correct,
// non-régression à préserver par le fix des bugs C/D).

ETAT_LibelleStatiqueRegression est un État
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	corps est un Corps
		PROPRIETES
			Hauteur = 40
		FIN

		LIB_X est un Champ Libellé
			PROPRIETES
				Libellé      = "STATIQUE"
				X            = 20
				Y            = 10
				Largeur      = 100
				Hauteur      = 15
				PoliceNom    = iPoliceLiberationSans
				PoliceTaille = 11
			FIN
		FIN
	FIN
FIN
