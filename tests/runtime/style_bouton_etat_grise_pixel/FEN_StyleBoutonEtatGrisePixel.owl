//  — Style..Libellé..Etats[grisé] réconcilié avec Etat = Grisé (Qt
// :disabled). Etat est un état PERSISTANT (posé une fois, pas transitoire
// comme le survol souris) → capturable au pixel directement, sans
// interaction simulée.
FEN_StyleBoutonEtatGrisePixel est une Fenêtre
	PROPRIETES
		Titre       = "Style Bouton — état grisé"
		Largeur     = 560
		Hauteur     = 120
		Disposition = dispLibre
		CouleurFond = RVB(10, 10, 10)
	FIN

	BTN_Cible est un Champ Bouton
		PROPRIETES
			X                                              = 20
			Y                                              = 20
			Largeur                                        = 500
			Hauteur                                        = 60
			Libellé                                        = "Valider"
			Style..Libellé..Etats[grisé]..CouleurFond      = RVB(0, 255, 0)
			Style..Libellé..Etats[grisé]..Cadre..Couleur   = RVB(0, 128, 255)
			Style..Libellé..Etats[grisé]..Cadre..Epaisseur = 3
		FIN
	FIN
FIN
