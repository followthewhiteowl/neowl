// Voisine du test capture-pixel  : 4 Saisie cote a cote,
// positions fixes (dispLibre) pour permettre un scan de zone precis
// depuis le script test.
FEN_StyleSaisieRendu est une Fenêtre
	PROPRIETES
		Titre       = "Rendu style Saisie"
		Largeur     = 560
		Hauteur     = 340
		Disposition = dispLibre
		CouleurFond = RVB(10, 10, 10)
	FIN

	SAI_Flat est un Champ Saisie
		PROPRIETES
			X           = 20
			Y           = 20
			Largeur     = 500
			Hauteur     = 60
			CouleurFond = RVB(255, 0, 255)
		FIN
	FIN

	SAI_Style est un Champ Saisie
		PROPRIETES
			X                  = 20
			Y                  = 100
			Largeur            = 500
			Hauteur            = 60
			Style..CouleurFond = RVB(0, 255, 0)
		FIN
	FIN

	SAI_Nu est un Champ Saisie
		PROPRIETES
			X       = 20
			Y       = 180
			Largeur = 500
			Hauteur = 60
		FIN
	FIN

	SAI_Combine est un Champ Saisie
		PROPRIETES
			X                       = 20
			Y                       = 260
			Largeur                 = 500
			Hauteur                 = 60
			Style..CouleurFond      = RVB(255, 165, 0)
			Style..Cadre..Couleur   = RVB(0, 128, 255)
			Style..Cadre..Epaisseur = 3
		FIN
	FIN
FIN
