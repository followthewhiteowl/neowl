//  — sonde pixel du comportement transverse de ..Alignement.
// Fenetre dispVerticale (largeur 300). Chaque Libelle a une Largeur figee
// de 100 et un fond vert. On mesure ou le fond se place sur l'axe
// transverse (horizontal) pour chaque valeur d'Alignement, et surtout pour
// le cas SANS Alignement (defaut) qui doit se comporter comme alignDébut
// (compact a gauche), et NON comme alignÉtire (remplit toute la largeur).
FEN_Alignement est une Fenêtre
	PROPRIETES
		Titre       = "Alignement transverse"
		Largeur     = 300
		Hauteur     = 200
		Disposition = dispVerticale
		Espacement  = 4
		CouleurFond = RVB(5, 5, 5)
	FIN

	LIB_Debut est un Champ Libellé
		PROPRIETES
			Largeur                            = 100
			Hauteur                            = 30
			Libellé                            = "D"
			Alignement                         = alignDébut
			Style..CadreExtérieur..CouleurFond = RVB(0, 200, 0)
		FIN
	FIN

	LIB_Centre est un Champ Libellé
		PROPRIETES
			Largeur                            = 100
			Hauteur                            = 30
			Libellé                            = "C"
			Alignement                         = alignCentre
			Style..CadreExtérieur..CouleurFond = RVB(0, 200, 0)
		FIN
	FIN

	LIB_Fin est un Champ Libellé
		PROPRIETES
			Largeur                            = 100
			Hauteur                            = 30
			Libellé                            = "F"
			Alignement                         = alignFin
			Style..CadreExtérieur..CouleurFond = RVB(0, 200, 0)
		FIN
	FIN

	LIB_Etire est un Champ Libellé
		PROPRIETES
			Largeur                            = 100
			Hauteur                            = 30
			Libellé                            = "E"
			Alignement                         = alignÉtire
			Style..CadreExtérieur..CouleurFond = RVB(0, 200, 0)
		FIN
	FIN

	LIB_Defaut est un Champ Libellé
		PROPRIETES
			Largeur                            = 100
			Hauteur                            = 30
			Libellé                            = "X"
			Style..CadreExtérieur..CouleurFond = RVB(0, 200, 0)
		FIN
	FIN
FIN
