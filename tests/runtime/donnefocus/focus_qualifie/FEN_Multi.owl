// Fenêtre voisine — ressource pour test_focus_qualifie.owl.
// Utilisée pour tester la forme qualifiée DonneFocus(FEN_Multi.SAI_Cible).

FEN_Multi est une Fenêtre
	PROPRIETES
		Titre       = "Multi Focus"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 200
	FIN

	nEntreeCible est un entier = 0

	SAI_Source est un Champ Saisie
		PROPRIETES
			X       = 20
			Y       = 20
			Largeur = 150
		FIN
	FIN

	SAI_Cible est un Champ Saisie
		PROPRIETES
			X       = 20
			Y       = 60
			Largeur = 150
		FIN
		PROCEDURE surEntrée()
			nEntreeCible += 1
		FIN
	FIN

	PROCEDURE RemonteEntreeCible()
		callback_entre_cible(nEntreeCible)
	FIN
FIN
