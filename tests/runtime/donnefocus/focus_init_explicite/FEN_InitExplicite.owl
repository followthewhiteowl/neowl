// Fenêtre voisine — ressource pour test_focus_init_explicite.owl.
// Deux champs : SAI_Premier (premier lexical), SAI_Deuxieme.
// FinInitialisation pose explicitement le focus sur SAI_Deuxieme.
// Le focus initial automatique NE DOIT PAS écraser ce choix explicite :
// SAI_Deuxieme garde le focus, SAI_Premier ne reçoit jamais surEntrée.

FEN_InitExplicite est une Fenêtre
	PROPRIETES
		Titre       = "Focus initial explicite"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 250
	FIN

	nEntreePremier est un entier = 0
	nEntreeDeuxieme est un entier = 0

	SAI_Premier est un Champ Saisie
		PROPRIETES
			X       = 20
			Y       = 20
			Largeur = 150
		FIN
		PROCEDURE surEntrée()
			nEntreePremier += 1
		FIN
	FIN

	SAI_Deuxieme est un Champ Saisie
		PROPRIETES
			X       = 20
			Y       = 60
			Largeur = 150
		FIN
		PROCEDURE surEntrée()
			nEntreeDeuxieme += 1
		FIN
	FIN

	PROCEDURE FinInitialisation()
		DonneFocus(SAI_Deuxieme)
	FIN

	PROCEDURE RemonteEntrees()
		callback_entrees_explicite(nEntreePremier, nEntreeDeuxieme)
	FIN
FIN
