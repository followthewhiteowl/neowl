// Fenêtre voisine — ressource pour test_focus_initial_sans_saisie.owl.
// Fenêtre sans aucun champ Saisie : uniquement des Libellés et un Bouton.
// Objectif : vérifier qu'il n'y a pas de crash au focus initial.

FEN_SansSaisie est une Fenêtre
	PROPRIETES
		Titre       = "Sans saisie"
		Disposition = dispLibre
		Largeur     = 300
		Hauteur     = 150
	FIN

	ouverteSansErreur est un booléen = Vrai

	LIB_Info est un Champ Libellé
		PROPRIETES
			X       = 20
			Y       = 20
			Libellé = "Aucune saisie"
		FIN
	FIN

	BTN_OK est un Champ Bouton
		PROPRIETES
			X       = 20
			Y       = 60
			Libellé = "OK"
		FIN
	FIN

	PROCEDURE RemonteOuverte()
		callback_ouverte_sans_saisie(ouverteSansErreur)
	FIN
FIN
