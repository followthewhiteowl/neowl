// Fenêtre voisine — ressource pour test_focus_initial_auto.owl.
// Trois champs déclarés dans l'ordre : SAI_Premier, SAI_Deuxieme, SAI_Troisieme.
// Le focus initial automatique doit aller sur SAI_Premier (premier lexical).

FEN_InitAuto est une Fenêtre
	PROPRIETES
		Titre       = "Focus initial auto"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 250
	FIN

	nEntreePremier est un entier = 0
	nEntreeDeuxieme est un entier = 0
	nEntreeTroisieme est un entier = 0

	SAI_Premier est un Champ Saisie
		PROPRIETES
			X       = 20
			Y       = 20
			Largeur = 150
		FIN
		PROCEDURE surEntrée()
			nEntreePremier += 1
		FIN
	FIN

	SAI_Deuxieme est un Champ Saisie
		PROPRIETES
			X       = 20
			Y       = 60
			Largeur = 150
		FIN
		PROCEDURE surEntrée()
			nEntreeDeuxieme += 1
		FIN
	FIN

	SAI_Troisieme est un Champ Saisie
		PROPRIETES
			X       = 20
			Y       = 100
			Largeur = 150
		FIN
		PROCEDURE surEntrée()
			nEntreeTroisieme += 1
		FIN
	FIN

	PROCEDURE RemonteEntrees()
		callback_entrees_init(nEntreePremier, nEntreeDeuxieme, nEntreeTroisieme)
	FIN
FIN
