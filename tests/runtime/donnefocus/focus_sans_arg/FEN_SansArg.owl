// Fenêtre voisine — ressource pour test_focus_sans_arg.owl.
// Deux champs Saisie. Le test appelle DonneFocus() sans argument depuis
// le script de test (pas depuis un event de la fenêtre).

FEN_SansArg est une Fenêtre
	PROPRIETES
		Titre       = "Focus sans arg"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 200
	FIN

	nEntreeSAI est un entier = 0
	nEntreeSuivant est un entier = 0

	SAI_Verif est un Champ Saisie
		PROPRIETES
			X       = 20
			Y       = 20
			Largeur = 150
		FIN
		PROCEDURE surEntrée()
			nEntreeSAI += 1
		FIN
	FIN

	SAI_Suivant est un Champ Saisie
		PROPRIETES
			X       = 20
			Y       = 60
			Largeur = 150
		FIN
		PROCEDURE surEntrée()
			nEntreeSuivant += 1
		FIN
	FIN

	PROCEDURE RemonteEntrees()
		callback_entrees_sansarg(nEntreeSAI, nEntreeSuivant)
	FIN
FIN
