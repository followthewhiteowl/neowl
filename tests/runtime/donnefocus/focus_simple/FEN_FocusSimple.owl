// Fenêtre voisine — ressource pour test_focus_simple.owl.
// Deux champs Saisie. Les events surEntrée / surSortie incrémentent
// des compteurs globaux, remontés via une procédure publique LireCompteurs().

FEN_FocusSimple est une Fenêtre
	PROPRIETES
		Titre       = "Focus simple"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 200
	FIN

	nEntreeA est un entier = 0
	nSortieA est un entier = 0
	nEntreeB est un entier = 0
	nSortieB est un entier = 0

	SAI_A est un Champ Saisie
		PROPRIETES
			X       = 20
			Y       = 20
			Largeur = 150
		FIN
		PROCEDURE surEntrée()
			nEntreeA += 1
		FIN
		PROCEDURE surSortie()
			nSortieA += 1
		FIN
	FIN

	SAI_B est un Champ Saisie
		PROPRIETES
			X       = 20
			Y       = 60
			Largeur = 150
		FIN
		PROCEDURE surEntrée()
			nEntreeB += 1
		FIN
		PROCEDURE surSortie()
			nSortieB += 1
		FIN
	FIN

	PROCEDURE RemonteCompteurs()
		callback_compteurs_focus(nEntreeA, nSortieA, nEntreeB, nSortieB)
	FIN
FIN
