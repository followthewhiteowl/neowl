// Fenêtre voisine — ressource pour test_focus_reapply_noevent.owl.
// Un champ Saisie qui compte ses surEntrée / surSortie, remontés via une
// procédure publique.

FEN_Reapply est une Fenêtre
	PROPRIETES
		Titre       = "Focus reapply"
		Disposition = dispLibre
		Largeur     = 300
		Hauteur     = 120
	FIN

	nEntree est un entier = 0
	nSortie est un entier = 0

	SAI_Champ est un Champ Saisie
		PROPRIETES
			X       = 20
			Y       = 20
			Largeur = 150
		FIN
		PROCEDURE surEntrée()
			nEntree += 1
		FIN
		PROCEDURE surSortie()
			nSortie += 1
		FIN
	FIN

	PROCEDURE RemonteEntrees()
		callback_reapply(nEntree, nSortie)
	FIN
FIN
