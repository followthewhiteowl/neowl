// =====================================================================
// TEST: Lot A — constantes des 3 enums ajoutees au catalogue UI Libelle.
//
// Verifie des invariants semantiques (independants des valeurs entieres
// internes : zone sentinel cf sentinels.h) :
//   1. Les 14 constantes curseurs sont definies et toutes distinctes.
//   2. Les 3 constantes ellipse sont definies et distinctes.
//   3. Les 3 constantes sensEcriture sont definies et distinctes.
//   4. Les alias ASCII (curFleche, curMainSysteme, sensDefaut) resolvent
//      vers les memes valeurs que leurs canoniques accentues.
// =====================================================================

Trace("=== Lot A : constantes des nouveaux enums Libelle ===")

// --- CurseurSouris : 14 valeurs toutes distinctes ---
dbgVérifieDifférence(curFlèche, curMain, "curFlèche != curMain")
dbgVérifieDifférence(curMain, curMainSystème, "curMain != curMainSystème")
dbgVérifieDifférence(curMainSystème, curCaret, "curMainSystème != curCaret")
dbgVérifieDifférence(curCaret, curCroix, "curCaret != curCroix")
dbgVérifieDifférence(curCroix, curSablier, "curCroix != curSablier")
dbgVérifieDifférence(curSablier, curAide, "curSablier != curAide")
dbgVérifieDifférence(curAide, curInterdit, "curAide != curInterdit")
dbgVérifieDifférence(curInterdit, curHFlèche, "curInterdit != curHFlèche")
dbgVérifieDifférence(curHFlèche, curTaille, "curHFlèche != curTaille")
dbgVérifieDifférence(curTaille, curTailleNS, "curTaille != curTailleNS")
dbgVérifieDifférence(curTailleNS, curTailleOE, "curTailleNS != curTailleOE")
dbgVérifieDifférence(curTailleOE, curTailleNESO, "curTailleOE != curTailleNESO")
dbgVérifieDifférence(curTailleNESO, curTailleNOSE, "curTailleNESO != curTailleNOSE")

// Alias ASCII : meme valeur que le canon accentue.
dbgVérifieEgalité(curFlèche, curFlèche, "curFleche (alias) = curFlèche")
dbgVérifieEgalité(curMainSystème, curMainSystème, "curMainSysteme (alias) = curMainSystème")
dbgVérifieEgalité(curHFlèche, curHFlèche, "curHFleche (alias) = curHFlèche")

// --- Ellipse (3 valeurs distinctes) ---
dbgVérifieDifférence(ellipseInactive, ellipseFin, "ellipseInactive != ellipseFin")
dbgVérifieDifférence(ellipseFin, ellipseChemin, "ellipseFin != ellipseChemin")
dbgVérifieDifférence(ellipseInactive, ellipseChemin, "ellipseInactive != ellipseChemin")

// --- SensEcriture (3 valeurs distinctes) ---
dbgVérifieDifférence(sensDéfaut, sensGaucheDroite, "sensDéfaut != sensGaucheDroite")
dbgVérifieDifférence(sensGaucheDroite, sensDroiteGauche, "sensGaucheDroite != sensDroiteGauche")
dbgVérifieDifférence(sensDéfaut, sensDroiteGauche, "sensDéfaut != sensDroiteGauche")

// Alias ASCII.
dbgVérifieEgalité(sensDéfaut, sensDéfaut, "sensDefaut (alias) = sensDéfaut")

dbgBilanTest()
