//  — prop `HauteurOption` (INT, px ; 0 = hauteur naturelle/auto) sur
// le Champ Sélecteur : hauteur de chaque ligne d'option.
FEN_StyleSelecteurHauteurOption est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
	FIN

	SEL_Fixe est un Champ Sélecteur
		PROPRIETES
			X             = 10
			Y             = 10
			Largeur       = 240
			Hauteur       = 150
			Options       = ["Un", "Deux", "Trois"]
			HauteurOption = 40
		FIN
	FIN

	SEL_Auto est un Champ Sélecteur
		PROPRIETES
			X       = 260
			Y       = 10
			Largeur = 240
			Hauteur = 150
			Options = ["Un", "Deux"]
		FIN
	FIN
FIN
