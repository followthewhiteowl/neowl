//  — prop `HauteurOption` (INT, px ; 0 = auto) sur le Champ
// Sélecteur : hauteur de chaque ligne d'option. Calque le patron du test
// symétrique de l'Interrupteur (style_interrupteur_hauteuroption).
//
// ROUGE attendu : `HauteurOption` n'existe pas encore dans le catalogue de
// props du Champ Sélecteur (PROPS_SELECTEUR_FIELD, src/ui_catalog.c) --
// compile-fail (propriété inconnue) sur SEL_Fixe..HauteurOption = 40.

Ouvre(FEN_StyleSelecteurHauteurOption)

dbgVérifieEgalité(SEL_Fixe..HauteurOption, 40, "HauteurOption : posée en PROPRIETES, relue sur l'instance")

// Defaut : 0 = auto/dynamique (pas de hauteur fixe imposée).
dbgVérifieEgalité(SEL_Auto..HauteurOption, 0, "HauteurOption : défaut 0 (auto) quand non renseignée")

SEL_Auto..HauteurOption = 0
dbgVérifieEgalité(SEL_Auto..HauteurOption, 0, "HauteurOption = 0 explicite : round-trip auto")

Ferme(FEN_StyleSelecteurHauteurOption)
dbgBilanTest()
