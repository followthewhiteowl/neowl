//  — Non-regression : SINON SI (elif) prend la bonne branche
// STATUT INITIAL : VERT (ne doit pas regressee apres fix)

// Forme elif basique : premiere condition vraie
PROCEDURE TestElifPremierVrai()
	nRes est un entier = 0
	SI nRes = 0 ALORS
		nRes = 10
	SINON SI nRes = 1 ALORS
		nRes = 20
	SINON
		nRes = 30
	FIN
	RENVOYER nRes
FIN

// Forme elif : deuxieme condition vraie
PROCEDURE TestElifDeuxiemeVrai()
	nVal est un entier = 1
	nRes est un entier = 0
	SI nVal = 0 ALORS
		nRes = 10
	SINON SI nVal = 1 ALORS
		nRes = 20
	SINON
		nRes = 30
	FIN
	RENVOYER nRes
FIN

// Forme elif : branche SINON finale prise
PROCEDURE TestElifSinonFinal()
	nVal est un entier = 99
	nRes est un entier = 0
	SI nVal = 0 ALORS
		nRes = 10
	SINON SI nVal = 1 ALORS
		nRes = 20
	SINON
		nRes = 30
	FIN
	RENVOYER nRes
FIN

// Forme elif chainee (3 conditions)
PROCEDURE TestElifChaine()
	nVal est un entier = 2
	nRes est un entier = 0
	SI nVal = 0 ALORS
		nRes = 10
	SINON SI nVal = 1 ALORS
		nRes = 20
	SINON SI nVal = 2 ALORS
		nRes = 30
	SINON
		nRes = 40
	FIN
	RENVOYER nRes
FIN

dbgVérifieEgalité(TestElifPremierVrai(), 10, "elif : 1ere condition vraie -> 10")
dbgVérifieEgalité(TestElifDeuxiemeVrai(), 20, "elif : 2eme condition vraie -> 20")
dbgVérifieEgalité(TestElifSinonFinal(), 30, "elif : aucune condition, SINON final -> 30")
dbgVérifieEgalité(TestElifChaine(), 30, "elif chaine 3 conditions : nVal=2 -> 30")

dbgBilanTest()
