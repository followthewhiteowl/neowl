// Fenêtre voisine — ressource pour test_valeur_typee_numerique_precis.owl.
//
// SAI_NumPrecis (sujet, ) + trois témoins de non-régression
// (/1995) : SAI_Num (owlRéel, sert AUSSI de discriminant de
// précision par comparaison), SAI_Monetaire (owlMonétaire) et SAI_Texte
// (chaîne) — leur ..Valeur ne doit pas bouger malgré le changement
// cross-cutting du chemin partagé input_typed_get/set.

FEN_ValeurTypeeNumPrecis est une Fenêtre
	PROPRIETES
		Titre       = "Valeur typée numérique précis"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 220
	FIN

	SAI_NumPrecis est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 10
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieNumériquePrécis
			Valeur     = ""
		FIN
	FIN

	SAI_Num est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 50
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieNum
			Valeur     = ""
		FIN
	FIN

	SAI_Monetaire est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 90
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieMonétaire
			Valeur     = ""
		FIN
	FIN

	SAI_Texte est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 130
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieTexte
			Valeur     = ""
		FIN
	FIN
FIN
