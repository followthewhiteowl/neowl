// Un Champ Bouton stylé via un styleBouton (theme.btnOk) et un Champ Saisie
// stylé via un styleSaisie (theme.saiOk) : les deux genres correspondent,
// la compilation doit rester acceptée.
FEN_TypeMatch est une Fenêtre
	PROPRIETES
		Titre       = "Type match"
		Disposition = dispLibre
		Largeur     = 320
		Hauteur     = 160
	FIN

	BTN_x est un Champ Bouton
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 200
			Hauteur = 40
			Libellé = "X"
			Style   = theme.btnOk
		FIN
	FIN

	SAI_x est un Champ Saisie
		PROPRIETES
			X       = 10
			Y       = 60
			Largeur = 200
			Style   = theme.saiOk
		FIN
	FIN
FIN
