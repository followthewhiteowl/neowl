// Catalogue de styles nommés, chacun affecté au genre de champ qui lui
// correspond (Bouton -> styleBouton, Saisie -> styleSaisie). Verrouille le
// cas GREEN attendu du check type-vs-genre : rien ne doit régresser ici.
ThèmeTypeMatch est un Thème
	btnOk est un styleBouton = {
		CadreExtérieur = { CouleurFond = Bleu }
	}
	saiOk est un styleSaisie = {
		ZoneSaisie = { CouleurFond = JauneClair }
	}
FIN
