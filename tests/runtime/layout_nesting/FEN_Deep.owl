// Nesting profond : Conteneur dans Conteneur.

FEN_Deep est une Fenêtre
	PROPRIETES
		Disposition = dispVerticale
	FIN

	GRD_Outer est un Champ Conteneur
		PROPRIETES
			Disposition = dispHorizontale
			Étire       = Vrai
		FIN

		PNL_Left est un Champ Conteneur
			PROPRIETES
				Disposition = dispVerticale
				Étire       = Vrai
			FIN
			LIB_LeftA est un Champ Libellé
				PROPRIETES
					Libellé = "Left A"
				FIN
			FIN
			LIB_LeftB est un Champ Libellé
				PROPRIETES
					Libellé = "Left B"
				FIN
			FIN
		FIN

		PNL_Right est un Champ Conteneur
			PROPRIETES
				Disposition = dispGrille
				Colonnes    = 2
				Étire       = Vrai
			FIN
			BTN_R1 est un Champ Bouton
				PROPRIETES
					Libellé = "1"
				FIN
			FIN
			BTN_R2 est un Champ Bouton
				PROPRIETES
					Libellé = "2"
				FIN
			FIN
			BTN_R3 est un Champ Bouton
				PROPRIETES
					Libellé = "3"
					ColSpan = 2
				FIN
			FIN
		FIN
	FIN
FIN
