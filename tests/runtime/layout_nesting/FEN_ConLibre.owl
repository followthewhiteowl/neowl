// Conteneur en dispLibre (mode legacy) avec X/Y sur ses enfants.

FEN_ConLibre est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 300
	FIN

	PNL_Free est un Champ Conteneur
		PROPRIETES
			X           = 10
			Y           = 10
			Largeur     = 380
			Hauteur     = 280
			Disposition = dispLibre
		FIN
		LIB_Pos est un Champ Libellé
			PROPRIETES
				X       = 20
				Y       = 20
				Libellé = "Position absolue OK car parent en dispLibre"
			FIN
		FIN
	FIN
FIN
