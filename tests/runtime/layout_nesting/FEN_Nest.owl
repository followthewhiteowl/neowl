// Nesting simple : Fenetre > Conteneur > 2 boutons.

FEN_Nest est une Fenêtre
	PROPRIETES
		Disposition = dispVerticale
		Largeur     = 400
		Hauteur     = 300
	FIN

	LIB_Top est un Champ Libellé
		PROPRIETES
			Libellé = "Header"
		FIN
	FIN

	BAR_Boutons est un Champ Conteneur
		PROPRIETES
			Disposition = dispHorizontale
			Espacement  = 8
			AlignH      = alignFin
		FIN
		BTN_OK est un Champ Bouton
			PROPRIETES
				Libellé = "OK"
				Largeur = 80
			FIN
		FIN
		BTN_KO est un Champ Bouton
			PROPRIETES
				Libellé = "Annuler"
				Largeur = 80
			FIN
		FIN
	FIN
FIN
