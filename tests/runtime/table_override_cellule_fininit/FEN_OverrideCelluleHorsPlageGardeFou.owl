// Fenêtre voisine — ressource partagée de
// tests\runtime\table_override_cellule_fininit\test_table_override_cellule_hors_plage_gardefou.
//
//  — garde-fou : un VRAI dépassement de ligne doit continuer à être
// signalé même après correction du bug FinInitialisation. Le bound-check ne
// doit pas être relâché — seulement corrigé pour regarder le store au lieu
// du compteur de lignes du widget.

FEN_OverrideCelluleHorsPlageGardeFou est une Fenêtre
	PROPRIETES
		Titre   = "Garde-fou dépassement réel"
		Largeur = 300
		Hauteur = 200
	FIN

	TABLE_Synthese est un Champ Table
		PROPRIETES
			Étire = Vrai
		FIN

		COL_Nom est une Colonne
			PROPRIETES
				Libellé = "Nom"
				Type    = colTypeTexte
				Largeur = 160
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		TableAjouteLigne(TABLE_Synthese, "Alice")
		TableAjouteLigne(TABLE_Synthese, "Bob")
	FIN
FIN
