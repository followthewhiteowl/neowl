// Lot C Zero — 0 = pas de marge (compile et applique 0).

FEN_LotC_Zero est une Fenêtre
	PROPRIETES
		Titre       = "Zero"
		Disposition = dispLibre
	FIN

	LIB_NoMargin est un Champ Libellé
		PROPRIETES
			Libellé       = "no inner padding"
			RetraitGauche = 0
			RetraitDroit  = 0
			RetraitHaut   = 0
			RetraitBas    = 0
		FIN
	FIN
FIN
