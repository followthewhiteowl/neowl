// Lot C EN — forme EN canon (LeftIndent/RightIndent/TopIndent/BottomIndent).

FEN_LotC_EN est un Window
	PROPRIETES
		Title       = "Lot C EN"
		Disposition = dispLibre
	FIN

	LIB_PaddedEN est un Champ Label
		PROPRIETES
			Width        = 200
			Height       = 60
			Caption      = "Padded"
			LeftIndent   = 8
			RightIndent  = 8
			TopIndent    = 4
			BottomIndent = 4
		FIN
	FIN
FIN
