// Ressource Etat pure utilisee par test_monchamp_sous_champ.owl.
//
// Verifie que l'alias MonChamp fonctionne dans le top-level d'un
// sous-champ d'Etat : MonChamp resout vers le self (LIB_X) et permet
// la pose/lecture des proprietes. Observation via callback voisin.

ETAT_MonChampSousChamp est un Etat
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	corps est un Corps
		PROPRIETES
			Hauteur = 40
		FIN

		LIB_X est un Champ Libelle
			PROPRIETES
				Libelle      = "initial"
				X            = 20
				Y            = 10
				Largeur      = 100
				Hauteur      = 15
				PoliceNom    = iPoliceLiberationSans
				PoliceTaille = 11
			FIN

			// TOP-LEVEL SOUS-CHAMP — utilisation de MonChamp comme alias self.
			MonChamp..Libelle = "via MonChamp"
			callback_observe("MonChamp:" + MonChamp..Libelle)
		FIN
	FIN
FIN
