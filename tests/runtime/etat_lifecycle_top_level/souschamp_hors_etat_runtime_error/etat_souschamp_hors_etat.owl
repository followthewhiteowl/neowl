// Ressource Etat pure utilisee par test_souschamp_hors_etat.owl.
//
// L'Etat declare un sous-champ LIB_X. Le script test voisin tentera
// d'acceder a LIB_X..Libelle HORS du contexte Etat (au top-level
// script) : doit emettre une erreur runtime "variable inconnue".

ETAT_X est un Etat
	PROPRIETES
		Format = formatA4
	FIN

	corps est un Corps
		PROPRIETES
			Hauteur = 40
		FIN

		LIB_X est un Champ Libelle
			PROPRIETES
				Libelle      = "test"
				X            = 10
				Y            = 10
				Largeur      = 50
				Hauteur      = 10
				PoliceNom    = iPoliceLiberationSans
				PoliceTaille = 10
			FIN
		FIN
	FIN
FIN
