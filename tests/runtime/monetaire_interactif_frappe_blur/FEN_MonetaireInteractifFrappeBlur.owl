// Fenêtre voisine — deux champs Saisie : SAI_Montant (typSaisieMonétaire,
// format hérité du projet) et SAI_Autre (cible de DonneFocus pour déclencher
// un focus-out réel sur SAI_Montant).

FEN_MonetaireInteractifFrappeBlur est une Fenêtre
	PROPRIETES
		Titre       = "Monétaire interactif - frappe+blur"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 160
	FIN

	SAI_Montant est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 10
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieMonétaire
			Valeur     = ""
		FIN
	FIN

	SAI_Autre est un Champ Saisie
		PROPRIETES
			X       = 10
			Y       = 50
			Largeur = 180
			Hauteur = 24
			Valeur  = ""
		FIN
	FIN
FIN
