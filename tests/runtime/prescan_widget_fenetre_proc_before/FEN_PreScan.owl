// Fenêtre voisine — ressource pour test_prescan_widget_fenetre_proc_before.owl.
// Une PROCEDURE declaree AVANT un widget peut referencier ce widget (proprietes,
// sous-champs) sans erreur. Le prescan collecte tous les widgets avant de
// compiler le code de la fenetre.

FEN_PreScan est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 300
		Hauteur     = 200
	FIN

	// Code top-level declare AVANT le widget LIB_X
	// Reference forward : LIB_X pas encore declare a cette ligne-source
	LIB_X..PoliceNom = "Courier New"
	LIB_X..Visible   = Vrai
	LIB_X..Libellé   = "Configure par proc avant"

	LIB_X est un Champ Libellé
		PROPRIETES
			X       = 10
			Y       = 10
			Libellé = "initial"
		FIN
	FIN

	PROCEDURE RemonteEtat()
		callback_etat(LIB_X..PoliceNom, LIB_X..Visible, LIB_X..Libellé)
	FIN
FIN
