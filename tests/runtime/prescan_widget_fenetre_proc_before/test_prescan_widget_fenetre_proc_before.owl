// Test : prescan widgets - procedure AVANT widget dans Fenetre.
// Une PROCEDURE declaree AVANT un widget peut referencier ce widget sans erreur.
//
// Pattern : la fenêtre voisine FEN_PreScan.owl porte la déclaration.

TestModeHeadless(Vrai)

policeObs est une chaîne = ""
visibleObs est un booléen = Faux
libelleObs est une chaîne = ""

PROCEDURE callback_etat(p est une chaîne, v est un booléen, l est une chaîne)
	policeObs  = p
	visibleObs = v
	libelleObs = l
FIN

Ouvre(FEN_PreScan)
RemonteEtat()

dbgVérifieEgalité(policeObs, "Courier New", "PoliceNom modifiee par proc avant")
dbgVérifieVrai(visibleObs, "Visible active par proc avant")
dbgVérifieEgalité(libelleObs, "Configure par proc avant", "Libelle modifie par proc avant")

dbgBilanTest()
