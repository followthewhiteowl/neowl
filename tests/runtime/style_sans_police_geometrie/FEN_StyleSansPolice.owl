// Fenêtre voisine — paires « nu » / « stylé » du même champ, à la même
// police. Le champ stylé ne reçoit qu'une couleur de fond : il ne dit rien
// de la police, donc il doit occuper exactement la même place que son
// jumeau nu.
//
// Aucune Hauteur n'est déclarée : la disposition verticale laisse chaque
// champ prendre sa taille naturelle, celle que la police lui impose. C'est
// précisément ce que la mesure doit voir bouger si une taille de police est
// émise par erreur.

FEN_StyleSansPolice est une Fenêtre
	PROPRIETES
		Titre       = "Un style sans police ne change pas la taille du texte"
		Largeur     = 500
		Hauteur     = 900
		Disposition = dispVerticale
		Espacement  = 4
	FIN

	LIB_Nu est un Champ Libellé
		PROPRIETES
			Libellé    = "Texte de mesure"
			Alignement = alignDébut
		FIN
	FIN

	LIB_Style est un Champ Libellé
		PROPRIETES
			Libellé                            = "Texte de mesure"
			Alignement                         = alignDébut
			Style..CadreExtérieur..CouleurFond = RVB(0, 200, 0)
		FIN
	FIN

	SAI_Nu est un Champ Saisie
		PROPRIETES
			Valeur = "Texte de mesure"
		FIN
	FIN

	SAI_Style est un Champ Saisie
		PROPRIETES
			Valeur                             = "Texte de mesure"
			Style..CadreExtérieur..CouleurFond = RVB(0, 200, 0)
		FIN
	FIN

	SEL_Nu est un Champ Sélecteur
		PROPRIETES
			Options = ["a", "b", "c", "d", "e", "f"]
		FIN
	FIN

	SEL_Style est un Champ Sélecteur
		PROPRIETES
			Options                            = ["a", "b", "c", "d", "e", "f"]
			Style..CadreExtérieur..CouleurFond = RVB(0, 200, 0)
		FIN
	FIN

	INT_Nu est un Champ Interrupteur
		PROPRIETES
			Options = ["a", "b", "c", "d", "e", "f"]
		FIN
	FIN

	INT_Style est un Champ Interrupteur
		PROPRIETES
			Options                            = ["a", "b", "c", "d", "e", "f"]
			Style..CadreExtérieur..CouleurFond = RVB(0, 200, 0)
		FIN
	FIN

	// --- Cas nominal : un style qui PARLE de police doit continuer à
	// l'imposer, exactement comme la propriété plate équivalente.
	LIB_PolicePlate est un Champ Libellé
		PROPRIETES
			Libellé      = "Texte de mesure"
			Alignement   = alignDébut
			PoliceTaille = 20
		FIN
	FIN

	LIB_PoliceStyle est un Champ Libellé
		PROPRIETES
			Libellé                        = "Texte de mesure"
			Alignement                     = alignDébut
			Style..Libellé..Police..Taille = 20
		FIN
	FIN

	// --- Une graisse posée à plat ne doit pas être effacée par un style
	// qui ne parle pas de police.
	LIB_Gras est un Champ Libellé
		PROPRIETES
			Libellé    = "Texte de mesure"
			Alignement = alignDébut
			PoliceGras = Vrai
		FIN
	FIN

	LIB_GrasStyle est un Champ Libellé
		PROPRIETES
			Libellé                            = "Texte de mesure"
			Alignement                         = alignDébut
			PoliceGras                         = Vrai
			Style..CadreExtérieur..CouleurFond = RVB(0, 200, 0)
		FIN
	FIN

	// --- Réceptacle : reçoit à l'exécution un style dont la police est une
	// instance Police complète.
	LIB_PoliceInstance est un Champ Libellé
		PROPRIETES
			Libellé    = "Texte de mesure"
			Alignement = alignDébut
		FIN
	FIN

	LIB_PoliceOnze est un Champ Libellé
		PROPRIETES
			Libellé      = "Texte de mesure"
			Alignement   = alignDébut
			PoliceTaille = 11
		FIN
	FIN
FIN
