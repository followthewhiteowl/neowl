// Fenêtre de test : une OptionMenu peut porter une icône via la propriété
// Image, sous les mêmes formes que le Bouton :
//   - référence du catalogue d'icônes intégré ("icones.<nom>") ;
//   - chemin de fichier disque.
// Les entrées volontairement invalides (catalogue inconnu, fichier absent)
// vérifient le contrat défensif : la construction du menu reste robuste et
// ne lève aucune erreur d'exécution — l'icône manquante est simplement
// absente, jamais un plantage silencieux du programme.

FEN_MenuIcone est une Fenêtre
	PROPRIETES
		Titre         = "Menu avec icônes"
		Largeur       = 480
		Hauteur       = 320
		Disposition   = dispLibre
		MenuPrincipal = MNU_Icone
	FIN

	MNU_Icone est un MenuPrincipal
		PROPRIETES
			Style..SousMenu..CouleurFond    = Blanc
			Style..SousMenu..CouleurBordure = GrisClair
			Style..SousMenu..Arrondi        = 8
			Style..SousMenu..Epaisseur      = 1
			Style..OptionMenu..CouleurFond  = Blanc
			Style..OptionMenu..Couleur      = Noir
		FIN

		SM_Fichier est un SousMenu
			PROPRIETES
				Libellé = "Fichier"
			FIN

			OPT_Catalogue est une OptionMenu
				PROPRIETES
					Libellé = "Enregistrer"
					Image   = "icones.save"
				FIN
				PROCEDURE surSélection()
				FIN
			FIN

			OPT_CatalogueInconnu est une OptionMenu
				PROPRIETES
					Libellé = "Catalogue inconnu"
					Image   = "icones.zzz_option_inexistante"
				FIN
				PROCEDURE surSélection()
				FIN
			FIN

			OPT_FichierAbsent est une OptionMenu
				PROPRIETES
					Libellé = "Fichier absent"
					Image   = "chemin/qui/nexiste/pas/icone.png"
				FIN
				PROCEDURE surSélection()
				FIN
			FIN

			OPT_SansIcone est une OptionMenu
				PROPRIETES
					Libellé = "Sans icône"
				FIN
				PROCEDURE surSélection()
				FIN
			FIN
		FIN
	FIN
FIN
