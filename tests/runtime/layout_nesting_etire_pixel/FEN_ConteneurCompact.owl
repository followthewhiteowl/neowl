//  — témoin de discrimination : structure identique à
// FEN_ConteneurEtire (même enfant coloré Étire=Vrai à l'intérieur), mais
// GRD_Compact n'a PAS Étire=Vrai. Le ressort terminal doit
// s'appliquer : GRD_Compact reste compact en haut (Hauteur naturelle),
// le bas de la fenêtre reste à la CouleurFond pure (le fond du Conteneur
// n'atteint pas le bas, contrairement au cas Étire=Vrai).
FEN_ConteneurCompact est une Fenêtre
	PROPRIETES
		Titre       = "Conteneur sans Étire reste compact"
		Largeur     = 300
		Hauteur     = 400
		Disposition = dispVerticale
		Espacement  = 8
		CouleurFond = RVB(5, 5, 5)
	FIN

	LIB_Haut est un Champ Libellé
		PROPRIETES
			Largeur                            = 200
			Hauteur                            = 30
			Libellé                            = "Haut"
			Style..CadreExtérieur..CouleurFond = RVB(0, 0, 200)
		FIN
	FIN

	GRD_Compact est un Champ Conteneur
		PROPRIETES
			Disposition = dispVerticale
			Largeur     = 200
			Hauteur     = 40
		FIN

		LIB_Remplissage est un Champ Libellé
			PROPRIETES
				Libellé                            = "Remplissage"
				Hauteur                            = 30
				Style..CadreExtérieur..CouleurFond = RVB(0, 200, 0)
			FIN
		FIN
	FIN
FIN
