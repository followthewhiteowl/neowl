//  — sonde pixel : un Conteneur Étire=Vrai dans une Fenêtre
// dispVerticale doit occuper l'espace principal disponible (le ressort
// terminal de  ne s'applique PAS quand un enfant Étire=Vrai est
// présent). LIB_Haut sert de repère fixe en haut ; GRD_Etire porte un
// enfant coloré (lui-même Étire=Vrai) qui doit atteindre le bas de la
// fenêtre si — et seulement si — le Conteneur parent se stretche bien.
FEN_ConteneurEtire est une Fenêtre
	PROPRIETES
		Titre       = "Conteneur Étire=Vrai remplit l'axe principal"
		Largeur     = 300
		Hauteur     = 400
		Disposition = dispVerticale
		Espacement  = 8
		CouleurFond = RVB(5, 5, 5)
	FIN

	LIB_Haut est un Champ Libellé
		PROPRIETES
			Largeur                            = 200
			Hauteur                            = 30
			Libellé                            = "Haut"
			Style..CadreExtérieur..CouleurFond = RVB(0, 0, 200)
		FIN
	FIN

	GRD_Etire est un Champ Conteneur
		PROPRIETES
			Disposition = dispVerticale
			Étire       = Vrai
		FIN

		LIB_Remplissage est un Champ Libellé
			PROPRIETES
				Libellé                            = "Remplissage"
				Étire                              = Vrai
				Style..CadreExtérieur..CouleurFond = RVB(0, 200, 0)
			FIN
		FIN
	FIN
FIN
