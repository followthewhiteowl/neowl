// Ressource — une Hauteur figée doit primer sur Étire : le champ reste à sa
// taille déclarée sur l'axe principal, il ne consomme pas l'espace restant.
FEN_PrincFigee est une Fenêtre
	PROPRIETES
		Titre       = "Hauteur figée prime"
		Largeur     = 400
		Hauteur     = 300
		Disposition = dispVerticale
	FIN

	EPF_Saisie est un Champ Saisie
		PROPRIETES
			Hauteur = 40
			Étire   = Vrai
		FIN
	FIN
FIN
