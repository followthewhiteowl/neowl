// Ressource — pile verticale, un seul champ de saisie qui étire l'axe PRINCIPAL.
// Seul enfant de la fenêtre : il doit occuper toute la hauteur cliente déclarée.
FEN_PrincV est une Fenêtre
	PROPRIETES
		Titre       = "Étire principal — Saisie"
		Largeur     = 400
		Hauteur     = 300
		Disposition = dispVerticale
	FIN

	EPV_Saisie est un Champ Saisie
		PROPRIETES
			Étire = Vrai
		FIN
	FIN
FIN
