// Ressource — pile verticale avec un champ naturel (témoin) et un champ étiré.
// Le témoin donne son sens à la valeur : sans lui, une pile qui grandirait tout
// le monde passerait aussi.
FEN_PrincTemoin est une Fenêtre
	PROPRIETES
		Titre       = "Étire vs témoin"
		Largeur     = 400
		Hauteur     = 300
		Disposition = dispVerticale
	FIN

	EPT_Nature est un Champ Saisie
		PROPRIETES
			Visible = Vrai
		FIN
	FIN

	EPT_Etire est un Champ Saisie
		PROPRIETES
			Étire = Vrai
		FIN
	FIN
FIN
