// Ressource — pile HORIZONTALE : l'axe principal est la largeur. Étire y grandit
// déjà la largeur ; on verrouille la non-régression et l'absence de débordement
// sur l'axe transverse (hauteur), qui doit rester naturelle.
FEN_PrincHoriz est une Fenêtre
	PROPRIETES
		Titre       = "Étire principal — horizontal"
		Largeur     = 400
		Hauteur     = 100
		Disposition = dispHorizontale
	FIN

	EPH_Nature est un Champ Bouton
		PROPRIETES
			Libellé = "Nat"
		FIN
	FIN

	EPH_Etire est un Champ Bouton
		PROPRIETES
			Libellé = "Grand"
			Étire   = Vrai
		FIN
	FIN
FIN
