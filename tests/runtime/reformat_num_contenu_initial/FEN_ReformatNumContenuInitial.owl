// Fenêtre voisine — champ typSaisieNum avec un ContenuInitial à 3 décimales
// (pas de Valeur posée) : sert à prouver que le format effectif (hérité du
// projet) est appliqué DÈS L'OUVERTURE, pas seulement au SET programmatique.

FEN_ReformatNumContenuInitial est une Fenêtre
	PROPRIETES
		Titre       = "Reformat num ContenuInitial"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 120
	FIN

	SAI_Num est un Champ Saisie
		PROPRIETES
			X              = 10
			Y              = 10
			Largeur        = 180
			Hauteur        = 24
			TypeSaisie     = typSaisieNum
			ContenuInitial = "1234567.891"
		FIN
	FIN
FIN
