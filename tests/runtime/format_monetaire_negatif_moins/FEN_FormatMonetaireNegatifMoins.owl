// Fenêtre voisine — ressource pour test_format_monetaire_negatif_moins.owl.
// Le champ pose un FormatMonétaire inline avec FormatNégatif = fmnMoins : un
// montant NÉGATIF doit être affiché avec un signe '-' en tête
// (ex. "-1 234,50 €").

FEN_FormatMonetaireNegatifMoins est une Fenêtre
	PROPRIETES
		Titre       = "FormatMonétaire négatif moins"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 120
	FIN

	SAI_Montant est un Champ Saisie
		PROPRIETES
			X               = 10
			Y               = 10
			Largeur         = 180
			Hauteur         = 24
			TypeSaisie      = typSaisieMonétaire
			FormatMonétaire = {Symbole = "€", SéparateurMilliers = " ", SéparateurDécimal = ",", ChiffresAprèsVirgule = 2, FormatNégatif = fmnMoins}
			Valeur          = ""
		FIN
	FIN
FIN
