//  — type composite styleColonne (Lot 1 : fondations backend).
// Vérifie que styleColonne existe avec ses 6 sous-éléments (override par
// colonne, sous-ensemble de styleTable, SANS CadreExtérieur — propre à la
// table entière) : TitreColonne, LibelléLignes, LignesPaires, LignesImpaires,
// LigneSélectionnée, LigneSurvolée.
//
// ROUGE attendu : le type styleColonne n'existe pas encore (compile-fail :
// type styleColonne inconnu).

Trace("=== styleColonne : type composite 6 sous-éléments (sans CadreExtérieur) ===")

STY_Colonne est un styleColonne
STY_Colonne..TitreColonne..Couleur          = Rouge
STY_Colonne..LibelléLignes..Couleur         = Bleu
STY_Colonne..LignesPaires..CouleurFond      = GrisClair
STY_Colonne..LignesImpaires..CouleurFond    = Blanc
STY_Colonne..LigneSélectionnée..CouleurFond = VertFoncé
STY_Colonne..LigneSurvolée..CouleurFond     = JauneClair

dbgVérifieEgalité(STY_Colonne..TitreColonne..Couleur, Rouge, "styleColonne : TitreColonne..Couleur posée")
dbgVérifieEgalité(STY_Colonne..LibelléLignes..Couleur, Bleu, "styleColonne : LibelléLignes..Couleur posée")
dbgVérifieEgalité(STY_Colonne..LignesPaires..CouleurFond, GrisClair, "styleColonne : LignesPaires..CouleurFond posée")
dbgVérifieEgalité(STY_Colonne..LignesImpaires..CouleurFond, Blanc, "styleColonne : LignesImpaires..CouleurFond posée")
dbgVérifieEgalité(STY_Colonne..LigneSélectionnée..CouleurFond, VertFoncé, "styleColonne : LigneSélectionnée..CouleurFond posée")
dbgVérifieEgalité(STY_Colonne..LigneSurvolée..CouleurFond, JauneClair, "styleColonne : LigneSurvolée..CouleurFond posée")

dbgBilanTest()
