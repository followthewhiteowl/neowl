// Fenêtre voisine — ressource pour test_ComboFerme.owl.
// Plusieurs Combos pour couvrir les différents scenarios (simple, vide,
// déjà fermée, multi-appels, nom accentué).

FEN_ComboFerme est une Fenêtre
	PROPRIETES
		Titre       = "Test ComboFerme"
		Largeur     = 600
		Hauteur     = 400
		Disposition = dispLibre
	FIN

	CMB_Simple est un Champ Combo
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 200
			Hauteur = 30
		FIN
	FIN

	CMB_Vide est un Champ Combo
		PROPRIETES
			X       = 10
			Y       = 90
			Largeur = 200
			Hauteur = 30
		FIN
	FIN

	CMB_Multi est un Champ Combo
		PROPRIETES
			X       = 10
			Y       = 130
			Largeur = 200
			Hauteur = 30
		FIN
	FIN

	CMB_Déjà est un Champ Combo
		PROPRIETES
			X       = 10
			Y       = 170
			Largeur = 200
			Hauteur = 30
		FIN
	FIN

	CMB_Météo est un Champ Combo
		PROPRIETES
			X       = 10
			Y       = 210
			Largeur = 200
			Hauteur = 30
		FIN
	FIN
FIN
