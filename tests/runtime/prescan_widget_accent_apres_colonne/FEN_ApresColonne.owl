// Fenêtre voisine — ressource pour test_prescan_widget_accent_apres_colonne.owl.
//
// Une Table AVEC colonne, suivie d'un widget frère au nom accentué.
// Le bloc colonne doit rester neutre pour le scope des frères suivants :
// le frère accentué reste résoluble par sa forme sans accent (invariant 2).

FEN_ApresColonne est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 300
	FIN

	// Table AVEC colonne (déclenche le bloc colonne).
	TAB_Premiere est un Champ Table
		PROPRIETES
			X = 10
			Y = 10
		FIN

		COL_A est une Colonne
			PROPRIETES
				Libellé = "A"
			FIN
		FIN
	FIN

	// Frère SUIVANT à nom accentué : accédé sans accent côté test.
	TAB_Résultats est un Champ Table
		PROPRIETES
			X = 10
			Y = 120
		FIN

		COL_B est une Colonne
			PROPRIETES
				Libellé = "B"
			FIN
		FIN
	FIN
FIN
