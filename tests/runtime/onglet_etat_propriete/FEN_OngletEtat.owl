// Fenêtre voisine — ressource pour test_onglet_etat_propriete.owl.
//
// Verrouille la propriété d'état unifié `Etat`
// (Actif / AffichageSeulement / Grisé / Invisible) sur un Champ Onglet, au
// même titre que sur une Saisie ou un Bouton. Un Onglet est un conteneur :
// Grisé le désactive, Invisible le masque, AffichageSeulement le rend
// non-interactif en conservant une couleur normale.

FEN_OngletEtat est une Fenêtre
	PROPRIETES
		Titre       = "Onglet état"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 300
	FIN

	ONG_Actif est un Champ Onglet
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 180
			Hauteur = 120
			Etat    = Actif
		FIN

		VOL_A1 est un Volet
			PROPRIETES
				Libellé = "A"
			FIN
		FIN
	FIN

	ONG_Grise est un Champ Onglet
		PROPRIETES
			X       = 200
			Y       = 10
			Largeur = 180
			Hauteur = 120
			Etat    = Grisé
		FIN

		VOL_B1 est un Volet
			PROPRIETES
				Libellé = "B"
			FIN
		FIN
	FIN

	ONG_AffSeul est un Champ Onglet
		PROPRIETES
			X       = 10
			Y       = 150
			Largeur = 180
			Hauteur = 120
			Etat    = AffichageSeulement
		FIN

		VOL_C1 est un Volet
			PROPRIETES
				Libellé = "C"
			FIN
		FIN
	FIN

	ONG_Invis est un Champ Onglet
		PROPRIETES
			X       = 200
			Y       = 150
			Largeur = 180
			Hauteur = 120
			Etat    = Invisible
		FIN

		VOL_D1 est un Volet
			PROPRIETES
				Libellé = "D"
			FIN
		FIN
	FIN
FIN
