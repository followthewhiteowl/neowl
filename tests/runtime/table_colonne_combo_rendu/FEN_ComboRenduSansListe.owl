// Fenêtre voisine — ressource partagée de
// tests\runtime\table_colonne_combo_rendu\table_colonne_combo_rendu_sans_liste.
//
// Une colonne combo SANS aucune liste déclarée (ni `Contenu` à la
// conception, ni surcharge par cellule). Le déroulant permanent doit
// s'afficher vide, pas planter ni inventer des options.

FEN_ComboRenduSansListe est une Fenêtre
	PROPRIETES
		Titre   = "Rendu sans liste"
		Largeur = 300
		Hauteur = 200
	FIN

	TABLE_Rendu est un Champ Table
		PROPRIETES
			Étire = Vrai
		FIN

		COL_Statut est une Colonne
			PROPRIETES
				Libellé = "Statut"
				Type    = colTypeCombo
				Largeur = 160
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		TableAjouteLigne(TABLE_Rendu, "Actif")
	FIN
FIN
