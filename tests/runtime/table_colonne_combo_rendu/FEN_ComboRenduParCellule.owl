// Fenêtre voisine — ressource partagée de
// tests\runtime\table_colonne_combo_rendu\table_colonne_combo_rendu_listes_par_cellule.
//
// Une colonne combo avec une liste déclarée (Paris/Lyon/Marseille). La
// ligne 2 reçoit une surcharge par cellule posée après l'ouverture (dans le
// script de test voisin), de quoi exercer des listes DIFFÉRENTES entre deux
// cellules de la même colonne.

FEN_ComboRenduParCellule est une Fenêtre
	PROPRIETES
		Titre   = "Rendu par cellule"
		Largeur = 300
		Hauteur = 200
	FIN

	TABLE_Rendu est un Champ Table
		PROPRIETES
			Étire = Vrai
		FIN

		COL_Ville est une Colonne
			PROPRIETES
				Libellé = "Ville"
				Type    = colTypeCombo
				Contenu = `Paris
Lyon
Marseille`
				Largeur = 160
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		TableAjouteLigne(TABLE_Rendu, "Paris")
		TableAjouteLigne(TABLE_Rendu, "Bruxelles")
	FIN
FIN
