// Fenêtre voisine — ressource partagée de
// tests\runtime\table_colonne_combo_rendu\table_colonne_combo_rendu_liste.
//
// Une colonne combo avec une liste déclarée (Actif/Inactif) et deux lignes :
// une valeur dans la liste, une valeur hors liste. De quoi exercer le mode
// strict du rendu runtime (pas d'injection de valeur hors-liste).

FEN_ComboRenduListe est une Fenêtre
	PROPRIETES
		Titre   = "Rendu"
		Largeur = 300
		Hauteur = 200
	FIN

	TABLE_Rendu est un Champ Table
		PROPRIETES
			Étire = Vrai
		FIN

		COL_Statut est une Colonne
			PROPRIETES
				Libellé = "Statut"
				Type    = colTypeCombo
				Contenu = `Actif
Inactif`
				Largeur = 160
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		TableAjouteLigne(TABLE_Rendu, "Actif")
		TableAjouteLigne(TABLE_Rendu, "Supprimé")
	FIN
FIN
