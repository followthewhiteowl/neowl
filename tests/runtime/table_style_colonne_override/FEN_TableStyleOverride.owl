// Fenêtre voisine — ressource pour test_table_style_colonne_override.owl.
// (pattern split canon strict — cf.  / .)
//
// Le point neuf du ticket  (archi "style sur sous-élément") : le
// bloc Colonne accepte une prop Style de type styleColonne exactement comme
// la Table accepte Style de type styleTable, et la colonne peut surcharger
// localement un sous-élément du style hérité de la table.

FEN_TableStyleOverride est une Fenêtre
	PROPRIETES
		Titre       = "Test Table+Colonne stylées"
		Disposition = dispLibre
	FIN

	TAB_Clients est un Champ Table
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 550
			Hauteur = 350
		FIN

		COL_Nom est une Colonne
			PROPRIETES
				Libellé = "Nom"
				Type    = colTypeTexte
				Largeur = 150
			FIN
		FIN

		COL_Prenom est une Colonne
			PROPRIETES
				Libellé                       = "Prénom"
				Type                          = colTypeTexte
				Largeur                       = 150
				Style..LibelléLignes..Couleur = Rouge
			FIN
		FIN
	FIN
FIN
