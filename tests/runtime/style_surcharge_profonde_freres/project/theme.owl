// Fichier de thème désigné par Projet..Thème. Le styleBouton `bp` porte un
// CadreExtérieur avec PLUSIEURS sous-objets frères (Cadre, Dégradé, Ombre) ET
// un scalaire (CouleurFond), pour vérifier qu'une surcharge profonde posée
// sur UN SEUL frère ne détruit pas les autres.

ThèmeSurchargeProfonde est un Thème
	bp est un styleBouton = {
		CadreExtérieur = {
			CouleurFond = Blanc
			Cadre       = {
				Arrondi = 20
			}
			Dégradé = {
				Type         = dégradéLinéaire
				CouleurDébut = RVB(126, 103, 187)
				CouleurFin   = RVB(94, 72, 150)
			}
			Ombre = {
				Couleur   = Noir
				DécalageX = 0
				DécalageY = 6
				Flou      = 16
				Étendue   = 2
			}
		}
	}
FIN
