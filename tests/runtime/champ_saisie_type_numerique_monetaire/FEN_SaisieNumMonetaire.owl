// Fenêtre voisine — ressource pour test_saisie_type_numerique_monetaire.owl.
//
// Deux champs de saisie : l'un typé numérique (typSaisieNum), l'autre
// monétaire (typSaisieMonétaire) — Lot A du chantier types de saisie
//. Sert à vérifier le round-trip get/set de TypeSaisie sur
// un vrai widget Qt (pas de repli vers typSaisieTexte).

FEN_SaisieNumMonetaire est une Fenêtre
	PROPRIETES
		Titre       = "Saisie numérique / monétaire"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 160
	FIN

	SAI_Num est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 10
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieNum
			Valeur     = ""
		FIN
	FIN

	SAI_Monetaire est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 50
			Largeur    = 180
			Hauteur    = 24
			TypeSaisie = typSaisieMonétaire
			Valeur     = ""
		FIN
	FIN
FIN
