// Designated theme. `stAmbiance` carries the same name as an ordinary global
// declared in a neighbour file: the style must never escape to that bare name.
ThemeStyleHomonym is a Theme
	stAmbiance is a styleInput = {
		InputZone = { BackgroundColor = RGB(200, 10, 10) }
	}
	stNoHomonym is a styleInput = {
		InputZone = { BackgroundColor = RGB(20, 180, 20) }
	}
END
