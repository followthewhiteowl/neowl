Trace("=== RETOURS MULTIPLES ===")

PROCEDURE Coords()
	RENVOYER (10, 20)
FIN

PROCEDURE MinMax(nA est un entier, nB est un entier)
	SI nA < nB ALORS
		RENVOYER (nA, nB)
	SINON
		RENVOYER (nB, nA)
	FIN
FIN

PROCEDURE Triple()
	RENVOYER (1, 2, 3)
FIN

// --- Test 1: Retour multiple basique ---
x est un entier = 0
y est un entier = 0
(x, y) = Coords()
dbgVérifieEgalité(x, 10, "Multi-return: x = 10")
dbgVérifieEgalité(y, 20, "Multi-return: y = 20")

// --- Test 2: Retour conditionnel ---
nMin est un entier = 0
nMax est un entier = 0
(nMin, nMax) = MinMax(42, 7)
dbgVérifieEgalité(nMin, 7, "MinMax(42,7): min = 7")
dbgVérifieEgalité(nMax, 42, "MinMax(42,7): max = 42")

// --- Test 3: Trois valeurs ---
n1 est un entier = 0
n2 est un entier = 0
n3 est un entier = 0
(n1, n2, n3) = Triple()
dbgVérifieEgalité(n1, 1, "Triple: n1 = 1")
dbgVérifieEgalité(n2, 2, "Triple: n2 = 2")
dbgVérifieEgalité(n3, 3, "Triple: n3 = 3")

// --- Test 4: Retour comme array normal ---
r est un tableau de entiers
r = Coords()
dbgVérifieEgalité(r[1], 10, "Retour comme array: r[1] = 10")
dbgVérifieEgalité(r[2], 20, "Retour comme array: r[2] = 20")

// --- Test 5: Retour simple (pas multiple) reste inchange ---
PROCEDURE Simple()
	RENVOYER 42
FIN

nSimple est un entier = Simple()
dbgVérifieEgalité(nSimple, 42, "Retour simple inchange")
