// test_chaine_arity_formes.owl
// Verrouille les formes d'arite discretes des natives chaine
// migrees depuis une signature variadique masquee : chaque forme valide
// continue de compiler ET de s'executer correctement.

PROCEDURE PUBLIQUE test_droite_formes()
	s est une chaîne = "   abcdef"
	// 1 arg : trim des espaces a gauche
	dbgVérifieEgalité(Droite(s), "abcdef", "Droite 1 arg : trim gauche")
	// 2 args : n derniers caracteres
	dbgVérifieEgalité(Droite("abcdef", 2), "ef", "Droite 2 args : n derniers")
FIN

PROCEDURE PUBLIQUE test_complete_formes()
	// 2 args : pad espaces a droite
	dbgVérifieEgalité(Complète("ab", 4), "ab  ", "Complete 2 args")
	// 3 args : caractere de remplissage
	dbgVérifieEgalité(Complète("ab", 4, "*"), "ab**", "Complete 3 args")
	// 4 args : sens = pad a gauche
	dbgVérifieEgalité(Complète("ab", 4, "*", 1), "**ab", "Complete 4 args (gauche)")
FIN

PROCEDURE PUBLIQUE test_comparechaine_formes()
	// 2 args : comparaison stricte
	dbgVérifieEgalité(ChaîneCompare("abc", "abc"), 0, "ChaineCompare 2 args egal")
	// 3 args : options
	dbgVérifieEgalité(ChaîneCompare("ABC", "abc", ccSansCasse), 0, "ChaineCompare 3 args sans casse")
FIN

PROCEDURE PUBLIQUE test_extraitchaineentre_formes()
	s est une chaîne = "[un][deux][trois]"
	// 4 args : sepDebut + sepFin distincts
	dbgVérifieEgalité(ExtraitChaîneEntre(s, 2, "[", "]"), "deux", "ExtraitChaineEntre 4 args")
FIN

PROCEDURE PUBLIQUE test_occurrence_formes()
	// 2 args : compte des occurrences d'une sous-chaine
	dbgVérifieEgalité(Occurrence("abcabcabc", "abc"), 3, "Occurrence 2 args")
FIN

PROCEDURE PUBLIQUE test_tronque_formes()
	// 1 arg : troncation numerique vers zero
	dbgVérifieEgalité(Tronque(3.7), 3, "Tronque 1 arg numerique")
	// 2 args : chaine, n caracteres a conserver
	dbgVérifieEgalité(Tronque("abcdef", 3), "abc", "Tronque 2 args chaine")
FIN
