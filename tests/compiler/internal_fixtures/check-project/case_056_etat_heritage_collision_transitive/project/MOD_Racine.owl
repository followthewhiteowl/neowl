// Racine de la chaine de modeles. Declare ITER_Partage, du meme nom que le bloc
// Iteration de l'etat feuille -> source de la collision transitive.
MOD_Racine est un ModèleÉtat
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN
	Corps est un Corps
		PROPRIETES
			Hauteur = 40
		FIN
	FIN
	ITER_Partage est une Itération
		Trace("partage-racine")
	FIN
FIN
