// Modele voisin referencé par ETAT_Propre. Son bloc Iteration porte un nom
// distinct de celui de l'etat heritier -> aucune collision.
MOD_Propre est un ModèleÉtat
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN
	Corps est un Corps
		PROPRIETES
			Hauteur = 40
		FIN
	FIN
	ITER_Entete est une Itération
		Trace("entete-modele")
	FIN
FIN
