// Garde anti-faux-positif : un etat qui herite proprement d'un modele voisin,
// sans collision de bloc Iteration (noms distincts). Doit rester sans erreur au
// check editeur, avant comme apres l'activation de la validation d'heritage.
ETAT_Propre est un État
	Hérite de MOD_Propre
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN
	Corps est un Corps
		PROPRIETES
			Hauteur = 40
		FIN
	FIN
	ITER_Lignes est une Itération
		Trace("lignes-etat")
	FIN
FIN
