// Garde de non-regression : une variable declaree sous la bascule LOCAL
// reste confinee au flux de demarrage du projet — ni globale du projet,
// ni visible d'un compagnon. Le fix sur les globales de projet (bascule
// GLOBAL par defaut) ne doit PAS fuir vers LOCAL.
APP est un Projet
	PROPRIETES
		Langues = [langueFrançais]
	FIN
	LOCAL
	sTemp est une chaîne = "confine"
	GLOBAL
	ConsoleEcrit("PROJET_INIT")
FIN
