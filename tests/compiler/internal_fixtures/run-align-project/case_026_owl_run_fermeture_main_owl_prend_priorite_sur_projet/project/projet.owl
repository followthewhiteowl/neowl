//  : quand le bloc Projet definit a la fois Fermeture() (FR canon) et
// Closing() (alias EN), le teardown appelle Fermeture() en priorite. Verrouille
// la resolution bilingue du teardown projet (call_project_teardown). Les deux
// sont des events projet reconnus, autorises DANS le bloc.
APP est un Projet
	PROPRIETES
		Langues = [langueFrançais]
	FIN
	ConsoleEcrit("main_ok|")
	PROCEDURE Fermeture()
		ConsoleEcrit("fermeture_prioritaire")
	FIN
	PROCEDURE Closing()
		ConsoleEcrit("closing_NE_DOIT_PAS")
	FIN
FIN
