// Etat compagnon — declare une structure au top-level du bloc,
// referencable en position de type depuis l'exterieur (ETAT_Conf.stInfo).
ETAT_Conf est un Etat
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	stInfo est une Structure
		total est un entier
	FIN

	corps est un Corps
	FIN
FIN
