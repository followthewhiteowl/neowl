// Le champ Thème du catalogue Projet devient navigable au runtime vers
// l'instance de thème désignée : MonApp..Thème.<style> doit accéder aux
// mêmes valeurs que le namespace `theme.<style>` (sucre équivalent, même
// résolution). Le corps s'exécute en dernier (après les compagnons, dont
// theme.owl), donc l'instance est déjà liée au moment de ce test.

MonAppNav est un Projet
	PROPRIETES
		Langues = [langueFrançais]
		Thème   = ThèmeNav
	FIN

	nPrimaireViaMonApp est un entier = MonAppNav..Thème.boutonPrimaire..CadreExtérieur..CouleurFond
	nDangerViaMonApp est un entier = MonAppNav..Thème.boutonDanger..CadreExtérieur..CouleurFond
	nPrimaireViaSucre est un entier = theme.boutonPrimaire..CadreExtérieur..CouleurFond
	nDangerViaSucre est un entier = theme.boutonDanger..CadreExtérieur..CouleurFond

	SI nPrimaireViaMonApp = Bleu ET nDangerViaMonApp = Rouge ET nPrimaireViaMonApp = nPrimaireViaSucre ET nDangerViaMonApp = nDangerViaSucre ALORS
		ConsoleEcrit("OK")
	SINON
		ConsoleEcrit("KO")
	FIN
FIN
