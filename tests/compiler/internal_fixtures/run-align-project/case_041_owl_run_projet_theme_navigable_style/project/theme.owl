// Instance de thème désignée par projet.owl. Deux styles distincts pour
// prouver qu'une navigation depuis MonApp..Thème atteint le BON style (pas
// toujours le dernier déclaré).
ThèmeNav est un Thème
	boutonPrimaire est un styleBouton = {
		CadreExtérieur = { CouleurFond = Bleu }
	}

	boutonDanger est un styleBouton = {
		CadreExtérieur = { CouleurFond = Rouge }
	}
FIN
