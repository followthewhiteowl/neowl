// Qualification d'une structure de collection en POSITION DE TYPE : le
// type declare dans COL_Lib doit etre referencable en "COL_Lib.stPoint"
// depuis un autre fichier, au meme titre qu'en position d'expression.
COL_Lib est une CollectionDeProcédures
	stPoint est une Structure
		x est un entier
		y est un entier
	FIN
FIN
