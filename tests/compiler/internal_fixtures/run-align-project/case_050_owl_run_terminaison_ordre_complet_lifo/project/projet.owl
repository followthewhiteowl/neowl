// Ordre complet a la fermeture -- Fermeture() (teardown du
// projet) tourne D'ABORD, PUIS les Terminaison() des compagnons en ordre
// INVERSE de leur init (init lexicographique aaa_comp, bbb_comp -> teardown
// bbb_comp, aaa_comp).
APP est un Projet
	PROPRIETES
		Langues = [langueFrançais]
	FIN
	ConsoleEcrit("programme|")
	PROCEDURE Fermeture()
		ConsoleEcrit("fermeture|")
	FIN
FIN
