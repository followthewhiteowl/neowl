//  : la PROCEDURE Fermeture() definie DANS le bloc Projet est l'event
// de teardown, auto-appele en fin de run PROJET (apres le corps du bloc, qui
// est le programme).
APP est un Projet
	PROPRIETES
		Langues = [langueFrançais]
	FIN
	ConsoleEcrit("main_ok|")
	PROCEDURE Fermeture()
		ConsoleEcrit("projet_fermeture")
	FIN
FIN
