// Fenetre compagnon — declare une enumeration au top-level du bloc.
// L'enumeration doit etre referencable depuis l'exterieur par le nom
// qualifie du conteneur, en POSITION DE TYPE (FEN_Stat.EStatut).
FEN_Stat est une Fenêtre
	PROPRIETES
		Titre       = "Stat"
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN

	EStatut est une Énumération
		activées    = 7
		desactivées = 9
	FIN
FIN
