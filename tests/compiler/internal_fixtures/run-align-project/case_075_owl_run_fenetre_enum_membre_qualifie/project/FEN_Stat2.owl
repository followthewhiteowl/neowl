// Fenetre compagnon avec DEUX enumerations partageant un meme nom de
// membre (actif) : la qualification par le nom du type (forme b) est
// donc obligatoire pour desambiguiser — FEN.EStatut.actif vs FEN.ENiveau.actif.
FEN_Stat2 est une Fenêtre
	PROPRIETES
		Titre       = "Stat2"
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN

	EStatut est une Énumération
		actif = 7
	FIN
	ENiveau est une Énumération
		actif = 20
	FIN
FIN
