//  : le corps du bloc Projet accepte aussi des déclarations de
// variables, pas seulement des appels. Vérifie que la variable déclarée
// dans le corps est utilisable dans le corps lui-même.
APP est un Projet
	PROPRIETES
		Langues = [langueFrançais]
	FIN
	n est un entier = 42
	ConsoleEcrit("valeur:" + n)
FIN
