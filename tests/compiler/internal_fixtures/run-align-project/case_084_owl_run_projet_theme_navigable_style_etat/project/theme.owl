// Instance de thème désignée par projet.owl. Un style avec une propriété de
// BASE et un ÉTAT distinct, pour prouver que les deux surfaces se relisent
// à la même valeur par le raccourci et par le namespace (base ET état).
ThèmeNavEtat est un Thème
	boutonPrimaire est un styleBouton = {
		CadreExtérieur = {
			CouleurFond = Bleu
			Etats       = {
				Survol = { CouleurFond = Rouge }
			}
		}
	}
FIN
