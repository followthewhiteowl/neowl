// Le raccourci MonApp..Thème.<style> doit accéder aux mêmes valeurs que le
// namespace theme.<style> (sucre équivalent, même résolution) — vrai pour la
// propriété de BASE (case_041) ET pour un ÉTAT : les deux surfaces relisent
// la même valeur, par le raccourci comme par le namespace.

MonAppNavEtat est un Projet
	PROPRIETES
		Langues = [langueFrançais]
		Thème   = ThèmeNavEtat
	FIN

	nBaseViaMonApp est un entier = MonAppNavEtat..Thème.boutonPrimaire..CadreExtérieur..CouleurFond
	nBaseViaSucre est un entier = theme.boutonPrimaire..CadreExtérieur..CouleurFond
	nEtatViaMonApp est un entier = MonAppNavEtat..Thème.boutonPrimaire..CadreExtérieur..Etats[survol]..CouleurFond
	nEtatViaSucre est un entier = theme.boutonPrimaire..CadreExtérieur..Etats[survol]..CouleurFond

	SI nBaseViaMonApp = Bleu ET nBaseViaMonApp = nBaseViaSucre ET nEtatViaMonApp = Rouge ET nEtatViaMonApp = nEtatViaSucre ET nEtatViaSucre <> nBaseViaSucre ALORS
		ConsoleEcrit("OK")
	SINON
		ConsoleEcrit("KO")
	FIN
FIN
