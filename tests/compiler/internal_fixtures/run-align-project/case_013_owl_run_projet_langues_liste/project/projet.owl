// Champ Langues : liste ordonnee de constantes langue. La 1ere
// pilote LangueSource(), bootee au compile-time (, ). Le
// corps du bloc est le programme d'initialisation.
MonApplication est un Projet
	PROPRIETES
		Description = "Gestion de stock"
		Langues     = [langueFrançais, langueAnglais]
	FIN
	ConsoleEcrit(LangueSource())
FIN
