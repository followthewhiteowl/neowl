// Non-regression  : l'acces NOM NU interne (depuis le top-level
// de la fenetre elle-meme) doit rester inchange par le durcissement de
// l'acces qualifie externe.
FEN_Compteur82 est une Fenêtre
	PROPRIETES
		Titre       = "Compteur82"
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN

	compteur est un entier = 9
	ConsoleEcrit("interne:" + compteur)
FIN
