//  : non-regression — mots-cles FR inchanges apres impl bilingue.
// Les formes FR mal cassees sont restaurees vers leur canon FR uppercase.
// Aucune traduction vers l'EN ne doit se produire.

// --- si / alors / fin ---
n est un entier = 0
si n > 3 alors
	n = 1
fin

// --- si / sinon / fin ---
m est un entier = 0
SI m > 0 ALORS
	Trace("positif")
SINON
	Trace("non positif")
FIN

// --- tantque / fin ---
q est un entier = 3
tantque q > 0
	q = q - 1
fin

// --- pour / fin ---
PROCEDURE TestPour()
	j est un entier
	pour j = 1 a 3
		Trace(j)
	fin
FIN

// --- selon / cas / autre / fin ---
PROCEDURE TestSelon()
	vv est un entier = 1
	selon vv
		cas 1
			Trace("un")
		cas 2
			Trace("deux")
		autre
			Trace("autre")
	fin
FIN

// --- sortir / continuer / retour ---
PROCEDURE TestSortir() : entier
	pp est un entier
	pour pp = 1 a 5
		si pp = 3 alors
			continuer
		fin
	fin
	retour 0
FIN
