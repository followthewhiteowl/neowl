// Les 9 comparateurs souples en tête de CAS. La ligne CAS est copiée verbatim
// par le formateur : aucun de ces opérateurs ne doit être découpé. `=]` était
// pris pour un `=` d'affectation par l'aligneur de blocs de propriétés, qui
// insérait une espace au milieu et cassait la compilation.
PROCEDURE ComparateursSouplesCas(sTexte est une chaîne)
	sVerdict est une chaîne = ""
	SELON sTexte
		CAS [= "http" : sVerdict = "préfixe strict"
		CAS [=] "www" : sVerdict = "contient strict"
		CAS [~ "HTTP" : sVerdict = "préfixe sans casse"
		CAS [~] "WWW" : sVerdict = "contient sans casse"
		CAS [~~ "hôte" : sVerdict = "préfixe souple"
		CAS [~~] "hôte" : sVerdict = "contient souple"
		CAS =] ".pdf" : sVerdict = "suffixe strict"
		CAS ~] ".PDF" : sVerdict = "suffixe sans casse"
		CAS ~~] ".PDF" : sVerdict = "suffixe souple"
		AUTRE CAS : sVerdict = "aucun"
	FIN
	Trace(sVerdict)
FIN
