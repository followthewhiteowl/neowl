//  : article EN 'an' dans les declarations — preserve.
// 'x is an integer' reste 'x is an integer' (pas 'x est an entier').
// L'article 'a' avec les types composes (is a Window) est couvert
// dans fh2_window_reparse.owl (bug FH_2, necessite impl parser aussi).

// Article 'an' avec type primitif EN
x is an integer
x = 0

// Copule 'is' seule (sans article) — doit rester 'is'
y is integer
y = 1

// 'are' EN — doit rester 'are'
// (validation que la copule plurielle EN est aussi preservee)
