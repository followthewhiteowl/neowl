//  (ticket A) — tolerated casse variants of the 5 English
// canon keywords + properties + event. The formatter must restore the
// EN canon form : MainMenu, Submenu, MenuOption, MenuSeparator,
// Caption, Shortcut, onSelection.

FEN_MenuClassiqueCanonEN est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
		MainMenu    = MNU_X
	FIN

	MNU_X est un MainMenu
		SM_A est un Submenu
			PROPRIETES
				Caption = "File"
			FIN

			OPT_A est une MenuOption
				PROPRIETES
					Caption  = "New"
					Shortcut = "Ctrl+N"
				FIN

				PROCEDURE onSelection()
				FIN
			FIN

			SEP_A est un MenuSeparator
			FIN
		FIN
	FIN
FIN
