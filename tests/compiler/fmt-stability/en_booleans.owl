//  : booleens EN — true/false canonises en True/False
// (miroir FR Vrai/Faux), jamais traduits vers le FR.

// Litteraux EN en casse quelconque
x est un boolean = true
y est un boolean = false

// Formes mal cassees : restaurees vers le canon EN
a est un boolean = TRUE
b est un boolean = FALSE
c est un boolean = True
d est un boolean = False
