// Les 9 comparateurs souples en pleine expression. Ce sont des opérateurs
// binaires : une espace de chaque côté, quelle que soit la forme écrite.
// Les formes ouvrantes étaient collées au terme de gauche (`sNom[= "Rap"`)
// parce que le `[` était traité comme une indexation.
PROCEDURE ComparateursSouplesExpression()
	sNom est une chaîne = "Rapport.PDF"
	bRésultat est un booléen

	// Formes ouvrantes, écrites espacées.
	bRésultat = sNom [= "Rap"
	bRésultat = sNom [=] "port"
	bRésultat = sNom [~ "rap"
	bRésultat = sNom [~] "PORT"
	bRésultat = sNom [~~ "râp"
	bRésultat = sNom [~~] "pôrt"

	// Formes fermantes, écrites espacées.
	bRésultat = sNom =] ".PDF"
	bRésultat = sNom ~] ".pdf"
	bRésultat = sNom ~~] ".pdf"

	// Formes ouvrantes écrites collées : le formateur rétablit l'espacement.
	bRésultat = sNom [= "Rap"
	bRésultat = sNom [=] "port"
	bRésultat = sNom [~ "rap"
	bRésultat = sNom [~] "PORT"
	bRésultat = sNom [~~ "râp"
	bRésultat = sNom [~~] "pôrt"

	// Une indexation reste collée : le crochet n'est un opérateur que suivi
	// de `=` ou de `~`.
	tMots est un tableau de chaînes = ["a", "b"]
	sNom = tMots[1]
	Trace(bRésultat, sNom)
FIN
