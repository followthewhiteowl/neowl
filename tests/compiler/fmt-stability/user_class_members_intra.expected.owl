// Test : membres de classe (champs + constantes) declares dans
// le MEME fichier. L'acces doit etre canonise vers la casse declaree.
//
// NOTE : aujourd'hui le formatter ne collecte PAS les membres de classe
// (skip delibere "too risky"). Ce test est ROUGE attendu pour le Lot 1.

cConfig est une Classe
PUBLIC
	// Champs avec casses specifiques
	VERSION est une chaîne = "1.0"
	nLargeur est un entier = 800
	rTempsMaximumAttenteRéponse est un réel = 30.0

	CONSTANTE
		NOM_APPLICATION = "OWL Editor"
		URL_DEFAUT      = "http://localhost"
	FIN
FIN

PROCEDURE TestUsageMembresMemefichier()
	cfg est un cConfig

	// Acces aux champs en casse divergente : doit etre canonise
	Trace(cfg.VERSION) // → cfg.VERSION
	Trace(cfg.VERSION) // deja canon
	Trace(cfg.nLargeur) // → cfg.nLargeur
	Trace(cfg.nLargeur) // → cfg.nLargeur

	// Acces sans accent : doit etre canonise vers forme accentuee
	Trace(cfg.rTempsMaximumAttenteRéponse) // → cfg.rTempsMaximumAttenteRéponse

	// Constantes de classe : idem
	Trace(cConfig.NOM_APPLICATION) // → cConfig.NOM_APPLICATION
	Trace(cConfig.URL_DEFAUT) // → cConfig.URL_DEFAUT
FIN
