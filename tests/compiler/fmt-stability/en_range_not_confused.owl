//  : piege range — 'a' article EN vs 'a' borne de range (TOKEN_A).
// La borne de range FR 'a' doit rester 'A' (→ puis formatter -> A accent).
// Borne de range EN 'to' -> canon 'TO' (miroir FR 'À'). NE PAS confondre avec l'article.
// Le formatter ne doit pas confondre ces bornes avec l'article EN 'a'.

// Borne FR 'a' dans POUR (doit rester À)
PROCEDURE TestRangeFR()
	j est un entier
	POUR j = 1 A 5
		Trace(j)
	FIN
FIN

// Borne EN 'to' dans for (doit devenir TO, FOR uppercase)
PROCEDURE TestRangeEN()
	k est un entier
	for k = 1 to 5
		Trace(k)
	end
FIN

// Borne FR dans CAS plage (CAS X A Y) — ne doit pas interagir avec article
PROCEDURE TestCasPlage()
	ncase est un entier = 3
	SELON ncase
		CAS 1 A 3
			Trace("petit")
		AUTRE
			Trace("grand")
	FIN
FIN
