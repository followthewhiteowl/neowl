//  : non-regression — types FR inchanges apres impl bilingue.
// booleen->booleen, entier->entier, chaine->chaine, reel->reel.
// Les accents et la casse FR sont restaures comme avant.

// Types primitifs FR (formes variantes en input)
a1 est un booleen = Vrai
a2 est un BOOLEEN = Faux
a3 est un entier = 10
a4 est un ENTIER = 0
a5 est une chaine = "texte"
a6 est une CHAINE = ""
a7 est un reel = 1.5
a8 est un REEL = 0.0
