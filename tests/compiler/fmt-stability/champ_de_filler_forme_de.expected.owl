// fmt-stability : forme `Champ de X` doit rester inchangée après owl fmt.
// Canon C = neutre : le formatter ne retire PAS le `de`.

FEN_FmtDe est une Fenêtre
	PROPRIETES
		Titre = "fmt de stable"
	FIN

	SAI_Test est un Champ de Saisie
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 200
			Hauteur = 30
		FIN
	FIN

	BTN_Test est un Champ de Bouton
		PROPRIETES
			X       = 10
			Y       = 50
			Largeur = 100
			Hauteur = 30
			Libellé = "OK"
		FIN
	FIN
FIN
