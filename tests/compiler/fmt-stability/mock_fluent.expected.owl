// Test stabilité formatter: API fluent Mock.
// Doit préserver:
// - re-casage méthodes .QUAND → .Quand, .AVEC → .Avec, etc.
// - pas d'indent après .Quand() (pas de block opener)
// - préservation de la structure one-liner chainée
mock est un MockNative = MockCrée(Trace)
mock.Quand().Avec(MockTout).Retourne("x").Active()
mock.VerifieAppele(3)
mock.Reinitialise()
mock.Desactive()
