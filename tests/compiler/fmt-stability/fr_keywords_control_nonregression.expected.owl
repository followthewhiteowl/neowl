//  : non-regression — mots-cles FR inchanges apres impl bilingue.
// Les formes FR mal cassees sont restaurees vers leur canon FR uppercase.
// Aucune traduction vers l'EN ne doit se produire.

// --- si / alors / fin ---
n est un entier = 0
SI n > 3 ALORS
	n = 1
FIN

// --- si / sinon / fin ---
m est un entier = 0
SI m > 0 ALORS
	Trace("positif")
SINON
	Trace("non positif")
FIN

// --- tantque / fin ---
q est un entier = 3
TANTQUE q > 0
	q = q - 1
FIN

// --- pour / fin ---
PROCEDURE TestPour()
	j est un entier
	POUR j = 1 À 3
		Trace(j)
	FIN
FIN

// --- selon / cas / autre / fin ---
PROCEDURE TestSelon()
	vv est un entier = 1
	SELON vv
		CAS 1
		Trace("un")
		CAS 2
		Trace("deux")
		AUTRE
		Trace("autre")
	FIN
FIN

// --- sortir / continuer / retour ---
PROCEDURE TestSortir() : entier
	pp est un entier
	POUR pp = 1 À 5
		SI pp = 3 ALORS
			CONTINUER
		FIN
	FIN
	RETOUR 0
FIN
