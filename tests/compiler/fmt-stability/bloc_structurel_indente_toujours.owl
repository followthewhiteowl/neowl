// Contrepartie de usage_nu_genre_structurel.owl : neutraliser l'homonyme a
// l'usage ne doit pas desarmer le vrai bloc. Un genre structurel garde son
// pouvoir d'ouverture dans ses deux positions legitimes — apres la copule
// (`intro est un EnTeteDocument`) et nu en tete de ligne (`Corps`) — et le FIN
// correspondant referme bien le niveau.

ETAT_Structure est un État
	PROPRIETES
		Format = formatA4
	FIN

	intro est un EnTêteDocument
		PROPRIETES
			Hauteur = 20
		FIN
		Trace("intro")
	FIN

	hdp est un HautDePage
		PROPRIETES
			Hauteur = 15
		FIN
		Trace("haut")
	FIN

	principal est un Corps
		PROPRIETES
			Hauteur = 40
		FIN
		Trace("corps")
	FIN

	bdp est un BasDePage
		PROPRIETES
			Hauteur = 10
		FIN
		Trace("bas")
	FIN

	cloture est un FinDeDocument
		PROPRIETES
			Hauteur = 20
		FIN
		Trace("cloture")
	FIN
FIN

FEN_Structure est une Fenêtre
	PROPRIETES
		Titre = "Blocs structurels"
	FIN

	MNU_Principal est un MenuPrincipal
		SousMenu SM_Fichier
			PROPRIETES
				Libellé = "Fichier"
			FIN

			OptionMenu OPT_Quitter
				PROPRIETES
					Libellé = "Quitter"
				FIN
			FIN
		FIN
	FIN

	TAB_Donnees est un Champ Table
		PROPRIETES
			Largeur = 200
		FIN

		COL_Nom est une Colonne
			PROPRIETES
				Titre = "Nom"
			FIN
		FIN
	FIN
FIN
