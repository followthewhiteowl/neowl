//  : non-regression natives — les formes EN restent inchangees.
// Length() reste Length() — les natives du registry ne sont pas affectees
// par l'impl des keywords EN bilingues.

sTexte est une chaîne = "bonjour"
nLen est un entier = Length(sTexte)
nLen2 est un entier = Length("monde")

// Verifie que la majuscule native EN (Length) n'est pas confondue
// avec un keyword apres l'impl bilingue.
bVide est un booléen = (nLen = 0)
