// Fichier d'usage : utilise les identifiants declares dans declaration.owl
// avec des casses divergentes. Le formatter doit les ramener a la graphie
// de declaration (cross-fichier).

PROCEDURE TestUsageCrossFile()
	// Classe declaree dans declaration.owl
	monClient est un cclient

	// Acces aux champs en casses divergentes
	monClient.snomclient = "Alice"
	monClient.NMONTANT = 1000

	Trace(monClient.SNOMCLIENT)
	Trace(monClient.nmontant)

	// Appel de procedure declaree dans declaration.owl
	nTotal est un entier = calculertotal(500)
	Trace(CALCULERTOTAL(1000))
FIN
