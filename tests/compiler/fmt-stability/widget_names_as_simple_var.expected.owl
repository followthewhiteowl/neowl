// Test  : noms de widgets registry (image, Bouton, Saisie, Libellé,
// Fenêtre...) utilises comme noms de variables simples. Le formatter
// reconnait `<widget-name> est un <type-non-widget>` comme declaration
// de variable, PAS comme ouverture de body widget. Pas d'indentation
// cascade des lignes suivantes.

PROCEDURE Test1()
	image est un booléen = Vrai
	dbgVérifieEgalité(image, Vrai, "img-bool")
FIN

PROCEDURE Test2()
	Bouton est un entier = 1
	Saisie est un entier = 2
	Libellé est un entier = 3
	Fenêtre est un entier = 4
	dbgVérifieEgalité(Bouton + Saisie + Libellé + Fenêtre, 10, "cascade")
FIN

PROCEDURE Test3()
	image est une chaîne = "logo.png"
	SI image = "logo.png" ALORS
		dbgVérifieVrai(Vrai, "ok")
	FIN
FIN
