// Test de regression : indentation du formatter sur "Champ Image".
// Verifie que `IDENT est un Champ Image` declenche bien lineOpens=true
// dans formatter.c::word_opens_block (le mot "image" doit etre dans la
// liste des openers, et "image" doit etre marque ambigu pour distinguer
// "imgQ est une Image = ..." (type runtime, pas opener) de
// "IMG_X est un Champ Image" (widget, opener).

imgQ est une Image = dCréeImage(100, 100, Blanc)

FEN_X est une Fenêtre
	PROPRIETES
		Titre = "Test"
	FIN

	IMG_Centre est un Champ Image
		PROPRIETES
			Cadrage = cadCentre
			Image   = imgQ
		FIN
	FIN
FIN
