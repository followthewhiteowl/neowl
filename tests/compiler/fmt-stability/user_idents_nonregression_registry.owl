// Test non-regression : les mots-cles, types, natives et constantes
// du registry doivent toujours etre canonises comme avant (pas affectes
// par l'ajout de la canonisation des identifiants user).

PROCEDURE TestNonRegression()
	// Mots-cles en casse divergente
	tantque Vrai
		SI Faux alors
			RETOUR
		fin
	fin

	// Types en casse divergente
	s est une CHAINE = "test"
	n est un ENTIER = 42
	r est un reel = 3.14

	// Natives en casse divergente
	Trace(majuscule("test"))
	Trace(MAJUSCULE("test"))
	Trace(taille("test"))

	// Constantes en casse divergente
	bFlag est un booléen = vrai
	bFlag = VRAI
	Trace(bFlag)
FIN
