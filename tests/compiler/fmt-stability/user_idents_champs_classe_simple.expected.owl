// Test canonisation identifiants user : champs de classe simples.
// Champ declare avec casse specifique, acces divergents doivent etre ramenes.

cClient est une Classe
PUBLIC
	nMontant est un entier = 0
	sNom est une chaîne = ""
FIN

PROCEDURE TestAcces()
	monC est un cClient

	// Acces aux champs en casses divergentes
	monC.nMontant = 500
	monC.nMontant = 1000
	Trace(monC.nMontant)

	monC.sNom = "Bob"
	Trace(monC.sNom)
	Trace(monC.sNom)
FIN
