// Un champ/membre nommé comme une constante built-in (tab -> TAB, crlf -> CRLF,
// catégories CAT_BOOL / CAT_EOL_LEGACY) ne doit pas être réécrit vers la forme
// canon de la constante par le formatter — ni à sa déclaration, ni en accès.
// Le nom appartient à l'utilisateur. Couvre Structure ET Classe, déclaration
// ET accès (. simple et :membre en méthode).

Enreg est une Structure
	tab      est un entier
	crlf     est un entier
	compteur est un entier
FIN

Boite est une Classe
	tab  est un entier
	crlf est un entier
FIN

PROCEDURE TestStruct()
	e est un Enreg
	e.tab      = 1
	e.crlf     = 2
	e.compteur = 3
	Trace(e.tab)
	Trace(e.crlf)
FIN

PROCEDURE TestClasse()
	:tab = 10
	:crlf = 20
FIN
