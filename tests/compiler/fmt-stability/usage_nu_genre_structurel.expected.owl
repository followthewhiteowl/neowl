// Un nom d'utilisateur homonyme d'un genre STRUCTUREL du langage (Corps,
// HautDePage, Colonne, SousMenu, Iteration...) ne doit ouvrir aucun niveau
// d'indentation quand il est employe comme simple identifiant. Sans cette
// garantie, une seule mention du mot dans une expression decale tout le reste
// du fichier d'une tabulation qui ne se referme jamais.
//
// Les genres widget (Bouton, Saisie, Table...) sont neutralises de longue
// date ; cette fixture pose la symetrie pour les genres structurels. Elle
// couvre l'INDENTATION uniquement — la casse est couverte par la fixture
// voisine nom_bloc_homonyme_genre_dsl.owl, volontairement limitee aux genres
// widget pour ne pas meler les deux defauts.

PROCEDURE usageDesHomonymesStructurelsFR()
	corps est un entier = 1
	hautDePage est un entier = 2
	basDePage est un entier = 3
	colonne est un entier = 4
	finDeDocument est un entier = 5
	enTeteDocument est un entier = 6
	volet est un entier = 7
	menuPrincipal est un entier = 8
	menuContextuel est un entier = 9
	sousMenu est un entier = 10
	optionMenu est un entier = 11
	menuSeparateur est un entier = 12
	iteration est un entier = 13
	etat est un entier = 14

	// Usage nu, sans copule ni affectation : rien ici n'ouvre de bloc.
	Trace(corps)
	Trace(corps + 1)
	Trace(hautDePage + basDePage)
	Trace(colonne * 2)
	Trace(finDeDocument, enTeteDocument)
	Trace(volet + 1)
	Trace(menuPrincipal + menuContextuel)
	Trace(sousMenu + optionMenu)
	Trace(menuSeparateur + iteration)
	Trace(etat + 1)

	// Memes homonymes dans des positions syntaxiques variees.
	SI corps > 0 ALORS
		Trace(hautDePage)
	FIN

	total est un entier = corps + colonne + volet
	Trace(total)

	// Temoin non-homonyme : doit traverser a l'identique.
	truc est un entier = 7
	Trace(truc)

	// Cette ligne doit rester au meme niveau que les precedentes.
	Trace("fin FR")
FIN

PROCEDURE usageDesHomonymesStructurelsEN()
	body est un entier = 1
	pageHeader est un entier = 2
	pageFooter est un entier = 3
	column est un entier = 4
	documentHeader est un entier = 5
	documentFooter est un entier = 6
	pane est un entier = 7
	mainMenu est un entier = 8
	contextMenu est un entier = 9
	submenu est un entier = 10
	menuOption est un entier = 11
	menuSeparator est un entier = 12
	report est un entier = 13

	Trace(body + 1)
	Trace(pageHeader + pageFooter)
	Trace(column + pane)
	Trace(documentHeader + documentFooter)
	Trace(mainMenu + contextMenu)
	Trace(submenu + menuOption)
	Trace(menuSeparator + report)

	Trace("fin EN")
FIN
