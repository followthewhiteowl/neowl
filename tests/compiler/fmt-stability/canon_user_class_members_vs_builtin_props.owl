// Test fix 0330 : membres classe user gardent la casse de leur declaration,
// meme si le nom matche une prop builtin ou une native fonction.
//
// Bug actuel : v.type → v.Type (prop Definition.Type), :nom → :Nom dans
// méthode, etc. Canon user doit gagner.
//
// Collisions testees : marque (improbable collision), modele (improbable),
// type (prop Definition.Type), nom (prop Definition.Nom).

cVoiture est une Classe
	marque est une chaîne
	modele est une chaîne
	type est une chaîne
	nom est une chaîne
FIN

PROCEDURE PUBLIQUE Constructeur(sMarque est une chaîne, sModele est une chaîne)
	:marque = sMarque
	:modele = sModele
	:type = "berline"
	:nom = sMarque + " " + sModele
FIN

PROCEDURE PUBLIQUE Affiche() : chaîne
	RENVOYER :nom + " (" + :type + ")"
FIN

v est un cVoiture("Renault", "Clio")
s est une chaîne = v.Affiche()
t est une chaîne = v.type
n est une chaîne = v.nom
