//  : mots-cles EN with/on/in — canonises en WITH/ON/IN
// (miroir FR AVEC/SUR/DANS), jamais traduits vers le FR.

// with -> WITH (miroir AVEC)
PROCEDURE TestWith()
	with "context"
		Trace("ok")
	end
FIN

// on -> ON (miroir SUR, gestionnaire erreur inline)
PROCEDURE TestOn()
	on error
		Trace("err")
FIN

// in -> IN (miroir DANS, operateur appartenance)
PROCEDURE TestIn()
	x est un entier = 2
	if x in (1, 2, 3) then
		Trace("appartient")
	end
FIN
