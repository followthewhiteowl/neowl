// Test canonisation identifiants user : distinction avec natives.
// Un identifiant user proche d'une native ne doit PAS etre confondu.
// staille (variable user) != Taille (native)

sTaille est une chaîne = "ma variable"
sMaChaine est une chaîne = "test"

// Usages de la variable user en casses variees
Trace(staille)
Trace(STAILLE)

// Usage de la native Taille (doit rester canonise comme native)
n est un entier = Taille(sMaChaine)
Trace(taille(sMaChaine))
Trace(TAILLE(sMaChaine))
