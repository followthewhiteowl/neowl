//  : operateurs logiques EN — and/or/not canonises en AND/OR/NOT
// (miroir FR ET/OU/PAS), jamais traduits vers le FR.
// Input : formes EN en casse quelconque.

// and / or dans condition if
x est un entier = 5
IF x > 0 AND x < 10 THEN
	Trace("dans intervalle")
END

IF x < 0 OR x > 100 THEN
	Trace("hors intervalle")
END

// not (pas) devant expression
IF NOT (x = 0) THEN
	Trace("non nul")
END

// Formes mal cassees : restaurees vers le canon EN
IF x > 0 AND x < 10 THEN
	Trace("ok")
END

IF x = 5 OR x = 6 THEN
	Trace("cinq ou six")
END

IF NOT (x < 0) THEN
	Trace("positif")
END
