//  : mots-cles de controle EN doivent etre preserves dans leur langue
// (canonises EN majuscule, miroir du FR) sans traduction vers le FR.
// Input : formes EN en casse quelconque.
// Expected : chaque keyword EN uppercase (IF/WHILE/FOR/SWITCH/CASE/BREAK/
// CONTINUE/RETURN/ELSE/THEN/END/OTHER), jamais traduit SI/TANTQUE/POUR/etc.

// --- if / then / end ---
x est un entier = 0
if x > 3 then
	x = 1
end

// --- if / then / else / end ---
b est un booléen = Vrai
if b then
	Trace("vrai")
else
	Trace("faux")
end

// --- while / end ---
cpt est un entier = 5
while cpt > 0
	cpt = cpt - 1
end

// --- switch / case / other / end ---
PROCEDURE TestSwitch()
	y est un entier = 2
	switch y
		case 1
			Trace("un")
		case 2
			Trace("deux")
		other
			Trace("autre")
	end
FIN

// --- continue / return ---
PROCEDURE TestContinue() : entier
	k est un entier
	for k = 1 to 3
		if k = 2 then
			continue
		end
	end
	return 0
FIN
