//  : mix FR/EN dans un meme fichier — chaque token canon dans sa langue.
// Une declaration EN reste EN, une declaration FR reste FR.
// Aucune traduction croisee ne doit se produire.

// Declaration FR
sNom est une chaîne = "test"
nAge est un entier = 0

// Declaration EN (copule EN)
bActif is boolean
bActif = Vrai

// Bloc FR
SI nAge > 18 ALORS
	Trace("majeur")
FIN

// Bloc EN
IF nAge = 0 THEN
	Trace("age non renseigne")
END

// Procedure FR
PROCEDURE CalculFR() : entier
	r est un entier = nAge * 2
	RETOUR r
FIN

// Procedure EN (keywords EN)
PROCEDURE CalculEN() : entier
	res est un integer = nAge + 1
	RETURN res
FIN
