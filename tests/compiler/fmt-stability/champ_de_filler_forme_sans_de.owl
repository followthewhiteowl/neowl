// fmt-stability : forme `Champ X` (sans `de`) doit rester inchangée après owl fmt.
// Canon C = neutre : le formatter n'INSERT PAS de `de`.

FEN_FmtSansDe est une Fenêtre
	PROPRIETES
		Titre = "fmt sans de stable"
	FIN

	SAI_Test est un Champ Saisie
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 200
			Hauteur = 30
		FIN
	FIN

	BTN_Test est un Champ Bouton
		PROPRIETES
			X       = 10
			Y       = 50
			Largeur = 100
			Hauteur = 30
			Libellé = "OK"
		FIN
	FIN
FIN
