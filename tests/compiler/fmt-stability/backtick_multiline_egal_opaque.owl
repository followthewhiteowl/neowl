// Contenu d'un literal backtick multi-ligne : donnée verbatim, jamais réalignée.
// Une ligne interne finissant par un `=` isolé (padding base64) ne doit recevoir
// aucun espace inséré par l'alignement des `=`.
cle est une chaîne = `abc
def=
ghi`

pem est une chaîne = `-----BEGIN PUBLIC KEY-----
MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAE=
abcd1234WXYZ0987base64paddingligne=
-----END PUBLIC KEY-----`
