// Bug remonté 2026-05-21 (#14) : SI inline casse l'indentation
// cumulative des FIN suivants. Ce test expose le decalage.

PROCEDURE TestSIInline()
	x est un entier = 42
	y est un entier = 0
	SI x > 10 ALORS y = 1 SINON y = 0
	SI x > 20 ALORS
		z est un entier = 3
		SI z = 3 ALORS
			Trace("z vaut 3")
		FIN
	FIN
	Trace(y)
FIN
