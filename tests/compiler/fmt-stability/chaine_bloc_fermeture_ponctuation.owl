// La ponctuation qui suit le `]` fermant appartient à la structure qui
// englobe le bloc : elle compte dans la profondeur d'indentation. Sans cela,
// l'accolade de `]}` n'est jamais décomptée et tout le reste du fichier gagne
// un niveau à chaque enregistrement.
PROCEDURE T()
	m est une chaîneMultilingue = {
		langueFrançais: [
Bonjour
],
		langueAnglais: "Hello"
	}
	Trace(m)
FIN

PROCEDURE U()
	m est une chaîneMultilingue = {
		langueFrançais: [
Bonjour
]}
	n est un entier = 1
	Trace(n)
FIN

PROCEDURE V()
	r est une chaîne = ChaîneConstruit([
Bonjour %1
], "Alice")
	Trace(r)
FIN
