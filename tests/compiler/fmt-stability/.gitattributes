# Fixtures CRLF : verrouillent les fins de ligne Windows pour le test de
# detection d'ouvreur de bloc en CRLF. Sans ca, un checkout avec
# core.autocrlf=true rabattrait le \r et le fixture perdrait son sens (le bug
# ne se declenche que si le \r traine en fin de ligne).
crlf_if_then_block_en.owl   text eol=crlf
crlf_si_alors_block_fr.owl  text eol=crlf
crlf_cas_newline_body.owl   text eol=crlf

# Meme verrou pour les fixtures de trim de fin de ligne d'attribut :
# le bug (espace laissee avant le \r) n'existe que si le \r termine la ligne.
crlf_attribut_serialise_chaine.owl      text eol=crlf
crlf_attribut_serialise_non_chaine.owl  text eol=crlf

# Meme verrou pour les fixtures de ligne vide aveugle au \r : le
# bug (tabulation injectee / refusee selon l'EOL) n'existe que si le \r
# termine la ligne vide.
crlf_ligne_vide_nue.owl        text eol=crlf
crlf_ligne_vide_indentee.owl   text eol=crlf

# Les snapshots attendus restent en LF (le harnais normalise CRLF->LF avant
# comparaison ; on garde la convention LF du depot pour les .expected.owl).
*.expected.owl              text eol=lf
