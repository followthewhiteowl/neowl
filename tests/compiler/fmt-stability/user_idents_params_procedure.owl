// Test canonisation identifiants user : parametres de procedure.
// Les parametres declares gardent leur graphie de declaration.

PROCEDURE Calcul(nMontant est un entier, sNom est une chaîne)
	// Usage interne des parametres (meme si la casse diverge,
	// doit etre ramene a la graphie de declaration)
	Trace(nmontant)
	Trace(NMONTANT)
	Trace(snom)
	Trace(SNOM)
FIN

PROCEDURE TestAppel()
	// Appel de la procedure (les noms de params ne sont pas utilises a l'appel)
	Calcul(100, "Alice")
FIN
