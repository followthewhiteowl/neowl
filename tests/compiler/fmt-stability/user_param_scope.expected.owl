// Test : parametres de procedure, usage en casse divergente
// doit etre canonise vers la casse du parametre declare.

PROCEDURE CalculerSomme(nPremier est un entier, nSecond est un entier) : entier
	// Usage en casse divergente : doit etre canonise vers nPremier, nSecond
	RENVOYER nPremier + nSecond
FIN

PROCEDURE AfficherMessage(sTexte est une chaîne)
	// Usage en casse divergente : doit etre canonise vers sTexte
	Trace(sTexte)
	Trace(sTexte)
FIN

PROCEDURE MethodeAvecAccent(rValeurMétrique est un réel) : réel
	// Usage sans accent : doit etre canonise vers rValeurMétrique
	RENVOYER rValeurMétrique * 2.0
FIN
