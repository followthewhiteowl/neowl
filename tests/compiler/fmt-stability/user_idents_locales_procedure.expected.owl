// Test canonisation identifiants user : variables locales de procedure.
// Les variables declarees dans une procedure suivent la meme regle.

PROCEDURE TestLocales()
	nLocal est un entier = 42
	sTmp est une chaîne = "temporaire"

	// Usages en casses divergentes
	nLocal = 100
	nLocal = 200
	Trace(nLocal)

	Trace(sTmp)
	Trace(sTmp)
	Trace(sTmp)
FIN
