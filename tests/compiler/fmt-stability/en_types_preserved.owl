//  : types EN preserves via registry nameEN — ne sont plus rabattus
// vers le FR. boolean->boolean, integer->integer, string->string, real->real.
// Input : formes EN en casse quelconque.

// Types primitifs EN (minuscule + accent corrige si necessaire)
bb est un boolean = Vrai
nn est un integer = 42
ss est une string = "hello"
rr est un real = 3.14

// Forme mal cassee en EN : le formatter restaure le nameEN canonique
b2 est un Boolean = Faux
n2 est un INTEGER = 0
s2 est une STRING = ""
r2 est un REAL = 0.0
