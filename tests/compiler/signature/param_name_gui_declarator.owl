// Un identifiant qui normalise (casse + accent) vers un declarateur GUI
// (libellé -> libelle, bouton, table) reste un identifiant ordinaire en
// position de nom de parametre. Ne doit lever aucune erreur ni avertissement.
PROCEDURE afficheLibellé(libellé est une chaîne)
	Trace(libellé)
FIN

PROCEDURE compteBoutons(bouton est un entier)
	Trace(bouton)
FIN

afficheLibellé("bonjour")
compteBoutons(3)
