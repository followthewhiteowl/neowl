// Le seul utilisateur des globales du dossier est ce fichier de test. Il ne
// mentionne ni `tabOrphelin` ni `FEN_CheckVoisin.tabJamais`.

TestModeHeadless(Vrai)

dbgVérifieEgalité(tabTop..Occurrence, 0, "usage cross-fichier d'une globale top-level")

Ouvre(FEN_CheckVoisin)
dbgVérifieEgalité(FEN_CheckVoisin.nLu, 0, "usage cross-fichier d'une globale d'élément")
Ferme(FEN_CheckVoisin)

PROCEDURE homonymeLocal()
	tabJamais est un tableau de httpRequête
	RENVOYER tabJamais..Occurrence
FIN

dbgVérifieEgalité(homonymeLocal(), 0, "le nom nu homonyme reste une locale")

dbgBilanTest()
