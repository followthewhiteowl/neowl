// État déclaratif voisin d'`api.owl` — un fichier-État = un seul
// État. Résolu par `owl .` (frontière projet), pas par `owl serve api.owl`
// avant le fix (celui-ci ne compile qu'un fichier unique).
ETAT_Facture est un État
	PROPRIETES
		Format = formatA4
	FIN

	intro est un EnTêteDocument
		Trace("Facture")
	FIN

	ligne est un Corps
		Trace("Ligne de facture")
	FIN
FIN
