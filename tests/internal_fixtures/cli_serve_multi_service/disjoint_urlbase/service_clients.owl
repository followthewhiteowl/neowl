//  — service exposant GET /clients/{id}, motif partagé avec
// service_commandes.owl mais sous une UrlBase distincte.
ServiceClients est un ServiceREST
	PROPRIETES
		UrlBase = ["clients"]
	FIN

	LitClient est une OpérationHTTP
		PROPRIETES
			Méthode  = httpGet
			Chemin   = [id]
			Réponses = [httpOK]
			CodeÉtat = httpOK
		FIN
		PROCEDURE surRequête(id est un entier)
			MoiMême..Réponse..CodeÉtat = httpOK
			MoiMême..Réponse..Corps    = "client-" + id
		FIN
	FIN
FIN
