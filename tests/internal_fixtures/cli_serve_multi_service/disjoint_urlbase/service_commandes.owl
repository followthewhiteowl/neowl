//  — service exposant GET /commandes/{id}, motif partagé avec
// service_clients.owl mais sous une UrlBase distincte.
ServiceCommandes est un ServiceREST
	PROPRIETES
		UrlBase = ["commandes"]
	FIN

	LitCommande est une OpérationHTTP
		PROPRIETES
			Méthode  = httpGet
			Chemin   = [id]
			Réponses = [httpOK]
			CodeÉtat = httpOK
		FIN
		PROCEDURE surRequête(id est un entier)
			MoiMême..Réponse..CodeÉtat = httpOK
			MoiMême..Réponse..Corps    = "commande-" + id
		FIN
	FIN
FIN
