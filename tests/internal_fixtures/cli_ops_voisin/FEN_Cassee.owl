// Fixture pour --self-test-cli-ops : compagnon volontairement
// invalide, et qui doit le RESTER. Le type nomme ligne 31 n'existe pas et
// n'existera jamais ; ne pas le remplacer par une syntaxe « pas encore
// supportee » —  en a rendu une valide et ce controle a verdi.
FEN_Cassee est une Fenêtre
	PROPRIETES
		Titre       = "Cassée"
		Largeur     = 400
		Hauteur     = 300
		Disposition = dispLibre
	FIN

	TABLE_X est un Champ Table
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 350
			Hauteur = 200
		FIN

		COL_A est une Colonne
			PROPRIETES
				Libellé = "A"
				Type    = colTypeTexte
				Largeur = 150
			FIN
		FIN
	FIN

	PROCEDURE Ecrit()
		compteur est un TypeQuiNexistePas
	FIN
FIN
