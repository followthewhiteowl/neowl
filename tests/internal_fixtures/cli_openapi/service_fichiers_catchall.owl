// Fixture  — service avec un segment catch-all glouton (`*reste`,
// ) ET un paramètre de chemin ordinaire, pour vérifier que le
// document OpenAPI distingue les deux : le catch-all porte une description
// + l'extension x-owl-catch-all, le paramètre ordinaire reste nu.
ServiceFichiers est un ServiceREST
	PROPRIETES
		UrlBase = ["api", "v1"]
	FIN

	LitFichier est une OpérationHTTP
		PROPRIETES
			Méthode  = httpGet
			Chemin   = ["fichiers", * reste]
			Réponses = [httpOK]
			CodeÉtat = httpOK
		FIN
		PROCEDURE surRequête(reste est une chaîne) : chaîne
			RENVOYER reste
		FIN
	FIN

	LitClient est une OpérationHTTP
		PROPRIETES
			Méthode  = httpGet
			Chemin   = ["clients", id]
			Réponses = [httpOK]
			CodeÉtat = httpOK
		FIN
		PROCEDURE surRequête(id est un entier) : chaîne
			RENVOYER "" + id
		FIN
	FIN
FIN
