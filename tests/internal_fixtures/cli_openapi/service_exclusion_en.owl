// Fixture  — forme EN de la propriété (invariant 3 bilingue) :
// ExcludeFromOpenAPI = Vrai doit produire le même effet que ExclureDeOpenAPI.
ServiceMetrics est un ServiceREST

PROPRIETES
	UrlBase = ["api", "v1"]
FIN

Metrics est une OpérationHTTP
	PROPRIETES
		Méthode  = httpGet
		Chemin   = ["metrics"]
		Réponses = [httpOK]
		CodeÉtat = httpOK
	FIN
	PROCEDURE surRequête()
		MoiMême..Réponse..CodeÉtat = httpOK
		MoiMême..Réponse..Corps    = "metrics"
	FIN
FIN

HealthInternal est une OpérationHTTP
	PROPRIETES
		Méthode            = httpGet
		Chemin             = ["healthz"]
		Réponses           = [httpOK]
		CodeÉtat           = httpOK
		ExcludeFromOpenAPI = Vrai
	FIN
	PROCEDURE surRequête()
		MoiMême..Réponse..CodeÉtat = httpOK
		MoiMême..Réponse..Corps    = "ok"
	FIN
FIN
FIN
