// participe et la duplication doit être détectée à la compilation
// (E_SEM_DSL_OPERATION_NAME_DUPLICATE).
MonSvc est un ServiceREST
Ping est une OpérationHTTP
	PROPRIETES
		Méthode  = httpGet
		Chemin   = ["ping"]
		Réponses = [httpOK]
		CodeÉtat = httpOK
	FIN
	PROCEDURE surRequête()
		MoiMême..Réponse..CodeEtat = httpOK
	FIN
FIN
Ping est une OpérationHTTP
	PROPRIETES
		Méthode  = httpGet
		Chemin   = ["ping2"]
		Réponses = [httpOK]
		CodeÉtat = httpOK
	FIN
	PROCEDURE surRequête()
		MoiMême..Réponse..CodeEtat = httpOK
	FIN
FIN
FIN
