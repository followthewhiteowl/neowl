// @sujet : alignement en colonnes des déclarations de variables consécutives
// @résumé : des déclarations consécutives au même niveau d'indentation sont
// alignées en colonnes (nom, type, valeur initiale) pour une lecture plus
// rapide d'un bloc de déclarations. Une déclaration sans valeur initiale
// garde sa colonne de type alignée, sans espace de queue inutile.

PROCEDURE PUBLIQUE scenario_declarations_alignees()
	iCompteur est un entier  = 0
	sMessage  est une chaîne = "pret"
	bActif    est un booléen = Vrai
	dbgVérifieEgalité(iCompteur, 0, "iCompteur initialisé à 0")
	dbgVérifieEgalité(sMessage, "pret", "sMessage initialisé à pret")
	dbgVérifieVrai(bActif, "bActif initialisé à vrai")
FIN

PROCEDURE PUBLIQUE scenario_declaration_sans_valeur_dans_le_run()
	iPremier   est un entier  = 10
	sDeuxieme  est une chaîne = "ok"
	bTroisieme est un booléen
	bTroisieme = Vrai
	dbgVérifieEgalité(iPremier, 10, "iPremier conserve sa valeur initiale")
	dbgVérifieEgalité(sDeuxieme, "ok", "sDeuxieme conserve sa valeur initiale")
	dbgVérifieVrai(bTroisieme, "bTroisieme affecté après sa déclaration")
FIN

PROCEDURE PRIVÉE scenario_declaration_isolee_sans_voisine()
	iValeurSeule est un entier = 42
	dbgVérifieEgalité(iValeurSeule, 42, "une déclaration isolée garde sa valeur")
FIN
