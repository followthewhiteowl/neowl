// @subject: English declarations — primitive types
// @summary: Programs using the English copula (is a / is an) to declare
// all primitive types: integer, string, real, boolean, date, time,
// duration, currency, numeric. Verifies that each declaration compiles,
// executes, and holds the expected value.

PROCEDURE PUBLIQUE scenario_integer_declaration()
	x is an integer = 42
	dbgCheckEqual(x, 42, "integer declared with EN copula holds assigned value")
	x = x + 8
	dbgCheckEqual(x, 50, "integer arithmetic works after EN declaration")
FIN

PROCEDURE PUBLIQUE scenario_string_declaration()
	s is a string = "hello"
	dbgCheckEqual(s, "hello", "string declared with EN copula holds assigned value")
	s = s + " world"
	dbgCheckEqual(s, "hello world", "string concatenation works after EN declaration")
FIN

PROCEDURE PUBLIQUE scenario_real_declaration()
	r is a real = 3.14
	dbgCheckTrue(r > 3.0 AND r < 3.2, "real declared with EN copula holds float value")
FIN

PROCEDURE PUBLIQUE scenario_boolean_declaration()
	b is a boolean = True
	dbgCheckTrue(b, "boolean true declared with EN copula")
	b = False
	dbgCheckFalse(b, "boolean false assigned after EN declaration")
FIN

PROCEDURE PUBLIQUE scenario_date_declaration()
	d is a date = "20260101"
	dbgCheckNotNull(d, "date declared with EN copula is not null")
FIN

PROCEDURE PUBLIQUE scenario_time_declaration()
	t is a time = "120000"
	dbgCheckNotNull(t, "time declared with EN copula is not null")
FIN

PROCEDURE PUBLIQUE scenario_duration_declaration()
	dur is a duration = "+0000060000"
	dbgCheckNotNull(dur, "duration declared with EN copula is not null")
FIN

PROCEDURE PUBLIQUE scenario_currency_declaration()
	c is a currency = 99.99
	dbgCheckTrue(c > 99.0, "currency declared with EN copula holds value")
FIN

PROCEDURE PUBLIQUE scenario_numeric_declaration()
	n is a numeric = 12345
	dbgCheckEqual(n, 12345, "numeric declared with EN copula holds assigned value")
FIN

PROCEDURE PUBLIQUE scenario_array_declaration()
	arrNums is an array of integers = [10, 20, 30]
	dbgCheckEqual(Length(arrNums), 3, "array of integers declared with EN copula has length 3")
	dbgCheckEqual(arrNums[1], 10, "first element of EN-declared array is correct")
	dbgCheckEqual(arrNums[3], 30, "last element of EN-declared array is correct")
FIN
