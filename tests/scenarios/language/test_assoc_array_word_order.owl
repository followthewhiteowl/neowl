// @subject: Associative array declarations — word order parity FR/EN
// @summary: An associative array can be declared in French canon order
// (tableau associatif) or in the literal calque order (array associative).
// Both orders declare the same underlying structure and support set/get
// by key with identical behaviour.

PROCEDURE PUBLIQUE scenario_declaration_ordre_canon_francais()
	x est un tableau associatif de chaînes
	x["nom"] = "Alice"
	x["ville"] = "Paris"
	dbgVérifieEgalité(x["nom"], "Alice", "FR canon order: read back key nom")
	dbgVérifieEgalité(x["ville"], "Paris", "FR canon order: read back key ville")
	dbgVérifieEgalité(x..Occurrence, 2, "FR canon order: 2 entries after 2 sets")
FIN

PROCEDURE PUBLIQUE scenario_declaration_ordre_calque()
	x is array associative of strings
	x["nom"] = "Alice"
	x["ville"] = "Paris"
	dbgCheckEqual(x["nom"], "Alice", "calque order: read back key nom")
	dbgCheckEqual(x["ville"], "Paris", "calque order: read back key ville")
	dbgCheckEqual(x..Occurrence, 2, "calque order: 2 entries after 2 sets")
FIN
