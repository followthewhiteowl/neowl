// @subject: English collections — array, FOR EACH / FOR EVERY / FOR ALL iteration
// @summary: Programs using English keywords for arrays and iteration constructs.
// FOR EACH, FOR EVERY, and FOR ALL are all valid EN synonyms of POUR TOUT.
// Note: the formatter canonises the preposition token to DE (not OF) in
// FOR EACH v DE arr — this is a known formatter behaviour.

PROCEDURE PUBLIQUE scenario_array_integer()
	arrInt is an array of integers = [3, 1, 4, 1, 5]
	dbgCheckEqual(Length(arrInt), 5, "integer array declared with EN keywords has 5 elements")
	dbgCheckEqual(arrInt[1], 3, "first element is 3")
	dbgCheckEqual(arrInt[5], 5, "last element is 5")
FIN

PROCEDURE PUBLIQUE scenario_array_string()
	arrStr is an array of strings = ["alpha", "beta", "gamma"]
	dbgCheckEqual(Length(arrStr), 3, "string array has 3 elements")
	dbgCheckEqual(arrStr[2], "beta", "second element is beta")
FIN

PROCEDURE PUBLIQUE scenario_for_each_sum()
	arrNums is an array of integers = [10, 20, 30, 40]
	nSum is an integer = 0
	FOR EACH v DE arrNums
		nSum = nSum + v
	END
	dbgCheckEqual(nSum, 100, "FOR EACH sums [10,20,30,40] to 100")
FIN

PROCEDURE PUBLIQUE scenario_for_every_sum()
	arrNums is an array of integers = [1, 2, 3, 4, 5]
	nSum is an integer = 0
	FOR EVERY v DE arrNums
		nSum = nSum + v
	END
	dbgCheckEqual(nSum, 15, "FOR EVERY sums [1..5] to 15")
FIN

PROCEDURE PUBLIQUE scenario_for_all_sum()
	arrNums is an array of integers = [5, 10, 15]
	nSum is an integer = 0
	FOR ALL v DE arrNums
		nSum = nSum + v
	END
	dbgCheckEqual(nSum, 30, "FOR ALL sums [5,10,15] to 30")
FIN

PROCEDURE PUBLIQUE scenario_for_each_string()
	arrWords is an array of strings = ["x", "y", "z"]
	sResult is a string = ""
	FOR EACH w DE arrWords
		sResult = sResult + w
	END
	dbgCheckEqual(sResult, "xyz", "FOR EACH concatenates string array elements")
FIN

PROCEDURE PUBLIQUE scenario_array_add_native()
	arrData is an array of integers
	Add(arrData, 7)
	Add(arrData, 14)
	Add(arrData, 21)
	dbgCheckEqual(Length(arrData), 3, "Add (EN native) appends to array, length is 3")
	dbgCheckEqual(arrData[1], 7, "first element is 7 after Add")
	dbgCheckEqual(arrData[3], 21, "third element is 21 after Add")
FIN

PROCEDURE PUBLIQUE scenario_array_indexing()
	arrData is an array of integers = [100, 200, 300]
	nFirst is an integer = arrData[1]
	nLast is an integer = arrData[3]
	dbgCheckEqual(nFirst, 100, "indexed access [1] returns first element")
	dbgCheckEqual(nLast, 300, "indexed access [3] returns last element")
FIN
