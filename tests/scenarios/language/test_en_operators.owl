// @subject: English operators — AND/OR/NOT, arithmetic, comparisons, concatenation
// @summary: Programs using English logical operators AND, OR, NOT, comparison
// operators, arithmetic operators, and string concatenation. Verifies that all
// operator forms compile, execute, and produce the expected results.

PROCEDURE PUBLIQUE scenario_logical_and()
	bResult is a boolean = True AND True
	dbgCheckTrue(bResult, "True AND True is True")
	bResult = True AND False
	dbgCheckFalse(bResult, "True AND False is False")
	bResult = False AND True
	dbgCheckFalse(bResult, "False AND True is False")
FIN

PROCEDURE PUBLIQUE scenario_logical_or()
	bResult is a boolean = True OR False
	dbgCheckTrue(bResult, "True OR False is True")
	bResult = False OR True
	dbgCheckTrue(bResult, "False OR True is True")
	bResult = False OR False
	dbgCheckFalse(bResult, "False OR False is False")
FIN

PROCEDURE PUBLIQUE scenario_logical_not()
	bResult is a boolean = NOT True
	dbgCheckFalse(bResult, "NOT True is False")
	bResult = NOT False
	dbgCheckTrue(bResult, "NOT False is True")
FIN

PROCEDURE PUBLIQUE scenario_combined_logical()
	p is an integer = 8
	bResult is a boolean = (p > 0) AND (p < 10)
	dbgCheckTrue(bResult, "8 is in range 0..10 via AND")
	bResult = (p < 0) OR (p > 5)
	dbgCheckTrue(bResult, "8 > 5 triggers OR to true")
	bResult = NOT (p = 8)
	dbgCheckFalse(bResult, "NOT (p = 8) is False when p is 8")
FIN

PROCEDURE PUBLIQUE scenario_arithmetic()
	nAdd is an integer = 15 + 7
	dbgCheckEqual(nAdd, 22, "integer addition")
	nSub is an integer = 20 - 3
	dbgCheckEqual(nSub, 17, "integer subtraction")
	nMul is an integer = 6 * 7
	dbgCheckEqual(nMul, 42, "integer multiplication")
	nDiv is an integer = 20 / 4
	dbgCheckEqual(nDiv, 5, "integer division")
	nMod is an integer = 17 % 5
	dbgCheckEqual(nMod, 2, "modulo operator")
FIN

PROCEDURE PUBLIQUE scenario_comparisons()
	dbgCheckTrue(3 < 5, "less-than comparison")
	dbgCheckTrue(5 > 3, "greater-than comparison")
	dbgCheckTrue(5 >= 5, "greater-or-equal comparison")
	dbgCheckTrue(3 <= 3, "less-or-equal comparison")
	dbgCheckTrue(7 = 7, "equality comparison")
	dbgCheckTrue(7 <> 8, "not-equal comparison")
FIN

PROCEDURE PUBLIQUE scenario_string_concat()
	s1 is a string = "Hello"
	s2 is a string = " World"
	sResult is a string = s1 + s2
	dbgCheckEqual(sResult, "Hello World", "string concatenation with + operator")
	dbgCheckEqual(Length(sResult), 11, "length of concatenated string is 11")
FIN

PROCEDURE PUBLIQUE scenario_short_circuit_and()
	// _AND_ is the short-circuit form: right side not evaluated if left is False
	bResult is a boolean = False _AND_ True
	dbgCheckFalse(bResult, "_AND_ short-circuit: False _AND_ True is False")
FIN

PROCEDURE PUBLIQUE scenario_short_circuit_or()
	// _OR_ is the short-circuit form: right side not evaluated if left is True
	bResult is a boolean = True _OR_ False
	dbgCheckTrue(bResult, "_OR_ short-circuit: True _OR_ False is True")
FIN
