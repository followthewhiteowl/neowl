// Ressource fenêtre — voisine de test_TableVersPressePapier.owl.
//
// Une Table à 2 colonnes texte (COL_Nom, COL_Ville), peuplée de 2 lignes
// via TableAjouteLigne en FinInitialisation, pour exercer la copie vers
// le presse-papier.

FEN_TableVersPressePapier est une Fenêtre
	PROPRIETES
		Titre       = "Copie presse-papier depuis Table"
		Disposition = dispLibre
		Largeur     = 600
		Hauteur     = 400
	FIN

	TBL_Copie est un Champ Table
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 560
			Hauteur = 340
		FIN

		COL_Nom est une Colonne
			PROPRIETES
				Libellé = "Nom"
				Type    = colTypeTexte
				Largeur = 200
			FIN
		FIN

		COL_Ville est une Colonne
			PROPRIETES
				Libellé = "Ville"
				Type    = colTypeTexte
				Largeur = 200
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		TableAjouteLigne(TBL_Copie, "Alice", "Paris")
		TableAjouteLigne(TBL_Copie, "Bob", "Lyon")
		cb_tvp_init_done()
	FIN
FIN
