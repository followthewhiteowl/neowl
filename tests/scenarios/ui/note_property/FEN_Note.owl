// Fenêtre voisine — ressource pure pour test_note_property.owl.
// Sert uniquement de support (Fenêtre + Bouton + Libellé + 2 Saisies)
// pour exercer la propriété universelle ..Note en lecture/écriture.

FEN_Note est une Fenêtre
	PROPRIETES
		Titre       = "Test"
		Largeur     = 300
		Hauteur     = 200
		Disposition = dispLibre
	FIN

	BTN_NoteTest est un Champ Bouton
		PROPRIETES
			Libellé = "Bouton"
			X       = 10
			Y       = 10
			Largeur = 100
			Hauteur = 30
		FIN
	FIN

	LIB_NoteTest est un Champ Libellé
		PROPRIETES
			Libellé = "Libellé"
			X       = 10
			Y       = 50
			Largeur = 100
			Hauteur = 20
		FIN
	FIN

	SAI_NoteTest est un Champ de Saisie
		PROPRIETES
			X       = 10
			Y       = 80
			Largeur = 100
			Hauteur = 30
		FIN
	FIN

	SAI_NoteAutre est un Champ de Saisie
		PROPRIETES
			X       = 10
			Y       = 120
			Largeur = 100
			Hauteur = 30
		FIN
	FIN
FIN
