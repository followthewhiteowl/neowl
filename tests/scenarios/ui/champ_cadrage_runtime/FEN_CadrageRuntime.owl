// Fenêtre voisine — ressource pour test_champ_cadrage_runtime.owl.
// Un Champ CodeBarres qui porte un cadrage horizontal/vertical explicite et
// dont le contenu est modifiable au runtime (régénère l'image du code-barres).

FEN_CadrageRuntime est une Fenêtre
	PROPRIETES
		Titre       = "Cadrage runtime"
		Largeur     = 400
		Hauteur     = 250
		Disposition = dispLibre
	FIN

	CBA_Cadre est un Champ CodeBarres
		PROPRIETES
			X                 = 10
			Y                 = 10
			Largeur           = 200
			Hauteur           = 200
			TypeCodeBarres    = CB_QRCODE
			Contenu           = "INITIAL"
			CadrageHorizontal = chDroite
			CadrageVertical   = cvHaut
		FIN
	FIN

	PROCEDURE ChangeContenu(sNouveau est une chaîne)
		CBA_Cadre..Contenu = sNouveau
	FIN

	PROCEDURE LireCadrageH()
		RENVOYER CBA_Cadre..CadrageHorizontal
	FIN

	PROCEDURE LireCadrageV()
		RENVOYER CBA_Cadre..CadrageVertical
	FIN
FIN
