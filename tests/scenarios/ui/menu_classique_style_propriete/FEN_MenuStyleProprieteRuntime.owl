// Fenêtre voisine de test_menu_classique_style_propriete.owl.
// Un MenuPrincipal stylé (nouvelle syntaxe canonique) dont une OptionMenu
// déclenche surSélection() — vérifie que le menu stylé reste pleinement
// fonctionnel (pas juste compilable), via TestSimuleMenu. Expose
// RemonteEtat()/RAZEtat() (pattern callback voisin, cf. tests/scenarios/
// natives/TestSimuleMenu/FEN_TSimulMenu.owl).

FEN_MenuStyleProprieteRuntime est une Fenêtre
	PROPRIETES
		Titre         = "Menu stylé (runtime)"
		Disposition   = dispLibre
		Largeur       = 400
		Hauteur       = 200
		MenuPrincipal = MNU_RuntimeStylé
	FIN

	MNU_RuntimeStylé est un MenuPrincipal
		PROPRIETES
			Style..Barre..CouleurFond      = Bleu
			Style..OptionMenu..CouleurFond = Blanc
		FIN

		SM_Fichier est un SousMenu
			PROPRIETES
				Libellé = "&Fichier"
			FIN

			OPT_Nouveau est une OptionMenu
				PROPRIETES
					Libellé = "&Nouveau"
				FIN

				PROCEDURE surSélection()
					nNouveauCount += 1
				FIN
			FIN
		FIN
	FIN

	nNouveauCount est un entier = 0

	PROCEDURE RemonteEtat()
		callback_etat(nNouveauCount)
	FIN

	PROCEDURE RAZEtat()
		nNouveauCount = 0
	FIN
FIN
