// Fenêtre voisine de test_menu_classique_style_propriete.owl.
// Forme INLINE littérale : `Style = { Barre = {...}, SousMenu = {...},
// OptionMenu = {...} }`, miroir de la forme inline déjà acceptée sur un
// champ (cf. examples/couleur_opacite/FEN_Demo.owl).

FEN_MenuStyleProprieteInline est une Fenêtre
	PROPRIETES
		Titre         = "Menu stylé (propriété inline)"
		Largeur       = 600
		Hauteur       = 400
		Disposition   = dispLibre
		MenuPrincipal = MNU_StyléInline
	FIN

	MNU_StyléInline est un MenuPrincipal
		PROPRIETES
			Style = {
				Barre = {
					CouleurFond = Bleu
					Couleur     = Blanc
				}
				SousMenu = {
					CouleurFond = GrisClair
					Arrondi     = 8
				}
				OptionMenu = {
					CouleurFond = Blanc
					Couleur     = Noir
				}
			}
		FIN

		SM_Fichier est un SousMenu
			PROPRIETES
				Libellé = "&Fichier"
			FIN

			OPT_Quitter est une OptionMenu
				PROPRIETES
					Libellé = "&Quitter"
				FIN
			FIN
		FIN
	FIN
FIN
