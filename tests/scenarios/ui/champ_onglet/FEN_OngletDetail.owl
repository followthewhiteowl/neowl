// Fenêtre voisine — ressource pour test_champ_onglet_detail.owl.
//
// Réglages Détail du Champ Onglet : largeur des volets (proportionnelle/égale)
// et alignement du libellé (gauche/centre/droite). Le rendu exact n'est pas
// observable en test headless — ce scénario verrouille l'absence d'erreur à
// l'ouverture pour chaque combinaison de valeurs. La mesure visuelle du rendu
// se fait à part par capture (voir le rapport de faisabilité).

FEN_OngletDetail est une Fenêtre
	PROPRIETES
		Titre       = "OngletDetail"
		Disposition = dispLibre
		Largeur     = 700
		Hauteur     = 500
	FIN

	ONG_Proportionnel est un Champ Onglet
		PROPRIETES
			X                 = 10
			Y                 = 10
			Largeur           = 320
			Hauteur           = 200
			LargeurVolets     = largeurProportionnelle
			AlignementLibellé = alignCentre
		FIN
		VOL_P1 est un Volet
			PROPRIETES
				Libellé = "Résumé"
			FIN
		FIN
		VOL_P2 est un Volet
			PROPRIETES
				Libellé = "Détails complémentaires"
			FIN
		FIN
	FIN

	ONG_Egale est un Champ Onglet
		PROPRIETES
			X                 = 350
			Y                 = 10
			Largeur           = 320
			Hauteur           = 200
			LargeurVolets     = largeurÉgale
			AlignementLibellé = alignDébut
		FIN
		VOL_E1 est un Volet
			PROPRIETES
				Libellé = "A"
			FIN
		FIN
		VOL_E2 est un Volet
			PROPRIETES
				Libellé = "Paramètres avancés"
			FIN
		FIN
	FIN

	ONG_Droite est un Champ Onglet
		PROPRIETES
			X                 = 10
			Y                 = 230
			Largeur           = 320
			Hauteur           = 200
			LargeurVolets     = largeurProportionnelle
			AlignementLibellé = alignFin
		FIN
		VOL_D1 est un Volet
			PROPRIETES
				Libellé = "Un onglet large"
			FIN
		FIN
		VOL_D2 est un Volet
			PROPRIETES
				Libellé = "X"
			FIN
		FIN
	FIN
FIN
