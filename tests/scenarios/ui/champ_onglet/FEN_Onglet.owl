// Fenêtre voisine — ressource pour test_champ_onglet.owl.
//
// Un Champ Onglet à 3 volets. Chaque volet porte son propre Libellé et sa
// propre Disposition (comme un Conteneur), et contient des champs enfants
// arbitraires — y compris un Conteneur imbriqué dans le 3e volet.

FEN_Onglet est une Fenêtre
	PROPRIETES
		Titre       = "Onglet"
		Disposition = dispLibre
		Largeur     = 500
		Hauteur     = 400
	FIN

	nChangementCount est un entier = 0

	ONG_Principal est un Champ Onglet
		PROPRIETES
			X        = 10
			Y        = 10
			Largeur  = 460
			Hauteur  = 340
			Position = ongHaut
			Valeur   = 1
		FIN

		VOL_Profil est un Volet
			PROPRIETES
				Libellé     = "Profil"
				Disposition = dispLibre
			FIN

			SAI_Nom est un Champ Saisie
				PROPRIETES
					X       = 10
					Y       = 10
					Largeur = 200
					Hauteur = 30
				FIN
			FIN

			BTN_Enregistrer est un Champ Bouton
				PROPRIETES
					X       = 10
					Y       = 50
					Largeur = 120
					Hauteur = 30
					Libellé = "Enregistrer"
				FIN
			FIN
		FIN

		VOL_Options est un Volet
			PROPRIETES
				Libellé     = "Options"
				Disposition = dispVerticale
			FIN

			BTN_ActiverNotif est un Champ Bouton
				PROPRIETES
					Largeur = 150
					Hauteur = 30
					Libellé = "Activer les notifications"
				FIN
			FIN

			BTN_ActiverSon est un Champ Bouton
				PROPRIETES
					Largeur = 150
					Hauteur = 30
					Libellé = "Activer le son"
				FIN
			FIN
		FIN

		VOL_Avance est un Volet
			PROPRIETES
				Libellé     = "Avancé"
				Disposition = dispLibre
			FIN

			CNT_Groupe est un Champ Conteneur
				PROPRIETES
					X           = 10
					Y           = 10
					Largeur     = 400
					Hauteur     = 200
					Disposition = dispLibre
				FIN

				BTN_Reinitialiser est un Champ Bouton
					PROPRIETES
						X       = 10
						Y       = 10
						Largeur = 150
						Hauteur = 30
						Libellé = "Réinitialiser"
					FIN
				FIN
			FIN
		FIN

		PROCEDURE surChangementVolet()
			nChangementCount += 1
		FIN
	FIN

	PROCEDURE LireCompteurChangement()
		RENVOYER nChangementCount
	FIN

	PROCEDURE LireVoletActif()
		RENVOYER ONG_Principal..Valeur
	FIN

	PROCEDURE ChangeVoletActif(n est un entier)
		ONG_Principal..Valeur = n
	FIN

	PROCEDURE LireLibelleBoutonNotif()
		RENVOYER BTN_ActiverNotif..Libellé
	FIN

	PROCEDURE LireLibelleBoutonReinit()
		RENVOYER BTN_Reinitialiser..Libellé
	FIN
FIN
