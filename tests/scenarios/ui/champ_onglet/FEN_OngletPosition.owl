// Fenêtre voisine — ressource pour test_champ_onglet_position.owl.
//
// Un Champ Onglet par valeur de position de la barre d'onglets. Le
// placement visuel exact n'est pas observable en test automatisé (headless)
// — ce scénario verrouille uniquement l'absence d'erreur à l'ouverture pour
// chacune des 4 positions.

FEN_OngletPosition est une Fenêtre
	PROPRIETES
		Titre       = "OngletPosition"
		Disposition = dispLibre
		Largeur     = 500
		Hauteur     = 500
	FIN

	ONG_Haut est un Champ Onglet
		PROPRIETES
			X        = 10
			Y        = 10
			Largeur  = 200
			Hauteur  = 150
			Position = ongHaut
		FIN

		VOL_Haut est un Volet
			PROPRIETES
				Libellé = "Volet"
			FIN
		FIN
	FIN

	ONG_Bas est un Champ Onglet
		PROPRIETES
			X        = 220
			Y        = 10
			Largeur  = 200
			Hauteur  = 150
			Position = ongBas
		FIN

		VOL_Bas est un Volet
			PROPRIETES
				Libellé = "Volet"
			FIN
		FIN
	FIN

	ONG_Gauche est un Champ Onglet
		PROPRIETES
			X        = 10
			Y        = 170
			Largeur  = 200
			Hauteur  = 150
			Position = ongGauche
		FIN

		VOL_Gauche est un Volet
			PROPRIETES
				Libellé = "Volet"
			FIN
		FIN
	FIN

	ONG_Droite est un Champ Onglet
		PROPRIETES
			X        = 220
			Y        = 170
			Largeur  = 200
			Hauteur  = 150
			Position = ongDroite
		FIN

		VOL_Droite est un Volet
			PROPRIETES
				Libellé = "Volet"
			FIN
		FIN
	FIN
FIN
