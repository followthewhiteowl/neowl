// Réglages Détail du Champ Onglet : LargeurVolets
// (largeurProportionnelle/largeurÉgale) et AlignementLibellé
// (alignDébut/alignCentre/alignFin, sous-ensemble de l'enum alignement).
//
// Le placement/rendu exact des languettes n'est pas observable en headless :
// ce scénario verrouille la compilation + l'ouverture sans erreur des trois
// combinaisons. La mesure visuelle du rendu (largeur uniforme, alignement du
// texte) est faite par capture offscreen à part.

TestModeHeadless(Vrai)

PROCEDURE PUBLIQUE scenario_onglet_detail_combinaisons_ouvre_sans_erreur()
	Ouvre(FEN_OngletDetail)
	dbgVérifieFaux(ErreurDétectée, "Onglet avec LargeurVolets + AlignementLibellé (3 combinaisons) : ouverture sans erreur")
	Ferme(FEN_OngletDetail)
FIN
