// Fenêtre voisine — ressource pour test_champ_onglet_masquage.owl.
//
// Un Champ Onglet à 2 volets, dédié aux manipulations runtime de libellé et
// de visibilité (indépendant de FEN_Onglet.owl pour rester à 2 volets et
// isoler le cas du masquage du volet actif).

FEN_OngletMasquage est une Fenêtre
	PROPRIETES
		Titre       = "OngletMasquage"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 300
	FIN

	ONG_Test est un Champ Onglet
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 360
			Hauteur = 240
			Valeur  = 1
		FIN

		VOL_A est un Volet
			PROPRIETES
				Libellé     = "Un"
				Disposition = dispLibre
			FIN
		FIN

		VOL_B est un Volet
			PROPRIETES
				Libellé     = "Deux"
				Disposition = dispLibre
			FIN
		FIN
	FIN

	PROCEDURE RetitreVoletB(s est une chaîne)
		VOL_B..Libellé = s
	FIN

	PROCEDURE LireLibelleVoletB()
		RENVOYER VOL_B..Libellé
	FIN

	PROCEDURE MasqueVoletB()
		VOL_B..Visible = Faux
	FIN

	PROCEDURE LireVisibiliteVoletB()
		RENVOYER VOL_B..Visible
	FIN

	PROCEDURE MasqueVoletA()
		VOL_A..Visible = Faux
	FIN

	PROCEDURE LireVoletActifTest()
		RENVOYER ONG_Test..Valeur
	FIN
FIN
