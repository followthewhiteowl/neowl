// Les 4 positions de la barre d'onglets (ongHaut/ongBas/ongGauche/ongDroite)
// sont acceptées au runtime sans erreur, quelle que soit la position choisie.
//
// Ressource DSL : FEN_OngletPosition.owl (voisin, 1 onglet par position).

TestModeHeadless(Vrai)

PROCEDURE PUBLIQUE scenario_onglet_toutes_positions_ouvre_sans_erreur()
	Ouvre(FEN_OngletPosition)
	dbgVérifieFaux(ErreurDétectée, "les 4 positions de barre d'onglets s'ouvrent sans erreur")

	Ferme(FEN_OngletPosition)
FIN
