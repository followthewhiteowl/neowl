// Fenêtre voisine — ressource pour test_champ_codebarres_conteneur.owl.
// Un champ à image régénérable (ici un Champ CodeBarres) placé
// DANS un Champ Conteneur doit ouvrir la fenêtre sans crash (le parent est
// le conteneur, pas la fenêtre — résolution via central_of).

FEN_CodeBarresConteneur est une Fenêtre
	PROPRIETES
		Titre       = "Code-barres en conteneur"
		Disposition = dispVerticale
	FIN

	C1 est un Champ Conteneur
		PROPRIETES
			Disposition = dispHorizontale
			Étire       = Vrai
		FIN

		CBA est un Champ CodeBarres
			PROPRIETES
				TypeCodeBarres = CB_QRCODE
				Contenu        = "OWL-CONT"
				Largeur        = 150
				Hauteur        = 150
			FIN
		FIN
	FIN

	PROCEDURE LireContenu()
		RENVOYER CBA..Contenu
	FIN
FIN
