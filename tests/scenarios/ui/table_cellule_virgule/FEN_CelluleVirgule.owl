// Fenêtre voisine — ressource pour les scénarios de
// tests\scenarios\ui\table_cellule_virgule\.
//
// Une Table à deux colonnes, assez pour désigner une cellule soit par
// numéro de colonne soit par nom de colonne dans la forme virgule
// `TABLE[ligne, colonne]`.

FEN_CelluleVirgule est une Fenêtre
	PROPRIETES
		Titre   = "Cellule virgule"
		Largeur = 360
		Hauteur = 220
	FIN

	TABLE_Lot est un Champ Table
		PROPRIETES
			Étire = Vrai
		FIN

		COL_Libellé est une Colonne
			PROPRIETES
				Libellé = "Libellé"
				Type    = colTypeTexte
				Largeur = 160
			FIN
		FIN

		COL_Valeur est une Colonne
			PROPRIETES
				Libellé = "Valeur"
				Type    = colTypeNumerique
				Largeur = 120
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		TableAjouteLigne(TABLE_Lot, "Un", 10)
		TableAjouteLigne(TABLE_Lot, "Deux", 20)
	FIN
FIN
