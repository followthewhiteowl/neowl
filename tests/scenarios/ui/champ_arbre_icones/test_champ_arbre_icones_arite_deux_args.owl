// @sujet : ArbreAjoute
// @résumé : ArbreAjoute à 2 arguments (chemin seul, sans image personnalisée)
// continue de fonctionner tel qu'avant — non-régression pendant l'extension
// de l'arité à 3 et 4 arguments pour les icônes de nœud.
//
// Ressource DSL : FEN_ArbreIcones.owl (voisin).

TestModeHeadless(Vrai)

PROCEDURE PUBLIQUE scenario_arbre_ajoute_arite_deux_args_reste_disponible()
	Ouvre(FEN_ArbreIcones)

	bOk est un booléen = ArbreAjoute(ARBRE_Icones, "Documents")
	dbgVérifieVrai(bOk, "ArbreAjoute à 2 arguments (chemin seul) réussit")

	dbgVérifieEgalité(ArbreOccurrence(ARBRE_Icones), 1, "un nœud ajouté sans image personnalisée")

	Ferme(FEN_ArbreIcones)
FIN
