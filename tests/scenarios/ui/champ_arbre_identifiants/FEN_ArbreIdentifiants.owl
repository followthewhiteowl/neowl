// Fenêtre voisine — ressource pour test_champ_arbre_identifiants.owl.
//
// Un Arbre mono-colonne peuplé par chemins TAB-séparés, utilisé pour vérifier
// l'association d'un identifiant à un élément et sa relecture.

FEN_ArbreIdentifiants est une Fenêtre
	PROPRIETES
		Titre       = "Identifiants"
		Disposition = dispLibre
		Largeur     = 300
		Hauteur     = 300
	FIN

	ARBRE_Categories est un Champ Arbre
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 260
			Hauteur = 260
		FIN
	FIN
FIN
