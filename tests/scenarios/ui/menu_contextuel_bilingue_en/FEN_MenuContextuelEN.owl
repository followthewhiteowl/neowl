// Neighbor window — used by test_menu_contextuel_bilingue_en.owl.
// Context menu, English canon forms: ContextMenu / Submenu / MenuOption /
// MenuSeparator / Caption / onSelection, attached via the ContextMenu
// property on a Field.

FEN_MenuContextuelEN is a Window
	PROPERTIES
		Title  = "Shared editor"
		Width  = 500
		Height = 300
		Layout = dispFree
	FIN

	MNU_Shared is a ContextMenu
		SM_Edit is a Submenu
			PROPERTIES
				Caption = "&Edit"
			FIN

			OPT_Copy is a MenuOption
				PROPERTIES
					Caption = "&Copy"
				FIN

				PROCEDURE onSelection()
					nCopyCount += 1
				FIN
			FIN

			SEP_Edit1 is a MenuSeparator
			FIN

			OPT_Paste is a MenuOption
				PROPERTIES
					Caption = "&Paste"
				FIN

				PROCEDURE onSelection()
					nPasteCount += 1
				FIN
			FIN
		FIN
	FIN

	INP_ZoneA is a Field Input
		PROPERTIES
			X           = 10
			Y           = 10
			Width       = 460
			Height      = 30
			ContextMenu = MNU_Shared
		FIN
	FIN

	nCopyCount is an integer = 0
	nPasteCount is an integer = 0

	PROCEDURE ReadCountersEN()
		cb_menu_en_counters(nCopyCount, nPasteCount)
	FIN
FIN
