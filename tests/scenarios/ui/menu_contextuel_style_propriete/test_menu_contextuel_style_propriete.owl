// Reprise canonique du Style menu contextuel : `Style` est
// désormais une propriété DANS le bloc `PROPRIETES` d'un MenuContextuel
// (comme sur un champ), plus un bloc autonome (syntaxe
// inventée retirée). Couvre la forme ligne-par-ligne, la forme inline
// littérale et l'équivalent bilingue EN.

TestModeHeadless(Vrai)

PROCEDURE PUBLIQUE scenario_menu_contextuel_style_propriete_ligne_compile_et_ouvre()
	Ouvre(FEN_MenuContextuelStyleProprieteLigne)
	dbgVérifieFaux(ErreurDétectée, "MenuContextuel avec Style en propriété PROPRIETES (ligne-par-ligne) : ouverture sans erreur")
	Ferme(FEN_MenuContextuelStyleProprieteLigne)
FIN


PROCEDURE PUBLIQUE scenario_menu_contextuel_style_propriete_inline_compile_et_ouvre()
	Ouvre(FEN_MenuContextuelStyleProprieteInline)
	dbgVérifieFaux(ErreurDétectée, "MenuContextuel avec Style en propriété PROPRIETES (littéral inline) : ouverture sans erreur")
	Ferme(FEN_MenuContextuelStyleProprieteInline)
FIN


PROCEDURE PUBLIQUE scenario_menu_contextuel_style_propriete_bilingue_en_compile_et_ouvre()
	Ouvre(FEN_MenuContextuelStyleProprieteEN)
	dbgVérifieFaux(ErreurDétectée, "ContextMenu avec Style en propriété PROPERTIES (EN) : ouverture sans erreur")
	Ferme(FEN_MenuContextuelStyleProprieteEN)
FIN
