// Fenêtre voisine de test_menu_contextuel_style_propriete.owl.
// Reprise canonique de menu_contextuel_style/FEN_MenuContextuelStyleComplet
// .owl : `Style` en propriété DANS `PROPRIETES` (ligne-par-ligne), 2
// surfaces stylables (SousMenu, OptionMenu — pas de Barre, un menu
// contextuel n'en a pas).

FEN_MenuContextuelStyleProprieteLigne est une Fenêtre
	PROPRIETES
		Titre          = "Menu contextuel stylé (propriété)"
		Largeur        = 500
		Hauteur        = 300
		Disposition    = dispLibre
		MenuContextuel = MNU_Style
	FIN

	MNU_Style est un MenuContextuel
		PROPRIETES
			Style..SousMenu..CouleurFond       = GrisClair
			Style..SousMenu..CouleurSéparateur = GrisFoncé
			Style..SousMenu..Arrondi           = 8
			Style..SousMenu..Epaisseur         = 2
			Style..SousMenu..CouleurBordure    = GrisFoncé

			Style..OptionMenu..CouleurFond                = Blanc
			Style..OptionMenu..Couleur                    = Noir
			Style..OptionMenu..Police..Gras               = Faux
			Style..OptionMenu..Etats[survol]..CouleurFond = Bleu
			Style..OptionMenu..Etats[survol]..Couleur     = Blanc
		FIN

		SM_Fichier est un SousMenu
			PROPRIETES
				Libellé = "&Fichier"
			FIN

			OPT_Quitter est une OptionMenu
				PROPRIETES
					Libellé = "&Quitter"
				FIN
			FIN
		FIN
	FIN
FIN
