// Fenêtre voisine de test_menu_contextuel_style_propriete.owl.
// Forme INLINE littérale du Style sur un MenuContextuel.

FEN_MenuContextuelStyleProprieteInline est une Fenêtre
	PROPRIETES
		Titre          = "Menu contextuel stylé (propriété inline)"
		Largeur        = 500
		Hauteur        = 300
		Disposition    = dispLibre
		MenuContextuel = MNU_StyleInline
	FIN

	MNU_StyleInline est un MenuContextuel
		PROPRIETES
			Style = {
				SousMenu = {
					CouleurFond = GrisClair
					Arrondi     = 8
				}
				OptionMenu = {
					CouleurFond = Blanc
					Couleur     = Noir
				}
			}
		FIN

		SM_Fichier est un SousMenu
			PROPRIETES
				Libellé = "&Fichier"
			FIN

			OPT_Quitter est une OptionMenu
				PROPRIETES
					Libellé = "&Quitter"
				FIN
			FIN
		FIN
	FIN
FIN
