// Fenêtre voisine de test_menu_contextuel_style_propriete.owl.
// Équivalent EN complet : ContextMenu/PROPERTIES/Style/Submenu/MenuOption/
// States[hover].

FEN_MenuContextuelStyleProprieteEN is a Window
	PROPERTIES
		Title       = "Styled context menu (property)"
		Width       = 500
		Height      = 300
		Layout      = dispFree
		ContextMenu = MNU_StyleEN
	FIN

	MNU_StyleEN is a ContextMenu
		PROPERTIES
			Style..Submenu..BackgroundColor = LightGray
			Style..Submenu..CornerRadius    = 8

			Style..MenuOption..BackgroundColor                = White
			Style..MenuOption..Color                          = Black
			Style..MenuOption..States[hover]..BackgroundColor = Blue
		FIN

		SM_File is a Submenu
			PROPERTIES
				Caption = "&File"
			FIN

			OPT_Quit is a MenuOption
				PROPERTIES
					Caption = "&Quit"
				FIN
			FIN
		FIN
	FIN
FIN
