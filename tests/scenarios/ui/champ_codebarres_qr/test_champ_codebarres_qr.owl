// @sujet : Champ CodeBarres
// @résumé : Déclare une fenêtre affichant un code-barres QR et un code-barres
// linéaire (Code128) via le Champ CodeBarres, calqué sur le Champ
// Image. Couvre déclaration, type, contenu et niveau de correction d'erreur.

PROCEDURE PUBLIQUE scenario_etiquette_produit_qr_et_reference()
	Ouvre(FEN_ChampCodeBarresQR)

	dbgVérifieEgalité(LireContenuQR(), "https://www.example.com/produit/42",
	"Champ CodeBarres QR - contenu affiché")
	dbgVérifieEgalité(LireContenuReference(), "REF-2026-00042",
	"Champ CodeBarres Code128 - référence affichée")

	Ferme(FEN_ChampCodeBarresQR)
FIN
