// Fenêtre voisine — ressource pour test_champ_codebarres_qr.owl.
// Une fenêtre avec deux champs code-barres : un QR Code et un Code128.

FEN_ChampCodeBarresQR est une Fenêtre
	PROPRIETES
		Titre       = "Étiquette produit"
		Largeur     = 400
		Hauteur     = 250
		Disposition = dispLibre
	FIN

	CBA_QR est un Champ CodeBarres
		PROPRIETES
			X                = 10
			Y                = 10
			Largeur          = 150
			Hauteur          = 150
			TypeCodeBarres   = CB_QRCODE
			Contenu          = "https://www.example.com/produit/42"
			CorrectionErreur = qrcodeNiveauH
		FIN
	FIN

	CBA_Reference est un Champ CodeBarres
		PROPRIETES
			X              = 180
			Y              = 10
			Largeur        = 200
			Hauteur        = 60
			TypeCodeBarres = CB_CODE128
			Contenu        = "REF-2026-00042"
		FIN
	FIN

	PROCEDURE LireContenuQR()
		RENVOYER CBA_QR..Contenu
	FIN

	PROCEDURE LireContenuReference()
		RENVOYER CBA_Reference..Contenu
	FIN
FIN
