// Ressource fenêtre — voisine de test_menu_contextuel_champ_partage.owl.
//
// Un menu contextuel nommé (MNU_Partage est un MenuContextuel) est déclaré
// une seule fois puis référencé par DEUX champs distincts via la propriété
// d'attache MenuContextuel = MNU_Partage : partage effectif, sans
// duplication de l'arbre. Réutilise le vocabulaire figé du menu classique
// (SousMenu / OptionMenu / MenuSéparateur / Libellé / surSélection).

FEN_MenuContextuelPartage est une Fenêtre
	PROPRIETES
		Titre       = "Éditeur partagé"
		Largeur     = 500
		Hauteur     = 300
		Disposition = dispLibre
	FIN

	MNU_Partage est un MenuContextuel
		SM_Edition est un SousMenu
			PROPRIETES
				Libellé = "&Édition"
			FIN

			OPT_Copier est une OptionMenu
				PROPRIETES
					Libellé = "&Copier"
				FIN

				PROCEDURE surSélection()
					nCopierCount += 1
				FIN
			FIN

			OPT_Coller est une OptionMenu
				PROPRIETES
					Libellé = "Co&ller"
				FIN

				PROCEDURE surSélection()
					nCollerCount += 1
				FIN
			FIN

			SEP_Edition1 est un MenuSéparateur
			FIN

			OPT_Supprimer est une OptionMenu
				PROPRIETES
					Libellé = "&Supprimer"
				FIN

				PROCEDURE surSélection()
					nSupprimerCount += 1
				FIN
			FIN
		FIN
	FIN

	ZS_Zone1 est un Champ Saisie
		PROPRIETES
			X              = 10
			Y              = 10
			Largeur        = 460
			Hauteur        = 30
			MenuContextuel = MNU_Partage
		FIN
	FIN

	ZS_Zone2 est un Champ Saisie
		PROPRIETES
			X              = 10
			Y              = 60
			Largeur        = 460
			Hauteur        = 30
			MenuContextuel = MNU_Partage
		FIN
	FIN

	nCopierCount est un entier = 0
	nCollerCount est un entier = 0
	nSupprimerCount est un entier = 0

	PROCEDURE LireCompteursPartage()
		cb_partage_compteurs(nCopierCount, nCollerCount, nSupprimerCount)
	FIN
FIN
