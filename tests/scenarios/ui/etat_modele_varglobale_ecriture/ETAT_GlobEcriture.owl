// État pur utilisé par test_etat_modele_varglobale_ecriture.owl.
//
// Hérite de MOD_GlobEcriture (voisin) : le champ écrit la variable
// globale gMessage déclarée au top-level du modèle, puis la relit pour
// prouver que l'écriture a bien eu lieu sur la variable partagée.

ETAT_GlobEcriture est un État
	Hérite de MOD_GlobEcriture
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	Corps est un Corps
		PROPRIETES
			Hauteur = 40
		FIN

		LBL_Ecrit est un Champ Libellé
			PROPRIETES
				X       = 10
				Y       = 5
				Largeur = 100
				Hauteur = 10
				Libellé = "ecrit la globale du modele"
			FIN
			gMessage = "modifie par l'etat"
			callback_observe("etat-ecrit:" + gMessage)
		FIN
	FIN
FIN
