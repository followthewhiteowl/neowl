// Fenêtre voisine — ressource pour test_table_mise_en_forme_conditionnelle.owl.
//
// Une Table de suivi de trésorerie : un laboratoire par ligne, son solde et
// son niveau de stock. Les données sont volontairement contrastées (un solde
// négatif, un stock bas, un meilleur solde) pour que chaque règle de mise en
// forme ait exactement une ligne à laquelle s'appliquer.

FEN_SyntheseTresorerie est une Fenêtre
	PROPRIETES
		Titre       = "Synthèse de trésorerie"
		Largeur     = 480
		Hauteur     = 300
		Disposition = dispVerticale
	FIN

	TABLE_Synthese est un Champ Table
		PROPRIETES
			Étire = Vrai
		FIN

		COL_Laboratoire est une Colonne
			PROPRIETES
				Libellé = "Laboratoire"
				Type    = colTypeTexte
				Largeur = 180
			FIN
		FIN

		COL_Tresorerie est une Colonne
			PROPRIETES
				Libellé = "Trésorerie"
				Type    = colTypeNumerique
				Largeur = 150
			FIN
		FIN

		COL_Stock est une Colonne
			PROPRIETES
				Libellé = "Stock"
				Type    = colTypeNumerique
				Largeur = 100
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		TableAjouteLigne(TABLE_Synthese, "Labo Nord", 12400, 58)
		TableAjouteLigne(TABLE_Synthese, "Labo Sud",-3250, 42)
		TableAjouteLigne(TABLE_Synthese, "Labo Est", 7800, 6)
	FIN
FIN
