// Fenêtre voisine — ressource pour test_fenetre_plan.owl.
//
// Un plan est un mécanisme d'étape (type wizard) : la fenêtre possède un
// plan actif (défaut 0) et chaque champ peut appartenir à un plan. Un champ
// jamais affecté à un plan ("sans plan") reste toujours visible ; un champ
// affecté à un plan n'est visible que lorsque le plan actif correspond.
//
// Quatre libellés : un sans plan (toujours visible), un sur le plan 0, un
// sur le plan 1, un sur le plan 2 — de quoi distinguer "sans plan" de
// "plan 0" et vérifier la bascule entre plusieurs plans exclusifs.

FEN_Plan est une Fenêtre
	PROPRIETES
		Titre       = "Plan"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 300
	FIN

	LIB_SansPlan est un Champ Libellé
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 150
			Hauteur = 20
			Libellé = "Sans plan"
		FIN
	FIN

	LIB_Plan0 est un Champ Libellé
		PROPRIETES
			X       = 10
			Y       = 40
			Largeur = 150
			Hauteur = 20
			Libellé = "Plan 0"
			Plan    = 0
		FIN
	FIN

	LIB_Plan1 est un Champ Libellé
		PROPRIETES
			X       = 10
			Y       = 70
			Largeur = 150
			Hauteur = 20
			Libellé = "Plan 1"
			Plan    = 1
		FIN
	FIN

	LIB_Plan2 est un Champ Libellé
		PROPRIETES
			X       = 10
			Y       = 100
			Largeur = 150
			Hauteur = 20
			Libellé = "Plan 2"
			Plan    = 2
		FIN
	FIN

	PROCEDURE LireFenPlan()
		RENVOYER FEN_Plan..Plan
	FIN

	PROCEDURE DefinitFenPlan(k est un entier)
		FEN_Plan..Plan = k
	FIN

	PROCEDURE LireVisibleSansPlan()
		RENVOYER LIB_SansPlan..Visible
	FIN

	PROCEDURE LireVisiblePlan0()
		RENVOYER LIB_Plan0..Visible
	FIN

	PROCEDURE LireVisiblePlan1()
		RENVOYER LIB_Plan1..Visible
	FIN

	PROCEDURE LireVisiblePlan2()
		RENVOYER LIB_Plan2..Visible
	FIN

	PROCEDURE LirePlanChampSansPlan()
		RENVOYER LIB_SansPlan..Plan
	FIN

	PROCEDURE LirePlanChampPlan0()
		RENVOYER LIB_Plan0..Plan
	FIN

	PROCEDURE LirePlanChampPlan1()
		RENVOYER LIB_Plan1..Plan
	FIN
FIN
