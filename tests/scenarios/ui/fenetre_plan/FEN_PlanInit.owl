// Fenêtre voisine — ressource pour test_fenetre_plan_init.owl.
//
// Contrairement à FEN_Plan.owl, cette fenêtre ne déclare AUCUN plan actif
// dans ses PROPRIETES statiques : c'est FinInitialisation() qui pose le
// plan actif au démarrage. La visibilité initiale des champs doit refléter
// ce plan posé dynamiquement, pas un plan par défaut.

FEN_PlanInit est une Fenêtre
	PROPRIETES
		Titre       = "Plan initialisé dynamiquement"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 300
	FIN

	LIB_SansPlan est un Champ Libellé
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 150
			Hauteur = 20
			Libellé = "Sans plan"
		FIN
	FIN

	LIB_Plan1 est un Champ Libellé
		PROPRIETES
			X       = 10
			Y       = 40
			Largeur = 150
			Hauteur = 20
			Libellé = "Plan 1"
			Plan    = 1
		FIN
	FIN

	LIB_Plan2 est un Champ Libellé
		PROPRIETES
			X       = 10
			Y       = 70
			Largeur = 150
			Hauteur = 20
			Libellé = "Plan 2"
			Plan    = 2
		FIN
	FIN

	PROCEDURE FinInitialisation()
		FEN_PlanInit..Plan = 1
	FIN

	PROCEDURE LireVisibleSansPlanInit()
		RENVOYER LIB_SansPlan..Visible
	FIN

	PROCEDURE LireVisiblePlan1Init()
		RENVOYER LIB_Plan1..Visible
	FIN

	PROCEDURE LireVisiblePlan2Init()
		RENVOYER LIB_Plan2..Visible
	FIN
FIN
