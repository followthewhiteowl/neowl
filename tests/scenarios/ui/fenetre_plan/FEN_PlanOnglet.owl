// Fenêtre voisine — ressource pour test_fenetre_plan_onglet.owl.
//
// Couvre le cas du Champ Onglet affecté directement à un plan de fenêtre
// (widget composite : barre de languettes + volets, structure différente du
// Conteneur). Un champ sans plan sert de témoin.

FEN_PlanOnglet est une Fenêtre
	PROPRIETES
		Titre       = "Plan onglet"
		Disposition = dispLibre
		Largeur     = 500
		Hauteur     = 400
	FIN

	LIB_SansPlan est un Champ Libellé
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 150
			Hauteur = 20
			Libellé = "Sans plan"
		FIN
	FIN

	ONG_Plan1 est un Champ Onglet
		PROPRIETES
			X        = 10
			Y        = 40
			Largeur  = 460
			Hauteur  = 300
			Position = ongHaut
			Plan     = 1
		FIN

		VOL_Unique est un Volet
			PROPRIETES
				Libellé     = "Détail"
				Disposition = dispLibre
			FIN

			SAI_Detail est un Champ Saisie
				PROPRIETES
					X       = 10
					Y       = 10
					Largeur = 200
					Hauteur = 30
				FIN
			FIN
		FIN
	FIN

	PROCEDURE DefinitFenPlanOnglet(k est un entier)
		FEN_PlanOnglet..Plan = k
	FIN

	PROCEDURE LireVisibleSansPlanOnglet()
		RENVOYER LIB_SansPlan..Visible
	FIN

	PROCEDURE LireVisibleOngletPlan1()
		RENVOYER ONG_Plan1..Visible
	FIN
FIN
