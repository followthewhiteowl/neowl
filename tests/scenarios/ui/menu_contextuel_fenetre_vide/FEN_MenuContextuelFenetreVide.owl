// Ressource fenêtre — voisine de test_menu_contextuel_fenetre_vide.owl.
//
// Le menu contextuel s'attache aussi sur la fenêtre elle-même (clic droit
// sur une zone vide, hors de tout champ) via la même propriété d'attache
// MenuContextuel = <nom>, posée dans PROPRIETES de la Fenêtre.

FEN_MenuContextuelFenetreVide est une Fenêtre
	PROPRIETES
		Titre          = "Zone vide"
		Largeur        = 400
		Hauteur        = 250
		Disposition    = dispLibre
		MenuContextuel = MNU_Fond
	FIN

	MNU_Fond est un MenuContextuel
		SM_Affichage est un SousMenu
			PROPRIETES
				Libellé = "&Affichage"
			FIN

			OPT_Actualiser est une OptionMenu
				PROPRIETES
					Libellé = "Ac&tualiser"
				FIN

				PROCEDURE surSélection()
					nActualiserCount += 1
				FIN
			FIN
		FIN
	FIN

	nActualiserCount est un entier = 0

	PROCEDURE LireCompteurFond()
		cb_fond_compteur(nActualiserCount)
	FIN
FIN
