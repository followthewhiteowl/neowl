// Menu contextuel attaché à la fenêtre elle-même (clic droit sur une zone
// vide, hors de tout champ), via MenuContextuel = MNU_Fond posée dans les
// PROPRIETES de la Fenêtre.

TestModeHeadless(Vrai)

nActualiser_obs est un entier = -1

PROCEDURE cb_fond_compteur(nActualiser est un entier)
	nActualiser_obs = nActualiser
FIN

PROCEDURE PUBLIQUE scenario_menu_contextuel_fenetre_zone_vide_compile()
	Ouvre(FEN_MenuContextuelFenetreVide)
	dbgVérifieFaux(ErreurDétectée, "menu contextuel attaché à la fenêtre (zone vide) : ouverture sans erreur")

	LireCompteurFond()
	dbgVérifieEgalité(nActualiser_obs, 0, "option Actualiser : compteur surSélection à zéro avant toute interaction")

	Ferme(FEN_MenuContextuelFenetreVide)
FIN
