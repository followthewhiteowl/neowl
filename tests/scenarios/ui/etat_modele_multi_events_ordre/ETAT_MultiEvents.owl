// État pur utilisé par test_etat_modele_multi_events_ordre.owl.
//
// Hérite de MOD_EventsA ET MOD_EventsB (voisins) via `Hérite de A, B` :
// l'ouverture doit exécuter A puis B puis l'état (ordre d'inclusion) ; la
// Fermeture doit exécuter l'état puis B puis A (ordre inverse).

ETAT_MultiEvents est un État
	Hérite de MOD_EventsA, MOD_EventsB
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	Corps est un Corps
		PROPRIETES
			Hauteur = 40
		FIN
	FIN

	callback_observe("ouverture-etat")

	PROCEDURE Fermeture()
		callback_observe("fermeture-etat")
	FIN
FIN
