// Premier modèle utilisé par test_etat_modele_multi_events_ordre.owl.
//
// Code d'ouverture (top-level) et PROCEDURE Fermeture : notifient le
// script test pour vérifier l'ordre d'exécution cumulatif à trois
// (MOD_EventsA, MOD_EventsB, ETAT_MultiEvents).

MOD_EventsA est un ModèleÉtat
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	Corps est un Corps
		PROPRIETES
			Hauteur = 40
		FIN
	FIN

	callback_observe("ouverture-A")

	PROCEDURE Fermeture()
		callback_observe("fermeture-A")
	FIN
FIN
