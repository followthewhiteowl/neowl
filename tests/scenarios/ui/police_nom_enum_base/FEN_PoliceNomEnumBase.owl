// Fenêtre voisine — ressource pour test_police_nom_enum_base.owl.

FEN_PoliceNomEnumBase est une Fenêtre
	PROPRIETES
		Titre       = "Police"
		Disposition = dispLibre
	FIN

	LIB_Const est un Champ Libellé
		PROPRIETES
			Libellé   = "Const"
			PoliceNom = iPoliceArial
		FIN
	FIN

	LIB_Chaine est un Champ Libellé
		PROPRIETES
			Libellé   = "Chaine"
			PoliceNom = "Arial"
		FIN
	FIN

	// Casse-insensibilite sur le nom de la constante (invariant langage).
	LIB_Casse est un Champ Libellé
		PROPRIETES
			Libellé   = "Casse"
			PoliceNom = IPOLICEARIAL
		FIN
	FIN
FIN
