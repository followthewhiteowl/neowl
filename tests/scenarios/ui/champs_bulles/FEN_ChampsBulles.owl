// Fenêtre voisine — ressource pour test_champs_bulles.owl.

FEN_ChampsBulles est une Fenêtre
	PROPRIETES
		Titre       = "Test slots Bulle multilingue"
		Largeur     = 600
		Hauteur     = 500
		Disposition = dispLibre
	FIN

	// Combo avec bulle multilingue via litteral inline DSL
	CMB_Pays est un Champ Combo
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 200
			Hauteur = 30
			Bulle   = {langueFrançais: "Sélectionnez un pays", langueAnglais: "Select a country"}
		FIN
	FIN

	// Selecteur avec bulle multilingue via litteral inline DSL
	SEL_Options est un Champ Sélecteur
		PROPRIETES
			X       = 10
			Y       = 50
			Largeur = 200
			Hauteur = 100
			Options = ["Option A", "Option B", "Option C"]
			Bulle   = {langueFrançais: "Choisissez une option", langueAnglais: "Choose an option"}
		FIN
	FIN

	// Interrupteur avec bulle multilingue via litteral inline DSL
	INT_Prefs est un Champ Interrupteur
		PROPRIETES
			X       = 10
			Y       = 160
			Largeur = 200
			Hauteur = 100
			Options = ["Option 1", "Option 2", "Option 3"]
			Bulle   = {langueFrançais: "Cochez vos préférences", langueAnglais: "Check your preferences"}
		FIN
	FIN

	// ZoneRepetee avec bulle multilingue via litteral inline DSL
	ZR_Lignes est un Champ ZoneRépétée
		PROPRIETES
			X       = 10
			Y       = 270
			Largeur = 200
			Hauteur = 100
			Bulle   = {langueFrançais: "Liste des lignes", langueAnglais: "List of rows"}
		FIN
	FIN

	// Table avec bulle multilingue via litteral inline DSL
	TAB_Données est un Champ Table
		PROPRIETES
			X       = 220
			Y       = 10
			Largeur = 350
			Hauteur = 200
			Bulle   = {langueFrançais: "Table de données", langueAnglais: "Data table"}
		FIN

		COL_A est une Colonne
			PROPRIETES
				Libellé = "A"
			FIN
		FIN
	FIN
FIN
