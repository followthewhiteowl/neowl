// Ressource fenêtre — voisine de test_TableVersExcel.owl.
//
// Une Table à 2 colonnes texte (COL_Nom, COL_Ville), peuplée de 2 lignes
// via TableAjouteLigne en FinInitialisation, pour exercer l'export Excel.

FEN_TableVersExcel est une Fenêtre
	PROPRIETES
		Titre       = "Export Excel depuis Table"
		Disposition = dispLibre
		Largeur     = 600
		Hauteur     = 400
	FIN

	TBL_Export est un Champ Table
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 560
			Hauteur = 340
		FIN

		COL_Nom est une Colonne
			PROPRIETES
				Libellé = "Nom"
				Type    = colTypeTexte
				Largeur = 200
			FIN
		FIN

		COL_Ville est une Colonne
			PROPRIETES
				Libellé = "Ville"
				Type    = colTypeTexte
				Largeur = 200
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		TableAjouteLigne(TBL_Export, "Alice", "Paris")
		TableAjouteLigne(TBL_Export, "Bob", "Lyon")
		cb_tve_init_done()
	FIN
FIN
