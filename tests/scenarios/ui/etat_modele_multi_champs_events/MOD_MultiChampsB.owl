// Second modèle de MOD_MultiChampsA/B utilisés par
// test_etat_modele_multi_champs_events.owl.
//
// ETAT_MultiChamps hérite de MOD_MultiChampsA ET de ce modèle via
// `Hérite de A, B` : le champ LBL_B doit être présent à l'impression, au
// même titre que celui du premier modèle et celui propre à l'état.

MOD_MultiChampsB est un ModèleÉtat
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	Corps est un Corps
		PROPRIETES
			Hauteur = 40
		FIN

		LBL_B est un Champ Libellé
			PROPRIETES
				X       = 10
				Y       = 20
				Largeur = 100
				Hauteur = 10
				Libellé = "Modele B"
			FIN
			callback_observe("modeleB:" + LBL_B..Libellé)
		FIN
	FIN
FIN
