// État pur utilisé par test_etat_modele_multi_champs_events.owl.
//
// Hérite de DEUX modèles (MOD_MultiChampsA, MOD_MultiChampsB, voisins) via
// la grammaire `Hérite de A, B` : à l'impression, le Corps unique doit
// fusionner les champs des deux modèles et celui propre à l'état dans
// l'ordre d'inclusion gauche→droite puis l'état.

ETAT_MultiChamps est un État
	Hérite de MOD_MultiChampsA, MOD_MultiChampsB
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	Corps est un Corps
		PROPRIETES
			Hauteur = 40
		FIN

		LBL_Etat est un Champ Libellé
			PROPRIETES
				X       = 10
				Y       = 35
				Largeur = 100
				Hauteur = 10
				Libellé = "Etat"
			FIN
			callback_observe("etat:" + LBL_Etat..Libellé)
		FIN
	FIN
FIN
