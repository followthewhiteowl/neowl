// Premier modèle de MOD_MultiChampsA/B utilisés par
// test_etat_modele_multi_champs_events.owl.
//
// ETAT_MultiChamps hérite de ce modèle ET de MOD_MultiChampsB (voisin) via
// `Hérite de A, B` : le champ LBL_A doit être présent à l'impression, au
// même titre que celui du second modèle et celui propre à l'état.

MOD_MultiChampsA est un ModèleÉtat
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	Corps est un Corps
		PROPRIETES
			Hauteur = 40
		FIN

		LBL_A est un Champ Libellé
			PROPRIETES
				X       = 10
				Y       = 5
				Largeur = 100
				Hauteur = 10
				Libellé = "Modele A"
			FIN
			callback_observe("modeleA:" + LBL_A..Libellé)
		FIN
	FIN
FIN
