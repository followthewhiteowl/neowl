// Modèle d'état pur utilisé par test_etat_modele_override_partiel.owl.
//
// Déclare un champ LBL_Titre avec position, taille et libellé. L'état
// voisin ETAT_Devis le redéclare par nom en ne posant QUE la propriété
// Libellé : override partiel, le reste (X/Y/Largeur/Hauteur) doit
// cascader depuis ce modèle.

MOD_Devis est un ModèleÉtat
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	Corps est un Corps
		PROPRIETES
			Hauteur = 40
		FIN

		LBL_Titre est un Champ Libellé
			PROPRIETES
				X       = 12
				Y       = 8
				Largeur = 150
				Hauteur = 12
				Libellé = "Modele : titre generique"
			FIN
			callback_observe("X=" + LBL_Titre..X + ";Y=" + LBL_Titre..Y +
			";Largeur=" + LBL_Titre..Largeur + ";Hauteur=" + LBL_Titre..Hauteur +
			";Libelle=" + LBL_Titre..Libellé)
		FIN
	FIN
FIN
