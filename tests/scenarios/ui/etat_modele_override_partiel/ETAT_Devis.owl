// État pur utilisé par test_etat_modele_override_partiel.owl.
//
// Redéclare LBL_Titre (hérité de MOD_Devis) en ne posant QUE Libellé :
// override partiel. X/Y/Largeur/Hauteur doivent cascader du modèle
// inchangés, seul Libellé doit changer.

ETAT_Devis est un État
	Hérite de MOD_Devis
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	Corps est un Corps
		PROPRIETES
			Hauteur = 40
		FIN

		LBL_Titre est un Champ Libellé
			PROPRIETES
				Libellé = "Devis n°42"
			FIN
			callback_observe("X=" + LBL_Titre..X + ";Y=" + LBL_Titre..Y +
			";Largeur=" + LBL_Titre..Largeur + ";Hauteur=" + LBL_Titre..Hauteur +
			";Libelle=" + LBL_Titre..Libellé)
		FIN
	FIN
FIN
