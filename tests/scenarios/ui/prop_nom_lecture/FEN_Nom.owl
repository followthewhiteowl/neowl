// Fenêtre voisine — ressource pure pour test_prop_nom_lecture.owl.
// Sert de support (Fenêtre + Bouton + Libellé + Saisie) pour exercer la
// propriété universelle lecture seule ..Nom / ..Name, qui retourne le nom
// déclaré de l'élément (son identifiant), pas une valeur de contenu.
//
// Les Indications diffèrent volontairement des identifiants pour prouver que
// ..Nom retourne bien le nom déclaré et non un texte de contenu.

FEN_Nom est une Fenêtre
	PROPRIETES
		Titre       = "Test"
		Largeur     = 300
		Hauteur     = 200
		Disposition = dispLibre
	FIN

	BTN_Valider est un Champ Bouton
		PROPRIETES
			Libellé = "Valider"
			X       = 10
			Y       = 10
			Largeur = 100
			Hauteur = 30
		FIN
	FIN

	LIB_Titre est un Champ Libellé
		PROPRIETES
			Libellé = "Un libellé"
			X       = 10
			Y       = 50
			Largeur = 100
			Hauteur = 20
		FIN
	FIN

	SAI_Contact est un Champ de Saisie
		PROPRIETES
			X          = 10
			Y          = 80
			Largeur    = 100
			Hauteur    = 30
			Indication = "Saisissez un nom"
		FIN
	FIN
FIN
