// Fenêtre voisine de test_menu_police_nom_ipolice.owl.
// Un menu accepte une constante iPolice (membre de iFamille) pour
// Police..Nom, à parité avec un champ. Les surfaces Barre et OptionMenu
// portent une police ; un littéral chaîne reste accepté sur la même feuille.

FEN_MenuPoliceNomIPolice est une Fenêtre
	PROPRIETES
		Titre         = "Menu police iPolice"
		Largeur       = 600
		Hauteur       = 400
		Disposition   = dispLibre
		MenuPrincipal = MNU_PoliceI
	FIN

	MNU_PoliceI est un MenuPrincipal
		PROPRIETES
			Style..Barre..Police..Nom = iPoliceGeorgia
			// Le littéral chaîne reste accepté sur la même feuille.
			Style..OptionMenu..Police..Nom = "Georgia"
		FIN

		SM_Fichier est un SousMenu
			PROPRIETES
				Libellé = "&Fichier"
			FIN

			OPT_Quitter est une OptionMenu
				PROPRIETES
					Libellé = "&Quitter"
				FIN
			FIN
		FIN
	FIN
FIN
