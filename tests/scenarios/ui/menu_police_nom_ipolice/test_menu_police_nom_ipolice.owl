// Un menu accepte une constante iPolice (membre de iFamille) pour la feuille
// Police..Nom du style, exactement comme un champ. Couvre la surface Barre
// (constante iPolice) et OptionMenu (littéral chaîne), la parité bilingue
// FR/EN, et la non-régression du littéral chaîne.

TestModeHeadless(Vrai)


PROCEDURE PUBLIQUE scenario_menu_police_nom_ipolice_fr_compile_et_ouvre()
	Ouvre(FEN_MenuPoliceNomIPolice)
	dbgVérifieFaux(ErreurDétectée, "MenuPrincipal : constante iPolice acceptée sur Police..Nom (Barre), littéral chaîne toujours accepté (OptionMenu)")
	Ferme(FEN_MenuPoliceNomIPolice)
FIN


PROCEDURE PUBLIQUE scenario_menu_police_nom_ipolice_en_compile_et_ouvre()
	Ouvre(FEN_MenuPoliceNomIPoliceEN)
	dbgVérifieFaux(ErreurDétectée, "MainMenu : constante iFont acceptée sur Font..Name (parité FR/EN)")
	Ferme(FEN_MenuPoliceNomIPoliceEN)
FIN
