// Équivalent EN : un MainMenu accepte une constante iFont (membre de
// iFontFamily) pour Font..Name, à parité FR/EN avec le champ.

FEN_MenuPoliceNomIPoliceEN is a Window
	PROPERTIES
		Title    = "Menu font iFont"
		Width    = 600
		Height   = 400
		Layout   = dispFree
		MainMenu = MNU_FontEN
	FIN

	MNU_FontEN is a MainMenu
		PROPERTIES
			Style..Bar..Font..Name        = iFontGeorgia
			Style..MenuOption..Font..Name = iFontComicSansMS
		FIN

		SM_File is a Submenu
			PROPERTIES
				Caption = "&File"
			FIN

			OPT_Quit is a MenuOption
				PROPERTIES
					Caption = "&Quit"
				FIN
			FIN
		FIN
	FIN
FIN
