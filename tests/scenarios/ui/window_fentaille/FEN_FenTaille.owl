// Ressource fenetre — voisin de test_FenTaille.owl.
// Fenetre servant de cible aux appels FenTaille (resize, move, mode).

FEN_FenTaille est une Fenêtre
	PROPRIETES
		Titre       = "FenTaille"
		Largeur     = 400
		Hauteur     = 300
		Disposition = dispLibre
	FIN

	LIB_Titre est un Champ Libellé
		PROPRIETES
			Libellé = "Cible FenTaille"
			X       = 10
			Y       = 10
			Largeur = 200
			Hauteur = 20
		FIN
	FIN

	PROCEDURE FinInitialisation()
		cb_fen_fentaille_prete()
	FIN
FIN
