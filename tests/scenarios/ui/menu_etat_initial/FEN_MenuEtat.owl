// Ressource fenetre — voisin de test_menu_etat_initial.owl.
// Menu classique dont les noeuds portent la propriete État initial (Etat) :
// une OptionMenu Active, une AffichageSeulement (libellé designer « Inactif »),
// une Grisée, et un SousMenu AffichageSeulement. Etat est l'enum unifié partagé
// avec les champs ; sur un noeud de menu, la variante utile est
// Actif / AffichageSeulement / Grisé (masquage via Visible).

FEN_MenuEtat est une Fenêtre
	PROPRIETES
		Titre         = "Menu État"
		Largeur       = 400
		Hauteur       = 300
		Disposition   = dispLibre
		MenuPrincipal = MNU_Etat
	FIN

	MNU_Etat est un MenuPrincipal
		SM_Actions est un SousMenu
			PROPRIETES
				Libellé = "&Actions"
			FIN

			OPT_Actif est une OptionMenu
				PROPRIETES
					Libellé = "Actif"
					Etat    = Actif
				FIN

				PROCEDURE surSélection()
					nActifCount += 1
				FIN
			FIN

			OPT_Affichage est une OptionMenu
				PROPRIETES
					Libellé = "Affichage seulement"
					Etat    = AffichageSeulement
				FIN
			FIN

			OPT_Grise est une OptionMenu
				PROPRIETES
					Libellé = "Grisée"
					Etat    = Grisé
				FIN
			FIN
		FIN

		SM_Inactif est un SousMenu
			PROPRIETES
				Libellé = "&Inactif"
				Etat    = AffichageSeulement
			FIN

			OPT_Sous est une OptionMenu
				PROPRIETES
					Libellé = "Sous-option"
				FIN
			FIN
		FIN
	FIN

	nActifCount est un entier = 0

	PROCEDURE LireCompteurActif()
		cb_menu_etat_compteur(nActifCount)
	FIN
FIN
