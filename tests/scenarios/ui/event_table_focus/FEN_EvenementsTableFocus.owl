// Ressource fenetre — voisin de test_event_table_focus.owl.
// Events surEntree / surSortie (focus) sur champ Table.
//
// surEntree / surSortie, deja disponibles sur Saisie, Liste et Combo,
// fonctionnent aussi sur un champ Table. Le champ SAI_Focus sert de cible
// alternative pour deplacer le focus.

FEN_EvenementsTableFocus est une Fenêtre
	PROPRIETES
		Titre       = "EvenementsTableFocus"
		Largeur     = 500
		Hauteur     = 300
		Disposition = dispLibre
	FIN

	nEntreeCount est un entier = 0
	nSortieCount est un entier = 0

	SAI_Focus est un Champ Saisie
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 200
		FIN
	FIN

	TABLE_Focus est un Champ Table
		PROPRIETES
			X       = 10
			Y       = 50
			Largeur = 460
			Hauteur = 200
		FIN

		COL_Valeur est une Colonne
			PROPRIETES
				Libellé = "Valeur"
				Type    = colTypeTexte
				Largeur = 200
			FIN
		FIN

		PROCEDURE surEntrée()
			nEntreeCount += 1
		FIN

		PROCEDURE surSortie()
			nSortieCount += 1
		FIN
	FIN

	PROCEDURE FinInitialisation()
		cb_evt_table_focus_prete()
	FIN

	PROCEDURE DonnerFocusTable()
		DonneFocus(TABLE_Focus)
	FIN

	PROCEDURE DonnerFocusSaisie()
		DonneFocus(SAI_Focus)
	FIN

	PROCEDURE LireCompteursTableFocus()
		cb_evt_table_focus_compteurs(nEntreeCount, nSortieCount)
	FIN
FIN
