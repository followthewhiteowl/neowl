// Fenêtre voisine de test_menu_contextuel_style.owl. Style partiel :
// seules deux props sont posées (SousMenu..CouleurFond et OptionMenu..Etats
// [survol]..CouleurFond). Le reste doit se replier sur le défaut sans casser la
// compilation (fallback).

FEN_MenuContextuelStylePartiel est une Fenêtre
	PROPRIETES
		Titre          = "Menu contextuel partiellement stylé"
		Largeur        = 400
		Hauteur        = 250
		Disposition    = dispLibre
		MenuContextuel = MNU_Partiel
	FIN

	MNU_Partiel est un MenuContextuel
		PROPRIETES
			Style..SousMenu..CouleurFond                  = GrisClair
			Style..OptionMenu..Etats[survol]..CouleurFond = JauneClair
		FIN

		SM_Aide est un SousMenu
			PROPRIETES
				Libellé = "&Aide"
			FIN

			OPT_Apropos est une OptionMenu
				PROPRIETES
					Libellé = "&À propos"
				FIN
			FIN
		FIN
	FIN
FIN
