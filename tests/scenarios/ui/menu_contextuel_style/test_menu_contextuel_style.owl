// styleMenuContextuel : le Style typé (SousMenu/OptionMenu — pas de Barre,
// un menu contextuel n'en a pas) devient accepté sur un MenuContextuel. Ce
// scénario ne vérifie QUE la compilation + l'ouverture sans erreur (rendu
// QSS = validation visuelle, hors-portée headless) : style complet, style
// partiel (fallback sur les props non posées) et équivalent bilingue EN.

TestModeHeadless(Vrai)

PROCEDURE PUBLIQUE scenario_menu_contextuel_style_complet_compile()
	Ouvre(FEN_MenuContextuelStyleComplet)
	dbgVérifieFaux(ErreurDétectée, "MenuContextuel avec Style complet (SousMenu+OptionMenu, base+Etats[survol]) : ouverture sans erreur")
	Ferme(FEN_MenuContextuelStyleComplet)
FIN

PROCEDURE PUBLIQUE scenario_menu_contextuel_style_partiel_compile()
	Ouvre(FEN_MenuContextuelStylePartiel)
	dbgVérifieFaux(ErreurDétectée, "MenuContextuel avec Style partiel (2 props posées seulement) : compile et s'ouvre, le reste retombe au défaut")
	Ferme(FEN_MenuContextuelStylePartiel)
FIN

PROCEDURE PUBLIQUE scenario_menu_contextuel_style_bilingue_en_compile()
	Ouvre(FEN_MenuContextuelStyleEN)
	dbgVérifieFaux(ErreurDétectée, "ContextMenu avec ContextMenuStyle (Submenu/MenuOption EN, States[hover]) : ouverture sans erreur")
	Ferme(FEN_MenuContextuelStyleEN)
FIN
