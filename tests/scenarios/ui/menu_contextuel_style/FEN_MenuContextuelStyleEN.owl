// Neighbor window of test_menu_contextuel_style.owl. Full EN
// equivalent: ContextMenu/Submenu/MenuOption, States[hover], BackgroundColor/
// Color/Font/Bold/SeparatorColor, via the `Style` property of the PROPERTIES
// block.

FEN_MenuContextuelStyleEN is a Window
	PROPERTIES
		Title       = "Styled context menu"
		Width       = 500
		Height      = 300
		Layout      = dispFree
		ContextMenu = MNU_StyledEN
	FIN

	MNU_StyledEN is a ContextMenu
		PROPERTIES
			Style..Submenu..BackgroundColor = LightGray
			Style..Submenu..SeparatorColor  = DarkGray
			Style..Submenu..CornerRadius    = 8
			Style..Submenu..Thickness       = 2
			Style..Submenu..BorderColor     = DarkGray

			Style..MenuOption..BackgroundColor                = White
			Style..MenuOption..Color                          = Black
			Style..MenuOption..Font..Bold                     = False
			Style..MenuOption..States[hover]..BackgroundColor = Blue
			Style..MenuOption..States[hover]..Color           = White
		FIN

		SM_File is a Submenu
			PROPERTIES
				Caption = "&File"
			FIN

			OPT_Quit is a MenuOption
				PROPERTIES
					Caption = "&Quit"
				FIN
			FIN
		FIN
	FIN
FIN
