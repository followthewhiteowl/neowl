// Ressource fenetre — voisin de test_window_state.owl.
// Fenetre servant de cible a Maximise, Iconise, Restaure.

FEN_WindowState est une Fenêtre
	PROPRIETES
		Titre       = "WindowState"
		Largeur     = 400
		Hauteur     = 300
		Disposition = dispLibre
	FIN

	LIB_Titre est un Champ Libellé
		PROPRIETES
			Libellé = "Cible changements d'etat"
			X       = 10
			Y       = 10
			Largeur = 250
			Hauteur = 20
		FIN
	FIN

	PROCEDURE FinInitialisation()
		cb_fen_window_state_prete()
	FIN
FIN
