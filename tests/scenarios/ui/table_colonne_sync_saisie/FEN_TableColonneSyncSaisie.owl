// Fenêtre voisine — ressource partagée de
// tests\scenarios\ui\table_colonne_sync_saisie\test_table_colonne_sync_saisie.owl.
//
// Un Champ Table éditable « ordinaire » : une Colonne texte saisissable SANS
// événement, SANS masque, SANS format, SANS style. C'est le cas data-grid le
// plus courant. La saisie réelle en cellule doit remonter au store, lisible par
// TABLE[l].COL.

FEN_TableColonneSyncSaisie est une Fenêtre
	PROPRIETES
		Titre       = "Saisie de cellule"
		Disposition = dispLibre
		Largeur     = 240
		Hauteur     = 160
	FIN

	TABLE_Saisie est un Champ Table
		PROPRIETES
			X           = 10
			Y           = 10
			Largeur     = 200
			Hauteur     = 90
			EtatInitial = EnSaisie
		FIN

		COL_Plain est une Colonne
			PROPRIETES
				Libellé = "Texte"
				Type    = colTypeTexte
				Largeur = 180
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		TableAjouteLigne(TABLE_Saisie, "")
	FIN
FIN
