// Fenêtre voisine — ressource pour test_table_colonnes_declaration.owl.
//
// Déclaration d'un champ Table et de ses colonnes : chaque colonne est un
// sous-bloc Colonne avec ses propriétés courantes (Libellé, Type, Largeur).
// Les lignes sont peuplées dans FinInitialisation, une valeur par colonne
// dans l'ordre de déclaration.

FEN_Repertoire est une Fenêtre
	PROPRIETES
		Titre       = "Répertoire"
		Largeur     = 420
		Hauteur     = 260
		Disposition = dispVerticale
	FIN

	TABLE_Repertoire est un Champ Table
		PROPRIETES
			Étire = Vrai
		FIN

		COL_Nom est une Colonne
			PROPRIETES
				Libellé = "Nom"
				Type    = colTypeTexte
				Largeur = 220
			FIN
		FIN

		COL_Age est une Colonne
			PROPRIETES
				Libellé = "Âge"
				Type    = colTypeNumerique
				Largeur = 100
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		TableAjouteLigne(TABLE_Repertoire, "Ada", 36)
		TableAjouteLigne(TABLE_Repertoire, "Grace", 41)
	FIN
FIN
