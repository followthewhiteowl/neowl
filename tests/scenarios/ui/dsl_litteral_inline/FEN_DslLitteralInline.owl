// Fenêtre voisine — ressource pour test_dsl_litteral_inline.owl.
// Valide que le parser DSL accepte un littéral inline dict
// ({langueFrançais: "...", langueAnglais: "..."}) sur slot
// chaîneMultilingue (Libellé du Bouton). Compile sans segfault.

FEN_DslLitteralInline est une Fenêtre
	PROPRIETES
		Titre       = "Test multilangue"
		Largeur     = 400
		Hauteur     = 200
		Disposition = dispLibre
	FIN

	BTN_Valider est un Champ Bouton
		PROPRIETES
			Libellé = {langueFrançais: "Valider", langueAnglais: "Submit"}
			X       = 10
			Y       = 10
			Largeur = 100
			Hauteur = 30
		FIN
	FIN

	// 3 langues dans le DSL props : valide que le parser supporte N entrées.
	BTN_Annuler est un Champ Bouton
		PROPRIETES
			Libellé = {langueFrançais: "Annuler", langueAnglais: "Cancel", langueAllemand: "Abbrechen"}
			X       = 120
			Y       = 10
			Largeur = 100
			Hauteur = 30
		FIN
	FIN

	// Régression : string simple dans DSL props continue de marcher via
	// coerce auto chaîne → chaîneMultilingue.
	BTN_Aide est un Champ Bouton
		PROPRIETES
			Libellé = "Aide"
			X       = 230
			Y       = 10
			Largeur = 100
			Hauteur = 30
		FIN
	FIN
FIN
