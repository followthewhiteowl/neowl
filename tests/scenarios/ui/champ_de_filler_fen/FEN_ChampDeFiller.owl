// Fenêtre voisine — ressource pour test_champ_de_filler_fen.owl.
//
// Valide que le filler optionnel `de` entre `Champ` et le genre est
// accepté dans une Fenêtre.
// Les deux formes sont déclarées côte à côte pour confirmer l'équivalence.

FEN_ChampDeFiller est une Fenêtre
	PROPRIETES
		Titre       = "Test Champ de filler"
		Largeur     = 500
		Hauteur     = 700
		Disposition = dispLibre
	FIN

	// Forme avec `de` (filler optionnel)
	SAI_AvecDe est un Champ de Saisie
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 200
			Hauteur = 30
		FIN
	FIN

	BTN_AvecDe est un Champ de Bouton
		PROPRIETES
			X       = 10
			Y       = 50
			Largeur = 100
			Hauteur = 30
			Libellé = "OK"
		FIN
	FIN

	LBL_AvecDe est un Champ de Libellé
		PROPRIETES
			X       = 10
			Y       = 90
			Largeur = 200
			Hauteur = 20
			Libellé = "Statut"
		FIN
	FIN

	IMG_AvecDe est un Champ de Image
		PROPRIETES
			X       = 10
			Y       = 120
			Largeur = 100
			Hauteur = 80
		FIN
	FIN

	LST_AvecDe est un Champ de Liste
		PROPRIETES
			X       = 10
			Y       = 210
			Largeur = 200
			Hauteur = 80
		FIN
	FIN

	TBL_AvecDe est un Champ de Table
		PROPRIETES
			X       = 10
			Y       = 300
			Largeur = 200
			Hauteur = 100
		FIN

		COL_A est une Colonne
			PROPRIETES
				Libellé = "A"
			FIN
		FIN
	FIN

	// Forme sans `de` (forme historique — inchangée)
	SAI_SansDe est un Champ Saisie
		PROPRIETES
			X       = 220
			Y       = 10
			Largeur = 200
			Hauteur = 30
		FIN
	FIN

	BTN_SansDe est un Champ Bouton
		PROPRIETES
			X       = 220
			Y       = 50
			Largeur = 100
			Hauteur = 30
			Libellé = "OK"
		FIN
	FIN

	LBL_SansDe est un Champ Libellé
		PROPRIETES
			X       = 220
			Y       = 90
			Largeur = 200
			Hauteur = 20
			Libellé = "Statut"
		FIN
	FIN

	PROCEDURE LireLibelleBoutonAvecDe()
		RENVOYER BTN_AvecDe..Libellé
	FIN

	PROCEDURE LireLibelleBoutonSansDe()
		RENVOYER BTN_SansDe..Libellé
	FIN

	PROCEDURE LireLibelleLibelleAvecDe()
		RENVOYER LBL_AvecDe..Libellé
	FIN

	PROCEDURE LireLibelleLibelleSansDe()
		RENVOYER LBL_SansDe..Libellé
	FIN
FIN
