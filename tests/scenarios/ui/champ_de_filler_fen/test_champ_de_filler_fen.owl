// Valide que le filler optionnel `de` entre `Champ` et le genre est
// accepté dans une Fenêtre, et que les contrôles déclarés avec `de`
// se comportent identiquement à ceux sans `de`.
//
// Ressource DSL : FEN_ChampDeFiller.owl (voisin).

TestModeHeadless(Vrai)

PROCEDURE PUBLIQUE scenario_champ_de_filler_fenetre()
	Ouvre(FEN_ChampDeFiller)

	// Les deux formes doivent compiler et la fenêtre s'ouvrir.
	dbgVérifieVrai(Vrai, "Fenêtre avec Champ de <Genre> compile et s'ouvre")

	// Équivalence sémantique : les libellés des contrôles `Champ de X`
	// sont identiques à ceux des contrôles `Champ X` équivalents.
	sLibBtnAvecDe est une chaîne = LireLibelleBoutonAvecDe()
	sLibBtnSansDe est une chaîne = LireLibelleBoutonSansDe()
	dbgVérifieEgalité(sLibBtnAvecDe, sLibBtnSansDe, "Libellé Bouton: Champ de == Champ")

	sLibLblAvecDe est une chaîne = LireLibelleLibelleAvecDe()
	sLibLblSansDe est une chaîne = LireLibelleLibelleSansDe()
	dbgVérifieEgalité(sLibLblAvecDe, sLibLblSansDe, "Libellé Libellé: Champ de == Champ")

	Ferme(FEN_ChampDeFiller)
FIN
