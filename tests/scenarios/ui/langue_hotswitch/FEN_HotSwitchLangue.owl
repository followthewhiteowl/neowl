// Ressource fenetre — voisin de test_langue_hotswitch.owl.
// Deux controles porteurs d'un libelle multilingue (Libelle chaineMultilingue).
// Le test change la langue courante a chaud et verifie que le texte affiche
// par les controles vivants suit la nouvelle langue active.

FEN_HotSwitchLangue est une Fenêtre
	PROPRIETES
		Titre       = "HotSwitch"
		Largeur     = 400
		Hauteur     = 200
		Disposition = dispLibre
	FIN

	LIB_Titre est un Champ Libellé
		PROPRIETES
			Libellé = {langueFrançais: "Bonjour", langueAnglais: "Hello"}
			X       = 10
			Y       = 10
			Largeur = 280
			Hauteur = 20
		FIN
	FIN

	BTN_Ok est un Champ Bouton
		PROPRIETES
			Libellé = {langueFrançais: "Valider", langueAnglais: "Submit"}
			X       = 10
			Y       = 40
			Largeur = 120
			Hauteur = 30
		FIN
	FIN

	PROCEDURE FinInitialisation()
		cb_hotswitch_prete()
	FIN
FIN
