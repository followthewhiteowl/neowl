// Fenêtre voisine — ressource pour test_table_insere_ligne.owl.
//
// Une Table d'inventaire minimale : un code et un libellé par ligne. Chaque
// scénario repart d'un état connu (il vide puis re-remplit la Table), donc
// FinInitialisation ne fait qu'exister — l'amorçage réel vit dans le test.

FEN_Inventaire est une Fenêtre
	PROPRIETES
		Titre       = "Inventaire"
		Largeur     = 400
		Hauteur     = 300
		Disposition = dispVerticale
	FIN

	TABLE_Articles est un Champ Table
		PROPRIETES
			Étire = Vrai
		FIN

		COL_Code est une Colonne
			PROPRIETES
				Libellé = "Code"
				Type    = colTypeTexte
				Largeur = 120
			FIN
		FIN

		COL_Libelle est une Colonne
			PROPRIETES
				Libellé = "Libellé"
				Type    = colTypeTexte
				Largeur = 220
			FIN
		FIN
	FIN
FIN
