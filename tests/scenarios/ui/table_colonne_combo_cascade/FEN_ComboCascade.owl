// Fenêtre voisine — ressource pour le scénario de
// tests\scenarios\ui\table_colonne_combo_cascade\.
//
// Deux colonnes combo dans un Champ Table : Pays (liste fixe) et Ville, dont
// la liste proposée dépend du pays choisi sur la même ligne — des combos en
// cascade posées cellule par cellule.

FEN_ComboCascade est une Fenêtre
	PROPRIETES
		Titre   = "Commandes"
		Largeur = 420
		Hauteur = 240
	FIN

	TABLE_Commandes est un Champ Table
		PROPRIETES
			Étire = Vrai
		FIN

		COL_Pays est une Colonne
			PROPRIETES
				Libellé = "Pays"
				Type    = colTypeCombo
				Contenu = `France
Belgique
Suisse`
				Largeur = 140
			FIN
		FIN

		COL_Ville est une Colonne
			PROPRIETES
				Libellé = "Ville"
				Type    = colTypeCombo
				Contenu = "Choisissez un pays"
				Largeur = 160
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		TableAjouteLigne(TABLE_Commandes, "France", "Paris")
		TableAjouteLigne(TABLE_Commandes, "Belgique", "Bruxelles")
		TableAjouteLigne(TABLE_Commandes, "Suisse", "Genève")
	FIN
FIN
