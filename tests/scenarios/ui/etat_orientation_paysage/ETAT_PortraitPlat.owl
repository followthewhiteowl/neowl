// État plat (aucun `Hérite de`) en orientation portrait, cas de contrôle :
// le défaut portrait doit rester portrait (dimensions en hauteur).

ETAT_PortraitPlat est un État
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	Corps est un Corps
		PROPRIETES
			Hauteur = 40
		FIN
	FIN
FIN
