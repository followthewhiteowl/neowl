// Modèle d'état réduit à un en-tête de page (sans Corps) — fragment
// réutilisable utilisé par ETAT_HeriteBandOnly (voisin). Démontre qu'un
// modèle peut ne porter qu'une bande d'en-tête, sans prétendre être
// imprimable seul.

MOD_BandOnly est un ModèleÉtat
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	haut est un HautDePage
		PROPRIETES
			Hauteur = 15
		FIN
		callback_observe("modele:haut")
	FIN
FIN
