// État qui hérite de MOD_BandOnly (voisin, en-tête seul) et fournit son
// propre Corps : l'impression doit combiner l'en-tête du modèle et le
// corps de l'état.

ETAT_HeriteBandOnly est un État
	Hérite de MOD_BandOnly
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	ligne est un Corps
		PROPRIETES
			Hauteur = 40
		FIN
		callback_observe("etat:corps")
	FIN
FIN
