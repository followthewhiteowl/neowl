// Modèle de premier niveau utilisé par test_etat_modele_multi_niveaux.owl.
//
// MOD_NiveauEnfant (voisin) hérite de ce modèle, puis ETAT_MultiNiveaux
// hérite de MOD_NiveauEnfant : les champs de ce modèle doivent être
// présents à l'impression malgré les deux niveaux d'indirection.

MOD_NiveauParent est un ModèleÉtat
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	Corps est un Corps
		PROPRIETES
			Hauteur = 40
		FIN

		LBL_Parent est un Champ Libellé
			PROPRIETES
				X       = 10
				Y       = 5
				Largeur = 100
				Hauteur = 10
				Libellé = "niveau parent"
			FIN
			callback_observe("parent:" + LBL_Parent..Libellé)
		FIN
	FIN
FIN
