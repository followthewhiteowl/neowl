// Modèle-de-modèle utilisé par test_etat_modele_multi_niveaux.owl.
//
// Hérite de MOD_NiveauParent (voisin) : un ModèleÉtat peut lui-même
// hériter d'un autre ModèleÉtat. ETAT_MultiNiveaux (voisin) hérite de
// celui-ci.

MOD_NiveauEnfant est un ModèleÉtat
Hérite de MOD_NiveauParent
PROPRIETES
	Format      = formatA4
	Orientation = orientPortrait
FIN

Corps est un Corps
	PROPRIETES
		Hauteur = 40
	FIN

	LBL_Enfant est un Champ Libellé
		PROPRIETES
			X       = 10
			Y       = 20
			Largeur = 100
			Hauteur = 10
			Libellé = "niveau enfant"
		FIN
		callback_observe("enfant:" + LBL_Enfant..Libellé)
	FIN
FIN
FIN
