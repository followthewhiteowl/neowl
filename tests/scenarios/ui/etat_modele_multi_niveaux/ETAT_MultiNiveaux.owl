// État pur utilisé par test_etat_modele_multi_niveaux.owl.
//
// Hérite de MOD_NiveauEnfant (voisin), lui-même héritier de
// MOD_NiveauParent : les champs des DEUX niveaux de modèles doivent être
// présents à l'impression, fusionnés avec celui propre à l'état.

ETAT_MultiNiveaux est un État
	Hérite de MOD_NiveauEnfant
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	Corps est un Corps
		PROPRIETES
			Hauteur = 40
		FIN

		LBL_Etat est un Champ Libellé
			PROPRIETES
				X       = 10
				Y       = 35
				Largeur = 100
				Hauteur = 10
				Libellé = "niveau etat"
			FIN
			callback_observe("etat:" + LBL_Etat..Libellé)
		FIN
	FIN
FIN
