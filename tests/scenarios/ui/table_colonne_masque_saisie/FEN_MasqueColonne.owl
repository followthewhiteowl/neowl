// Fenêtre voisine — ressource pour test_table_colonne_masque_saisie.owl.
//
// Déclare un champ Table dont une colonne porte un masque de saisie
// (MasqueSaisie). Le masque cadre l'édition des cellules de la colonne ;
// il est ici déclaré au niveau de la colonne, à côté des propriétés
// courantes (Libellé, Type, Largeur).

FEN_MasqueColonne est une Fenêtre
	PROPRIETES
		Titre       = "Contacts"
		Largeur     = 420
		Hauteur     = 260
		Disposition = dispVerticale
	FIN

	TABLE_Contacts est un Champ Table
		PROPRIETES
			Étire = Vrai
		FIN

		COL_Nom est une Colonne
			PROPRIETES
				Libellé = "Nom"
				Type    = colTypeTexte
				Largeur = 220
			FIN
		FIN

		COL_Tel est une Colonne
			PROPRIETES
				Libellé      = "Téléphone"
				Type         = colTypeTexte
				Largeur      = 140
				MasqueSaisie = "+99 99 999 99 99"
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		TableAjouteLigne(TABLE_Contacts, "Ada", "+41 79 123 45 67")
	FIN
FIN
