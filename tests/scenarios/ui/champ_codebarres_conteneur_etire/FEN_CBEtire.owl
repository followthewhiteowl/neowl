// Fenêtre voisine — ressource pour test_champ_codebarres_conteneur_etire.owl.
// Un Champ CodeBarres en Étire (sans taille déclarée) dans un
// Champ Conteneur doit remplir sa cellule et ouvrir sans crash. Le rendu
// étiré réel (image qui suit la taille) est validé visuellement.

FEN_CBEtire est une Fenêtre
	PROPRIETES
		Titre       = "Code-barres étiré en conteneur"
		Disposition = dispVerticale
	FIN

	C1 est un Champ Conteneur
		PROPRIETES
			Disposition = dispHorizontale
			Étire       = Vrai
		FIN

		CBA est un Champ CodeBarres
			PROPRIETES
				TypeCodeBarres = CB_QRCODE
				Contenu        = "OWL-ETIRE"
				Étire          = Vrai
			FIN
		FIN
	FIN

	PROCEDURE LireContenu()
		RENVOYER CBA..Contenu
	FIN
FIN
