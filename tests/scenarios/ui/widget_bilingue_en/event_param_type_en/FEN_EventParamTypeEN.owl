// Ressource pour test_event_param_type_en.owl.
//
// Fenetre EN dont le handler clavier declare son parametre avec un nom de
// type EN (`is an integer`). Verrouille que la validation de signature
// d'evenement accepte le type EN au meme titre qu'une declaration de
// parametre de procedure normale.

FEN_EventParamTypeEN is a Window
	PROPERTIES
		Title  = "Event param type EN"
		Width  = 400
		Height = 200
		Layout = dispFree
	END

	nDerniereAppuyee is an integer = -1

	SAI_Texte is a Control Input
		PROPERTIES
			X     = 20
			Y     = 20
			Width = 300
		END
		PROCEDURE onKeyDown(nTouche is an integer)
			nDerniereAppuyee = nTouche
			callback_appuyee(nTouche)
		END
	END

	PROCEDURE FinInitialisation()
		callback_fen_prete()
	END
END
