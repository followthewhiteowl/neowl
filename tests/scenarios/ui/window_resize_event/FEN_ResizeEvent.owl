// Ressource fenetre — voisin de test_window_resize_event.owl.
// Observe l'event surChangementTaille declenche au redimensionnement
// par programme (ecriture de ..Largeur ou ..Hauteur).

FEN_ResizeEvent est une Fenêtre
	PROPRIETES
		Titre       = "ResizeEvent"
		Largeur     = 400
		Hauteur     = 300
		Disposition = dispLibre
	FIN

	LIB_Info est un Champ Libellé
		PROPRIETES
			Libellé = "Ecoute surChangementTaille"
			X       = 10
			Y       = 10
			Largeur = 280
			Hauteur = 20
		FIN
	FIN

	nResizeCount est un entier = 0
	nDerniereWidth est un entier = 0
	nDerniereHeight est un entier = 0

	PROCEDURE surChangementTaille(largeur est un entier, hauteur est un entier)
		nResizeCount += 1
		nDerniereWidth  = largeur
		nDerniereHeight = hauteur
	FIN

	PROCEDURE FinInitialisation()
		cb_fen_resize_event_prete()
	FIN

	PROCEDURE LireCompteursResize()
		cb_fen_resize_event_compteurs(nResizeCount, nDerniereWidth, nDerniereHeight)
	FIN
FIN
