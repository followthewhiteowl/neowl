// État pur utilisé par test_etat_modele_varglobale_transitif.owl.
//
// Hérite de MOD_GlobTransEnfant (voisin), lui-même héritier de
// MOD_GlobTransParent : lit la variable globale gMessage déclarée deux
// niveaux plus haut dans la chaîne de modèles.

ETAT_GlobTransitif est un État
	Hérite de MOD_GlobTransEnfant
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	Corps est un Corps
		PROPRIETES
			Hauteur = 40
		FIN

		LBL_Lit est un Champ Libellé
			PROPRIETES
				X       = 10
				Y       = 5
				Largeur = 100
				Hauteur = 10
				Libellé = "lit la globale transitive"
			FIN
			callback_observe("etat-lit:" + gMessage)
		FIN
	FIN
FIN
