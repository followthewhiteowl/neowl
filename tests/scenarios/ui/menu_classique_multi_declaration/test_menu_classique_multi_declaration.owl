// Deux MenuPrincipal déclarés sur la même fenêtre, un seul affecté via
// MenuPrincipal : compile sans erreur. Le choix du menu
// réellement rendu (MNU_B) est vérifié au rendu.

TestModeHeadless(Vrai)

PROCEDURE PUBLIQUE scenario_menu_classique_multi_declaration_compile()
	Ouvre(FEN_MenuMultiDeclaration)
	dbgVérifieFaux(ErreurDétectée, "deux MenuPrincipal déclarés, un seul affecté : ouverture sans erreur")
	Ferme(FEN_MenuMultiDeclaration)
FIN
