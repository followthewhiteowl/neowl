// Neighbor window — used by test_menu_classique_multi_declaration.owl.
// Deux MenuPrincipal déclarés comme blocs enfants de la fenêtre ;
// seul celui affecté via MenuPrincipal compte (décision figée :
// "multi-déclaration autorisée, seul l'affecté s'applique").

FEN_MenuMultiDeclaration est une Fenêtre
	PROPRIETES
		Titre         = "Multi-déclaration"
		Largeur       = 400
		Hauteur       = 300
		Disposition   = dispLibre
		MenuPrincipal = MNU_B
	FIN

	MNU_A est un MenuPrincipal
		SM_A est un SousMenu
			PROPRIETES
				Libellé = "Menu A"
			FIN

			OPT_A est une OptionMenu
				PROPRIETES
					Libellé = "Option A"
				FIN

				PROCEDURE surSélection()
				FIN
			FIN
		FIN
	FIN

	MNU_B est un MenuPrincipal
		SM_B est un SousMenu
			PROPRIETES
				Libellé = "Menu B"
			FIN

			OPT_B est une OptionMenu
				PROPRIETES
					Libellé = "Option B"
				FIN

				PROCEDURE surSélection()
				FIN
			FIN
		FIN
	FIN
FIN
