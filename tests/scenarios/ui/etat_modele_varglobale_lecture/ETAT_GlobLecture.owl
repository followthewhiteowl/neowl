// État pur utilisé par test_etat_modele_varglobale_lecture.owl.
//
// Hérite de MOD_GlobLecture (voisin) : le champ lit la variable globale
// gMessage déclarée au top-level du modèle, sans la redéclarer.

ETAT_GlobLecture est un État
	Hérite de MOD_GlobLecture
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	Corps est un Corps
		PROPRIETES
			Hauteur = 40
		FIN

		LBL_Lit est un Champ Libellé
			PROPRIETES
				X       = 10
				Y       = 5
				Largeur = 100
				Hauteur = 10
				Libellé = "lit la globale du modele"
			FIN
			callback_observe("etat-lit:" + gMessage)
		FIN
	FIN
FIN
