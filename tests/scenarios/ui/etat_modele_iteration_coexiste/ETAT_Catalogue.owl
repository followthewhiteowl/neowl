// État pur utilisé par test_etat_modele_iteration_coexiste.owl.
//
// Hérite de MOD_Catalogue et déclare son propre bloc Itération
// (ITER_Etat). Les deux blocs Itération (modèle + état) coexistent
// sans fusion : chacun est imprimable indépendamment via
// iImprimeBloc, depuis la PROCEDURE Lecture.

ETAT_Catalogue est un État
	Hérite de MOD_Catalogue
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	Corps est un Corps
		PROPRIETES
			Hauteur = 40
		FIN
	FIN

	ITER_Etat est une Itération
		callback_observe("iteration-etat")
	FIN

	PROCEDURE Lecture()
		iImprimeBloc("ITER_Modele")
		iImprimeBloc("ITER_Etat")
	FIN
FIN
