// ReportTemplate pur 100% EN utilisé par test_etat_modele_bilingue_en.owl.
//
// Verrouille la forme EN du type (ReportTemplate) et de ses blocs
// canon (Body) dans un modèle de rapport pur.

MOD_BaseEN is a ReportTemplate
	PROPERTIES
		Format      = formatA4
		Orientation = orientPortrait
	END

	Body is a Body
		PROPERTIES
			Height = 40
		END

		LBL_BaseEN is a Field Label
			PROPERTIES
				X      = 10
				Y      = 10
				Width  = 100
				Height = 10
				Label  = "Template : base label"
			END
			callback_observe("template:" + LBL_BaseEN..Label)
		END
	END
END
