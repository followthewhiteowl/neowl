// Report pur 100% EN utilisé par test_etat_modele_bilingue_en.owl.
//
// Verrouille la forme EN du mot-clé d'héritage (Inherits) sur un
// Report qui hérite d'un ReportTemplate.

ETAT_ChildEN is a Report
	Inherits MOD_BaseEN
	PROPERTIES
		Format      = formatA4
		Orientation = orientPortrait
	END

	Body is a Body
		PROPERTIES
			Height = 40
		END

		LBL_ChildEN is a Field Label
			PROPERTIES
				X      = 10
				Y      = 25
				Width  = 100
				Height = 10
				Label  = "Report : child label"
			END
			callback_observe("report:" + LBL_ChildEN..Label)
		END
	END
END
