// Fenêtre voisine — ressource pour test_widget_nom_accentue.owl.
// Plusieurs champs à nom accentué pour exercer la résolution
// accent-insensible dans vm.globals.

FEN_TestWidgets est une Fenêtre
	PROPRIETES
		Titre       = "Test noms champs accentués"
		Largeur     = 800
		Hauteur     = 600
		Disposition = dispLibre
	FIN

	// === Section 1 : champ Table accentué (cas nominal du bug) ===
	TAB_Données est un Champ Table
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 300
			Hauteur = 200
		FIN

		COL_A est une Colonne
			PROPRIETES
				Libellé = "A"
			FIN
		FIN
	FIN

	// === Section 2 : cross-form, déclaré accentué (accédé sans accent côté test) ===
	TAB_Résultats est un Champ Table
		PROPRIETES
			X       = 10
			Y       = 220
			Largeur = 300
			Hauteur = 100
		FIN

		COL_A est une Colonne
			PROPRIETES
				Libellé = "A"
			FIN
		FIN
	FIN

	// === Section 3 : cross-form inverse, déclaré sans accent (accédé avec tréma côté test) ===
	TAB_Clients est un Champ Table
		PROPRIETES
			X       = 320
			Y       = 10
			Largeur = 300
			Hauteur = 100
		FIN

		COL_A est une Colonne
			PROPRIETES
				Libellé = "A"
			FIN
		FIN
	FIN

	// === Section 4 : autre champ que Table — Combo accentué ===
	CMB_Données est un Champ Combo
		PROPRIETES
			X       = 320
			Y       = 120
			Largeur = 200
			Hauteur = 30
		FIN
	FIN

	// === Section 6 (non-régression) : champs sans accent dans la même fenêtre ===
	TAB_Produits est un Champ Table
		PROPRIETES
			X       = 320
			Y       = 160
			Largeur = 300
			Hauteur = 100
		FIN

		COL_A est une Colonne
			PROPRIETES
				Libellé = "A"
			FIN
		FIN
	FIN

	CMB_Statuts est un Champ Combo
		PROPRIETES
			X       = 320
			Y       = 270
			Largeur = 200
			Hauteur = 30
		FIN
	FIN
FIN
