// Fenêtre voisine — ressource pour test_champ_arbre_selection_mono_nonregression.owl.
//
// Un Arbre SANS la propriété Multisélection déclarée (donc en mode mono par
// défaut), pour verrouiller que l'arrivée de la multi-sélection ne change
// rien au comportement historique.

FEN_ArbreSelectionMono est une Fenêtre
	PROPRIETES
		Titre       = "Sélection mono"
		Disposition = dispLibre
		Largeur     = 300
		Hauteur     = 300
	FIN

	ARBRE_Mono est un Champ Arbre
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 260
			Hauteur = 260
		FIN
	FIN
FIN
