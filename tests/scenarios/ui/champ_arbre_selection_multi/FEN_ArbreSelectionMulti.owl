// Fenêtre voisine — ressource pour test_champ_arbre_selection_multi.owl.
//
// Un Arbre avec Multisélection = Vrai, pour exercer l'accumulation de la
// sélection (ArbreSelectPlus/Moins) et son itération par rang
// (ArbreSelectOccurrence / ArbreSelect avec rang).

FEN_ArbreSelectionMulti est une Fenêtre
	PROPRIETES
		Titre       = "Sélection multiple"
		Disposition = dispLibre
		Largeur     = 300
		Hauteur     = 300
	FIN

	ARBRE_Multi est un Champ Arbre
		PROPRIETES
			X              = 10
			Y              = 10
			Largeur        = 260
			Hauteur        = 260
			Multisélection = Vrai
		FIN
	FIN
FIN
