// Modèle d'état pur utilisé par test_etat_modele_heritage_champs.owl.
//
// Déclare un Corps avec un champ Libellé. ETAT_Facture (voisin) hérite
// de ce modèle : le champ du modèle doit être présent à l'impression
// de l'état, fusionné dans le même bloc Corps que les champs propres
// de l'état.

MOD_Facture est un ModèleÉtat
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	Corps est un Corps
		PROPRIETES
			Hauteur = 40
		FIN

		LBL_Entete est un Champ Libellé
			PROPRIETES
				X       = 10
				Y       = 5
				Largeur = 100
				Hauteur = 10
				Libellé = "Modele : entete facture"
			FIN
			callback_observe("modele:" + LBL_Entete..Libellé)
		FIN
	FIN
FIN
