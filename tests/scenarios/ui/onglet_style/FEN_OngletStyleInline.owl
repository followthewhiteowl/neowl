// Fenêtre voisine de test_onglet_style.owl.
// Forme INLINE littérale : `Style = { CadreExtérieur = { CouleurFond = ... },
// VoletActif = {...}, VoletInactif = {...} }`, miroir de
// FEN_MenuStyleProprieteInline.owl.

FEN_OngletStyleInline est une Fenêtre
	PROPRIETES
		Titre       = "Onglet stylé (inline)"
		Largeur     = 500
		Hauteur     = 400
		Disposition = dispLibre
	FIN

	ONG_StyléInline est un Champ Onglet
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 460
			Hauteur = 340
			Valeur  = 1

			Style = {
				CadreExtérieur = {
					CouleurFond = GrisClair
				}
				VoletActif = {
					CouleurFond = Blanc
					Couleur     = Noir
				}
				VoletInactif = {
					CouleurFond = GrisClair
					Couleur     = GrisFoncé
				}
			}
		FIN

		VOL_Profil est un Volet
			PROPRIETES
				Libellé     = "Profil"
				Disposition = dispLibre
			FIN
		FIN

		VOL_Options est un Volet
			PROPRIETES
				Libellé     = "Options"
				Disposition = dispLibre
			FIN
		FIN
	FIN
FIN
