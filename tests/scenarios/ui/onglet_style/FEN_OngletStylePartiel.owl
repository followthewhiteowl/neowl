// Fenêtre voisine de test_onglet_style.owl.
// Style partiel : seules deux props sont posées (CadreExtérieur..CouleurFond
// et VoletActif..Etats[survol]..CouleurFond). Le reste doit se replier sur
// le défaut sans casser la compilation (fallback), même pattern que
// FEN_MenuStylePartiel.owl.

FEN_OngletStylePartiel est une Fenêtre
	PROPRIETES
		Titre       = "Onglet partiellement stylé"
		Largeur     = 400
		Hauteur     = 300
		Disposition = dispLibre
	FIN

	ONG_Partiel est un Champ Onglet
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 380
			Hauteur = 250
			Valeur  = 1

			Style..CadreExtérieur..CouleurFond            = GrisClair
			Style..VoletActif..Etats[survol]..CouleurFond = Bleu
		FIN

		VOL_Aide est un Volet
			PROPRIETES
				Libellé     = "Aide"
				Disposition = dispLibre
			FIN
		FIN
	FIN
FIN
