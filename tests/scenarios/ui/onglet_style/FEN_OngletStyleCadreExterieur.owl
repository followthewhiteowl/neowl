// Fenêtre voisine de test_onglet_style.owl. Bordure posée sur le
// pane via le sous-élément CadreExtérieur (type styleCadreExtérieur, comme
// les autres champs stylés OWL) : Cadre..Couleur, Cadre..Épaisseur et
// Cadre..Arrondi, en plus de CouleurFond.

FEN_OngletStyleCadreExterieur est une Fenêtre
	PROPRIETES
		Titre       = "Onglet stylé (bordure)"
		Largeur     = 460
		Hauteur     = 340
		Disposition = dispLibre
	FIN

	ONG_Bordure est un Champ Onglet
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 420
			Hauteur = 280
			Valeur  = 1

			Style..CadreExtérieur..CouleurFond      = GrisClair
			Style..CadreExtérieur..Cadre..Couleur   = Bleu
			Style..CadreExtérieur..Cadre..Epaisseur = 3
			Style..CadreExtérieur..Cadre..Arrondi   = 8
		FIN

		VOL_Profil est un Volet
			PROPRIETES
				Libellé     = "Profil"
				Disposition = dispLibre
			FIN
		FIN
	FIN
FIN
