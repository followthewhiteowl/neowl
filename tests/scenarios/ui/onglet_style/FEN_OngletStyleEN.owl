// Fenêtre voisine de test_onglet_style.owl.
// Équivalent EN complet de la forme ligne-par-ligne :
// Tab/PROPERTIES/Style/OuterFrame/ActivePane/InactivePane/States[hover].

FEN_OngletStyleEN is a Window
	PROPERTIES
		Title  = "Styled tab"
		Width  = 500
		Height = 400
		Layout = dispFree
	FIN

	ONG_StyledEN is a Field Tab
		PROPERTIES
			X      = 10
			Y      = 10
			Width  = 460
			Height = 340
			Value  = 1

			Style..OuterFrame..BackgroundColor = LightGray

			Style..ActivePane..BackgroundColor                = White
			Style..ActivePane..Color                          = Black
			Style..ActivePane..Font..Bold                     = True
			Style..ActivePane..States[hover]..BackgroundColor = Blue
			Style..ActivePane..States[hover]..Color           = White

			Style..InactivePane..BackgroundColor                = LightGray
			Style..InactivePane..Color                          = DarkGray
			Style..InactivePane..States[hover]..BackgroundColor = LightYellow
			Style..InactivePane..States[hover]..Color           = Black
		FIN

		VOL_Profile is a Pane
			PROPERTIES
				Caption = "Profile"
				Layout  = dispFree
			FIN
		FIN

		VOL_Options is a Pane
			PROPERTIES
				Caption = "Options"
				Layout  = dispFree
			FIN
		FIN
	FIN
FIN
