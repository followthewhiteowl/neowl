// Fenêtre voisine de test_onglet_style.owl. Équivalent EN de
// l'arrondi des languettes (ActivePane/InactivePane..CornerRadius).

FEN_OngletStyleVoletArrondiEN is a Window
	PROPERTIES
		Title  = "Styled tab (rounded corners)"
		Width  = 460
		Height = 340
		Layout = dispFree
	FIN

	ONG_RoundedEN is a Field Tab
		PROPERTIES
			X      = 10
			Y      = 10
			Width  = 420
			Height = 280
			Value  = 1

			Style..ActivePane..CornerRadius   = 8
			Style..InactivePane..CornerRadius = 8
		FIN

		VOL_ProfileEN is a Pane
			PROPERTIES
				Caption = "Profile"
				Layout  = dispFree
			FIN
		FIN

		VOL_OptionsEN is a Pane
			PROPERTIES
				Caption = "Options"
				Layout  = dispFree
			FIN
		FIN
	FIN
FIN
