// Fenêtre voisine de test_onglet_style.owl. Arrondi des
// languettes du Champ Onglet (VoletActif/VoletInactif), en plus de l'arrondi
// déjà accepté sur le cadre du pane (CadreExtérieur..Cadre..Arrondi).

FEN_OngletStyleVoletArrondi est une Fenêtre
	PROPRIETES
		Titre       = "Onglet stylé (languettes arrondies)"
		Largeur     = 460
		Hauteur     = 340
		Disposition = dispLibre
	FIN

	ONG_Arrondi est un Champ Onglet
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 420
			Hauteur = 280
			Valeur  = 1

			Style..VoletActif..Arrondi   = 8
			Style..VoletInactif..Arrondi = 8
		FIN

		VOL_Profil est un Volet
			PROPRIETES
				Libellé     = "Profil"
				Disposition = dispLibre
			FIN
		FIN

		VOL_Options est un Volet
			PROPRIETES
				Libellé     = "Options"
				Disposition = dispLibre
			FIN
		FIN
	FIN
FIN
