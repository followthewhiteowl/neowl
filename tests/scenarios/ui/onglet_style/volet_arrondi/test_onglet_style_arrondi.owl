// Arrondi de la forme des languettes du Champ Onglet
// (Style..VoletActif..Arrondi / Style..VoletInactif..Arrondi, bilingue
// Arrondi/CornerRadius). Même patron que test_onglet_style.owl : compile +
// ouverture sans erreur, le rendu (coins arrondis en haut des languettes)
// relève de la vérification visuelle hors-portée headless.

TestModeHeadless(Vrai)

PROCEDURE PUBLIQUE scenario_onglet_style_volet_arrondi_compile()
	Ouvre(FEN_OngletStyleVoletArrondi)
	dbgVérifieFaux(ErreurDétectée, "Champ Onglet avec languettes arrondies (VoletActif/VoletInactif..Arrondi) : ouverture sans erreur")
	Ferme(FEN_OngletStyleVoletArrondi)
FIN

PROCEDURE PUBLIQUE scenario_onglet_style_volet_arrondi_bilingue_en_compile()
	Ouvre(FEN_OngletStyleVoletArrondiEN)
	dbgVérifieFaux(ErreurDétectée, "Field TAB avec languettes arrondies EN (ActivePane/InactivePane..CornerRadius) : ouverture sans erreur")
	Ferme(FEN_OngletStyleVoletArrondiEN)
FIN
