// Fenêtre voisine de test_onglet_style.owl. Équivalent EN de
// FEN_OngletStyleCadreExterieur.owl : OuterFrame/Border/Color/Thickness/
// CornerRadius.

FEN_OngletStyleCadreExterieurEN is a Window
	PROPERTIES
		Title  = "Styled tab (border)"
		Width  = 460
		Height = 340
		Layout = dispFree
	FIN

	ONG_BorderEN is a Field Tab
		PROPERTIES
			X      = 10
			Y      = 10
			Width  = 420
			Height = 280
			Value  = 1

			Style..OuterFrame..BackgroundColor      = LightGray
			Style..OuterFrame..Border..Color        = Blue
			Style..OuterFrame..Border..Thickness    = 3
			Style..OuterFrame..Border..CornerRadius = 8
		FIN

		VOL_ProfileEN is a Pane
			PROPERTIES
				Caption = "Profile"
				Layout  = dispFree
			FIN
		FIN
	FIN
FIN
