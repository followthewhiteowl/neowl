// Style typé du Champ Onglet (styleOnglet/
// styleTab) : couvre la forme ligne-par-ligne, la forme partielle
// (fallback), la forme inline littérale, l'équivalent bilingue EN, et la
// bordure du pane posée via le sous-élément CadreExtérieur (FR/EN). Ce
// scénario ne vérifie QUE la compilation + l'ouverture sans erreur (rendu
// QSS = validation visuelle, hors-portée headless), même patron que
// test_menu_classique_style.owl.
//
// Le fond du pane n'est pas une propriété scalaire à la racine du style
// Onglet : il est rangé sous le sous-élément CadreExtérieur
// (styleCadreExtérieur, comme les autres champs stylés OWL).

TestModeHeadless(Vrai)

PROCEDURE PUBLIQUE scenario_onglet_style_complet_compile()
	Ouvre(FEN_OngletStyleComplet)
	dbgVérifieFaux(ErreurDétectée, "Champ Onglet avec Style complet (racine+VoletActif+VoletInactif, base+Etats[survol]) : ouverture sans erreur")
	Ferme(FEN_OngletStyleComplet)
FIN

PROCEDURE PUBLIQUE scenario_onglet_style_partiel_compile()
	Ouvre(FEN_OngletStylePartiel)
	dbgVérifieFaux(ErreurDétectée, "Champ Onglet avec Style partiel (2 props posées seulement) : compile et s'ouvre, le reste retombe au défaut")
	Ferme(FEN_OngletStylePartiel)
FIN

PROCEDURE PUBLIQUE scenario_onglet_style_inline_compile()
	Ouvre(FEN_OngletStyleInline)
	dbgVérifieFaux(ErreurDétectée, "Champ Onglet avec Style en littéral inline : ouverture sans erreur")
	Ferme(FEN_OngletStyleInline)
FIN

PROCEDURE PUBLIQUE scenario_onglet_style_bilingue_en_compile()
	Ouvre(FEN_OngletStyleEN)
	dbgVérifieFaux(ErreurDétectée, "Field Tab avec Style EN (ActivePane/InactivePane, States[hover]) : ouverture sans erreur")
	Ferme(FEN_OngletStyleEN)
FIN

PROCEDURE PUBLIQUE scenario_onglet_style_cadre_exterieur_compile()
	Ouvre(FEN_OngletStyleCadreExterieur)
	dbgVérifieFaux(ErreurDétectée, "Champ Onglet avec bordure du pane via CadreExtérieur (CouleurFond, Cadre..Couleur/Épaisseur/Arrondi) : ouverture sans erreur")
	Ferme(FEN_OngletStyleCadreExterieur)
FIN

PROCEDURE PUBLIQUE scenario_onglet_style_cadre_exterieur_bilingue_en_compile()
	Ouvre(FEN_OngletStyleCadreExterieurEN)
	dbgVérifieFaux(ErreurDétectée, "Field TAB avec bordure du pane via OuterFrame (BackgroundColor, Border..Color/Thickness/CornerRadius) : ouverture sans erreur")
	Ferme(FEN_OngletStyleCadreExterieurEN)
FIN
