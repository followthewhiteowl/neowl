// Fenêtre voisine de test_onglet_style.owl
// (pattern split canon strict). Un Champ Onglet complet :
// fond du pane rangé sous le sous-élément CadreExtérieur (comme les autres
// champs stylés OWL), en-tête du volet affiché (VoletActif) et en-têtes des
// volets non affichés (VoletInactif), chacun avec sa base ET son état
// survol, via la propriété universelle `Style` du bloc PROPRIETES.

FEN_OngletStyleComplet est une Fenêtre
	PROPRIETES
		Titre       = "Onglet stylé"
		Largeur     = 500
		Hauteur     = 400
		Disposition = dispLibre
	FIN

	ONG_Stylé est un Champ Onglet
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 460
			Hauteur = 340
			Valeur  = 1

			Style..CadreExtérieur..CouleurFond = GrisClair

			Style..VoletActif..CouleurFond                = Blanc
			Style..VoletActif..Couleur                    = Noir
			Style..VoletActif..Police..Gras               = Vrai
			Style..VoletActif..Etats[survol]..CouleurFond = Bleu
			Style..VoletActif..Etats[survol]..Couleur     = Blanc

			Style..VoletInactif..CouleurFond                = GrisClair
			Style..VoletInactif..Couleur                    = GrisFoncé
			Style..VoletInactif..Police..Gras               = Faux
			Style..VoletInactif..Etats[survol]..CouleurFond = JauneClair
			Style..VoletInactif..Etats[survol]..Couleur     = Noir
		FIN

		VOL_Profil est un Volet
			PROPRIETES
				Libellé     = "Profil"
				Disposition = dispLibre
			FIN
		FIN

		VOL_Options est un Volet
			PROPRIETES
				Libellé     = "Options"
				Disposition = dispLibre
			FIN
		FIN
	FIN
FIN
