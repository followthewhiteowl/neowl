// Fenêtre voisine — ressource pure pour test_indirection_scope.owl.
// Sert de support à l'indirection scopée ({nom, indXxx}..prop) : une
// fenêtre nommée avec une largeur déclarée, et un champ nommé avec un
// libellé déclaré, tous les deux lisibles en mode headless.

FEN_IndirectionScope est une Fenêtre
	PROPRIETES
		Titre       = "Cible"
		Largeur     = 417
		Hauteur     = 233
		Disposition = dispLibre
	FIN

	LIB_IndirectionScope est un Champ Libellé
		PROPRIETES
			Libellé = "Texte cible"
			X       = 10
			Y       = 10
			Largeur = 222
			Hauteur = 20
		FIN
	FIN
FIN
