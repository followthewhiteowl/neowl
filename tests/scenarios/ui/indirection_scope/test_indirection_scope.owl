// @sujet : indirection scopée — {nom, indWindow}..prop / {nom, indChamp}..prop
// @résumé : le scope d'une indirection dirige la résolution vers une
// fenêtre ({nom, indWindow} / {nom, indFenêtre}) ou un champ ({nom,
// indChamp}) désignés par un nom calculé dynamiquement, comme une
// fenêtre dont le nom est stocké dans une variable globale.
//
// La fenêtre voisine FEN_IndirectionScope.owl porte la déclaration
// (Fenêtre + Champ Libellé).

TestModeHeadless(Vrai)

nomFenetreIndirectionScope est une chaîne = "FEN_IndirectionScope"
nomChampIndirectionScope est une chaîne = "LIB_IndirectionScope"


PROCEDURE PUBLIQUE scenario_indirection_scope_indwindow_resout_fenetre_par_nom()
	Ouvre(FEN_IndirectionScope)

	n est un entier = {nomFenetreIndirectionScope, indWindow}..Largeur
	dbgVérifieEgalité(n, 417, "{nom, indWindow}..Largeur résout la fenêtre nommée dynamiquement")

	Ferme(FEN_IndirectionScope)
FIN


PROCEDURE PUBLIQUE scenario_indirection_scope_indfenetre_resout_fenetre_par_nom()
	Ouvre(FEN_IndirectionScope)

	n est un entier = {nomFenetreIndirectionScope, indFenêtre}..Largeur
	dbgVérifieEgalité(n, 417, "{nom, indFenêtre}..Largeur résout la fenêtre nommée dynamiquement (forme FR)")

	Ferme(FEN_IndirectionScope)
FIN


PROCEDURE PUBLIQUE scenario_indirection_scope_indchamp_resout_champ_par_nom()
	Ouvre(FEN_IndirectionScope)

	s est une chaîne = {nomChampIndirectionScope, indChamp}..Libellé
	dbgVérifieEgalité(s, "Texte cible", "{nom, indChamp}..Libellé résout le champ nommé dynamiquement (forme FR)")

	Ferme(FEN_IndirectionScope)
FIN
