// État pur utilisé par test_etat_modele_ancetre_champ.owl.
//
// Surcharge LBL_Calc (hérité de MOD_Ancetre) et appelle Ancêtre() dans
// son propre code : le code du modèle doit s'exécuter, suivi du code
// propre de l'état.

ETAT_AncetrePresent est un État
	Hérite de MOD_Ancetre
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	Corps est un Corps
		PROPRIETES
			Hauteur = 40
		FIN

		LBL_Calc est un Champ Libellé
			PROPRIETES
				Libellé = "Etat : calcul etendu"
			FIN
			Ancêtre()
			callback_observe("code-etat-avec-ancetre")
		FIN
	FIN
FIN
