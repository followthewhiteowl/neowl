// État pur utilisé par test_etat_modele_ancetre_champ.owl.
//
// Surcharge LBL_Calc (hérité de MOD_Ancetre) SANS appeler Ancêtre() :
// le code du modèle doit être ignoré, seul le code propre de l'état
// s'exécute.

ETAT_AncetreOmis est un État
	Hérite de MOD_Ancetre
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	Corps est un Corps
		PROPRIETES
			Hauteur = 40
		FIN

		LBL_Calc est un Champ Libellé
			PROPRIETES
				Libellé = "Etat : calcul isole"
			FIN
			callback_observe("code-etat-sans-ancetre")
		FIN
	FIN
FIN
