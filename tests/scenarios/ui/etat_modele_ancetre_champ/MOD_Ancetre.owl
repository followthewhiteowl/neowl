// Modèle d'état pur utilisé par test_etat_modele_ancetre_champ.owl.
//
// Déclare un champ LBL_Calc dont le code (après PROPRIETES) notifie le
// script test. Deux états voisins héritent de ce même modèle et
// surchargent LBL_Calc : l'un appelle Ancêtre() dans son code, l'autre
// pas.

MOD_Ancetre est un ModèleÉtat
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	Corps est un Corps
		PROPRIETES
			Hauteur = 40
		FIN

		LBL_Calc est un Champ Libellé
			PROPRIETES
				X       = 10
				Y       = 10
				Largeur = 100
				Hauteur = 10
				Libellé = "Modele : calcul de base"
			FIN
			callback_observe("code-modele")
		FIN
	FIN
FIN
