// Fenêtre voisine — ressource pour test_champ_arbre_insertion_parcours.owl.
//
// Un Arbre mono-colonne peuplé par chemins TAB-séparés, utilisé pour vérifier
// l'insertion positionnée et le parcours ordonné des fils directs.

FEN_ArbreInsertionParcours est une Fenêtre
	PROPRIETES
		Titre       = "Insertion et parcours"
		Disposition = dispLibre
		Largeur     = 300
		Hauteur     = 300
	FIN

	ARBRE_Categories est un Champ Arbre
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 260
			Hauteur = 260
		FIN
	FIN
FIN
