// Un Arbre mono-colonne peuplé par chemins TAB-séparés, utilisé pour vérifier
// la recherche par libellé (ArbreCherche) et le tri alphabétique (ArbreTrie).

FEN_ArbreRechercheTri est une Fenêtre
	PROPRIETES
		Titre       = "Recherche et tri"
		Disposition = dispLibre
		Largeur     = 300
		Hauteur     = 300
	FIN

	ARBRE_Categories est un Champ Arbre
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 260
			Hauteur = 260
		FIN
	FIN
FIN
