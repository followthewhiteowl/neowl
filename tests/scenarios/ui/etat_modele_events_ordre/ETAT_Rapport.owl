// État pur utilisé par test_etat_modele_events_ordre.owl.
//
// Hérite de MOD_Rapport : le code d'ouverture doit s'exécuter APRES
// celui du modèle (modèle d'abord), et la Fermeture doit s'exécuter
// AVANT celle du modèle (ordre inverse : l'état d'abord, puis le modèle).

ETAT_Rapport est un État
	Hérite de MOD_Rapport
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	Corps est un Corps
		PROPRIETES
			Hauteur = 40
		FIN
	FIN

	callback_observe("ouverture-etat")

	PROCEDURE Fermeture()
		callback_observe("fermeture-etat")
	FIN
FIN
