// Neighbor window — used by test_menu_classique_fenetre_en.owl.
// Classic window menu, English canon forms:
// MainMenu / Submenu / MenuOption / MenuSeparator / Caption / Shortcut
// / onSelection.

FEN_MenuClassiqueEN est une Fenêtre
	PROPRIETES
		Titre       = "Application"
		Largeur     = 600
		Hauteur     = 400
		Disposition = dispLibre
		MainMenu    = MNU_Main
	FIN

	MNU_Main est un MainMenu
		SM_File est un Submenu
			PROPRIETES
				Caption = "&File"
			FIN

			OPT_New est une MenuOption
				PROPRIETES
					Caption  = "&New"
					Shortcut = "Ctrl+N"
				FIN

				PROCEDURE onSelection()
					nNewCount += 1
				FIN
			FIN

			SEP_File1 est un MenuSeparator
			FIN

			OPT_Quit est une MenuOption
				PROPRIETES
					Caption = "&Quit"
				FIN

				PROCEDURE onSelection()
					nQuitCount += 1
				FIN
			FIN
		FIN
	FIN

	nNewCount est un entier = 0
	nQuitCount est un entier = 0

	PROCEDURE LireCompteursMenuEN()
		cb_menu_en_compteurs(nNewCount, nQuitCount)
	FIN
FIN
