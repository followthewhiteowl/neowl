// Ressource fenetre — voisin de test_menu_classique_fenetre.owl.
// Menu classique de fenêtre. MenuPrincipal déclaré comme bloc enfant de
// la fenêtre, puis affecté via `MenuPrincipal = MNU_X` dans
// PROPRIETES. Arbre : 2 SousMenu top-level, un sous-menu imbriqué, des
// OptionMenu avec surSélection et Raccourci, un MenuSéparateur, Libellé
// simple ET multilingue.

FEN_MenuClassique est une Fenêtre
	PROPRIETES
		Titre         = "Application"
		Largeur       = 600
		Hauteur       = 400
		Disposition   = dispLibre
		MenuPrincipal = MNU_Principal
	FIN

	MNU_Principal est un MenuPrincipal
		SM_Fichier est un SousMenu
			PROPRIETES
				Libellé = "&Fichier"
			FIN

			OPT_Nouveau est une OptionMenu
				PROPRIETES
					Libellé   = "&Nouveau"
					Raccourci = "Ctrl+N"
				FIN

				PROCEDURE surSélection()
					nNouveauCount += 1
				FIN
			FIN

			SEP_Fichier1 est un MenuSéparateur
			FIN

			OPT_Quitter est une OptionMenu
				PROPRIETES
					Libellé = {langueFrançais: "&Quitter", langueAnglais: "&Quit"}
				FIN

				PROCEDURE surSélection()
					nQuitterCount += 1
				FIN
			FIN
		FIN

		SM_Édition est un SousMenu
			PROPRIETES
				Libellé = "&Édition"
			FIN

			SM_Avancé est un SousMenu
				PROPRIETES
					Libellé = "Avancé"
				FIN

				OPT_Copier est une OptionMenu
					PROPRIETES
						Libellé = "&Copier"
					FIN

					PROCEDURE surSélection()
						nCopierCount += 1
					FIN
				FIN
			FIN
		FIN
	FIN

	nNouveauCount est un entier = 0
	nQuitterCount est un entier = 0
	nCopierCount est un entier = 0

	PROCEDURE LireCompteursMenu()
		cb_menu_compteurs(nNouveauCount, nQuitterCount, nCopierCount)
	FIN
FIN
