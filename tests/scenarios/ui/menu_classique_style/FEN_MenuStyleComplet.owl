// Fenêtre voisine de test_menu_classique_style.owl (pattern split
// canon strict). Un MenuPrincipal complet : les 3 surfaces
// stylées (Barre, SousMenu, OptionMenu) posent leur base ET un état survol,
// via la propriété universelle `Style` du bloc PROPRIETES.

FEN_MenuStyleComplet est une Fenêtre
	PROPRIETES
		Titre         = "Menu stylé"
		Largeur       = 600
		Hauteur       = 400
		Disposition   = dispLibre
		MenuPrincipal = MNU_Stylé
	FIN

	MNU_Stylé est un MenuPrincipal
		PROPRIETES
			Style..Barre..CouleurFond                = Bleu
			Style..Barre..Couleur                    = Blanc
			Style..Barre..Police..Gras               = Vrai
			Style..Barre..Etats[survol]..CouleurFond = JauneClair
			Style..Barre..Etats[survol]..Couleur     = Noir

			Style..SousMenu..CouleurFond       = GrisClair
			Style..SousMenu..CouleurSéparateur = GrisFoncé
			Style..SousMenu..Arrondi           = 8
			Style..SousMenu..Epaisseur         = 2
			Style..SousMenu..CouleurBordure    = GrisFoncé

			Style..OptionMenu..CouleurFond                = Blanc
			Style..OptionMenu..Couleur                    = Noir
			Style..OptionMenu..Police..Gras               = Faux
			Style..OptionMenu..Etats[survol]..CouleurFond = Bleu
			Style..OptionMenu..Etats[survol]..Couleur     = Blanc
		FIN

		SM_Fichier est un SousMenu
			PROPRIETES
				Libellé = "&Fichier"
			FIN

			OPT_Quitter est une OptionMenu
				PROPRIETES
					Libellé = "&Quitter"
				FIN
			FIN
		FIN
	FIN
FIN
