// Fenêtre voisine de test_menu_classique_style.owl. Équivalent EN
// complet : MainMenu/Bar/Submenu/MenuOption, States[hover], BackgroundColor/
// Color/Font/Bold/SeparatorColor, via la propriété `Style` du bloc PROPERTIES.

FEN_MenuStyleEN is a Window
	PROPERTIES
		Title    = "Styled menu"
		Width    = 600
		Height   = 400
		Layout   = dispFree
		MainMenu = MNU_StyledEN
	FIN

	MNU_StyledEN is a MainMenu
		PROPERTIES
			Style..Bar..BackgroundColor                = Blue
			Style..Bar..Color                          = White
			Style..Bar..Font..Bold                     = True
			Style..Bar..States[hover]..BackgroundColor = LightYellow
			Style..Bar..States[hover]..Color           = Black

			Style..Submenu..BackgroundColor = LightGray
			Style..Submenu..SeparatorColor  = DarkGray
			Style..Submenu..CornerRadius    = 8
			Style..Submenu..Thickness       = 2
			Style..Submenu..BorderColor     = DarkGray

			Style..MenuOption..BackgroundColor                = White
			Style..MenuOption..Color                          = Black
			Style..MenuOption..Font..Bold                     = False
			Style..MenuOption..States[hover]..BackgroundColor = Blue
			Style..MenuOption..States[hover]..Color           = White
		FIN

		SM_File is a Submenu
			PROPERTIES
				Caption = "&File"
			FIN

			OPT_Quit is a MenuOption
				PROPERTIES
					Caption = "&Quit"
				FIN
			FIN
		FIN
	FIN
FIN
