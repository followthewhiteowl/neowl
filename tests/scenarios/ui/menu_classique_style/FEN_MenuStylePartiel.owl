// Fenêtre voisine de test_menu_classique_style.owl. Style partiel :
// seules deux props sont posées (Barre..CouleurFond et OptionMenu..Etats[survol]
// ..CouleurFond). Le reste doit se replier sur le défaut sans casser la
// compilation (fallback).

FEN_MenuStylePartiel est une Fenêtre
	PROPRIETES
		Titre         = "Menu partiellement stylé"
		Largeur       = 400
		Hauteur       = 300
		Disposition   = dispLibre
		MenuPrincipal = MNU_Partiel
	FIN

	MNU_Partiel est un MenuPrincipal
		PROPRIETES
			Style..Barre..CouleurFond                     = Bleu
			Style..OptionMenu..Etats[survol]..CouleurFond = JauneClair
		FIN

		SM_Aide est un SousMenu
			PROPRIETES
				Libellé = "&Aide"
			FIN

			OPT_Apropos est une OptionMenu
				PROPRIETES
					Libellé = "&À propos"
				FIN
			FIN
		FIN
	FIN
FIN
