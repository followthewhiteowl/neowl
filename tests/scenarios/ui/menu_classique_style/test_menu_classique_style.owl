// styleMenuPrincipal : le Style typé (Barre/SousMenu/
// OptionMenu) devient accepté sur un MenuPrincipal. Ce scénario ne vérifie
// QUE la compilation + l'ouverture sans erreur (rendu QSS = validation
// visuelle, hors-portée headless) : style complet, style partiel (fallback
// sur les props non posées) et équivalent bilingue EN.

TestModeHeadless(Vrai)

PROCEDURE PUBLIQUE scenario_menu_style_complet_compile()
	Ouvre(FEN_MenuStyleComplet)
	dbgVérifieFaux(ErreurDétectée, "MenuPrincipal avec Style complet (Barre+SousMenu+OptionMenu, base+Etats[survol]) : ouverture sans erreur")
	Ferme(FEN_MenuStyleComplet)
FIN

PROCEDURE PUBLIQUE scenario_menu_style_partiel_compile()
	Ouvre(FEN_MenuStylePartiel)
	dbgVérifieFaux(ErreurDétectée, "MenuPrincipal avec Style partiel (2 props posées seulement) : compile et s'ouvre, le reste retombe au défaut")
	Ferme(FEN_MenuStylePartiel)
FIN

PROCEDURE PUBLIQUE scenario_menu_style_bilingue_en_compile()
	Ouvre(FEN_MenuStyleEN)
	dbgVérifieFaux(ErreurDétectée, "MainMenu avec MainMenuStyle (Bar/Submenu/MenuOption EN, States[hover]) : ouverture sans erreur")
	Ferme(FEN_MenuStyleEN)
FIN
