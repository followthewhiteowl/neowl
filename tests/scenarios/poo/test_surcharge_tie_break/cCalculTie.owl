// Deux syntaxes de meme arite dont AUCUNE ne matche exactement l'argument :
// l'argument (chaine) est coercible vers les deux (reel ET entier), rang egal.
cCalculTie est une Classe
PUBLIC
	PROCEDURE M(x est un réel) : chaîne
		RENVOYER "premiere_reel"
	FIN

	PROCEDURE M(x est un entier) : chaîne
		RENVOYER "seconde_entier"
	FIN
FIN
