// Classe voisine — ressource pour test_membre_classe_chaine_multilingue.owl.
// Membre typé chaîne recevant une chaîneMultilingue (littéral ou variable
// via paramètre typé chaîne) : la règle d'aplatissement de la cible
// s'applique aussi bien à l'intérieur d'une classe qu'à une variable ou un
// champ de structure.
cMembreTexte est une Classe
PUBLIC
	sNom est une chaîne

	PROCEDURE DefinirNomDirect()
		:sNom = {langueFrançais: "bonjour", langueAnglais: "hello"}
	FIN

	PROCEDURE DefinirNomViaParametre(sTexte est une chaîne)
		:sNom = sTexte
	FIN

	// Deux paramètres typés chaîne — sert à vérifier que la coercition
	// d'un littéral multilingue s'applique aussi en 2e position, pas
	// seulement au 1er argument de l'appel.
	PROCEDURE DefinirNomViaDeuxParametres(sPrefixe est une chaîne, sTexte est une chaîne)
		:sNom = sPrefixe + sTexte
	FIN

	PROCEDURE LireNom() : chaîne
		RENVOYER :sNom
	FIN

	PROCEDURE LireTypeNom() : entier
		RENVOYER TypeVar(:sNom)
	FIN
FIN
