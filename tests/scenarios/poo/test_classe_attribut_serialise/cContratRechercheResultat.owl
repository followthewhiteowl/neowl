// Classe avec attributs <Sérialise> inline sur les membres, parité struct.
// Forme réelle issue de la conversion : l'attribut suit le type sur la même
// ligne, AVANT le Destructeur — reproduit la désynchronisation du parseur
// qui faisait passer le Destructeur pour une « méthode externe interdite ».
cContratRechercheResultat est une Classe
PUBLIC
	m_sContractNumber est une chaîne <Sérialise="contractNumber">
	m_sSecretInterne  est une chaîne <Sérialise=Faux>
	m_nScore          est un entier
	m_sLabel          est une chaîne

	PROCEDURE Constructeur()
		:m_nScore = 0
	FIN

	PROCEDURE Destructeur()
	FIN

	PROCEDURE LitLabel() : chaîne
		RENVOYER :m_sLabel
	FIN
FIN
