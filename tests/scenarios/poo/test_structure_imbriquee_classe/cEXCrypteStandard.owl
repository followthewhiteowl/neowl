// Classe declarant une Structure dans son corps : la structure sert de
// type a une variable locale dans les methodes de la classe.
cEXCrypteStandard est une Classe
PUBLIC
	imyVarIn est un entier

	stMyStruc est une Structure
		iVar est un entier
		svar est une chaîne
	FIN

	PROCEDURE Constructeur()
		:imyVarIn = 23
	FIN

	PROCEDURE CalculeIVar() : entier
		stvStruc est un stMyStruc
		stvStruc.iVar = :imyVarIn + 5
		RENVOYER stvStruc.iVar
	FIN

	PROCEDURE CalculeSVar() : chaîne
		stvStruc est un stMyStruc
		stvStruc.svar = "init-modifie"
		RENVOYER stvStruc.svar
	FIN
FIN
