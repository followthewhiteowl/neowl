// Classe declarant une Enumeration ET une Combinaison dans son corps.
// Les types imbriques servent de types utilisables (valeurs qualifiees et
// variables locales typees) dans les methodes de la classe.
cInScope est une Classe
PUBLIC
	imyVarIn est un entier

	eStatut est une Énumération
		Actif   = "A"
		Inactif = "I"
	FIN

	cDroits est une Combinaison
		Lecture
		Ecriture
		Suppression
	FIN

	PROCEDURE Constructeur()
		:imyVarIn = 7
	FIN

	// Valeur chaine sous-jacente d'un membre d'enum imbriquee (accesseur ..Valeur).
	PROCEDURE StatutActif() : chaîne
		RENVOYER eStatut.Actif..Valeur
	FIN

	PROCEDURE StatutInactif() : chaîne
		RENVOYER eStatut.Inactif..Valeur
	FIN

	// Combinaison imbriquee : valeurs puissances de 2 + operateur de cumul.
	PROCEDURE DroitLecture() : entier
		RENVOYER cDroits.Lecture..Valeur
	FIN

	PROCEDURE DroitsCumules() : entier
		d est un cDroits = cDroits.Lecture + cDroits.Suppression
		RENVOYER d..Valeur
	FIN
FIN
