// @sujet : Classe — enumeration et combinaison imbriquees dans le corps
// @resume : Une Classe peut declarer une Enumeration et une Combinaison dans
// son propre corps. Les types declares deviennent utilisables : valeurs
// qualifiees (Type.Membre), extraction de valeur sous-jacente, variable
// locale typee dans les methodes de la classe.

PROCEDURE PUBLIQUE scenario_enum_combi_imbriquees_classe()
	o est un cInScope()

	// Enumeration imbriquee : valeur chaine sous-jacente des membres.
	dbgVérifieEgalité(o.StatutActif(), "A", "membre d'enum imbriquee, valeur chaine Actif")
	dbgVérifieEgalité(o.StatutInactif(), "I", "membre d'enum imbriquee, valeur chaine Inactif")

	// Combinaison imbriquee : auto-valeurs puissances de 2 + cumul via +.
	dbgVérifieEgalité(o.DroitLecture(), 1, "membre de combinaison imbriquee, Lecture = 1")
	dbgVérifieEgalité(o.DroitsCumules(), 5, "cumul de combinaison imbriquee, Lecture + Suppression = 5")
FIN
