// @sujet : Interface — contrat de methodes verifie a la compilation
// @resume : Une interface declare un contrat : liste des methodes qu'une classe doit fournir. Une classe annonce qu'elle satisfait le contrat avec implemente. La conformite est verifiee a la compilation (signature + presence des methodes).

// Cas nominal : classe implementant une interface
PROCEDURE scenario_interface_conformite()
	oProduit est un cProduit("clavier", 29.99)

	// Appel de la methode contractuelle implementee : la valeur retournee
	// est le rendu concret produit par Afficher(), preuve observable que la
	// methode declaree par l'interface est bien celle executee sur l'objet.
	sRendu est une chaîne = oProduit.Afficher()

	dbgVérifieEgalité(sRendu, "clavier : 29.99",
	"Afficher() (contrat iAffichable) produit le rendu nom : prix")
FIN
