// Classe cProduit implementant iAffichable
cProduit est une Classe
	implemente iAffichable
PUBLIC
	sNom est une chaîne
	rPrix est un réel

	PROCEDURE Constructeur(nom est une chaîne, prix est un réel)
		:sNom = nom
		:rPrix = prix
	FIN

	// Implementation de la methode contractuelle
	PROCEDURE Afficher()
		RENVOYER :sNom + " : " + :rPrix
	FIN
FIN
