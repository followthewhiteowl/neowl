// Classe cFichier avec destructeur pour liberer ressources
cFichier est une Classe
PUBLIC
	sNom est une chaîne
	nHandle est un entier = 0

	PROCEDURE Constructeur(nom est une chaîne)
		:sNom = nom
		:nHandle = 1 // simule ouverture
		Trace("Fichier ouvert: " + :sNom)
	FIN

	PROCEDURE Destructeur()
		Trace("Fichier ferme: " + :sNom)
		:nHandle = 0
	FIN
FIN
