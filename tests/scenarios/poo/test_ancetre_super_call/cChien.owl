// Classe derivee cChien
cChien est une Classe
	Hérite de cAnimal
PUBLIC
	PROCEDURE Constructeur(nom est une chaîne)
		Constructeur cAnimal(nom)
	FIN

	PROCEDURE Crier()
		// Appel de la version parente avec Ancetre, puis on etend
		// son resultat au lieu de le remplacer.
		sHerite est une chaîne = Ancetre.Crier()
		RENVOYER sHerite + " + Wouf"
	FIN
FIN
