// @sujet : Ancêtre — appel de la version parente d'une methode
// @resume : Le mot-cle Ancêtre permet d'appeler explicitement la version definie dans la classe parente immediate. Utile pour etendre le comportement herite au lieu de le remplacer completement.

// Cas nominal : methode redefinie appelle la version parente
PROCEDURE scenario_super_call_ancetre()
	oChien est un cChien("Rex")

	// Appel de la methode redefinie : cChien.Crier() appelle Ancetre.Crier()
	// pour recuperer le comportement parent ("bruit generique"), puis ajoute
	// le sien ("Wouf"). Le resultat combine prouve que le super-call a bien
	// ete execute et que sa valeur a ete reutilisee.
	sCri est une chaîne = oChien.Crier()

	dbgVérifieEgalité(sCri, "bruit generique + Wouf",
	"Crier() combine le resultat de Ancetre.Crier() et son propre ajout")
FIN
