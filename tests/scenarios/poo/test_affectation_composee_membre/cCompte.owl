// Classe cCompte pour tester affectation composee sur membre
cCompte est une Classe
PUBLIC
	mSolde est un monétaire
	nOperations est un entier

	PROCEDURE Constructeur()
		:mSolde = 0
		:nOperations = 0
	FIN

	PROCEDURE Crediter(m est un monétaire)
		:mSolde += m
		:nOperations += 1
	FIN

	PROCEDURE Debiter(m est un monétaire)
		:mSolde -= m
		:nOperations += 1
	FIN

	PROCEDURE Solde() : monétaire
		RENVOYER :mSolde
	FIN

	PROCEDURE NbOperations() : entier
		RENVOYER :nOperations
	FIN

	PROCEDURE IncrementerCompteur()
		:nOperations++
	FIN

	PROCEDURE DecrementerCompteur()
		:nOperations--
	FIN
FIN
