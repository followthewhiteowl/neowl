// Classe implementant trois interfaces listees sur une seule clause,
// separees par des virgules, avec espaces tolere autour des virgules.
cX est une Classe
	implemente iUn,  iDeux ,iTrois
PUBLIC
	PROCEDURE Dit1() : chaîne
		RENVOYER "un"
	FIN

	PROCEDURE Dit2() : entier
		RENVOYER 2
	FIN

	PROCEDURE Dit3() : chaîne
		RENVOYER "trois"
	FIN
FIN
