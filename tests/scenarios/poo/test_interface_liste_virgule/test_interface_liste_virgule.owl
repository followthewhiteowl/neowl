// @sujet : Interface — liste separee par des virgules
// @resume : Une classe peut implementer plusieurs interfaces en les listant sur une seule clause implemente, separees par des virgules. Chaque interface est enregistree : l'operateur est renvoie Vrai pour chacune, et le contrat de chaque interface est verifie a la compilation.

PROCEDURE scenario_interface_liste_virgule()
	oX est un cX()

	// Les trois interfaces listees sur la clause virgule sont enregistrees.
	dbgVérifieVrai(oX est iUn, "cX implemente iUn (liste virgule)")
	dbgVérifieVrai(oX est iDeux, "cX implemente iDeux (liste virgule)")
	dbgVérifieVrai(oX est iTrois, "cX implemente iTrois (liste virgule)")

	// Les methodes de chaque interface sont bien resolues.
	dbgVérifieEgalité(oX.Dit1(), "un", "Dit1() de iUn")
	dbgVérifieEgalité(oX.Dit2(), 2, "Dit2() de iDeux")
	dbgVérifieEgalité(oX.Dit3(), "trois", "Dit3() de iTrois")
FIN
