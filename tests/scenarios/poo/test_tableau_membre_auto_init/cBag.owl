// Classe cBag avec un membre tableau jamais initialise explicitement
cBag est une Classe
PUBLIC
	tMots est un tableau de chaînes

	PROCEDURE AjouterMot(s est une chaîne)
		Ajoute(:tMots, s)
	FIN

	PROCEDURE AjouterMotMethode(s est une chaîne)
		:tMots.Ajoute(s)
	FIN

	PROCEDURE NombreMots() : entier
		RENVOYER Taille(:tMots)
	FIN

	PROCEDURE CompterIterationsPourTout() : entier
		nCompteur est un entier = 0
		POUR TOUT m DE :tMots
			nCompteur++
		FIN
		RENVOYER nCompteur
	FIN
FIN
