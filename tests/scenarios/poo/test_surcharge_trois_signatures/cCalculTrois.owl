// Classe avec trois syntaxes de la meme methode (cas moteur : arite + type)
cCalculTrois est une Classe
PUBLIC
	PROCEDURE M(n1 est un entier) : chaîne
		RENVOYER "sig_scalaire"
	FIN

	PROCEDURE M(n1 est un entier, n2 est un entier) : chaîne
		RENVOYER "sig_deux_entiers"
	FIN

	PROCEDURE M(n1 est un tableau de entiers) : chaîne
		RENVOYER "sig_tableau"
	FIN
FIN
