// @sujet : Surcharge de methode de classe — trois syntaxes combinant arite et type
// @resume : Reproduit le cas moteur de surcharge a 3 syntaxes (meme methode declaree avec un scalaire, deux scalaires, ou un tableau). Chaque appel resout vers la syntaxe correspondant a l'arite puis, a arite egale, au type declare de l'argument.

// Cas nominal : les 3 appels resolvent chacun vers une syntaxe distincte
PROCEDURE scenario_trois_signatures_resolues()
	o est un cCalculTrois()
	t est un tableau de entiers = [10, 20]

	dbgVérifieEgalité(o.M(5), "sig_scalaire", "1 argument entier resout vers la syntaxe scalaire")
	dbgVérifieEgalité(o.M(5, 6), "sig_deux_entiers", "2 arguments entiers resout vers la syntaxe a 2 parametres")
	dbgVérifieEgalité(o.M(t), "sig_tableau", "1 argument tableau resout vers la syntaxe tableau")
FIN
