// @sujet : Structure — structure imbriquee dans le corps d'une structure
// @resume : Une Structure peut declarer une autre Structure dans son propre
// corps, a parite du comportement deja etabli pour une Classe (cf.
// tests/scenarios/poo/test_structure_imbriquee_classe). Le type imbrique sert
// de type a un champ suivant, dont les sous-champs restent lisibles et
// ecrivables depuis l'exterieur via l'instance de la structure englobante.

CT_Boite est une Structure
	nom est une chaîne

	sPoint est une Structure
		x est un entier
		y est un entier
	FIN
	origine est un sPoint

	taille est un entier
FIN

PROCEDURE PUBLIQUE scenario_structure_imbriquee_structure()
	c est un CT_Boite
	c.nom = "boite"
	c.origine.x = 3
	c.origine.y = 4
	c.taille = 10

	dbgVérifieEgalité(c.nom, "boite", "champ avant le type imbrique reste accessible")
	dbgVérifieEgalité(c.origine.x, 3, "champ x de la structure imbriquee, ecrit et lu depuis l'exterieur")
	dbgVérifieEgalité(c.origine.y, 4, "champ y de la structure imbriquee, ecrit et lu depuis l'exterieur")
	dbgVérifieEgalité(c.taille, 10, "champ scalaire apres le type imbrique n'est plus orpheline")
FIN
