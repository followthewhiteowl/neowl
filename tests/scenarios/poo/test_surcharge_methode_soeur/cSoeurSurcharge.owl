// Methode surchargee A(entier)/A(chaine) appelee depuis une methode SOEUR via
// la syntaxe this-methode `:A(args)` : la resolution d'overload s'applique au
// site d'appel soeur comme au site externe `recv.A(args)`.
cSoeurSurcharge est une Classe
PUBLIC
	PROCEDURE A(x est un entier) : chaîne
		RENVOYER "entier"
	FIN

	PROCEDURE A(x est une chaîne) : chaîne
		RENVOYER "chaine"
	FIN

	PROCEDURE AppelleSoeurChaine() : chaîne
		RENVOYER :A("hello")
	FIN

	PROCEDURE AppelleSoeurEntier() : chaîne
		RENVOYER :A(42)
	FIN

	// Argument typé via variable locale déclarée (type connu à la compilation).
	PROCEDURE AppelleSoeurVar() : chaîne
		s est une chaîne = "monde"
		RENVOYER :A(s)
	FIN
FIN
