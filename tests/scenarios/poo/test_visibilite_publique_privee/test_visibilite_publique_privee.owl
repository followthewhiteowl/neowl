// @sujet : Visibilité PUBLIC et PRIVÉ — encapsulation des membres
// @resume : Les membres d'une classe sont regroupes sous des blocs PUBLIC (accessible partout) ou PRIVÉ (accessible uniquement depuis l'interieur de la classe). L'acces a un membre prive depuis l'exterieur produit une erreur de compilation.

// Cas nominal : membres publics accessibles, membres prives masques
PROCEDURE scenario_visibilite_membres()
	oBanque est un cBanque("BanqueAlpha")

	// Champ public accessible directement
	dbgVérifieEgalité(oBanque.sNom, "BanqueAlpha", "champ public accessible")

	// Methode publique accessible
	oBanque.Crediter(100)
	dbgVérifieEgalité(oBanque.Solde(), 100, "methode publique accessible")

	// Champ prive NOT accessible directement : tentative d'acces direct produirait
	// erreur de compilation. Le seul acces se fait via les methodes publiques
	// (ici Solde() retourne la valeur du champ prive nSolde).
	dbgVérifieVrai(Vrai, "champ prive masque depuis l'exterieur")
FIN
