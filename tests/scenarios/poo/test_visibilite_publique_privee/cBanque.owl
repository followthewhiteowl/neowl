// Classe cBanque avec membres PUBLIC et PRIVE
cBanque est une Classe
PUBLIC
	sNom est une chaîne

	PROCEDURE Constructeur(nom est une chaîne)
		:sNom = nom
		:nSolde = 0
	FIN

	PROCEDURE Crediter(rMontant est un réel)
		:nSolde = :nSolde + rMontant
	FIN

	PROCEDURE Solde() : entier
		RENVOYER :nSolde
	FIN

PRIVÉ
	nSolde est un entier // champ prive, accessible uniquement depuis la classe
FIN
