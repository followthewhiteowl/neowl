// @sujet : Methode GLOBALE — appel sans instance
// @resume : Une methode declaree avec le modificateur GLOBALE (ou GLOBAL en anglais) s'appelle directement sur la classe, sans necessiter d'instance. Elle n'a pas acces au prefixe : (pas de this). Utile pour fonctions utilitaires attachees a une classe.

// Cas nominal : appel de methode statique
PROCEDURE scenario_methode_globale()
	// Appel sans creer d'instance
	nResultat est un entier = cMath.Carre(7)
	dbgVérifieEgalité(nResultat, 49, "methode GLOBALE Carre(7) = 49")

	rAire est un réel = cMath.AireCercle(2.0)
	dbgVérifieVrai(Abs(rAire - 12.56636) < 0.001, "methode GLOBALE AireCercle(2.0) ≈ 12.566")
FIN

// Forme anglaise du modificateur : GLOBAL (sans E), equivalent strict de GLOBALE
PROCEDURE scenario_methode_global_forme_en()
	sPropre est une chaîne = cValidateur.NomFichierValide("a/b*c.txt", "_")
	dbgVérifieEgalité(sPropre, "a_b_c.txt", "methode GLOBAL (sans E) appelee sans instance")

	sSansRemplacement est une chaîne = cValidateur.NomFichierValide("simple.txt")
	dbgVérifieEgalité(sSansRemplacement, "simple.txt", "methode GLOBAL avec parametre par defaut")
FIN
