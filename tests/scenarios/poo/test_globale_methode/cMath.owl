// Classe cMath avec methodes GLOBALE (statiques)
cMath est une Classe
	GLOBAL
	rPi est un réel = 3.14159

PUBLIC
	PROCEDURE GLOBALE Carre(nValeur est un entier) : entier
		RENVOYER nValeur * nValeur
	FIN

	PROCEDURE GLOBALE AireCercle(rRayon est un réel) : réel
		RENVOYER cMath.rPi * rRayon * rRayon
	FIN
FIN
