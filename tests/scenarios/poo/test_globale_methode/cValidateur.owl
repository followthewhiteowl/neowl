// Classe cValidateur avec methode statique declaree via GLOBAL (forme anglaise)
cValidateur est une Classe
PUBLIC
	PROCEDURE GLOBAL NomFichierValide(sNomFichier est une chaîne, sCaractereRemplacement est une chaîne = "") : chaîne
		RENVOYER Remplace(sNomFichier, ["'", `"`, "<", ">", "\", "/", "*", "?", "¦"], sCaractereRemplacement)
	FIN
FIN
