// Classe enfant heritant de cBase
cEnfant est une Classe
	Hérite de cBase
PUBLIC
	nLocal est un entier
	// Declaration apres usage (reference-avant) pour tester pre-passe
	champTardif est un entier

	PROCEDURE Constructeur()
		Constructeur cBase()
		:nLocal = 50
		// Reference-avant : champTardif declare plus bas dans la classe
		:champTardif = 999
	FIN

	PROCEDURE LireLocal() : entier
		RENVOYER :nLocal
	FIN

	PROCEDURE LireTardif() : entier
		// Autre reference vers champTardif (declare plus haut mais apres le constructeur)
		RENVOYER :champTardif
	FIN

	PROCEDURE LireParentViaHeritage() : entier
		// Acces a champ herite de cBase
		RENVOYER :nParent
	FIN

	PROCEDURE AppelMethodeParente() : entier
		// Appel de methode heritee de cBase
		RENVOYER :LireParent()
	FIN
FIN
