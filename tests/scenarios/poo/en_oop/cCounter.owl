// EN class declaration: counter with a public field and methods
cCounter est une Class
PUBLIC
	nValue is an integer

	PROCEDURE Constructeur(start is an integer)
		:nValue = start
	FIN

	PROCEDURE Increment()
		:nValue = :nValue + 1
	FIN

	PROCEDURE Add(amount is an integer)
		:nValue = :nValue + amount
	FIN

	PROCEDURE GetValue() : integer
		RETURN :nValue
	FIN
FIN
