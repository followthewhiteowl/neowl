// @subject: English OOP — class, inherits, methods, field access
// @summary: Programs using English OOP keywords (class, Inherits) to declare
// a class with public fields, a constructor, and methods. Also covers
// inheritance. Verifies that EN-keyword OOP compiles, executes, and produces
// expected results.

PROCEDURE PUBLIQUE scenario_counter_basic()
	c est un cCounter(0)
	dbgCheckEqual(c.nValue, 0, "counter starts at 0 after EN-keyword constructor call")
	c.Increment()
	dbgCheckEqual(c.nValue, 1, "Increment method increases value by 1")
	c.Increment()
	c.Increment()
	dbgCheckEqual(c.nValue, 3, "three Increment calls reach 3")
FIN

PROCEDURE PUBLIQUE scenario_counter_add()
	c est un cCounter(10)
	c.Add(5)
	dbgCheckEqual(c.GetValue(), 15, "Add method adds amount to value")
	c.Add(0)
	dbgCheckEqual(c.GetValue(), 15, "Add(0) leaves value unchanged")
FIN

PROCEDURE PUBLIQUE scenario_counter_getvalue()
	c est un cCounter(42)
	dbgCheckEqual(c.GetValue(), 42, "GetValue() returns integer via RETURN keyword")
FIN

PROCEDURE PUBLIQUE scenario_bounded_counter_inherits()
	bc est un cBoundedCounter(0, 3)
	dbgCheckEqual(bc.nValue, 0, "bounded counter starts at 0 (inherited field)")
	dbgCheckEqual(bc.nMax, 3, "bounded counter nMax set to 3")
	bc.Increment()
	bc.Increment()
	bc.Increment()
	dbgCheckEqual(bc.nValue, 3, "bounded counter reaches max after 3 increments")
	bAtMax is a boolean = bc.IsAtMax()
	dbgCheckTrue(bAtMax, "IsAtMax returns True when counter is at max (RETURN boolean)")
FIN
