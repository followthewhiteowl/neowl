// EN class declared with the English copula `is a class` (not `est une Class`).
cWidget is a Class
PUBLIC
	nWidth is an integer
	nHeight is an integer

	PROCEDURE Constructeur(w is an integer, h is an integer)
		:nWidth = w
		:nHeight = h
	FIN

	PROCEDURE Area() : integer
		RETURN :nWidth * :nHeight
	FIN

	PROCEDURE Resize(factor is an integer)
		:nWidth = :nWidth * factor
		:nHeight = :nHeight * factor
	FIN
FIN
