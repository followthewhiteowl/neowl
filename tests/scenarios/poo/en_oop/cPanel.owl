// EN class with the English copula AND English inheritance keyword.
cPanel is a Class
	Inherits cWidget
PUBLIC
	nBorder is an integer

	PROCEDURE Constructeur(w is an integer, h is an integer, b is an integer)
		Constructeur cWidget(w, h)
		:nBorder = b
	FIN

	PROCEDURE OuterArea() : integer
		RETURN (:nWidth + :nBorder) * (:nHeight + :nBorder)
	FIN
FIN
