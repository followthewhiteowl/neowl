// EN class inheriting cCounter — demonstrates Inherits keyword
cBoundedCounter est une Class
	Inherits cCounter
PUBLIC
	nMax is an integer

	PROCEDURE Constructeur(start is an integer, maxVal is an integer)
		Constructeur cCounter(start)
		:nMax = maxVal
	FIN

	PROCEDURE IsAtMax() : boolean
		RETURN :nValue >= :nMax
	FIN
FIN
