// @sujet : Constructeur — arguments et parametres par defaut
// @resume : Le constructeur d'une classe accepte des parametres par defaut, permettant plusieurs façons de l'appeler (multi-arity) sans surcharge. Chaque parametre non fourni prend sa valeur par defaut.

// Cas nominal : plusieurs arities du meme constructeur
PROCEDURE scenario_multi_arity_constructeur()
	// Appel sans argument : tous les parametres prennent leur valeur par defaut
	oP1 est un cPersonne()
	dbgVérifieEgalité(oP1.sNom, "inconnu", "nom par defaut")
	dbgVérifieEgalité(oP1.nAge, 0, "age par defaut")

	// Appel avec 1 argument : le premier parametre reçoit la valeur, le second prend le defaut
	oP2 est un cPersonne("Alice")
	dbgVérifieEgalité(oP2.sNom, "Alice", "nom fourni")
	dbgVérifieEgalité(oP2.nAge, 0, "age par defaut")

	// Appel avec 2 arguments : tous les parametres reçoivent une valeur explicite
	oP3 est un cPersonne("Bob", 30)
	dbgVérifieEgalité(oP3.sNom, "Bob", "nom fourni")
	dbgVérifieEgalité(oP3.nAge, 30, "age fourni")
FIN
