// Classe cPersonne avec constructeur multi-arity (parametres par defaut)
cPersonne est une Classe
PUBLIC
	sNom est une chaîne
	nAge est un entier

	// Constructeur avec parametres par defaut : appelable avec 0, 1 ou 2 arguments
	PROCEDURE Constructeur(nom est une chaîne = "inconnu", Age est un entier = 0)
		:sNom = nom
		:nAge = Age
	FIN

	PROCEDURE SePresenter() : chaîne
		RENVOYER :sNom + " a " + :nAge + " ans"
	FIN
FIN
