// @sujet : Appel d'ancêtre par nom — saut de niveau dans la chaine
// @resume : La syntaxe cAncestor.M() permet d'appeler directement la version definie dans une classe ancetre nommee, en sautant les niveaux intermediaires. Ancetre cible le parent immediat, tandis que cAncestor.M() cible une classe specifique plus haut.

// Cas nominal : appel direct d'un ancetre non immediat
PROCEDURE scenario_appel_ancetre_nomme()
	oChiot est un cChiot()

	// Appel de Crier : cChiot.Crier() appelle cAnimal.Crier() directement,
	// sautant cChien ("Wouf"). Le resultat combine "bruit animal generique + Wif"
	// prouve le saut : si l'appel avait cible le parent immediat cChien,
	// on aurait obtenu "Wouf + Wif".
	sCri est une chaîne = oChiot.Crier()

	dbgVérifieEgalité(sCri, "bruit animal generique + Wif",
	"cAnimal.Crier() cible la racine en sautant cChien")
FIN
