// Classe avec un membre tableau portant un attribut <Sérialise> inline AU
// MILIEU du type (entre "tableau" et "de <TypeÉlément>"), parité struct —
// follow-up de  (qui ne couvrait que les membres scalaires).
cTenantsSerialise est une Classe
PUBLIC
	m_tTenants  est un tableau <Sérialise="tenants"> de chaînes
	m_tInterne  est un tableau <Sérialise=Faux> de chaînes
	m_nScore    est un entier

	PROCEDURE Constructeur()
		:m_nScore = 0
	FIN

	PROCEDURE Destructeur()
	FIN
FIN
