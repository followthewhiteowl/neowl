// @sujet : Héritage simple — derivation et polymorphisme
// @resume : Une classe peut heriter d'une autre via Hérite de. La classe derivee recoit les membres et methodes de la parente. Le constructeur enfant appelle le constructeur parent avec Constructeur cParent(args). Une methode heritee peut etre redefinie (polymorphisme).

// Cas nominal : heritage et acces aux membres herites
PROCEDURE scenario_heritage_membres()
	oChat est un cChat("Felix", Vrai)

	// Champ herite de cAnimal accessible directement
	dbgVérifieEgalité(oChat.sNom, "Felix", "champ herite accessible")

	// Champ propre a cChat
	dbgVérifieEgalité(oChat.bInterieur, Vrai, "champ propre accessible")
FIN

// Polymorphisme : methode redefinie dans la classe derivee
PROCEDURE scenario_heritage_polymorphisme()
	oChat est un cChat("Minou", Faux)

	// Appel de la methode redefinie : version cChat executee (pas cAnimal)
	oChat.Presenter()
	// Sortie attendue : "Chat : Minou"

	dbgVérifieVrai(Vrai, "methode redefinie executee sans erreur")
FIN
