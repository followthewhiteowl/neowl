// @sujet : Affectation d'un sous-type à une variable du super-type (Liskov)
// @résumé : Une variable typée sur la classe parente peut recevoir une instance de la classe dérivée, à l'initialisation comme à la réaffectation.

// Réaffectation : une variable déclarée `cVehicule` reçoit une instance
// `cVoiture` (sous-type). Le champ hérité reste lisible via la variable
// parente.
PROCEDURE scenario_reaffectation_sous_type_vers_super_type()
	oVoiture est un cVoiture("Coupé", 2)
	oVehicule est un cVehicule("Générique")

	oVehicule = oVoiture

	dbgVérifieEgalité(oVehicule.sModele, "Coupé", "réaffectation sous-type -> super-type conserve le champ hérité")
FIN


// Initialisation directe : `oVehicule est un cVehicule = oVoiture`.
PROCEDURE scenario_initialisation_sous_type_vers_super_type()
	oVoiture est un cVoiture("Berline", 4)
	oVehicule est un cVehicule = oVoiture

	dbgVérifieEgalité(oVehicule.sModele, "Berline", "initialisation sous-type -> super-type conserve le champ hérité")
FIN
