// Classe cCompte avec champs publics et methodes inline
cCompte est une Classe
PUBLIC
	sProprietaire est une chaîne
	rSolde est un réel

	PROCEDURE Constructeur(nom est une chaîne)
		:sProprietaire = nom
		:rSolde = 0
	FIN

	PROCEDURE Crediter(rMontant est un réel)
		:rSolde = :rSolde + rMontant
	FIN

	PROCEDURE Solde() : réel
		RENVOYER :rSolde
	FIN
FIN
