// @sujet : Classe — declaration simple avec champs et methodes
// @resume : Montre la declaration d'une classe avec champs publics, constructeur avec argument, methodes d'instance. L'instanciation se fait en declarant une variable du type de la classe. Les methodes s'appellent avec la syntaxe point.

// Cas nominal : creation d'une instance avec constructeur, appels de methode
PROCEDURE scenario_instanciation_et_methodes()
	// Instanciation avec appel constructeur (1 argument)
	oCompte est un cCompte("Alice")

	// Lecture d'un champ public
	dbgVérifieEgalité(oCompte.sProprietaire, "Alice", "champ assigne par constructeur")
	dbgVérifieEgalité(oCompte.rSolde, 0, "solde initialise a zero par constructeur")

	// Appel de methode d'instance
	oCompte.Crediter(100)
	dbgVérifieEgalité(oCompte.Solde(), 100, "methode Crediter augmente le solde")

	// Modification directe d'un champ public
	oCompte.rSolde = 250
	dbgVérifieEgalité(oCompte.Solde(), 250, "champ public modifiable directement")
FIN
