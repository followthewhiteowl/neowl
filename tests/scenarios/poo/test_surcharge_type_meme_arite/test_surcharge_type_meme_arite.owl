// @sujet : Surcharge de methode de classe — resolution par type declare a arite egale
// @resume : Quand deux syntaxes d'une methode partagent le meme nombre d'arguments, la resolution se fait sur le type DECLARE de l'argument (variable typee au site d'appel), pas sur l'arite seule.

// Cas nominal : meme arite (1), types distincts (scalaire vs tableau)
PROCEDURE scenario_surcharge_resolue_par_type()
	o est un cCalculType()
	n est un entier             = 42
	t est un tableau de entiers = [1, 2, 3]

	dbgVérifieEgalité(o.M(n), "scalaire", "argument entier resout vers la syntaxe scalaire")
	dbgVérifieEgalité(o.M(t), "tableau", "argument tableau resout vers la syntaxe tableau")
FIN
