// @sujet : Introspection est — test dynamique du type d'instance
// @resume : L'operateur est <NomClasse> teste dynamiquement le type d'une instance. Il retourne Vrai si la valeur est une instance de la classe ou d'une de ses descendantes, Faux sinon. Respecte la chaine d'heritage.

// Cas nominal : test de type exact et via heritage
PROCEDURE scenario_est_classe()
	oChat est un cChat("Felix")

	// Type exact
	dbgVérifieVrai(oChat est cChat, "type exact : oChat est cChat")

	// Via heritage : cChat herite de cAnimal
	dbgVérifieVrai(oChat est cAnimal, "via heritage : oChat est aussi cAnimal")

	// Classes sœurs : cChat et cChien sont freres (meme parent cAnimal)
	dbgVérifieFaux(oChat est cChien, "classes sœurs : oChat n'est pas cChien")
FIN

// Test sur une valeur non-instance : retourne Faux sans erreur
PROCEDURE scenario_est_valeur_non_instance()
	nEntier est un entier = 42

	dbgVérifieFaux(nEntier est cAnimal, "valeur non-instance : entier n'est pas cAnimal")
FIN
