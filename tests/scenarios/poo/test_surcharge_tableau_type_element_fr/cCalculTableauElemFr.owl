// Classe FR avec deux syntaxes de meme nom, meme arite, toutes deux un
// tableau, distinguees uniquement par le type d'ELEMENT du tableau.
cCalculTableauElemFr est une Classe
PUBLIC
	PROCEDURE M(t est un tableau de chaînes) : chaîne
		RENVOYER "TABLEAU_CHAINES"
	FIN

	PROCEDURE M(t est un tableau de entiers) : chaîne
		RENVOYER "TABLEAU_ENTIERS"
	FIN
FIN
