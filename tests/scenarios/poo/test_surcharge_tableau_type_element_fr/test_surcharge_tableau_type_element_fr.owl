// @sujet : Surcharge de methode de classe — resolution par type d'element de tableau
// @resume : Deux syntaxes d'une methode peuvent toutes deux prendre un tableau en
// argument, pourvu que le type d'ELEMENT du tableau differe. La resolution choisit la
// syntaxe dont le type d'element correspond au tableau passe en argument.

// Cas nominal : meme arite (1), meme famille (tableau), types d'element distincts
PROCEDURE PUBLIQUE scenario_surcharge_resolue_par_type_element_tableau()
	o        est un cCalculTableauElemFr()
	tEntiers est un tableau de entiers     = [1, 2, 3]
	tChaines est un tableau de chaînes     = ["a", "b"]

	dbgVérifieEgalité(o.M(tEntiers), "TABLEAU_ENTIERS", "tableau d'entiers resout vers la surcharge entiers")
	dbgVérifieEgalité(o.M(tChaines), "TABLEAU_CHAINES", "tableau de chaines resout vers la surcharge chaines")
FIN
