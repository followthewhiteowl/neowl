// Classe dont la methode est declaree SANS accent (Credite).
// Doit etre appelable indifferemment via 'Credite' ou 'Crédite'
// (symetrie de l'invariant 2).
cSansAccent est une Classe
PUBLIC
	nSolde est un entier

	PROCEDURE Constructeur()
		:nSolde = 0
	FIN

	PROCEDURE Credite(n est un entier) : entier
		:nSolde = :nSolde + n
		RENVOYER :nSolde
	FIN
FIN
