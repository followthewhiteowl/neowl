// Classe melangeant un membre GLOBAL (partage) et un membre LOCAL (instance)
cLocGlob est une Classe
	GLOBAL
	nPartage est un entier = 0 // champ partage par toutes les instances

	LOCAL
	nPropre est un entier = 0 // champ d'instance (revient a l'axe instance apres GLOBAL)

	PUBLIC
	PROCEDURE Constructeur()
		// Incremente le compteur partage a chaque instanciation
		cLocGlob.nPartage = cLocGlob.nPartage + 1
	FIN
FIN
