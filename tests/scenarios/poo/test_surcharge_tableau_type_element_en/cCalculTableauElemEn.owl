// Classe EN avec deux syntaxes de meme nom, meme arite, toutes deux un
// tableau, distinguees uniquement par le type d'ELEMENT du tableau.
cCalculTableauElemEn is a Class
PUBLIC
	PROCEDURE M(t is an array of strings) : string
		RETURN "ARRAY_STRINGS"
	FIN

	PROCEDURE M(t is an array of integers) : string
		RETURN "ARRAY_INTEGERS"
	FIN
FIN
