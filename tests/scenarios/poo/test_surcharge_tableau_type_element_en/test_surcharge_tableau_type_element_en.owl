// @sujet : Surcharge de methode de classe EN — resolution par type d'element de tableau
// @resume : Une classe declaree avec les mots-cles EN peut distinguer deux syntaxes
// d'une methode prenant chacune un tableau, pourvu que le type d'ELEMENT du tableau
// differe. La resolution choisit la syntaxe dont le type d'element correspond au
// tableau passe en argument, exactement comme en FR.

PROCEDURE PUBLIQUE scenario_surcharge_en_resolue_par_type_element_tableau()
	o     est un cCalculTableauElemEn()
	tInts est un tableau de entiers     = [1, 2, 3]
	tStrs est un tableau de chaînes     = ["a", "b"]

	dbgVérifieEgalité(o.M(tInts), "ARRAY_INTEGERS", "tableau d'entiers resout vers la surcharge EN integers")
	dbgVérifieEgalité(o.M(tStrs), "ARRAY_STRINGS", "tableau de chaines resout vers la surcharge EN strings")
FIN
