// @sujet : Classe — champ d'instance type par une Structure, auto-initialise
// @resume : Un champ d'instance de classe dont le type est une Structure
// (imbriquee dans la classe, ou declaree au niveau fichier voisin) est
// automatiquement initialise des la construction de l'instance, sans
// affectation prealable du champ entier. Les sous-champs sont directement
// accessibles en lecture et en ecriture depuis les methodes de la classe.

// Cas 1 : structure imbriquee dans le corps de la classe, utilisee comme
// type d'un champ d'instance (pas seulement une variable locale de methode).
PROCEDURE PUBLIQUE scenario_champ_structure_imbriquee_autoinit()
	o est un cCompteurStruct()

	dbgVérifieEgalité(o.LitIVal(), 5, "champ structure imbriquee auto-initialise, sous-champ entier")
	dbgVérifieEgalité(o.LitSTxt(), "ok", "champ structure imbriquee auto-initialise, sous-champ chaine")
FIN

// Cas 2 : structure declaree au niveau fichier (voisine), utilisee comme
// type d'un champ d'instance dans une autre classe.
PROCEDURE PUBLIQUE scenario_champ_structure_fichier_voisin_autoinit()
	o est un cPersonneAdresse()

	dbgVérifieEgalité(o.LitVille(), "Paris", "champ structure fichier voisin auto-initialise, sous-champ chaine")
	dbgVérifieEgalité(o.LitCodePostal(), 75000, "champ structure fichier voisin auto-initialise, sous-champ entier")
FIN
