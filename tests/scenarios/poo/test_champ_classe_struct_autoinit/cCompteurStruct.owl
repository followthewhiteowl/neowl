// Classe declarant une Structure dans son propre corps, utilisee comme
// type d'un CHAMP d'instance (pas seulement une variable locale de methode).
cCompteurStruct est une Classe
PUBLIC
	stInfo est une Structure
		iVal est un entier
		sTxt est une chaîne
	FIN

	monInfo est un stInfo

	PROCEDURE Constructeur()
		:monInfo.iVal = 5
		:monInfo.sTxt = "ok"
	FIN

	PROCEDURE LitIVal() : entier
		RENVOYER :monInfo.iVal
	FIN

	PROCEDURE LitSTxt() : chaîne
		RENVOYER :monInfo.sTxt
	FIN
FIN
