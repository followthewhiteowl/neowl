// Classe avec un champ d'instance type par une Structure declaree au
// niveau fichier (voisine, pas imbriquee dans la classe).
cPersonneAdresse est une Classe
PUBLIC
	monAdresse est un StAdresse

	PROCEDURE Constructeur()
		:monAdresse.sVille = "Paris"
		:monAdresse.nCodePostal = 75000
	FIN

	PROCEDURE LitVille() : chaîne
		RENVOYER :monAdresse.sVille
	FIN

	PROCEDURE LitCodePostal() : entier
		RENVOYER :monAdresse.nCodePostal
	FIN
FIN
