// Classe concrete cCercle heritant de cFigure
cCercle est une Classe
	Hérite de cFigure
PUBLIC
	rRayon est un réel

	PROCEDURE Constructeur(nom est une chaîne, rayon est un réel)
		Constructeur cFigure(nom)
		:rRayon = rayon
	FIN

	// Implementation de la methode abstraite
	PROCEDURE Aire() : réel
		RENVOYER 3.14159 * :rRayon * :rRayon
	FIN
FIN
