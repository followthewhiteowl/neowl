// @sujet : Membre GLOBAL — champ partage par toutes les instances
// @resume : Un bloc GLOBAL declare des champs attaches a la classe plutot qu'a une instance. Il existe en un seul exemplaire, independamment du nombre d'instances. Acces via le nom de la classe (cClasse.nChamp).

// Cas nominal : compteur partage entre instances
PROCEDURE scenario_membre_global()
	// Initialisation : compteur a zero
	cCompteur.nTotal = 0

	oC1 est un cCompteur("premier")
	dbgVérifieEgalité(cCompteur.nTotal, 1, "premiere instance incrementée le compteur")

	oC2 est un cCompteur("deuxieme")
	dbgVérifieEgalité(cCompteur.nTotal, 2, "deuxieme instance incrementée le compteur")

	oC3 est un cCompteur("troisieme")
	dbgVérifieEgalité(cCompteur.nTotal, 3, "troisieme instance incrementée le compteur")

	// Le compteur est unique et partage
	dbgVérifieVrai(Vrai, "membre GLOBAL partage entre toutes les instances")
FIN
