// Classe cCompteur avec membre GLOBAL partage
cCompteur est une Classe
	GLOBAL
	nTotal est un entier = 0 // champ partage par toutes les instances

PUBLIC
	sNom est une chaîne

	PROCEDURE Constructeur(nom est une chaîne)
		:sNom = nom
		// Incrementation du compteur partage
		cCompteur.nTotal = cCompteur.nTotal + 1
	FIN
FIN
