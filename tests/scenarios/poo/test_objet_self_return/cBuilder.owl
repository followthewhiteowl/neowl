// Classe support pour scenario chainage multi-appel
cBuilder est une Classe
PUBLIC
	sNom est une chaîne
	nAge est un entier
	sVille est une chaîne

	PROCEDURE FixeNom(s est une chaîne) : cBuilder
		:sNom = s
		RENVOYER objet
	FIN

	PROCEDURE FixeAge(n est un entier) : cBuilder
		:nAge = n
		RENVOYER objet
	FIN

	PROCEDURE FixeVille(v est une chaîne) : cBuilder
		:sVille = v
		RENVOYER objet
	FIN
FIN
