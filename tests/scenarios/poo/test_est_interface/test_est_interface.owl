// @sujet : Introspection est — test avec interface
// @resume : L'operateur est accepte aussi un nom d'interface a droite. Il retourne Vrai si la classe de l'instance (ou un de ses ancêtres) implemente l'interface, Faux sinon. Prend en compte l'heritage du contrat.

// Cas nominal : test d'implementation d'interface
PROCEDURE scenario_est_interface()
	oProduit est un cProduit("clavier")

	// cProduit implemente iAffichable
	dbgVérifieVrai(oProduit est iAffichable, "cProduit implemente iAffichable")

	// Appel conditionnel base sur l'interface
	SI oProduit est iAffichable ALORS
		oProduit.Afficher()
		dbgVérifieVrai(Vrai, "appel conditionnel Afficher() execute")
	SINON
		dbgVérifieVrai(Faux, "branche non attendue")
	FIN
FIN

// Classe n'implementant pas l'interface
PROCEDURE scenario_est_interface_non_implementee()
	oService est un cService("nettoyage")

	// cService n'implemente PAS iAffichable
	dbgVérifieFaux(oService est iAffichable, "cService n'implemente pas iAffichable")
FIN
