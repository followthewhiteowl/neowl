// @sujet : Exactitude / MatriceDeConfusion
// @résumé : Deux métriques d'évaluation de classification (comptage pur, non
// différentiable). Exactitude rend la fraction d'exemples bien classés, à
// partir de prédictions 2D (scores par classe, la classe retenue par ligne
// est celle du plus grand score) ou 1D (indices de classe), comparées à des
// cibles 1D d'indices 0-based. MatriceDeConfusion rend une Matrice carrée
// classes x classes dont la cellule (classe réelle, classe prédite) compte
// les exemples correspondants.


// Prédictions sous forme de scores 2D lot x classes : la classe retenue par
// ligne est l'ArgMax. Scores [[2,1,0],[0,1,2],[1,0,0]] -> classes [0,2,0].
// Cibles [0,2,1] : 2 lignes sur 3 correctes -> exactitude 2/3.
PROCEDURE PUBLIQUE scenario_exactitude_scores_2d()
	matScores est une Matrice = [[2.0, 1.0, 0.0], [0.0, 1.0, 2.0], [1.0, 0.0, 0.0]]
	preds est un Tenseur = Tenseur(matScores)
	cibles est un Tenseur = Tenseur([0.0, 2.0, 1.0])
	taux est un réel = Exactitude(preds, cibles)
	dbgVérifieVrai(Abs(taux - 0.6666666666666666) < 0.0000001, "2 lignes correctes sur 3 -> ~0.6666667")
FIN


// Prédictions déjà sous forme d'indices 1D : mêmes classes [0,2,0] passées
// directement, mêmes cibles [0,2,1] -> même exactitude 2/3 que la forme 2D.
PROCEDURE PUBLIQUE scenario_exactitude_indices_1d()
	preds est un Tenseur = Tenseur([0.0, 2.0, 0.0])
	cibles est un Tenseur = Tenseur([0.0, 2.0, 1.0])
	taux est un réel = Exactitude(preds, cibles)
	dbgVérifieVrai(Abs(taux - 0.6666666666666666) < 0.0000001, "indices [0,2,0] vs [0,2,1] -> ~0.6666667")
FIN


// Prédictions parfaites : chaque indice égale sa cible -> exactitude 1.0
// exactement (valeur exacte, sans tolérance).
PROCEDURE PUBLIQUE scenario_exactitude_parfaite()
	preds est un Tenseur = Tenseur([3.0, 1.0, 0.0, 2.0])
	cibles est un Tenseur = Tenseur([3.0, 1.0, 0.0, 2.0])
	taux est un réel = Exactitude(preds, cibles)
	dbgVérifieEgalité(taux, 1.0, "toutes les prédictions correctes -> exactitude 1.0")
FIN


// Exactement la moitié correcte : 4 exemples, 2 bons -> 0.5 exactement.
PROCEDURE PUBLIQUE scenario_exactitude_moitie()
	preds est un Tenseur = Tenseur([0.0, 1.0, 0.0, 1.0])
	cibles est un Tenseur = Tenseur([0.0, 0.0, 0.0, 0.0])
	taux est un réel = Exactitude(preds, cibles)
	dbgVérifieEgalité(taux, 0.5, "2 exemples corrects sur 4 -> 0.5")
FIN


// Matrice de confusion à partir des scores 2D : classes prédites [0,2,0],
// cibles réelles [0,2,1]. La cellule (réelle, prédite) est comptée en base 0
// mais lue en Matrice 1-based. Ventilation attendue :
//   exemple 0 : réelle 0, prédite 0 -> [1][1]
//   exemple 1 : réelle 2, prédite 2 -> [3][3]
//   exemple 2 : réelle 1, prédite 0 -> [2][1]
PROCEDURE PUBLIQUE scenario_matrice_confusion_scores_2d()
	matScores est une Matrice = [[2.0, 1.0, 0.0], [0.0, 1.0, 2.0], [1.0, 0.0, 0.0]]
	preds est un Tenseur = Tenseur(matScores)
	cibles est un Tenseur = Tenseur([0.0, 2.0, 1.0])
	conf est une Matrice = MatriceDeConfusion(preds, cibles)

	dbgVérifieEgalité(conf..Lignes, 3, "3 classes -> 3 lignes")
	dbgVérifieEgalité(conf..Colonnes, 3, "3 classes -> 3 colonnes")
	dbgVérifieEgalité(conf[1][1], 1.0, "réelle 0 prédite 0 : 1 exemple")
	dbgVérifieEgalité(conf[1][2], 0.0, "réelle 0 prédite 1 : aucun")
	dbgVérifieEgalité(conf[1][3], 0.0, "réelle 0 prédite 2 : aucun")
	dbgVérifieEgalité(conf[2][1], 1.0, "réelle 1 prédite 0 : 1 exemple")
	dbgVérifieEgalité(conf[2][2], 0.0, "réelle 1 prédite 1 : aucun")
	dbgVérifieEgalité(conf[2][3], 0.0, "réelle 1 prédite 2 : aucun")
	dbgVérifieEgalité(conf[3][1], 0.0, "réelle 2 prédite 0 : aucun")
	dbgVérifieEgalité(conf[3][2], 0.0, "réelle 2 prédite 1 : aucun")
	dbgVérifieEgalité(conf[3][3], 1.0, "réelle 2 prédite 2 : 1 exemple")
FIN


// Formes anglaises Accuracy / ConfusionMatrix : même calcul que leurs
// équivalents français.
PROCEDURE PUBLIQUE scenario_formes_anglaises()
	preds est un Tenseur = Tenseur([0.0, 2.0, 0.0])
	cibles est un Tenseur = Tenseur([0.0, 2.0, 1.0])
	taux est un réel = Accuracy(preds, cibles)
	dbgVérifieVrai(Abs(taux - 0.6666666666666666) < 0.0000001, "Accuracy = Exactitude")

	conf est une Matrice = ConfusionMatrix(preds, cibles)
	dbgVérifieEgalité(conf[1][1], 1.0, "ConfusionMatrix : réelle 0 prédite 0 = 1")
	dbgVérifieEgalité(conf[2][1], 1.0, "ConfusionMatrix : réelle 1 prédite 0 = 1")
	dbgVérifieEgalité(conf[3][3], 1.0, "ConfusionMatrix : réelle 2 prédite 2 = 1")
FIN


// La matrice de confusion prend la dimension du nombre de classes déduit des
// scores (nombre de colonnes), même si une classe n'apparaît jamais. Scores
// 2 exemples x 4 classes, prédictions [3,3], cibles [3,3] : matrice 4x4 avec
// un seul 1 en [4][4], tout le reste à zéro.
PROCEDURE PRIVÉE scenario_edge_classe_absente()
	matScores est une Matrice = [[0.0, 0.0, 0.0, 5.0], [0.0, 0.0, 0.0, 9.0]]
	preds est un Tenseur = Tenseur(matScores)
	cibles est un Tenseur = Tenseur([3.0, 3.0])
	conf est une Matrice = MatriceDeConfusion(preds, cibles)
	dbgVérifieEgalité(conf..Lignes, 4, "4 classes déduites des colonnes")
	dbgVérifieEgalité(conf..Colonnes, 4, "4 classes déduites des colonnes")
	dbgVérifieEgalité(conf[4][4], 2.0, "2 exemples réelle 3 prédite 3")
	dbgVérifieEgalité(conf[1][1], 0.0, "classe 0 absente : cellule nulle")
FIN


// Tailles incohérentes entre prédictions et cibles : erreur récupérable
// posée, résultat neutre. On vérifie ErreurDétectée AVANT toute autre
// instruction (la sentinelle d'erreur fraîche ne survit qu'à un OP_CALL).
PROCEDURE PRIVÉE scenario_edge_tailles_incoherentes()
	ErreurRAZ()
	preds est un Tenseur = Tenseur([0.0, 1.0, 0.0])
	cibles est un Tenseur = Tenseur([0.0])
	taux est un réel = Exactitude(preds, cibles)
	dbgVérifieVrai(ErreurDétectée, "tailles incohérentes -> ErreurDétectée")
FIN


// Cibles fournies en 2D alors qu'elles doivent être des indices 1D : erreur
// récupérable claire.
PROCEDURE PRIVÉE scenario_edge_cibles_2d_refusees()
	ErreurRAZ()
	matScores est une Matrice = [[2.0, 1.0], [0.0, 1.0]]
	preds est un Tenseur = Tenseur(matScores)
	matCibles est une Matrice = [[1.0, 0.0], [0.0, 1.0]]
	cibles est un Tenseur = Tenseur(matCibles)
	taux est un réel = Exactitude(preds, cibles)
	dbgVérifieVrai(ErreurDétectée, "cibles 2D -> ErreurDétectée")
FIN
