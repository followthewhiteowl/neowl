	dbgVérifieEgalité(sCode, "E_NATIVE_MQTT_SUBSCRIBE_FAILURE", "code d'erreur dédié à l'abonnement")
FIN


// Même constat avec la qualité de service « exactement une fois ».
PROCEDURE scenario_abonnement_sans_connexion_qualite_exactement_une_fois()
	sess est un mqttSession
	sess..Adresse  = "broker.exemple.local"
	sess..IDClient = "capteur-salon-04"

	ErreurRAZ()
	bRetour est un booléen = MQTTAbonne(sess, "etat/vanne", mqttQualitéExactementUneFois, reception_message)
	bErr est un booléen = ErreurDétectée
	sCode est une chaîne = ErreurInfo(errCode)
	dbgVérifieFaux(bRetour, "abonnement sans connexion renvoie Faux")
	dbgVérifieVrai(bErr, "abonnement sans connexion renseigne l'erreur courante")
	dbgVérifieEgalité(sCode, "E_NATIVE_MQTT_SUBSCRIBE_FAILURE", "code d'erreur dédié à l'abonnement")
FIN
