pwIDAQAB
-----END PUBLIC KEY-----`

// Clé publique d'une paire RSA DISTINCTE (#2, jetable) : utilisée uniquement
// pour prouver que la signature ne valide pas contre n'importe quelle clé.
sCléPubliqueAutre est une chaîne = `-----BEGIN PUBLIC KEY-----
MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAuKwqPrQMr7H6jWqY6vz8
sbty9SeVD6JzZInMnR+W6cqyF9neBhAzvplpoGCi/+kmnySyCQiyNH2pLlv+HNtg
f7jjggVQ5o3lyc3DL5AclWUksiUE4S/Zwo7B4eaEE66KJogZEFr/Qg3jk1RWMD9K
k8Ty0zli04DeWwIL4XFPPkhc2rFS9uzv9Fyxylccoa0HmEM0hiujg9Od3+tlUpHG
bNy41UXrbYNKGfw9XzuAbSIA31SEuLtYbmcjaom8FArvxVtJizli+x47T5x8lKKd
oPHKkB/gXClkUVJ+RrAoER/DjfOemUwOt0TaWMx7DcIwFLCEqVUgOVIiNqbMaD5x
lwIDAQAB
-----END PUBLIC KEY-----`

// Entête et payload JSON FIXES (aucune horloge) : la même paire d'entrées
// doit produire exactement la même assertion à chaque appel.
sEntete  est une chaîne = `{"alg":"RS256","typ":"JWT"}`
sPayload est une chaîne = `{"iss":"mon-client","sub":"mon-client","aud":"https://auth.exemple.test","exp":9999999999}`


// L'assertion produite depuis un entête et un payload JSON bruts est un JWT
// bien formé (3 segments), dont l'entête et le payload décodés restituent
// exactement les claims fournis, et dont la signature RS256 se vérifie
// contre la clé publique correspondant à la clé privée utilisée.
PROCEDURE PUBLIQUE scenario_rs256_nominal()
	jwt est une chaîne = JWTCréeAssertion(sEntete, sPayload, sCléPriveeTest)

	segments est un tableau de chaînes = ChaîneDécoupe(jwt, ".")
	dbgVérifieEgalité(segments..Occurrence, 3, "un JWT compte 3 segments séparés par des points")

	sEnteteJSON  est une chaîne = Base64VersChaîne(segments[1], encodeBASE64URL)
	sPayloadJSON est une chaîne = Base64VersChaîne(segments[2], encodeBASE64URL)

	jEntete est un JSON = ChaîneVersJSON(sEnteteJSON)
	dbgVérifieEgalité(jEntete.alg, "RS256", "entête restituée telle que fournie")
	dbgVérifieEgalité(jEntete.typ, "JWT", "entête restituée telle que fournie")

	jPayload est un JSON = ChaîneVersJSON(sPayloadJSON)
	dbgVérifieEgalité(jPayload.iss, "mon-client", "payload restitué tel que fourni")
	dbgVérifieEgalité(jPayload.sub, "mon-client", "payload restitué tel que fourni")
	dbgVérifieEgalité(jPayload.aud, "https://auth.exemple.test", "payload restitué tel que fourni")
	dbgVérifieEgalité(jPayload.Exp, 9999999999, "payload restitué tel que fourni")

	dbgVérifieVrai(__JWTVerifieSignature(jwt, sCléPubliqueTest), "signature RS256 valide contre la clé publique correspondante")
FIN


// Aucun claim n'est ajouté automatiquement (ni iat ni exp) : l'appelant
// fournit tout, donc deux appels avec les mêmes entrées produisent
// exactement le même JWT.
PROCEDURE PUBLIQUE scenario_deterministe_memes_entrees_meme_jwt()
	jwt1 est une chaîne = JWTCréeAssertion(sEntete, sPayload, sCléPriveeTest)
	jwt2 est une chaîne = JWTCréeAssertion(sEntete, sPayload, sCléPriveeTest)
	dbgVérifieEgalité(jwt1, jwt2, "mêmes entrées -> même JWT (aucune horloge implicite)")
FIN


// La signature ne valide pas contre une clé publique d'une autre paire RSA :
// preuve que la vérification est cryptographique et pas une tautologie.
PROCEDURE PUBLIQUE scenario_signature_rejetee_mauvaise_cle()
	jwt est une chaîne = JWTCréeAssertion(sEntete, sPayload, sCléPriveeTest)
	dbgVérifieFaux(__JWTVerifieSignature(jwt, sCléPubliqueAutre), "signature RS256 ne valide pas contre une clé publique d'une autre paire")
FIN


// jwtHS256 n'est pas supporté en phase courante (ambiguïté canon clé-vs-secret
// différée, cf. AuthIdentifie(JWTParamètres)) : un entête qui annonce HS256
// échoue nettement, sans tentative silencieuse de signer en HMAC avec une
// clé PEM RSA.
PROCEDURE PUBLIQUE scenario_hs256_non_supporte()
	sEnteteHS256 est une chaîne = `{"alg":"HS256","typ":"JWT"}`

	ErreurRAZ()
	JWTCréeAssertion(sEnteteHS256, sPayload, sCléPriveeTest)
	bErr est un booléen = ErreurDétectée
	dbgVérifieVrai(bErr, "entête alg=HS256 -> erreur nette")
	dbgVérifieEgalité(ErreurInfo(errCode), "E_NATIVE_JWT_ALGORITHM_UNSUPPORTED", "code dédié algorithme JWT non supporté")
FIN


// Une clé qui n'est pas un PEM exploitable échoue nettement, sans crash.
PROCEDURE PRIVÉE scenario_edge_cle_pem_invalide()
	ErreurRAZ()
	JWTCréeAssertion(sEntete, sPayload, "pas-une-cle-pem")
	bErr est un booléen = ErreurDétectée
	dbgVérifieVrai(bErr, "clé PEM invalide -> erreur nette, pas de crash")
FIN


dbgBilanTest()
