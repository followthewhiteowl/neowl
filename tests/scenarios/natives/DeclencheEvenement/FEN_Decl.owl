// Fenêtre voisine — ressource pour test_DeclencheEvenement.owl.
//
// Un Bouton (event souris simple), une Saisie (event modification texte
// et event clavier avec paramètre) pour couvrir les formes de déclenchement
// par code testées côté script.

FEN_Decl est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 200
	FIN

	BTN_Clic est un Champ Bouton
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 100
			Hauteur = 30
			Libellé = "Clic"
		FIN
		PROCEDURE surClic()
			callback_clic("clic déclenché")
		FIN
	FIN

	SAI_Modif est un Champ Saisie
		PROPRIETES
			X       = 10
			Y       = 60
			Largeur = 150
			Hauteur = 30
		FIN
		PROCEDURE surAChaqueModification()
			callback_modif("modif déclenchée")
		FIN
		PROCEDURE surToucheAppuyée(touche est un entier)
			callback_touche(touche)
		FIN
	FIN
FIN
