// @sujet : EntierVersBuffer
// @résumé : Produit une séquence d'octets binaire représentant un entier en complément à deux sur un nombre fixe d'octets. Le boutisme (petit-boutiste par défaut ou grand-boutiste) est précisé explicitement. Tailles acceptées : 1, 2, 4 ou 8 octets. Toute valeur non représentable dans la taille demandée lève une exception. Toute taille hors de cet ensemble lève une exception.


// Cas A : 1000 sur 4 octets, boutisme petit (défaut) — poids faible en premier.
// 1000 = 0x000003E8 → octets LE : E8 03 00 00.
PROCEDURE PUBLIQUE scenario_petit_boutiste_4octets()
	buf est un buffer = EntierVersBuffer(1000, 4)
	dbgVérifieEgalité(Taille(buf), 4, "EntierVersBuffer(1000, 4) produit 4 octets")
	o1 est un entier = BufferLitOctet(buf, 1)
	o2 est un entier = BufferLitOctet(buf, 2)
	o3 est un entier = BufferLitOctet(buf, 3)
	o4 est un entier = BufferLitOctet(buf, 4)
	dbgVérifieEgalité(o1, 232, "octet 1 = 0xE8 (232) — poids faible")
	dbgVérifieEgalité(o2, 3, "octet 2 = 0x03 (3)")
	dbgVérifieEgalité(o3, 0, "octet 3 = 0x00")
	dbgVérifieEgalité(o4, 0, "octet 4 = 0x00 — poids fort")
FIN


// Cas B : 1000 sur 4 octets, boutisme grand — poids fort en premier.
// 1000 = 0x000003E8 → octets BE : 00 00 03 E8.
PROCEDURE PUBLIQUE scenario_gros_boutiste_4octets()
	buf est un buffer = EntierVersBuffer(1000, 4, boutismeGros)
	dbgVérifieEgalité(Taille(buf), 4, "boutismeGros produit 4 octets")
	o1 est un entier = BufferLitOctet(buf, 1)
	o2 est un entier = BufferLitOctet(buf, 2)
	o3 est un entier = BufferLitOctet(buf, 3)
	o4 est un entier = BufferLitOctet(buf, 4)
	dbgVérifieEgalité(o1, 0, "octet 1 = 0x00 — poids fort en premier")
	dbgVérifieEgalité(o2, 0, "octet 2 = 0x00")
	dbgVérifieEgalité(o3, 3, "octet 3 = 0x03 (3)")
	dbgVérifieEgalité(o4, 232, "octet 4 = 0xE8 (232) — poids faible en dernier")
FIN


// Cas C : taille 1 octet — 255 tient en non-signé sur 1 octet.
PROCEDURE PUBLIQUE scenario_1_octet()
	buf est un buffer = EntierVersBuffer(255, 1)
	dbgVérifieEgalité(Taille(buf), 1, "taille = 1 octet")
	o est un entier = BufferLitOctet(buf, 1)
	dbgVérifieEgalité(o, 255, "255 tient en non-signé sur 1 octet = 0xFF")
FIN


// Cas D : taille 2 octets, petit-boutiste — 258 = 0x0102 → octets [0x02, 0x01].
PROCEDURE PUBLIQUE scenario_2_octets_petit_boutiste()
	buf est un buffer = EntierVersBuffer(258, 2)
	dbgVérifieEgalité(Taille(buf), 2, "taille = 2 octets")
	o1 est un entier = BufferLitOctet(buf, 1)
	o2 est un entier = BufferLitOctet(buf, 2)
	dbgVérifieEgalité(o1, 2, "octet 1 = 0x02 — poids faible")
	dbgVérifieEgalité(o2, 1, "octet 2 = 0x01 — poids fort")
FIN


// Cas E : taille 8 octets — valeur 1, les 7 octets de poids fort sont nuls.
PROCEDURE PUBLIQUE scenario_8_octets()
	buf est un buffer = EntierVersBuffer(1, 8)
	dbgVérifieEgalité(Taille(buf), 8, "taille = 8 octets")
	o1 est un entier = BufferLitOctet(buf, 1)
	o2 est un entier = BufferLitOctet(buf, 2)
	dbgVérifieEgalité(o1, 1, "octet 1 = 1 — poids faible")
	dbgVérifieEgalité(o2, 0, "octet 2 = 0 — octets de poids fort nuls")
FIN


// Cas F : valeur négative en complément à deux — -1 sur 4 octets = 0xFFFFFFFF.
PROCEDURE PUBLIQUE scenario_negatif_complement_deux()
	buf est un buffer = EntierVersBuffer(-1, 4)
	dbgVérifieEgalité(Taille(buf), 4, "taille = 4 octets")
	o1 est un entier = BufferLitOctet(buf, 1)
	o2 est un entier = BufferLitOctet(buf, 2)
	o3 est un entier = BufferLitOctet(buf, 3)
	o4 est un entier = BufferLitOctet(buf, 4)
	dbgVérifieEgalité(o1, 255, "octet 1 = 0xFF")
	dbgVérifieEgalité(o2, 255, "octet 2 = 0xFF")
	dbgVérifieEgalité(o3, 255, "octet 3 = 0xFF")
	dbgVérifieEgalité(o4, 255, "octet 4 = 0xFF")
FIN


// Cas G : dépassement — 300 ne tient ni en signé [-128,127] ni en non-signé [0,255] sur 1 octet.
PROCEDURE PUBLIQUE scenario_depassement_erreur()
	bExceptionLevee est un booléen = Faux
	QUAND EXCEPTION DANS
		EntierVersBuffer(300, 1)
	FAIRE
		bExceptionLevee = Vrai
	FIN
	dbgVérifieVrai(bExceptionLevee, "300 hors plage 1 octet lève une exception")
FIN


// Cas H : 200 sur 1 octet — tient en non-signé [0,255], pas d'erreur.
PROCEDURE PUBLIQUE scenario_200_dans_1_octet()
	buf est un buffer = EntierVersBuffer(200, 1)
	dbgVérifieEgalité(Taille(buf), 1, "taille = 1 octet")
	o est un entier = BufferLitOctet(buf, 1)
	dbgVérifieEgalité(o, 200, "200 = 0xC8 tient en non-signé sur 1 octet")
FIN


// Cas I : taille invalide — 3 n'est pas dans {1,2,4,8} → exception.
PROCEDURE PUBLIQUE scenario_taille_invalide_3()
	bExceptionLevee est un booléen = Faux
	QUAND EXCEPTION DANS
		EntierVersBuffer(1, 3)
	FAIRE
		bExceptionLevee = Vrai
	FIN
	dbgVérifieVrai(bExceptionLevee, "taille 3 non autorisée lève une exception")
FIN


// Cas J : taille 0 → exception.
PROCEDURE PUBLIQUE scenario_taille_zero()
	bExceptionLevee est un booléen = Faux
	QUAND EXCEPTION DANS
		EntierVersBuffer(1, 0)
	FAIRE
		bExceptionLevee = Vrai
	FIN
	dbgVérifieVrai(bExceptionLevee, "taille 0 lève une exception")
FIN


// Cas K : composition de deux buffers — buffer [1] + buffer [2] = buffer 2 octets [1, 2].
PROCEDURE PUBLIQUE scenario_composition()
	buf est un buffer = EntierVersBuffer(1, 1) + EntierVersBuffer(2, 1)
	dbgVérifieEgalité(Taille(buf), 2, "composition produit un buffer de 2 octets")
	o1 est un entier = BufferLitOctet(buf, 1)
	o2 est un entier = BufferLitOctet(buf, 2)
	dbgVérifieEgalité(o1, 1, "premier octet = 1")
	dbgVérifieEgalité(o2, 2, "deuxième octet = 2")
FIN


// Edge case : valeur 0 sur 4 octets — tous les octets sont nuls.
PROCEDURE PRIVÉE scenario_edge_zero()
	buf est un buffer = EntierVersBuffer(0, 4)
	dbgVérifieEgalité(Taille(buf), 4, "taille = 4 octets")
	o1 est un entier = BufferLitOctet(buf, 1)
	o2 est un entier = BufferLitOctet(buf, 2)
	o3 est un entier = BufferLitOctet(buf, 3)
	o4 est un entier = BufferLitOctet(buf, 4)
	dbgVérifieEgalité(o1, 0, "octet 1 = 0")
	dbgVérifieEgalité(o2, 0, "octet 2 = 0")
	dbgVérifieEgalité(o3, 0, "octet 3 = 0")
	dbgVérifieEgalité(o4, 0, "octet 4 = 0")
FIN


// Edge case : -1 sur 1 octet — tient en signé [-128,127], produit 0xFF = 255.
PROCEDURE PRIVÉE scenario_edge_negatif_1_octet()
	buf est un buffer = EntierVersBuffer(-1, 1)
	dbgVérifieEgalité(Taille(buf), 1, "taille = 1 octet")
	o est un entier = BufferLitOctet(buf, 1)
	dbgVérifieEgalité(o, 255, "-1 en complément à deux sur 1 octet = 0xFF = 255")
FIN


// Edge case : -256 sur 2 octets petit-boutiste — 0xFF00 → octets [0x00, 0xFF].
PROCEDURE PRIVÉE scenario_edge_negatif_2_octets()
	buf est un buffer = EntierVersBuffer(-256, 2)
	dbgVérifieEgalité(Taille(buf), 2, "taille = 2 octets")
	o1 est un entier = BufferLitOctet(buf, 1)
	o2 est un entier = BufferLitOctet(buf, 2)
	dbgVérifieEgalité(o1, 0, "octet 1 = 0x00 — poids faible")
	dbgVérifieEgalité(o2, 255, "octet 2 = 0xFF = 255 — poids fort")
FIN


// Edge case : 258 sur 2 octets, boutisme grand — 0x0102 → octets [0x01, 0x02].
PROCEDURE PRIVÉE scenario_edge_gros_boutiste_2octets()
	buf est un buffer = EntierVersBuffer(258, 2, boutismeGros)
	dbgVérifieEgalité(Taille(buf), 2, "taille = 2 octets")
	o1 est un entier = BufferLitOctet(buf, 1)
	o2 est un entier = BufferLitOctet(buf, 2)
	dbgVérifieEgalité(o1, 1, "octet 1 = 0x01 — poids fort en premier")
	dbgVérifieEgalité(o2, 2, "octet 2 = 0x02 — poids faible en dernier")
FIN


// Edge case : taille 5 → exception (hors {1,2,4,8}).
PROCEDURE PRIVÉE scenario_edge_taille_5()
	bExceptionLevee est un booléen = Faux
	QUAND EXCEPTION DANS
		EntierVersBuffer(1, 5)
	FAIRE
		bExceptionLevee = Vrai
	FIN
	dbgVérifieVrai(bExceptionLevee, "taille 5 non autorisée lève une exception")
FIN


// Edge case : boutismePetit explicite — résultat identique au comportement par défaut.
PROCEDURE PRIVÉE scenario_edge_petit_boutiste_explicite()
	buf est un buffer = EntierVersBuffer(1000, 4, boutismePetit)
	dbgVérifieEgalité(Taille(buf), 4, "boutismePetit explicite produit 4 octets")
	o1 est un entier = BufferLitOctet(buf, 1)
	dbgVérifieEgalité(o1, 232, "boutismePetit explicite : octet 1 = 0xE8 (232)")
FIN


// Edge case : forme EN de l'enum — littleEndian produit le même résultat que boutismePetit.
PROCEDURE PRIVÉE scenario_edge_en_little_endian()
	buf est un buffer = EntierVersBuffer(1000, 4, littleEndian)
	o1 est un entier = BufferLitOctet(buf, 1)
	dbgVérifieEgalité(o1, 232, "littleEndian donne le même octet 1 que boutismePetit")
FIN


// Edge case : forme EN de l'enum — bigEndian produit le même résultat que boutismeGros.
PROCEDURE PRIVÉE scenario_edge_en_big_endian()
	buf est un buffer = EntierVersBuffer(1000, 4, bigEndian)
	o1 est un entier = BufferLitOctet(buf, 1)
	dbgVérifieEgalité(o1, 0, "bigEndian : octet 1 = 0x00 (poids fort)")
FIN
