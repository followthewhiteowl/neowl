// Fenêtre voisine — ressource pour test_TableCherche.owl.
//
// Un champ Table par programmation, une colonne "Produit" peuplée de
// 5 lignes dans FinInitialisation (dont deux valeurs identiques, pour
// exercer la ligne de départ et les occurrences multiples).

FEN_TableCherche est une Fenêtre
	PROPRIETES
		Titre       = "Recherche produits"
		Disposition = dispLibre
	FIN

	TAB_Produits est un Champ Table
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 400
			Hauteur = 300
		FIN

		COL_Produit est une Colonne
			PROPRIETES
				Libellé = "Produit"
				Type    = colTypeTexte
				Largeur = 200
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		TableAjouteLigne(TAB_Produits, "Chemise")
		TableAjouteLigne(TAB_Produits, "Pantalon")
		TableAjouteLigne(TAB_Produits, "Chemisier")
		TableAjouteLigne(TAB_Produits, "Chemise")
		TableAjouteLigne(TAB_Produits, "Veste")
	FIN
FIN
