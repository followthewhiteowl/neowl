// Fenêtre voisine — ressource pour test_TableCherchePartout.owl.
//
// Un champ Table par programmation, deux colonnes ("Produit" et "Couleur")
// peuplées de 5 lignes dans FinInitialisation. La valeur recherchée peut
// se trouver dans n'importe quelle colonne — c'est l'intérêt de "Partout"
// face à TableCherche qui ne fouille qu'une seule colonne.

FEN_TableCherchePartout est une Fenêtre
	PROPRIETES
		Titre       = "Recherche produits (toutes colonnes)"
		Disposition = dispLibre
	FIN

	TAB_Produits est un Champ Table
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 400
			Hauteur = 300
		FIN

		COL_Produit est une Colonne
			PROPRIETES
				Libellé = "Produit"
				Type    = colTypeTexte
				Largeur = 200
			FIN
		FIN

		COL_Couleur est une Colonne
			PROPRIETES
				Libellé = "Couleur"
				Type    = colTypeTexte
				Largeur = 200
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		TableAjouteLigne(TAB_Produits, "Chemise", "Bleu")
		TableAjouteLigne(TAB_Produits, "Pantalon", "Noir")
		TableAjouteLigne(TAB_Produits, "Chemisier", "Bleu")
		TableAjouteLigne(TAB_Produits, "Chemise", "Rouge")
		TableAjouteLigne(TAB_Produits, "Veste", "Noir")
	FIN
FIN
