// @sujet : CoefficientDétermination, ErreurAbsolueMoyenne, CSVVersMatrice, MatriceStandardiseColonnes
// @résumé : Démonstration complète d'un pipeline de régression tabulaire :
// deux chaînes CSV numériques (variables explicatives, cible) sont
// converties en Matrice via CSVVersMatrice, les variables explicatives sont
// centrées-réduites avec MatriceStandardiseColonnes, un IAModèle à une
// couche dense est entraîné par descente de gradient (OptionsEntraînement
// avec Perte = perteErreurQuadratique), puis le coefficient de
// détermination et l'erreur absolue moyenne mesurent la qualité des
// prédictions avant/après entraînement. Jeu de données synthétique
// exactement linéaire (cible = 3*x1 + 2*x2 + 5, sans bruit), représentable
// sans résidu par une seule couche dense.


// Le pipeline complet prouve l'apprentissage : le coefficient de
// détermination R² sur les données d'entraînement doit augmenter nettement
// (se rapprocher de 1) et l'erreur absolue moyenne doit baisser nettement
// après entraînement, par rapport à l'état initial (poids aléatoires).
PROCEDURE PUBLIQUE scenario_regression_tabulaire_apprend()
	InitHasard(2024)

	// 8 échantillons, 2 variables explicatives.
	csvX est une chaîne = "1.0;2.0" + CRLF + "2.0;1.0" + CRLF + "3.0;4.0" + CRLF + "4.0;3.0" + CRLF + "5.0;6.0" + CRLF + "6.0;5.0" + CRLF + "7.0;8.0" + CRLF + "8.0;7.0"
	matX est une Matrice = CSVVersMatrice(csvX, ";", Faux)

	// Cible générée sans bruit par cible = 3*x1 + 2*x2 + 5, exactement
	// représentable par une couche dense (2 entrées, 1 sortie) :
	//   [1,2] -> 3+4+5=12   [2,1] -> 6+2+5=13   [3,4] -> 9+8+5=22   [4,3] -> 12+6+5=23
	//   [5,6] -> 15+12+5=32 [6,5] -> 18+10+5=33 [7,8] -> 21+16+5=42 [8,7] -> 24+14+5=43
	csvY est une chaîne = "12.0" + CRLF + "13.0" + CRLF + "22.0" + CRLF + "23.0" + CRLF + "32.0" + CRLF + "33.0" + CRLF + "42.0" + CRLF + "43.0"
	matY est une Matrice = CSVVersMatrice(csvY, ";", Faux)

	// Standardisation des variables explicatives uniquement (convention
	// usuelle : la cible reste en unité brute).
	matXStd est une Matrice = MatriceStandardiseColonnes(matX)

	tX est un Tenseur = Tenseur(matXStd)
	tY est un Tenseur = Tenseur(matY)

	mon est un IAModèle
	mon.AjouteCoucheDense(2, 1)

	// Mesures AVANT entraînement (poids d'initialisation aléatoire).
	sortieAvant est un Tenseur = mon.Infère(tX)
	r2Avant est un réel = CoefficientDétermination(sortieAvant, tY)
	maeAvant est un réel = ErreurAbsolueMoyenne(sortieAvant, tY)

	opts est un OptionsEntraînement
	opts..Époques           = 400
	opts..TailleLot         = 8
	opts..TauxApprentissage = 0.05
	opts..Optimiseur        = optimSGD
	opts..Perte             = perteErreurQuadratique

	mon.Entraîne(tX, tY, opts)

	// Mesures APRÈS entraînement.
	sortieApres est un Tenseur = mon.Infère(tX)
	r2Apres est un réel = CoefficientDétermination(sortieApres, tY)
	maeApres est un réel = ErreurAbsolueMoyenne(sortieApres, tY)

	dbgVérifieVrai(r2Apres > r2Avant, "R² a augmenté après entraînement : le modèle a appris")
	dbgVérifieVrai(maeApres < maeAvant, "MAE a baissé après entraînement : le modèle a appris")

	// Cible exactement représentable sans résidu par une couche dense :
	// l'ajustement final doit être quasi parfait (R² proche de 1).
	dbgVérifieVrai(r2Apres > 0.9, "cible linéaire sans bruit, exactement représentable : R² final proche de 1")
FIN
