// @sujet : DonneIdentifiant
// @résumé : Renvoie un entier unique et croissant à chaque appel au sein d'un même run.

// ============================================
// Cas pedagogiques (publics)
// ============================================

PROCEDURE PUBLIQUE scenario_incrément_de_1()
	// Chaque appel renvoie la valeur précédente augmentée de 1.
	n1 est un entier = DonneIdentifiant()
	n2 est un entier = DonneIdentifiant()
	n3 est un entier = DonneIdentifiant()
	dbgVérifieEgalité(n2, n1 + 1, "le deuxième appel vaut le premier + 1")
	dbgVérifieEgalité(n3, n2 + 1, "le troisième appel vaut le deuxième + 1")
FIN

PROCEDURE PUBLIQUE scenario_valeurs_distinctes()
	// Deux appels successifs ne renvoient jamais la même valeur.
	id1 est un entier = DonneIdentifiant()
	id2 est un entier = DonneIdentifiant()
	dbgVérifieVrai(id1 <> id2, "deux appels donnent des identifiants distincts")
	dbgVérifieVrai(id2 > id1, "la suite est strictement croissante")
FIN

PROCEDURE PUBLIQUE scenario_entier_positif()
	// Au sein d'un run normal, l'identifiant est un entier strictement positif.
	n est un entier = DonneIdentifiant()
	dbgVérifieVrai(n > 0, "l'identifiant est strictement positif")
FIN
