// Fenêtre voisine — ressource pour test_MaFenetre.owl.
//
// Chaque bouton illustre une facette de MaFenêtre : modification du Titre
// de la fenêtre qui le contient depuis son propre gestionnaire, alias EN
// (MyWindow), forme sans accent (MaFenetre), et délégation à une
// procédure externe (héritage de la chaîne d'appel, comme MoiMême).
// Les procédures externes utilisées par BTN_Chain / BTN_ChainMyWindow
// sont déclarées côté test et vues via le mode script voisinage.

FEN_MaFenetre est une Fenêtre
	PROPRIETES
		Titre       = "Titre initial"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 300
	FIN

	// Bouton qui modifie le Titre de sa fenêtre parente via MaFenêtre.
	BTN_Auto est un Champ Bouton
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 150
			Hauteur = 30
			Libellé = "Bouton"
		FIN
		PROCEDURE surClic()
			MaFenêtre..Titre = "Titre modifié"
		FIN
	FIN

	// Bouton pour tester l'alias EN MyWindow dans son propre handler.
	BTN_MyWindow est un Champ Bouton
		PROPRIETES
			X       = 10
			Y       = 60
			Largeur = 150
			Hauteur = 30
			Libellé = "Bouton EN"
		FIN
		PROCEDURE surClic()
			MyWindow..Titre = "EN Titre modifié"
		FIN
	FIN

	// Bouton pour tester la forme sans accent (MaFenetre).
	BTN_Accent est un Champ Bouton
		PROPRIETES
			X       = 10
			Y       = 110
			Largeur = 150
			Hauteur = 30
			Libellé = "Bouton Accent"
		FIN
		PROCEDURE surClic()
			MaFenetre..Titre = "Titre sans accent"
		FIN
	FIN

	// Bouton dont le handler délègue à une procédure externe qui utilise
	// MaFenêtre -- verrouille l'héritage de la chaîne d'appel.
	BTN_Chain est un Champ Bouton
		PROPRIETES
			X       = 10
			Y       = 160
			Largeur = 150
			Hauteur = 30
			Libellé = "Bouton Chain"
		FIN
		PROCEDURE surClic()
			ModifierTitreViaMaFenetre()
		FIN
	FIN

	// Idem via l'alias EN MyWindow, depuis une procédure externe.
	BTN_ChainMyWindow est un Champ Bouton
		PROPRIETES
			X       = 10
			Y       = 210
			Largeur = 150
			Hauteur = 30
			Libellé = "Bouton Chain EN"
		FIN
		PROCEDURE surClic()
			ModifierTitreViaMyWindow()
		FIN
	FIN
FIN
