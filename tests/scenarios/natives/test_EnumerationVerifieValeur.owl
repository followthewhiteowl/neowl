// @sujet : EnumérationVérifieValeur
// @résumé : Indique si une valeur explicite correspond à un membre d'une
// énumération, sans faire échouer l'appelant sur une valeur inconnue.

ENuance est une Énumération
	Rouge = "R"
	Vert  = "V"
FIN

Statut est une Énumération
	Actif    = 1
	Suspendu = 5
FIN

PROCEDURE PUBLIQUE scenario_valeur_existante_chaine()
	dbgVérifieVrai(EnumérationVérifieValeur(ENuance, "R"), "La valeur R existe dans ENuance")
FIN

PROCEDURE PUBLIQUE scenario_valeur_existante_entiere()
	dbgVérifieVrai(EnumérationVérifieValeur(Statut, 5), "La valeur 5 existe dans Statut")
FIN

PROCEDURE PUBLIQUE scenario_valeur_absente()
	dbgVérifieFaux(EnumérationVérifieValeur(ENuance, "Z"), "La valeur Z n'existe pas dans ENuance")
FIN

PROCEDURE PRIVÉE scenario_edge_valeur_zero_absente()
	dbgVérifieFaux(EnumérationVérifieValeur(Statut, 0), "La valeur 0 n'est associée à aucun membre de Statut")
FIN
