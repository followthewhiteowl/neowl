// @sujet : fAjouteTexte
// @résumé : Ajoute du texte à la fin d'un fichier, en le créant s'il n'existe pas. Sans argument d'encodage, le texte est écrit en UTF-8. Avec un encodage explicite (encUTF8, encLatin1, encWindows1252, encUTF16LE, encUTF16BE), le contenu est transcodé avant l'ajout. Des appels successifs concatènent le texte sur disque dans l'ordre d'ajout.


// Cas A : fichier inexistant — fAjouteTexte le crée avec le texte fourni.
PROCEDURE PUBLIQUE scenario_fat_creation_fichier_inexistant()
	chemin est une chaîne = "_tmp_fat_0143_A.txt"
	fSupprime(chemin)
	ok est un booléen = fAjouteTexte(chemin, "bonjour")
	dbgVérifieVrai(ok, "fAjouteTexte sur fichier inexistant retourne Vrai et le crée")
	sLu est une chaîne = fChargeTexte(chemin)
	dbgVérifieEgalité(sLu, "bonjour", "contenu relu identique au texte ajouté")
	fSupprime(chemin)
FIN


// Cas B : fichier existant — deux ajouts successifs concatènent le texte dans l'ordre.
PROCEDURE PUBLIQUE scenario_fat_concatenation_fichier_existant()
	chemin est une chaîne = "_tmp_fat_0143_B.txt"
	fSupprime(chemin)
	ok1 est un booléen = fAjouteTexte(chemin, "bonjour ")
	dbgVérifieVrai(ok1, "premier fAjouteTexte retourne Vrai")
	ok2 est un booléen = fAjouteTexte(chemin, "monde")
	dbgVérifieVrai(ok2, "second fAjouteTexte retourne Vrai")
	sLu est une chaîne = fChargeTexte(chemin)
	dbgVérifieEgalité(sLu, "bonjour monde", "les deux ajouts sont concaténés dans l'ordre")
	fSupprime(chemin)
FIN


// Cas C : vérification des octets réels — défaut UTF-8, é occupe 2 octets (195, 169) sur disque.
PROCEDURE PUBLIQUE scenario_fat_octets_utf8_defaut()
	chemin est une chaîne = "_tmp_fat_0143_C.txt"
	fSupprime(chemin)
	ok est un booléen = fAjouteTexte(chemin, "é")
	dbgVérifieVrai(ok, "fAjouteTexte sans encodage retourne Vrai")
	buf est un buffer = fChargeBuffer(chemin)
	dbgVérifieEgalité(Taille(buf), 2, "é en UTF-8 (défaut) = 2 octets sur disque")
	dbgVérifieEgalité(BufferLitOctet(buf, 1), 195, "premier octet de é en UTF-8 (195 = 0xC3)")
	dbgVérifieEgalité(BufferLitOctet(buf, 2), 169, "second octet de é en UTF-8 (169 = 0xA9)")
	fSupprime(chemin)
FIN


// Cas D : round-trip encodage Europe occidentale (encLatin1) — àéî tiennent sur 1 octet chacun.
PROCEDURE PUBLIQUE scenario_fat_roundtrip_latin1()
	chemin est une chaîne = "_tmp_fat_0143_D.txt"
	fSupprime(chemin)
	ok est un booléen = fAjouteTexte(chemin, "àéî", encLatin1)
	dbgVérifieVrai(ok, "fAjouteTexte àéî en encLatin1 retourne Vrai")
	buf est un buffer = fChargeBuffer(chemin)
	dbgVérifieEgalité(Taille(buf), 3, "àéî en Latin-1 = 3 octets sur disque (1 par caractère)")
	sLu est une chaîne = fChargeTexte(chemin, encLatin1)
	dbgVérifieEgalité(sLu, "àéî", "round-trip encLatin1 restitue àéî")
	fSupprime(chemin)
FIN


// Cas E : deux ajouts successifs en encUTF16LE — chaque ajout est transcodé avant écriture, la relecture restitue la concaténation.
PROCEDURE PUBLIQUE scenario_fat_deux_ajouts_utf16le()
	chemin est une chaîne = "_tmp_fat_0143_E.txt"
	fSupprime(chemin)
	ok1 est un booléen = fAjouteTexte(chemin, "A", encUTF16LE)
	dbgVérifieVrai(ok1, "premier fAjouteTexte en encUTF16LE retourne Vrai")
	ok2 est un booléen = fAjouteTexte(chemin, "é", encUTF16LE)
	dbgVérifieVrai(ok2, "second fAjouteTexte en encUTF16LE retourne Vrai")
	sLu est une chaîne = fChargeTexte(chemin, encUTF16LE)
	dbgVérifieEgalité(sLu, "Aé", "les deux ajouts UTF-16LE concaténés relus donnent Aé")
	fSupprime(chemin)
FIN


// Cas limite : ajout d'un texte vide sur un fichier déjà existant — le contenu ne change pas.
PROCEDURE PRIVÉE scenario_fat_edge_texte_vide()
	chemin est une chaîne = "_tmp_fat_0143_Z.txt"
	fSupprime(chemin)
	ok1 est un booléen = fAjouteTexte(chemin, "intact")
	dbgVérifieVrai(ok1, "création initiale du fichier retourne Vrai")
	ok2 est un booléen = fAjouteTexte(chemin, "")
	dbgVérifieVrai(ok2, "ajout d'un texte vide retourne Vrai sans erreur")
	sLu est une chaîne = fChargeTexte(chemin)
	dbgVérifieEgalité(sLu, "intact", "le contenu reste inchangé après ajout d'un texte vide")
	fSupprime(chemin)
FIN
