// @sujet : ArrondiSupérieur
// @résumé : Arrondit un nombre à l'entier ou à la décimale supérieure (plafond vers +∞).
// ArrondiSupérieur(n [, décimales]) : plafond orienté vers les valeurs les plus hautes.
// Symétrique d'ArrondiInférieur.


// Cas A : plafond à 1 décimale — positifs et négatifs.
// Vers +∞ : 3.12 monte à 3.2, mais -3.12 monte à -3.1 (plus haut, plus proche de 0).
PROCEDURE PUBLIQUE scenario_plafond_decimales()
	dbgVérifieEgalité(ArrondiSupérieur(3.12, 1), 3.2, "ArrondiSupérieur(3.12, 1) = 3.2")
	dbgVérifieEgalité(ArrondiSupérieur(-3.12, 1),-3.1, "ArrondiSupérieur(-3.12, 1) = -3.1 (vers +∞)")
FIN


// Cas B : plafond à l'entier (sans décimales) — défaut 0.
// 3.12 → 4, -3.12 → -3 (l'entier supérieur ou égal).
PROCEDURE PUBLIQUE scenario_plafond_entier()
	dbgVérifieEgalité(ArrondiSupérieur(3.12), 4, "ArrondiSupérieur(3.12) = 4")
	dbgVérifieEgalité(ArrondiSupérieur(-3.12),-3, "ArrondiSupérieur(-3.12) = -3 (vers +∞)")
FIN


// Edge : forme EN bilingue — RoundCeil.
PROCEDURE PRIVÉE scenario_bilingue_en()
	dbgVérifieEgalité(RoundCeil(3.12, 1), 3.2, "RoundCeil(3.12, 1) = 3.2 (forme EN)")
	dbgVérifieEgalité(RoundCeil(3.12), 4, "RoundCeil(3.12) = 4 (forme EN)")
FIN


// Edge : entier exact et zéro — retournés tels quels.
PROCEDURE PRIVÉE scenario_edge_exact()
	dbgVérifieEgalité(ArrondiSupérieur(5.0), 5, "ArrondiSupérieur(5.0) = 5")
	dbgVérifieEgalité(ArrondiSupérieur(0.0), 0, "ArrondiSupérieur(0.0) = 0")
	dbgVérifieEgalité(ArrondiSupérieur(-5.0),-5, "ArrondiSupérieur(-5.0) = -5")
FIN
