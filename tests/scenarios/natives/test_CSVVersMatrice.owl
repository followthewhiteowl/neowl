// @sujet : CSVVersMatrice
// @résumé : Parse une chaîne CSV tout-numérique directement en Matrice, sans passer par un tableau intermédiaire. Séparateur de colonne configurable, entête optionnellement ignorée, cellule non-numérique refusée.

// ═════════════════════════════════════════════════════════════════════════════
// PROCEDURES PUBLIQUES : exemples documentaires pour utilisateur
// ═════════════════════════════════════════════════════════════════════════════

PROCEDURE PUBLIQUE scenario_csv_sans_entete_vers_matrice()
	// CSV numérique sans entête : chaque ligne devient une ligne de Matrice.
	csv est une chaîne = "1.0;2.0;3.0" + CRLF + "4.0;5.0;6.0"
	m est une Matrice = CSVVersMatrice(csv, ";", Faux)

	dbgVérifieEgalité(m..Lignes, 2, "2 lignes CSV -> 2 lignes de Matrice")
	dbgVérifieEgalité(m..Colonnes, 3, "3 champs par ligne -> 3 colonnes")
	dbgVérifieEgalité(m[1][1], 1.0, "m[1][1] = 1.0")
	dbgVérifieEgalité(m[1][3], 3.0, "m[1][3] = 3.0")
	dbgVérifieEgalité(m[2][2], 5.0, "m[2][2] = 5.0")
FIN

PROCEDURE PUBLIQUE scenario_csv_avec_entete_ignoree()
	// ignoreEntête = Vrai : la 1re ligne est sautée, elle n'est jamais
	// convertie en réel (même si elle n'est pas numérique).
	csv est une chaîne = "colA;colB" + CRLF + "10.0;20.0" + CRLF + "30.0;40.0"
	m est une Matrice = CSVVersMatrice(csv, ";", Vrai)

	dbgVérifieEgalité(m..Lignes, 2, "Entête ignorée : 3 lignes CSV -> 2 lignes de Matrice")
	dbgVérifieEgalité(m[1][1], 10.0, "m[1][1] = première valeur après l'entête")
	dbgVérifieEgalité(m[2][2], 40.0, "m[2][2] = dernière valeur")
FIN

PROCEDURE PUBLIQUE scenario_separateur_virgule()
	// Le séparateur de colonne est paramétrable, ici la virgule.
	csv est une chaîne = "1.5,2.5" + CRLF + "3.5,4.5"
	m est une Matrice = CSVVersMatrice(csv, ",", Faux)

	dbgVérifieEgalité(m..Colonnes, 2, "Séparateur virgule : 2 colonnes détectées")
	dbgVérifieEgalité(m[1][2], 2.5, "m[1][2] = 2.5")
	dbgVérifieEgalité(m[2][1], 3.5, "m[2][1] = 3.5")
FIN

PROCEDURE PUBLIQUE scenario_cellule_non_numerique_refusee()
	// Une cellule qui n'est pas un nombre (hors entête ignorée) fait
	// échouer la conversion avec une exception récupérable.
	csv est une chaîne = "1.0;2.0" + CRLF + "abc;4.0"

	capturé est une chaîne = ""
	QUAND EXCEPTION DANS
		m est une Matrice = CSVVersMatrice(csv, ";", Faux)
		capturé = "no-throw"
	FAIRE
		capturé = "caught"
	FIN
	dbgVérifieEgalité(capturé, "caught", "Cellule non-numérique refusée avec une exception claire")
FIN

PROCEDURE PUBLIQUE scenario_forme_anglaise()
	// CSVToMatrix désigne la même opération que CSVVersMatrice.
	csv est une chaîne = "7.0;8.0" + CRLF + "9.0;10.0"
	m est une Matrice = CSVToMatrix(csv, ";", Faux)

	dbgVérifieEgalité(m..Lignes, 2, "CSVToMatrix (EN) : 2 lignes")
	dbgVérifieEgalité(m[2][1], 9.0, "CSVToMatrix (EN) : m[2][1] = 9.0")
FIN

// ═════════════════════════════════════════════════════════════════════════════
// PROCEDURES PRIVÉES : edge cases et cas limites (initiative test_writer)
// ═════════════════════════════════════════════════════════════════════════════

PROCEDURE PRIVÉE scenario_edge_entete_non_numerique_pas_gene()
	// Même une entête clairement non-numérique ("Prix", "Poids") ne pose
	// pas problème dès lors qu'elle est ignorée : elle n'est jamais parsée.
	csv est une chaîne = "Prix;Poids" + CRLF + "12.0;3.0"
	m est une Matrice = CSVVersMatrice(csv, ";", Vrai)

	dbgVérifieEgalité(m..Lignes, 1, "1 seule ligne de données après entête ignorée")
	dbgVérifieEgalité(m[1][1], 12.0, "m[1][1] = 12.0")
FIN

PROCEDURE PRIVÉE scenario_edge_valeurs_negatives()
	// Les valeurs négatives sont des réels valides, pas des cellules refusées.
	csv est une chaîne = "-1.5;2.0" + CRLF + "3.0;-4.5"
	m est une Matrice = CSVVersMatrice(csv, ";", Faux)

	dbgVérifieEgalité(m[1][1],-1.5, "m[1][1] = -1.5")
	dbgVérifieEgalité(m[2][2],-4.5, "m[2][2] = -4.5")
FIN

PROCEDURE PRIVÉE scenario_edge_entiers_coerces_en_reel()
	// Des cellules écrites sans décimale ("1", "2") sont coercées en réel,
	// comme tout élément de Matrice.
	csv est une chaîne = "1;2" + CRLF + "3;4"
	m est une Matrice = CSVVersMatrice(csv, ";", Faux)

	dbgVérifieEgalité(m[1][1], 1.0, "Cellule entière '1' coercée en réel 1.0")
	dbgVérifieEgalité(m[2][2], 4.0, "Cellule entière '4' coercée en réel 4.0")
FIN

PROCEDURE PRIVÉE scenario_edge_csv_non_rectangulaire_refuse()
	// Toutes les lignes doivent porter le même nombre de champs : une ligne
	// plus courte fait échouer la conversion avec une exception récupérable.
	csv est une chaîne = "1.0;2.0" + CRLF + "3.0"

	capturé est une chaîne = ""
	QUAND EXCEPTION DANS
		m est une Matrice = CSVVersMatrice(csv, ";", Faux)
		capturé = "no-throw"
	FAIRE
		capturé = "caught"
	FIN
	dbgVérifieEgalité(capturé, "caught", "CSV non rectangulaire refusé avec une exception")
FIN

PROCEDURE PRIVÉE scenario_edge_csv_vide_refuse()
	// Un contenu sans aucune ligne de données ne produit pas une Matrice vide
	// silencieuse : il lève une exception récupérable.
	csv est une chaîne = ""

	capturé est une chaîne = ""
	QUAND EXCEPTION DANS
		m est une Matrice = CSVVersMatrice(csv, ";", Faux)
		capturé = "no-throw"
	FAIRE
		capturé = "caught"
	FIN
	dbgVérifieEgalité(capturé, "caught", "CSV vide refusé avec une exception")
FIN
