// Ressource fenetre — voisine de test_FenEtat.owl.
// Fenetre minimale servant de cible a FenEtat (etat / existence).

FEN_FenEtat est une Fenêtre
	PROPRIETES
		Titre       = "Controle fenetre"
		Largeur     = 300
		Hauteur     = 200
		Disposition = dispLibre
	FIN

	LIB_Info est un Champ Libellé
		PROPRIETES
			Libellé = "Cible FenEtat"
			X       = 10
			Y       = 10
			Largeur = 250
			Hauteur = 20
		FIN
	FIN
FIN
