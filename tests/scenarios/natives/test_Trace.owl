// @sujet : Trace
// @résumé : Écrit une ou plusieurs valeurs sur la sortie standard avec retour à la ligne. Outil d'instrumentation pour inspecter l'état du programme pendant son exécution.


// Cas canonique : une seule valeur. Le contenu envoyé sur la sortie
// standard reproduit la valeur telle qu'elle apparaît au programme.
PROCEDURE scenario_valeur_simple()
	nResultat est un entier = 42
	Trace(nResultat)
	dbgVérifieEgalité(nResultat, 42)
FIN


// Plusieurs arguments : Trace concatène les arguments en les
// séparant par un espace dans l'ordre d'apparition.
PROCEDURE scenario_arguments_multiples()
	sNom est une chaîne = "Alice"
	nAge est un entier = 30
	Trace("Utilisateur :", sNom, "âge :", nAge)
	dbgVérifieEgalité(sNom, "Alice")
	dbgVérifieEgalité(nAge, 30)
FIN


// Instrumentation typique : inspecter une variable intermédiaire au
// milieu d'un calcul sans interrompre le flux du programme.
PROCEDURE scenario_inspection_calcul()
	nBase est un entier = 7
	nFacteur est un entier = 6
	Trace("base =", nBase, "facteur =", nFacteur)
	nProduit est un entier = nBase * nFacteur
	Trace("produit =", nProduit)
	dbgVérifieEgalité(nProduit, 42)
FIN


// Trace accepte les booléens : pratique pour confirmer la branche
// prise par un test conditionnel.
PROCEDURE scenario_booleen()
	bAdmin est un booléen = Vrai
	Trace("est admin :", bAdmin)
	SI bAdmin ALORS
		Trace("acces accorde")
	SINON
		Trace("acces refuse")
	FIN
	dbgVérifieEgalité(bAdmin, Vrai)
FIN


// Chaîne vide : Trace écrit une ligne vide. Utile pour aérer la
// sortie quand on enchaîne plusieurs inspections.
PROCEDURE scenario_chaine_vide()
	Trace("")
	Trace("apres ligne vide")
	dbgVérifieVrai(Vrai, "Trace sur chaine vide n'a pas leve d'erreur")
FIN
