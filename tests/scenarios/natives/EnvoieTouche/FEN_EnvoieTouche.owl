// Ressource fenetre — voisin de test_EnvoieTouche.owl.
// Fenetre minimale avec surToucheAppuyee pour observer les injections
// de frappes via EnvoieTouche.

FEN_EnvoieTouche est une Fenêtre
	PROPRIETES
		Titre       = "EnvoieTouche demo"
		Largeur     = 300
		Hauteur     = 150
		Disposition = dispLibre
	FIN

	nEnvoiCount est un entier = 0
	nDerniereEnvoi est un entier = -1

	PROCEDURE surToucheAppuyee(nTouche est un entier)
		nEnvoiCount += 1
		nDerniereEnvoi = nTouche
		callback_envoie_touche(nTouche)
	FIN

	PROCEDURE LireEnvoiCompteur()
		callback_envoie_etat(nEnvoiCount, nDerniereEnvoi)
	FIN
FIN
