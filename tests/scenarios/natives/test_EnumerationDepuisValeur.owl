// @sujet : EnumérationDepuisValeur
// @résumé : Retrouve le membre d'une énumération à partir de sa valeur
// explicite (recherche inverse valeur -> membre). Sans valeur par défaut,
// une valeur introuvable lève une exception ; avec un défaut, la fonction
// renvoie ce défaut plutôt que d'échouer.

ENuance est une Énumération
	Rouge = "R"
	Vert  = "V"
	Bleu  = "B"
FIN

Statut est une Énumération
	Actif    = 1
	Suspendu = 5
	Cloture  = 9
FIN

PROCEDURE PUBLIQUE scenario_lookup_valeur_chaine()
	m est un ENuance = EnumérationDepuisValeur(ENuance, "R")
	dbgVérifieEgalité(m..Nom, "Rouge", "Le membre trouvé porte le nom Rouge")
	dbgVérifieEgalité(m..Valeur, "R", "Le membre trouvé porte la valeur R")
FIN

PROCEDURE PUBLIQUE scenario_lookup_valeur_entiere()
	m est un Statut = EnumérationDepuisValeur(Statut, 5)
	dbgVérifieEgalité(m..Nom, "Suspendu", "Le membre trouvé porte le nom Suspendu")
	dbgVérifieEgalité(m..Valeur, 5, "Le membre trouvé porte la valeur 5")
FIN

PROCEDURE PUBLIQUE scenario_introuvable_avec_defaut()
	m est un ENuance = EnumérationDepuisValeur(ENuance, "X", ENuance.Vert)
	dbgVérifieEgalité(m..Nom, "Vert", "Valeur introuvable : le défaut fourni est renvoyé")
FIN

PROCEDURE PUBLIQUE scenario_introuvable_sans_defaut_leve_exception()
	bLevée est un booléen = Faux
	sMessage est une chaîne = ""

	QUAND EXCEPTION DANS
		m est un ENuance = EnumérationDepuisValeur(ENuance, "Z")
	FAIRE
		bLevée   = Vrai
		sMessage = ExceptionInfo(errMessage)
	FIN

	dbgVérifieVrai(bLevée, "Valeur introuvable sans défaut : une exception est levée")
	dbgVérifieVrai(Taille(sMessage) > 0, "Le message d'exception n'est pas vide")
FIN

PROCEDURE PRIVÉE scenario_edge_valeur_sentinelle_basse()
	m est un Statut = EnumérationDepuisValeur(Statut, 1)
	dbgVérifieEgalité(m..Nom, "Actif", "La valeur la plus basse (1) résout le membre Actif")
FIN
