// Fenêtre voisine — ressource pour test_ChampsDe.owl.
//
// L'ordre de déclaration n'est PAS alphabétique (BTN_Zulu avant SAI_Alpha
// avant LIB_Milieu) : ça permet de distinguer un tri par ordre de création
// d'un tri alphabétique accidentel. ZR_Conteneur porte un champ interne
// (LIB_Interne) qui ne doit PAS apparaître dans les champs directs de la
// fenêtre — seulement dans ceux du conteneur lui-même.

FEN_ChampsDe est une Fenêtre
	PROPRIETES
		Titre       = "ChampsDe"
		Largeur     = 400
		Hauteur     = 300
		Disposition = dispLibre
	FIN

	BTN_Zulu est un Champ Bouton
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 100
			Hauteur = 30
			Libellé = "Zulu"
		FIN
	FIN

	SAI_Alpha est un Champ Saisie
		PROPRIETES
			X       = 10
			Y       = 50
			Largeur = 100
			Hauteur = 30
			Libellé = "Alpha"
		FIN
	FIN

	LIB_Milieu est un Champ Libellé
		PROPRIETES
			X       = 10
			Y       = 90
			Largeur = 100
			Hauteur = 30
			Libellé = "Milieu"
		FIN
	FIN

	ZR_Conteneur est un Champ ZoneRépétée
		PROPRIETES
			X       = 10
			Y       = 130
			Largeur = 300
			Hauteur = 100
			Sens    = zrVertical
		FIN

		LIB_Interne est un Champ Libellé
			PROPRIETES
				X       = 5
				Y       = 5
				Largeur = 100
				Libellé = "Interne"
			FIN
		FIN
	FIN
FIN
