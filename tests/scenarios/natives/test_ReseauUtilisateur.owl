// @sujet : RéseauUtilisateur
// @résumé : Renvoie le nom de l'utilisateur du système en cours de session.

// ============================================
// Cas pedagogiques (publics)
// ============================================

PROCEDURE PUBLIQUE scenario_non_vide()
	// Le nom de l'utilisateur courant est renseigné.
	nom est une chaîne = RéseauUtilisateur()
	dbgVérifieVrai(Taille(nom) > 0, "le nom d'utilisateur est non vide")
FIN

PROCEDURE PUBLIQUE scenario_login_simple()
	// Le résultat est le seul login, sans séparateur de domaine ni chemin.
	nom est une chaîne = RéseauUtilisateur()
	dbgVérifieVrai(Position(nom, Caract(92)) = 0, "pas de séparateur de domaine antéposé")
	dbgVérifieVrai(Position(nom, "/") = 0, "pas de séparateur de chemin")
FIN

PROCEDURE PUBLIQUE scenario_stable()
	// Deux appels successifs renvoient la même valeur.
	nom1 est une chaîne = RéseauUtilisateur()
	nom2 est une chaîne = RéseauUtilisateur()
	dbgVérifieEgalité(nom1, nom2, "appels successifs stables")
FIN
