kMGZ9nvThsqq9kHeaLZI43O/awiHxkDFlIYsoUb+KAHvTm+vJ5GjpHrkhkBp+d+M
M9wiSHQkck90lpBb+owRRWaM
-----END PRIVATE KEY-----`


PROCEDURE avantChaqueTest()
	rep est un httpRéponse
	rep..CodeEtat = 200
	rep..Contenu  = `{"access_token":"atk-custom-grant","expires_in":3600}`
	mockHttp      = MockCrée(HTTPEnvoie).Quand().Retourne(rep).Active()
FIN


PROCEDURE apresChaqueTest()
	mockHttp.Désactive()
FIN


// Flux personnalisé (gtCustomGrantType) : l'appelant signe lui-même une
// assertion JWT (JWTCréeAssertion) et la pose dans les paramètres
// supplémentaires avec son type ; AuthIdentifie transmet ces paramètres au
// fournisseur de jeton sans logique JWT propre (c'est tout le sens de
// "personnalisé" — le framework ne décide rien à la place de l'appelant).
PROCEDURE PUBLIQUE scenario_custom_grant_type_porte_assertion_jwt()
	sEntete  est une chaîne = `{"alg":"RS256","typ":"JWT"}`
	sPayload est une chaîne = `{"iss":"mon-client","sub":"mon-client","aud":"https://auth.exemple.test/token","exp":9999999999}`
	jwt      est une chaîne = JWTCréeAssertion(sEntete, sPayload, sCléPriveeTest)

	oParams est un OAuth2Paramètres
	oParams..ClientID                                           = "mon-client"
	oParams..URLToken                                           = "https://auth.exemple.test/token"
	oParams..TypeAutorisation                                   = gtCustomGrantType
	oParams..ParamètresSupplémentaires["client_assertion"]      = jwt
	oParams..ParamètresSupplémentaires["client_assertion_type"] = "urn:ietf:params:oauth:client-assertion-type:jwt-bearer"

	t est un AuthToken = AuthIdentifie(oParams)

	dbgVérifieVrai(t..Valide, "flux personnalisé -> jeton valide")
	dbgVérifieEgalité(t..Valeur, "atk-custom-grant")

	reqCapturee est un httpRequête = MockDernierArgument(mockHttp, 1)
	dbgVérifieEgalité(reqCapturee..URL, "https://auth.exemple.test/token")
	sCorps est une chaîne = BufferVersChaîne(reqCapturee..Contenu)
	dbgVérifieVrai(Position(sCorps, "client_assertion=") > 0, "corps POST porte client_assertion")
	dbgVérifieVrai(Position(sCorps, "client_assertion_type=urn%3Aietf%3Aparams%3Aoauth%3Aclient-assertion-type%3Ajwt-bearer") > 0, "corps POST porte client_assertion_type RFC 7523 (percent-encodé)")
FIN


dbgBilanTest()
