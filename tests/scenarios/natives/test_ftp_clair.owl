// fonction.
PROCEDURE PUBLIQUE scenario_repertoire_courant_modification()
	cnx est une ftpClient
	cnx..Serveur = "ftp.exemple.test"

	mockRepEnCours est un MockNative = MockCrée(FTPRepEnCours)
	mockRepEnCours.Quand().Retourne(Vrai).Active()

	bChange est un booléen = FTPRepEnCours(cnx, "/depot/archives")

	dbgVérifieVrai(bChange, "modification du répertoire courant distant confirmée")

	mockRepEnCours.Desactive()
FIN

// Même lecture, forme méthode.
PROCEDURE PUBLIQUE scenario_repertoire_courant_forme_methode()
	cnx est une ftpClient
	cnx..Serveur = "ftp.exemple.test"

	mockRepEnCours est un MockNative = MockCrée(FTPRepEnCours)
	mockRepEnCours.Quand().Retourne("/depot").Active()

	sRep est une chaîne = cnx.RepEnCours()

	dbgVérifieEgalité(sRep, "/depot", "la forme méthode relit le répertoire courant")

	mockRepEnCours.Desactive()
FIN

// Cas limite : un listage sans aucune correspondance retourne 0, distinct
// d'une erreur.
PROCEDURE PRIVÉE scenario_edge_liste_fichiers_aucun_resultat()
	cnx est une ftpClient
	cnx..Serveur = "ftp.exemple.test"

	mockListe est un MockNative = MockCrée(FTPListeFichier)
	mockListe.Quand().Retourne(0).Active()

	nCompte est un entier = FTPListeFichier(cnx, "/depot/*.iso", compteCSVCallback)

	dbgVérifieEgalité(nCompte, 0, "aucune correspondance retourne 0")

	mockListe.Desactive()
FIN

// Cas limite : répertoire courant à la racine du serveur.
PROCEDURE PRIVÉE scenario_edge_repertoire_courant_racine()
	cnx est une ftpClient
	cnx..Serveur = "ftp.exemple.test"

	mockRepEnCours est un MockNative = MockCrée(FTPRepEnCours)
	mockRepEnCours.Quand().Retourne("/").Active()

	sRep est une chaîne = FTPRepEnCours(cnx)

	dbgVérifieEgalité(sRep, "/", "répertoire courant à la racine")

	mockRepEnCours.Desactive()
FIN

// Cas limite : le callback de progression ne coupe pas tant que le
// transfert n'est pas achevé, y compris à taille nulle (rien à transférer,
// déjà "achevé").
PROCEDURE PRIVÉE scenario_edge_callback_progression_taille_nulle()
	dbgVérifieFaux(progressionTransfertCallback(0, 0), "transfert de taille nulle est immédiatement considéré achevé")
	dbgVérifieVrai(progressionTransfertCallback(1000, 250), "transfert partiel se poursuit")
FIN

dbgBilanTest()
