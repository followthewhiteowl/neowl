// Lecture du répertoire courant sur le serveur distant, forme fonction.
PROCEDURE PUBLIQUE scenario_repertoire_courant_lecture()
	cnx est une ftpClient
	cnx..Serveur = "ftp.exemple.test"

	mockRepEnCours est un MockNative = MockCrée(FTPRepEnCours)
	mockRepEnCours.Quand().Retourne("/depot").Active()

	sRep est une chaîne = FTPRepEnCours(cnx)

	dbgVérifieEgalité(sRep, "/depot", "lecture du répertoire courant distant")

	mockRepEnCours.Desactive()
FIN

