// Fenêtre voisine — ressource pour test_IntercepteEvenement.owl.
//
// BTN_Clic porte un bloc statique surClic (pour vérifier l'ordre
// interception → bloc statique, et la suppression du bloc statique).
// SAI_Modif porte un bloc statique surAChaqueModification (même usage),
// et ne déclare PAS surToucheRelâchée (pour vérifier l'interception sur
// un événement sans bloc statique existant).

FEN_Interc est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 200
	FIN

	BTN_Clic est un Champ Bouton
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 100
			Hauteur = 30
			Libellé = "Clic"
		FIN
		PROCEDURE surClic()
			callback_trace("statique:clic;")
		FIN
	FIN

	SAI_Modif est un Champ Saisie
		PROPRIETES
			X       = 10
			Y       = 60
			Largeur = 150
			Hauteur = 30
		FIN
		PROCEDURE surAChaqueModification()
			callback_trace("statique:modif;")
		FIN
	FIN
FIN
