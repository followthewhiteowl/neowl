// @sujet : dRemplissage
// @résumé : Remplir une zone connexe par flood fill ou boundary fill à partir d'un point

// ════════════════════════════════════════════════════════════════════════════════════
// SECTION PUBLIQUE — scénarios documentaires (usage typique, valeur pédagogique)
// ════════════════════════════════════════════════════════════════════════════════════

// Remplir une zone connexe simple depuis un point (flood fill)
PROCEDURE PUBLIQUE scenario_flood_fill_simple()
	img est un Image
	couleurBlanc est un entier = RVB(255, 255, 255)
	couleurRouge est un entier = RVB(255, 0, 0)
	couleurBleu est un entier = RVB(0, 0, 255)
	pixelTest est un entier

	// Créer image blanche, dessiner bordure rouge, remplir intérieur blanc en bleu
	img = dCréeImage(100, 100, couleurBlanc)
	dDébutDessin(img)
	dRectangle(img, 10, 10, 90, 90, Transparent, couleurRouge)
	dRemplissage(img, 50, 50, couleurBleu)
	dFinDessin(img)

	pixelTest = dPixelCouleur(img, 50, 50)

	// Le point central (50,50) doit être bleu après remplissage
	dbgVérifieEgalité(pixelTest, couleurBleu, "flood fill : intérieur zone rempli bleu")
FIN

// Remplir zone en s'arrêtant à une couleur de bordure (boundary fill)
PROCEDURE PUBLIQUE scenario_boundary_fill_avec_couleur_bordure()
	img est un Image
	couleurBlanc est un entier = RVB(255, 255, 255)
	couleurNoir est un entier = RVB(0, 0, 0)
	couleurVert est un entier = RVB(0, 255, 0)
	pixelInterieur est un entier
	pixelBordure est un entier

	// Créer image blanche, dessiner bordure noire, remplir avec boundary fill
	img = dCréeImage(100, 100, couleurBlanc)
	dDébutDessin(img)
	dRectangle(img, 20, 20, 80, 80, Transparent, couleurNoir)
	dRemplissage(img, 50, 50, couleurVert, couleurNoir)
	dFinDessin(img)

	pixelInterieur = dPixelCouleur(img, 50, 50)
	pixelBordure   = dPixelCouleur(img, 20, 20)

	// L'intérieur doit être vert, bordure reste noire
	dbgVérifieEgalité(pixelInterieur, couleurVert, "boundary fill : intérieur vert")
	dbgVérifieEgalité(pixelBordure, couleurNoir, "boundary fill : bordure noire préservée")
FIN

// Remplir en utilisant couleur de fond définie par dFond (couleur remplissage omise)
PROCEDURE PUBLIQUE scenario_remplissage_avec_dFond()
	img est un Image
	couleurBlanc est un entier = RVB(255, 255, 255)
	couleurJaune est un entier = RVB(255, 255, 0)
	couleurRouge est un entier = RVB(255, 0, 0)
	pixelTest est un entier

	// Définir dFond en jaune, remplir sans spécifier couleur explicite
	img = dCréeImage(100, 100, couleurBlanc)
	dDébutDessin(img)
	dRectangle(img, 15, 15, 85, 85, Transparent, couleurRouge)
	dFond(couleurJaune)
	dRemplissage(img, 50, 50)
	dFinDessin(img)

	pixelTest = dPixelCouleur(img, 50, 50)

	// Le remplissage doit utiliser la couleur dFond (jaune)
	dbgVérifieEgalité(pixelTest, couleurJaune, "dRemplissage sans couleur explicite : utilise dFond")
FIN

// Remplir une zone déjà partiellement colorée en propagation uniforme
PROCEDURE PUBLIQUE scenario_remplissage_propagation_uniforme()
	img est un Image
	couleurBlanc est un entier = RVB(255, 255, 255)
	couleurCyan est un entier = RVB(0, 255, 255)
	pixelCentre est un entier
	pixelCoin est un entier

	// Remplir toute image blanche depuis coin (flood fill sans bordure)
	img = dCréeImage(80, 80, couleurBlanc)
	dDébutDessin(img)
	dRemplissage(img, 5, 5, couleurCyan)
	dFinDessin(img)

	pixelCentre = dPixelCouleur(img, 40, 40)
	pixelCoin   = dPixelCouleur(img, 79, 79)

	// Le remplissage doit s'étendre sur toute l'image uniforme
	dbgVérifieEgalité(pixelCentre, couleurCyan, "remplissage uniforme : centre cyan")
	dbgVérifieEgalité(pixelCoin, couleurCyan, "remplissage uniforme : coin cyan")
FIN

// ════════════════════════════════════════════════════════════════════════════════════
// SECTION PRIVÉE — cas limites, edge cases, valeurs extrêmes (non user-facing)
// ════════════════════════════════════════════════════════════════════════════════════

// Vérifier que point de départ hors image n'entraîne pas de crash
PROCEDURE PRIVÉE scenario_point_depart_hors_image()
	img est un Image
	couleurBlanc est un entier = RVB(255, 255, 255)
	couleurVert est un entier = RVB(0, 255, 0)
	pixelTest est un entier

	// Point de départ hors limites → remplissage ignoré, image reste intacte
	img = dCréeImage(50, 50, couleurBlanc)
	dDébutDessin(img)
	dRemplissage(img, 100, 100, couleurVert)
	dFinDessin(img)

	pixelTest = dPixelCouleur(img, 25, 25)

	// Image reste blanche (point hors image ignoré)
	dbgVérifieEgalité(pixelTest, couleurBlanc, "point hors image : aucun remplissage effectué")
FIN

// Vérifier remplissage zone très petite (quelques pixels connexes)
PROCEDURE PRIVÉE scenario_zone_minimale_petite()
	img est un Image
	couleurBlanc est un entier = RVB(255, 255, 255)
	couleurNoir est un entier = RVB(0, 0, 0)
	couleurMagenta est un entier = RVB(255, 0, 255)
	pixelCible est un entier
	pixelVoisin est un entier

	// Créer petite zone blanche dans image noire, remplir cette zone minimale
	img = dCréeImage(50, 50, couleurNoir)
	dDébutDessin(img)
	dRectangle(img, 24, 24, 26, 26, couleurBlanc, couleurBlanc)
	dRemplissage(img, 25, 25, couleurMagenta)
	dFinDessin(img)

	pixelCible  = dPixelCouleur(img, 25, 25)
	pixelVoisin = dPixelCouleur(img, 30, 30)

	// La petite zone doit être remplie magenta, extérieur noir préservé
	dbgVérifieEgalité(pixelCible, couleurMagenta, "zone minimale : remplie magenta")
	dbgVérifieEgalité(pixelVoisin, couleurNoir, "zone minimale : extérieur reste noir")
FIN

// Vérifier que remplir point de même couleur que couleur cible ne modifie rien
PROCEDURE PRIVÉE scenario_point_deja_couleur_cible()
	img est un Image
	couleurBlanc est un entier = RVB(255, 255, 255)
	couleurOrange est un entier = RVB(255, 165, 0)
	pixelTest est un entier

	// Créer zone orange, remplir depuis point déjà orange avec même couleur
	img = dCréeImage(60, 60, couleurOrange)
	dDébutDessin(img)
	dRemplissage(img, 30, 30, couleurOrange)
	dFinDessin(img)

	pixelTest = dPixelCouleur(img, 30, 30)

	// Image reste orange (aucune modification visible)
	dbgVérifieEgalité(pixelTest, couleurOrange, "remplir avec même couleur : identité préservée")
FIN

// Vérifier comportement coordonnées négatives (point invalide)
PROCEDURE PRIVÉE scenario_coordonnees_negatives()
	img est un Image
	couleurBlanc est un entier = RVB(255, 255, 255)
	couleurBleu est un entier = RVB(0, 0, 255)
	pixelTest est un entier

	// Coordonnées négatives → remplissage ignoré
	img = dCréeImage(50, 50, couleurBlanc)
	dDébutDessin(img)
	dRemplissage(img,-10,-5, couleurBleu)
	dFinDessin(img)

	pixelTest = dPixelCouleur(img, 25, 25)

	// Image reste blanche (coordonnées négatives ignorées)
	dbgVérifieEgalité(pixelTest, couleurBlanc, "coordonnées négatives : aucun remplissage")
FIN

// Vérifier remplissage zone complexe avec îlots internes non touchés
PROCEDURE PRIVÉE scenario_zone_complexe_avec_ilots()
	img est un Image
	couleurBlanc est un entier = RVB(255, 255, 255)
	couleurNoir est un entier = RVB(0, 0, 0)
	couleurVert est un entier = RVB(0, 255, 0)
	pixelExterieur est un entier
	pixelIlot est un entier

	// Créer bordure noire, îlot noir interne, remplir zone blanche avec vert
	img = dCréeImage(100, 100, couleurBlanc)
	dDébutDessin(img)
	dRectangle(img, 10, 10, 90, 90, Transparent, couleurNoir)
	dRectangle(img, 40, 40, 60, 60, couleurNoir, couleurNoir)
	dRemplissage(img, 20, 20, couleurVert, couleurNoir)
	dFinDessin(img)

	pixelExterieur = dPixelCouleur(img, 20, 20)
	pixelIlot      = dPixelCouleur(img, 50, 50)

	// Zone blanche extérieure remplie vert, îlot noir préservé
	dbgVérifieEgalité(pixelExterieur, couleurVert, "zone complexe : extérieur rempli vert")
	dbgVérifieEgalité(pixelIlot, couleurNoir, "zone complexe : îlot noir préservé")
FIN
