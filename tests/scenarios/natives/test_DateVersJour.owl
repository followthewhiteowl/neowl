// @sujet : DateVersJour
// @résumé : Retourne le jour de la semaine d'une date (1=lundi, 7=dimanche). Alias de DateVersJourDeLaSemaine.


// Cas standard : jeudi 1er janvier 2026.
PROCEDURE scenario_jeudi()
	d est une date = ChaîneVersDate("20260101")
	n est un entier = DateVersJour(d)
	// 1er janvier 2026 = jeudi.
	dbgVérifieEgalité(n, 4, "1er janvier 2026 doit être jeudi (4)")
FIN


// Lundi : premier jour de la semaine.
PROCEDURE scenario_lundi()
	d est une date = ChaîneVersDate("20260105")
	n est un entier = DateVersJour(d)
	// 5 janvier 2026 = lundi.
	dbgVérifieEgalité(n, 1, "5 janvier 2026 doit être lundi (1)")
FIN


// Dimanche : dernier jour de la semaine (valeur 7).
PROCEDURE scenario_dimanche()
	d est une date = ChaîneVersDate("20260104")
	n est un entier = DateVersJour(d)
	// 4 janvier 2026 = dimanche.
	dbgVérifieEgalité(n, 7, "4 janvier 2026 doit être dimanche (7)")
FIN


// Vendredi en fin d'année : 25 décembre 2026.
PROCEDURE scenario_vendredi_fin_annee()
	d est une date = ChaîneVersDate("20261225")
	n est un entier = DateVersJour(d)
	// 25 décembre 2026 = vendredi.
	dbgVérifieEgalité(n, 5, "25 décembre 2026 doit être vendredi (5)")
FIN


// Mardi milieu d'année : 12 mai 2026.
PROCEDURE scenario_mardi()
	d est une date = ChaîneVersDate("20260512")
	n est un entier = DateVersJour(d)
	// 12 mai 2026 = mardi.
	dbgVérifieEgalité(n, 2, "12 mai 2026 doit être mardi (2)")
FIN


// Entrée chaîne AAAAMMJJ : cast implicite accepté sans conversion préalable.
PROCEDURE scenario_entree_chaine_compacte()
	n est un entier = DateVersJour("20260512")
	// 12 mai 2026 = mardi.
	dbgVérifieEgalité(n, 2, "12 mai 2026 (chaîne) doit être mardi (2)")
FIN


// 29 février année bissextile : samedi 29 février 2020.
PROCEDURE scenario_29_fevrier_bissextile()
	d est une date = ChaîneVersDate("20200229")
	n est un entier = DateVersJour(d)
	// 29 février 2020 = samedi.
	dbgVérifieEgalité(n, 6, "29 février 2020 doit être samedi (6)")
FIN


// Début année bissextile : mercredi 1er janvier 2020.
PROCEDURE scenario_debut_annee_bissextile()
	d est une date = ChaîneVersDate("20200101")
	n est un entier = DateVersJour(d)
	// 1er janvier 2020 = mercredi.
	dbgVérifieEgalité(n, 3, "1er janvier 2020 doit être mercredi (3)")
FIN
