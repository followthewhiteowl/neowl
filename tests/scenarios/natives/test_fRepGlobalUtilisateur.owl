// @sujet : fRepGlobalUtilisateur
// @résumé : Renvoie la racine des données applicatives par utilisateur,
// partagée par toutes les applications de l'utilisateur courant.

PROCEDURE PUBLIQUE scenario_non_vide()
	rep est une chaîne = fRepGlobalUtilisateur()
	dbgVérifieVrai(Taille(rep) > 0, "non vide")
FIN

PROCEDURE PUBLIQUE scenario_chemin_absolu()
	rep est une chaîne = fRepGlobalUtilisateur()
	dbgVérifieVrai(Position(rep, fSep()) > 0, "chemin absolu (contient un séparateur)")
FIN

PROCEDURE PUBLIQUE scenario_stable()
	rep1 est une chaîne = fRepGlobalUtilisateur()
	rep2 est une chaîne = fRepGlobalUtilisateur()
	dbgVérifieEgalité(rep1, rep2, "appels successifs stables")
FIN

PROCEDURE PUBLIQUE scenario_bilingue()
	dbgVérifieEgalité(fRepGlobalUtilisateur(), fGlobalDirUser(), "fRepGlobalUtilisateur() = fGlobalDirUser()")
FIN
