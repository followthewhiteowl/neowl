// Endpoint personnalisé : un override posé sur ..Endpoint remplace le
// calcul par défaut.
PROCEDURE scenario_endpoint_override_utilise()
	sess est une AWSSession
	sess..Région     = "us-east-1"
	sess..CléAccès   = "AKIAIOSFODNN7EXAMPLE"
	sess..CléSecrète = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
	sess..Endpoint   = "https://sts.local-test.example.com"

	corps est un JSON = ChaîneVersJSON("{}")
	AWSRequête(sess, awsSTS, awsSTSGetCallerIdentity, corps)

	req est un httpRequête = MockDernierArgument(mockHttp, 1)
	dbgVérifieVrai(Contient(req..URL, "sts.local-test.example.com"), "endpoint personnalisé utilisé au lieu du défaut")
FIN


// Cadrage protocole query pour EC2 : comme STS, le corps part en
// application/x-www-form-urlencoded sous la forme Action=...&Version=...,
// pas en JSON. L'argument corps n'est pas sérialisé dans ce mode.
PROCEDURE scenario_protocole_ec2_query()
	sess est une AWSSession
	sess..Région     = "us-east-1"
	sess..CléAccès   = "AKIAIOSFODNN7EXAMPLE"
	sess..CléSecrète = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

	corps est un JSON = ChaîneVersJSON("{}")
	AWSRequête(sess, awsEC2, awsEC2DescribeInstances, corps)

	req est un httpRequête = MockDernierArgument(mockHttp, 1)
	dbgVérifieEgalité(req..ContentType, "application/x-www-form-urlencoded", "protocole query en form-urlencoded pour EC2")
	dbgVérifieVrai(CommencePar(req..Contenu, "Action=DescribeInstances"), "corps EC2 encodé en query, action en tête")
	dbgVérifieVrai(Contient(req..Contenu, "Version=2016-11-15"), "version d'API EC2 présente dans le corps query")
FIN


// Cadrage protocole rest-json pour API Gateway : méthode et URI portées par
// l'action (CreateRestApi = POST /restapis), corps sérialisé en JSON avec le
// Content-Type application/json.
PROCEDURE scenario_protocole_rest_json_apigateway()
	sess est une AWSSession
	sess..Région     = "us-east-1"
	sess..CléAccès   = "AKIAIOSFODNN7EXAMPLE"
	sess..CléSecrète = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

	corps est un JSON = ChaîneVersJSON(`{"name":"demo"}`)
	AWSRequête(sess, awsAPIGateway, awsAPIGatewayCreateRestApi, corps)

	req est un httpRequête = MockDernierArgument(mockHttp, 1)
	dbgVérifieEgalité(req..ContentType, "application/json", "protocole rest-json en application/json pour API Gateway")
	dbgVérifieVrai(FinitPar(req..URL, "/restapis"), "URI de l'action portée par la table de modèles")
	dbgVérifieVrai(CommencePar(req..Contenu, "{"), "corps rest-json sérialisé en JSON")
FIN


// Chemin paramétré rest-json : une action à URI `{param}` (GetRestApi =
// GET /restapis/{restapi_id}) substitue le placeholder par la valeur du
// champ homonyme du corps, URI-encodée. Le champ consommé est retiré du
// corps sérialisé (il n'apparaît pas dans le body JSON).
PROCEDURE scenario_rest_json_placeholder_substitue()
	sess est une AWSSession
	sess..Région     = "us-east-1"
	sess..CléAccès   = "AKIAIOSFODNN7EXAMPLE"
	sess..CléSecrète = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

	corps est un JSON = ChaîneVersJSON(`{"restapi_id":"abc123"}`)
	AWSRequête(sess, awsAPIGateway, awsAPIGatewayGetRestApi, corps)

	req est un httpRequête = MockDernierArgument(mockHttp, 1)
	dbgVérifieVrai(Contient(req..URL, "/restapis/abc123"), "placeholder de chemin substitué par la valeur du corps")
	dbgVérifieFaux(Contient(req..URL, "{restapi_id}"), "placeholder littéral absent de l'URL finale")
	dbgVérifieFaux(Contient(req..Contenu, "restapi_id"), "champ consommé par le chemin retiré du corps sérialisé")
FIN


// Encodage URI d'une valeur de placeholder contenant un caractère réservé :
// une valeur `a b/c` produit un segment pourcent-encodé (%20, %2F).
PROCEDURE scenario_rest_json_placeholder_encode()
	sess est une AWSSession
	sess..Région     = "us-east-1"
	sess..CléAccès   = "AKIAIOSFODNN7EXAMPLE"
	sess..CléSecrète = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

	corps est un JSON = ChaîneVersJSON(`{"restapi_id":"a b/c"}`)
	AWSRequête(sess, awsAPIGateway, awsAPIGatewayGetRestApi, corps)

	req est un httpRequête = MockDernierArgument(mockHttp, 1)
	dbgVérifieVrai(Contient(req..URL, "/restapis/a%20b%2Fc"), "valeur de placeholder URI-encodée dans l'URL")
FIN


// Non-régression : une action rest-json SANS placeholder (CreateRestApi =
// POST /restapis) produit l'URI telle quelle, sans altération.
PROCEDURE scenario_rest_json_sans_placeholder_inchange()
	sess est une AWSSession
	sess..Région     = "us-east-1"
	sess..CléAccès   = "AKIAIOSFODNN7EXAMPLE"
	sess..CléSecrète = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

	corps est un JSON = ChaîneVersJSON(`{"name":"demo"}`)
	AWSRequête(sess, awsAPIGateway, awsAPIGatewayCreateRestApi, corps)

	req est un httpRequête = MockDernierArgument(mockHttp, 1)
	dbgVérifieVrai(FinitPar(req..URL, "/restapis"), "URI sans placeholder inchangée")
	dbgVérifieFaux(Contient(req..URL, "{"), "aucun placeholder résiduel dans l'URL")
FIN


// Cas d'erreur : un placeholder de chemin requis sans valeur correspondante
// dans le corps remonte une erreur détectable, sans délégation réseau.
PROCEDURE scenario_rest_json_placeholder_manquant_erreur()
	sess est une AWSSession
	sess..Région     = "us-east-1"
	sess..CléAccès   = "AKIAIOSFODNN7EXAMPLE"
	sess..CléSecrète = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

	corps est un JSON = ChaîneVersJSON("{}")
	ErreurRAZ()
	AWSRequête(sess, awsAPIGateway, awsAPIGatewayGetRestApi, corps)

	dbgVérifieVrai(ErreurDétectée, "placeholder de chemin sans valeur remonte une erreur")
FIN


// L'en-tête Host n'est pas posé manuellement dans la requête : la couche
// d'envoi le dérive de l'URL. La native ne le duplique pas dans ..Entête.
PROCEDURE scenario_host_non_duplique_dans_entete()
	sess est une AWSSession
	sess..Région     = "us-east-1"
	sess..CléAccès   = "AKIAIOSFODNN7EXAMPLE"
	sess..CléSecrète = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

	corps est un JSON = ChaîneVersJSON("{}")
	AWSRequête(sess, awsSTS, awsSTSGetCallerIdentity, corps)

	req est un httpRequête = MockDernierArgument(mockHttp, 1)
	dbgVérifieEgalité(req..Entête["Host"], "", "Host non dupliqué dans les en-têtes de la requête")
FIN


// Cadrage rest-json avec identité de signature dédiée : Bedrock Runtime signe
// sous le service « bedrock » (distinct de son préfixe d'endpoint), l'endpoint
// est dérivé du préfixe et de la région, et l'identifiant de modèle porté par
// le corps est substitué au placeholder de chemin {modelId} de l'action
// InvokeModel (POST /model/{modelId}/invoke).
PROCEDURE scenario_bedrock_runtime_invoke_model()
	sess est une AWSSession
	sess..Région     = "us-east-1"
	sess..CléAccès   = "AKIAIOSFODNN7EXAMPLE"
	sess..CléSecrète = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

	corps est un JSON = ChaîneVersJSON(`{"modelId":"anthropic.claude-v2","prompt":"Bonjour"}`)
	AWSRequête(sess, awsBedrockRuntime, awsBedrockRuntimeInvokeModel, corps)

	req est un httpRequête = MockDernierArgument(mockHttp, 1)
	dbgVérifieVrai(Contient(req..URL, "bedrock-runtime.us-east-1.amazonaws.com"), "endpoint dérivé du préfixe bedrock-runtime et de la région")
	dbgVérifieVrai(Contient(req..URL, "/model/anthropic.claude-v2/invoke"), "identifiant de modèle substitué au placeholder de chemin")
	dbgVérifieFaux(Contient(req..URL, "{modelId}"), "placeholder littéral absent de l'URL finale")
	dbgVérifieEgalité(req..ContentType, "application/json", "protocole rest-json en application/json pour Bedrock Runtime")
	dbgVérifieFaux(Contient(req..Contenu, "modelId"), "champ consommé par le chemin retiré du corps sérialisé")
	dbgVérifieVrai(Contient(req..Contenu, "prompt"), "champs restants conservés dans le corps JSON")

	sAutorisation est une chaîne = req..Entête["Authorization"]
	dbgVérifieVrai(Contient(sAutorisation, "/bedrock/aws4_request"), "portée de signature sur le service bedrock")
FIN


// Cadrage et décodage rest-xml : un service rest-xml (Route 53) est utilisable
// via le générique. La réponse, dont le corps est un Buffer XML, est décodée en
// JSON générique — élément à texte seul → valeur, enfants de même nom répétés →
// tableau — accessible comme un document JSON quelconque.
PROCEDURE scenario_protocole_rest_xml_decode()
	repXml est un httpRéponse
	repXml..CodeEtat            = 200
	repXml..DescriptionCodeEtat = "OK"
	repXml..ContentType         = "application/xml"
	repXml..Contenu             = ChaîneVersBuffer(`<Result><Item>a</Item><Item>b</Item><Name>x</Name></Result>`)
	mockHttp = MockCrée(HTTPEnvoie).Quand().Retourne(repXml).Active()

	sess est une AWSSession
	sess..Région     = "us-east-1"
	sess..CléAccès   = "AKIAIOSFODNN7EXAMPLE"
	sess..CléSecrète = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

	corps est un JSON = ChaîneVersJSON("{}")
	rep est un JSON = AWSRequête(sess, awsRoute53, awsRoute53ListHostedZones, corps)

	dbgVérifieEgalité(rep.Result.Name, "x", "élément à texte seul décodé en valeur JSON")
	dbgVérifieEgalité(rep.Result.Item[1], "a", "premier élément répété décodé en entrée de tableau JSON")
	dbgVérifieEgalité(rep.Result.Item[2], "b", "second élément répété décodé en entrée de tableau JSON")
	dbgVérifieVrai(MockVérifieAppelé(mockHttp, 1), "AWSRequête rest-xml délègue exactement une fois à HTTPEnvoie")
FIN


// Cadrage requête rest-xml : la méthode et l'URI de l'action sont portées par la
// table de modèles (ListHostedZones = GET /2013-04-01/hostedzone), l'endpoint est
// dérivé du préfixe et de la région, et le Content-Type est adapté au protocole.
PROCEDURE scenario_protocole_rest_xml_cadrage()
	repXml est un httpRéponse
	repXml..CodeEtat = 200
	repXml..Contenu  = ChaîneVersBuffer(`<Result><Name>x</Name></Result>`)
	mockHttp = MockCrée(HTTPEnvoie).Quand().Retourne(repXml).Active()

	sess est une AWSSession
	sess..Région     = "us-east-1"
	sess..CléAccès   = "AKIAIOSFODNN7EXAMPLE"
	sess..CléSecrète = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

	corps est un JSON = ChaîneVersJSON("{}")
	AWSRequête(sess, awsRoute53, awsRoute53ListHostedZones, corps)

	req est un httpRequête = MockDernierArgument(mockHttp, 1)
	dbgVérifieVrai(FinitPar(req..URL, "/2013-04-01/hostedzone"), "URI de l'action portée par la table de modèles")
	// Route 53 est un service global : hôte unique sans segment de région.
	dbgVérifieVrai(Contient(req..URL, "route53.amazonaws.com"), "endpoint global adressé sur son hôte unique")
	dbgVérifieFaux(Contient(req..URL, "route53.us-east-1"), "aucun segment de région dans l'hôte d'un service global")
	dbgVérifieEgalité(req..ContentType, "application/xml", "Content-Type adapté au protocole rest-xml")
FIN


// Sérialisation du corps d'une écriture rest-xml (S3 PutBucketTagging) : une
// opération à input structuré (structure imbriquée + liste de structures)
// produit un corps XML (au lieu du corps vide des lectures). Le placeholder de
// chemin {Bucket} est consommé depuis le corps (il finit dans l'URL, pas dans le
// corps XML). Quand l'input désigne un membre porteur du corps, la racine XML
// est ce membre (ici Tagging), pas un conteneur au nom de la requête : ses
// propres membres deviennent les enfants directs de la racine. La liste sort en
// éléments répétés (Tag) sous son conteneur (TagSet), les membres scalaires sous
// leur nom XML, et la racine porte l'espace de noms par défaut exigé par le
// service. L'empreinte du corps signée (X-Amz-Content-Sha256) porte sur ce corps.
PROCEDURE scenario_rest_xml_ecriture_serialise_corps()
	repXml est un httpRéponse
	repXml..CodeEtat = 200
	repXml..Contenu  = ChaîneVersBuffer(`<PutBucketTaggingResponse/>`)
	mockHttp = MockCrée(HTTPEnvoie).Quand().Retourne(repXml).Active()

	sess est une AWSSession
	sess..Région     = "us-east-1"
	sess..CléAccès   = "AKIAIOSFODNN7EXAMPLE"
	sess..CléSecrète = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

	corps est un JSON = ChaîneVersJSON(`{"Bucket":"mon-seau","Tagging":{"TagSet":[{"Key":"env","Value":"prod"},{"Key":"team","Value":"core"}]}}`)
	AWSRequête(sess, awsS3, awsS3PutBucketTagging, corps)

	req est un httpRequête = MockDernierArgument(mockHttp, 1)
	sCorps est une chaîne = req..Contenu

	dbgVérifieEgalité(req..ContentType, "application/xml", "Content-Type rest-xml pour l'écriture")
	dbgVérifieVrai(CommencePar(sCorps, `<Tagging xmlns="http://s3.amazonaws.com/doc/2006-03-01/">`), "racine = membre payload (Tagging) porteur de l'espace de noms par défaut")
	dbgVérifieVrai(Contient(sCorps, `xmlns="http://s3.amazonaws.com/doc/2006-03-01/"`), "espace de noms S3 émis sur l'élément racine")
	dbgVérifieEgalité(Contient(sCorps, "PutBucketTaggingRequest"), Faux, "pas de conteneur au nom du request-shape : la racine est le membre payload")
	dbgVérifieVrai(Contient(sCorps, "<TagSet><Tag><Key>env</Key><Value>prod</Value></Tag><Tag><Key>team</Key><Value>core</Value></Tag></TagSet>"), "liste sérialisée en éléments répétés (Tag) sous son conteneur (TagSet)")
	dbgVérifieVrai(Contient(sCorps, "<Key>env</Key>"), "membre scalaire sous son nom XML")
	dbgVérifieVrai(FinitPar(sCorps, "</Tagging>"), "fermeture de l'élément racine (membre payload)")
	dbgVérifieEgalité(Contient(sCorps, "mon-seau"), Faux, "le placeholder de chemin {Bucket} ne fuit pas dans le corps XML")
	dbgVérifieDifférence(req..Entête["X-Amz-Content-Sha256"], "", "empreinte du corps XML présente sur la requête signée")
FIN


// Non-régression rest-xml LECTURE : une opération sans input (S3
// GetBucketTagging, GET) n'a pas de descripteur de sérialisation et conserve un
// corps vide, même quand le corps JSON porte le placeholder de chemin {Bucket}.
PROCEDURE scenario_rest_xml_lecture_corps_vide()
	repXml est un httpRéponse
	repXml..CodeEtat = 200
	repXml..Contenu  = ChaîneVersBuffer(`<Tagging><TagSet/></Tagging>`)
	mockHttp = MockCrée(HTTPEnvoie).Quand().Retourne(repXml).Active()

	sess est une AWSSession
	sess..Région     = "us-east-1"
	sess..CléAccès   = "AKIAIOSFODNN7EXAMPLE"
	sess..CléSecrète = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

	corps est un JSON = ChaîneVersJSON(`{"Bucket":"mon-seau"}`)
	AWSRequête(sess, awsS3, awsS3GetBucketTagging, corps)

	req est un httpRequête = MockDernierArgument(mockHttp, 1)
	dbgVérifieEgalité(req..Contenu, "", "lecture rest-xml sans input : corps vide (pas de descripteur)")
FIN


// Méthode HTTP d'une écriture rest-xml : une action PUT (S3 PutBucketTagging =
// PUT /{Bucket}?tagging) est envoyée avec le verbe PUT, pas replié sur POST. La
// sous-ressource `?tagging` de l'URI est conservée dans l'URL réellement émise.
PROCEDURE scenario_rest_xml_put_methode_et_sous_ressource()
	repXml est un httpRéponse
	repXml..CodeEtat = 200
	repXml..Contenu  = ChaîneVersBuffer(`<PutBucketTaggingResponse/>`)
	mockHttp = MockCrée(HTTPEnvoie).Quand().Retourne(repXml).Active()

	sess est une AWSSession
	sess..Région     = "us-east-1"
	sess..CléAccès   = "AKIAIOSFODNN7EXAMPLE"
	sess..CléSecrète = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

	corps est un JSON = ChaîneVersJSON(`{"Bucket":"mon-seau","Tagging":{"TagSet":[{"Key":"env","Value":"prod"}]}}`)
	AWSRequête(sess, awsS3, awsS3PutBucketTagging, corps)

	req est un httpRequête = MockDernierArgument(mockHttp, 1)
	dbgVérifieEgalité(req..Méthode, httpPut, "méthode PUT préservée (non repliée sur POST)")
	dbgVérifieVrai(Contient(req..URL, "?tagging"), "sous-ressource ?tagging conservée dans l'URL émise")
FIN


