	dbgVérifieVrai(Contient(req..Contenu, "L.member.1=x"), "premier élément de liste indexé sous .member")
	dbgVérifieVrai(Contient(req..Contenu, "L.member.2=y"), "second élément de liste indexé sous .member")
FIN


// Sérialisation query — liste de structures : chaque entrée porte ses membres
