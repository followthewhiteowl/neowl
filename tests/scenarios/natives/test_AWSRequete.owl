// Format blob à l'écriture rest-xml : un membre de corps de type blob (CloudFront
// CreateFunction porte FunctionCode) est sérialisé encodé en base64 dans le corps
// XML, pas en texte brut. Les scalaires ordinaires du même corps (Name) restent
// en texte brut. base64("hello") = "aGVsbG8=".
PROCEDURE scenario_rest_xml_ecriture_blob_base64()
	repXml est un httpRéponse
	repXml..CodeEtat = 200
	repXml..Contenu  = ChaîneVersBuffer(`<CreateFunctionResult/>`)
	mockHttp = MockCrée(HTTPEnvoie).Quand().Retourne(repXml).Active()

	sess est une AWSSession
	sess..Région     = "us-east-1"
	sess..CléAccès   = "AKIAIOSFODNN7EXAMPLE"
	sess..CléSecrète = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

	corps est un JSON = ChaîneVersJSON(`{"Name":"maFonction","FunctionCode":"hello"}`)
	AWSRequête(sess, awsCloudFront, awsCloudFrontCreateFunction, corps)

	req est un httpRequête = MockDernierArgument(mockHttp, 1)
	sCorps est une chaîne = req..Contenu

	dbgVérifieVrai(Contient(sCorps, "<FunctionCode>aGVsbG8=</FunctionCode>"), "membre blob sérialisé en base64 dans le corps XML")
	dbgVérifieEgalité(Contient(sCorps, "<FunctionCode>hello</FunctionCode>"), Faux, "le blob n'est pas émis en texte brut")
	dbgVérifieVrai(Contient(sCorps, "<Name>maFonction</Name>"), "scalaire ordinaire du même corps reste en texte brut")
FIN


// Blob VIDE à l'écriture rest-xml : un membre blob à chaîne vide doit produire un
// élément vide, jamais de la mémoire non initialisée. base64("") == "", donc
// l'encodeur ne touche pas son buffer de sortie — le cas vide est court-circuité
// en amont pour émettre directement un contenu vide.
PROCEDURE scenario_rest_xml_ecriture_blob_vide()
	repXml est un httpRéponse
	repXml..CodeEtat = 200
	repXml..Contenu  = ChaîneVersBuffer(`<CreateFunctionResult/>`)
	mockHttp = MockCrée(HTTPEnvoie).Quand().Retourne(repXml).Active()

	sess est une AWSSession
	sess..Région     = "us-east-1"
	sess..CléAccès   = "AKIAIOSFODNN7EXAMPLE"
	sess..CléSecrète = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

	corps est un JSON = ChaîneVersJSON(`{"Name":"maFonction","FunctionCode":""}`)
	AWSRequête(sess, awsCloudFront, awsCloudFrontCreateFunction, corps)

	req est un httpRequête = MockDernierArgument(mockHttp, 1)
	sCorps est une chaîne = req..Contenu

	dbgVérifieVrai(Contient(sCorps, "<FunctionCode></FunctionCode>"), "blob vide sérialisé en élément vide, sans mémoire non initialisée")
	dbgVérifieVrai(Contient(sCorps, "<Name>maFonction</Name>"), "scalaire ordinaire du même corps reste en texte brut")
FIN


// Service global (IAM) : l'endpoint ne porte pas la région. Quelle que soit la
// région de la session, un service global s'adresse à son hôte unique
// (iam.amazonaws.com), sans segment de région dans le nom d'hôte.
PROCEDURE scenario_service_global_endpoint_sans_region()
	sess est une AWSSession
	sess..Région     = "eu-central-1"
	sess..CléAccès   = "AKIAIOSFODNN7EXAMPLE"
	sess..CléSecrète = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

	corps est un JSON = ChaîneVersJSON("{}")
	AWSRequête(sess, awsIAM, "ListRoles", corps)

	req est un httpRequête = MockDernierArgument(mockHttp, 1)
	dbgVérifieVrai(Contient(req..URL, "iam.amazonaws.com"), "service global adressé sur son hôte unique sans région")
	dbgVérifieFaux(Contient(req..URL, "eu-central-1"), "aucun segment de région dans l'hôte d'un service global")
FIN


// Portée de signature d'un service global : les services globaux de la partition
// aws signent dans la portée us-east-1, indépendamment de la région de la
// session. Le scope de credentials porté par Authorization le reflète.
PROCEDURE scenario_service_global_scope_signature_us_east_1()
	sess est une AWSSession
	sess..Région     = "eu-central-1"
	sess..CléAccès   = "AKIAIOSFODNN7EXAMPLE"
	sess..CléSecrète = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

	corps est un JSON = ChaîneVersJSON("{}")
	AWSRequête(sess, awsIAM, "ListRoles", corps)

	req est un httpRequête = MockDernierArgument(mockHttp, 1)
	sAutorisation est une chaîne = req..Entête["Authorization"]
	dbgVérifieVrai(Contient(sAutorisation, "/us-east-1/iam/aws4_request"), "portée de signature forcée sur us-east-1 pour un service global")
	dbgVérifieFaux(Contient(sAutorisation, "/eu-central-1/"), "la région de session n'apparaît pas dans la portée de signature d'un service global")
FIN


// Sérialisation query — champ scalaire : une opération query à corps non vide
// (IAM CreateUser) sérialise ses paramètres dans le corps form-urlencoded, en
// plus des paires Action et Version toujours présentes en tête.
PROCEDURE scenario_query_corps_scalaire()
	sess est une AWSSession
	sess..Région     = "us-east-1"
	sess..CléAccès   = "AKIAIOSFODNN7EXAMPLE"
	sess..CléSecrète = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

	corps est un JSON = ChaîneVersJSON(`{"UserName":"bob"}`)
	AWSRequête(sess, awsIAM, "CreateUser", corps)

	req est un httpRequête = MockDernierArgument(mockHttp, 1)
	dbgVérifieVrai(CommencePar(req..Contenu, "Action=CreateUser"), "action en tête du corps query")
	dbgVérifieVrai(Contient(req..Contenu, "Version=2010-05-08"), "version d'API IAM présente dans le corps query")
	dbgVérifieVrai(Contient(req..Contenu, "UserName=bob"), "paramètre scalaire sérialisé dans le corps query")
FIN


