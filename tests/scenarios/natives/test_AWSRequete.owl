// @sujet : AWSRequête
// @résumé : Signe (AWS4-HMAC-SHA256) et envoie une requête vers un service AWS quelconque, à partir d'une AWSSession, d'un service (∈ awsService) et d'une action. Retourne la réponse décodée en JSON.


// Mock partagé : AWSRequête signe puis délègue l'envoi réseau à HTTPEnvoie.
// On intercepte cette dépendance externe pour rester déterministe (pas de
// vrai appel AWS en test), exactement comme pour httpRequête. Le mock est
// volontairement un catch-all : il ne vérifie pas ici le contenu exact de
// la requête signée (en-têtes SigV4, cadrage protocole) — cette vérification
// est hors de portée de ce fichier.
mockHttp est un MockNative = MockCrée(HTTPEnvoie)


PROCEDURE avantChaqueTest()
	rep est un httpRéponse
	rep..CodeEtat            = 200
	rep..DescriptionCodeEtat = "OK"
	rep..ContentType         = "application/x-amz-json-1.0"
	// Corps en Buffer : c'est la forme que restitue l'envoi réseau réel pour
	// un corps de réponse. La native doit décoder aussi bien un Buffer qu'une
	// chaîne, sans quoi la réponse revient null.
	rep..Contenu             = ChaîneVersBuffer(`{"Account":"123456789012","Arn":"arn:aws:iam::123456789012:user/Alice","UserId":"AIDACKCEVSQ6C2EXAMPLE"}`)

	mockHttp = MockCrée(HTTPEnvoie).Quand().Retourne(rep).Active()
FIN


PROCEDURE apresChaqueTest()
	mockHttp.Desactive()
FIN


// Cas canonique : un appel STS GetCallerIdentity (protocole query) délègue à
// HTTPEnvoie et restitue la réponse décodée. STS répond en XML (protocole
// query), la réponse est donc décodée en JSON générique, accessible via le
// chemin d'éléments imbriqués.
PROCEDURE scenario_appel_sts_getcalleridentity()
	// Le corps partagé d'avantChaqueTest est du JSON : valable pour un service
	// json (DynamoDB) mais pas pour STS, qui répond en XML. On re-mocke ici
	// localement une réponse XML réaliste.
	repSts est un httpRéponse
	repSts..CodeEtat = 200
	repSts..Contenu  = ChaîneVersBuffer(`<GetCallerIdentityResponse xmlns="https://sts.amazonaws.com/doc/2011-06-15/"><GetCallerIdentityResult><Arn>arn:aws:iam::123456789012:user/Alice</Arn><UserId>AIDACKCEVSQ6C2EXAMPLE</UserId><Account>123456789012</Account></GetCallerIdentityResult><ResponseMetadata><RequestId>r1</RequestId></ResponseMetadata></GetCallerIdentityResponse>`)
	mockHttp = MockCrée(HTTPEnvoie).Quand().Retourne(repSts).Active()

	sess est une AWSSession
	sess..Région     = "us-east-1"
	sess..CléAccès   = "AKIAIOSFODNN7EXAMPLE"
	sess..CléSecrète = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

	corps est un JSON = ChaîneVersJSON("{}")
	rep est un JSON = AWSRequête(sess, awsSTS, awsSTSGetCallerIdentity, corps)

	dbgVérifieEgalité(rep.GetCallerIdentityResponse.GetCallerIdentityResult.Account, "123456789012", "compte AWS restitué depuis la réponse XML STS décodée")
	dbgVérifieVrai(MockVérifieAppelé(mockHttp, 1), "AWSRequête délègue exactement une fois à HTTPEnvoie")
FIN


// Repli chaîne libre : une action non résolue via la table de symboles
// reste utilisable telle quelle (validée au littéral, pas au symbole).
PROCEDURE scenario_action_chaine_libre()
	sess est une AWSSession
	sess..Région     = "eu-west-1"
	sess..CléAccès   = "AKIAIOSFODNN7EXAMPLE"
	sess..CléSecrète = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

	corps est un JSON = ChaîneVersJSON(`{"TableName":"Clients","Key":{"id":{"S":"42"}}}`)
	rep est un JSON = AWSRequête(sess, awsDynamoDB, "GetItem", corps)

	dbgVérifieEgalité(rep.Account, "123456789012", "réponse mockée restituée telle quelle")
	dbgVérifieVrai(MockVérifieAppelé(mockHttp, 1), "action en repli chaîne libre délègue tout de même à HTTPEnvoie")
FIN


// Un jeton de session présent sur l'AWSSession n'empêche pas l'appel
// d'aboutir (le jeton part en en-tête X-Amz-Security-Token — non vérifiable
// dans ce fichier faute de mécanisme d'introspection, cf. rapport ticket).
// STS répond en XML : on re-mocke localement une réponse XML réaliste.
PROCEDURE scenario_appel_avec_jeton_session()
	repSts est un httpRéponse
	repSts..CodeEtat = 200
	repSts..Contenu  = ChaîneVersBuffer(`<GetCallerIdentityResponse xmlns="https://sts.amazonaws.com/doc/2011-06-15/"><GetCallerIdentityResult><Arn>arn:aws:iam::123456789012:user/Alice</Arn><UserId>AIDACKCEVSQ6C2EXAMPLE</UserId><Account>123456789012</Account></GetCallerIdentityResult><ResponseMetadata><RequestId>r1</RequestId></ResponseMetadata></GetCallerIdentityResponse>`)
	mockHttp = MockCrée(HTTPEnvoie).Quand().Retourne(repSts).Active()

	sess est une AWSSession
	sess..Région     = "us-east-1"
	sess..CléAccès   = "ASIAIOSFODNN7EXAMPLE"
	sess..CléSecrète = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
	sess..Jeton      = "AQoDYXdzEJr...EXAMPLETOKEN"

	corps est un JSON = ChaîneVersJSON("{}")
	rep est un JSON = AWSRequête(sess, awsSTS, awsSTSGetCallerIdentity, corps)

	dbgVérifieEgalité(rep.GetCallerIdentityResponse.GetCallerIdentityResult.Account, "123456789012", "réponse XML STS restituée malgré la présence d'un jeton de session")
FIN


// Décodage query : un service au protocole query (IAM) répond en XML, comme
// STS. La réponse, corps XML en Buffer, est décodée en JSON générique et
// accessible via le chemin d'éléments imbriqués — même traitement que rest-xml.
PROCEDURE scenario_protocole_query_decode()
	repXml est un httpRéponse
	repXml..CodeEtat = 200
	repXml..Contenu  = ChaîneVersBuffer(`<ListUsersResponse xmlns="https://iam.amazonaws.com/doc/2010-05-08/"><ListUsersResult><IsTruncated>false</IsTruncated><Users><member><UserName>alice</UserName></member></Users></ListUsersResult><ResponseMetadata><RequestId>r2</RequestId></ResponseMetadata></ListUsersResponse>`)
	mockHttp = MockCrée(HTTPEnvoie).Quand().Retourne(repXml).Active()

	sess est une AWSSession
	sess..Région     = "us-east-1"
	sess..CléAccès   = "AKIAIOSFODNN7EXAMPLE"
	sess..CléSecrète = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

	corps est un JSON = ChaîneVersJSON("{}")
	rep est un JSON = AWSRequête(sess, awsIAM, "ListUsers", corps)

	dbgVérifieEgalité(rep.ListUsersResponse.ListUsersResult.IsTruncated, "false", "élément à texte seul de la réponse query XML décodé en valeur JSON")
	dbgVérifieVrai(MockVérifieAppelé(mockHttp, 1), "AWSRequête query délègue exactement une fois à HTTPEnvoie")
FIN


// Cas limite défensif : deux appels successifs comptent bien deux
// délégations distinctes à HTTPEnvoie (pas de mise en cache implicite).
PROCEDURE PRIVÉE scenario_deux_appels_successifs()
	sess est une AWSSession
	sess..Région     = "us-east-1"
	sess..CléAccès   = "AKIAIOSFODNN7EXAMPLE"
	sess..CléSecrète = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

	corps est un JSON = ChaîneVersJSON("{}")
	AWSRequête(sess, awsSTS, awsSTSGetCallerIdentity, corps)
	AWSRequête(sess, awsSTS, awsSTSGetCallerIdentity, corps)

	dbgVérifieVrai(MockVérifieAppelé(mockHttp, 2), "deux appels AWSRequête, deux délégations HTTPEnvoie")
FIN


// Signature SigV4 complète : Authorization porte l'algorithme, les
// identifiants, les en-têtes signés et la signature ; X-Amz-Date est au
// format horodaté AAAAMMJJTHHMMSSZ ; X-Amz-Content-Sha256 est renseigné.
PROCEDURE scenario_entetes_sigv4_presents()
	sess est une AWSSession
	sess..Région     = "us-east-1"
	sess..CléAccès   = "AKIAIOSFODNN7EXAMPLE"
	sess..CléSecrète = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

	corps est un JSON = ChaîneVersJSON("{}")
	AWSRequête(sess, awsSTS, awsSTSGetCallerIdentity, corps)

	req est un httpRequête = MockDernierArgument(mockHttp, 1)

	sAutorisation est une chaîne = req..Entête["Authorization"]
	dbgVérifieVrai(Contient(sAutorisation, "AWS4-HMAC-SHA256"), "algorithme SigV4 annoncé dans Authorization")
	dbgVérifieVrai(Contient(sAutorisation, "Credential="), "identifiants présents dans Authorization")
	dbgVérifieVrai(Contient(sAutorisation, "SignedHeaders="), "liste des en-têtes signés présente dans Authorization")
	dbgVérifieVrai(Contient(sAutorisation, "Signature="), "signature présente dans Authorization")

	sDate est une chaîne = req..Entête["X-Amz-Date"]
	dbgVérifieEgalité(Taille(sDate), 16, "X-Amz-Date au format AAAAMMJJTHHMMSSZ")
	dbgVérifieVrai(Contient(sDate, "T"), "séparateur entre date et heure dans X-Amz-Date")
	dbgVérifieEgalité(Droite(sDate, 1), "Z", "suffixe Z de X-Amz-Date")

	dbgVérifieDifférence(req..Entête["X-Amz-Content-Sha256"], "", "empreinte du corps présente sur la requête signée")
FIN


// Jeton de session : présent sur l'AWSSession, il part en en-tête
// X-Amz-Security-Token avec sa valeur exacte.
PROCEDURE scenario_jeton_session_ajoute_entete()
	sess est une AWSSession
	sess..Région     = "us-east-1"
	sess..CléAccès   = "ASIAIOSFODNN7EXAMPLE"
	sess..CléSecrète = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
	sess..Jeton      = "AQoDYXdzEJr...EXAMPLETOKEN"

	corps est un JSON = ChaîneVersJSON("{}")
	AWSRequête(sess, awsSTS, awsSTSGetCallerIdentity, corps)

	req est un httpRequête = MockDernierArgument(mockHttp, 1)
	dbgVérifieEgalité(req..Entête["X-Amz-Security-Token"], "AQoDYXdzEJr...EXAMPLETOKEN", "jeton de session transmis en en-tête")
FIN


// Sans jeton de session sur l'AWSSession, aucun en-tête
// X-Amz-Security-Token n'est émis.
PROCEDURE scenario_sans_jeton_pas_entete_token()
	sess est une AWSSession
	sess..Région     = "us-east-1"
	sess..CléAccès   = "AKIAIOSFODNN7EXAMPLE"
	sess..CléSecrète = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

	corps est un JSON = ChaîneVersJSON("{}")
	AWSRequête(sess, awsSTS, awsSTSGetCallerIdentity, corps)

	req est un httpRequête = MockDernierArgument(mockHttp, 1)
	dbgVérifieEgalité(req..Entête["X-Amz-Security-Token"], "", "aucun jeton de session, aucun en-tête émis")
FIN


// Cadrage protocole JSON (DynamoDB) : Content-Type dédié et cible
// annoncée dans X-Amz-Target sous la forme <préfixe>.<Action>.
PROCEDURE scenario_protocole_json_dynamodb()
	sess est une AWSSession
	sess..Région     = "us-east-1"
	sess..CléAccès   = "AKIAIOSFODNN7EXAMPLE"
	sess..CléSecrète = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

	corps est un JSON = ChaîneVersJSON(`{"TableName":"Clients","Key":{"id":{"S":"42"}}}`)
	AWSRequête(sess, awsDynamoDB, awsDynamoDBGetItem, corps)

	req est un httpRequête = MockDernierArgument(mockHttp, 1)
	dbgVérifieEgalité(req..ContentType, "application/x-amz-json-1.0", "protocole JSON 1.0 pour DynamoDB")

	sCible est une chaîne = req..Entête["X-Amz-Target"]
	dbgVérifieVrai(Contient(sCible, "."), "X-Amz-Target combine un préfixe de cible et l'action")
	dbgVérifieEgalité(Droite(sCible, Taille("GetItem")), "GetItem", "X-Amz-Target se termine par le nom de l'action")
FIN


// Cadrage protocole query (STS) : le corps part en
// application/x-www-form-urlencoded, pas en JSON.
PROCEDURE scenario_protocole_query_sts()
	sess est une AWSSession
	sess..Région     = "us-east-1"
	sess..CléAccès   = "AKIAIOSFODNN7EXAMPLE"
	sess..CléSecrète = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

	corps est un JSON = ChaîneVersJSON("{}")
	AWSRequête(sess, awsSTS, awsSTSGetCallerIdentity, corps)

	req est un httpRequête = MockDernierArgument(mockHttp, 1)
	dbgVérifieEgalité(req..ContentType, "application/x-www-form-urlencoded", "protocole query en form-urlencoded pour STS")
FIN


// Endpoint par défaut : dérivé du service et de la région, sans
