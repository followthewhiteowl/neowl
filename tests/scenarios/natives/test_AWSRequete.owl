FIN


// Non-régression régional : un service régional (DynamoDB) conserve l'endpoint
// dérivé du préfixe et de la région de session, et signe dans cette même région.
PROCEDURE scenario_service_regional_non_regression()
	sess est une AWSSession
	sess..Région     = "eu-central-1"
	sess..CléAccès   = "AKIAIOSFODNN7EXAMPLE"
	sess..CléSecrète = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

	corps est un JSON = ChaîneVersJSON("{}")
	AWSRequête(sess, awsDynamoDB, "ListTables", corps)

	req est un httpRequête = MockDernierArgument(mockHttp, 1)
	dbgVérifieVrai(Contient(req..URL, "dynamodb.eu-central-1.amazonaws.com"), "service régional : endpoint dérivé du préfixe et de la région")
	sAutorisation est une chaîne = req..Entête["Authorization"]
	dbgVérifieVrai(Contient(sAutorisation, "/eu-central-1/dynamodb/"), "service régional : signature dans la région de session")
FIN


// Décodage rest-xml d'une liste à UN SEUL élément : le membre TagSet (liste de
// structures Tag) doit décoder DIRECTEMENT en tableau à 1 entrée — pas en objet
// intermédiaire portant une clé "Tag". Comparaison sur la sérialisation minifiée
// exacte : discrimine sans ambiguïté le tableau ciblé de l'objet-conteneur
// aujourd'hui produit par le décodage schéma-less (`{"Tag":{...}}`), pour lequel
// une comparaison de taille seule serait trompeuse (un objet à 1 clé a aussi
// une taille de 1).
PROCEDURE scenario_rest_xml_liste_un_element_decode_tableau()
	repXml est un httpRéponse
	repXml..CodeEtat = 200
	repXml..Contenu  = ChaîneVersBuffer(`<Tagging xmlns="http://s3.amazonaws.com/doc/2006-03-01/"><TagSet><Tag><Key>env</Key><Value>prod</Value></Tag></TagSet></Tagging>`)
	mockHttp         = MockCrée(HTTPEnvoie).Quand().Retourne(repXml).Active()

	sess est une AWSSession
	sess..Région     = "us-east-1"
	sess..CléAccès   = "AKIAIOSFODNN7EXAMPLE"
	sess..CléSecrète = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

	corps est un JSON = ChaîneVersJSON(`{"Bucket":"mon-seau"}`)
	rep est un JSON = AWSRequête(sess, awsS3, awsS3GetBucketTagging, corps)

	dbgVérifieEgalité(JSONVersChaîne(rep.Tagging.TagSet, psdMinifie), `[{"Key":"env","Value":"prod"}]`, "TagSet à un seul Tag décode en tableau direct, pas en objet-conteneur")
FIN


// Décodage rest-xml d'une liste à DEUX éléments : même exigence de forme que le
// cas à 1 élément — TagSet doit être le tableau lui-même, pas un objet-conteneur
// `{"Tag":[...]}`. Le fix qui rend le cas à 1 élément conforme doit produire la
// MÊME forme quel que soit le nombre d'entrées.
PROCEDURE scenario_rest_xml_liste_deux_elements_decode_tableau()
	repXml est un httpRéponse
	repXml..CodeEtat = 200
	repXml..Contenu  = ChaîneVersBuffer(`<Tagging xmlns="http://s3.amazonaws.com/doc/2006-03-01/"><TagSet><Tag><Key>env</Key><Value>prod</Value></Tag><Tag><Key>team</Key><Value>core</Value></Tag></TagSet></Tagging>`)
	mockHttp         = MockCrée(HTTPEnvoie).Quand().Retourne(repXml).Active()

	sess est une AWSSession
	sess..Région     = "us-east-1"
	sess..CléAccès   = "AKIAIOSFODNN7EXAMPLE"
	sess..CléSecrète = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

	corps est un JSON = ChaîneVersJSON(`{"Bucket":"mon-seau"}`)
	rep est un JSON = AWSRequête(sess, awsS3, awsS3GetBucketTagging, corps)

	dbgVérifieEgalité(JSONVersChaîne(rep.Tagging.TagSet, psdMinifie), `[{"Key":"env","Value":"prod"},{"Key":"team","Value":"core"}]`, "TagSet à deux Tag décode en tableau direct à 2 éléments")
FIN


// Décodage query (IAM ListUsers) d'une liste à UN SEUL élément : le membre-liste
// Users décode DIRECTEMENT en tableau (forme boto3 « hoist »), le nom
// d'élément répété `member` étant consommé — pas `{"member":{...}}` ni
// `{"member":[...]}`. Même piège schéma-less que rest-xml, sur le protocole
// query — comparaison exacte pour ne pas se faire piéger par une taille d'objet
// à 1 clé qui coïnciderait avec la taille de tableau attendue.
PROCEDURE scenario_query_liste_un_element_decode_tableau()
	repXml est un httpRéponse
	repXml..CodeEtat = 200
	repXml..Contenu  = ChaîneVersBuffer(`<ListUsersResponse xmlns="https://iam.amazonaws.com/doc/2010-05-08/"><ListUsersResult><IsTruncated>false</IsTruncated><Users><member><UserName>alice</UserName></member></Users></ListUsersResult><ResponseMetadata><RequestId>r2</RequestId></ResponseMetadata></ListUsersResponse>`)
	mockHttp         = MockCrée(HTTPEnvoie).Quand().Retourne(repXml).Active()

	sess est une AWSSession
	sess..Région     = "us-east-1"
	sess..CléAccès   = "AKIAIOSFODNN7EXAMPLE"
	sess..CléSecrète = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

	corps est un JSON = ChaîneVersJSON("{}")
	rep est un JSON = AWSRequête(sess, awsIAM, "ListUsers", corps)

	dbgVérifieEgalité(JSONVersChaîne(rep.ListUsersResponse.ListUsersResult.Users, psdMinifie), `[{"UserName":"alice"}]`, "Users à un seul membre décode en tableau direct (forme boto3), pas en objet-conteneur")
FIN


// Décodage query (IAM ListUsers) d'une liste VIDE : Users sans aucun <member>
// décode en tableau vide `[]`, pas en chaîne vide "" ni null — même forme que
// les cas à 1 et N éléments (Users EST le tableau, forme boto3 « hoist »),
// juste avec 0 entrée.
PROCEDURE scenario_query_liste_vide_decode_tableau_vide()
	repXml est un httpRéponse
	repXml..CodeEtat = 200
	repXml..Contenu  = ChaîneVersBuffer(`<ListUsersResponse xmlns="https://iam.amazonaws.com/doc/2010-05-08/"><ListUsersResult><IsTruncated>false</IsTruncated><Users></Users></ListUsersResult><ResponseMetadata><RequestId>r2</RequestId></ResponseMetadata></ListUsersResponse>`)
	mockHttp         = MockCrée(HTTPEnvoie).Quand().Retourne(repXml).Active()

	sess est une AWSSession
	sess..Région     = "us-east-1"
	sess..CléAccès   = "AKIAIOSFODNN7EXAMPLE"
	sess..CléSecrète = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

	corps est un JSON = ChaîneVersJSON("{}")
	rep est un JSON = AWSRequête(sess, awsIAM, "ListUsers", corps)

	dbgVérifieEgalité(JSONVersChaîne(rep.ListUsersResponse.ListUsersResult.Users, psdMinifie), `[]`, "Users vide décode en tableau direct vide, pas en chaîne vide ni null")
FIN
