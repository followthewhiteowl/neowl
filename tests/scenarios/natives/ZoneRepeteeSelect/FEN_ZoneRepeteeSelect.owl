// Fenêtre voisine — ressource pour test_ZoneRépétéeSelect.owl.
//
// Un Champ ZoneRépétée par programmation, garni de 3 répétitions dans
// FinInitialisation.

FEN_ZoneRépétéeSelect est une Fenêtre
	PROPRIETES
		Titre       = "Gestion des tâches"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 300
	FIN

	ZR_Tâches est un Champ ZoneRépétée
		PROPRIETES
			X                 = 10
			Y                 = 10
			Largeur           = 360
			Hauteur           = 200
			Sens              = zrVertical
			HauteurRepetition = 50
		FIN

		LIB_Vide est un Champ Libellé
			PROPRIETES
				X       = 5
				Y       = 5
				Largeur = 1
				Libellé = ""
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		ZoneRépétéeAjouteLigne(ZR_Tâches)
		ZoneRépétéeAjouteLigne(ZR_Tâches)
		ZoneRépétéeAjouteLigne(ZR_Tâches)
	FIN
FIN
