// @sujet : fRepExe
// @résumé : Renvoie le répertoire contenant l'exécutable en cours. Chemin
// absolu, sans séparateur final.

// ============================================
// Cas pedagogiques (publics)
// ============================================

PROCEDURE PUBLIQUE scenario_non_vide()
	// Le répertoire de l'exécutable est toujours renseigné.
	rep est une chaîne = fRepExe()
	dbgVérifieVrai(Taille(rep) > 0, "le répertoire de l'exécutable est non vide")
FIN

PROCEDURE PUBLIQUE scenario_chemin_absolu()
	// Le résultat contient au moins un séparateur de chemin (chemin absolu).
	rep est une chaîne = fRepExe()
	dbgVérifieVrai(Position(rep, fSep()) > 0, "le chemin contient un séparateur (chemin absolu)")
FIN

PROCEDURE PUBLIQUE scenario_pas_de_separateur_final()
	// Le chemin ne se termine pas par un séparateur.
	rep est une chaîne = fRepExe()
	dernier est une chaîne = Droite(rep, 1)
	dbgVérifieFaux(dernier = "\", "pas de backslash final")
	dbgVérifieFaux(dernier = "/", "pas de slash final")
FIN

PROCEDURE PUBLIQUE scenario_stable()
	// Deux appels successifs renvoient la même valeur.
	rep1 est une chaîne = fRepExe()
	rep2 est une chaîne = fRepExe()
	dbgVérifieEgalité(rep1, rep2, "appels successifs stables")
FIN
