// @sujet : dRectangle
// @résumé : Dessiner un rectangle avec fond et contour dans une image

// ════════════════════════════════════════════════════════════════════════════════════
// SECTION PUBLIQUE — scénarios documentaires (usage typique, valeur pédagogique)
// ════════════════════════════════════════════════════════════════════════════════════

PROCEDURE PUBLIQUE scenario_rectangle_fond_jaune_contour_bleu()
	img est un Image
	couleurBlanc est un entier = RVB(255, 255, 255)
	couleurJaune est un entier = RVB(255, 255, 0)
	couleurBleu est un entier = RVB(0, 0, 255)
	pixelInterieur est un entier

	// Rectangle simple : coin haut-gauche (10,10), coin bas-droit (90,90)
	// fond jaune, contour bleu
	img = dCréeImage(100, 100, couleurBlanc)
	dDébutDessin(img)
	dRectangle(img, 10, 10, 90, 90, couleurJaune, couleurBleu)
	dFinDessin(img)

	// Centre du rectangle (50,50) — bien à l'intérieur, fond jaune
	pixelInterieur = dPixelCouleur(img, 50, 50)
	dbgVérifieEgalité(pixelInterieur, couleurJaune, "rectangle fond jaune : centre est jaune")
FIN

PROCEDURE PUBLIQUE scenario_rectangle_plein_sans_contour()
	img est un Image
	couleurBlanc est un entier = RVB(255, 255, 255)
	couleurRouge est un entier = RVB(255, 0, 0)
	pixelCentre est un entier

	// Rectangle sans contour : seulement couleur de fond spécifiée, pas de trait
	img = dCréeImage(100, 100, couleurBlanc)
	dDébutDessin(img)
	dRectangle(img, 0, 0, 100, 100, couleurRouge)
	dFinDessin(img)

	// Fond rouge couvre toute l'image
	pixelCentre = dPixelCouleur(img, 50, 50)
	dbgVérifieEgalité(pixelCentre, couleurRouge, "rectangle sans contour : centre rouge pur")
FIN

PROCEDURE PUBLIQUE scenario_rectangle_avec_dStylo_pour_contour()
	img est un Image
	couleurBlanc est un entier = RVB(255, 255, 255)
	couleurVert est un entier = RVB(0, 255, 0)
	couleurMagenta est un entier = RVB(255, 0, 255)
	pixelInterieur est un entier

	// Rectangle utilisant dStylo pour définir le contour
	img = dCréeImage(100, 100, couleurBlanc)
	dDébutDessin(img)
	dStylo(couleurMagenta, 0, 2)
	dRectangle(img, 15, 15, 85, 85, couleurVert)
	dFinDessin(img)

	// Centre du rectangle (50,50) — fond vert
	pixelInterieur = dPixelCouleur(img, 50, 50)
	dbgVérifieEgalité(pixelInterieur, couleurVert, "rectangle avec dStylo : centre est vert")
FIN

PROCEDURE PUBLIQUE scenario_rectangle_tres_large()
	img est un Image
	couleurBlanc est un entier = RVB(255, 255, 255)
	couleurCyan est un entier = RVB(0, 255, 255)
	couleurNoir est un entier = RVB(0, 0, 0)
	pixelInterieur est un entier

	// Rectangle large (250x150) sur image 300x200
	img = dCréeImage(300, 200, couleurBlanc)
	dDébutDessin(img)
	dRectangle(img, 25, 25, 275, 175, couleurCyan, couleurNoir)
	dFinDessin(img)

	// Centre du rectangle (150,100) — fond cyan
	pixelInterieur = dPixelCouleur(img, 150, 100)
	dbgVérifieEgalité(pixelInterieur, couleurCyan, "rectangle large : centre est cyan")
FIN

// ════════════════════════════════════════════════════════════════════════════════════
// SECTION PRIVÉE — cas limites, edge cases, valeurs extrêmes (non user-facing)
// ════════════════════════════════════════════════════════════════════════════════════

PROCEDURE PRIVÉE scenario_edge_rectangle_hauteur_nulle()
	img est un Image
	couleurBlanc est un entier = RVB(255, 255, 255)
	couleurOrange est un entier = RVB(255, 165, 0)

	// Rectangle dégénéré : hauteur 0 (y1=y2) → impl native trace probablement ligne 1D
	img = dCréeImage(100, 100, couleurBlanc)
	dDébutDessin(img)
	dRectangle(img, 10, 50, 90, 50, couleurOrange)
	dFinDessin(img)

	// Verrouille l'absence de crash, comportement exact (ligne 1D vs ignoré) non critique
	dbgVérifieVrai(Vrai, "rectangle hauteur=0 : pas de crash")
FIN

PROCEDURE PRIVÉE scenario_edge_rectangle_largeur_nulle()
	img est un Image
	couleurBlanc est un entier = RVB(255, 255, 255)
	couleurJaune est un entier = RVB(255, 255, 0)

	// Rectangle dégénéré : largeur 0 (x1=x2) → impl native trace probablement ligne 1D
	img = dCréeImage(100, 100, couleurBlanc)
	dDébutDessin(img)
	dRectangle(img, 50, 10, 50, 90, couleurJaune)
	dFinDessin(img)

	// Verrouille l'absence de crash, comportement exact (ligne 1D vs ignoré) non critique
	dbgVérifieVrai(Vrai, "rectangle largeur=0 : pas de crash")
FIN

PROCEDURE PRIVÉE scenario_edge_rectangle_coordonnees_inversees()
	img est un Image
	couleurBlanc est un entier = RVB(255, 255, 255)
	couleurViolet est un entier = RVB(128, 0, 128)

	// Coordonnées inversées : x2 < x1 et y2 < y1 (coin bas-droit < coin haut-gauche)
	img = dCréeImage(100, 100, couleurBlanc)
	dDébutDessin(img)
	dRectangle(img, 90, 90, 10, 10, couleurViolet)
	dFinDessin(img)

	// Impl peut corriger auto ou ignorer, test verrouille l'absence de crash
	dbgVérifieVrai(Vrai, "rectangle coords inversées : pas de crash")
FIN

PROCEDURE PRIVÉE scenario_edge_rectangle_un_pixel()
	img est un Image
	couleurBlanc est un entier = RVB(255, 255, 255)
	couleurRouge est un entier = RVB(255, 0, 0)

	// Rectangle minimal : 1x1 pixel (coin haut-gauche = coin bas-droit)
	img = dCréeImage(100, 100, couleurBlanc)
	dDébutDessin(img)
	dRectangle(img, 50, 50, 51, 51, couleurRouge)
	dFinDessin(img)

	// 1 pixel rouge sur 10000 : vérifie absence de crash
	dbgVérifieVrai(Vrai, "rectangle 1x1 : tracé sans crash")
FIN

PROCEDURE PRIVÉE scenario_edge_rectangle_hors_limites_partiel()
	img est un Image
	couleurBlanc est un entier = RVB(255, 255, 255)
	couleurBleu est un entier = RVB(0, 0, 255)
	pixelInterieur est un entier

	// Rectangle partiellement hors image : coin bas-droit dépasse (200,200 > 100,100)
	img = dCréeImage(100, 100, couleurBlanc)
	dDébutDessin(img)
	dRectangle(img, 50, 50, 200, 200, couleurBleu)
	dFinDessin(img)

	// Partie visible du rectangle (coin bas-droit 50..100, 50..100), point (75,75) à l'intérieur
	pixelInterieur = dPixelCouleur(img, 75, 75)
	dbgVérifieEgalité(pixelInterieur, couleurBleu, "rectangle hors limites partiel : partie visible est bleue")
FIN

PROCEDURE PRIVÉE scenario_edge_rectangle_negatif()
	img est un Image
	couleurBlanc est un entier = RVB(255, 255, 255)
	couleurMagenta est un entier = RVB(255, 0, 255)
	pixelInterieur est un entier

	// Coordonnées négatives : coin haut-gauche hors image à gauche/en haut
	img = dCréeImage(100, 100, couleurBlanc)
	dDébutDessin(img)
	dRectangle(img,-20,-20, 50, 50, couleurMagenta)
	dFinDessin(img)

	// Partie visible (de 0,0 à 50,50), point (25,25) à l'intérieur
	pixelInterieur = dPixelCouleur(img, 25, 25)
	dbgVérifieEgalité(pixelInterieur, couleurMagenta, "rectangle coords négatives : partie visible est magenta")
FIN
