// @sujet : CrypteStandard
// @résumé : Vérifie que CrypteStandard et DécrypteStandard honorent réellement le choix
// d'algorithme (AES-128/256), de mode (CBC/CFB/CTR/GCM) et de remplissage (PKCS/Zéro).
// Couvre aussi la distinction inter-algo et le rejet GCM sur buffer altéré.

// ─── AES-128 ───────────────────────────────────────────────────────────────

// AES-128-CBC-PKCS : round-trip nominal.
PROCEDURE PUBLIQUE scenario_aes128_cbc_pkcs()
	msg est une chaîne = "aes128 cbc pkcs"
	cle est une chaîne = "cle-128"
	buf est un buffer = CrypteStandard(msg, cle, crypteAES128, crypteCBC, cryptePaddingPKCS)
	dbgVérifieVrai(Taille(buf) > 0, "AES-128-CBC-PKCS : buffer chiffré non vide")
	clair est un buffer = DécrypteStandard(buf, cle, crypteAES128, crypteCBC, cryptePaddingPKCS)
	dbgVérifieEgalité(clair, msg, "AES-128-CBC-PKCS : round-trip restitue le clair")
FIN


// AES-128-CBC-Zéro : round-trip nominal.
PROCEDURE PUBLIQUE scenario_aes128_cbc_zero()
	msg est une chaîne = "aes128 cbc zero"
	cle est une chaîne = "cle-128"
	buf est un buffer = CrypteStandard(msg, cle, crypteAES128, crypteCBC, cryptePaddingZéro)
	clair est un buffer = DécrypteStandard(buf, cle, crypteAES128, crypteCBC, cryptePaddingZéro)
	dbgVérifieEgalité(clair, msg, "AES-128-CBC-Zéro : round-trip restitue le clair")
FIN


// AES-128-CFB : round-trip nominal (mode flux, sans padding).
PROCEDURE PUBLIQUE scenario_aes128_cfb()
	msg est une chaîne = "aes128 cfb flux"
	cle est une chaîne = "cle-128"
	buf est un buffer = CrypteStandard(msg, cle, crypteAES128, crypteCFB)
	clair est un buffer = DécrypteStandard(buf, cle, crypteAES128, crypteCFB)
	dbgVérifieEgalité(clair, msg, "AES-128-CFB : round-trip restitue le clair")
FIN


// AES-128-CTR : round-trip nominal (mode flux, sans padding).
PROCEDURE PUBLIQUE scenario_aes128_ctr()
	msg est une chaîne = "aes128 ctr flux"
	cle est une chaîne = "cle-128"
	buf est un buffer = CrypteStandard(msg, cle, crypteAES128, crypteCTR)
	clair est un buffer = DécrypteStandard(buf, cle, crypteAES128, crypteCTR)
	dbgVérifieEgalité(clair, msg, "AES-128-CTR : round-trip restitue le clair")
FIN


// AES-128-GCM : round-trip nominal (mode authentifié, sans padding).
PROCEDURE PUBLIQUE scenario_aes128_gcm()
	msg est une chaîne = "aes128 gcm auth"
	cle est une chaîne = "cle-128"
	buf est un buffer = CrypteStandard(msg, cle, crypteAES128, crypteGCM)
	clair est un buffer = DécrypteStandard(buf, cle, crypteAES128, crypteGCM)
	dbgVérifieEgalité(clair, msg, "AES-128-GCM : round-trip restitue le clair")
FIN


// ─── AES-256 ───────────────────────────────────────────────────────────────

