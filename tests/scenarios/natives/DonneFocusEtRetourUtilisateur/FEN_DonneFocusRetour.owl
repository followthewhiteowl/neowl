// Ressource fenetre — voisine de test_DonneFocusEtRetourUtilisateur.owl.
// Deux champs Saisie pour observer le transfert de focus via surEntrée.

FEN_DonneFocusRetour est une Fenêtre
	PROPRIETES
		Titre       = "Focus et retour"
		Largeur     = 400
		Hauteur     = 200
		Disposition = dispLibre
	FIN

	SAI_Premier est un Champ Saisie
		PROPRIETES
			X       = 20
			Y       = 20
			Largeur = 150
		FIN
		PROCEDURE surEntrée()
			cb_focusretour_entree("Premier")
		FIN
	FIN

	SAI_Second est un Champ Saisie
		PROPRIETES
			X       = 20
			Y       = 60
			Largeur = 150
		FIN
		PROCEDURE surEntrée()
			cb_focusretour_entree("Second")
		FIN
	FIN
FIN
