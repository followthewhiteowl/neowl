// @sujet : EnumérationVérifieNom
// @résumé : Indique si un nom correspond à un membre d'une énumération,
// sans faire échouer l'appelant sur un nom inconnu.

ENuance est une Énumération
	Rouge = "R"
	Vert  = "V"
FIN

PROCEDURE PUBLIQUE scenario_nom_existant()
	dbgVérifieVrai(EnumérationVérifieNom(ENuance, "Rouge"), "Le nom Rouge existe dans ENuance")
FIN

PROCEDURE PUBLIQUE scenario_nom_absent()
	dbgVérifieFaux(EnumérationVérifieNom(ENuance, "Jaune"), "Le nom Jaune n'existe pas dans ENuance")
FIN

PROCEDURE PRIVÉE scenario_edge_nom_vide()
	dbgVérifieFaux(EnumérationVérifieNom(ENuance, ""), "Le nom vide n'existe pas")
FIN
