// @sujet : ToucheEnfoncee
// @résumé : Renvoie Vrai si la touche indiquée est physiquement enfoncée
// au moment de l'appel. Utile pour lire l'état des touches de contrôle
// (modificateurs, flèches) ou n'importe quelle touche identifiée par son
// code entier. Accepte les constantes de la famille tk* (directionnelles,
// touches de fonction, etc.) et les codes de lettres via Asc("X").

// En dehors d'une interaction utilisateur réelle (fenêtre de test sans
// focus physique), toutes les touches renvoient Faux.
PROCEDURE scenario_base_headless()
	TestModeHeadless(Vrai)

	bLettre est un booléen = ToucheEnfoncée(Asc("A"))
	dbgVérifieVrai(bLettre = Faux, "touche A : Faux sans interaction utilisateur")
FIN


// Les constantes directionnelles tk* sont des entiers utilisables
// comme argument.
PROCEDURE scenario_directionnelles()
	TestModeHeadless(Vrai)

	bHaut est un booléen = ToucheEnfoncée(tkHaut)
	dbgVérifieVrai(bHaut = Faux, "tkHaut : Faux sans interaction")

	bBas est un booléen = ToucheEnfoncée(tkBas)
	dbgVérifieVrai(bBas = Faux, "tkBas : Faux sans interaction")
FIN


// Forme EN acceptée identiquement.
PROCEDURE scenario_forme_en()
	TestModeHeadless(Vrai)

	b est un booléen = KeyPressed(tkEchap)
	dbgVérifieVrai(b = Faux, "KeyPressed (EN) : forme EN acceptee")
FIN

dbgBilanTest()
