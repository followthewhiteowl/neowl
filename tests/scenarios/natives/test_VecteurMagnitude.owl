// @sujet : VecteurMagnitude
// @résumé : Norme euclidienne d'un Vecteur — racine carrée de la somme des carrés de ses éléments, disponible en native préfixée et en méthode fluente, avec forme anglaise.


// La magnitude (norme euclidienne) d'un Vecteur est √(Σ vᵢ²). Sur un
// triangle 3-4-5 le résultat est exact.
PROCEDURE PUBLIQUE scenario_calcul_magnitude()
	v est un Vecteur = [3.0, 4.0]
	nMagnitude est un réel = VecteurMagnitude(v)
	dbgVérifieEgalité(nMagnitude, 5.0, "√(3² + 4²) = 5.0")
FIN


// La méthode fluente .Magnitude() produit exactement le même résultat que
// la native préfixée.
PROCEDURE PUBLIQUE scenario_fluent_equivalent_natif()
	v est un Vecteur = [3.0, 4.0]
	nViaFluent est un réel = v.Magnitude()
	nViaNatif est un réel = VecteurMagnitude(v)
	dbgVérifieEgalité(nViaFluent, nViaNatif, "v.Magnitude() == VecteurMagnitude(v)")
FIN


// La forme anglaise VectorMagnitude désigne la même opération.
PROCEDURE PUBLIQUE scenario_forme_anglaise()
	v est un Vecteur = [3.0, 4.0]
	nMagnitudeEN est un réel = VectorMagnitude(v)
	dbgVérifieEgalité(nMagnitudeEN, 5.0, "VectorMagnitude(v) = 5.0")
FIN


// Un Vecteur vide (taille 0) a une somme de carrés nulle : sa magnitude
// est 0.0, sans exception.
PROCEDURE PRIVÉE scenario_edge_vecteur_vide()
	v est un Vecteur = []
	nMagnitude est un réel = VecteurMagnitude(v)
	dbgVérifieEgalité(nMagnitude, 0.0, "Magnitude d'un Vecteur vide = 0.0")
FIN
