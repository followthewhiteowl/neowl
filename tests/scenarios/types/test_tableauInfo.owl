// @sujet : tableauInfo
// @résumé : Enum des types d'information (mutuellement exclusifs) acceptés par le paramètre information de TableauInfo : nombre total d'éléments, nombre de dimensions, lignes/colonnes d'un tableau 2D, taille d'un élément, caractère dynamique, etc. Une seule information par appel ; les constantes ne se combinent pas.



// Cas B : usage réel — nombre total d'éléments d'un tableau 1D.
PROCEDURE PUBLIQUE scenario_nombre_total()
	t est un tableau de 4 entiers
	n est un entier = TableauInfo(t, tiNombreTotal)
	dbgVérifieEgalité(n, 4, "TableauInfo renvoie 4 éléments")
FIN


// Cas C : usage réel — nombre de dimensions d'un tableau 1D.
PROCEDURE PUBLIQUE scenario_nombre_dimensions()
	t est un tableau de 3 entiers
	d est un entier = TableauInfo(t, tiNombreDimensions)
	dbgVérifieEgalité(d, 1, "un tableau 1D a une seule dimension")
FIN
