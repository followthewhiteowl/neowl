// @sujet : Forme
// @résumé : Enum cadrage appliqué au rendu d'une icône : aucune (rendu brut), carrée (inscrit dans carré), ou cercle (inscrit dans cercle).


// La propriété Forme d'une Icône accepte les trois valeurs et les restitue.
PROCEDURE PUBLIQUE scenario_forme_sur_icone()
	ICN est une Icône = icones.save
	ICN..Forme = formeCarree
	dbgVérifieEgalité(ICN..Forme, formeCarree, "Forme carrée appliquée sur Icône")
	ICN..Forme = formeCercle
	dbgVérifieEgalité(ICN..Forme, formeCercle, "Forme cercle appliquée sur Icône")
	ICN..Forme = formeAucune
	dbgVérifieEgalité(ICN..Forme, formeAucune, "Forme aucune (défaut) appliquée sur Icône")
FIN


// Réassignation successive : la propriété Forme reflète toujours la dernière valeur affectée.
PROCEDURE PRIVÉE scenario_edge_reassignation_forme()
	ICN est une Icône = icones.save
	ICN..Forme = formeAucune
	dbgVérifieEgalité(ICN..Forme, formeAucune, "initialisée à aucune")
	ICN..Forme = formeCarree
	dbgVérifieEgalité(ICN..Forme, formeCarree, "réassignée à carrée")
	ICN..Forme = formeCercle
	dbgVérifieEgalité(ICN..Forme, formeCercle, "réassignée à cercle")
	ICN..Forme = formeAucune
	dbgVérifieEgalité(ICN..Forme, formeAucune, "retour à aucune")
FIN
