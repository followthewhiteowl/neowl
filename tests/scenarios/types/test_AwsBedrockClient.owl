// @sujet : AwsBedrockClient
// @résumé : Client objet fluent pour le service d'inférence Bedrock. Instancié via `b est un AwsBedrockClient`, la session se pose via `..Session`, l'invocation d'un modèle s'appelle en `b.Invoque(modelId, corps)` et retourne la réponse décodée en JSON.


// Mock partagé : Invoque signe la requête puis délègue l'envoi réseau à
// HTTPEnvoie, exactement comme AwsS3Client. On intercepte cette dépendance
// externe pour rester déterministe (pas de vrai appel Bedrock en test).
mockHttp est un MockNative = MockCrée(HTTPEnvoie)


PROCEDURE avantChaqueTest()
	rep est un httpRéponse
	rep..CodeEtat            = 200
	rep..DescriptionCodeEtat = "OK"
	rep..Contenu             = `{"completion":"bonjour","stop_reason":"end_turn"}`

	mockHttp = MockCrée(HTTPEnvoie).Quand().Retourne(rep).Active()
FIN


PROCEDURE apresChaqueTest()
	mockHttp.Desactive()
FIN


// Construit une session de test partageable entre scénarios.
PROCEDURE PRIVÉE sessionDeTest() : AWSSession
	sess est une AWSSession
	sess..Région     = "eu-central-1"
	sess..CléAccès   = "AKIAIOSFODNN7EXAMPLE"
	sess..CléSecrète = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
	RENVOYER sess
FIN


// Construit un corps de requête (agnostique du contenu modèle).
PROCEDURE PRIVÉE corpsDeTest() : JSON
	corps est un JSON
	corps.anthropic_version = "bedrock-2023-05-31"
	corps.max_tokens = 100
	RENVOYER corps
FIN


// Cas canonique : un AwsBedrockClient déclaré sans initialisation existe, la
// session se pose via la propriété ..Session.
PROCEDURE PUBLIQUE scenario_creation_et_session()
	b est un AwsBedrockClient
	b..Session = sessionDeTest()

	dbgVérifieEgalité(b..Session..Région, "eu-central-1", "session relue via la propriété ..Session")
FIN


// Invoque : la requête déléguée à HTTPEnvoie est un POST signé, l'hôte est
// bedrock-runtime régional, le chemin porte le modelId, le Content-Type est
// application/json et le corps transmis est le JSON fourni sérialisé.
PROCEDURE PUBLIQUE scenario_invoque_post_signe()
	b est un AwsBedrockClient
	b..Session = sessionDeTest()

	b.Invoque("eu.anthropic.claude-sonnet-4-6", corpsDeTest())

	req est un httpRequête = MockDernierArgument(mockHttp, 1)

	dbgVérifieEgalité(req..Méthode, httpPost, "Invoque envoie une requête POST")
	dbgVérifieVrai(Contient(req..URL, "bedrock-runtime.eu-central-1.amazonaws.com"), "l'URL cible l'hôte bedrock-runtime régional")
	dbgVérifieVrai(Contient(req..URL, "/model/eu.anthropic.claude-sonnet-4-6/invoke"), "le chemin porte le modelId entre /model/ et /invoke")
	dbgVérifieEgalité(req..ContentType, "application/json", "Content-Type application/json")
	dbgVérifieVrai(Contient(req..Contenu, "bedrock-2023-05-31"), "le corps JSON fourni est transmis sérialisé")
FIN


// Signature SigV4 : Authorization AWS4-HMAC-SHA256 avec le service `bedrock`
// dans le scope, X-Amz-Date posé, empreinte réelle du corps.
PROCEDURE PUBLIQUE scenario_invoque_signature_service_bedrock()
	b est un AwsBedrockClient
	b..Session = sessionDeTest()

	b.Invoque("eu.anthropic.claude-sonnet-4-6", corpsDeTest())

	req est un httpRequête = MockDernierArgument(mockHttp, 1)

	sAutorisation est une chaîne = req..Entête["Authorization"]
	dbgVérifieVrai(Contient(sAutorisation, "AWS4-HMAC-SHA256"), "Invoque signe la requête (SigV4)")
	dbgVérifieVrai(Contient(sAutorisation, "/bedrock/aws4_request"), "le scope de signature porte le service bedrock (pas bedrock-runtime)")
	dbgVérifieDifférence(req..Entête["X-Amz-Date"], "", "X-Amz-Date posé sur la requête signée")

	sEmpreinte est une chaîne = req..Entête["X-Amz-Content-Sha256"]
	dbgVérifieEgalité(Taille(sEmpreinte), 64, "empreinte SHA-256 hexadécimale du corps (64 caractères)")
	dbgVérifieDifférence(sEmpreinte, "UNSIGNED-PAYLOAD", "empreinte réelle, pas un placeholder non-signé")
FIN


// Réponse : le corps JSON du modèle est retourné décodé en JSON exploitable.
PROCEDURE PUBLIQUE scenario_invoque_reponse_json_decodee()
	b est un AwsBedrockClient
	b..Session = sessionDeTest()

	reponse est un JSON = b.Invoque("eu.anthropic.claude-sonnet-4-6", corpsDeTest())

	dbgVérifieEgalité(reponse.completion, "bonjour", "corps de réponse décodé en JSON (champ completion)")
	dbgVérifieEgalité(reponse.stop_reason, "end_turn", "corps de réponse décodé en JSON (champ stop_reason)")
FIN


// Cas limite : le modelId est encodé pour la canonical URI SigV4. Le point est
// unreserved (non encodé) ; un caractère réservé (ex. ':') est pourcent-encodé.
PROCEDURE PRIVÉE scenario_invoque_modelid_encode()
	b est un AwsBedrockClient
	b..Session = sessionDeTest()

	b.Invoque("anthropic.claude:v2", corpsDeTest())

	req est un httpRequête = MockDernierArgument(mockHttp, 1)
	dbgVérifieVrai(Contient(req..URL, "/model/anthropic.claude%3Av2/invoke"), "':' réservé pourcent-encodé, '.' unreserved conservé")
FIN


// Cas limite défensif : deux invocations successives comptent bien deux
// délégations distinctes à HTTPEnvoie (pas de mise en cache implicite).
PROCEDURE PRIVÉE scenario_deux_invocations_deux_delegations()
	b est un AwsBedrockClient
	b..Session = sessionDeTest()

	b.Invoque("eu.anthropic.claude-sonnet-4-6", corpsDeTest())
	b.Invoque("eu.anthropic.claude-sonnet-4-6", corpsDeTest())

	dbgVérifieVrai(MockVérifieAppelé(mockHttp, 2), "deux invocations, deux délégations HTTPEnvoie")
FIN
