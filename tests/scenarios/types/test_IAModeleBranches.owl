// @sujet : IAModèle — branches parallèles (mon.DébutBranches / .BrancheSuivante /
// .FusionneParAddition)
// @résumé : mon.DébutBranches() capture l'activation courante x (le point de
// divergence) et ouvre une première branche. mon.BrancheSuivante() clôt la
// branche courante et rouvre une nouvelle branche repartant du MÊME x.
// mon.FusionneParAddition() clôt le bloc et additionne, élément par élément,
// les sorties de toutes les branches. Un résiduel à la ResNet s'exprime
// désormais comme un cas particulier : une branche = F(x) (une ou plusieurs
// couches), l'autre branche VIDE (identité) ; un résiduel à PROJECTION
// (raccourci qui change le nombre de canaux, style ResNet bottleneck)
// s'exprime avec les DEUX branches non triviales — l'une F(x), l'autre une
// convolution 1×1 + une normalisation de lot.
//
// Convention de vérification retenue (comme pour test_IAModeleBlocResiduel.owl
// et le socle .Infère) : jamais de valeur de poids/gradient hardcodée quand la
// couche testée possède des poids entraînables — on les EXTRAIT du modèle via
// .Poids/.Biais puis on recalcule indépendamment avec les briques Tenseur bas
// niveau (ProduitMatriciel, Convolution2D, +, *, ErreurQuadratique,
// Rétropropage/DescenteGradient), pour comparaison exacte ou à faible
// tolérance. Pour le bloc à projection, une normalisation de lot toute neuve
// a des paramètres CONNUS par construction (échelle 1, décalage 0, statistiques
// mobiles moyenne 0 / variance 1, cf. test_IAModeleNormalisationLotEval.owl) :
// son effet en inférence se réduit alors à une division par une constante
// connue, ce qui permet un recalcul manuel complet sans avoir besoin de deviner
// des poids aléatoires.

PROCEDURE PRIVÉE entréeGradientCheckBranches() : Tenseur
	mat est une Matrice = [[1.0, -1.0]]
	RENVOYER Tenseur(mat)
FIN

PROCEDURE PRIVÉE cibleGradientCheckBranches() : Tenseur
	mat est une Matrice = [[0.5, -0.5]]
	RENVOYER Tenseur(mat)
FIN

// Perte scalaire d'un bloc à deux branches non triviales (chacune une couche
// dense 2->2) fusionnées par addition, sur l'entrée/cible fixes ci-dessus.
// Fonction PUREMENT forward (aucun Rétropropage ici) : sert de brique au
// gradient-check par différences finies, indépendante du chemin de backward
// qu'elle vérifie (patron test_TenseurConvolution2DGroupe.owl).
PROCEDURE PRIVÉE perteAddMergeDeuxBranches(tW1 est un Tenseur, tb1 est un Tenseur, tW2 est un Tenseur, tb2 est un Tenseur) : réel
	tX est un Tenseur = entréeGradientCheckBranches()
	tY est un Tenseur = cibleGradientCheckBranches()
	tF est un Tenseur = tX.ProduitMatriciel(tW1) + tb1
	tG est un Tenseur = tX.ProduitMatriciel(tW2) + tb2
	tSortie est un Tenseur = tF + tG
	tPerte est un Tenseur = tSortie.ErreurQuadratique(tY)
	RENVOYER tPerte..Valeur[1]
FIN

// Tenseur 2×2 valant `delta` à la position (ligne,colonne) et 0 ailleurs :
// s'ajoute à un poids extrait pour le perturber à un seul endroit, sans
// jamais reconstruire les autres poids (indépendance du gradient-check).
PROCEDURE PRIVÉE tenseurUnSeulÉlément2x2(ligne est un entier, col est un entier, delta est un réel) : Tenseur
	arr est un tableau de réels
	POUR i = 1 À 2
		POUR j = 1 À 2
			SI i = ligne ET j = col ALORS
				arr.Ajoute(delta)
			SINON
				arr.Ajoute(0.0)
			FIN
		FIN
	FIN
	RENVOYER Tenseur(arr).Redimensionne([2, 2])
FIN


// Résiduel identité exprimé par les branches : une branche = F(x) (une
// couche dense), l'autre branche VIDE. FusionneParAddition() doit alors
// rendre exactement F(x) + x, comme l'ancien DébutBlocRésiduel/FinBlocRésiduel
// (test_IAModeleBlocResiduel.owl), mais construit avec le nouveau mécanisme
// de branches. Forward exact, comparé à un calcul manuel avec les poids
// EXTRAITS du modèle.
PROCEDURE PUBLIQUE scenario_residuel_identite_via_branches_egal_calcul_manuel()
	mon est un IAModèle
	mon.DébutBranches()
	mon.AjouteCoucheDense(2, 2, initHe)
	mon.BrancheSuivante()
	mon.FusionneParAddition()

	tW est un Tenseur = mon.Poids(1)
	tb est un Tenseur = mon.Biais(1)

	x est un Tenseur = Tenseur([1.0,-2.0])
	matX est une Matrice = [[1.0, -2.0]]
	tX est un Tenseur = Tenseur(matX)
	tF est un Tenseur = tX.ProduitMatriciel(tW) + tb
	tManuel est un Tenseur = tF + tX

	sortie est un Tenseur = mon.Infère(x)

	valManuel est une Matrice = tManuel..Valeur
	valSortie est un Vecteur = sortie..Valeur

	dbgVérifieEgalité(valSortie..Taille, 2, "le résiduel identité via branches préserve les dimensions : sortie de taille 2 comme l'entrée")
	POUR i = 1 À 2
		dbgVérifieEgalité(valSortie[i], valManuel[1][i], "mon.Infère(x) à travers DébutBranches()/BrancheSuivante()/FusionneParAddition() (branche vide = identité) = F(x)+x calculé à la main, AU BIT PRÈS")
	FIN
FIN


// Même contrat, formes anglaises (.BeginBranches / .NextBranch / .MergeByAdd) :
// verrou de la surface bilingue (invariant 3).
PROCEDURE PUBLIQUE scenario_formes_anglaises_residuel_identite_via_branches()
	mon is an AIModel
	mon.BeginBranches()
	mon.AddDenseLayer(2, 2, initHe)
	mon.NextBranch()
	mon.MergeByAdd()

	tW is a Tensor = mon.Weights(1)
	tb is a Tensor = mon.Bias(1)

	x is a Tensor = Tensor([1.0,-2.0])
	matX is a Matrix = [[1.0, -2.0]]
	tX is a Tensor = Tensor(matX)
	tF is a Tensor = tX.ProduitMatriciel(tW) + tb
	tManuel is a Tensor = tF + tX

	sortie is a Tensor = mon.Infer(x)

	valManuel is a Matrix = tManuel..Valeur
	valSortie is a Vector = sortie..Value

	dbgCheckEqual(valSortie..Length, 2, "English forms: identity residual via branches preserves dimensions -> output size 2")
	POUR i = 1 À 2
		dbgCheckEqual(valSortie[i], valManuel[1][i], "English forms: mon.Infer(x) through BeginBranches()/NextBranch()/MergeByAdd() (empty branch = identity) = F(x)+x, bit for bit")
	FIN
FIN


// Résiduel à PROJECTION : la branche 2 n'est PAS vide mais porte une
// convolution 1×1 + une normalisation de lot (le raccourci change le nombre
// de canaux, comme dans un bottleneck ResNet). C'est le cas nouveau que les
// anciens marqueurs résiduels (identité seule) ne pouvaient pas exprimer.
//
// La normalisation de lot est toute NEUVE (jamais entraînée) : ses
// paramètres sont connus par construction (échelle 1, décalage 0,
// statistiques mobiles moyenne 0 / variance 1, epsilon par défaut 1e-5 —
// cf. test_IAModeleNormalisationLotEval.owl / AjouteCoucheNormalisationLot).
// En inférence (statistiques mobiles figées), son effet se réduit donc à une
// division par une constante connue — ce qui permet de recalculer la branche
// de projection à la main sans deviner ses poids appris.
//
// Hypothèse (à confirmer par l'implémenteur, comme pour
// test_IAModeleConvolution2D.owl) : .Poids(n)/.Biais(n) numérotent les
// couches à paramètres dans l'ordre de construction à travers toutes les
// branches — ici 1 = la convolution de la branche F, 2 = la convolution de
// la branche de projection (la normalisation de lot n'a pas de poids/biais
// au sens .Poids/.Biais, ses paramètres gamma/beta restent implicites tant
// qu'elle n'a jamais été entraînée).
PROCEDURE PUBLIQUE scenario_residuel_projection_via_branches_egal_calcul_manuel()
	mon est un IAModèle
	mon.DébutBranches()
	mon.AjouteCoucheConvolution2D(2, 4, 3, 1, 1)
	mon.BrancheSuivante()
	mon.AjouteCoucheConvolution2D(2, 4, 1, 1, 0)
	mon.AjouteCoucheNormalisationLot(4)
	mon.FusionneParAddition()

	tWF est un Tenseur = mon.Poids(1)
	tbF est un Tenseur = mon.Biais(1)
	tWProj est un Tenseur = mon.Poids(2)
	tbProj est un Tenseur = mon.Biais(2)

	brut est un tableau de réels
	POUR k = 0 À 31
		brut.Ajoute(k / 32.0)
	FIN
	entrée est un Tenseur = Tenseur(brut).Redimensionne([1, 2, 4, 4])

	tF est un Tenseur = entrée.Convolution2D(tWF, 1, 1) + tbF
	tProjConv est un Tenseur = entrée.Convolution2D(tWProj, 1, 0) + tbProj

	// Normalisation de lot toute neuve, en inférence : y = x / racine(1+eps),
	// IDENTIQUE sur chaque élément (échelle 1, décalage 0, moyenne mobile 0,
	// variance mobile 1).
	epsilon est un réel = 0.00001
	facteur est un réel = 1.0 / Racine(1.0 + epsilon)
	arrFacteur est un tableau de réels
	POUR k = 1 À 64
		arrFacteur.Ajoute(facteur)
	FIN
	tFacteur est un Tenseur = Tenseur(arrFacteur).Redimensionne([1, 4, 4, 4])
	tProj est un Tenseur = tProjConv * tFacteur

	tManuel est un Tenseur = tF + tProj
	sortie est un Tenseur = mon.Infère(entrée)

	dbgVérifieVrai(Abs(sortie..Valeur[1][1][1][1] - tManuel..Valeur[1][1][1][1]) < 0.0000001, "résiduel à projection (raccourci conv1x1+normalisation de lot) via branches = F(x)+projection(x) calculé à la main, coin [1][1][1][1]")
	dbgVérifieVrai(Abs(sortie..Valeur[1][4][4][4] - tManuel..Valeur[1][4][4][4]) < 0.0000001, "résiduel à projection via branches = F(x)+projection(x) calculé à la main, coin [1][4][4][4]")
	dbgVérifieVrai(Abs(sortie..Valeur[1][2][2][3] - tManuel..Valeur[1][2][2][3]) < 0.0000001, "résiduel à projection via branches = F(x)+projection(x) calculé à la main, cellule intérieure [1][2][2][3]")
FIN


// Gradient-check backward du merge par addition (FusionneParAddition), sur un
// bloc à DEUX branches non triviales (deux couches denses 2->2, la même
// entrée x nourrit les deux). Le gradient "analytique" est lu au travers du
// mécanisme réel du modèle (mon.Entraîne, un pas de SGD pur : le poids AVANT
// moins le poids APRÈS, divisé par le taux d'apprentissage, donne exactement
// le gradient — même convention que test_IAModeleBlocResiduel.owl. .Infère ne
// construisant jamais de graphe autograd, cette lecture par différence est la
// seule fenêtre sur le gradient qui a réellement traversé DébutBranches()/
// BrancheSuivante()/FusionneParAddition()). Il est comparé à des différences
// finies centrées calculées par un helper strictement FORWARD (aucun
// Rétropropage), donc indépendant du chemin de backward qu'il vérifie —
// patron exact de test_TenseurConvolution2DGroupe.owl. Une composante est
// vérifiée dans CHAQUE branche, pour prouver que le gradient est bien routé
// (et non mélangé) vers les deux.
PROCEDURE PUBLIQUE scenario_gradient_addmerge_deux_branches_verifie_par_differences_finies()
	mon est un IAModèle
	mon.DébutBranches()
	mon.AjouteCoucheDense(2, 2, initHe)
	mon.BrancheSuivante()
	mon.AjouteCoucheDense(2, 2, initHe)
	mon.FusionneParAddition()

	tW1avant est un Tenseur = mon.Poids(1)
	tb1avant est un Tenseur = mon.Biais(1)
	tW2avant est un Tenseur = mon.Poids(2)
	tb2avant est un Tenseur = mon.Biais(2)

	tX est un Tenseur = entréeGradientCheckBranches()
	tY est un Tenseur = cibleGradientCheckBranches()

	opts est un OptionsEntraînement
	opts..Époques           = 1
	opts..TailleLot         = 1
	opts..TauxApprentissage = 0.1
	opts..Optimiseur        = optimSGD
	opts..Perte             = perteErreurQuadratique
	mon.Entraîne(tX, tY, opts)

	tW1après est un Tenseur = mon.Poids(1)
	tW2après est un Tenseur = mon.Poids(2)

	valW1avant est une Matrice = tW1avant..Valeur
	valW1après est une Matrice = tW1après..Valeur
	valW2avant est une Matrice = tW2avant..Valeur
	valW2après est une Matrice = tW2après..Valeur

	tauxApprentissage est un réel = 0.1
	dW1AnalytiqueViaSGD est un réel = (valW1avant[1][1] - valW1après[1][1]) / tauxApprentissage
	dW2AnalytiqueViaSGD est un réel = (valW2avant[1][1] - valW2après[1][1]) / tauxApprentissage

	eps est un réel = 0.0001

	tW1plus est un Tenseur = tW1avant + tenseurUnSeulÉlément2x2(1, 1, eps)
	tW1moins est un Tenseur = tW1avant + tenseurUnSeulÉlément2x2(1, 1,-eps)
	perteW1Plus est un réel = perteAddMergeDeuxBranches(tW1plus, tb1avant, tW2avant, tb2avant)
	perteW1Moins est un réel = perteAddMergeDeuxBranches(tW1moins, tb1avant, tW2avant, tb2avant)
	dW1Findiff est un réel = (perteW1Plus - perteW1Moins) / (2 * eps)

	tW2plus est un Tenseur = tW2avant + tenseurUnSeulÉlément2x2(1, 1, eps)
	tW2moins est un Tenseur = tW2avant + tenseurUnSeulÉlément2x2(1, 1,-eps)
	perteW2Plus est un réel = perteAddMergeDeuxBranches(tW1avant, tb1avant, tW2plus, tb2avant)
	perteW2Moins est un réel = perteAddMergeDeuxBranches(tW1avant, tb1avant, tW2moins, tb2avant)
	dW2Findiff est un réel = (perteW2Plus - perteW2Moins) / (2 * eps)

	tolérance est un réel = 0.001
	dbgVérifieVrai(Abs(dW1AnalytiqueViaSGD - dW1Findiff) < tolérance, "branche 1 (F) : le gradient qui traverse FusionneParAddition() est proche des différences finies indépendantes")
	dbgVérifieVrai(Abs(dW2AnalytiqueViaSGD - dW2Findiff) < tolérance, "branche 2 : le gradient qui traverse FusionneParAddition() est proche des différences finies indépendantes — routé, pas mélangé avec la branche 1")
FIN


// Import d'un bloc résiduel à PROJECTION depuis ONNX : raccourci = convolution
// 1×1 + normalisation de lot (motif bottleneck ResNet). Fixture :
// tests/internal_fixtures/onnx/fixture_bottleneck_proj.onnx — entrée [1,2,8,8],
// chemin principal (2 convolutions 3×3 + normalisations de lot + activation
// intercalée), raccourci (convolution 1×1 + normalisation de lot), fusion par
// addition puis activation, réduction globale puis couche dense (4→3).
// Oracle : tests/internal_fixtures/onnx/fixture_bottleneck_proj_oracle.json —
// sortie calculée indépendamment (double vérification, moteur d'entraînement
// ET moteur d'inférence dédié, tous deux hors OWL).
//
// Si le raccourci à projection n'est pas mappé, l'import réussit (chaque
// couche est reconnue individuellement) mais l'inférence échoue : la fusion
// par addition suppose un raccourci IDENTITÉ, donc le nombre de canaux ne
// correspond plus dès que le raccourci porte sa propre convolution.
PROCEDURE PUBLIQUE scenario_import_onnx_bloc_residuel_projection_egal_oracle()
	mon est un IAModèle
	mon.ChargeONNX("tests/internal_fixtures/onnx/fixture_bottleneck_proj.onnx")
	// Capture immédiate : la sentinelle d'erreur est consommée au 1er appel
	// natif suivant (cf. skill test-writing-pitfalls §6).
	bImportEchoue est un booléen = ErreurDétectée
	dbgVérifieVrai(PAS bImportEchoue, "l'import d'un bloc résiduel à projection (raccourci conv1x1+normalisation de lot) réussit (chaque couche est reconnue)")

	SI PAS bImportEchoue ALORS
		brut est un tableau de réels
		POUR k = 0 À 127
			brut.Ajoute(k / 128.0)
		FIN
		entrée est un Tenseur = Tenseur(brut).Redimensionne([1, 2, 8, 8])

		sortie est un Tenseur = mon.Infère(entrée)
		bInfereEchoue est un booléen = ErreurDétectée
		dbgVérifieVrai(PAS bInfereEchoue, "l'inférence d'un bloc résiduel à projection réussit (le raccourci convolué est câblé, pas mélangé avec le chemin principal)")

		SI PAS bInfereEchoue ALORS
			dbgVérifieEgalité(sortie..Rang, 1, "sortie image unique : Tenseur 1D [classes]")
			val est un Vecteur = sortie..Valeur

			attendu1 est un réel = 0.4790436029434204
			attendu2 est un réel = -0.3790234923362732
			attendu3 est un réel = -0.30714595317840576

			dbgVérifieVrai(Abs(val[1] - attendu1) < 0.0001, "sortie[1] proche de l'oracle (bloc résiduel à projection, tolérance flottante)")
			dbgVérifieVrai(Abs(val[2] - attendu2) < 0.0001, "sortie[2] proche de l'oracle (bloc résiduel à projection, tolérance flottante)")
			dbgVérifieVrai(Abs(val[3] - attendu3) < 0.0001, "sortie[3] proche de l'oracle (bloc résiduel à projection, tolérance flottante)")
		FIN
	FIN
FIN


// Verrou de la forme anglaise : .LoadONNX sur la même fixture produit le même
// comportement observable que .ChargeONNX.
PROCEDURE PUBLIQUE scenario_load_onnx_projection_residual_block_infer_egale_oracle()
	mon is an AIModel
	mon.LoadONNX("tests/internal_fixtures/onnx/fixture_bottleneck_proj.onnx")
	bImportFailed is a boolean = ErrorOccurred
	dbgCheckTrue(PAS bImportFailed, "importing a projection-shortcut residual block (1x1 conv + batch norm) succeeds (each layer is recognized)")

	SI PAS bImportFailed ALORS
		raw is an array of reals
		POUR k = 0 À 127
			raw.Ajoute(k / 128.0)
		FIN
		input is a Tensor = Tensor(raw).Redimensionne([1, 2, 8, 8])

		output is a Tensor = mon.Infer(input)
		bInferFailed is a boolean = ErrorOccurred
		dbgCheckTrue(PAS bInferFailed, "inferring a projection-shortcut residual block succeeds (the convolved shortcut is wired, not mixed with the main path)")

		SI PAS bInferFailed ALORS
			dbgCheckEqual(output..Rank, 1, "single-image output: 1D Tensor [classes]")
			val is a Vector = output..Value

			expected1 is a real = 0.4790436029434204
			expected2 is a real = -0.3790234923362732
			expected3 is a real = -0.30714595317840576

			dbgCheckTrue(Abs(val[1] - expected1) < 0.0001, "AIModel.LoadONNX, English form: output[1] within tolerance of the projection-residual oracle")
			dbgCheckTrue(Abs(val[2] - expected2) < 0.0001, "AIModel.LoadONNX, English form: output[2] within tolerance of the projection-residual oracle")
			dbgCheckTrue(Abs(val[3] - expected3) < 0.0001, "AIModel.LoadONNX, English form: output[3] within tolerance of the projection-residual oracle")
		FIN
	FIN
FIN


// Non-régression : un bloc résiduel IDENTITÉ importé depuis ONNX (raccourci =
// le tenseur brut, sans convolution — motif ResNet non-bottleneck)
// continue de fonctionner à l'identique. Réutilise la fixture déjà
// verrouillée par test_IAModeleONNX.owl (mêmes valeurs d'entrée et d'oracle) :
// ce scénario est un point de repère de non-régression — le raccourci
// identité continue de passer par FusionneParAddition() avec une branche
// vide, sans régression de valeur.
PROCEDURE PUBLIQUE scenario_non_regression_import_residuel_identite_egal_oracle()
	mon est un IAModèle
	mon.ChargeONNX("tests/internal_fixtures/onnx/fixture_resnet.onnx")
	bImportEchoue est un booléen = ErreurDétectée
	dbgVérifieVrai(PAS bImportEchoue, "l'import du bloc résiduel identité (Add-skip sans projection) continue de réussir")

	SI PAS bImportEchoue ALORS
		brut est un tableau de réels
		POUR k = 0 À 127
			brut.Ajoute(k / 128.0)
		FIN
		entrée est un Tenseur = Tenseur(brut).Redimensionne([1, 2, 8, 8])

		sortie est un Tenseur = mon.Infère(entrée)
		bInfereEchoue est un booléen = ErreurDétectée
		dbgVérifieVrai(PAS bInfereEchoue, "l'inférence du bloc résiduel identité continue de réussir")

		SI PAS bInfereEchoue ALORS
			dbgVérifieEgalité(sortie..Rang, 1, "sortie image unique : Tenseur 1D [classes]")
			val est un Vecteur = sortie..Valeur

			attendu1 est un réel = -0.13573767244815826
			attendu2 est un réel = 0.19091612100601196
			attendu3 est un réel = 0.05653282627463341

			dbgVérifieVrai(Abs(val[1] - attendu1) < 0.0001, "non-régression : sortie[1] du résiduel identité inchangée")
			dbgVérifieVrai(Abs(val[2] - attendu2) < 0.0001, "non-régression : sortie[2] du résiduel identité inchangée")
			dbgVérifieVrai(Abs(val[3] - attendu3) < 0.0001, "non-régression : sortie[3] du résiduel identité inchangée")
		FIN
	FIN
FIN


// Cas limite : BrancheSuivante() appelée sans DébutBranches() préalable
// signale une erreur (même famille que les anciens marqueurs résiduels non
// appariés, test_IAModeleBlocResiduel.owl::scenario_erreur_fin_bloc_sans_debut).
// La validation structurelle rejette cet appel non apparié.
PROCEDURE PRIVÉE scenario_edge_branche_suivante_sans_debut_branches()
	mon est un IAModèle
	mon.AjouteCoucheDense(2, 2)

	ErreurRAZ()
	mon.BrancheSuivante()
	dbgVérifieVrai(ErreurDétectée, "BrancheSuivante() sans DébutBranches() correspondant signale une erreur")
FIN


// Cas limite symétrique : FusionneParAddition() sans DébutBranches()
// préalable signale une erreur.
PROCEDURE PRIVÉE scenario_edge_fusionne_par_addition_sans_debut_branches()
	mon est un IAModèle
	mon.AjouteCoucheDense(2, 2)

	ErreurRAZ()
	mon.FusionneParAddition()
	dbgVérifieVrai(ErreurDétectée, "FusionneParAddition() sans DébutBranches() correspondant signale une erreur")
FIN
