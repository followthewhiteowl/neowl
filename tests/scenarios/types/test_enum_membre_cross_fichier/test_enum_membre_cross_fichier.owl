// @sujet : Acces Enum.membre cross-fichier
// @resume : Un membre d'enumeration declare dans un fichier doit etre accessible depuis un autre fichier du projet via la syntaxe Enum.membre. Le type Statut est resolu cross-fichier (le compilo connait le type) et l'acces au membre Statut.actif l'est egalement.

// Cas nominal : acces Enum.membre dans une classe (constructeur)
PROCEDURE scenario_classe_enum_membre_cross()
	o est un cCompte()
	dbgVérifieEgalité(o.eStatut, Statut.actif, "constructeur classe acces Statut.actif")
	
	o.Geler()
	dbgVérifieEgalité(o.eStatut, Statut.gele, "methode classe acces Statut.gele")
FIN

// Cas complementaire : acces Enum.membre dans une procedure
PROCEDURE scenario_proc_enum_membre_cross()
	eEtat est un Statut
	eEtat = Statut.actif
	dbgVérifieEgalité(eEtat, Statut.actif, "procedure acces Statut.actif direct")
	
	eEtat = Statut.clos
	dbgVérifieEgalité(eEtat, Statut.clos, "procedure acces Statut.clos direct")
FIN
