// Classe cCompte qui consomme l'enum Statut declaree dans Statut.owl
cCompte est une Classe
PUBLIC
	eStatut est un Statut
	
	PROCEDURE Constructeur()
		// Acces Enum.membre cross-fichier : bug actuel (compile error)
		:eStatut = Statut.actif
	FIN
	
	PROCEDURE Geler()
		:eStatut = Statut.gele
	FIN
FIN
