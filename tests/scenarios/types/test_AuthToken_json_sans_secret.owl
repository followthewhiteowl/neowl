// @sujet : AuthToken — sérialisation JSON
// @résumé : La sérialisation JSON d'un AuthToken n'expose que les champs déclarés (jeton, validité, expiration, rafraîchissement, réponse serveur) et jamais l'état interne (paramètres d'origine, secret client, horodatage brut).


// Un AuthToken retient ses paramètres d'origine pour pouvoir se rafraîchir,
// dont le secret client. Cet état est interne : JSONSérialise ne doit émettre
// que les champs publics déclarés, jamais le secret ni les champs internes.
PROCEDURE scenario_json_n_expose_pas_le_secret()
	oParams est un OAuth2Paramètres
	oParams..ClientID     = "mon-client"
	oParams..ClientSecret = "secret-ne-doit-pas-fuiter"

	sJson est une chaîne                   = `{"access_token":"atk-123","expires_in":3600,"refresh_token":"rtk-987"}`
	t     est un AuthToken(oParams, sJson)

	sDump est une chaîne = JSONSérialise(t)

	dbgVérifieEgalité(Position(sDump, "secret-ne-doit-pas-fuiter"), 0, "le secret client ne fuite pas dans le JSON")
	dbgVérifieEgalité(Position(sDump, "_params"), 0, "le champ interne _params n'est pas sérialisé")
	dbgVérifieEgalité(Position(sDump, "_exp"), 0, "le champ interne _exp n'est pas sérialisé")
FIN


// Les champs déclarés du schéma restent bien présents, y compris ceux calculés
// à la volée (Valide via son getter).
PROCEDURE scenario_json_conserve_les_champs_declares()
	oParams est un OAuth2Paramètres
	sJson   est une chaîne                   = `{"access_token":"atk-456","expires_in":3600,"refresh_token":"rtk-1"}`
	t       est un AuthToken(oParams, sJson)

	sDump est une chaîne = JSONSérialise(t)

	dbgVérifieVrai(Position(sDump, "Valeur") > 0, "le jeton d'accès (champ déclaré Valeur) est présent")
	dbgVérifieVrai(Position(sDump, "Valide") > 0, "le champ calculé Valide est présent via son getter")
	dbgVérifieVrai(Position(sDump, "Actualisation") > 0, "le jeton de rafraîchissement (Actualisation) est présent")
FIN
