// @sujet : MLForêtAléatoire — digue e2e tabulaire (CSV -> forêt -> métrique)
// @résumé : Pipeline complet sur des données tabulaires brutes : une chaîne
// CSV convertie en Matrice via CSVVersMatrice, une MLForêtAléatoire entraînée
// à graine fixe, puis la qualité des prédictions mesurée par la métrique
// adaptée à l'objectif (Exactitude en classification, CoefficientDétermination
// en régression). Jeux synthétiques parfaitement séparables pour garder des
// assertions exactes malgré le bagging/tirage de variables interne.


// 8 échantillons à une variable, deux groupes bien séparés (1..4 vs
// 11..14) : chaque arbre de la forêt sépare totalement les deux classes
// quel que soit son tirage, exactitude 1.0 exacte sur les données
// d'entraînement.
PROCEDURE PUBLIQUE scenario_pipeline_csv_classification()
	csvX est une chaîne = "1.0" + CRLF + "2.0" + CRLF + "3.0" + CRLF + "4.0" + CRLF + "11.0" + CRLF + "12.0" + CRLF + "13.0" + CRLF + "14.0"
	matX est une Matrice = CSVVersMatrice(csvX, ";", Faux)

	csvY est une chaîne = "0.0" + CRLF + "0.0" + CRLF + "0.0" + CRLF + "0.0" + CRLF + "1.0" + CRLF + "1.0" + CRLF + "1.0" + CRLF + "1.0"
	matY est une Matrice = CSVVersMatrice(csvY, ";", Faux)
	y est un Tenseur = Tenseur(matY)

	foret est une MLForêtAléatoire
	foret..Objectif = objClassification
	foret..Graine   = 13
	foret.Entraîne(matX, y)

	preds est un Tenseur = foret.Prédit(matX)
	taux est un réel = Exactitude(preds, y)
	dbgVérifieEgalité(taux, 1.0, "deux clusters bien séparés (1-4 vs 11-14) : exactitude 1.0")
FIN


// 8 échantillons à une variable, cible en marche d'escalier (10 pour x<=4,
// 30 pour x>4). La forêt fait de la régression tabulaire de bout en bout et
// son R² d'ensemble est nettement bon. Seuil > 0.90 (et non ~1) : le bootstrap
// fait qu'une part des arbres rate la valeur frontière (x=4) et déplace son
// seuil, laissant un résidu STRUCTUREL sur les lignes frontière — irréductible
// pour une forêt bootstrap (mesuré ~0.96, ne converge PAS vers 1 avec plus
// d'arbres). On vérifie un R² clairement bon, pas parfait.
PROCEDURE PUBLIQUE scenario_pipeline_csv_regression()
	csvX est une chaîne = "1.0" + CRLF + "2.0" + CRLF + "3.0" + CRLF + "4.0" + CRLF + "5.0" + CRLF + "6.0" + CRLF + "7.0" + CRLF + "8.0"
	matX est une Matrice = CSVVersMatrice(csvX, ";", Faux)

	csvY est une chaîne = "10.0" + CRLF + "10.0" + CRLF + "10.0" + CRLF + "10.0" + CRLF + "30.0" + CRLF + "30.0" + CRLF + "30.0" + CRLF + "30.0"
	matY est une Matrice = CSVVersMatrice(csvY, ";", Faux)
	y est un Tenseur = Tenseur(matY)

	foret est une MLForêtAléatoire
	foret..Objectif = objRégression
	foret..Graine   = 13
	foret.Entraîne(matX, y)

	preds est un Tenseur = foret.Prédit(matX)
	r2 est un réel = CoefficientDétermination(preds, y)
	dbgVérifieVrai(r2 > 0.90, "régression tabulaire e2e : R² d'ensemble clairement bon (>0.90)")
FIN
