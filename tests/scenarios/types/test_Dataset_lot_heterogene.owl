// @sujet : Dataset — refus des lots d'images hétérogènes
// @résumé : .LotEntrées empile les images d'un lot dans un Tenseur B×C×H×W et
// exige que toutes les images du lot partagent les mêmes dimensions. Un lot
// homogène s'empile normalement ; un lot mélangeant des tailles différentes
// lève une exception attrapable qui pointe vers un redimensionnement explicite
// en amont, au lieu de déformer silencieusement les images.

// Cas nominal (sanity) : toutes les images du lot ont la même taille -> le
// Tenseur est produit sans erreur, avec la forme attendue.
PROCEDURE PUBLIQUE scenario_lot_homogene_reste_valide()
	racine est une chaîne = fRepTemp() + "\owl_test_1693_dataset_homogene"
	fRepCree(racine + "\chat")
	fRepCree(racine + "\chien")
	dSauveImagePNG(dCréeImage(4, 4, RVB(0, 255, 0)), racine + "\chat\c1.png")
	dSauveImagePNG(dCréeImage(4, 4, RVB(0, 255, 0)), racine + "\chat\c2.png")
	dSauveImagePNG(dCréeImage(4, 4, RVB(255, 255, 0)), racine + "\chien\d1.png")
	dSauveImagePNG(dCréeImage(4, 4, RVB(255, 255, 0)), racine + "\chien\d2.png")

	ds est un Dataset de ImageÉtiquetée = ChargeImagesÉtiquetéesDepuisDossier(racine)

	tX est un Tenseur = ds.LotEntrées(4, 1)
	dbgVérifieEgalité(tX..Rang, 4, "lot homogène -> Tenseur rang 4")
	dbgVérifieEgalité(tX..Forme[3], 4, "H = 4 px (dimensions communes)")
	dbgVérifieEgalité(tX..Forme[4], 4, "W = 4 px (dimensions communes)")

	fRepSupprime(racine, frRécursif)
FIN


// Cas limite : le lot contient une image dont les dimensions diffèrent de la
// première -> .LotEntrées lève une exception rattrapable (plus d'étirement
// silencieux). Le message cite les dimensions attendues et reçues.
PROCEDURE PRIVÉE scenario_edge_lot_heterogene_leve_exception()
	racine est une chaîne = fRepTemp() + "\owl_test_1693_dataset_heterogene"
	fRepCree(racine + "\classeA")
	// Première image du lot : 4×4. Seconde : 8×6 (dimensions différentes).
	dSauveImagePNG(dCréeImage(4, 4, RVB(0, 255, 0)), racine + "\classeA\a1.png")
	dSauveImagePNG(dCréeImage(8, 6, RVB(0, 0, 255)), racine + "\classeA\a2.png")

	ds est un Dataset de ImageÉtiquetée = ChargeImagesÉtiquetéesDepuisDossier(racine)
	dbgVérifieEgalité(ds..Taille, 2, "précondition : 2 exemples dans le lot")

	bLevée est un booléen = Faux
	sMessage est une chaîne = ""
	QUAND EXCEPTION DANS
		tX est un Tenseur = ds.LotEntrées(2, 1)
	FAIRE
		bLevée   = Vrai
		sMessage = ExceptionInfo(errMessage)
	FIN

	dbgVérifieVrai(bLevée, "un lot d'images hétérogènes lève une exception (pas d'étirement muet)")
	// dCréeImage(largeur, hauteur) -> la première est 4 large × 4 haut, la
	// seconde 8 large × 6 haut. Le message cite les dimensions HxL.
	dbgVérifieVrai(Position(sMessage, "4x4") > 0, "le message cite les dimensions attendues (4x4)")
	dbgVérifieVrai(Position(sMessage, "6x8") > 0, "le message cite les dimensions reçues (6x8)")

	fRepSupprime(racine, frRécursif)
FIN
