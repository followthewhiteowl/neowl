// @sujet : MLGradientBoosting — digue e2e tabulaire (CSV -> boosting -> métrique)
// @résumé : Pipeline complet sur des données tabulaires brutes : une chaîne
// CSV convertie en Matrice via CSVVersMatrice, un MLGradientBoosting entraîné
// (déterministe, pas de graine), puis la qualité des prédictions mesurée par
// la métrique adaptée à l'objectif (Exactitude en classification,
// CoefficientDétermination en régression). Jeux synthétiques séparables /
// tree-représentables pour garder des assertions exactes.


// 8 échantillons à une variable, deux groupes bien séparés (1..4 vs 11..14) :
// cible parfaitement tree-représentable, le boosting classe tout
// correctement dès les premières étapes -> exactitude 1.0 exacte.
PROCEDURE PUBLIQUE scenario_pipeline_csv_classification()
	csvX est une chaîne = "1.0" + CRLF + "2.0" + CRLF + "3.0" + CRLF + "4.0" + CRLF + "11.0" + CRLF + "12.0" + CRLF + "13.0" + CRLF + "14.0"
	matX est une Matrice = CSVVersMatrice(csvX, ";", Faux)

	csvY est une chaîne = "0.0" + CRLF + "0.0" + CRLF + "0.0" + CRLF + "0.0" + CRLF + "1.0" + CRLF + "1.0" + CRLF + "1.0" + CRLF + "1.0"
	matY est une Matrice = CSVVersMatrice(csvY, ";", Faux)
	y est un Tenseur = Tenseur(matY)

	gb est un MLGradientBoosting
	gb..Objectif = objClassification
	gb.Entraîne(matX, y)

	preds est un Tenseur = gb.Prédit(matX)
	taux est un réel = Exactitude(preds, y)
	dbgVérifieEgalité(taux, 1.0, "deux clusters bien séparés (1-4 vs 11-14) : exactitude 1.0")
FIN


// 8 échantillons à une variable, cible en marche d'escalier (10 pour x<=4,
// 30 pour x>4). Cible exactement tree-représentable, boosting déterministe :
// le R² d'ensemble converge très près de 1 après 100 étapes.
PROCEDURE PUBLIQUE scenario_pipeline_csv_regression()
	csvX est une chaîne = "1.0" + CRLF + "2.0" + CRLF + "3.0" + CRLF + "4.0" + CRLF + "5.0" + CRLF + "6.0" + CRLF + "7.0" + CRLF + "8.0"
	matX est une Matrice = CSVVersMatrice(csvX, ";", Faux)

	csvY est une chaîne = "10.0" + CRLF + "10.0" + CRLF + "10.0" + CRLF + "10.0" + CRLF + "30.0" + CRLF + "30.0" + CRLF + "30.0" + CRLF + "30.0"
	matY est une Matrice = CSVVersMatrice(csvY, ";", Faux)
	y est un Tenseur = Tenseur(matY)

	gb est un MLGradientBoosting
	gb..Objectif = objRégression
	gb.Entraîne(matX, y)

	preds est un Tenseur = gb.Prédit(matX)
	r2 est un réel = CoefficientDétermination(preds, y)
	dbgVérifieVrai(r2 > 0.99, "régression tabulaire e2e : boosting déterministe converge, R² > 0.99")
FIN
