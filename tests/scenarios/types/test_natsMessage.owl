// @sujet : natsMessage
// @résumé : Type composé décrivant un message NATS échangé sur un sujet (corps, sujet, adresse de réponse). Se passe à NATSPublie et reçu depuis NATSAbonne.


// Un message déclaré sans initialisation reçoit des propriétés par défaut
// prêtes à l'emploi : sujet vide, corps vide, aucune adresse de réponse.
PROCEDURE PUBLIQUE scenario_creation_avec_defauts()
	msg est un natsMessage
	dbgVérifieEgalité(msg..Sujet, "", "sujet vide par défaut")
	dbgVérifieEgalité(msg..Corps, "", "corps vide par défaut")
	dbgVérifieEgalité(msg..RépondreÀ, "", "adresse de réponse vide par défaut")
FIN


// Le databinding est direct : on assigne aux propriétés avec la notation
// `..`, on relit de la même façon.
PROCEDURE PUBLIQUE scenario_configuration_message()
	msg est un natsMessage
	msg..Sujet     = "owl.capteurs.salon"
	msg..Corps     = "temp=21.5"
	msg..RépondreÀ = "owl.capteurs.salon.reponse"

	dbgVérifieEgalité(msg..Sujet, "owl.capteurs.salon", "sujet relu tel quel")
	dbgVérifieEgalité(msg..Corps, "temp=21.5", "corps relu tel quel")
	dbgVérifieEgalité(msg..RépondreÀ, "owl.capteurs.salon.reponse", "adresse de réponse relue telle quelle")
FIN


// Formes bilingues : Sujet (FR) et Subject (EN) sont un seul et même champ.
PROCEDURE PUBLIQUE scenario_bilingue_sujet_subject()
	msg est un natsMessage
	msg..Sujet = "sujet-fr"
	dbgVérifieEgalité(msg..Subject, "sujet-fr", "Subject (EN) relit ce qu'écrit Sujet (FR)")

	msg..Subject = "sujet-en"
	dbgVérifieEgalité(msg..Sujet, "sujet-en", "Sujet (FR) relit ce qu'écrit Subject (EN)")
FIN


// Formes bilingues : Corps (FR) et Body (EN).
PROCEDURE PUBLIQUE scenario_bilingue_corps_body()
	msg est un natsMessage
	msg..Corps = "valeur-fr"
	dbgVérifieEgalité(msg..Body, "valeur-fr", "Body (EN) relit ce qu'écrit Corps (FR)")

	msg..Body = "valeur-en"
	dbgVérifieEgalité(msg..Corps, "valeur-en", "Corps (FR) relit ce qu'écrit Body (EN)")
FIN


// Formes bilingues : RépondreÀ (FR) et ReplyTo (EN).
PROCEDURE PUBLIQUE scenario_bilingue_repondrea_replyto()
	msg est un natsMessage
	msg..RépondreÀ = "inbox-fr"
	dbgVérifieEgalité(msg..ReplyTo, "inbox-fr", "ReplyTo (EN) relit ce qu'écrit RépondreÀ (FR)")

	msg..ReplyTo = "inbox-en"
	dbgVérifieEgalité(msg..RépondreÀ, "inbox-en", "RépondreÀ (FR) relit ce qu'écrit ReplyTo (EN)")
FIN

dbgBilanTest()
