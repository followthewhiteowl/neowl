// @sujet : amqpMessage
// @résumé : Type composé décrivant un message AMQP échangé avec un courtier (corps, persistance, propriétés riches). Se passe à AMQPPublie et reçu depuis AMQPConsomme.


// Un message déclaré sans initialisation reçoit des propriétés par défaut
// prêtes à l'emploi : non persistant, priorité neutre, aucune méta renseignée.
PROCEDURE PUBLIQUE scenario_creation_avec_defauts()
	msg est un amqpMessage
	dbgVérifieEgalité(msg..Corps, "", "corps vide par défaut")
	dbgVérifieEgalité(msg..CléRoutage, "", "clé de routage vide par défaut")
	dbgVérifieFaux(msg..Persistant, "non persistant par défaut")
	dbgVérifieEgalité(msg..TypeContenu, "", "type de contenu vide par défaut")
	dbgVérifieEgalité(msg..EncodageContenu, "", "encodage de contenu vide par défaut")
	dbgVérifieEgalité(msg..IdCorrélation, "", "identifiant de corrélation vide par défaut")
	dbgVérifieEgalité(msg..RépondreÀ, "", "répondre-à vide par défaut")
	dbgVérifieEgalité(msg..Priorité, 0, "priorité neutre par défaut")
	dbgVérifieEgalité(msg..Expiration, "", "expiration vide par défaut")
	dbgVérifieEgalité(msg..IdMessage, "", "identifiant de message vide par défaut")
	dbgVérifieEgalité(msg..Type, "", "type applicatif vide par défaut")
	dbgVérifieEgalité(msg..Identifiant, 0, "identifiant de livraison nul avant réception")
FIN


// Le databinding est direct : on assigne aux propriétés avec la notation
// `..`, on relit de la même façon.
PROCEDURE PUBLIQUE scenario_configuration_message()
	msg est un amqpMessage
	msg..Corps           = "bonjour"
	msg..Persistant      = Vrai
	msg..TypeContenu     = "application/json"
	msg..EncodageContenu = "utf-8"
	msg..IdCorrélation   = "corr-42"
	msg..RépondreÀ       = "file-retour"
	msg..Priorité        = 5
	msg..Expiration      = "60000"
	msg..IdMessage       = "msg-1"
	msg..Type            = "commande.creee"

	dbgVérifieEgalité(msg..Corps, "bonjour", "corps relu tel quel")
	dbgVérifieVrai(msg..Persistant, "persistance relue à Vrai")
	dbgVérifieEgalité(msg..TypeContenu, "application/json", "type de contenu relu")
	dbgVérifieEgalité(msg..EncodageContenu, "utf-8", "encodage de contenu relu")
	dbgVérifieEgalité(msg..IdCorrélation, "corr-42", "identifiant de corrélation relu")
	dbgVérifieEgalité(msg..RépondreÀ, "file-retour", "répondre-à relu")
	dbgVérifieEgalité(msg..Priorité, 5, "priorité relue")
	dbgVérifieEgalité(msg..Expiration, "60000", "expiration relue")
	dbgVérifieEgalité(msg..IdMessage, "msg-1", "identifiant de message relu")
	dbgVérifieEgalité(msg..Type, "commande.creee", "type applicatif relu")
FIN


// Formes bilingues : Persistant (FR) et Persistent (EN) sont un seul et même
// champ, quel que soit le nom utilisé pour écrire ou lire.
PROCEDURE PUBLIQUE scenario_bilingue_persistant_persistent()
	msg est un amqpMessage
	msg..Persistant = Vrai
	dbgVérifieVrai(msg..Persistent, "Persistent (EN) relit ce qu'écrit Persistant (FR)")

	msg..Persistent = Faux
	dbgVérifieFaux(msg..Persistant, "Persistant (FR) relit ce qu'écrit Persistent (EN)")
FIN


// Formes bilingues : IdCorrélation (FR) et CorrelationId (EN).
PROCEDURE PUBLIQUE scenario_bilingue_idcorrelation_correlationid()
	msg est un amqpMessage
	msg..IdCorrélation = "corr-fr"
	dbgVérifieEgalité(msg..CorrelationId, "corr-fr", "CorrelationId (EN) relit ce qu'écrit IdCorrélation (FR)")

	msg..CorrelationId = "corr-en"
	dbgVérifieEgalité(msg..IdCorrélation, "corr-en", "IdCorrélation (FR) relit ce qu'écrit CorrelationId (EN)")
FIN

dbgBilanTest()
