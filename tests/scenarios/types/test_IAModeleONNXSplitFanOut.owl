// @sujet : IAModèle.ChargeONNX / .LoadONNX — import d'un graphe non
// séquentiel : nœud `Split` (découpe en canaux) dont une sortie est
// consommée par PLUSIEURS nœuds (fan-out), motif du bloc C2f des
// détecteurs d'objets modernes.
// @résumé : le scénario central importe un petit réseau qui divise son
// entrée en deux moitiés de canaux, réutilise une des deux moitiés à la
// fois brute et transformée par une convolution, recombine le tout par
// concaténation, puis compare l'inférence à une sortie de référence
// capturée hors OWL (onnxruntime), à une tolérance flottante près.
//
// Fixture : tests/internal_fixtures/onnx/fixture_split_fanout.onnx —
// graphe Split, Conv, Concat, ReduceMean, Gemm (vérifié : le nœud Split
// existe bien, et sa deuxième sortie alimente à la fois le nœud Conv et
// le nœud Concat — fan-out réel à 2 consommateurs, pas une pseudo-branche
// linéaire). Entrée [1,4,8,8] (flat[k] = k/256.0), sortie [1,3].
// Oracle : tests/internal_fixtures/onnx/fixture_split_fanout_oracle.json.

PROCEDURE PUBLIQUE scenario_charge_onnx_split_fanout_infere_egale_oracle()
	mon est un IAModèle
	ErreurRAZ()
	mon.ChargeONNX("tests/internal_fixtures/onnx/fixture_split_fanout.onnx")
	// Capture immédiate : la RAZ-auto consomme la sentinelle d'erreur au 1er
	// appel natif suivant, lire ErreurDétectée avant tout autre appel
	// (cf. skill test-writing-pitfalls §6).
	bImportEchoue est un booléen = ErreurDétectée
	dbgVérifieVrai(PAS bImportEchoue, "l'import d'un réseau à Split fan-out (C2f) réussit")

	SI PAS bImportEchoue ALORS
		brut est un tableau de réels
		POUR k = 0 À 255
			brut.Ajoute(k / 256.0)
		FIN
		entrée est un Tenseur = Tenseur(brut).Redimensionne([1, 4, 8, 8])

		sortie est un Tenseur = mon.Infère(entrée)

		// Image unique (lot=1) : sortie rétrogradée en Tenseur 1D [classes]
		// (sémantique d'import ONNX). L'oracle onnxruntime [1,3] correspond aux
		// mêmes 3 valeurs lues ici comme un Vecteur.
		dbgVérifieEgalité(sortie..Rang, 1, "sortie image unique : Tenseur 1D [classes]")
		val est un Vecteur = sortie..Valeur

		attendu1 est un réel = -0.06850048899650574
		attendu2 est un réel = 0.0008913036435842514
		attendu3 est un réel = 0.010283103212714195

		dbgVérifieVrai(Abs(val[1] - attendu1) < 0.0001, "sortie[1] proche de l'oracle onnxruntime (Split fan-out)")
		dbgVérifieVrai(Abs(val[2] - attendu2) < 0.0001, "sortie[2] proche de l'oracle onnxruntime (Split fan-out)")
		dbgVérifieVrai(Abs(val[3] - attendu3) < 0.0001, "sortie[3] proche de l'oracle onnxruntime (Split fan-out)")
	SINON
		// Si l'exécuteur de graphe et l'op Split n'existent pas, le message
		// nomme l'opération ONNX non reconnue, pas une syntaxe cassée côté
		// test.
		sDétail est une chaîne = ErreurInfo(errMessage)
		dbgVérifieVrai(Contient(sDétail, "non supportee") OU Contient(sDétail, "non supportée"), "le détail nomme une opération ONNX non reconnue (Split)")
	FIN
FIN


// Verrou de la forme anglaise : .LoadONNX sur la même fixture produit le
// même comportement observable que .ChargeONNX.
PROCEDURE PUBLIQUE scenario_load_onnx_split_fanout_infer_equals_oracle()
	mon is an AIModel
	ErrorReset()
	mon.LoadONNX("tests/internal_fixtures/onnx/fixture_split_fanout.onnx")
	bImportFailed is a boolean = ErrorOccurred
	dbgCheckTrue(PAS bImportFailed, "importing a network with a Split fan-out (C2f) succeeds")

	SI PAS bImportFailed ALORS
		raw is an array of reals
		POUR k = 0 À 255
			raw.Ajoute(k / 256.0)
		FIN
		input is a Tensor = Tensor(raw).Redimensionne([1, 4, 8, 8])

		output is a Tensor = mon.Infer(input)

		dbgCheckEqual(output..Rank, 1, "single-image output: 1D Tensor [classes]")
		val is a Vector = output..Value

		expected1 is a real = -0.06850048899650574
		expected2 is a real = 0.0008913036435842514
		expected3 is a real = 0.010283103212714195

		dbgCheckTrue(Abs(val[1] - expected1) < 0.0001, "AIModel.LoadONNX, English form: output[1] within tolerance of the Split fan-out oracle")
		dbgCheckTrue(Abs(val[2] - expected2) < 0.0001, "AIModel.LoadONNX, English form: output[2] within tolerance of the Split fan-out oracle")
		dbgCheckTrue(Abs(val[3] - expected3) < 0.0001, "AIModel.LoadONNX, English form: output[3] within tolerance of the Split fan-out oracle")
	SINON
		sDetail is a string = ErrorInfo(errMessage)
		dbgCheckTrue(Contient(sDetail, "non supportee") OU Contient(sDetail, "non supportée"), "the detail names an unrecognized ONNX operation (Split)")
	FIN
FIN
