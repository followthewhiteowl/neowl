// @sujet : rechercheTableau
// @résumé : Enum des modes de recherche (mutuellement exclusifs) acceptés par le paramètre mode de Cherche et TableauCherche : tcLineaire et ses variantes de position (Premier/Suivant/Dernier/Precedent) plus tcDichotomique pour un tableau trié. Un seul mode par appel ; ce ne sont pas des bits combinables.


// Cas C : usage réel — recherche linéaire d'une valeur présente via TableauCherche.
PROCEDURE PUBLIQUE scenario_recherche_lineaire()
	t est un tableau de 4 entiers
	t[1] = 10
	t[2] = 20
	t[3] = 30
	t[4] = 40
	pos est un entier = TableauCherche(t, tcLineaire, 30)
	dbgVérifieEgalité(pos, 3, "30 est trouvé en position 3 (base 1)")
FIN


// Cas D : usage réel — recherche d'une valeur absente renvoie -1.
PROCEDURE PUBLIQUE scenario_recherche_absente()
	t est un tableau de 3 entiers
	t[1] = 10
	t[2] = 20
	t[3] = 30
	pos est un entier = TableauCherche(t, tcLineaire, 99)
	dbgVérifieEgalité(pos,-1, "valeur absente renvoie -1")
FIN
