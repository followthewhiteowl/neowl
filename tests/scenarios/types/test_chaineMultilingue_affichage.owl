// @sujet : chaîneMultilingue (affichage résolu)
// @résumé : Trace, Info et Erreur doivent résoudre la langue courante d'une
//           chaîneMultilingue (produire "Salut" en fr-FR), pas dumper le dict brut
//           {"fr-FR": Salut, "en-US": Hi}. Cohérence avec la coercion canonique.
//
// CONTRAT : ces scénarios VERROUILLENT le comportement d'affichage résolu
//           d'une chaîneMultilingue.
//
// Note testabilité : Trace() écrit sur stdout sans valeur de retour assertable.
//   La stratégie adoptée est l'assertion de COHÉRENCE : ce que Trace doit
//   afficher est exactement ce que `s est une chaîne = m` retourne. Si la coerce
//   est correcte (elle l'est déjà) et que object_print produit le même résultat,
//   les deux valent la même chose. Le scénario
//   vérifie donc la valeur que Trace doit produire via la coerce, et appelle Trace
//   pour confirmer qu'il ne crash pas.
//   Info et Erreur : silencés automatiquement en mode `owl test` (garde
//   testing_is_unitaire) — assertable pour non-crash, pas pour la valeur affichée.


// Cas canonique fr-FR : langue courante par défaut "fr-FR". Trace doit afficher
// "Salut", c'est-à-dire le même texte que la coerce canonique `s est une chaîne = m`.
// Trace ne doit pas afficher {"fr-FR": Salut, "en-US": Hi} — le dict brut.
PROCEDURE scenario_trace_resout_langue_courante_fr_fr()
	m est une chaîneMultilingue = {langueFrançais: "Salut", langueAnglais: "Hi"}

	// Coerce canonique : résout déjà correctement (référence stable).
	s est une chaîne = m
	dbgVérifieEgalité(s, "Salut", "coerce m → fr-FR retourne Salut")

	// Trace doit afficher la même valeur que la coerce.
	// La valeur attendue par Trace est celle produite par value_to_string,
	// qui est l'unique chemin d'affichage.
	Trace(m)
	dbgVérifieVrai(Vrai, "Trace(m) ne crash pas en fr-FR")
FIN


// Switch langue → en-US : après Langue(langueAnglais), la coerce résout "Hi".
// Trace doit résoudre identiquement, sans ignorer le switch langue ni dumper
// le dict brut.
PROCEDURE scenario_trace_resout_apres_switch_langue_en_us()
	m est une chaîneMultilingue = {langueFrançais: "Salut", langueAnglais: "Hi"}

	Langue(langueAnglais)

	s est une chaîne = m
	dbgVérifieEgalité(s, "Hi", "coerce m → en-US retourne Hi après switch")

	Trace(m)
	dbgVérifieVrai(Vrai, "Trace(m) ne crash pas en en-US")

	Langue(langueFrançais) // restore
FIN


// Cohérence Trace / coerce : les deux doivent produire le même texte.
// Ce scénario est la preuve formelle du contrat :
// object_print(OBJ_MULTILINGUE) doit déléguer à value_to_string (qui résout),
// pas au chemin de dump du dict.
PROCEDURE scenario_coherence_trace_et_coerce_fr_fr()
	m est une chaîneMultilingue = {langueFrançais: "Bonjour", langueAnglais: "Hello"}

	// Valeur attendue : langue courante fr-FR → "Bonjour"
	attendu est une chaîne = m
	dbgVérifieEgalité(attendu, "Bonjour", "référence coerce fr-FR = Bonjour")

	// Trace doit produire la même valeur. Non assertable directement sur stdout,
	// mais le contrat est : Trace(m) ≡ Trace(attendu).
	Trace(m)
	dbgVérifieVrai(Vrai, "Trace(m) s'exécute sans erreur")
FIN


// Cohérence Trace / coerce après switch langue :
// même assertion de cohérence que ci-dessus, en en-US.
PROCEDURE scenario_coherence_trace_et_coerce_en_us()
	m est une chaîneMultilingue = {langueFrançais: "Bonjour", langueAnglais: "Hello"}

	Langue(langueAnglais)

	attendu est une chaîne = m
	dbgVérifieEgalité(attendu, "Hello", "référence coerce en-US = Hello")

	Trace(m)
	dbgVérifieVrai(Vrai, "Trace(m) cohérent avec coerce en en-US")

	Langue(langueFrançais) // restore
FIN


// Fallback : langue courante absente du dict → retombe sur la langue source
// (fr-FR). Trace doit afficher "Seule traduction", pas dict brut ni vide.
PROCEDURE scenario_trace_fallback_langue_absente()
	m est une chaîneMultilingue = {langueFrançais: "Seule traduction"}

	Langue(langueAllemand)

	s est une chaîne = m
	dbgVérifieEgalité(s, "Seule traduction", "fallback langue source fr-FR si de-DE absent")

	Trace(m)
	dbgVérifieVrai(Vrai, "Trace(m) ne crash pas en fallback langue source")

	Langue(langueFrançais) // restore
FIN


// Fallback extrême : langue source absente → chaîne vide.
// Trace doit afficher "" (ou ligne vide), pas le dict brut.
PROCEDURE scenario_trace_fallback_langue_source_absente()
	m est une chaîneMultilingue
	m[langueAnglais] = "Hello only"
	// Pas de fr-FR posé

	s est une chaîne = m
	dbgVérifieEgalité(s, "", "source fr-FR absente → coerce retourne vide")

	Trace(m)
	dbgVérifieVrai(Vrai, "Trace(m) avec source absente ne crash pas")
FIN


// Info(m) : en mode test, le garde testing_is_unitaire() silence le dialog.
// Ce scénario verrouille : (1) pas de crash, (2) pas de dump dict brut.
// La valeur exacte affichée par Info n'est pas assertable headless — la
// correction de concat_messages (stdlib_ui.c:615-639) est vérifiée par l'impl.
// Le non-crash suffit pour verrouiller que le chemin Info(multilingue) compile
// et s'exécute.
PROCEDURE scenario_info_multilingue_ne_crash_pas()
	m est une chaîneMultilingue = {langueFrançais: "Succès", langueAnglais: "Success"}

	Info(m)
	dbgVérifieVrai(Vrai, "Info(m) ne crash pas (silence headless)")
FIN


// Erreur(m) : même logique que Info. Silence headless, pas assertable sur valeur.
// Verrouille le non-crash et le fait que concat_messages traite le multilingue.
PROCEDURE scenario_erreur_multilingue_ne_crash_pas()
	m est une chaîneMultilingue = {langueFrançais: "Échec", langueAnglais: "Failure"}

	Erreur(m)
	dbgVérifieVrai(Vrai, "Erreur(m) ne crash pas (silence headless)")
FIN


// ================================================================
// PROCÉDURES PRIVÉES (edge cases défensifs)
// ================================================================

// Trace avec chaîneMultilingue vide : doit afficher "" (chaîne vide), pas "{}".
PROCEDURE PRIVÉE scenario_trace_multilingue_vide()
	m est une chaîneMultilingue = {}

	s est une chaîne = m
	dbgVérifieEgalité(s, "", "coerce vide → chaîne vide")

	Trace(m)
	dbgVérifieVrai(Vrai, "Trace(m vide) ne crash pas")
FIN


// Trace après switch langue puis restore : les deux états produisent la bonne
// valeur via coerce. Vérifie que le resolve est bien dynamique (lit langue
// courante au moment de l'appel).
PROCEDURE PRIVÉE scenario_trace_dynamique_switch_restore()
	m est une chaîneMultilingue = {langueFrançais: "France", langueAnglais: "England"}

	s1 est une chaîne = m
	dbgVérifieEgalité(s1, "France", "coerce fr-FR avant switch")

	Langue(langueAnglais)
	s2 est une chaîne = m
	dbgVérifieEgalité(s2, "England", "coerce en-US après switch")

	Langue(langueFrançais)
	s3 est une chaîne = m
	dbgVérifieEgalité(s3, "France", "coerce fr-FR après restore")
FIN


// Trace d'une chaîneMultilingue à une seule traduction : Trace doit afficher
// cette unique traduction (pas "{ langueXxx: ... }").
PROCEDURE PRIVÉE scenario_trace_une_seule_traduction()
	m est une chaîneMultilingue = {langueFrançais: "Unique"}

	s est une chaîne = m
	dbgVérifieEgalité(s, "Unique", "une seule traduction → la retourne")

	Trace(m)
	dbgVérifieVrai(Vrai, "Trace(m une traduction) ne crash pas")
FIN
