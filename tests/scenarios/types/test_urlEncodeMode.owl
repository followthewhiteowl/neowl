// @sujet : urlEncodeMode
// @résumé : Enum des modes d'encodage (mutuellement exclusifs) accepté par le paramètre format de URLEncode : encodeURLDepuisUTF8 (défaut), encodeURLDepuisAnsi, encodeURLDepuisUnicode, encodeURLParamètre. Le mode défaut préserve les séparateurs d'URL ; le mode Paramètre encode tous les caractères réservés pour passer une URL en paramètre d'une autre URL.



// Cas C : usage réel — mode défaut préserve les séparateurs d'URL.
PROCEDURE PUBLIQUE scenario_mode_defaut()
	encodee est une chaîne = URLEncode("hello world", encodeURLDepuisUTF8)
	dbgVérifieEgalité(encodee, "hello%20world", "espace encodé, séparateurs préservés")
FIN


// Cas D : usage réel — mode Paramètre encode aussi les caractères réservés.
PROCEDURE PUBLIQUE scenario_mode_parametre()
	encodee est une chaîne = URLEncode("a=1&b=2", encodeURLParamètre)
	dbgVérifieEgalité(encodee, "a%3D1%26b%3D2", "= et & encodés en mode Paramètre")
FIN
