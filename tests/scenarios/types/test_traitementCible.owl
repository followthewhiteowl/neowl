// @sujet : traitementCible
// @résumé : Enum des cibles d'exécution (mutuellement exclusives) accepté par le paramètre trt de ExécuteTraitement : trtProcédure exécute la procédure désignée, trtProcédureProjet exécute la procédure désignée au niveau du projet.


// Procédure exercée par les scénarios ci-dessous.
PROCEDURE doublePar2(n est un entier)
	RENVOYER n * 2
FIN


// trtProcédure : ExécuteTraitement route vers la procédure locale désignée.
PROCEDURE PUBLIQUE scenario_trt_procedure()
	r est un entier = ExécuteTraitement("doublePar2", trtProcédure, 21)
	dbgVérifieEgalité(r, 42, "ExécuteTraitement avec trtProcédure exécute la procédure et renvoie 42")
FIN


// trtProcédureProjet : ExécuteTraitement route vers la procédure au niveau projet
// (même procédure locale dans ce contexte de test).
PROCEDURE PUBLIQUE scenario_trt_procedure_projet()
	r est un entier = ExécuteTraitement("doublePar2", trtProcédureProjet, 10)
	dbgVérifieEgalité(r, 20, "ExécuteTraitement avec trtProcédureProjet exécute la procédure et renvoie 20")
FIN
