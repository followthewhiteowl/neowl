//  : `:msg = {"tag": "valeur", ...}` — affectation à un membre de
// classe depuis une méthode (préfixe `:`), même trou de propagation.
Trace("=== fix/1340 : littéral multilingue en affectation membre de classe ===")

annonce est un cAnnonceMultilingue
annonce.InitMessage()

dbgVérifieEgalité(annonce.msg[langueFrançais], "Bienvenue", "membre de classe : fr-FR")
dbgVérifieEgalité(annonce.msg["en-GB"], "Welcome", "membre de classe : en-GB")

dbgBilanTest()
