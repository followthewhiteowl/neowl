//  : `tab[1] = {"tag": "valeur", ...}` — tableau simple indexé par
// entier, même défaut de propagation de type que le tableau associatif.
Trace("=== fix/1340 : littéral multilingue en affectation tableau simple ===")

messages est un tableau de 3 chaîneMultilingue

messages[1] = {"fr-FR": "Bonjour", "en-GB": "Hello"}
messages[2] = {"fr-FR": "Au revoir", "en-GB": "Goodbye"}

dbgVérifieEgalité(messages[1][langueFrançais], "Bonjour", "tableau simple : index 1, fr-FR")
dbgVérifieEgalité(messages[1]["en-GB"], "Hello", "tableau simple : index 1, en-GB")
dbgVérifieEgalité(messages[2][langueFrançais], "Au revoir", "tableau simple : index 2, fr-FR")

dbgBilanTest()
