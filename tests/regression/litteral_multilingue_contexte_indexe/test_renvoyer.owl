//  : `RENVOYER {"tag": "valeur", ...}` — retour direct d'un
// littéral colon-brace depuis une procédure typée chaîneMultilingue.
Trace("=== fix/1340 : littéral multilingue via RENVOYER ===")

PROCEDURE ConstruitMessage() : chaîneMultilingue
	RENVOYER {"fr-FR": "Traité", "en-GB": "Processed"}
FIN

m est une chaîneMultilingue = ConstruitMessage()

dbgVérifieEgalité(m[langueFrançais], "Traité", "RENVOYER : fr-FR")
dbgVérifieEgalité(m["en-GB"], "Processed", "RENVOYER : en-GB")

dbgBilanTest()
