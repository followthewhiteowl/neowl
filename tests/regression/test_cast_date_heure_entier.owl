// ================================================================
// test_cast_date_heure_entier.owl
// Couvre  : cast Date/Heure → entier aligné canon de référence
// - Date → entier : jours depuis 01/01/1800 (1-based)
// - Heure → entier : centièmes de seconde depuis 00:00:00:00
// - DateHeure → entier : rejet compile-time (pas de canon de référence univoque)
// ================================================================

PROCEDURE PUBLIQUE test_cast_date_entier()
	// ============================================================
	// GROUPE A — Cast Date → entier (jours depuis 01/01/1800)
	// ============================================================

	// A1 — Cast direct équivalent à DateVersEntier
	d1 est une date = "20260604"
	n1 est un entier = d1
	nCanon est un entier = DateVersEntier(d1)
	dbgVérifieVrai(n1 = nCanon, "cast Date → entier doit aligner DateVersEntier")
	dbgVérifieVrai(n1 = 82700, "20260604 → 82700 jours depuis 1800")

	// A2 — Epoch OWL : 01/01/1800 = 1 (1-based de référence)
	d2 est une date = "18000101"
	n2 est un entier = d2
	dbgVérifieVrai(n2 = 1, "01/01/1800 doit être 1 (1-based)")

	// A3 — 01/01/2000
	d3 est une date = "20000101"
	n3 est un entier = d3
	dbgVérifieVrai(n3 = 73049, "01/01/2000 → 73049 jours depuis 1800")

	// A4 — TypeVar du cast
	d4 est une date = "20260604"
	n4 est un entier = d4
	dbgVérifieVrai(TypeVar(n4) = 8, "TypeVar résultat doit être entier (code 8)")

	// A5 — Round-trip Date → entier → Date
	d5 est une date = "20260604"
	n5 est un entier = d5
	d6 est une date = EntierVersDate(n5)
	dbgVérifieVrai(d5 = d6, "round-trip Date → entier → Date doit préserver valeur")

FIN

PROCEDURE PUBLIQUE test_cast_heure_entier()
	// ============================================================
	// GROUPE B — Cast Heure → entier (centièmes depuis 00:00:00:00)
	// ============================================================

	// B1 — Cast direct équivalent à HeureVersEntier
	h1 est une heure = "143000"
	n1 est un entier = h1
	nCanon est un entier = HeureVersEntier(h1)
	dbgVérifieVrai(n1 = nCanon, "cast Heure → entier doit aligner HeureVersEntier")
	dbgVérifieVrai(n1 = 5220000, "14:30:00 → 5220000 centièmes")

	// B2 — Minuit = 0
	h2 est une heure = "000000"
	n2 est un entier = h2
	dbgVérifieVrai(n2 = 0, "00:00:00:00 doit être 0")

	// B3 — Midi
	h3 est une heure = "120000"
	n3 est un entier = h3
	dbgVérifieVrai(n3 = 4320000, "12:00:00:00 → 4320000 centièmes")

	// B4 — Max : 23:59:59:99
	h4 est une heure = "23595999"
	n4 est un entier = h4
	dbgVérifieVrai(n4 = 8639999, "23:59:59:99 → 8639999 centièmes")

	// B5 — TypeVar du cast
	h5 est une heure = "143000"
	n5 est un entier = h5
	dbgVérifieVrai(TypeVar(n5) = 8, "TypeVar résultat doit être entier (code 8)")

	// B6 — Round-trip Heure → entier → Heure
	h6 est une heure = "143000"
	n6 est un entier = h6
	h7 est une heure = EntierVersHeure(n6)
	dbgVérifieVrai(h6 = h7, "round-trip Heure → entier → Heure doit préserver valeur")

	// B7 — Heure avec centièmes
	h8 est une heure = "14300055" // 14:30:00:55
	n8 est un entier = h8
	dbgVérifieVrai(n8 = 5220055, "heure avec centièmes doit inclure centièmes")
FIN

PROCEDURE PUBLIQUE test_cast_date_heure_cas_limites()
	// ============================================================
	// GROUPE D — Cas limites
	// ============================================================

	// D1 — Date epoch min : 01/01/1800
	dMin est une date = "18000101"
	nMin est un entier = dMin
	dbgVérifieVrai(nMin = 1, "date min 1800 doit être 1")

	// D2 — Date loin dans le futur
	dFutur est une date = "30000101"
	nFutur est un entier = dFutur
	dbgVérifieVrai(TypeVar(nFutur) = 8, "TypeVar doit être entier (code 8)")
	// Note : nFutur devrait être > 82700 mais on ne teste pas arith pour éviter crash pre-fix

	// D3 — Heure epoch min : 00:00:00:00
	hMin est une heure = "000000"
	nHMin est un entier = hMin
	dbgVérifieVrai(nHMin = 0, "heure min doit être 0")

	// D4 — Heure max : 23:59:59:99
	hMax est une heure = "23595999"
	nHMax est un entier = hMax
	dbgVérifieVrai(nHMax = 8639999, "heure max doit être 8639999")

FIN

PROCEDURE PRIVÉE test_edge_cases_coerce_ambigus()
	// ============================================================
	// Edge cases proactifs (test_writer mandat actif)
	// ============================================================

	// E1 — Cast date passée avant epoch 1800 (si valide)
	// Note : pas de test ici car OWL n'a pas (encore) de dates avant 1800
	// dans le runtime. À couvrir si étendu.

	// E2 — Cast heure format court (HH, HHMM, HHMMSS)
	h2 est une heure = "1430" // format court 14:30
	n2 est un entier = h2
	dbgVérifieVrai(n2 = 5220000, "format court heure doit être casté correctement")

	// E3 — Cast répété sur même variable
	d3 est une date = "20260604"
	n3a est un entier = d3
	n3b est un entier = d3
	dbgVérifieVrai(n3a = n3b, "cast répété doit donner même résultat")

	// E4 — Cast dans affectation composée
	d4 est une date = "20260604"
	n4 est un entier = 0
	n4 = d4
	dbgVérifieVrai(n4 = 82700, "affectation composée doit caster correctement")

	// E5 — Cast en paramètre de fonction (coerce implicite)
	d5 est une date = "20260604"
	n5 est un entier = helper_cast_param(d5)
	dbgVérifieVrai(n5 = 82700, "cast en param fonction doit fonctionner")
FIN

FONCTION PRIVÉE helper_cast_param(n est un entier) : entier
	RENVOYER n
FIN

// Point d'entrée : exécuter tous les tests
test_cast_date_entier()
test_cast_heure_entier()
test_cast_date_heure_cas_limites()
test_edge_cases_coerce_ambigus()
Trace("[OK] fix/0287 : tous les tests cast Date/Heure → entier passent")
