// Regression: TableauCherche/Cherche doit retourner -1 si absent (spécification de référence)
// Avant le fix: retournait 0 sur "non trouvé"
t est un tableau de entiers
Ajoute(t, 10)
Ajoute(t, 20)
Ajoute(t, 30)

// Trouvé → indice base-1
dbgVérifieEgalité(Cherche(t, 20), 2, "cherche trouve")
dbgVérifieEgalité(TableauCherche(t, tcLineaire, 10), 1, "tabcherche trouve")

// Non trouvé → -1 (spécification de référence), pas 0
dbgVérifieEgalité(Cherche(t, 99),-1, "cherche absent retourne -1")
dbgVérifieEgalité(TableauCherche(t, tcLineaire, 99),-1, "tabcherche absent retourne -1")

// Traversal: tcLineairePremier / tcLineaireSuivant
t2 est un tableau de chaînes
Ajoute(t2, "a")
Ajoute(t2, "b")
Ajoute(t2, "a")
Ajoute(t2, "c")
Ajoute(t2, "a")
dbgVérifieEgalité(TableauCherche(t2, tcLineairePremier, "a"), 1, "premier 'a'")
dbgVérifieEgalité(TableauCherche(t2, tcLineaireSuivant, "a"), 3, "suivant 'a'")
dbgVérifieEgalité(TableauCherche(t2, tcLineaireSuivant, "a"), 5, "suivant 'a' bis")
dbgVérifieEgalité(TableauCherche(t2, tcLineaireSuivant, "a"),-1, "suivant 'a' epuise")

// tcLineaireDernier
dbgVérifieEgalité(TableauCherche(t2, tcLineaireDernier, "a"), 5, "dernier 'a'")

// tcDichotomique sur tableau trié
t3 est un tableau de entiers
Ajoute(t3, 1)
Ajoute(t3, 3)
Ajoute(t3, 5)
Ajoute(t3, 7)
Ajoute(t3, 9)
dbgVérifieEgalité(TableauCherche(t3, tcDichotomique, 5), 3, "dicho trouve")
dbgVérifieEgalité(TableauCherche(t3, tcDichotomique, 4),-1, "dicho absent")

// tcLineaire avec indice de départ
t4 est un tableau de entiers
Ajoute(t4, 5)
Ajoute(t4, 3)
Ajoute(t4, 5)
Ajoute(t4, 8)
dbgVérifieEgalité(TableauCherche(t4, tcLineaire, 5, 2), 3, "lineaire depuis 2")

dbgBilanTest()
