// Contrôle de non-régression pour test_type_bilingue_nom_en.owl : les mêmes
// types déclarés avec leur forme FR canon doivent continuer de compiler et de
// fonctionner, avant et après la correction de la résolution de type EN.
// Toujours vert.

v1 est un emailSessionSMTP
v1..AdresseServeur = "smtp.example.com"
v1..Port           = 587
dbgVérifieEgalité(v1..AdresseServeur, "smtp.example.com", "emailSessionSMTP (FR) : premier champ")
dbgVérifieEgalité(v1..Port, 587, "emailSessionSMTP (FR) : second champ")

v2 est un emailAttache
v2..Nom = "piece.pdf"
dbgVérifieEgalité(v2..Nom, "piece.pdf", "emailAttache (FR) : champ")

v3 est un emailEntête
v3..Nom    = "X-Test"
v3..Valeur = "123"
dbgVérifieEgalité(v3..Nom, "X-Test", "emailEntête (FR) : premier champ")
dbgVérifieEgalité(v3..Valeur, "123", "emailEntête (FR) : second champ")

v4 est un natsConnexion
v4..Adresse = "nats://localhost"
dbgVérifieEgalité(v4..Adresse, "nats://localhost", "natsConnexion (FR) : champ")

v5 est un FormatNombre
v5..SéparateurDécimal = ","
dbgVérifieEgalité(v5..SéparateurDécimal, ",", "FormatNombre (FR) : champ")

v6 est un FormatMonétaire
v6..Symbole = "€"
dbgVérifieEgalité(v6..Symbole, "€", "FormatMonétaire (FR) : champ")

dbgBilanTest()
