// Fichier au fin de ligne mélangée : une portion en CRLF, une portion en LF.
// Cas réaliste après un merge git ou un éditeur qui ne convertit pas tout.
// La valeur du littéral doit rester la même quelle que soit cette bigarrure.

txt est une chaîne = `ligne1
ligne2
ligne3`
dbgVérifieEgalité(Taille(txt), 20, "3 lignes EOL mélangées = 20 octets")
dbgVérifieEgalité(txt, "ligne1" + LF + "ligne2" + LF + "ligne3", "3 lignes EOL mélangées = concaténation attendue")

dbgBilanTest()
