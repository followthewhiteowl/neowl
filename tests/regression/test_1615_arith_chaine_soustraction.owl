//  : toute erreur runtime de niveau utilisateur doit être
// rattrapable par QUAND EXCEPTION. Isolé dans son propre fichier : voir
// test_1615_arith_tableau_plus_tableau.owl pour la justification de
// l'isolation (exit 70 tuerait les voisins).

// ROUGE tant que "chaîne - entier" n'est pas rattrapable.
PROCEDURE PUBLIQUE test_arith_chaine_soustraction_leve_exception()
	chn est une chaîne = "xyz"

	capturé est une chaîne = "init"
	QUAND EXCEPTION DANS
		r est un entier = chn - 1
		capturé = "no-throw"
	FAIRE
		capturé = "caught"
	FIN
	dbgVérifieEgalité(capturé, "caught", "chaîne - entier lève une exception récupérable")
FIN
