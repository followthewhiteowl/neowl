// Etat voisin — ressource pour les tests de portee des globales etat.
// Declare une globale gCode au top-level du bloc Etat.

ETAT_PorteeGlob est un Etat
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	gCode est un entier = 77

	corps est un Corps
		PROPRIETES
			Hauteur = 40
		FIN
	FIN
FIN
