// Ressource DSL pour test_widget_fr_noregression.owl.
//
// Non-regression : le DSL FR des widgets reste inchange apres impl
// de  (bilinguisme EN). Forme canonique FR sans accent.
//
// Statut : VERT maintenant ET apres impl.

FEN_WidgetFRNoregression est une Fenêtre
	PROPRIETES
		Titre       = "Non-regression FR"
		Largeur     = 400
		Hauteur     = 300
		Disposition = dispLibre
	FIN

	LBL_Texte est un Champ Libellé
		PROPRIETES
			Libellé = "Bonjour"
			X       = 10
			Y       = 10
			Largeur = 200
			Hauteur = 24
			Couleur = 0x000000
			Visible = Vrai
		FIN
	FIN

	BTN_Valider est un Champ Bouton
		PROPRIETES
			Libellé = "Valider"
			X       = 10
			Y       = 44
			Largeur = 80
			Hauteur = 30
		FIN

		PROCEDURE onClick()
			Trace("BTN_Valider clique")
		FIN
	FIN

	SAI_Saisie est un Champ Saisie
		PROPRIETES
			X       = 10
			Y       = 84
			Largeur = 200
			Hauteur = 30
		FIN
	FIN
FIN
