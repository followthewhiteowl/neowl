// Fenêtre voisine — ressource compile-only pour test_window_libelle_accent_prop.owl.
// Témoin : la prop `Libellé` (avec accent) doit être normalisée en `Libelle`
// (ASCII strippé) au compile, sinon le runtime ne la trouve pas et le widget
// Qt apparaît sans texte.

FEN_X est une Fenêtre
	PROPRIETES
		Titre       = "Test accents"
		Disposition = dispLibre
	FIN

	LBL_A est un Champ Libellé
		PROPRIETES
			Libellé = "Bonjour"
		FIN
	FIN

	BTN_OK est un Champ Bouton
		PROPRIETES
			Libellé         = "OK"
			TypeBouton      = btnValider
			ToucheRaccourci = "Alt+O"
		FIN

		PROCEDURE surClic()
			Trace(LBL_A)
		FIN
	FIN

	SAI_Nom est un Champ Saisie
		PROPRIETES
			Indication = "Votre nom"
		FIN
	FIN
FIN
