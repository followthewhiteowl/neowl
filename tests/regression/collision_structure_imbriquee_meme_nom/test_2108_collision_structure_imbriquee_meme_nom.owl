//  : verrou d'execution pour la structure voisine COL_Forme.owl.
// Deux Structures de la MEME CollectionDeProcédures ont chacune une
// Structure imbriquee de MEME nom (sPoint) avec des champs differents. Ce
// test prouve que chaque type niche garde ses propres champs et sa propre
// valeur, sans collision ni alias silencieux entre les deux.

c est un COL_Forme.stCercle
c.Origine.X = 3
c.Origine.Y = 4
c.Rayon = 5

r est un COL_Forme.stRectangle
r.Coin.Cx = 10
r.Coin.Cy = 20
r.Largeur = 7

dbgVérifieEgalité(c.Origine.X, 3, "sPoint de stCercle garde son champ x independant")
dbgVérifieEgalité(c.Origine.Y, 4, "sPoint de stCercle garde son champ y independant")
dbgVérifieEgalité(c.Rayon, 5, "champ scalaire de stCercle apres le type imbrique")
dbgVérifieEgalité(r.Coin.Cx, 10, "sPoint de stRectangle garde son champ cx independant (pas ecrase par stCercle)")
dbgVérifieEgalité(r.Coin.Cy, 20, "sPoint de stRectangle garde son champ cy independant (pas ecrase par stCercle)")
dbgVérifieEgalité(r.Largeur, 7, "champ scalaire de stRectangle apres le type imbrique")
dbgBilanTest()
