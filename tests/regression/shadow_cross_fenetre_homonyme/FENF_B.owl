//  — Fenetre B : controles homonymes avec FENF_A.owl (voisin).
// Meme noms LIB_Statut + BTN_Rejouer : c'est le cas legitime (deux fenetres
// independantes qui utilisent le meme identifiant pour leurs propres controles).
// Attendu : {"errors":[]} sur chacun des deux fichiers fenetre.

FENF_B est une Fenêtre
	PROPRIETES
		Titre       = "Fenetre B"
		Disposition = dispVerticale
		Largeur     = 300
		Hauteur     = 200
	FIN

	LIB_Statut est un Champ Libellé
		PROPRIETES
			Libellé = "statut B"
		FIN
	FIN

	PROCEDURE MAJ()
		LIB_Statut..Libellé = "maj B"
	FIN

	BTN_Rejouer est un Champ Bouton
		PROPRIETES
			Libellé = "Rejouer"
		FIN
	FIN
FIN
