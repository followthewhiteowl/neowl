// Fenetre voisine — ressource pour test_fen_voisin_non_ouvert.owl.
//
// Ce fichier ne doit PAS etre ouvert par le script test.
// __dbgNoteExecution("FEN_Dormant") au top-level : compte chaque execution.
// Apres  : sans Ouvre => compteur = 0.
// Avant fix (bug 648) : eager au boot => compteur = 1.

FEN_VoisinEndormi est une Fenêtre
	PROPRIETES
		Titre       = "VoisinEndormi"
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN

	__dbgNoteExecution("FEN_Dormant")

	PROCEDURE FinInitialisation()
	FIN
FIN
