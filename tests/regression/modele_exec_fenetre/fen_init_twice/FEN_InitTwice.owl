// Fenetre voisine — ressource pour test_fen_init_twice.owl.
//
// __dbgNoteExecution("FEN_Twice") au top-level : chaque execution reelle du
// top-level incremente le compteur.
// Apres  : 2 Ouvre => compteur = 2.
// Avant fix (bug 650) : eager au boot + 2 Ouvre = compteur = 3.

FEN_InitTwice est une Fenêtre
	PROPRIETES
		Titre       = "InitTwice"
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN

	__dbgNoteExecution("FEN_Twice")

	PROCEDURE FinInitialisation()
	FIN
FIN
