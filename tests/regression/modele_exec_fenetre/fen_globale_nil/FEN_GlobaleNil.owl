// Fenetre voisine — ressource pour test_fen_globale_nil_avant_ouvre.owl.
//
// FinInitialisation ecrit "initialise" dans LIB_Etat..Libelle.
// Le script voisin lit FEN_GlobaleNil.LIB_Etat..Libellé apres l'Ouvre.
// Attendu : "initialise" (top-level + FinInit ont execute le corps fenetre).
// Non-regression post- : ce test doit rester VERT.

FEN_GlobaleNil est une Fenêtre
	PROPRIETES
		Titre       = "GlobaleNil"
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN

	LIB_Etat est un Champ Libellé
		PROPRIETES
			X       = 10
			Y       = 10
			Libellé = "avant"
		FIN
	FIN

	PROCEDURE FinInitialisation()
		LIB_Etat..Libellé = "initialise"
	FIN
FIN
