// Fichier en LF, mais un octet CR isolé (0x0D, sans 0x0A qui suit) est
// incrusté au milieu du littéral -- résidu classique d une conversion
// de fin de ligne ratée. Il doit disparaitre comme n importe quel CR.

txt est une chaîne = `ligne1ligne2`
dbgVérifieEgalité(Taille(txt), 12, "CR isolé supprimé = 12 octets")
dbgVérifieEgalité(txt, "ligne1" + "ligne2", "CR isolé supprimé = ligne1 + ligne2 collés")

dbgBilanTest()
