// Ressource Etat pour le verrou d'accent-insensibilite des noms de blocs.
//
// Deux blocs Iteration nommes par l'utilisateur :
//   - "sep"         declare SANS accent, imprime AVEC accent  ("sép")
//   - "séparateur"  declare AVEC accent, imprime SANS accent  ("separateur")
//
// Les deux graphies doivent designer le meme bloc : declaration et recherche
// utilisent la meme regle de comparaison.

ETAT_BlocAccent est un Etat
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	corps est un Corps
		PROPRIETES
			Hauteur = 40
		FIN
	FIN

	sep est une Iteration
		PROPRIETES
			Hauteur = 10
		FIN

		LIB_Sep est un Champ Libelle
			PROPRIETES
				Libelle      = "---"
				X            = 20
				Y            = 2
				Largeur      = 100
				Hauteur      = 6
				PoliceNom    = iPoliceLiberationSans
				PoliceTaille = 9
			FIN
		FIN
	FIN

	séparateur est une Iteration
		PROPRIETES
			Hauteur = 10
		FIN

		LIB_Separateur est un Champ Libelle
			PROPRIETES
				Libelle      = "==="
				X            = 20
				Y            = 2
				Largeur      = 100
				Hauteur      = 6
				PoliceNom    = iPoliceLiberationSans
				PoliceTaille = 9
			FIN
		FIN
	FIN

	PROCEDURE Lecture()
		// Acces croise : graphie accentuee vers un nom declare sans accent,
		// et graphie nue vers un nom declare avec accent.
		callback_resultat_accent(iImprimeBloc("sép"))
		callback_resultat_nu(iImprimeBloc("separateur"))
	FIN
FIN
