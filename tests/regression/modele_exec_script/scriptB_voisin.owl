// Script voisin — ressource pour test_script_voisins.owl.
//
// Son top-level incremente gPassagesB. Le script-entree (test_script_voisins.owl)
// verifie que gPassagesB vaut 1 apres le boot (le voisin tourne 1x, pas 0x ni 2x).

gPassagesB est un entier = 0
gPassagesB += 1

gValeurB est une chaîne = "bonjour"

PROCEDURE ProcedureDeB()
	gValeurB = "appele"
FIN
