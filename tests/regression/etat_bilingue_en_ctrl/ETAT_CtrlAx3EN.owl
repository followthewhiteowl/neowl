// Jumeau EN de ETAT_CtrlAx3FR.owl — mêmes valeurs, formes anglaises des
// propriétés de contrôle WYSIWYG (X/Y/Width/Height/Caption/BackgroundColor).
// Doit produire exactement le même flux de contenu PDF que la version FR :
// géométrie du contrôle honorée à l'identique.

ETAT_CtrlAx3EN is a Report
	PROPERTIES
		Format      = formatA4
		Orientation = orientPortrait
	END

	corps is a Body
		PROPERTIES
			Height = 40
		END

		LIB_A is a Field Label
			PROPERTIES
				X               = 12
				Y               = 8
				Width           = 60
				Height          = 15
				Caption         = "Axe3"
				BackgroundColor = BleuClair
			END
		END
	END
END
