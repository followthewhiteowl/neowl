// Référence FR : un Libellé WYSIWYG positionné (X/Y/Largeur/Hauteur) avec
// CouleurFond dans un bloc Corps. Jumeau de ETAT_CtrlAx3EN.owl (formes EN).
// Les deux doivent produire un flux de contenu PDF identique.

ETAT_CtrlAx3FR est un État
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	corps est un Corps
		PROPRIETES
			Hauteur = 40
		FIN

		LIB_A est un Champ Libellé
			PROPRIETES
				X           = 12
				Y           = 8
				Largeur     = 60
				Hauteur     = 15
				Libellé     = "Axe3"
				CouleurFond = BleuClair
			FIN
		FIN
	FIN
FIN
