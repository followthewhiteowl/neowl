// Fenêtre voisine — ressource compile-only pour test_window_saisie_events.owl.
// Témoin : les blocs PROCEDURE Validation/Modification/Entree/Sortie sur Saisie
// sont acceptes par le parser. Aussi PROCEDURE Fermeture sur la fenetre.

FEN_Test est une Fenêtre
	PROPRIETES
		Titre       = "Test events"
		Largeur     = 400
		Hauteur     = 200
		Disposition = dispLibre
	FIN

	SAI_X est un Champ Saisie
		PROPRIETES
			Largeur = 300
		FIN

		PROCEDURE surValidation()
			Trace("Enter")
		FIN

		PROCEDURE surAChaqueModification()
			Trace("Texte change")
		FIN

		PROCEDURE surEntrée()
			Trace("Focus in")
		FIN

		PROCEDURE surSortie()
			Trace("Focus out")
		FIN
	FIN

	PROCEDURE Fermeture()
		Trace("Window closing")
	FIN
FIN
