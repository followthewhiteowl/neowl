// Mode TroisÉtats par option (INT_X[i]..TroisÉtats), lecture + écriture, et
// son effet sur l'écriture de -1 (indéterminé). La propriété par option
// n'existe pas encore : ce fichier ne compile pas aujourd'hui, rouge attendu
// (feature déclarée pas encore livrée).

TestModeHeadless(Vrai)

Ouvre(FEN_Interrupteur)

// --- Écriture + lecture du mode, indice littéral ---
INT_Perms[1]..TroisÉtats = Vrai
dbgVérifieVrai(INT_Perms[1]..TroisÉtats,
"mode TroisÉtats écrit puis relu Vrai, indice littéral")

// --- -1 accepté une fois TroisÉtats actif ---
INT_Perms[1] = -1
dbgVérifieEgalité(INT_Perms[1],-1,
"état indéterminé (-1) accepté et relu quand TroisÉtats est actif")

// --- Même chose, indice variable ---
i est un entier = 2
INT_Perms[i]..TroisÉtats = Vrai
dbgVérifieVrai(INT_Perms[i]..TroisÉtats,
"mode TroisÉtats écrit puis relu Vrai, indice variable")

INT_Perms[i] = -1
dbgVérifieEgalité(INT_Perms[i],-1,
"état indéterminé (-1) accepté et relu, indice variable")

Ferme(FEN_Interrupteur)

dbgBilanTest()
