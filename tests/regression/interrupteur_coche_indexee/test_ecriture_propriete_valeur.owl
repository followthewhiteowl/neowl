// Écriture de la coche d'une option d'Interrupteur via la forme propriété
// (INT_X[i]..Valeur = ...), équivalente canon de la forme nue. La propriété
// ..Valeur par option n'existe pas encore : ce fichier ne compile pas
// aujourd'hui, rouge attendu (feature déclarée pas encore livrée).

TestModeHeadless(Vrai)

Ouvre(FEN_Interrupteur)

// --- Écriture entière, indice littéral ---
INT_Perms[1]..Valeur = 1
dbgVérifieEgalité(INT_Perms[1]..Valeur, 1,
"écriture ..Valeur indice littéral, coche relue après écriture")

// --- Écriture entière, indice variable ---
k est un entier = 2
INT_Perms[k]..Valeur = 1
dbgVérifieEgalité(INT_Perms[k]..Valeur, 1,
"écriture ..Valeur indice variable, coche relue après écriture")

// --- Écriture booléenne ---
INT_Perms[1]..Valeur = Faux
dbgVérifieEgalité(INT_Perms[1]..Valeur, 0,
"écriture ..Valeur = Faux, coche relue à 0")

INT_Perms[1]..Valeur = Vrai
dbgVérifieEgalité(INT_Perms[1]..Valeur, 1,
"écriture ..Valeur = Vrai, coche relue à 1")

Ferme(FEN_Interrupteur)

dbgBilanTest()
