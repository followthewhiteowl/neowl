// Le Sélecteur (choix unique, valeur au niveau du champ) n'est PAS concerné
// par la coche indexée de l'Interrupteur : ses propriétés par option
// (Libellé / SousLibellé) restent intactes. Aucune valeur nue par option
// n'existe ni n'est testée sur le Sélecteur — ce n'est pas le canon de référence
// (hors-scope explicite).

TestModeHeadless(Vrai)

Ouvre(FEN_Interrupteur)

dbgVérifieEgalité(SEL_Mode[1]..Libellé, "Simple",
"Sélecteur, Libellé lu, indice littéral, inchangé")

SEL_Mode[1]..Libellé = "Basique"
dbgVérifieEgalité(SEL_Mode[1]..Libellé, "Basique",
"Sélecteur, Libellé écrit puis relu, indice littéral, inchangé")

i est un entier = 2
dbgVérifieEgalité(SEL_Mode[i]..SousLibellé, "Vue avancée",
"Sélecteur, SousLibellé lu, indice variable, inchangé")

Ferme(FEN_Interrupteur)

dbgBilanTest()
