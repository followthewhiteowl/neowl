// Équivalence canon : INT_X[n] (forme nue) ≡ INT_X[n]..Valeur (forme
// propriété). La propriété ..Valeur par option n'existe pas encore sur
// l'Interrupteur indexé : ce fichier ne compile pas aujourd'hui, c'est le
// rouge attendu (feature déclarée, pas encore livrée), pas une faute de
// syntaxe.

TestModeHeadless(Vrai)

Ouvre(FEN_Interrupteur)

INT_Perms..Valeur = 2 // coche uniquement l'option 2 (bit 1)

// --- Option cochée, indice littéral ---
dbgVérifieEgalité(INT_Perms[2], INT_Perms[2]..Valeur,
"option cochée, indice littéral, nu et ..Valeur rendent la même chose")

// --- Option décochée, indice littéral ---
dbgVérifieEgalité(INT_Perms[1], INT_Perms[1]..Valeur,
"option décochée, indice littéral, nu et ..Valeur rendent la même chose")

// --- Option cochée, indice variable ---
i est un entier = 2
dbgVérifieEgalité(INT_Perms[i], INT_Perms[i]..Valeur,
"option cochée, indice variable, nu et ..Valeur rendent la même chose")

Ferme(FEN_Interrupteur)

dbgBilanTest()
