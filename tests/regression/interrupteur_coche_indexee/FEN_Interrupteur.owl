// Ressource fenêtre — voisine des test_*.owl de ce dossier. Un Interrupteur à
// 3 options (mode 2 états par défaut) et un Sélecteur à 2 options, pour
// prouver que la manipulation de la coche par option de l'Interrupteur ne
// touche pas le Sélecteur.

FEN_Interrupteur est une Fenêtre
	PROPRIETES
		Titre       = "Coches indexées (Interrupteur)"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 300
	FIN

	INT_Perms est un Champ Interrupteur
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 240
			Options = [{Libellé = "Lecture", SousLibellé = "Voir"},{Libellé = "Écriture", SousLibellé = "Modifier"},{Libellé = "Suppression", SousLibellé = "Effacer"}]
		FIN
	FIN

	SEL_Mode est un Champ Sélecteur
		PROPRIETES
			X       = 10
			Y       = 130
			Largeur = 240
			Options = [{Libellé = "Simple", SousLibellé = "Vue simple"},{Libellé = "Avancé", SousLibellé = "Vue avancée"}]
		FIN
	FIN
FIN
