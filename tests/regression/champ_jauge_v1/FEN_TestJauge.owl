// Fenêtre voisine — ressource compile-only pour test_champ_jauge_v1.owl.
// Témoin DSL : syntaxe Champ Jauge, props (Valeur, BorneMin, BorneMax,
// Vertical, Symetrique, CouleurJauge, Couleur, CouleurFond, TexteJauge),
// variantes linéaire horizontale / verticale / symétrique.

FEN_TestJauge est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
	FIN

	// Jauge linéaire horizontale (défaut), affichage du pourcentage.
	JAU_Chargement est un Champ Jauge
		PROPRIETES
			X            = 10
			Y            = 10
			Largeur      = 240
			Hauteur      = 24
			BorneMin     = 0
			BorneMax     = 100
			Valeur       = 40
			CouleurJauge = 0xC08040
		FIN
	FIN

	// Jauge verticale avec texte personnalisé au lieu du pourcentage.
	JAU_Niveau est un Champ Jauge
		PROPRIETES
			X           = 270
			Y           = 10
			Largeur     = 24
			Hauteur     = 120
			Vertical    = Vrai
			BorneMin    = 0
			BorneMax    = 10
			Valeur      = 7
			TexteJauge  = "7 / 10"
			Couleur     = 0x000000
			CouleurFond = 0xF0F0F0
		FIN
	FIN

	// Jauge symétrique : progression depuis le centre (négatif/positif).
	JAU_Balance est un Champ Jauge
		PROPRIETES
			X          = 10
			Y          = 150
			Largeur    = 300
			Hauteur    = 24
			Symétrique = Vrai
			BorneMin   = -50
			BorneMax   = 50
			Valeur     = -20
		FIN
	FIN
FIN
