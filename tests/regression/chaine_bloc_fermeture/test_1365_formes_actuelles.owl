//  : formes de chaîne-bloc `[ … ]` déjà fonctionnelles.
// Verrou posé AVANT l'assouplissement de la condition de fermeture :
// ces cas doivent rester identiques après la modification du scanner.

sDecl est une chaîne = [
Ligne 1
Ligne 2
]
dbgVérifieEgalité(sDecl, "Ligne 1" + LF + "Ligne 2",
	"déclaration : bloc fermé par un ] seul sur sa ligne")

sDecl = [
Autre contenu
]
dbgVérifieEgalité(sDecl, "Autre contenu", "réaffectation d'une variable existante")

sConcat est une chaîne = "préfixe:" + [
milieu
]
dbgVérifieEgalité(sConcat, "préfixe:milieu", "concaténation après +")

PROCEDURE Modele1365() : chaîne
	RENVOYER [
ligne A
ligne B
]
FIN

dbgVérifieEgalité(Modele1365(), "ligne A" + LF + "ligne B", "bloc après RENVOYER")

// Le ] de fermeture accepte une indentation devant lui.
sIndente est une chaîne = [
contenu indenté
	]
dbgVérifieEgalité(sIndente, "contenu indenté", "] précédé d'espaces ferme le bloc")

// Un bloc vide reste une chaîne vide.
sVide est une chaîne = [
]
dbgVérifieEgalité(sVide, "", "bloc sans ligne de contenu")

dbgBilanTest()
