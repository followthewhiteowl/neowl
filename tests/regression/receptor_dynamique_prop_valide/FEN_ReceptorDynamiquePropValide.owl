// Fenêtre voisine — ressource pour test_receptor_dynamique_prop_valide.owl.
//
// Garde anti-régression  : une propriété VALIDE lue via un
// récepteur dynamique (MoiMême, MonChamp, MaFenêtre) doit continuer à
// compiler et à s'exécuter correctement une fois la validation par union
// ajoutée. Les valeurs lues sont remontées au script via callback.

FEN_ReceptorDynamiquePropValide est une Fenêtre
	PROPRIETES
		Titre       = "Titre fenêtre valide"
		Disposition = dispLibre
		Largeur     = 300
		Hauteur     = 200
	FIN

	LIB_Sonde est un Champ Libellé
		PROPRIETES
			Libellé = "Sonde"
			X       = 10
			Y       = 10
			Largeur = 150
			Hauteur = 30
		FIN
		PROCEDURE surClic()
			// Prop de champ valide sur récepteur MoiMême.
			resLibelleMoiMeme est une chaîne = MoiMême..Libellé
			// Prop universelle sur récepteur MoiMême.
			resNomMoiMeme est une chaîne = MoiMême..Nom
			// Prop universelle sur récepteur MonChamp.
			resNomMonChamp est une chaîne = MonChamp..Nom
			// Prop de Fenêtre valide sur récepteur MaFenêtre.
			resTitreMaFenetre est une chaîne = MaFenêtre..Titre

			callback_sonde(resLibelleMoiMeme, resNomMoiMeme, resNomMonChamp, resTitreMaFenetre)
		FIN
	FIN
FIN
