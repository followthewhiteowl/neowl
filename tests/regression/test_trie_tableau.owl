// Regression: Trie/TableauTrie avec constantes ttCroissant/ttDecroissant
// Avant le fix: arité=1, pas de constante, toujours croissant

t est un tableau = [3, 1, 4, 1, 5, 9, 2, 6]

// Tri croissant (défaut)
Trie(t)
dbgVérifieEgalité(t[1], 1, "croissant[1]")
dbgVérifieEgalité(t[8], 9, "croissant[8]")

// Tri décroissant
Trie(t, ttDecroissant)
dbgVérifieEgalité(t[1], 9, "decroissant[1]")
dbgVérifieEgalité(t[8], 1, "decroissant[8]")

// ttCroissant explicite
Trie(t, ttCroissant)
dbgVérifieEgalité(t[1], 1, "ttCroissant")

// Tri de chaînes
tc est un tableau = ["banane", "abricot", "cerise"]
Trie(tc)
dbgVérifieEgalité(tc[1], "abricot", "chaines croissant")
Trie(tc, ttDecroissant)
dbgVérifieEgalité(tc[1], "cerise", "chaines decroissant")

// tccSansCasse
tm est un tableau = ["Banane", "abricot", "Cerise"]
Trie(tm, ttCroissant + tccSansCasse)
dbgVérifieEgalité(tm[1], "abricot", "sans casse[1]")

// tccSansAccent
ta est un tableau = ["été", "arbre", "île"]
Trie(ta, ttCroissant + tccSansAccent)
dbgVérifieEgalité(ta[1], "arbre", "sans accent[1]")

// TableauTrie (alias)
t2 est un tableau = [5, 2, 8]
TableauTrie(t2, ttDecroissant)
dbgVérifieEgalité(t2[1], 8, "TableauTrie decroissant")

dbgBilanTest()
