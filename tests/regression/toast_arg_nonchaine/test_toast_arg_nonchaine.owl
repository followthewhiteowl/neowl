// Régression : ToastAffiche accepte coercition entier -> chaîne.
// 1er arg entier : compile valide, appel bien dispatché.

mockToast est un MockNative = MockCrée(ToastAffiche).Quand().Active()

ToastAffiche(42)
dbgVérifieVrai(MockVérifieAppelé(mockToast, 1), "1er arg entier : coercition valide, appel intercepté")

mockToast.Désactive()

dbgBilanTest()
