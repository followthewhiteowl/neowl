// @sujet : famille image - Groupe B opacité canon de référence (réel 0-100%)
// @resume : Tests régression opacité réel 0-100% pour dFusionne, dIncrusteCouleur, dModifieOpacité (à reworker)

// ══════════════════════════════════════════════════════════════════════════════
// SECTION PUBLIQUE — Groupe B (opacité réel 0-100%, canon de référence pas encore aligné)
// ══════════════════════════════════════════════════════════════════════════════

PROCEDURE PUBLIQUE scenario_dfusionne_opacite_100_defaut()
	imgDest est une Image = dCréeImage(10, 10, RVB(128, 128, 128))
	imgSrc est une Image = dCréeImage(10, 10, RVB(255, 0, 0))

	// dFusionne sans opacité explicite → défaut 100% (fusion complète)
	dFusionne(imgDest, imgSrc)

	c est une Couleur = dPixelCouleur(imgDest, 5, 5)
	dbgVérifieEgalité(c..Rouge, 255, "dFusionne opacite defaut - rouge complet R")
	dbgVérifieEgalité(c..Vert, 0, "dFusionne opacite defaut - rouge complet V")
	dbgVérifieEgalité(c..Bleu, 0, "dFusionne opacite defaut - rouge complet B")
FIN

PROCEDURE PUBLIQUE scenario_dfusionne_opacite_100_explicite()
	imgDest est une Image = dCréeImage(10, 10, RVB(128, 128, 128))
	imgSrc est une Image = dCréeImage(10, 10, RVB(0, 255, 0))

	// dFusionne avec opacité 100.0 (100%) → fusion complète
	dFusionne(imgDest, imgSrc, 100.0)

	c est une Couleur = dPixelCouleur(imgDest, 5, 5)
	dbgVérifieEgalité(c..Vert, 255, "dFusionne opacite 100 - vert complet")
FIN

PROCEDURE PUBLIQUE scenario_dfusionne_opacite_50_partielle()
	imgDest est une Image = dCréeImage(10, 10, RVB(255, 255, 255))
	imgSrc est une Image = dCréeImage(10, 10, RVB(255, 0, 0))

	// dFusionne avec opacité 50.0 (50%) → fusion partielle
	dFusionne(imgDest, imgSrc, 50.0)

	c est une Couleur = dPixelCouleur(imgDest, 5, 5)

	// Blanc + rouge à 50% → attendu magenta clair (R=255, V~127, B~127)
	dbgVérifieEgalité(c..Rouge, 255, "dFusionne opacite 50 - R reste 255")
	dbgVérifieVrai(c..Vert >= 120 ET c..Vert <= 135, "dFusionne opacite 50 - V blend ~127")
	dbgVérifieVrai(c..Bleu >= 120 ET c..Bleu <= 135, "dFusionne opacite 50 - B blend ~127")
FIN

PROCEDURE PUBLIQUE scenario_dfusionne_opacite_0_aucun_effet()
	imgDest est une Image = dCréeImage(10, 10, RVB(100, 100, 100))
	imgSrc est une Image = dCréeImage(10, 10, RVB(255, 0, 0))

	// dFusionne avec opacité 0.0 (0%) → aucun effet
	dFusionne(imgDest, imgSrc, 0.0)

	c est une Couleur = dPixelCouleur(imgDest, 5, 5)
	dbgVérifieEgalité(c..Rouge, 100, "dFusionne opacite 0 - pixel inchange R")
	dbgVérifieEgalité(c..Vert, 100, "dFusionne opacite 0 - pixel inchange V")
	dbgVérifieEgalité(c..Bleu, 100, "dFusionne opacite 0 - pixel inchange B")
FIN

PROCEDURE PUBLIQUE scenario_dincrustecouleur_opacite_100_defaut()
	img est une Image = dCréeImage(10, 10, RVB(255, 255, 255))

	// dIncrusteCouleur sans opacité explicite → défaut 100% (remplacement complet)
	dIncrusteCouleur(img, RVB(255, 0, 0))

	c est une Couleur = dPixelCouleur(img, 5, 5)
	dbgVérifieEgalité(c..Rouge, 255, "dIncrusteCouleur opacite defaut - rouge complet R")
	dbgVérifieEgalité(c..Vert, 0, "dIncrusteCouleur opacite defaut - rouge complet V")
	dbgVérifieEgalité(c..Bleu, 0, "dIncrusteCouleur opacite defaut - rouge complet B")
FIN

PROCEDURE PUBLIQUE scenario_dincrustecouleur_opacite_75_partielle()
	img est une Image = dCréeImage(10, 10, RVB(255, 255, 255))

	// dIncrusteCouleur avec opacité 75.0 (75%) → incrustation partielle
	dIncrusteCouleur(img, RVB(0, 255, 0), 75.0)

	c est une Couleur = dPixelCouleur(img, 5, 5)

	// Blanc + vert à 75% → attendu vert clair (R~63, V=255, B~63)
	dbgVérifieVrai(c..Rouge >= 50 ET c..Rouge <= 75, "dIncrusteCouleur opacite 75 - R blend ~63")
	dbgVérifieEgalité(c..Vert, 255, "dIncrusteCouleur opacite 75 - V reste 255")
	dbgVérifieVrai(c..Bleu >= 50 ET c..Bleu <= 75, "dIncrusteCouleur opacite 75 - B blend ~63")
FIN

PROCEDURE PUBLIQUE scenario_dincrustecouleur_opacite_0_aucun_effet()
	img est une Image = dCréeImage(10, 10, RVB(100, 100, 100))

	// dIncrusteCouleur avec opacité 0.0 (0%) → aucun effet
	dIncrusteCouleur(img, RVB(255, 0, 0), 0.0)

	c est une Couleur = dPixelCouleur(img, 5, 5)
	dbgVérifieEgalité(c..Rouge, 100, "dIncrusteCouleur opacite 0 - pixel inchange R")
	dbgVérifieEgalité(c..Vert, 100, "dIncrusteCouleur opacite 0 - pixel inchange V")
	dbgVérifieEgalité(c..Bleu, 100, "dIncrusteCouleur opacite 0 - pixel inchange B")
FIN

PROCEDURE PUBLIQUE scenario_dmodifieopacite_facteur_50()
	img est une Image = dCréeImage(10, 10, RVB(255, 0, 0))

	// dModifieOpacité avec facteur 50.0 (50%) → alpha multiplié par 0.5
	dModifieOpacité(img, 50.0)

	// Vérification : image reste structurellement valide
	dbgVérifieVrai(img..Hauteur = 10, "dModifieOpacite facteur 50 - hauteur conservee")
	dbgVérifieVrai(img..Largeur = 10, "dModifieOpacite facteur 50 - largeur conservee")
FIN

PROCEDURE PUBLIQUE scenario_dmodifieopacite_facteur_0()
	img est une Image = dCréeImage(10, 10, RVB(0, 255, 0))

	// dModifieOpacité avec facteur 0.0 (0%) → transparence totale
	dModifieOpacité(img, 0.0)

	dbgVérifieVrai(img..Hauteur = 10, "dModifieOpacite facteur 0 - hauteur conservee")
	dbgVérifieVrai(img..Largeur = 10, "dModifieOpacite facteur 0 - largeur conservee")
FIN

PROCEDURE PUBLIQUE scenario_dmodifieopacite_facteur_100()
	img est une Image = dCréeImage(10, 10, RVB(0, 0, 255))

	// dModifieOpacité avec facteur 100.0 (100%) → aucun effet (alpha × 1)
	dModifieOpacité(img, 100.0)

	c est une Couleur = dPixelCouleur(img, 5, 5)
	dbgVérifieEgalité(c..Bleu, 255, "dModifieOpacite facteur 100 - couleur inchangee")
FIN

// ══════════════════════════════════════════════════════════════════════════════
// SECTION PRIVEE — edge cases Groupe B
// ══════════════════════════════════════════════════════════════════════════════

PROCEDURE PRIVÉE scenario_dfusionne_opacite_33_decimal()
	imgDest est une Image = dCréeImage(10, 10, RVB(128, 128, 128))
	imgSrc est une Image = dCréeImage(10, 10, RVB(255, 0, 0))

	// dFusionne avec opacité décimale 33.33% → fusion partielle précise
	dFusionne(imgDest, imgSrc, 33.33)

	c est une Couleur = dPixelCouleur(imgDest, 5, 5)
	// Gris + rouge à 33% → attendu rouge dominant mais pas complet
	dbgVérifieVrai(c..Rouge > 128, "dFusionne opacite 33.33 - rouge augmente")
FIN

PROCEDURE PRIVÉE scenario_dincrustecouleur_opacite_1_minimal()
	img est une Image = dCréeImage(10, 10, RVB(255, 255, 255))

	// dIncrusteCouleur avec opacité 1.0 (1%) → incrustation minimale
	dIncrusteCouleur(img, RVB(0, 0, 0), 1.0)

	c est une Couleur = dPixelCouleur(img, 5, 5)
	// Blanc + noir à 1% → attendu quasi-blanc (légère teinte grise)
	dbgVérifieVrai(c..Rouge >= 250, "dIncrusteCouleur opacite 1 - quasi blanc R")
	dbgVérifieVrai(c..Vert >= 250, "dIncrusteCouleur opacite 1 - quasi blanc V")
	dbgVérifieVrai(c..Bleu >= 250, "dIncrusteCouleur opacite 1 - quasi blanc B")
FIN

PROCEDURE PRIVÉE scenario_dmodifieopacite_facteur_25()
	img est une Image = dCréeImage(10, 10, RVB(200, 200, 200))

	// dModifieOpacité avec facteur 25.0 (25%) → alpha multiplié par 0.25
	dModifieOpacité(img, 25.0)

	dbgVérifieVrai(img..Hauteur = 10, "dModifieOpacite facteur 25 - hauteur conservee")
FIN

PROCEDURE PRIVÉE scenario_dmodifieopacite_facteur_99_9()
	img est une Image = dCréeImage(10, 10, RVB(100, 100, 100))

	// dModifieOpacité avec facteur 99.9 (99.9%) → quasi-aucun effet
	dModifieOpacité(img, 99.9)

	c est une Couleur = dPixelCouleur(img, 5, 5)
	dbgVérifieEgalité(c..Rouge, 100, "dModifieOpacite facteur 99.9 - couleur quasi inchangee R")
	dbgVérifieEgalité(c..Vert, 100, "dModifieOpacite facteur 99.9 - couleur quasi inchangee V")
	dbgVérifieEgalité(c..Bleu, 100, "dModifieOpacite facteur 99.9 - couleur quasi inchangee B")
FIN
