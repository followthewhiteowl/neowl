// Une classe à vingt paramètres de constructeur compile ET s'exécute : les
// valeurs arrivent dans le bon ordre jusqu'à la dernière colonne.
o est un cLigneClient(4271, "Dupont", "Marie", "marie.dupont@exemple.fr", "0102030405", "12 rue des Lilas", "Bâtiment C", "69003", "Lyon", "France", "fr", "EUR", 15, 50000, 12500, "Grand compte", "N. Perrin", "2026-01-14", "2026-08-07", Vrai)

dbgVérifieEgalité(o.nIdentifiant, 4271,
"1526 : première colonne du constructeur à vingt paramètres")

dbgVérifieEgalité(o.sVille, "Lyon",
"1526 : neuvième colonne du constructeur à vingt paramètres")

dbgVérifieEgalité(o.sModifieLe, "2026-08-07",
"1526 : dix-neuvième colonne du constructeur à vingt paramètres")

dbgVérifieVrai(o.bActif,
"1526 : vingtième et dernière colonne du constructeur")

dbgVérifieEgalité(o.Disponible(), 37500,
"1526 : la méthode utilise deux colonnes reçues par le constructeur")

dbgBilanTest()
