// Cas réaliste : une classe décrivant une ligne de table à vingt colonnes.
// Le constructeur porte une valeur par colonne — c'est la forme produite par
// la génération de code à partir d'un schéma de base de données.
cLigneClient est une Classe
PUBLIC
	nIdentifiant est un entier
	sNom est une chaîne
	sPrenom est une chaîne
	sEmail est une chaîne
	sTelephone est une chaîne
	sAdresse est une chaîne
	sComplement est une chaîne
	sCodePostal est une chaîne
	sVille est une chaîne
	sPays est une chaîne
	sLangue est une chaîne
	sDevise est une chaîne
	nRemise est un entier
	nPlafond est un entier
	nEncours est un entier
	sCategorie est une chaîne
	sCommercial est une chaîne
	sCreeLe est une chaîne
	sModifieLe est une chaîne
	bActif est un booléen

	PROCEDURE Constructeur(identifiant est un entier, nom est une chaîne, prenom est une chaîne, email est une chaîne, telephone est une chaîne, adresse est une chaîne, complement est une chaîne, codePostal est une chaîne, ville est une chaîne, pays est une chaîne, langue est une chaîne, devise est une chaîne, remise est un entier, plafond est un entier, encours est un entier, categorie est une chaîne, commercial est une chaîne, creeLe est une chaîne, modifieLe est une chaîne, actif est un booléen)
		:nIdentifiant = identifiant
		:sNom = nom
		:sPrenom = prenom
		:sEmail = email
		:sTelephone = telephone
		:sAdresse = adresse
		:sComplement = complement
		:sCodePostal = codePostal
		:sVille = ville
		:sPays = pays
		:sLangue = langue
		:sDevise = devise
		:nRemise = remise
		:nPlafond = plafond
		:nEncours = encours
		:sCategorie = categorie
		:sCommercial = commercial
		:sCreeLe = creeLe
		:sModifieLe = modifieLe
		:bActif = actif
	FIN

	PROCEDURE Disponible() : entier
		RENVOYER :nPlafond - :nEncours
	FIN
FIN
