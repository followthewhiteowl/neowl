// Regression  : un grand SELON (code généré type workflow converti)
// où chaque branche se termine par SORTIR SELON ne doit plus buter sur la
// limite de breaks/continues. 100 branches, chacune avec un SORTIR SELON :
// la liste de breaks du SELON doit absorber bien au-delà de l'ancien plafond.
// Noms de globales suffixés _mb2437 : l'autodiscovery compile tout le dossier
// dans un même espace global (cf. collisions cross-fichier).

PROCEDURE dispatche_mb2437(n est un entier)
	res est un entier = 0
	SELON n
	CAS 1: res = 10 ; SORTIR SELON
	CAS 2: res = 20 ; SORTIR SELON
	CAS 3: res = 30 ; SORTIR SELON
	CAS 4: res = 40 ; SORTIR SELON
	CAS 5: res = 50 ; SORTIR SELON
	CAS 6: res = 60 ; SORTIR SELON
	CAS 7: res = 70 ; SORTIR SELON
	CAS 8: res = 80 ; SORTIR SELON
	CAS 9: res = 90 ; SORTIR SELON
	CAS 10: res = 100 ; SORTIR SELON
	CAS 11: res = 110 ; SORTIR SELON
	CAS 12: res = 120 ; SORTIR SELON
	CAS 13: res = 130 ; SORTIR SELON
	CAS 14: res = 140 ; SORTIR SELON
	CAS 15: res = 150 ; SORTIR SELON
	CAS 16: res = 160 ; SORTIR SELON
	CAS 17: res = 170 ; SORTIR SELON
	CAS 18: res = 180 ; SORTIR SELON
	CAS 19: res = 190 ; SORTIR SELON
