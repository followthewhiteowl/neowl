	SI i = 45 ALORS CONTINUER
	SI i = 46 ALORS CONTINUER
	SI i = 47 ALORS CONTINUER
	SI i = 48 ALORS CONTINUER
	SI i = 49 ALORS CONTINUER
	SI i = 50 ALORS CONTINUER
	SI i = 51 ALORS CONTINUER
	SI i = 52 ALORS CONTINUER
	SI i = 53 ALORS CONTINUER
	SI i = 54 ALORS CONTINUER
	SI i = 55 ALORS CONTINUER
	SI i = 56 ALORS CONTINUER
	SI i = 57 ALORS CONTINUER
	SI i = 58 ALORS CONTINUER
	SI i = 59 ALORS CONTINUER
