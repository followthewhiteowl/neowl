	CAS 83: res = 830 ; SORTIR SELON
	CAS 84: res = 840 ; SORTIR SELON
	CAS 85: res = 850 ; SORTIR SELON
	CAS 86: res = 860 ; SORTIR SELON
	CAS 87: res = 870 ; SORTIR SELON
	CAS 88: res = 880 ; SORTIR SELON
	CAS 89: res = 890 ; SORTIR SELON
	CAS 90: res = 900 ; SORTIR SELON
	CAS 91: res = 910 ; SORTIR SELON
