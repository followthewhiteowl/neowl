	CAS 76: res = 760 ; SORTIR SELON
	CAS 77: res = 770 ; SORTIR SELON
	CAS 78: res = 780 ; SORTIR SELON
	CAS 79: res = 790 ; SORTIR SELON
	CAS 80: res = 800 ; SORTIR SELON
