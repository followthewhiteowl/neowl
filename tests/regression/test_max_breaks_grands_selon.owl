	CAS 53: res = 530 ; SORTIR SELON
	CAS 54: res = 540 ; SORTIR SELON
	CAS 55: res = 550 ; SORTIR SELON
	CAS 56: res = 560 ; SORTIR SELON
	CAS 57: res = 570 ; SORTIR SELON
	CAS 58: res = 580 ; SORTIR SELON
	CAS 59: res = 590 ; SORTIR SELON
	CAS 60: res = 600 ; SORTIR SELON
	CAS 61: res = 610 ; SORTIR SELON
	CAS 62: res = 620 ; SORTIR SELON
	CAS 63: res = 630 ; SORTIR SELON
	CAS 64: res = 640 ; SORTIR SELON
	CAS 65: res = 650 ; SORTIR SELON
	CAS 66: res = 660 ; SORTIR SELON
	CAS 67: res = 670 ; SORTIR SELON
	CAS 68: res = 680 ; SORTIR SELON
