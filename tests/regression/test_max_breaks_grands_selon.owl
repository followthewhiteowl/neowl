	CAS 99: res = 990 ; SORTIR SELON
	CAS 100: res = 1000 ; SORTIR SELON
	AUTRE CAS: res = -1
	FIN
	RENVOYER res
FIN

dbgVérifieEgalité(dispatche_mb2437(1), 10, "première branche d'un SELON à 100 cas")
dbgVérifieEgalité(dispatche_mb2437(37), 370, "branche médiane")
dbgVérifieEgalité(dispatche_mb2437(100), 1000, "dernière branche, au-delà de l'ancien plafond")
dbgVérifieEgalité(dispatche_mb2437(101), -1, "valeur hors cas -> branche AUTRE")

// Croissance de la liste des CONTINUER d'une même boucle : 70 instructions
// CONTINUER distinctes dépassent l'ancien plafond de 64 (forme courte SI, sans FIN).
compteur_mb2437 est un entier = 0
POUR i = 1 À 100
	SI i = 1 ALORS CONTINUER
	SI i = 2 ALORS CONTINUER
	SI i = 3 ALORS CONTINUER
	SI i = 4 ALORS CONTINUER
	SI i = 5 ALORS CONTINUER
	SI i = 6 ALORS CONTINUER
