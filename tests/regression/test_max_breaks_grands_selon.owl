	SI i = 61 ALORS CONTINUER
	SI i = 62 ALORS CONTINUER
	SI i = 63 ALORS CONTINUER
	SI i = 64 ALORS CONTINUER
	SI i = 65 ALORS CONTINUER
	SI i = 66 ALORS CONTINUER
	SI i = 67 ALORS CONTINUER
	SI i = 68 ALORS CONTINUER
	SI i = 69 ALORS CONTINUER
	SI i = 70 ALORS CONTINUER
	compteur_mb2437 = compteur_mb2437 + 1
FIN
dbgVérifieEgalité(compteur_mb2437, 30, "70 CONTINUER dans une boucle : seuls i=71..100 atteignent le bas")

// Croissance de la liste des SORTIR (break de boucle) : une boucle dont le
// corps contient 80 SORTIR distincts (un seul s'exécute selon la valeur).
dernier_mb2437 est un entier = -1
POUR i = 1 À 100
	SELON i
	CAS 1: dernier_mb2437 = 1 ; SORTIR
	CAS 2: dernier_mb2437 = 2 ; SORTIR
	CAS 3: dernier_mb2437 = 3 ; SORTIR
	CAS 4: dernier_mb2437 = 4 ; SORTIR
