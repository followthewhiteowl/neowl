//  — en mode projet, ProjetInfo(piNomProjet) restitue l'identifiant
// du bloc `est un Projet` de la frontière courante (MonAppProjetInfo).

// Forme explicite : la constante de type d'info demande le nom du projet.
dbgVérifieEgalité(ProjetInfo(piNomProjet), "MonAppProjetInfo", "ProjetInfo(piNomProjet) renvoie le nom du projet")

// Sans argument : le défaut est piNomProjet, même résultat.
dbgVérifieEgalité(ProjetInfo(), "MonAppProjetInfo", "ProjetInfo() sans argument = nom du projet (défaut piNomProjet)")

// Forme anglaise de la native et de la constante : mêmes valeurs (bilingue).
dbgVérifieEgalité(ProjectInfo(piProjectName), "MonAppProjetInfo", "ProjectInfo(piProjectName) = nom du projet")

// Casse et accent-insensibilité au runtime (invariants 1 & 2).
dbgVérifieEgalité(projetinfo(pinomprojet), "MonAppProjetInfo", "casse-insensible : projetinfo(pinomprojet)")

dbgBilanTest()
