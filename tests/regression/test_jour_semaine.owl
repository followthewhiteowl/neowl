// Regression: DateVersJourDeLaSemaine convention de référence = 1:Lundi ... 7:Dimanche (ISO européen)
// Bug initial: convention incorrecte 1=Dimanche (américaine) au lieu de 1=Lundi (référence/ISO)

// 2024-01-07 = Dimanche → doit retourner 7
d est une date = "20240107"
dbgVérifieEgalité(DateVersJourDeLaSemaine(d), 7, "dimanche=7")

// 2024-01-01 = Lundi → doit retourner 1
d2 est une date = "20240101"
dbgVérifieEgalité(DateVersJourDeLaSemaine(d2), 1, "lundi=1")

// 2024-01-02 = Mardi → 2
d3 est une date = "20240102"
dbgVérifieEgalité(DateVersJourDeLaSemaine(d3), 2, "mardi=2")

// 2024-01-06 = Samedi → 6
d4 est une date = "20240106"
dbgVérifieEgalité(DateVersJourDeLaSemaine(d4), 6, "samedi=6")

// Alias DateVersJour cohérent
dbgVérifieEgalité(DateVersJour(d), 7, "DateVersJour alias dimanche=7")

// JourDeLaSemaine = alias extension OWL (même résultat)
dbgVérifieEgalité(JourDeLaSemaine(d2), 1, "JourDeLaSemaine lundi=1")

dbgBilanTest()
