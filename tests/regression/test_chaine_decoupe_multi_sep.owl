// Régression : ChaîneDécoupe forme 2 (plusieurs séparateurs séquentiels).
// spécification de référence : ChaîneDécoupe(s, sep1, sep2, ..., sepN) coupe au 1er occurrence
// de sep1, puis dans ce qui reste au 1er de sep2, etc.

// ── Cas basique : 2 séparateurs ────────────────────────────────
sMenu est une chaîne = "Entrée Plat du jour, Dessert"
t1 est un tableau de chaînes = ChaîneDécoupe(sMenu, " ", ", ")
dbgVérifieEgalité(t1..Occurrence, 3, "3 segments")
dbgVérifieEgalité(t1[1], "Entrée", "pos 1 (avant 1er sep)")
dbgVérifieEgalité(t1[2], "Plat du jour", "pos 2 (entre sep1 et sep2)")
dbgVérifieEgalité(t1[3], "Dessert", "pos 3 (après 2e sep)")

// ── 3 séparateurs différents ───────────────────────────────────
sData est une chaîne = "A|B,C;D"
t2 est un tableau de chaînes = ChaîneDécoupe(sData, "|", ",", ";")
dbgVérifieEgalité(t2..Occurrence, 4, "4 segments")
dbgVérifieEgalité(t2[1], "A", "A")
dbgVérifieEgalité(t2[2], "B", "B")
dbgVérifieEgalité(t2[3], "C", "C")
dbgVérifieEgalité(t2[4], "D", "D")

// ── Forme 1 (compatibilité) : 1 séparateur → split global ──────
sCSV est une chaîne = "a,b,c,d"
t3 est un tableau de chaînes = ChaîneDécoupe(sCSV, ",")
dbgVérifieEgalité(t3..Occurrence, 4, "forme 1 : split global")
dbgVérifieEgalité(t3[4], "d", "dernier élément")

dbgBilanTest()
