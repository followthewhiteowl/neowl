// Regression : valide l'invariant n°3 (bilingue FR<->EN) sur les fields
// du type pdfParametre (5 fields honores par le moteur PDF).

pdf est un pdfParamètre

// MotDePasseModification <-> ModificationPassword
pdf..ModificationPassword = "owner-pwd"
dbgVérifieEgalité(pdf..MotDePasseModification, "owner-pwd", "ModificationPassword -> MotDePasseModification")

// MotDePasseOuverture <-> OpenPassword
pdf..OpenPassword = "user-pwd"
dbgVérifieEgalité(pdf..MotDePasseOuverture, "user-pwd", "OpenPassword -> MotDePasseOuverture")

// Protection identique
pdf..Protection = iProtectionImpression
dbgVérifieEgalité(pdf..Protection, iProtectionImpression, "Protection identique")

// Signet <-> Bookmark
pdf..Bookmark = Vrai
dbgVérifieEgalité(pdf..Signet, Vrai, "Bookmark -> Signet")

// Unicode identique
pdf..Unicode = Faux
dbgVérifieEgalité(pdf..Unicode, Faux, "Unicode identique")

dbgBilanTest()
