// Classe support  : methodes inline avec parametre LOCAL.
// LOCAL force une copie profonde du parametre : la mutation dans le corps
// de la methode ne doit pas remonter a l'appelant.
cMuteur1938 est une Classe
PUBLIC
	// Parametre LOCAL : la mutation reste locale a la methode.
	PROCEDURE MuteAvecLocal(LOCAL t est un tableau de entiers)
		t[1] = 999
	FIN

	// Sans LOCAL : contraste, la mutation est partagee avec l'appelant.
	PROCEDURE MuteSansLocal(t est un tableau de entiers)
		t[1] = 999
	FIN

	// Mix LOCAL / non-LOCAL + valeurs par defaut.
	PROCEDURE MuteMixte(LOCAL t est un tableau de entiers, nFacteur est un entier = 10, bOption est un booléen = Vrai)
		t[1] = nFacteur
	FIN
FIN
