// Voisin de test_bug_procedure_global_forme_en.owl : non-regression
// section membre statique GLOBAL (bloc de champs partages en tete de classe —
// role different d'un modificateur de methode, ne doit pas changer).
cCompteur1964 est une Classe
	GLOBAL
	nInstances est un entier = 0

PUBLIC
	PROCEDURE Constructeur()
		cCompteur1964.nInstances += 1
	FIN

	PROCEDURE GLOBALE NbInstances() : entier
		RENVOYER cCompteur1964.nInstances
	FIN
FIN
