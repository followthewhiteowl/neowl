//  : toute erreur runtime de niveau utilisateur doit être
// rattrapable par QUAND EXCEPTION. Isolé dans son propre fichier : voir
// test_1615_arith_tableau_plus_tableau.owl pour la justification de
// l'isolation (exit 70 tuerait les voisins).

// ROUGE tant que "entier.faitTruc()" n'est pas rattrapable.
PROCEDURE PUBLIQUE test_appel_methode_sur_non_instance_leve_exception()
	n est un entier = 5

	capturé est une chaîne = "init"
	QUAND EXCEPTION DANS
		n.faitTruc()
		capturé = "no-throw"
	FAIRE
		capturé = "caught"
	FIN
	dbgVérifieEgalité(capturé, "caught", "appel de méthode sur un entier lève une exception récupérable")
FIN
