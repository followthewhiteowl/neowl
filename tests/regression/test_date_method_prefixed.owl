// Regression: DateVers<X> functions must also be accessible as d.VersX() methods
// Bug initial: d.VersJourDeLaSemaine() et variantes n'apparaissaient pas en autocompletion
// car non enregistrées via owl_register_method() — seulement dans DEFS (globales)

d est une date = "20260416" // 16 avril 2026 = jeudi = 4 (référence : 1=Lun, 7=Dim)

// Toutes les formes méthode de DateVersJourDeLaSemaine
dbgVérifieEgalité(d.JourDeLaSemaine(), 4, "d.JourDeLaSemaine jeudi=4")
dbgVérifieEgalité(d.VersJourDeLaSemaine(), 4, "d.VersJourDeLaSemaine")
dbgVérifieEgalité(d.DateVersJourDeLaSemaine(), 4, "d.DateVersJourDeLaSemaine")
dbgVérifieEgalité(d.VersJour(), 4, "d.VersJour")
dbgVérifieEgalité(d.DateVersJour(), 4, "d.DateVersJour")

// Cohérence avec la forme globale
dbgVérifieEgalité(DateVersJourDeLaSemaine(d), 4, "globale cohérente avec méthode")

// Dimanche = 7
dimanche est une date = "20240107"
dbgVérifieEgalité(dimanche.VersJourDeLaSemaine(), 7, "dimanche.VersJourDeLaSemaine=7")

dbgBilanTest()
