// Fenêtre voisine — ressource pour test_sous_widget_cross_fichier_multilingue.owl.
// Déclare un sous-widget Bouton dont le slot Libellé est multilingue. Le test
// voisin doit pouvoir affecter directement un littéral inline dict sans variable
// typée intermédiaire (le pré-scan des voisins ancre le sous-widget DSL
// cross-fichier).

FEN_Repro est une Fenêtre
	PROPRIETES
		Titre       = "Repro 0469"
		Largeur     = 400
		Hauteur     = 200
		Disposition = dispLibre
	FIN

	BTN_Test est un Champ Bouton
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 200
			Hauteur = 30
		FIN
	FIN
FIN
