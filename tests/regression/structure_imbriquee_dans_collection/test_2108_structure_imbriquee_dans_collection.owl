//  : verrou d'execution pour la structure voisine COL_Lib.owl.
// Verifie que le champ declare APRES le type imbrique (Enumeration) reste
// accessible depuis l'exterieur via l'acces qualifie de collection.

p est un COL_Lib.stConfig
p.Nom = "cfg"
p.Taille = 7

dbgVérifieEgalité(p.Nom, "cfg", "champ avant le type imbrique reste accessible (collection)")
dbgVérifieEgalité(p.Taille, 7, "champ scalaire apres le type imbrique n'est plus orpheline (collection)")
dbgBilanTest()
