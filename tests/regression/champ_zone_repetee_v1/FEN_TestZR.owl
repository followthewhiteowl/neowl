// Fenêtre voisine — ressource compile-only pour test_champ_zone_repetee_v1.owl.
// Témoin DSL : syntaxe Champ ZoneRépétée, props (Sens=zrVertical), sous-champs
// imbriqués (Libellé + Saisie côte à côte).

FEN_TestZR est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
	FIN

	ZR_Items est un Champ ZoneRépétée
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 400
			Hauteur = 300
			Sens    = zrVertical
		FIN

		LIB_Item est un Champ Libellé
			PROPRIETES
				X       = 5
				Y       = 5
				Largeur = 200
				Libellé = "Item"
			FIN
		FIN

		SAI_Val est un Champ Saisie
			PROPRIETES
				X       = 210
				Y       = 5
				Largeur = 180
			FIN
		FIN
	FIN
FIN
