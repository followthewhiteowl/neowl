// Regression : Champ ZoneRepetee V1 — kind, props, natives.
//
// Pattern : la fenêtre voisine FEN_TestZR.owl porte la déclaration
// compile-only (ZoneRépétée avec sous-champs Libellé + Saisie).

dbgVérifieEgalité(owlChampZoneRepetee, 92, "owlChampZoneRepetee = 92")
dbgVérifieEgalité(TypeVar(ZoneRépétéeAjouteLigne), 70, "ZoneRépétéeAjouteLigne accentue = procedure native")
dbgVérifieEgalité(TypeVar(ZoneRépétéeAjouteLigne), 70, "ZoneRepeteeAjouteLigne ASCII = procedure native")
dbgVérifieEgalité(TypeVar(ZoneRépétéeSupprimeTout), 70, "ZoneRépétéeSupprimeTout = procedure native")
dbgVérifieEgalité(TypeVar(ZoneRépétéeOccurrence), 70, "ZoneRépétéeOccurrence = procedure native")
dbgVérifieEgalité(TypeVar(ZoneRépétéeAffiche), 70, "ZoneRépétéeAffiche = procedure native")
dbgVérifieEgalité(TypeVar(ZoneRépétéeInsère), 70, "ZoneRépétéeInsère = procedure native")
dbgVérifieEgalité(TypeVar(ZoneRépétéeSupprime), 70, "ZoneRépétéeSupprime = procedure native")
// Constante Sens — le sens de repetition n'a qu'une valeur : zrVertical
// (sentinel-zone, protege contre 'Sens = 0' qui serait un int valide).
dbgVérifieFaux(zrVertical = 0, "zrVertical est une sentinelle (protege contre int literal 0)")
dbgVérifieFaux(zrVertical = dispVerticale, "zrVertical != dispVerticale (enums distincts)")

dbgBilanTest()
