// Ressource pure — fenetre avec une globale et une procedure intra-element.
// Verrouille le chemin : proc intra-element lit/ecrit la globale en nom nu.

FEN_IntraGlob est une Fenêtre
	PROPRIETES
		Titre       = "IntraGlob"
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN

	gCompteur est un entier = 0

	PROCEDURE FinInitialisation()
		incremente()
	FIN

	PROCEDURE incremente()
		gCompteur += 1
	FIN

FIN
