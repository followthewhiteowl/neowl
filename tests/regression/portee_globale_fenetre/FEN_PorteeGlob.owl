// Fenetre voisine — ressource pour les tests de portee des globales fenetre.
// Declare deux globales typees au top-level du bloc Fenetre.
// Un champ Libelle pour le test de non-regression acces controle qualifie.

FEN_PorteeGlob est une Fenêtre
	PROPRIETES
		Titre       = "PorteeGlob"
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN

	gNom est une chaîne = "portee"
	gScore est un entier = 99

	LIB_Ctrl est un Champ Libellé
		PROPRIETES
			X       = 10
			Y       = 10
			Libellé = "ctrl"
		FIN
	FIN
FIN
