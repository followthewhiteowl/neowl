//  : lecture PURE d'un élément jamais écrit. Aucune écriture ne
// précède : une implémentation qui construirait l'instance à la première
// écriture passerait les autres cas et échouerait ici.
// Chaque champ rend la valeur par défaut de son type, jamais Null.
ST_Intouche est une Structure
	Msg est une chaîne
	N est un entier
FIN

tIntouche est un tableau de 2 ST_Intouche

dbgVérifieEgalité(tIntouche..Occurrence, 2, "1398 : deux éléments déclarés")

dbgVérifieEgalité(tIntouche[2].Msg, "", "1398 : champ chaîne d'un élément jamais écrit rend la chaîne vide")
dbgVérifieEgalité(tIntouche[2].N, 0, "1398 : champ entier d'un élément jamais écrit rend 0")
dbgVérifieEgalité(Taille(tIntouche[2].Msg), 0, "1398 : la chaîne par défaut est réellement vide, pas un objet")

dbgVérifieEgalité(tIntouche[1].Msg, "", "1398 : la première cellule est elle aussi construite et vide")
dbgVérifieEgalité(tIntouche[1].N, 0, "1398 : champ entier de la première cellule à zéro")

dbgBilanTest()
