//  : une structure à champs de types différents. Chaque champ d'une
// cellule pré-instanciée reçoit SA valeur par défaut, pas une valeur unique
// recopiée sur tout le contenu.
ST_Mixte est une Structure
	Intitulé est une chaîne
	Compteur est un entier
	Ratio est un réel
	Actif est un booléen
	Montant est un monétaire
FIN

tMixte est un tableau de 2 ST_Mixte

dbgVérifieEgalité(tMixte..Occurrence, 2, "1398 : deux éléments déclarés")

dbgVérifieEgalité(tMixte[1].Intitulé, "", "1398 : champ chaîne par défaut vide")
dbgVérifieEgalité(tMixte[1].Compteur, 0, "1398 : champ entier par défaut à zéro")
dbgVérifieVrai(Abs(tMixte[1].Ratio - 0.0) < 0.0001, "1398 : champ réel par défaut à zéro")
dbgVérifieEgalité(tMixte[1].Actif, Faux, "1398 : champ booléen par défaut à Faux")
dbgVérifieVrai(Abs(tMixte[1].Montant - 0.0) < 0.0001, "1398 : champ monétaire par défaut à zéro")

tMixte[2].Intitulé = "Facture"
tMixte[2].Compteur = 3
tMixte[2].Actif = Vrai
dbgVérifieEgalité(tMixte[2].Intitulé, "Facture", "1398 : champ chaîne écrit sur la deuxième cellule")
dbgVérifieEgalité(tMixte[2].Compteur, 3, "1398 : champ entier écrit sur la deuxième cellule")
dbgVérifieEgalité(tMixte[2].Actif, Vrai, "1398 : champ booléen écrit sur la deuxième cellule")
dbgVérifieVrai(Abs(tMixte[2].Ratio - 0.0) < 0.0001, "1398 : les champs non écrits de la cellule gardent leur valeur par défaut")
dbgVérifieEgalité(tMixte[1].Intitulé, "", "1398 : la première cellule n'a pas bougé")

dbgBilanTest()
