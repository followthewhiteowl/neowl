//  : un tableau déclaré avec une taille et un type Structure
// pré-instancie ses N éléments. Écrire un champ d'une cellule jamais
// construite doit fonctionner, et la relecture rendre la valeur écrite.
ST_Rub est une Structure
	Msg est une chaîne
	N est un entier
FIN

t est un tableau de 3 ST_Rub

dbgVérifieEgalité(t..Occurrence, 3, "1398 : le tableau dimensionné compte bien 3 éléments à la déclaration")

t[1].Msg = "Premier"
dbgVérifieEgalité(t[1].Msg, "Premier", "1398 : écriture puis relecture d'un champ chaîne de la première cellule")

t[3].N = 42
dbgVérifieEgalité(t[3].N, 42, "1398 : écriture puis relecture d'un champ entier de la dernière cellule")

dbgVérifieEgalité(t..Occurrence, 3, "1398 : écrire dans les cellules ne change pas le nombre d'éléments")

dbgBilanTest()
