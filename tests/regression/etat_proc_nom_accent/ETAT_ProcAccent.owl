// Ressource Etat pour le verrou d'accent-insensibilite des noms de PROCEDURE.
//
// Deux procedures nommees par l'utilisateur :
//   - "noteAidé"   declaree AVEC accent, appelee SANS  ("noteAide")
//   - "noteResume" declaree SANS accent, appelee AVEC  ("noteRésumé")
//
// Les deux graphies doivent designer la meme procedure : declaration et
// resolution utilisent la meme regle de comparaison.

ETAT_ProcAccent est un Etat
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	corps est un Corps
		PROPRIETES
			Hauteur = 20
		FIN
	FIN

	PROCEDURE noteAidé()
		callback_resultat_accent("noteAidé")
	FIN

	PROCEDURE noteResume()
		callback_resultat_nu("noteResume")
	FIN

	PROCEDURE Lecture()
		// Acces croise : graphie nue vers une proc declaree avec accent,
		// et graphie accentuee vers une proc declaree sans accent.
		noteAide()
		noteRésumé()
	FIN
FIN
