// Voisin de test_bug_procedure_global_forme_en.owl : methode
// statique declaree via GLOBAL (forme anglaise, sans E).
cNettoyeur1964 est une Classe
PUBLIC
	PROCEDURE GLOBAL MET_NomFichierVALIDER(IsNomFichier est une chaîne, IsCaractereRemplacement est une chaîne = "") : chaîne
		RENVOYER Remplace(IsNomFichier, ["'", `"`, "<", ">", "\", "/", "*", "?", "¦"], IsCaractereRemplacement)
	FIN
FIN
