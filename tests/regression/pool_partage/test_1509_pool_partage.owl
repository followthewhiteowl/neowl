stPetitApres1509 est une Structure
	pb1 est un entier
	pb2 est un entier
FIN

stPetitDernier1509 est une Structure
	pc1 est un entier
FIN

pa est un stPetitAvant1509
pg est un stGros1509
pb est un stPetitApres1509
pc est un stPetitDernier1509
o est un cInterleave1509

pa.pa1 = 101
pa.pa2 = 102
pg.g0001 = 3001
pg.g0100 = 3100
pg.g0200 = 3200
pb.pb1 = 201
pb.pb2 = 202
pc.pc1 = 301

dbgVérifieEgalité(pa.pa1, 101, "petit type declare avant le gros")
dbgVérifieEgalité(pa.pa2, 102, "deuxieme champ du petit type d'avant")
dbgVérifieEgalité(pg.g0001, 3001, "premier champ du gros type")
dbgVérifieEgalité(pg.g0100, 3100, "champ du milieu du gros type")
dbgVérifieEgalité(pg.g0200, 3200, "dernier champ du gros type")
dbgVérifieEgalité(pg.g0150, 0, "champ jamais ecrit du gros type")
dbgVérifieEgalité(pb.pb1, 201, "petit type declare apres le gros")
dbgVérifieEgalité(pb.pb2, 202, "deuxieme champ du petit type d'apres")
dbgVérifieEgalité(pc.pc1, 301, "dernier petit type declare")

pg.g0100 = 9
dbgVérifieEgalité(pg.g0100, 9, "reecriture au milieu du gros type")
dbgVérifieEgalité(pb.pb1, 201, "ecriture dans le gros type n'atteint pas le voisin")
dbgVérifieEgalité(pa.pa1, 101, "ni le voisin declare avant")

dbgVérifieEgalité(o.Croise(), 184, "methode croisant champs de classe et structure imbriquee")
dbgVérifieEgalité(o.avant0001, 1, "champ de classe avant la structure imbriquee, ecrit par la methode")
dbgVérifieEgalité(o.apres0040, 40, "champ de classe apres la structure imbriquee, ecrit par la methode")
dbgVérifieEgalité(o.apres0001, 0, "champ de classe jamais ecrit")
dbgBilanTest()
