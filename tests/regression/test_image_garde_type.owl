	dbgVérifieVrai(bErr, "dModifieOpacite type invalide arg1 - erreur detectee")
	dbgVérifieVrai(ChaîneOccurrence(sInfo, "type") > 0 OU ChaîneOccurrence(sInfo, "Image") > 0, "dModifieOpacite type invalide arg1 - message contient type/Image")
FIN

// ══════════════════════════════════════════════════════════════════════════════
// SECTION PRIVEE — edge cases garde type
// ══════════════════════════════════════════════════════════════════════════════

PROCEDURE PRIVÉE scenario_dfusionne_entier_au_lieu_instance()
	img est une Image = dCréeImage(10, 10, Blanc)

	// dFusionne avec arg2 entier au lieu de Image → E_NATIVE_ARG_TYPE_MISMATCH attendu
	ErreurRAZ()
	dFusionne(img, 42)

	bErr est un booléen = ErreurDétectée
	dbgVérifieVrai(bErr, "dFusionne entier au lieu instance - erreur detectee")
FIN

PROCEDURE PRIVÉE scenario_dincrustecouleur_booleen_au_lieu_instance()
	// dIncrusteCouleur avec arg1 booléen au lieu de Image → E_NATIVE_ARG_TYPE_MISMATCH attendu
	ErreurRAZ()
	dIncrusteCouleur(Vrai, RVB(255, 0, 0))

	bErr est un booléen = ErreurDétectée
	dbgVérifieVrai(bErr, "dIncrusteCouleur booleen au lieu instance - erreur detectee")
FIN

PROCEDURE PRIVÉE scenario_dpoint_reel_au_lieu_instance()
	// dPoint avec arg1 réel au lieu de Image → E_NATIVE_ARG_TYPE_MISMATCH attendu
	ErreurRAZ()
	dPoint(3.14, 5, 5, RVB(255, 0, 0))

	bErr est un booléen = ErreurDétectée
	dbgVérifieVrai(bErr, "dPoint reel au lieu instance - erreur detectee")
FIN
