// Verrou : un État déclaré en formes anglaises (TopMargin/BottomMargin/
// LeftMargin/RightMargin au niveau État, Height sur les blocs) doit rendre
// un PDF identique à son équivalent en formes françaises (MargeHaut/Bas/
// Gauche/Droite, Hauteur). Avant correction, ces formes EN sont ignorées
// par le moteur de rendu : aucune marge n'est appliquée et les blocs ne
// réservent aucune hauteur (bandeau de fond non peint, contenu suivant
// superposé).
//
// iImprimeEtat étant autonome ( : il finalise seul, la géométrie n'est
// plus lisible après l'impression), on vérifie l'équivalence bilingue sur le
// FLUX DE CONTENU PDF produit, décompressé :
//   1. Ancre absolue : le bandeau de fond du Corps (CouleurFond) est bien peint
//      en FR — présence d'au moins un rectangle "re" (marges + Hauteur honorées).
//   2. Égalité stricte FR == EN du flux de contenu : TopMargin/BottomMargin/
//      Height doivent rendre à l'octet près comme MargeHaut/MargeBas/Hauteur.

TestModeHeadless(Vrai)

PROCEDURE TrouveMotif(buf est un buffer, motif est une chaîne, depart est un entier)
	nBuf est un entier = Taille(buf)
	motifBuf est un buffer = ChaîneVersBuffer(motif)
	nMotif est un entier = Taille(motifBuf)
	i est un entier = depart
	TANTQUE i <= nBuf - nMotif + 1
		bMatch est un booléen = Vrai
		k est un entier = 0
		TANTQUE k < nMotif ET bMatch
			SI BufferLitOctet(buf, i + k) <> BufferLitOctet(motifBuf, k + 1) ALORS
				bMatch = Faux
			FIN
			k = k + 1
		FIN
		SI bMatch ALORS
			RENVOYER i
		FIN
		i = i + 1
	FIN
	RENVOYER 0
FIN

// Extrait et décompresse le 1er flux de contenu (celui référencé par
// /Contents) du PDF produit.
PROCEDURE StreamContenuPDF(chemin est une chaîne)
	buf est un buffer = fChargeBuffer(chemin)
	posContents est un entier = TrouveMotif(buf, "/Contents ", 1)
	i est un entier = posContents + Taille(ChaîneVersBuffer("/Contents "))
	nObj est un entier = 0
	TANTQUE BufferLitOctet(buf, i) >= 48 ET BufferLitOctet(buf, i) <= 57
		nObj = nObj * 10 + (BufferLitOctet(buf, i) - 48)
		i    = i + 1
	FIN
	sMotifObj est une chaîne = "" + nObj + " 0 obj"
	posObj est un entier = TrouveMotif(buf, sMotifObj, 1)
	posStream est un entier = TrouveMotif(buf, "stream", posObj)
	dataStart est un entier = posStream + 6
	SI BufferLitOctet(buf, dataStart) = 13 ALORS
		dataStart = dataStart + 1
	FIN
	SI BufferLitOctet(buf, dataStart) = 10 ALORS
		dataStart = dataStart + 1
	FIN
	posEndstream est un entier = TrouveMotif(buf, "endstream", dataStart)
	nSegTaille est un entier = posEndstream - dataStart
	seg est un buffer = BufferVide(nSegTaille)
	j est un entier = 1
	TANTQUE j <= nSegTaille
		BufferÉcritOctet(seg, j, BufferLitOctet(buf, dataStart + j - 1))
		j = j + 1
	FIN
	decomp est un buffer = Décompresse(seg)
	RENVOYER BufferVersChaîne(decomp, encLatin1)
FIN

// --- Rendu FR et EN — iImprimeEtat est autonome : il finalise seul, pas de
//     iFinImprime. ---

iDestination(iPDFGénérique, "tests/regression/etat_bilingue_en_rendu/temp_fr.pdf")
iImprimeEtat(ETAT_BilingueRenduFR)

iDestination(iPDFGénérique, "tests/regression/etat_bilingue_en_rendu/temp_en.pdf")
iImprimeEtat(ETAT_BilingueRenduEN)

// --- Vérification : l'État EN rend EXACTEMENT comme son jumeau FR ---

sFR est une chaîne = StreamContenuPDF("tests/regression/etat_bilingue_en_rendu/temp_fr.pdf")
sEN est une chaîne = StreamContenuPDF("tests/regression/etat_bilingue_en_rendu/temp_en.pdf")

// Ancre absolue : le bandeau CouleurFond du Corps est peint en FR (marges +
// Hauteur honorées ; sinon le flux ne contiendrait aucun rectangle "re").
nRectFR est un entier = Occurrence(sFR, "re")
dbgVérifieVrai(nRectFR > 0,
"FR : le bandeau CouleurFond du Corps (Hauteur = 40) est peint — marges et hauteur appliquées")

// Équivalence bilingue : TopMargin/BottomMargin/Height doivent produire un flux
// de contenu PDF strictement identique à MargeHaut/MargeBas/Hauteur. Toute
// divergence de rendu entre les deux formes casse cette égalité.
dbgVérifieEgalité(sEN, sFR,
"EN (TopMargin/BottomMargin/Height) : flux de contenu PDF identique à la version FR")

dbgBilanTest()
