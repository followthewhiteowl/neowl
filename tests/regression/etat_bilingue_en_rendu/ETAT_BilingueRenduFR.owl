// État de référence en formes FR — marges au niveau État + hauteur de bloc.
// Sert de repère de rendu comparé à son jumeau EN (ETAT_BilingueRenduEN.owl) :
// les deux doivent produire la même géométrie de page (marges appliquées,
// bandeaux non superposés).

ETAT_BilingueRenduFR est un État
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
		MargeHaut   = 20
		MargeBas    = 15
		MargeGauche = 10
		MargeDroite = 10
	FIN

	entete est un EnTêteDocument
		PROPRIETES
			Hauteur = 25
		FIN
	FIN

	corps est un Corps
		PROPRIETES
			Hauteur     = 40
			CouleurFond = BleuClair
		FIN
	FIN
FIN
