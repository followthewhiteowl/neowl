// Fenêtre voisine — ressource compile-only pour test_champ_interrupteur_v1.owl.
// Témoin DSL : syntaxe Champ Interrupteur, props (ModeAffichage, Options
// polymorphique array de chaînes / structs, NombreColonne, TroisEtats),
// events (surAChaqueModification).
//
// Toutes les déclarations `Options` sont écrites en forme mono-ligne (seule
// forme canon pour un littéral tableau, cf. ) : un `[` en fin de
// ligne ouvre une chaîne multi-ligne, jamais un tableau.

FEN_TestInterrupteur est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
	FIN

	INT_Permissions est un Champ Interrupteur
		PROPRIETES
			X              = 10
			Y              = 10
			Largeur        = 240
			Hauteur        = 100
			ModeAffichage  = selStandard
			Options        = ["Lecture", "Ecriture", "Execution"]
			ValeurInitiale = 5
		FIN
		PROCEDURE surAChaqueModification()
			Trace("[Permissions] bitmask = ", INT_Permissions..Valeur)
		FIN
	FIN

	INT_Notifs est un Champ Interrupteur
		PROPRIETES
			X             = 270
			Y             = 10
			Largeur       = 240
			ModeAffichage = selSousLib
			Options       = [{Libellé = "Email", SousLibelle = "Quotidien"},{Libellé = "SMS", SousLibelle = "Urgences"},{Libellé = "Push", SousLibelle = "Temps reel"}]
			TroisEtats    = Vrai
		FIN
	FIN

	// Multi-colonnes
	INT_Sources est un Champ Interrupteur
		PROPRIETES
			X             = 10
			Y             = 130
			Largeur       = 480
			NombreColonne = 2
			Options       = ["RSS", "Atom", "JSON Feed", "Twitter", "Mastodon", "Bluesky"]
		FIN
	FIN
FIN
