// Regression: DateDifference retourne un entier (nombre de jours), pas une durée
// Le registry la déclarait avec type "durée" mais l'impl retourne INTEGER_VAL

d1 est une date = "20240101"
d2 est une date = "20240110"

n est un entier = DateDifférence(d1, d2)
dbgVérifieEgalité(n, 9, "difference 9 jours")

// Sens inverse → négatif
n2 est un entier = DateDifférence(d2, d1)
dbgVérifieEgalité(n2,-9, "difference negative")

// Même date → 0
dbgVérifieEgalité(DateDifférence(d1, d1), 0, "meme date = 0")

// Année bissextile: 2024-02-01 → 2024-03-01 = 29 jours (2024 est bissextile)
d3 est une date = "20240201"
d4 est une date = "20240301"
dbgVérifieEgalité(DateDifférence(d3, d4), 29, "fevrier 2024 bissextile")

dbgBilanTest()
