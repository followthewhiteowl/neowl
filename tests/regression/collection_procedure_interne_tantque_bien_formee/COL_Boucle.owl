//  — non-régression VERTE : voisin direct du cas cassé (PROCEDURE
// sans son propre FIN). Ici 'CompteJusqua' a un bloc interne TANTQUE avec
// SON PROPRE FIN, ET la PROCEDURE a AUSSI son propre FIN — le cas bien formé
// le plus proche du bug ne doit jamais régresser.
COL_Boucle est une CollectionDeProcédures

	PROCEDURE CompteJusqua(n est un entier) : entier
		i est un entier = 0
		TANTQUE i < n
			i = i + 1
		FIN
		RENVOYER i
	FIN

	PROCEDURE Suivante() : entier
		RENVOYER 99
	FIN
FIN
