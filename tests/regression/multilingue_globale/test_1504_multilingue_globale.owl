mMulti est une chaîneMultilingue = {langueFrançais: "Bonjour"}
gVoisineAvant est un entier = 8001
gVoisineApres est un entier = 8002

// Assignation scalaire nue : c'est CE statement qui declenche
// __MultilingueAssignSource(mMulti, "Salut") et le site fautif.
mMulti = "Salut"

sLu est une chaîne = mMulti
dbgVérifieEgalité(sLu, "Salut", "assignation scalaire sur multilingue globale au-dela du seuil de 256 constantes")
dbgVérifieEgalité(gVoisineAvant, 8001, "globale voisine declaree avant le site fautif garde sa valeur")
dbgVérifieEgalité(gVoisineApres, 8002, "globale voisine declaree apres le site fautif garde sa valeur")
dbgVérifieEgalité(g0001 + g0300, 301, "somme croisee sur les globales les plus lointaines du pool")
dbgBilanTest()
