//  : ParamètreCharge sur une clé absente renvoie soit la valeur de
// repli fournie, soit la chaîne vide en son absence — jamais Null, jamais une
// erreur bloquante.

PROCEDURE PUBLIQUE test_cle_absente_avec_defaut()
	chemin est une chaîne = fRepTemp() + "test_regr_parametres_absente_avecdefaut.json"
	ParamètreInitialise(paramJSON, chemin)

	valeur est une chaîne = ParamètreCharge("N'existe pas", "repli")

	dbgVérifieEgalité(valeur, "repli", "clé absente avec repli explicite : repli renvoyé")
FIN

PROCEDURE PUBLIQUE test_cle_absente_sans_defaut()
	chemin est une chaîne = fRepTemp() + "test_regr_parametres_absente_sansdefaut.json"
	ParamètreInitialise(paramJSON, chemin)

	valeur est une chaîne = ParamètreCharge("N'existe pas non plus")

	dbgVérifieEgalité(valeur, "", "clé absente sans repli : chaîne vide renvoyée")
FIN

dbgBilanTest()
