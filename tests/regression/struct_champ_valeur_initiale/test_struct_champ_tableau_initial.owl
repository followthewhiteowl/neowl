// Champ de Structure de type tableau declare avec une valeur initiale.
// Le contenu declare doit etre present a l'instanciation, et chaque
// instance doit posseder sa propre copie du tableau.

stAvecTableau est une Structure
	tabValeurs est un tableau de entiers = [10, 20, 30]
	tabVide est un tableau de entiers
FIN

t1 est un stAvecTableau

dbgVérifieEgalité(Taille(t1.tabValeurs), 3, "le tableau initialise porte ses trois elements")
dbgVérifieEgalité(t1.tabValeurs[1], 10, "premier element du tableau initialise")
dbgVérifieEgalité(t1.tabValeurs[3], 30, "dernier element du tableau initialise")
dbgVérifieEgalité(Taille(t1.tabVide), 0, "un tableau sans valeur initiale reste vide")

t2 est un stAvecTableau
t2.tabValeurs[1] = 999

dbgVérifieEgalité(t1.tabValeurs[1], 10, "les tableaux ne sont pas partages entre instances")
dbgVérifieEgalité(t2.tabValeurs[1], 999, "la seconde instance porte bien sa propre valeur")

dbgBilanTest()
