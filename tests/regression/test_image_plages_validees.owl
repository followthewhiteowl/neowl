// @sujet : famille image - validation plages paramètres
// @resume : Tests régression plages paramétriques (dModifieContraste, dFlou rayon, dModifieOpacité)

// ══════════════════════════════════════════════════════════════════════════════
// SECTION PUBLIQUE — validation plages paramètres
// ══════════════════════════════════════════════════════════════════════════════

PROCEDURE PUBLIQUE scenario_dmodifiecontraste_variation_hors_plage_positive()
	img est une Image = dCréeImage(10, 10, RVB(128, 128, 128))

	// dModifieContraste avec variation +150 (hors plage canon -100..+100) → erreur OU retour Faux attendu
	ErreurRAZ()
	res est un booléen = dModifieContraste(img, 150)

	bErr est un booléen = ErreurDétectée
	sInfo est une chaîne = ErreurInfo()

	// Attendu : soit erreur levée, soit retour Faux
	dbgVérifieVrai(bErr OU res = Faux, "dModifieContraste variation +150 - erreur ou retour Faux")
FIN

PROCEDURE PUBLIQUE scenario_dmodifiecontraste_variation_hors_plage_negative()
	img est une Image = dCréeImage(10, 10, RVB(128, 128, 128))

	// dModifieContraste avec variation -150 (hors plage canon -100..+100) → erreur OU retour Faux attendu
	ErreurRAZ()
	res est un booléen = dModifieContraste(img,-150)

	bErr est un booléen = ErreurDétectée
	sInfo est une chaîne = ErreurInfo()

	dbgVérifieVrai(bErr OU res = Faux, "dModifieContraste variation -150 - erreur ou retour Faux")
FIN

PROCEDURE PUBLIQUE scenario_dmodifiecontraste_variation_limite_haute()
	img est une Image = dCréeImage(10, 10, RVB(128, 128, 128))

	// dModifieContraste avec variation +100 (limite haute canon) → OK attendu
	ErreurRAZ()
	res est un booléen = dModifieContraste(img, 100)

	bErr est un booléen = ErreurDétectée

	dbgVérifieVrai(res = Vrai, "dModifieContraste variation +100 - retour Vrai")
	dbgVérifieVrai(bErr = Faux, "dModifieContraste variation +100 - pas erreur")
FIN

PROCEDURE PUBLIQUE scenario_dmodifiecontraste_variation_limite_basse()
	img est une Image = dCréeImage(10, 10, RVB(128, 128, 128))

	// dModifieContraste avec variation -100 (limite basse canon) → OK attendu
	ErreurRAZ()
	res est un booléen = dModifieContraste(img,-100)

	bErr est un booléen = ErreurDétectée

	dbgVérifieVrai(res = Vrai, "dModifieContraste variation -100 - retour Vrai")
	dbgVérifieVrai(bErr = Faux, "dModifieContraste variation -100 - pas erreur")
FIN

PROCEDURE PUBLIQUE scenario_dflou_rayon_negatif()
	img est une Image = dCréeImage(10, 10, RVB(255, 0, 0))

	// dFlou avec rayon négatif → erreur attendue
	ErreurRAZ()
	dFlou(img,-5)

	bErr est un booléen = ErreurDétectée
	sInfo est une chaîne = ErreurInfo()

	dbgVérifieVrai(bErr, "dFlou rayon negatif - erreur detectee")
	dbgVérifieVrai(ChaîneOccurrence(sInfo, "rayon") > 0 OU ChaîneOccurrence(sInfo, "radius") > 0 OU ChaîneOccurrence(sInfo, "valeur") > 0, "dFlou rayon negatif - message contient rayon/radius/valeur")
FIN

PROCEDURE PUBLIQUE scenario_dflou_rayon_0_valide()
	img est une Image = dCréeImage(10, 10, RVB(0, 255, 0))

	// dFlou avec rayon 0 (limite basse) → OK attendu (aucun effet)
	ErreurRAZ()
	dFlou(img, 0)

	bErr est un booléen = ErreurDétectée

	dbgVérifieVrai(bErr = Faux, "dFlou rayon 0 - pas erreur")
FIN

