// SECTION PRIVEE — edge cases validation plages
// ══════════════════════════════════════════════════════════════════════════════

PROCEDURE PRIVÉE scenario_dmodifiecontraste_variation_101()
	img est une Image = dCréeImage(10, 10, RVB(128, 128, 128))

	// dModifieContraste avec variation +101 (juste au-dessus de limite haute) → erreur ou Faux attendu
	ErreurRAZ()
	res est un booléen = dModifieContraste(img, 101)

	bErr est un booléen = ErreurDétectée

	dbgVérifieVrai(bErr OU res = Faux, "dModifieContraste variation +101 - erreur ou retour Faux")
FIN

