PROCEDURE PRIVÉE scenario_dflou_rayon_tres_grand()
	img est une Image = dCréeImage(10, 10, RVB(0, 0, 255))

	// dFlou avec rayon très grand (1000) → OK attendu (convergence flou extreme)
	ErreurRAZ()
	dFlou(img, 1000)

	bErr est un booléen = ErreurDétectée

	dbgVérifieVrai(bErr = Faux, "dFlou rayon tres grand - pas erreur")
