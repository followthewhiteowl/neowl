// Verifications d'execution reelle (pas seulement de compilation) :
// premiere, une du milieu, derniere, plus une somme croisee.
dbgVérifieEgalité(g0001, 1, "premiere globale (index 1) conserve sa valeur")
dbgVérifieEgalité(g0500, 500, "globale du milieu (index 500) conserve sa valeur")
dbgVérifieEgalité(g1000, 1000, "derniere globale (index 1000) conserve sa valeur")
