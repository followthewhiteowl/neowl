// Verifie que TypeSaisie = typSaisieMultiligne est accepte par le parser
// et que les 3 constantes existent et sont distinctes.
//
// Pattern : la fenetre voisine FEN_Test.owl porte la declaration
// compile-only (SAI_Notes avec TypeSaisie = typSaisieMultiligne).

dbgVérifieDifférence(typSaisieTexte, typSaisieMotDePasse, "typSaisieTexte != typSaisieMotDePasse")
dbgVérifieDifférence(typSaisieMotDePasse, typSaisieMultiligne, "typSaisieMotDePasse != typSaisieMultiligne")
dbgVérifieDifférence(typSaisieTexte, typSaisieMultiligne, "typSaisieTexte != typSaisieMultiligne")

dbgVérifieVrai(Vrai, "compile ok avec typSaisieMultiligne")
dbgBilanTest()
