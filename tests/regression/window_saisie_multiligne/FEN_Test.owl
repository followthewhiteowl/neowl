// Fenêtre voisine — ressource compile-only pour test_window_saisie_multiligne.owl.
// Témoin : TypeSaisie = typSaisieMultiligne est accepté par le parser.

FEN_Test est une Fenêtre
	PROPRIETES
		Titre       = "Test multiligne"
		Largeur     = 400
		Hauteur     = 300
		Disposition = dispLibre
	FIN

	SAI_Notes est un Champ Saisie
		PROPRIETES
			TypeSaisie = typSaisieMultiligne
			Largeur    = 380
			Hauteur    = 200
			Indication = "Vos notes..."
		FIN
	FIN
FIN
