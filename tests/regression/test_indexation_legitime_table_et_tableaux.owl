// Non-regression : le refus de la mise en forme par cellule de Table ne doit
// toucher AUCUNE indexation legitime. Le crochet reste ouvert pour les
// tableaux simples, associatifs, 2D, les collections et le JSON.

tabEntiers est un tableau de 3 entiers
tabEntiers[1] = 10
tabEntiers[2] = 20
dbgVérifieEgalité(tabEntiers[1], 10, "tableau simple : lecture par indice")
dbgVérifieEgalité(tabEntiers[2], 20, "tableau simple : 2e element")

tabAssoc est un tableau associatif de chaînes
tabAssoc["clé"] = "valeur"
dbgVérifieEgalité(tabAssoc["clé"], "valeur", "tableau associatif : cle chaine")

matrice est un tableau de 2 par 2 entiers
matrice[1, 2] = 7
dbgVérifieEgalité(matrice[1, 2], 7, "tableau 2D : indice a deux dimensions")

stPoint est une Structure
	x est un entier
	y est un entier
FIN

tabPoints est un tableau de 2 stPoint
unPoint est un stPoint
unPoint.X = 3
unPoint.Y = 4
tabPoints[1] = unPoint
dbgVérifieEgalité(tabPoints[1].x, 3, "tableau de structures : champ apres indice")
dbgVérifieEgalité(tabPoints[1].y, 4, "tableau de structures : 2e champ")

doc est un JSON = ChaîneVersJSON(`{"items":[10,20,30]}`)
dbgVérifieEgalité(doc.items[2], 20, "JSON : indexation d'un tableau")

dbgBilanTest()
