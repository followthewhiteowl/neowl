//  : toute erreur runtime de niveau utilisateur doit être
// rattrapable par QUAND EXCEPTION. Isolé dans son propre fichier : voir
// test_1615_arith_tableau_plus_tableau.owl pour la justification de
// l'isolation (exit 70 tuerait les voisins).

// ROUGE tant qu'appeler une variable non-fonction (n()) n'est pas rattrapable.
PROCEDURE PUBLIQUE test_appel_variable_non_appelable_leve_exception()
	n est un entier = 5

	capturé est une chaîne = "init"
	QUAND EXCEPTION DANS
		r est un entier = n()
		capturé = "no-throw"
	FAIRE
		capturé = "caught"
	FIN
	dbgVérifieEgalité(capturé, "caught", "appel d'une variable non-fonction lève une exception récupérable")
FIN
