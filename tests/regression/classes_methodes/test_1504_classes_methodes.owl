//  : verrou d'execution pour la classe voisine cGrande1504.owl
// (200 methodes inline). Verifie que l'instanciation et l'appel de
// methodes reparties sur toute la plage renvoient les bonnes valeurs,
// pas seulement que le fichier compile.

o est un cGrande1504

dbgVérifieEgalité(o.M0001(), 1, "premiere methode (index 1)")
dbgVérifieEgalité(o.M0100(), 100, "methode du milieu (index 100)")
dbgVérifieEgalité(o.M0200(), 200, "derniere methode (index 200)")
dbgVérifieEgalité(o.M0001() + o.M0200(), 201, "somme croisee premiere + derniere")
dbgBilanTest()
