//  : verrou d'execution pour la fenetre voisine FEN_Conf2108.owl.
// Verifie que le champ declare APRES le type imbrique (Enumeration) reste
// accessible depuis l'exterieur via l'acces qualifie de fenetre.
TestModeHeadless(Vrai)

p est un FEN_Conf2108.stConfig
p.Nom = "cfg"
p.Taille = 9

dbgVérifieEgalité(p.Nom, "cfg", "champ avant le type imbrique reste accessible (fenetre)")
dbgVérifieEgalité(p.Taille, 9, "champ scalaire apres le type imbrique n'est plus orpheline (fenetre)")
dbgBilanTest()
