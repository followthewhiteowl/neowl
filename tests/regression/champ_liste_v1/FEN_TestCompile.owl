// Fenêtre voisine — ressource compile-only pour test_champ_liste_v1.owl.
// Témoin DSL : syntaxe fluent + Champ Liste, méthodes prefixées ListeXXX,
// lectures de props et events.

FEN_TestCompile est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
	FIN
	// Champ optionnel : sans modifier
	LISTE_Compile est un Champ Liste
		PROPRIETES
			X = 0
			Y = 0
		FIN
		// Signature canon de référence etendue : (champ, element [, valeur memorisee [, image]])
		LISTE_Compile.Ajoute("test")
		LISTE_Compile.Ajoute("test", "key1")
		LISTE_Compile.Ajoute("test", "key1", "img.png")
		LISTE_Compile.Ajoute("test")
		LISTE_Compile.Insère(1, "x")
		LISTE_Compile.Insère(1, "x", "k")
		LISTE_Compile.Supprime(1)
		LISTE_Compile.Modifie(1, "y")
		LISTE_Compile.Modifie(1, "y", "key2")
		LISTE_Compile.SupprimeTout()
		LISTE_Compile.Affiche()
		n est un entier = LISTE_Compile..Occurrence()
		i est un entier = LISTE_Compile.Cherche("x")
		LISTE_Compile.Trie()
		LISTE_Compile.Trie(-1)
		j est un entier = LISTE_Compile.Select()
		LISTE_Compile.Select(2)
		LISTE_Compile.SelectPlus(1)
		LISTE_Compile.SelectMoins(1)
		k est un entier = LISTE_Compile.SelectOccurrence()
		l est un entier = LISTE_Compile.SelectOccurrence(1)
		m est un entier = LISTE_Compile.DéplaceLigne(1, 2)
		o est un entier = LISTE_Compile.DéplaceLigne(ligneSélectionnée, tdSuivant, tdEchange + tdAfficheDestination)
		p est un entier = LISTE_Compile.InfoXY(tiNumLigne, 50, 50)
		// Props OptionTri / Zoom + ValeurMemorisee
		LISTE_Compile..OptionTri = ccSansAccent + ccSansCasse
		LISTE_Compile..Zoom      = 150
		v est une chaîne = LISTE_Compile..ValeurAffichée
		r est une chaîne = LISTE_Compile..ValeurMémorisée
	FIN
FIN
