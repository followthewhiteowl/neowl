// Fenêtre voisine — ressource pour test_menu_surselection_arite.owl.
//
// Régression : surSélection() d'une OptionMenu doit être déclenchable sans
// que le dispatcher ne pousse un argument de trop (MonChamp) — une option
// de menu n'est pas un champ, elle n'a que MaFenêtre comme slot implicite.

FEN_MenuArite est une Fenêtre
	PROPRIETES
		Titre         = "Régression arité surSélection"
		Disposition   = dispLibre
		Largeur       = 300
		Hauteur       = 150
		MenuPrincipal = MNU_Arite
	FIN

	MNU_Arite est un MenuPrincipal
		SM_Fichier est un SousMenu
			PROPRIETES
				Libellé = "&Fichier"
			FIN

			OPT_Nouveau est une OptionMenu
				PROPRIETES
					Libellé = "&Nouveau"
				FIN

				PROCEDURE surSélection()
					nDeclenchements += 1
				FIN
			FIN
		FIN
	FIN

	nDeclenchements est un entier = 0

	PROCEDURE LireDeclenchements()
		RENVOYER nDeclenchements
	FIN
FIN
