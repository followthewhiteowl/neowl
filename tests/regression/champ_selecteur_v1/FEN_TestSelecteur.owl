// Fenêtre voisine — ressource compile-only pour test_champ_selecteur_v1.owl.
// Témoin DSL : syntaxe Champ Selecteur, props (ModeAffichage variantes
// selStandard/selSousLib/selVista/selVistaSousLib), Options polymorphique
// (array de chaines OU de structs), multi-colonnes, images optionnelles.

FEN_TestSelecteur est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
	FIN

	// Mode standard, options array de chaines (forme simple)
	SEL_Civilite est un Champ Sélecteur
		PROPRIETES
			X              = 10
			Y              = 10
			Largeur        = 200
			ModeAffichage  = selStandard
			Options        = ["Monsieur", "Madame", "Mademoiselle"]
			ValeurInitiale = 1
		FIN
		PROCEDURE surAChaqueModification()
			Trace("[Civilite] = ", SEL_Civilite..Valeur)
		FIN
	FIN

	// Mode avec sous-libelles, options de Struct (forme riche)
	SEL_Livraison est un Champ Sélecteur
		PROPRIETES
			X              = 10
			Y              = 130
			Largeur        = 240
			ModeAffichage  = selSousLib
			Options        = [{Libellé = "Express", SousLibelle = "Sous 24h", ValeurRenvoyee = "exp"},{Libellé = "Standard", SousLibelle = "Sous 5 jours", ValeurRenvoyee = "std"},{Libellé = "Eco", SousLibelle = "Sous 10 jours", ValeurRenvoyee = "eco"}]
			ValeurInitiale = "std"
		FIN
	FIN

	// Multi-colonnes (NombreColonne = 2)
	SEL_Couleurs est un Champ Sélecteur
		PROPRIETES
			X             = 260
			Y             = 10
			Largeur       = 220
			NombreColonne = 2
			Options       = ["Rouge", "Vert", "Bleu", "Jaune"]
		FIN
	FIN

	// Avec image (mode Vista) — chemin fictif, parse seulement
	SEL_Format est un Champ Sélecteur
		PROPRIETES
			X             = 260
			Y             = 130
			ModeAffichage = selVistaSousLib
			Options       = [{Libellé = "PDF", SousLibelle = "Universel", ValeurRenvoyee = "pdf", Image = "icons/pdf.png"},{Libellé = "DOCX", SousLibelle = "Word", ValeurRenvoyee = "docx", Image = "icons/docx.png"}]
		FIN
	FIN
FIN
