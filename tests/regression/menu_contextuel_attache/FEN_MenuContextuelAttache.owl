// Fenêtre voisine — ressource pour test_menu_contextuel_attache.owl.
//
// Régression  : `MenuContextuel = MNU_Edition` reste une propriété
// d'attache résolue par le compilateur après l'ajout de
// MenuContextuel à la table des kinds structurels du formatter. La
// résolution différée de l'attache ne doit pas être affectée.

FEN_MenuContextuelAttache est une Fenêtre
	PROPRIETES
		Titre          = "Régression attache MenuContextuel"
		Disposition    = dispLibre
		Largeur        = 300
		Hauteur        = 150
		MenuContextuel = MNU_Edition
	FIN

	MNU_Edition est un MenuContextuel
		PROPRIETES
			Style..OptionMenu..CouleurFond = Blanc
		FIN

		OPT_Copier est une OptionMenu
			PROPRIETES
				Libellé = "&Copier"
			FIN

			PROCEDURE surSélection()
				nDeclenchements += 1
			FIN
		FIN
	FIN

	nDeclenchements est un entier = 0

	PROCEDURE LireDeclenchements()
		RENVOYER nDeclenchements
	FIN
FIN
