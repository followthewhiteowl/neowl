// Garde-fou : la suppression du CR dans les littéraux multilignes ne doit
// jamais toucher les constantes de fin de ligne elles-mêmes. RC et CR
// valent tous deux CRLF (compatibilité, ) ; LF reste le caractère
// simple canon.

dbgVérifieEgalité(Taille("a" + CRLF + "b"), 4, "a + RC + b = 4 octets (RC = 2 octets)")
dbgVérifieEgalité(Taille("a" + LF + "b"), 3, "a + LF + b = 3 octets")
dbgVérifieEgalité(Taille("a" + CRLF + "b"), 4, "a + CR + b = 4 octets (CR = CRLF depuis fix/1314)")
dbgVérifieEgalité(CRLF, Caract(13) + Caract(10), "RC = Caract(13) + Caract(10)")
dbgVérifieEgalité(CRLF, CRLF, "CRLF est le même caractère que RC")
dbgVérifieEgalité(LF, Caract(10), "LF = Caract(10)")
dbgVérifieEgalité(CRLF, Caract(13) + Caract(10), "CR = Caract(13) + Caract(10) (CR = CRLF depuis fix/1314)")

dbgBilanTest()
