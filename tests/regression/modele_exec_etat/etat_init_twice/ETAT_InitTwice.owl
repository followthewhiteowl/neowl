// Etat voisin — ressource pour test_etat_init_twice.owl.
//
// __dbgNoteExecution("ETAT_Twice") au top-level du bloc Etat : chaque
// execution reelle du top-level incremente le compteur.
// Apres  : 2 iImprimeEtat => compteur = 1 (init UNIQUE, pas par impression).
// Avant fix (bug 652) : comportement a mesurer.

ETAT_InitTwice est un Etat
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	__dbgNoteExecution("ETAT_Twice")

	corps est un Corps
		PROPRIETES
			Hauteur = 40
		FIN
	FIN
FIN
