// Verrou  — etat imprime 1x : top-level tourne exactement 1x.
//
// ETAT_InitOnce appelle __dbgNoteExecution("ETAT_Once") dans son top-level.
// Attendu post-fix : 1 iImprimeEtat => compteur = 1.
// => Ce test est ROUGE avant fix si le bug fait tourner le top-level 2x.

TestModeHeadless(Vrai)

iDestination(iPDFGénérique, "tests/regression/modele_exec_etat/etat_init_once/temp.pdf")
iImprimeEtat(ETAT_InitOnce)
iFinImprime()

dbgVérifieEgalité(__dbgNombreExecutions("ETAT_Once"), 1,
"etat imprime 1x : top-level execute exactement 1x")

dbgBilanTest()
