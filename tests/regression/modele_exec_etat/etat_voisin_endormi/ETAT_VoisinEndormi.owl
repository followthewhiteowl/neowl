// Etat voisin — ressource pour test_etat_voisin_non_imprime.owl.
//
// Ce fichier ne doit PAS etre imprime par le script test.
// __dbgNoteExecution("ETAT_Dormant") au top-level : compte chaque execution.
// Apres  : sans iImprimeEtat => compteur = 0 (etat endormi).
// Avant fix (bug 652) : eager au boot => compteur = 1.

ETAT_VoisinEndormi est un Etat
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	__dbgNoteExecution("ETAT_Dormant")

	corps est un Corps
		PROPRIETES
			Hauteur = 40
		FIN
	FIN
FIN
