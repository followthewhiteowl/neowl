//  : verrou d'execution pour la structure voisine COL_Boite.owl.
// Une Structure imbriquee (pas Enumeration) dans une Structure membre d'une
// CollectionDeProcédures doit compiler clean et rester utilisable depuis
// l'exterieur.

b est un COL_Boite.stConteneur
b.Nom = "boite"
b.Origine.X = 3
b.Origine.Y = 4
b.Taille = 10

dbgVérifieEgalité(b.Nom, "boite", "champ avant le type imbrique reste accessible (structure dans collection)")
dbgVérifieEgalité(b.Origine.X, 3, "champ x de la structure imbriquee, ecrit et lu depuis l'exterieur (collection)")
dbgVérifieEgalité(b.Origine.Y, 4, "champ y de la structure imbriquee, ecrit et lu depuis l'exterieur (collection)")
dbgVérifieEgalité(b.Taille, 10, "champ scalaire apres le type imbrique n'est plus orpheline (collection)")
dbgBilanTest()
