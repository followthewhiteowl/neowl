// Forme crochets équivalente à la référence LF (test_eol_litteraux_lf_reference.owl),
// fichier entièrement écrit en fin de ligne Windows (CRLF).

txt2 est une chaîne = [
ligne1
ligne2
]
dbgVérifieEgalité(Taille(txt2), 13, "crochets 2 lignes (CRLF) = 13 octets")
dbgVérifieEgalité(txt2, "ligne1" + LF + "ligne2", "crochets 2 lignes (CRLF) = ligne1 + LF + ligne2")

dbgBilanTest()
