// Même contenu 5 lignes que la référence LF, entièrement écrit en CRLF.
// Le nombre de fins de ligne à supprimer est plus élevé — vérifie que la
// règle sapplique uniformément au fichier, pas seulement à un cas isolé.

txt5 est une chaîne = `un
deux
trois
quatre
cinq`
dbgVérifieEgalité(Taille(txt5), 25, "5 lignes (CRLF) = 25 octets")
dbgVérifieEgalité(txt5, "un" + LF + "deux" + LF + "trois" + LF + "quatre" + LF + "cinq", "5 lignes (CRLF) = concaténation attendue")

dbgBilanTest()
