//  : champ de classe tableau dynamique declare avec l'article EN
// 'an' (is an array of X) n'est aujourd'hui PAS construit comme un vrai
// tableau dynamique -> premier appel de methode collection crashe au
// runtime ("No method ... for this type"). Une fois le fix pose, ce
// fichier doit executer sans crash et toutes les assertions doivent
// passer, avec le meme comportement que le temoin FR (cChampArrFr).
Trace("=== fix/1204 : champ classe tableau, article EN 'an' ===")

oEnAn est un cChampArrEnAn()
oEnAn.tabCases.Add(30)
oEnAn.tabCases.Ajoute(40)
dbgVérifieEgalité(Taille(oEnAn.tabCases), 2, "EN 'an' : champ tableau, 2 elements apres Add+Ajoute")
dbgVérifieEgalité(oEnAn.tabCases[1], 30, "EN 'an' : lecture element 1 via Add")
dbgVérifieEgalité(oEnAn.tabCases[2], 40, "EN 'an' : lecture element 2 via Ajoute")

dbgBilanTest()
