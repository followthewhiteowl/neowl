//  : champ de classe tableau dynamique declare avec l'article EN
// 'a' (is a array of X) n'est aujourd'hui PAS construit comme un vrai
// tableau dynamique -> premier appel de methode collection crashe au
// runtime ("No method ... for this type"). Une fois le fix pose, ce
// fichier doit executer sans crash et toutes les assertions doivent
// passer, avec le meme comportement que le temoin FR (cChampArrFr).
Trace("=== fix/1204 : champ classe tableau, article EN 'a' ===")

oEnA est un cChampArrEnA()
oEnA.tabCases.Ajoute(10)
oEnA.tabCases.Add(20)
dbgVérifieEgalité(Taille(oEnA.tabCases), 2, "EN 'a' : champ tableau, 2 elements apres Ajoute+Add")
dbgVérifieEgalité(oEnA.tabCases[1], 10, "EN 'a' : lecture element 1 via Ajoute")
dbgVérifieEgalité(oEnA.tabCases[2], 20, "EN 'a' : lecture element 2 via Add")

dbgBilanTest()
