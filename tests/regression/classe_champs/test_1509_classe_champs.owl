//  : verrou d'execution pour la classe voisine cGrande1509.owl
// (300 champs). Verifie l'instanciation, l'acces direct aux membres et
// l'acces depuis une methode, pas seulement que le fichier compile.

o est un cGrande1509

dbgVérifieEgalité(o.membre0300, 0, "champ jamais ecrit conserve sa valeur par defaut")

o.Remplir()

dbgVérifieEgalité(o.membre0001, 21, "premier membre ecrit par la methode")
dbgVérifieEgalité(o.membre0150, 2150, "membre du milieu ecrit par la methode")
dbgVérifieEgalité(o.membre0300, 2300, "trois-centieme membre ecrit par la methode")
dbgVérifieEgalité(o.Somme(), 4471, "somme des trois membres lue depuis une methode")

o.membre0002 = 7
dbgVérifieEgalité(o.membre0002, 7, "ecriture directe sur un membre depuis l'exterieur")
dbgVérifieEgalité(o.membre0299, 0, "membre voisin jamais ecrit reste a sa valeur par defaut")
dbgBilanTest()
