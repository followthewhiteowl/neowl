// Fenêtre voisine — ressource compile-only pour test_event_families.owl.
// Témoin familles d'events mutualisees event_catalog_widgets.c :
//  - Bouton + Libelle acceptent surDoubleClic (FAM_MOUSE_BASIC mutualise)
//  - Saisie : surEntree/surSortie (FAM_FOCUS) + surValidation/surAChaqueModification
//  - Liste : surEntree/surSortie + surSelection
//  - Combo : surEntree/surSortie + surSelection + surOuverture/surFermeture
//  - Image : MOUSE_BASIC + ADVANCED + MENU + SCROLL + LAYOUT

FEN_TestEvents est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
	FIN

	BTN_X est un Champ Bouton
		PROPRIETES
			X = 0
			Y = 0
		FIN
		PROCEDURE surClic()
			Trace("BTN clic")
		FIN
		// Nouveau via mutualisation
		PROCEDURE surDoubleClic()
			Trace("BTN doubleClic mutualise")
		FIN
	FIN

	LIB_X est un Champ Libellé
		PROPRIETES
			X       = 0
			Y       = 30
			Libellé = "X"
		FIN
		PROCEDURE surClic()
			Trace("LIB clic")
		FIN
		PROCEDURE surDoubleClic()
			Trace("LIB doubleClic mutualise")
		FIN
	FIN

	SAI_X est un Champ Saisie
		PROPRIETES
			X = 0
			Y = 60
		FIN
		PROCEDURE surEntree()
			Trace("SAI focus in (FAM_FOCUS)")
		FIN
		PROCEDURE surSortie()
			Trace("SAI focus out (FAM_FOCUS)")
		FIN
		PROCEDURE surValidation()
			Trace("SAI valid (specific)")
		FIN
		PROCEDURE surAChaqueModification()
			Trace("SAI mod (specific)")
		FIN
	FIN

	LISTE_X est un Champ Liste
		PROPRIETES
			X = 0
			Y = 90
		FIN
		PROCEDURE surEntree()
			Trace("LISTE focus in (FAM_FOCUS)")
		FIN
		PROCEDURE surSélection()
			Trace("LISTE select")
		FIN
	FIN

	COMBO_X est un Champ Combo
		PROPRIETES
			X = 220
			Y = 90
		FIN
		PROCEDURE surEntree()
			Trace("COMBO focus in (FAM_FOCUS)")
		FIN
		PROCEDURE surSélection()
			Trace("COMBO select")
		FIN
		PROCEDURE surOuverture()
			Trace("COMBO open")
		FIN
		PROCEDURE surFermeture()
			Trace("COMBO close")
		FIN
	FIN

	IMG_X est un Champ Image
		PROPRIETES
			X       = 0
			Y       = 200
			Largeur = 100
			Hauteur = 100
		FIN
		PROCEDURE surClic()
			Trace("IMG clic (FAM_MOUSE_BASIC)")
		FIN
		PROCEDURE surBoutonGauche(x est un entier, y est un entier)
			Trace("IMG btn gauche (FAM_MOUSE_ADVANCED) ", x, ",", y)
		FIN
		PROCEDURE surMolette(mouvement est un entier, x est un entier, y est un entier)
			Trace("IMG molette ", mouvement)
		FIN
		PROCEDURE surMenuContextuel(x est un entier, y est un entier)
			Trace("IMG ctx menu ", x, ",", y)
		FIN
		PROCEDURE surChangementTaille(largeur est un entier, hauteur est un entier)
			Trace("IMG resize ", largeur, "x", hauteur)
		FIN
	FIN
FIN
