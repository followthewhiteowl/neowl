//  : meme piege d'aliasing que , un cran plus bas. Trois
// instances de la meme structure : le membre tableau construit pour l'une
// doit etre INDEPENDANT de celui des deux autres.
Rub est une Structure
	Items est un tableau de chaînes
FIN

un1 est un Rub
un2 est un Rub
un3 est un Rub

TableauAjoute(un1.Items, "A")
dbgVérifieEgalité(un1.Items..Occurrence, 1, "1553 : instance 1 : ajout")
dbgVérifieEgalité(un2.Items..Occurrence, 0, "1553 : instance 2 non affectée par l'ajout sur l'instance 1")
dbgVérifieEgalité(un3.Items..Occurrence, 0, "1553 : instance 3 non affectée par l'ajout sur l'instance 1")

TableauAjoute(un3.Items, "C1")
TableauAjoute(un3.Items, "C2")
dbgVérifieEgalité(un3.Items..Occurrence, 2, "1553 : instance 3 : deux ajouts")
dbgVérifieEgalité(un1.Items..Occurrence, 1, "1553 : instance 1 inchangée après ajout sur l'instance 3")
dbgVérifieEgalité(un2.Items..Occurrence, 0, "1553 : instance 2 toujours vide")
dbgVérifieEgalité(un1.Items[1], "A", "1553 : instance 1 : contenu propre")
dbgVérifieEgalité(un3.Items[1], "C1", "1553 : instance 3 : contenu propre, premier élément")
dbgVérifieEgalité(un3.Items[2], "C2", "1553 : instance 3 : contenu propre, second élément")
dbgBilanTest()
