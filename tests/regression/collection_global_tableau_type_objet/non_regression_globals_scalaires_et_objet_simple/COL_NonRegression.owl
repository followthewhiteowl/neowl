//  — verrou de non-régression : ces formes de GLOBAL de collection
// fonctionnaient déjà avant l'apparition du bug et doivent continuer à
// exposer leurs procédures après le fix.
COL_NonRegression est une CollectionDeProcédures
	GLOBAL
	gEntier est un entier
	gTexte est une chaîne
	gDate est une date
	gTableauAssocTexte est un tableau associatif de chaînes
	gRequêteObjet est un httpRequête

	PROCEDURE Initialise()
		gEntier = 7
		gTexte  = "valeur"
		gDate   = ChaîneVersDate("20260101")
		gTableauAssocTexte["clé"] = "présente"
		gRequêteObjet..URL = "https://example.org/base"
	FIN

	PROCEDURE LitEntier() : entier
		RENVOYER gEntier
	FIN

	PROCEDURE LitTexte() : chaîne
		RENVOYER gTexte
	FIN

	PROCEDURE LitDateFormatée() : chaîne
		RENVOYER DateVersChaîne(gDate, "AAAAMMJJ")
	FIN

	PROCEDURE LitTableauAssocTexte() : chaîne
		RENVOYER gTableauAssocTexte["clé"]
	FIN

	PROCEDURE LitURLObjet() : chaîne
		RENVOYER gRequêteObjet..URL
	FIN
FIN
