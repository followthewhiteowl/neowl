// Régression : déclaration multi-variables `a, b, c sont des <type>`.
// spécification de référence : pluralized `sont`/`are` déclare N variables du même type.

// ── 3 chaînes sans init ────────────────────────────────────────────
s1, s2, s3 sont des chaînes
s1 = "x"
s2 = "y"
s3 = "z"
dbgVérifieEgalité(s1, "x", "s1")
dbgVérifieEgalité(s2, "y", "s2")
dbgVérifieEgalité(s3, "z", "s3")

// ── 2 entiers avec init (même valeur pour tous) ────────────────────
p, q sont des entiers = 42
dbgVérifieEgalité(p, 42, "p init")
dbgVérifieEgalité(q, 42, "q init")

// ── 2 réels avec init ──────────────────────────────────────────────
x, y sont des réels = 3.14
dbgVérifieEgalité(x, 3.14, "x réel init")
dbgVérifieEgalité(y, 3.14, "y réel init")

// ── 4 chaînes, puis multi-assign depuis un découpage ───────────────
m1, m2, m3, m4 sont des chaînes
(m1, m2, m3, m4) = ChaîneDécoupe("a,b,c,d", ",")
dbgVérifieEgalité(m1, "a", "m1")
dbgVérifieEgalité(m2, "b", "m2")
dbgVérifieEgalité(m3, "c", "m3")
dbgVérifieEgalité(m4, "d", "m4")

// ── Alias anglais `are` ────────────────────────────────────────────
u, v, w are integers
u = 1
v = 2
w = 3
dbgVérifieEgalité(u + v + w, 6, "are integers")

// ── Une seule variable avec virgule mal placée tombe sur la syntaxe
// normale (pas multi-decl) — pas testable ici sans erreur attendue,
// mais on vérifie qu'une décl unique classique marche toujours.
solo est un entier = 10
dbgVérifieEgalité(solo, 10, "décl classique toujours OK")

dbgBilanTest()
