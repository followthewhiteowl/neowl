PROCEDURE Externe()
  ::m_b = HErrorInfo(hErrFullDetails)
  x = dbgInfo(dbgStack, dbgCallingProcess)
  < IF ExecutionTarget = ApplicationWindows OR ExecutionTarget = SiteWindows >
    ::m_c = HErrorInfo(hErrSystemCode)
  < END >
  y is /*unicode*/ multilingualString = < §$0001 § >
  z is /*unicode*/ multilingualString = StringBuild( < §$0000 § >, y)
END
