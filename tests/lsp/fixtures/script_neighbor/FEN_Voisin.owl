FEN_Voisin est une Fenêtre
	PROPRIETES
		Disposition = dispVerticale
		Largeur     = 400
		Hauteur     = 300
	FIN
	TABLE_X est un Champ Table
		PROPRIETES
			Étire = Vrai
		FIN
		COL_A est une Colonne
			PROPRIETES
				Libellé = "A"
				Type    = colTypeTexte
				Largeur = 100
			FIN
		FIN
	FIN
	PROCEDURE Peindre()
		i est un entier = 1
		TABLE_X[i].ColonneInexistante = "valeur bidon"
	FIN
FIN
