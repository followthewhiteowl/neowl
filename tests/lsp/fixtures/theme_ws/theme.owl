// Fixture LSP  B2 — fichier de theme designe. Bloc `est un Thème`
// declarant des styles nommes typés. La completion `theme.<prefix>` doit
// enumerer ces noms (et filtrer par type styleXxx quand le contexte le
// permet).

ThèmeFixture est un Thème
	boutonPrimaire est un styleBouton = {
		CadreExtérieur = { CouleurFond = Bleu }
	}

	boutonSecondaire est un styleBouton = {
		CadreExtérieur = { CouleurFond = Gris }
	}

	saisieCompacte est un styleSaisie = {
		ZoneSaisie = { RetraitGauche = 2 }
	}

	libelléIntro est un styleLibellé = {
		Libellé = { Couleur = Bleu }
	}

	listeAérée est un styleZoneRépétée = {
		LignesPaires = { CouleurFond = Gris }
	}
FIN
