//  : ZORGLUB_Valider a un prefixe non-canon, mais le projet voisin
// ne declare pas ActiveAvertissementConventionDeNommage. Comportement inchange : aucun
// avertissement.
FEN_Prefixe est une Fenêtre
	PROPRIETES
		Titre       = "Prefixe libre"
		Disposition = dispLibre
		Largeur     = 300
		Hauteur     = 200
	FIN

	ZORGLUB_Valider est un Champ Bouton
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 100
			Hauteur = 30
			Libellé = "Valider"
		FIN
	FIN
FIN
