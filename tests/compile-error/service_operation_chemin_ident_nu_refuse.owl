// Chemin attend une liste entre crochets. Un identifiant nu (sans
// crochets) à la place doit être refusé à la compilation.
ServiceSc est un ServiceREST
	PROPRIETES
		UrlBase = ["api"]
	FIN

	LitSc est une OpérationHTTP
		PROPRIETES
			Méthode  = httpGet
			Chemin   = httpGet
			Réponses = [httpOK]
			CodeÉtat = httpOK
		FIN
		PROCEDURE surRequête() : entier
			RENVOYER 0
		FIN
	FIN
FIN
