//  — un parametre de FENETRE declare avec un type utilisateur
// inexistant doit etre rejete (aucune STRUCTURE/CLASSE/ENUMERATION nommee
// 'Toto' n'existe). Avant le correctif ce cas passait en silence.
FEN_ParamTypeInconnu is a Window(p is Toto)
	PROPERTIES
		Title  = "FEN_ParamTypeInconnu"
		Layout = dispFree
	END
END
