// Modèle d'état réduit à un en-tête de page, sans Corps ni État héritier
// dans ce dossier : sert uniquement à prouver qu'un modèle de ce type ne
// peut pas être imprimé directement (non-imprimable, indépendamment de
// la présence ou non d'un Corps).

MOD_BandOnlyGarde est un ModèleÉtat
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	haut est un HautDePage
		PROPRIETES
			Hauteur = 15
		FIN
		Trace("Haut de page")
	FIN
FIN
