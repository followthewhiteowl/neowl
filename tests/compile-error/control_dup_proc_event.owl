// Compile-time error : 2 PROCEDURE surClic dans le meme bouton.
FEN_X est une Fenetre
	PROPRIETES
		Titre = "X"
		Disposition = dispLibre
	FIN
	BTN_OK est un Champ Bouton
		PROPRIETES
			Libelle = "OK"
		FIN
		PROCEDURE surClic()
			Trace("a")
		FIN
		PROCEDURE surClic()
			Trace("b")
		FIN
	FIN
FIN
