// Compile-time error : un appel vers
// une méthode surchargée ne peut pas se résoudre quand l'argument provient
// d'un appel à retour NON TYPÉ et que l'arité ne lève pas l'ambiguïté.
// L'erreur doit pointer le SITE D'APPEL (l'expression g()), jamais la
// déclaration de M.
cSondeAmbigue est une Classe
	PROCEDURE M(x est un entier) : chaîne
		RENVOYER "entier"
	FIN

	PROCEDURE M(x est une chaîne) : chaîne
		RENVOYER "chaine"
	FIN
FIN

PROCEDURE g()
	RENVOYER 1
FIN

PROCEDURE scenario_appel_ambigu()
	o est un cSondeAmbigue()
	o.M(g())
FIN
