//  : cas legitime — FormatAffichage enrichi sur une saisie MULTILIGNE
// est applique au runtime, donc aucun warning attendu.
FEN_FormatAffichageMultiligne est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN
	SAI_X est un Champ Saisie
		PROPRIETES
			X               = 10
			Y               = 10
			Largeur         = 150
			Hauteur         = 60
			TypeSaisie      = typSaisieMultiligne
			FormatAffichage = formatTexteRiche
		FIN
	FIN
FIN
