//  — verrouille la colonne (octet 1-indexée) du token en faute
// quand un type keyword accentué ("chaîne") précède sur la même ligne.
// Le scanner doit émettre l'octet-1-indexé exact du début de "entier",
// pas un décalage de +1 (cf. diagnostic du ticket).

PROCEDURE ColonneApresTypeAccentue(aaa est une chaîne = "x", bbb est un entier)
	RENVOYER bbb
FIN
