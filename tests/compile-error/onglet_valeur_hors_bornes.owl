// Compile-time error : Valeur (volet actif) hors bornes.
// Valeur est 1-based et doit rester entre 1 et le nombre de volets déclarés
// (ici 2) : borne détectable à la compilation, sans exécuter de code.
FEN_ValeurHorsBornes est une Fenêtre
	PROPRIETES
		Titre = "Test"
		Disposition = dispLibre
		Largeur = 400
		Hauteur = 300
	FIN

	ONG_X est un Champ Onglet
		PROPRIETES
			X = 10
			Y = 10
			Largeur = 380
			Hauteur = 250
			Valeur = 5
		FIN

		VOL_A est un Volet
			PROPRIETES
				Libellé = "A"
			FIN
		FIN

		VOL_B est un Volet
			PROPRIETES
				Libellé = "B"
			FIN
		FIN
	FIN
FIN
