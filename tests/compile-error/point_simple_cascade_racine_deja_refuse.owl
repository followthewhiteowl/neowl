// Racine en double point, feuille en point simple : la forme mixte est déjà
// refusée aujourd'hui — non-régression à figer, pas un nouveau comportement.

FEN_CascadeMixte est une Fenêtre
	PROPRIETES
		Largeur = 200
		Hauteur = 100
	FIN

	BTN_Style est un Champ Bouton
		PROPRIETES
			Libellé = "OK"
		FIN
	FIN

	PROCEDURE FinInitialisation()
		BTN_Style..Style.CadreExtérieur.Cadre.Arrondi = 7
	FIN
FIN
