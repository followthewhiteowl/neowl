// Compile-time error : deux colonnes qui ne different que par les accents.
// Invariant 2 (accent-insensible) : les deux graphies designent la meme
// colonne, une seule serait atteignable.
FEN_ColonneDoublonAccent est une Fenêtre
	PROPRIETES
		Titre = "Doublon de colonne (accents)"
	FIN

	TBL_Accent est un Champ Table
		PROPRIETES
			Largeur = 300
			Hauteur = 200
		FIN

		COL_Clé est une colonne
			PROPRIETES
				Libellé = "Premiere"
				Type    = colTypeTexte
			FIN
		FIN

		COL_Cle est une colonne
			PROPRIETES
				Libellé = "Seconde"
				Type    = colTypeTexte
			FIN
		FIN
	FIN
FIN
