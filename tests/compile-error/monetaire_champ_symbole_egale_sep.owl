//  — Champ Saisie dont le FormatMonétaire inline pose un symbole (',')
// égal au séparateur décimal (','). Ambigu au reparse. Refus AU COMPILE.
FEN_MonChampSymboleEgaleSep est une Fenêtre
	PROPRIETES
		Titre       = "Champ FormatMonétaire symbole = séparateur"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 120
	FIN
	SAI_MonSymboleEgaleSep est un Champ Saisie
		PROPRIETES
			X               = 10
			Y               = 10
			Largeur         = 180
			Hauteur         = 24
			TypeSaisie      = typSaisieMonétaire
			FormatMonétaire = {Symbole = ",", SéparateurMilliers = " ", SéparateurDécimal = ",", ChiffresAprèsVirgule = 2}
			Valeur          = ""
		FIN
	FIN
FIN
