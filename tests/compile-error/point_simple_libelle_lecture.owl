// Lecture d'une propriété de Libellé avec un point simple : refusé, même
// diagnostic qu'à l'écriture.

FEN_LibelleLecture est une Fenêtre
	PROPRIETES
		Largeur = 200
		Hauteur = 100
	FIN

	LIB_A est un Champ Libellé
		PROPRIETES
			Libellé = "x"
		FIN
	FIN

	PROCEDURE FinInitialisation()
		Trace(LIB_A.Libellé)
	FIN
FIN
