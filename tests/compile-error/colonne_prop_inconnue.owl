// Propriete inconnue dans le sous-bloc PROPRIETES d'une Colonne de Table :
// erreur compile attendue (miroir du comportement Bouton/Table/Conteneur).
// Les props valides qui precedent (dont MasqueAffichage) doivent passer sans
// bruit : une seule erreur nette, sur PropBidonInexistante, pas de cascade.
FEN_ColonnePropInconnue est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 300
	FIN

	TAB_Donnees est un Champ Table
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 380
			Hauteur = 250
		FIN

		COL_Date est une Colonne
			PROPRIETES
				Libellé         = "Date"
				Type            = colTypeDate
				Largeur         = 120
				Visible         = Vrai
				MasqueSaisie    = "99/99/9999"
				MasqueAffichage = "JJ/MM/AAAA"
				Couleur         = 0
				CouleurFond     = 16777215
				PropBidonInexistante = "zzz"
			FIN
		FIN
	FIN
FIN
