// fix/couleur-texte (suite ) — verrouille le littéral couleur inline
// `{ Rouge=…, Opacité=… }` posé sur le champ `Couleur` (texte) quand il est
// IMBRIQUÉ dans un littéral de type composé typé (`styleBouton = { Libellé =
// { Couleur = {...} } }`), symétrique du chemin déjà couvert pour
// `CouleurFond` ( L3.5, cf. couleur_litteral_inline_imbrique_style).
// Snapshot attendu : {"errors":[],"warnings":[]}.
styleTest est un styleBouton = {
	Libellé = {
		Couleur = {Rouge = 255, Vert = 255, Bleu = 255, Opacité = 200}
	}
}
Trace(styleTest)
