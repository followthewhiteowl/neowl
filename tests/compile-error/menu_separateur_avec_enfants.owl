//  (ticket A) — un MenuSéparateur est un bloc à part, sans
// sous-blocs.

FEN_MenuSeparateurEnfants est une Fenêtre
	PROPRIETES
		Disposition     = dispLibre
		Largeur         = 200
		Hauteur         = 100
		MenuPrincipal   = MNU_X
	FIN

	MNU_X est un MenuPrincipal
		SM_A est un SousMenu
			PROPRIETES
				Libellé = "Menu A"
			FIN

			SEP_1 est un MenuSéparateur
				OPT_X est une OptionMenu
					PROPRIETES
						Libellé = "Option X"
					FIN
				FIN
			FIN
		FIN
	FIN
FIN
