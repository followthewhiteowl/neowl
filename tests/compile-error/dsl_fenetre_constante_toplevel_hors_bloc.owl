// Une CONSTANTE top-level hors bloc Fenêtre est interdite dans un
// fichier-fenêtre (canon strict 1 fichier = 1 fenêtre, ).

CONSTANTE
	MAX_LIGNES = 100
FIN

FEN_Test est une Fenêtre
	PROPRIETES
		Titre       = "Test"
		Largeur     = 400
		Hauteur     = 300
		Disposition = dispLibre
	FIN

	LIB_X est un Libellé
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 100
			Hauteur = 30
			Libellé = "X"
		FIN
	FIN
FIN
