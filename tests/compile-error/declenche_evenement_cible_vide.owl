// Robustesse cible vide : une chaîne littérale vide ne désigne aucun champ =
// erreur compile, pas une résolution silencieuse.

FEN_DeclCibleVide est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN
	BTN_Ok est un Champ Bouton
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 100
			Hauteur = 30
			Libellé = "Ok"
		FIN
	FIN
	PROCEDURE Lance()
		DéclencheÉvénement("", evtClic)
	FIN
FIN
