//  (L3.5) — non-régression : les AUTRES littéraux { } (Cadre,
// Style, imbriqué Cadre dans CadreExtérieur) doivent continuer à compiler
// sans être affectés par le changement de propagation de type cible sur
// Couleur. Snapshot attendu : {"errors":[],"warnings":[]}.
cadreTest est un Cadre = {Epaisseur = 2, Arrondi = 8}
styleTest est un styleConteneur = {
	CadreExtérieur = {
		Cadre = {Epaisseur = 2, Arrondi = 8}
	}
}
Trace(cadreTest)
Trace(styleTest)
