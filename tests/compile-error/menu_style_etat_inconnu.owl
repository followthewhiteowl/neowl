//  — seul l'état survol existe pour une surface de style menu. Un état
// nommé autrement (ici « appui ») est refusé avec un message défensif, pas de
// swallow silencieux.

FEN_MenuStyleEtatInconnu est une Fenêtre
	PROPRIETES
		Disposition     = dispLibre
		Largeur         = 200
		Hauteur         = 100
		MenuPrincipal   = MNU_X
	FIN

	MNU_X est un MenuPrincipal
		PROPRIETES
			Style..Barre..Etats[appui]..CouleurFond = Rouge
		FIN

		SM_A est un SousMenu
			PROPRIETES
				Libellé = "Menu A"
			FIN
		FIN
	FIN
FIN
