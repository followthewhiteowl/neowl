//  (negatif) — fenetre voisine (compagnon). Reutilise Alt+O,
// legitime car c'est une fenetre distincte de FEN_PremiereFenetre.

FEN_SecondeFenetre est une Fenetre
	PROPRIETES
		Titre = "Seconde"
	FIN

	BTN_Ouvrir2 est un Champ Bouton
		PROPRIETES
			Libelle         = "Ouvrir"
			ToucheRaccourci = "Alt+O"
		FIN
	FIN
FIN
