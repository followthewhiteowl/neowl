//  (L3.5) — fenêtre voisine pour le cas d'erreur/succès du
// littéral couleur inline posé DIRECTEMENT sur une propriété typée couleur
// (SET direct, sans variable intermédiaire).
FEN_ProbeCouleur est une Fenêtre
	PROPRIETES
		Titre       = "Probe couleur"
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN

	SAI_Champ est un Champ Saisie
		PROPRIETES
			X = 20
			Y = 20
		FIN
	FIN
FIN
