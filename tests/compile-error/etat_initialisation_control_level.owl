// Bloc Initialisation obsolete au niveau sous-champ d'Etat.
// Le code d'initialisation se place dans le top-level (corps du champ).

ETAT_Test est un Etat
	PROPRIETES
		Format = formatA4
	FIN

	Corps_Principal est un Corps
		PROPRIETES
		FIN

		LBL_Info est un Champ Libellé
			PROPRIETES
				Libellé = "Info"
			FIN

			PROCEDURE Initialisation()
				Trace("init etat champ")
			FIN
		FIN
	FIN
FIN
