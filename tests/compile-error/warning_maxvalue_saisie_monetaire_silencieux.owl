//  : non-regression — MaxValue est une borne legitime sur un Champ
// Saisie monetaire (forme EN, parite bilingue de la voie silencieuse
// aussi). Aucun warning ne doit apparaitre.
// Snapshot attendu : {"errors":[],"warnings":[]}.
FEN_MaxValueSaisieMonSilencieux est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN
	SAI_X est un Champ Saisie
		PROPRIETES
			X         = 10
			Y         = 10
			Largeur   = 150
			Hauteur   = 24
			InputType = typeInputCurrency
			MaxValue  = 1000
		FIN
	FIN
FIN
