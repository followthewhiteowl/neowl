// httpAuthAucune ne promet aucune protection : déclarer ce schéma ne doit
// PAS émettre le warning « déclarée mais pas appliquée », contrairement aux
// schémas protecteurs (Bearer / Basique / CléAPI). Ce service doit compiler
// sans erreur ET sans warning.
ServiceOuvert est un ServiceREST
	PROPRIETES
		UrlBase          = ["api", "public"]
		Authentification = httpAuthAucune
	FIN

	LitOuvert est une OpérationHTTP
		PROPRIETES
			Méthode  = httpGet
			Chemin   = ["clients", id]
			Réponses = [httpOK]
			CodeÉtat = httpOK
		FIN
		PROCEDURE surRequête(id est un entier) : entier
			RENVOYER id
		FIN
	FIN
FIN
