// Écriture d'une propriété de Libellé avec un point simple : refusé, le
// point simple n'est jamais l'opérateur de propriété.

FEN_LibelleEcriture est une Fenêtre
	PROPRIETES
		Largeur = 200
		Hauteur = 100
	FIN

	LIB_A est un Champ Libellé
		PROPRIETES
			Libellé = "x"
		FIN
	FIN

	PROCEDURE FinInitialisation()
		LIB_A.Libellé = "y"
	FIN
FIN
