// Le corps d'un état de volet est un style plat : des couleurs, et rien
// d'autre. Un Arrondi y est donc refusé — avec la même facture de message que
// Police ou Etats, dans les deux écritures d'un Champ Onglet (littéral inline
// et cascade), exactement comme le refuse déjà la même déclaration écrite dans
// un thème ou sur une variable typée (« Champ 'Arrondi' inconnu sur type
// styleVoletBase »).
//
// L'arrondi d'un volet se pose sur le volet lui-même, pas par état.

FEN_OngletStyleArrondiParEtat est une Fenêtre
	PROPRIETES
		Titre       = "Test"
		Disposition = dispLibre
		Largeur     = 520
		Hauteur     = 360
	FIN

	ONG_Inline est un Champ Onglet
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 480
			Hauteur = 150
			Valeur  = 1

			Style = {
				VoletActif = {
					CouleurFond = Blanc
					Arrondi     = 12
					Etats       = {
						Survol = {
							CouleurFond = RVB(255, 0, 255)
							Arrondi     = 8
						}
					}
				}
			}
		FIN

		VOL_InlineA est un Volet
			PROPRIETES
				Libellé     = "A"
				Disposition = dispLibre
			FIN
		FIN

		VOL_InlineB est un Volet
			PROPRIETES
				Libellé     = "B"
				Disposition = dispLibre
			FIN
		FIN
	FIN

	ONG_Cascade est un Champ Onglet
		PROPRIETES
			X       = 10
			Y       = 180
			Largeur = 480
			Hauteur = 150
			Valeur  = 1

			Style..VoletActif..CouleurFond                = Blanc
			Style..VoletActif..Arrondi                    = 12
			Style..VoletActif..Etats[survol]..CouleurFond = RVB(255, 0, 255)
			Style..VoletActif..Etats[survol]..Arrondi     = 8
		FIN

		VOL_CascadeA est un Volet
			PROPRIETES
				Libellé     = "A"
				Disposition = dispLibre
			FIN
		FIN

		VOL_CascadeB est un Volet
			PROPRIETES
				Libellé     = "B"
				Disposition = dispLibre
			FIN
		FIN
	FIN
FIN
