// Chaîne de 3 affectations `MoiMême..prop = <constante>` d'affilée : chaque
// `MoiMême..` repart d'un récepteur vierge, aucune constante précédente ne
// traîne.

FEN_MoiMemeTripleProp est une Fenêtre
	PROPRIETES
		Titre       = "Probe"
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 200
	FIN

	BTN_Z est un Champ Bouton
		PROPRIETES
			Libellé = "clic"
			X       = 10
			Y       = 10
			Largeur = 100
			Hauteur = 30
		FIN
		PROCEDURE surClic()
			MoiMême..Couleur     = RougeClair
			MoiMême..CouleurFond = BleuClair
			MoiMême..Couleur     = VertClair
		FIN
	FIN
FIN
