// Compile-time error : deux OptionMenu homonymes sous le meme parent.
// Les deux entrees sont montees dans le menu, mais la resolution par nom
// (TestSimuleMenu, MenuContextuel, ...) n'atteint que la premiere.
FEN_MenuNoeudDoublon est une Fenêtre
	PROPRIETES
		Titre         = "Doublon de noeud de menu"
		MenuPrincipal = MNU_NoeudDoublon
	FIN

	MNU_NoeudDoublon est un MenuPrincipal
		SM_Fichier est un SousMenu
			PROPRIETES
				Libellé = "&Fichier"
			FIN

			OPT_Doublon est une OptionMenu
				PROPRIETES
					Libellé = "&Un"
				FIN
			FIN

			OPT_Doublon est une OptionMenu
				PROPRIETES
					Libellé = "&Deux"
				FIN
			FIN

			// Une option saine APRES le doublon : la faute ne doit pas
			// desynchroniser le parcours du reste de l'arbre de menu.
			OPT_Suite est une OptionMenu
				PROPRIETES
					Libellé = "&Suite"
				FIN
			FIN
		FIN
	FIN
FIN
