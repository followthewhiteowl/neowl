// Robustesse événement : le 2e argument doit être une constante evt*. Une
// autre constante connue (chGauche, cadrage horizontal) n'est pas un
// événement = erreur compile spécifique.

FEN_DeclEvtInvalide est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN
	BTN_Ok est un Champ Bouton
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 100
			Hauteur = 30
			Libellé = "Ok"
		FIN
	FIN
	PROCEDURE Lance()
		DéclencheÉvénement(BTN_Ok, chGauche)
	FIN
FIN
