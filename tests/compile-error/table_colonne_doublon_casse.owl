// Compile-time error : deux colonnes qui ne different que par la casse.
// Invariant 1 (casse-insensible) : les deux graphies designent la meme
// colonne, une seule serait atteignable.
FEN_ColonneDoublonCasse est une Fenêtre
	PROPRIETES
		Titre = "Doublon de colonne (casse)"
	FIN

	TBL_Casse est un Champ Table
		PROPRIETES
			Largeur = 300
			Hauteur = 200
		FIN

		COL_Cle est une colonne
			PROPRIETES
				Libellé = "Premiere"
				Type    = colTypeTexte
			FIN
		FIN

		col_cle est une colonne
			PROPRIETES
				Libellé = "Seconde"
				Type    = colTypeTexte
			FIN
		FIN
	FIN
FIN
