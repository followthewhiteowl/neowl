FEN_NuBouton est une Fenêtre
	PROPRIETES
		Titre       = "Test"
		Largeur     = 300
		Hauteur     = 200
		Disposition = dispLibre
	FIN

	BTN_X est un Bouton
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 80
			Hauteur = 30
			Libellé = "OK"
		FIN
	FIN
FIN
