//  : ZORGLUB_Reference est une Colonne dans TABLE_Commandes, dont
// le prefixe ne correspond pas au prefixe canonique COL_. ActiveAvertissementConventionDeNommage
// =Vrai doit lever un avertissement citant COL_.
FEN_Prefixe est une Fenêtre
	PROPRIETES
		Titre       = "Colonne non canonique"
		Disposition = dispLibre
		Largeur     = 300
		Hauteur     = 200
	FIN

	TABLE_Commandes est un Champ Table
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 200
			Hauteur = 150
		FIN

		ZORGLUB_Reference est une Colonne
			PROPRIETES
				Libellé = "Reference"
				Type    = colTypeTexte
				Largeur = 100
			FIN
		FIN
	FIN
FIN
