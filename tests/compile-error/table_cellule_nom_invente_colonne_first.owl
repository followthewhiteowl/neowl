// Meme trou, forme colonne-first : TABLE_X.<nom>[ligne]. Un nom qui n'est
// pas une colonne declaree de TABLE_Y doit etre refuse comme dans la forme
// ligne-first (TABLE_X[ligne].<nom>), pas seulement echouer au runtime avec
// un message generique d'indexation.

FEN_TableSacPropsColFirst est une Fenêtre
	PROPRIETES
		Disposition = dispVerticale
		Largeur     = 400
		Hauteur     = 300
	FIN
	TABLE_Y est un Champ Table
		PROPRIETES
			Étire = Vrai
		FIN
		COL_B est une Colonne
			PROPRIETES
				Libellé = "B"
				Type    = colTypeTexte
				Largeur = 100
			FIN
		FIN
	FIN
	PROCEDURE Peindre()
		i est un entier = 1
		TABLE_Y.ZuTruc77[i] = "valeur bidon"
		rLecture1465 est une chaîne = TABLE_Y.ZuTruc77[i]
	FIN
FIN
