// Méthode attend un identifiant unique de l'énumération httpMéthodes,
// pas une liste. Une liste à la place doit être refusée à la
// compilation.
ServiceSf est un ServiceREST
	PROPRIETES
		UrlBase = ["api"]
	FIN

	LitSf est une OpérationHTTP
		PROPRIETES
			Méthode  = ["httpGet"]
			Chemin   = ["clients"]
			Réponses = [httpOK]
			CodeÉtat = httpOK
		FIN
		PROCEDURE surRequête() : entier
			RENVOYER 0
		FIN
	FIN
FIN
