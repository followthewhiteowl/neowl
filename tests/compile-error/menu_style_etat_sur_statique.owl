//  — exigence non-négociable : un SousMenu est statique, il n'a pas
// d'états. Poser Etats[...] sur la surface SousMenu est refusé avec un message
// défensif. Seules les surfaces Barre et OptionMenu portent un état survol.

FEN_MenuStyleEtatSurStatique est une Fenêtre
	PROPRIETES
		Disposition     = dispLibre
		Largeur         = 200
		Hauteur         = 100
		MenuPrincipal   = MNU_X
	FIN

	MNU_X est un MenuPrincipal
		PROPRIETES
			Style..SousMenu..Etats[survol]..CouleurFond = Rouge
		FIN

		SM_A est un SousMenu
			PROPRIETES
				Libellé = "Menu A"
			FIN
		FIN
	FIN
FIN
