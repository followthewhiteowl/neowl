// La police d'un menu se règle uniquement sur l'état de base, pas au survol.
// Poser Police sous Etats[survol] (forme Style..Surface..) est refusé : seules
// les couleurs varient par état sur un menu. Forme « statement ».

FEN_MenuStylePoliceSurvol est une Fenêtre
	PROPRIETES
		Disposition     = dispLibre
		Largeur         = 200
		Hauteur         = 100
		MenuPrincipal   = MNU_X
	FIN

	MNU_X est un MenuPrincipal
		PROPRIETES
			Style..Barre..Etats[survol]..Police..Nom = iPoliceGeorgia
		FIN

		SM_A est un SousMenu
			PROPRIETES
				Libellé = "Menu A"
			FIN
		FIN
	FIN
FIN
