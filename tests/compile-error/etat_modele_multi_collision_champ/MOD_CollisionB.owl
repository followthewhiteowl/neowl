// Second modèle utilisé par test_etat_modele_multi_collision_champ.owl.
//
// Déclare un champ LBL_Duplique, même nom que celui de MOD_CollisionA
// (voisin) : collision inter-modèles quand ETAT_MultiCollision hérite
// des deux.

MOD_CollisionB est un ModèleÉtat
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	Corps est un Corps
		PROPRIETES
			Hauteur = 40
		FIN

		LBL_Duplique est un Champ Libellé
			PROPRIETES
				X       = 10
				Y       = 20
				Largeur = 100
				Hauteur = 10
				Libellé = "depuis MOD_CollisionB"
			FIN
		FIN
	FIN
FIN
