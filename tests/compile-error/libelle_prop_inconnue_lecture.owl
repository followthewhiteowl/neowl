// Propriete inconnue lue depuis code sur un Libelle : erreur compile attendue.
// LIB_X..PropPas n'existe pas pour Libelle.
// Doit produire E_SEM_DSL_PROP_UNKNOWN_FOR_KIND.
// Aujourd'hui : aucune erreur emise. Bug .

FEN_LibellePropInconnue est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN
	LIB_X est un Champ Libellé
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 100
			Hauteur = 20
			Libellé = "label"
		FIN
	FIN
	PROCEDURE Lire()
		LIB_X..PropPas
	FIN
FIN
