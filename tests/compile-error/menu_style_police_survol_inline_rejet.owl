// La police d'un menu se règle uniquement sur l'état de base, pas au survol.
// Même refus par la forme littérale inline `Style = { ... Etats[survol] = {
// Police = { ... } } }` : le bloc Police sous survol est rejeté.

FEN_MenuStylePoliceSurvolInline est une Fenêtre
	PROPRIETES
		Disposition     = dispLibre
		Largeur         = 200
		Hauteur         = 100
		MenuPrincipal   = MNU_X
	FIN

	MNU_X est un MenuPrincipal
		PROPRIETES
			Style = { Barre = { Etats[survol] = { Police = { Gras = Vrai } } } }
		FIN

		SM_A est un SousMenu
			PROPRIETES
				Libellé = "Menu A"
			FIN
		FIN
	FIN
FIN
