//  (L3.6) — variante fenêtre du cas voisin
// couleur_litteral_direct_propriete_champ.owl : le littéral couleur inline
// posé DIRECTEMENT sur la propriété CouleurFond de la Fenêtre elle-même
// (racine PROPRIETES, pas un sous-champ) doit aussi compiler — même chemin
// de parsing (window_parse_property_init), même erreur aujourd'hui.
// Snapshot attendu : {"errors":[],"warnings":[]}.
FEN_ProbeCouleurDirectePropFenetre est une Fenêtre
	PROPRIETES
		Titre       = "Probe couleur directe fenêtre"
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
		CouleurFond = {Rouge = 255, Vert = 255, Bleu = 255, Opacité = 180}
	FIN
FIN
