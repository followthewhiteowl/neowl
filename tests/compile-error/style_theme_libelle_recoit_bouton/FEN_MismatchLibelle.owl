// Un Champ Libellé attend un styleLibellé. Lui affecter un style nommé
// styleBouton (theme.btnOk) doit être rejeté à la compilation.
//
// ROUGE attendu : le check type-vs-genre n'existe pas encore, la
// compilation passe aujourd'hui sans erreur. .expected.json provisoire —
// à régénérer post-impl (message/position exacts laissés à l'implémenteur).
FEN_MismatchLibelle est une Fenêtre
	PROPRIETES
		Titre       = "Mismatch libellé"
		Disposition = dispLibre
		Largeur     = 300
		Hauteur     = 120
	FIN

	LIB_x est un Champ Libellé
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 200
			Hauteur = 24
			Libellé = "X"
			Style   = theme.btnOk
		FIN
	FIN
FIN
