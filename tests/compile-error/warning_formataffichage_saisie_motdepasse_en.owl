//  : parite bilingue — la forme EN canon (InputType/typeInputPassword,
// DisplayFormat/formatRichText) doit declencher le meme warning que la FR.
FEN_FormatAffichageMotDePasseEN est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN
	SAI_X est un Champ Saisie
		PROPRIETES
			X             = 10
			Y             = 10
			Largeur       = 150
			Hauteur       = 24
			InputType     = typeInputPassword
			DisplayFormat = formatRichText
		FIN
	FIN
FIN
