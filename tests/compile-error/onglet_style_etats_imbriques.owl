//  — le corps d'un état de volet est un style plat (couleurs seules) :
// il ne porte pas de membre Etats. Un Etats imbriqué dans un Etats est donc
// refusé, exactement comme sur les autres familles de style écrites en
// littéral (« Champ 'Etats' inconnu sur type styleZoneSaisieBase »).
//
// Sans ce refus, le bloc imbriqué était avalé en silence ET écrasait la
// couleur de l'état qui l'englobe : perte de style sans le moindre message.

FEN_OngletStyleEtatsImbriques est une Fenêtre
	PROPRIETES
		Titre       = "Test"
		Disposition = dispLibre
		Largeur     = 520
		Hauteur     = 200
	FIN

	ONG_X est un Champ Onglet
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 480
			Hauteur = 160
			Valeur  = 1

			Style = {
				VoletActif = {
					Etats = {
						Survol = {
							CouleurFond = RVB(255, 0, 0)
							Etats       = {
								Survol = { CouleurFond = RVB(0, 255, 0) }
							}
						}
					}
				}
			}
		FIN

		VOL_A est un Volet
			PROPRIETES
				Libellé     = "A"
				Disposition = dispLibre
			FIN
		FIN

		VOL_B est un Volet
			PROPRIETES
				Libellé     = "B"
				Disposition = dispLibre
			FIN
		FIN
	FIN
FIN
