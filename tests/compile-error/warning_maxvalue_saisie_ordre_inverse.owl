//  durcissement : ordre inverse (BorneMax AVANT TypeSaisie) — le warning
// doit sortir pareil (detection independante de l'ordre des proprietes).
FEN_MaxValueOrdreInverse est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN
	SAI_X est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 10
			Largeur    = 150
			Hauteur    = 24
			BorneMax   = 90
			TypeSaisie = typSaisieTexte
		FIN
	FIN
FIN
