// Deux styles voisins : l'un juste en deçà de la soixantaine de caractères,
// l'autre juste au-delà. Les deux sont encapsulés, les deux se refusent en
// nom nu — aucun seuil de longueur ne fait décrocher le diagnostic.
ThèmeNomLong est un Thème
	stChampDeSaisiePrincipalDuFormulaireDeCommandeAvecEtatsDeSurvol est un styleSaisie = {
		ZoneSaisie = { CouleurFond = Blanc }
	}
	stSaisiePrincipaleDuFormulaireDeCommandeAvecEtatsSurvolFocusAppui est un styleSaisie = {
		ZoneSaisie = { CouleurFond = Rouge }
	}
FIN
