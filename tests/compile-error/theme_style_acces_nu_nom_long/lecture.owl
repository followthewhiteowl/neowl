// Les deux styles lus par leur nom nu : deux refus orientés attendus, qui
// nomment le thème propriétaire et donnent la forme qualifiée.
nFondCourt est un entier = stChampDeSaisiePrincipalDuFormulaireDeCommandeAvecEtatsDeSurvol..ZoneSaisie..CouleurFond
nFondLong est un entier = stSaisiePrincipaleDuFormulaireDeCommandeAvecEtatsSurvolFocusAppui..ZoneSaisie..CouleurFond
Trace(nFondCourt)
Trace(nFondLong)
