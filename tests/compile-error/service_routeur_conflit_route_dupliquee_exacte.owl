// Deux OpérationHTTP de même méthode avec exactement le même chemin
// (mêmes segments littéraux) sont une route dupliquée : requête ambiguë,
// aucune spécificité ne peut trancher puisque les motifs sont identiques.
// Refusé à la compilation, même si les noms d'opération diffèrent.
// DRAFT test_writer (chantier 2, ) — rouge à tort aujourd'hui
// (compile sans erreur, l'analyseur n'existe pas encore).
ServiceRouteurConflitDuplicata est un ServiceREST
	PROPRIETES
		UrlBase = ["api", "v1", "clients"]
	FIN

	ListeActifs est une OpérationHTTP
		PROPRIETES
			Méthode  = httpGet
			Chemin   = ["actifs"]
			Réponses = [httpOK]
			CodeÉtat = httpOK
		FIN
		PROCEDURE surRequête() : entier
			RENVOYER 0
		FIN
	FIN

	ListeActifsBis est une OpérationHTTP
		PROPRIETES
			Méthode  = httpGet
			Chemin   = ["actifs"]
			Réponses = [httpOK]
			CodeÉtat = httpOK
		FIN
		PROCEDURE surRequête() : entier
			RENVOYER 1
		FIN
	FIN
FIN
