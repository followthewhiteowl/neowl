//  : la famille texte couvre aussi le multiligne — BorneMax reste
// sans effet dessus, le warning doit se declencher pareil que sur le
// Champ Saisie texte simple.
FEN_MaxValueSaisieMultiligne est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN
	SAI_X est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 10
			Largeur    = 150
			Hauteur    = 60
			TypeSaisie = typSaisieMultiligne
			BorneMax   = 90
		FIN
	FIN
FIN
