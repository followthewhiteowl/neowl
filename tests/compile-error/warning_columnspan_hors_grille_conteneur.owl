//  : ColSpan sur un champ enfant d'un Conteneur en dispHorizontale
// (pas dispGrille) -> warning. Le check porte sur le parent direct
// (le Conteneur), pas sur la fenetre racine.
FEN_ColSpanConteneur est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
	FIN
	BAR est un Champ Conteneur
		PROPRIETES
			Disposition = dispHorizontale
		FIN
		BTN_A est un Champ Bouton
			PROPRIETES
				ColSpan = 2
				Libellé = "Test"
			FIN
		FIN
	FIN
FIN
