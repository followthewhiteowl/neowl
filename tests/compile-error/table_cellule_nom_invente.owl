// Sac de proprietes dynamique sur le descripteur de ligne : un nom qui
// n'est ni une colonne declaree, ni une propriete du type Table, est
// accepte silencieusement en lecture ET en ecriture.
// Attendu : erreur nommant la Table, le nom fautif et les colonnes reelles.

FEN_TableSacProps est une Fenêtre
	PROPRIETES
		Disposition = dispVerticale
		Largeur     = 400
		Hauteur     = 300
	FIN
	TABLE_X est un Champ Table
		PROPRIETES
			Étire = Vrai
		FIN
		COL_A est une Colonne
			PROPRIETES
				Libellé = "A"
				Type    = colTypeTexte
				Largeur = 100
			FIN
		FIN
	FIN
	PROCEDURE Peindre()
		i est un entier = 1
		TABLE_X[i].ZuTruc42 = "valeur bidon"
		rLecture1465 est une chaîne = TABLE_X[i].ZuTruc42
	FIN
FIN
