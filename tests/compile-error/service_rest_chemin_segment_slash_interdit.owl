// Un segment de Chemin/UrlBase ne doit jamais contenir de "/" : chaque
// segment est un composant de chemin unique, pas un sous-chemin complet.
// DRAFT test_writer.
ServiceClients est un ServiceREST
	PROPRIETES
		UrlBase = ["api", "v1", "clients"]
	FIN

	LitClient est une OpérationHTTP
		PROPRIETES
			Méthode  = httpGet
			Chemin   = ["clients/détail", id]
			Réponses = [httpOK]
			CodeÉtat = httpOK
		FIN
		PROCEDURE surRequête(id est un entier) : entier
			RENVOYER id
		FIN
	FIN
FIN
