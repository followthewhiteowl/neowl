// Le style nommé écrit sur le MenuPrincipal n'existe pas dans le thème
// voisin (menuPrincipale au lieu de menuPrincipal). Attendu : un
// avertissement, aucune erreur.
FEN_MenuNomInconnu est une Fenêtre
	PROPRIETES
		Titre         = "Menu, nom de style inconnu"
		Disposition   = dispLibre
		Largeur       = 300
		Hauteur       = 120
		MenuPrincipal = MNU_x
	FIN

	MNU_x est un MenuPrincipal
		PROPRIETES
			Style = theme.menuPrincipale
		FIN

		SM_Fichier est un SousMenu
			PROPRIETES
				Libellé = "&Fichier"
			FIN

			OPT_Quitter est une OptionMenu
				PROPRIETES
					Libellé = "&Quitter"
				FIN
			FIN
		FIN
	FIN
FIN
