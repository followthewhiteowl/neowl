//  : symetrie MinValue/BorneMin — meme defaut que BorneMax sur un
// Champ Saisie duree, doit lever le meme type de warning.
FEN_MinValueSaisieDuree est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN
	SAI_X est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 10
			Largeur    = 150
			Hauteur    = 24
			TypeSaisie = typSaisieDurée
			BorneMin   = 5
		FIN
	FIN
FIN
