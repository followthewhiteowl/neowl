//  (negatif) — deux boutons avec des raccourcis DISTINCTS
// (Alt+O vs Alt+F) : aucun warning attendu.

FEN_OkDistinct est une Fenetre
	PROPRIETES
		Titre = "Distinct"
	FIN

	BTN_Ouvrir est un Champ Bouton
		PROPRIETES
			Libelle         = "Ouvrir"
			ToucheRaccourci = "Alt+O"
		FIN
	FIN

	BTN_Fermer est un Champ Bouton
		PROPRIETES
			Libelle         = "Fermer"
			ToucheRaccourci = "Alt+F"
		FIN
	FIN
FIN
