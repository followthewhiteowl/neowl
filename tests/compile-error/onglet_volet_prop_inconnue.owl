// Compile-time error : propriété inconnue dans PROPRIETES d'un Volet.
FEN_VoletPropInconnue est une Fenêtre
	PROPRIETES
		Titre = "Test"
		Disposition = dispLibre
		Largeur = 400
		Hauteur = 300
	FIN

	ONG_X est un Champ Onglet
		PROPRIETES
			X = 10
			Y = 10
			Largeur = 380
			Hauteur = 250
		FIN

		VOL_A est un Volet
			PROPRIETES
				Libellé = "A"
				PropBidon = 1
			FIN
		FIN
	FIN
FIN
