// Ligne entière désignée par un seul indice, suivie d'un nom de propriété de
// mise en forme inconnu (double point). La mise en forme d'une ligne partage
// le même jeu de propriétés qu'une cellule (Couleur/CouleurFond) : le message
// doit parler de propriété, pas de colonne inconnue.

FEN_PropInventeeLigne est une Fenêtre
	PROPRIETES
		Disposition = dispVerticale
		Largeur     = 400
		Hauteur     = 300
	FIN
	TABLE_X est un Champ Table
		PROPRIETES
			Étire = Vrai
		FIN
		COL_A est une Colonne
			PROPRIETES
				Libellé = "A"
				Type    = colTypeTexte
				Largeur = 100
			FIN
		FIN
	FIN
	PROCEDURE Peindre()
		TABLE_X[1]..ZuTruc42 = 42
	FIN
FIN
