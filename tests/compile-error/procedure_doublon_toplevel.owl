// Erreur compile attendue : deux PROCEDURE meme nom au top-level script.
// (Les doublons fenetre/classe sont deja couverts par control_dup_user_proc
// et poo_methode_dup_nom)

PROCEDURE Calculer(val est un entier) : entier
	RENVOYER val * 2
FIN

PROCEDURE Calculer(val est un entier) : entier
	RENVOYER val * 3
FIN

Trace(Calculer(10))
