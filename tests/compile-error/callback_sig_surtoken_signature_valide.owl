// Signature exacte attendue par SurToken : (chaîne, booléen). Doit compiler
// sans erreur, avant et après le durcissement du contrat de signature.

PROCEDURE AffichéChaqueMorceau(morceau est une chaîne, terminé est un booléen)
	Trace(morceau, terminé)
FIN

opts est un OptionsGénération
opts..SurToken = AffichéChaqueMorceau
