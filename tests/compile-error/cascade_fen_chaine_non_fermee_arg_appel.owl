w_Main est une Fenêtre
	PROPRIETES
		Titre   = "Principal"
		Largeur = 400
		Hauteur = 300
	FIN

	PROCEDURE Charger()
		sQuery est une chaine = "SELECT %FileName%"
		sFileName est une chaine = "doc.txt"
		sQuery = Remplace(sQuery, "%FileName%"", sFileName)
		Trace(sQuery)
	FIN

	PROCEDURE Traiter()
		POUR i = 1 À 10
			Trace(i)
		FIN
	FIN

	PROCEDURE Aide()
		Trace("aide")
	FIN
FIN
