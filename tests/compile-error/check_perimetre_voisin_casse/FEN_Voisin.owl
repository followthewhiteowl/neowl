// Compagnon volontairement invalide, et qui doit le RESTER : le type nomme
// plus bas n'existe pas et n'existera jamais. Ne pas le remplacer par une
// syntaxe « pas encore supportee » —  en a rendu une valide, ce
// compagnon s'est mis a compiler, et le controle est repasse au vert.
FEN_Voisin est une Fenêtre
	PROPRIETES
		Titre       = "Voisin"
		Largeur     = 400
		Hauteur     = 300
		Disposition = dispLibre
	FIN

	TABLE_X est un Champ Table
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 350
			Hauteur = 200
		FIN

		COL_A est une Colonne
			PROPRIETES
				Libellé = "A"
				Type    = colTypeTexte
				Largeur = 150
			FIN
		FIN
	FIN

	PROCEDURE Ecrit()
		compteur est un TypeQuiNexistePas
	FIN
FIN
