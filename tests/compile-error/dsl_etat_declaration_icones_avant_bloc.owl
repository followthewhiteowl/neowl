monIcone est une Icône = icones.maison

ETAT_Rapport est un État
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	corps est un Corps
		PROPRIETES
			Hauteur = 30
		FIN

		LIB_Titre est un Champ Libellé
			PROPRIETES
				X            = 10
				Y            = 10
				Largeur      = 190
				Hauteur      = 10
				Libellé      = "Titre"
				PoliceNom    = iPoliceLiberationSans
				PoliceTaille = 11
			FIN
		FIN
	FIN
FIN
