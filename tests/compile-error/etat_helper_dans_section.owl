//  : PROCEDURE a nom libre dans une section (EnTeteDocument) d'Etat.
// Politique canon : seul le top-level de l'Etat peut porter des procedures libres.
// Attendu : erreur compile (message provisoire — a confirmer par l'implementeur).

ETAT_HelperSection est un Etat
	PROPRIETES
		Format = formatA4
	FIN

	intro est un EnTeteDocument
		PROPRIETES
			Hauteur = 20
		FIN

		PROCEDURE HelperSection()
			RENVOYER 99
		FIN
	FIN

	corps est un corps
		PROPRIETES
			Hauteur = 40
		FIN
	FIN
FIN
