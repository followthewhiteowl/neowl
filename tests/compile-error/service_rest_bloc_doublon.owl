// Deux blocs ServiceREST déclarés avec le même nom (au niveau projet, comme
// les types) sont un doublon refusé à la compilation. DRAFT test_writer.
ServiceClients est un ServiceREST
	PROPRIETES
		UrlBase = ["api", "v1", "clients"]
	FIN

	LitClient est une OpérationHTTP
		PROPRIETES
			Méthode  = httpGet
			Chemin   = ["clients", id]
			Réponses = [httpOK]
			CodeÉtat = httpOK
		FIN
		PROCEDURE surRequête(id est un entier) : entier
			RENVOYER id
		FIN
	FIN
FIN

ServiceClients est un ServiceREST
	PROPRIETES
		UrlBase = ["api", "v2", "clients"]
	FIN

	AutreOp est une OpérationHTTP
		PROPRIETES
			Méthode  = httpGet
			Chemin   = ["clients"]
			Réponses = [httpOK]
			CodeÉtat = httpOK
		FIN
		PROCEDURE surRequête() : entier
			RENVOYER 0
		FIN
	FIN
FIN
