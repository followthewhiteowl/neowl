// Ressource fenêtre — voisine de entree.owl (fix/couleur-texte, suite ).
FEN_ProbeCouleurTexteCascade est une Fenêtre
	PROPRIETES
		Titre       = "Probe couleur texte cascade"
		Disposition = dispLibre
		Largeur     = 300
		Hauteur     = 200
	FIN

	MonBouton est un Champ Bouton
		PROPRIETES
			X       = 20
			Y       = 20
			Libellé = "Test"
		FIN
	FIN

	SAI_Champ est un Champ Saisie
		PROPRIETES
			X = 20
			Y = 60
		FIN
	FIN

	TAB_Champ est un Champ Table
		PROPRIETES
			X = 20
			Y = 100
		FIN

		COL_A est une Colonne
			PROPRIETES
				Libellé = "A"
				Type    = colTypeTexte
				Largeur = 100
			FIN
		FIN
	FIN
FIN
