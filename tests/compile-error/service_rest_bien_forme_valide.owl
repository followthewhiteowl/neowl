// Controle positif (chantier 1 DSL service, ) : un ServiceREST
// avec une seule OpérationHTTP bien formée doit compiler sans erreur.
// DRAFT test_writer — ServiceREST/OpérationHTTP n'existent pas encore
// dans le compilateur, ce fichier est rouge aujourd'hui pour la bonne
// raison ("Type inconnu 'ServiceREST'"). Il doit passer à errors:[]
// une fois le chantier implémenté.
ServiceClients est un ServiceREST
	PROPRIETES
		UrlBase          = ["api", "v1", "clients"]
		Authentification = httpAuthBearer
	FIN

	LitClient est une OpérationHTTP
		PROPRIETES
			Méthode  = httpGet
			Chemin   = ["clients", id]
			Réponses = [httpOK, httpNonTrouvé]
			CodeÉtat = httpOK
		FIN
		PROCEDURE surRequête(id est un entier) : entier
			RENVOYER id
		FIN
	FIN
FIN
