// Compile-time error : propriété inconnue dans PROPRIETES d'un Champ Table,
// suivie d'une colonne valide. Miroir du comportement Onglet/Volet
// (onglet_prop_inconnue.owl) : 1 erreur nette sur la propriété, la colonne
// parsée normalement.
FEN_TablePropInconnue est une Fenêtre
	PROPRIETES
		Titre       = "Test"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 300
	FIN

	TAB_X est un Champ Table
		PROPRIETES
			X         = 10
			Y         = 10
			Largeur   = 380
			Hauteur   = 250
			PropBidon = 1
		FIN

		COL_A est une Colonne
			PROPRIETES
				Libellé = "A"
			FIN
		FIN
	FIN
FIN
