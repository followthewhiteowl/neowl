// Propriété inconnue dans le bloc PROPRIETES du ServiceREST -> erreur de
// compilation nommée (miroir de prop_inconnue_fenetre_multi_erreurs.owl).
// DRAFT test_writer : rouge aujourd'hui ("Type inconnu 'ServiceREST'"),
// devra rougir pour "Propriété 'ProxyBidule' inconnue pour ServiceREST"
// une fois le chantier implémenté.
ServiceClients est un ServiceREST
	PROPRIETES
		UrlBase     = ["api", "v1", "clients"]
		ProxyBidule = "http://localhost"
	FIN

	LitClient est une OpérationHTTP
		PROPRIETES
			Méthode  = httpGet
			Chemin   = ["clients", id]
			Réponses = [httpOK]
			CodeÉtat = httpOK
		FIN
		PROCEDURE surRequête(id est un entier) : entier
			RENVOYER id
		FIN
	FIN
FIN
