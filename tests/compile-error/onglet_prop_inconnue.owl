	PROPRIETES
		Titre = "Test"
		Disposition = dispLibre
		Largeur = 400
		Hauteur = 300
	FIN

	ONG_X est un Champ Onglet
		PROPRIETES
			X = 10
			Y = 10
			Largeur = 380
			Hauteur = 250
			PropBidon = 1
		FIN

		VOL_A est un Volet
