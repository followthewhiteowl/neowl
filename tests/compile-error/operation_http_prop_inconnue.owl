// Propriété inconnue dans le bloc PROPRIETES d'une OpérationHTTP -> erreur
// de compilation nommée. DRAFT test_writer, rouge aujourd'hui faute
// d'implémentation du bloc lui-même.
ServiceClients est un ServiceREST
	PROPRIETES
		UrlBase = ["api", "v1", "clients"]
	FIN

	LitClient est une OpérationHTTP
		PROPRIETES
			Méthode    = httpGet
			Chemin     = ["clients", id]
			Réponses   = [httpOK]
			CodeÉtat   = httpOK
			CacheDurée = 60
		FIN
		PROCEDURE surRequête(id est un entier) : entier
			RENVOYER id
		FIN
	FIN
FIN
