// Compile-time error : miroir champ du doublon bilingue de fenetre. surClic
// et onClick sont le meme evenement du Champ Bouton ; les declarer tous deux
// laissait un des deux blocs mort.
FEN_ChampEventDoublonBilingue est une Fenêtre
	PROPRIETES
		Titre = "Doublon"
	FIN

	BTN_X est un Champ Bouton
		PROPRIETES
			Libellé = "x"
		FIN

		PROCEDURE surClic()
		FIN

		PROCEDURE onClick()
		FIN
	FIN
FIN
