//  P1 — bilinguisme (invariant 3) : les formes EN Stream (Flux ->
// Stream via le catalogue, streamSSE/streamBytes alias EN des membres httpFlux)
// sont acceptées à la compilation au même titre que les formes FR. Contrôle
// positif : doit compiler sans erreur (errors:[]).
StreamServiceEN est un ServiceREST
	PROPRIETES
		BaseUrl = ["api"]
	FIN

	StreamBytes est une HTTPOperation
		PROPRIETES
			Method  = httpGet
			Path    = ["stream"]
			Stream  = streamBytes
			MaxDelay = 60
		FIN
		PROCEDURE onRequest()
		FIN
	FIN
FIN
