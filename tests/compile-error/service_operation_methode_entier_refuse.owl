// Méthode attend un identifiant de l'énumération httpMéthodes. Un
// littéral entier à la place doit être refusé à la compilation.
ServiceSd est un ServiceREST
	PROPRIETES
		UrlBase = ["api"]
	FIN

	LitSd est une OpérationHTTP
		PROPRIETES
			Méthode  = 42
			Chemin   = ["clients"]
			Réponses = [httpOK]
			CodeÉtat = httpOK
		FIN
		PROCEDURE surRequête() : entier
			RENVOYER 0
		FIN
	FIN
FIN
