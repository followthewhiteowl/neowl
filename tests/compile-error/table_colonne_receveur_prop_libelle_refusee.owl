//  lot A — dès que 'COL_X..Couleur' résout (la colonne devient un
// receveur), 'COL_X..Libellé' doit rester refusé EXPLICITEMENT. Sans ce
// refus, l'affectation redevient un no-op silencieux : le
// libellé se règle en déclaration (bloc PROPRIETES), pas à chaud.
FEN_ColonneReceveurPropLibelle est une Fenêtre
	PROPRIETES
		Titre       = "Colonne receveur - Libellé refusé"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 300
	FIN

	TABLE_Unique est un Champ Table
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 300
			Hauteur = 200
		FIN

		COL_A est une Colonne
			PROPRIETES
				Libellé = "A"
				Type    = colTypeTexte
				Largeur = 100
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		COL_A..Libellé = "Nouveau libellé"
	FIN
FIN
