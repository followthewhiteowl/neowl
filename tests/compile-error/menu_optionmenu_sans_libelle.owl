//  (ticket A) — un OptionMenu sans Libellé n'a rien à afficher :
// erreur compile (edge case proactif, symétrique de SousMenu sans
// Libellé).

FEN_MenuOptionSansLibelle est une Fenêtre
	PROPRIETES
		Disposition     = dispLibre
		Largeur         = 200
		Hauteur         = 100
		MenuPrincipal   = MNU_X
	FIN

	MNU_X est un MenuPrincipal
		SM_A est un SousMenu
			PROPRIETES
				Libellé = "Menu A"
			FIN

			OPT_X est une OptionMenu
				PROCEDURE surSélection()
				FIN
			FIN
		FIN
	FIN
FIN
