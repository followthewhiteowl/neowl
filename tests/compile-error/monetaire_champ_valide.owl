//  — non-régression : un Champ Saisie dont le FormatMonétaire inline
// est valide (symbole '€' distinct, milliers ' ' ≠ décimal ',', aucun chiffre)
// ne produit AUCUNE erreur au compile. Snapshot attendu : {"errors":[],"warnings":[]}.
FEN_MonChampValide est une Fenêtre
	PROPRIETES
		Titre       = "Champ FormatMonétaire valide"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 120
	FIN
	SAI_MonValide est un Champ Saisie
		PROPRIETES
			X               = 10
			Y               = 10
			Largeur         = 180
			Hauteur         = 24
			TypeSaisie      = typSaisieMonétaire
			FormatMonétaire = {Symbole = "€", SéparateurMilliers = " ", SéparateurDécimal = ",", ChiffresAprèsVirgule = 2}
			Valeur          = ""
		FIN
	FIN
FIN
