// Compile-time error : un Volet sans Libellé.
// Libellé est le texte affiché sur l'onglet correspondant, obligatoire.
FEN_VoletSansLibelle est une Fenêtre
	PROPRIETES
		Titre = "Test"
		Disposition = dispLibre
		Largeur = 400
		Hauteur = 300
	FIN

	ONG_X est un Champ Onglet
		PROPRIETES
			X = 10
			Y = 10
			Largeur = 380
			Hauteur = 250
		FIN

		VOL_Sans est un Volet
			PROPRIETES
				Disposition = dispLibre
			FIN
		FIN
	FIN
FIN
