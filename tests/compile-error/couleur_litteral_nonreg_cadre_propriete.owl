//  (L3.6) — non-régression : le littéral inline `{ }` d'un autre
// slot OBJECT (Cadre, déjà géré avant ce chantier) posé DIRECTEMENT en
// PROPRIETES d'un champ doit continuer à compiler après l'élargissement de
// la propagation de type cible aux slots couleur. Snapshot attendu :
// {"errors":[],"warnings":[]}.
FEN_ProbeCadreLibellePropriete est une Fenêtre
	PROPRIETES
		Titre       = "Probe cadre libellé"
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN

	LIB_Champ est un Champ Libellé
		PROPRIETES
			X     = 20
			Y     = 20
			Cadre = {Epaisseur = 2, Arrondi = 8}
		FIN
	FIN
FIN
