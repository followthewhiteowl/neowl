// Erreur compile attendue : deux methodes meme nom (avant , 1-arg devient __set_ donc pas de collision)

cRect est une Classe
	nLargeur est un entier

	PROCEDURE Constructeur(l est un entier)
		:nLargeur = l
	FIN

	PROCEDURE Largeur() : entier
		RENVOYER :nLargeur
	FIN

	PROCEDURE Largeur(val est un entier)
		:nLargeur = val
	FIN
FIN

PROCEDURE scenario_test()
	rect est un cRect(10)
	dbgVérifieEgalité(rect.Largeur(), 10, "getter")
	rect.Largeur(20)
	dbgVérifieEgalité(rect.Largeur(), 20, "setter")
FIN
