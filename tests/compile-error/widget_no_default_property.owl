// Compile-error : un widget compose (Table, Interrupteur, ZoneRepetee)
// dont OwlControlKindInfo.defaultProperty == NULL refuse l'affectation
// directe `WIDGET = X`. Le compilo emet un message clair pointant
// l'alternative (..Champ ou fonctions natives dediees).

FEN_X est une Fenêtre
    PROPRIETES
        Titre = "Test"
    FIN
    TBL_Articles est un Champ Table
        PROPRIETES
            Visible = Vrai
        FIN

        COL_A est une colonne
            PROPRIETES
                Libellé = "A"
            FIN
        FIN
    FIN
FIN

TBL_Articles = "ligne TAB-separee"
