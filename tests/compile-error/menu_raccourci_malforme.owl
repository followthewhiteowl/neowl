//  (ticket A) — Raccourci malformé : ni un modificateur connu
// (Ctrl/Alt/Maj/Shift) ni une touche valide. Erreur compile plutôt qu'un
// accélérateur silencieusement ignoré au runtime.

FEN_MenuRaccourciMalforme est une Fenêtre
	PROPRIETES
		Disposition     = dispLibre
		Largeur         = 200
		Hauteur         = 100
		MenuPrincipal   = MNU_X
	FIN

	MNU_X est un MenuPrincipal
		SM_A est un SousMenu
			PROPRIETES
				Libellé = "Menu A"
			FIN

			OPT_X est une OptionMenu
				PROPRIETES
					Libellé   = "Option X"
					Raccourci = "Ctrl-+-N"
				FIN

				PROCEDURE surSélection()
				FIN
			FIN
		FIN
	FIN
FIN
