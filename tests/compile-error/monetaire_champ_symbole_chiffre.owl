//  — Champ Saisie dont le FormatMonétaire inline pose un symbole qui
// est un chiffre ('5'). Indistinguable des chiffres du montant. Refus AU
// COMPILE (extension au symbole).
FEN_MonChampSymboleChiffre est une Fenêtre
	PROPRIETES
		Titre       = "Champ FormatMonétaire symbole chiffre"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 120
	FIN
	SAI_MonSymboleChiffre est un Champ Saisie
		PROPRIETES
			X               = 10
			Y               = 10
			Largeur         = 180
			Hauteur         = 24
			TypeSaisie      = typSaisieMonétaire
			FormatMonétaire = {Symbole = "5", SéparateurMilliers = " ", SéparateurDécimal = ",", ChiffresAprèsVirgule = 2}
			Valeur          = ""
		FIN
	FIN
FIN
