//  : FormatAffichage est legitime sur un Libellé (hors Champ Saisie),
// le warning cross-prop ne doit PAS s'y declencher.
FEN_FormatAffichageLibelle est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN
	LIB_X est un Champ Libellé
		PROPRIETES
			X               = 10
			Y               = 10
			Largeur         = 150
			Hauteur         = 24
			FormatAffichage = formatTexteRiche
		FIN
	FIN
FIN
