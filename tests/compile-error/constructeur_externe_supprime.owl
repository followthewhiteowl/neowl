//  : rejection compile-error de l'ancienne syntaxe externe
// `PROCEDURE cClass()` au top-level (constructeur externe).
// Message attendu : "Les methodes externes ne sont plus supportees. Declarez
// le constructeur directement dans le corps de la classe via
// PROCEDURE Constructeur(...)."
cFoo est une Classe
PUBLIC
	n est un entier = 0
FIN

// Ancienne syntaxe constructeur externe (doit produire erreur)
PROCEDURE cFoo(init est un entier)
	:n = init
FIN
