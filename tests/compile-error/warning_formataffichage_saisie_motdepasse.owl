//  (support #313) : FormatAffichage enrichi sur un Champ Saisie mot de
// passe -> le format riche est ignore en silence au runtime (reserve aux
// saisies multilignes), le compilateur doit avertir.
FEN_FormatAffichageMotDePasse est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN
	SAI_X est un Champ Saisie
		PROPRIETES
			X               = 10
			Y               = 10
			Largeur         = 150
			Hauteur         = 24
			TypeSaisie      = typSaisieMotDePasse
			FormatAffichage = formatTexteRiche
		FIN
	FIN
FIN
