//  — un Champ Saisie dont le FormatNombre inline pose un séparateur
// contenant un chiffre ('0') : indistinguable des chiffres du nombre. Doit être
// refusé AU COMPILE, comme le projet.
FEN_ChampSepChiffre est une Fenêtre
	PROPRIETES
		Titre       = "Champ FormatNombre séparateur chiffre"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 120
	FIN
	SAI_Chiffre est un Champ Saisie
		PROPRIETES
			X            = 10
			Y            = 10
			Largeur      = 180
			Hauteur      = 24
			TypeSaisie   = typSaisieNum
			FormatNombre = {SéparateurMilliers = "0", SéparateurDécimal = ",", ChiffresAprèsVirgule = 2}
			Valeur       = ""
		FIN
	FIN
FIN
