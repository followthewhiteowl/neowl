//  (L3.6) — non-régression : le littéral inline dict réservé aux
// slots chaîneMultilingue (Libellé, Titre, Bulle...) posé DIRECTEMENT en
// PROPRIETES d'un champ doit continuer à compiler après l'élargissement de
// la propagation de type cible aux slots couleur (le fix ne doit PAS
// remplacer ni casser le chemin multilingue existant, seulement l'étendre).
// Snapshot attendu : {"errors":[],"warnings":[]}.
FEN_ProbeMultilinguePropriete est une Fenêtre
	PROPRIETES
		Titre       = "Probe multilingue"
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN

	LIB_Champ est un Champ Libellé
		PROPRIETES
			X       = 20
			Y       = 20
			Libellé = {langueFrançais: "Bonjour", langueAnglais: "Hello"}
		FIN
	FIN
FIN
