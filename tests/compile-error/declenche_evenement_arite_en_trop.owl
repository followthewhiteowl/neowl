// Robustesse arité : evtClic est un événement 0 paramètre. Fournir un
// paramètre supplémentaire (42) est une erreur compile — l'arité des params
// est validée contre la signature portée par la constante evt*.

FEN_DeclAriteEnTrop est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN
	BTN_Ok est un Champ Bouton
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 100
			Hauteur = 30
			Libellé = "Ok"
		FIN
	FIN
	PROCEDURE Lance()
		DéclencheÉvénement(BTN_Ok, evtClic, 42)
	FIN
FIN
