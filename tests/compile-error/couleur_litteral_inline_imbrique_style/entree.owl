//  (L3.5) — le littéral couleur inline doit compiler aussi quand
// il est IMBRIQUÉ dans un bloc Style (le chemin glassmorphisme :
// Style = { CadreExtérieur = { CouleurFond = { Rouge=…, Opacité=… } } }).
// Aujourd'hui : « Littéral { } sans type cible » sur le littéral le plus
// interne (le compilateur ne propage pas le type cible Couleur au champ
// CouleurFond du bloc CadreExtérieur). Snapshot attendu :
// {"errors":[],"warnings":[]}.
styleTest est un styleConteneur = {
	CadreExtérieur = {
		CouleurFond = { Rouge = 255, Vert = 128, Bleu = 0, Opacité = 200 }
	}
}
Trace(styleTest)
