// Non-régression : nom de style correct, thème désigné par le fichier projet,
// fenêtre vérifiée SEULE (le fichier projet n'est pas la cible du contrôle).
// Attendu : aucun avertissement, aucune erreur. C'est cette fixture qui
// protège du faux positif — un signalement ici invaliderait le dispositif.
FEN_NomConnu est une Fenêtre
	PROPRIETES
		Titre       = "Nom de style connu"
		Disposition = dispLibre
		Largeur     = 300
		Hauteur     = 120
	FIN

	SAI_x est un Champ Saisie
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 200
			Hauteur = 30
			Style   = theme.saisiePrincipale
		FIN
	FIN
FIN
