// Authentification attend un identifiant de l'énumération
// httpAuthentification. Un littéral entier à la place doit être refusé à
// la compilation.
ServiceSj est un ServiceREST
	PROPRIETES
		UrlBase          = ["api"]
		Authentification = 42
	FIN

	LitSj est une OpérationHTTP
		PROPRIETES
			Méthode  = httpGet
			Chemin   = ["clients"]
			Réponses = [httpOK]
			CodeÉtat = httpOK
		FIN
		PROCEDURE surRequête() : entier
			RENVOYER 0
		FIN
	FIN
FIN
