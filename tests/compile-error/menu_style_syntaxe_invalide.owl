//  — la propriété Police d'une surface de style menu exige un
// sous-attribut (Police..Gras, Police..Nom, Police..Taille, ...). Employée
// seule comme cible d'affectation, elle est refusée : syntaxe invalide.

FEN_MenuStyleSyntaxeInvalide est une Fenêtre
	PROPRIETES
		Disposition     = dispLibre
		Largeur         = 200
		Hauteur         = 100
		MenuPrincipal   = MNU_X
	FIN

	MNU_X est un MenuPrincipal
		PROPRIETES
			Style..Barre..Police = Rouge
		FIN

		SM_A est un SousMenu
			PROPRIETES
				Libellé = "Menu A"
			FIN
		FIN
	FIN
FIN
