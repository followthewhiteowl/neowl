// Un même nom de paramètre déclaré à la fois comme segment de Chemin ET dans
// Requête : deux sources de liaison pour un seul param — incohérent, refus
// attendu à la compilation (chaque param lié à exactement une source).
ServiceBindingDoubleSource est un ServiceREST
	PROPRIETES
		UrlBase = ["api", "v1", "items"]
	FIN

	LitItemDouble est une OpérationHTTP
		PROPRIETES
			Méthode  = httpGet
			Chemin   = ["items", id]
			Requête  = [id]
			Réponses = [httpOK]
			CodeÉtat = httpOK
		FIN
		PROCEDURE surRequête(id est un entier) : entier
			RENVOYER id
		FIN
	FIN
FIN
