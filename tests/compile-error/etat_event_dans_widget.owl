//  : non-regression — PROCEDURE AvantImpression (event connu) dans un widget d'Etat.
// Un event connu dans un widget de rapport reste accepte apres la politique helper-top-level-only.
// Attendu : 0 erreur.

ETAT_EventWidget est un Etat
	PROPRIETES
		Format = formatA4
	FIN

	corps est un corps
		PROPRIETES
			Hauteur = 40
		FIN

		LIB_Info est un Champ Libellé
			PROPRIETES
				Libellé = "info"
				X       = 10
				Y       = 10
				Largeur = 100
				Hauteur = 15
			FIN

			PROCEDURE AvantImpression()
				LIB_Info..Libellé = "avant"
			FIN
		FIN
	FIN
FIN
