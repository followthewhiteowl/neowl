//  — non-regression : une valeur de propriete = une VARIABLE
// declaree (expression legitime) compile toujours proprement. A ne pas
// casser par la garde "valeur manquante" posee sur le cas vide.
FEN_BulleVar est une Fenêtre
	PROPRIETES
		Titre = "Demo"
	FIN
	gTexteBulle est une chaîne = "Astuce"
	BTN_OK est un Champ Bouton
		PROPRIETES
			Libellé = "OK"
			Bulle   = gTexteBulle
			Largeur = 100
		FIN
	FIN
FIN
