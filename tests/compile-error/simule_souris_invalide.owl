// TestSimuleSouris avec valeur enum inexistante
TestModeHeadless(Vrai)

FEN_Demo est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN
	BTN_OK est un Bouton
		PROPRIETES
			X = 10
			Y = 10
		FIN
		PROCEDURE Clic()
			Trace("clic")
		FIN
	FIN
FIN

// Ligne suivante doit produire compile-error : ClicInexistant pas dans ActionSouris
TestSimuleSouris(BTN_OK, ClicInexistant)
