//  — valeur de propriete ABSENTE dans un bloc PROPRIETES d'un Champ
// Libellé d'Etat. Sister-parser etat_label_parse_property_init : meme faille
// que widget/fenetre, la propriete suivante (Visible) ne doit pas etre
// avalee comme valeur de Libellé.
ETAT_LibelleVide est un Etat
	PROPRIETES
		Format = formatA4
	FIN

	corps est un Corps
		PROPRIETES
			Hauteur = 40
		FIN

		LIB_Titre est un Champ Libellé
			PROPRIETES
				Libellé =
				Visible = Vrai
			FIN
		FIN
	FIN
FIN
