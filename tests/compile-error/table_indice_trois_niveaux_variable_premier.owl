// Même refus que table_indice_trois_niveaux.owl, mais le premier indice est
// une VARIABLE plutôt qu'un littéral — la graphie qu'on écrit réellement
// (une mise en forme conditionnelle s'écrit dans une boucle).
// Attendu : E_SEM_TABLE_INDEX_TOO_DEEP.

FEN_IndiceTroisNiveauxVarPremier est une Fenêtre
	PROPRIETES
		Disposition = dispVerticale
		Largeur     = 400
		Hauteur     = 300
	FIN
	TABLE_Synthese est un Champ Table
		PROPRIETES
			Étire = Vrai
		FIN
		COL_Tresorerie est une Colonne
			PROPRIETES
				Libellé = "Trésorerie"
				Type    = colTypeNumerique
				Largeur = 100
			FIN
		FIN
	FIN
	PROCEDURE Peindre()
		i est un entier = 1
		TABLE_Synthese[i][1][1]..Couleur = RVB(200, 0, 0)
	FIN
FIN
