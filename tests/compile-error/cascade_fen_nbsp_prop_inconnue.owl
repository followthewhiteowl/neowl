// D2 : NBSP (U+00A0, bytes 0xC2 0xA0) invisible precede le nom dune propriete.
// La propriete devient "?Hauteur" (inconnue), la fenetre se desynchronise
// et les widgets suivants retombent au top-level.
// BASELINE : 9 erreurs cascade aujourd'hui.
// CIBLE apres  : ~1-3 erreurs (cause invisible, E_SEM_DSL_WINDOW_CLOSED_EARLY).

FEN_NBSP est une Fenêtre
	PROPRIETES
		Titre       = "Test NBSP"
		Largeur     = 600
		 Hauteur    = 400
		Disposition = dispLibre
	FIN

	LIB_A est un Libellé
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 100
			Hauteur = 20
			Libellé = "A"
		FIN
	FIN

	LIB_B est un Libellé
		PROPRIETES
			X       = 10
			Y       = 40
			Largeur = 100
			Hauteur = 20
			Libellé = "B"
		FIN
	FIN

	LIB_C est un Libellé
		PROPRIETES
			X       = 10
			Y       = 70
			Largeur = 100
			Hauteur = 20
			Libellé = "C"
		FIN
	FIN

	LIB_D est un Libellé
		PROPRIETES
			X       = 10
			Y       = 100
			Largeur = 100
			Hauteur = 20
			Libellé = "D"
		FIN
	FIN
FIN
