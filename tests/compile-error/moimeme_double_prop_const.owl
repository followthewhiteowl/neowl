// Deux affectations `MoiMême..prop = <constante>` consécutives dans un même
// handler doivent compiler. La constante du membre droit de la 1re affectation
// ne doit pas rester le « dernier token-variable » et faire prendre le
// `MoiMême..` suivant pour un chaînage sur constante.

FEN_MoiMemeDoubleProp est une Fenêtre
	PROPRIETES
		Titre       = "Probe"
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 200
	FIN

	BTN_X est un Champ Bouton
		PROPRIETES
			Libellé = "clic"
			X       = 10
			Y       = 10
			Largeur = 100
			Hauteur = 30
		FIN
		PROCEDURE surClic()
			MoiMême..Couleur     = RougeClair
			MoiMême..CouleurFond = BleuClair
		FIN
	FIN
FIN
