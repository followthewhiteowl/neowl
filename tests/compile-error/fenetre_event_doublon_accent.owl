// Compile-time error : miroir du doublon de PROCEDURE pour un evenement
// predefini de fenetre dont le nom canon porte un accent. Les deux graphies
// designent le meme evenement ; une seule serait cablee.
FEN_EventDoublonAccent est une Fenêtre
	PROPRIETES
		Titre = "Doublon"
	FIN

	PROCEDURE surToucheAppuyee(touche est un entier)
	FIN

	PROCEDURE surToucheAppuyée(touche est un entier)
	FIN
FIN
