// : Type OBJECT compile-check — sous-champ inexistant
// sur prop composee Police.
//
// LIB_X..Police..Nomm (typo : Nomm au lieu de Nom)
// doit produire une erreur de compilation nominative listant les
// champs valides du type Police.
//
// Attendu apres impl : erreur compile "Champ 'Nomm' inconnu
// sur type Police. Champs disponibles : Nom, Taille, Gras,
// Italique, Souligné, Barré, Couleur" (ou equivalent).

FEN_X est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN
	LIB_X est un Champ Libellé
		PROPRIETES
			X       = 10
			Y       = 10
			Libellé = "test"
		FIN
	FIN
FIN

LIB_X..Police..Nomm = "Arial"
