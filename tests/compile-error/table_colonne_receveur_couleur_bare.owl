//  lot A — une colonne devient un receveur de mise en forme : la
// forme nue 'COL_X..Couleur' / 'COL_X..CouleurFond' doit compiler quand la
// colonne est la seule de ce nom dans le périmètre (aucune homonymie).
//  : désucrage compile-time vers 'TABLE_X.COL_X..<prop>' via
// g_prescan_children. Snapshot attendu : {"errors":[],"warnings":[]}.
FEN_ColonneReceveurBare est une Fenêtre
	PROPRIETES
		Titre       = "Colonne receveur bare"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 300
	FIN

	TABLE_Unique est un Champ Table
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 300
			Hauteur = 200
		FIN

		COL_A est une Colonne
			PROPRIETES
				Libellé = "A"
				Type    = colTypeTexte
				Largeur = 100
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		COL_A..Couleur     = RVB(255, 0, 0)
		COL_A..CouleurFond = RVB(0, 255, 0)
	FIN
FIN
