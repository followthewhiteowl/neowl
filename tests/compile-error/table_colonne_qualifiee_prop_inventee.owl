//  — la forme colonne-first QUALIFIÉE NON INDEXÉE
// 'TABLE_X.COL_A..<prop>' ne livre que 'Couleur'/'CouleurFond' au niveau
// colonne. Une propriété inventée compilait clean = écriture dans
// le vide (no-op silencieux). Elle doit être refusée EXPLICITEMENT, comme la
// forme nue 'COL_A..<prop>' l'est déjà ( Lot A).
FEN_ColonneQualifieePropInventee est une Fenêtre
	PROPRIETES
		Titre       = "Colonne qualifiée - prop inventée refusée"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 300
	FIN

	TABLE_Unique est un Champ Table
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 300
			Hauteur = 200
		FIN

		COL_A est une Colonne
			PROPRIETES
				Libellé = "A"
				Type    = colTypeTexte
				Largeur = 100
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		TABLE_Unique.COL_A..ZuTruc42 = 42
	FIN
FIN
