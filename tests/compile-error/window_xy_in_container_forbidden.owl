// Lot F : X/Y sur enfant d'un Conteneur en dispHorizontale -> erreur.
// Le message doit citer le NOM du Conteneur parent (pas "la fenetre").
FEN_X est une Fenetre
	PROPRIETES
		Disposition = dispLibre
	FIN
	BAR est un Champ Conteneur
		PROPRIETES
			Disposition = dispHorizontale
		FIN
		BTN_A est un Champ Bouton
			PROPRIETES
				X       = 5
				Libelle = "Nope"
			FIN
		FIN
	FIN
FIN
