// Compile-time : methode PRIVEE ne peut pas etre appelee depuis l'exterieur
// de la classe. Aujourd'hui le modificateur est skip silencieusement et
// l'appel passe. Apres , doit compiler-error explicite.

cService est une Classe
PUBLIC
	nCompteur est un entier

	PROCEDURE Constructeur()
		:nCompteur = 0
	FIN

	PROCEDURE PRIVÉE SecretMethod()
		:nCompteur = :nCompteur + 1
		Trace("secret")
	FIN
FIN

PROCEDURE Main()
	oServ est un cService()
	oServ.SecretMethod()  // ATTENDU : compile-error "methode PRIVEE"
FIN
