//  — le corps d'un état de volet est un style plat : des couleurs, et
// rien d'autre. Une Police y est donc refusée, dans les deux écritures d'un
// Champ Onglet (littéral inline et cascade), exactement comme le refuse déjà
// la même déclaration écrite dans un thème ou sur une variable typée
// (« Champ 'Police' inconnu sur type styleVoletBase »).
//
// La police d'un volet se pose sur le volet lui-même, pas par état.

FEN_OngletStylePoliceParEtat est une Fenêtre
	PROPRIETES
		Titre       = "Test"
		Disposition = dispLibre
		Largeur     = 520
		Hauteur     = 360
	FIN

	ONG_Inline est un Champ Onglet
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 480
			Hauteur = 150
			Valeur  = 1

			Style = {
				VoletActif = {
					CouleurFond = Blanc
					Police      = { Nom = "Arial" }
					Etats       = {
						Survol = {
							CouleurFond = RVB(255, 0, 255)
							Police      = { Nom = "Courier New" }
						}
					}
				}
			}
		FIN

		VOL_InlineA est un Volet
			PROPRIETES
				Libellé     = "A"
				Disposition = dispLibre
			FIN
		FIN

		VOL_InlineB est un Volet
			PROPRIETES
				Libellé     = "B"
				Disposition = dispLibre
			FIN
		FIN
	FIN

	ONG_Cascade est un Champ Onglet
		PROPRIETES
			X       = 10
			Y       = 180
			Largeur = 480
			Hauteur = 150
			Valeur  = 1

			Style..VoletActif..CouleurFond                = Blanc
			Style..VoletActif..Police..Nom                = "Arial"
			Style..VoletActif..Etats[survol]..CouleurFond = RVB(255, 0, 255)
			Style..VoletActif..Etats[survol]..Police..Nom = "Courier New"
		FIN

		VOL_CascadeA est un Volet
			PROPRIETES
				Libellé     = "A"
				Disposition = dispLibre
			FIN
		FIN

		VOL_CascadeB est un Volet
			PROPRIETES
				Libellé     = "B"
				Disposition = dispLibre
			FIN
		FIN
	FIN
FIN
