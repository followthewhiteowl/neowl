//  lot A — homonymie intra-fenêtre : deux Tables de la MÊME fenêtre
// déclarent chacune une colonne 'COL_A'. La forme nue 'COL_A..Couleur' ne
// peut désigner qu'une seule Table :  refuse à la compilation plutôt
// que d'inventer une forme désambiguïsante non canon, et nomme les Tables
// candidates pour orienter le renommage.
FEN_ColonneReceveurHomonyme est une Fenêtre
	PROPRIETES
		Titre       = "Colonne receveur homonyme"
		Disposition = dispLibre
		Largeur     = 500
		Hauteur     = 300
	FIN

	TABLE_Un est un Champ Table
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 200
			Hauteur = 200
		FIN

		COL_A est une Colonne
			PROPRIETES
				Libellé = "Un"
				Type    = colTypeTexte
				Largeur = 100
			FIN
		FIN
	FIN

	TABLE_Deux est un Champ Table
		PROPRIETES
			X       = 220
			Y       = 10
			Largeur = 200
			Hauteur = 200
		FIN

		COL_A est une Colonne
			PROPRIETES
				Libellé = "Deux"
				Type    = colTypeTexte
				Largeur = 100
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		COL_A..Couleur = RVB(255, 0, 0)
	FIN
FIN
