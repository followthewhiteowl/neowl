// Contrôle positif : GET et POST sur exactement le même chemin ne sont pas
// en conflit, la méthode fait partie de la clé de résolution. Doit
// compiler sans erreur.
ServiceRouteurPasConflitMethodes est un ServiceREST
	PROPRIETES
		UrlBase = ["api", "v1", "clients"]
	FIN

	ListeClients est une OpérationHTTP
		PROPRIETES
			Méthode  = httpGet
			Chemin   = []
			Réponses = [httpOK]
			CodeÉtat = httpOK
		FIN
		PROCEDURE surRequête() : entier
			RENVOYER 0
		FIN
	FIN

	CréeClient est une OpérationHTTP
		PROPRIETES
			Méthode  = httpPost
			Chemin   = []
			Réponses = [httpCréé]
			CodeÉtat = httpCréé
		FIN
		PROCEDURE surRequête() : entier
			RENVOYER 1
		FIN
	FIN
FIN
