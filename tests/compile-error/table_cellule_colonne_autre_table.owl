// Le trou n'est pas seulement "nom invente" : un nom de colonne REEL mais
// appartenant a une AUTRE Table est accepte tout autant sur le descripteur
// de ligne, faute d'association Table -> ses colonnes au compile-time.

FEN_TableColonneAutreTable est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 300
	FIN
	TABLE_A est un Champ Table
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 180
			Hauteur = 150
		FIN
		COL_UN est une Colonne
			PROPRIETES
				Libellé = "Un"
				Type    = colTypeTexte
				Largeur = 100
			FIN
		FIN
	FIN
	TABLE_B est un Champ Table
		PROPRIETES
			X       = 200
			Y       = 10
			Largeur = 180
			Hauteur = 150
		FIN
		COL_DEUX est une Colonne
			PROPRIETES
				Libellé = "Deux"
				Type    = colTypeTexte
				Largeur = 100
			FIN
		FIN
	FIN
	PROCEDURE Peindre()
		i est un entier = 1
		TABLE_A[i].COL_DEUX = "valeur bidon"
		rLecture1465 est une chaîne = TABLE_A[i].COL_DEUX
	FIN
FIN
