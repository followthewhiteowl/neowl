// Une PROCEDURE top-level hors bloc Fenêtre est interdite dans un
// fichier-fenêtre. Les helpers vivent DANS le bloc, au top-level du
// bloc (hors widget), comme PROCEDURE FinInitialisation().

PROCEDURE HelperHorsBloc(champ)
	champ..Libellé = "modifié"
FIN

FEN_Test est une Fenêtre
	PROPRIETES
		Titre       = "Test"
		Largeur     = 400
		Hauteur     = 300
		Disposition = dispLibre
	FIN

	LIB_X est un Champ Libellé
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 100
			Hauteur = 30
			Libellé = "X"
		FIN
	FIN
FIN
