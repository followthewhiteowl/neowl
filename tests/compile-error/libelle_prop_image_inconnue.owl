// Un champ Libellé (texte statique) n'a pas de propriété Image.
// Déclarer Image dans son bloc PROPRIETES doit produire
// E_SEM_DSL_PROP_UNKNOWN_FOR_KIND.

FEN_LibelleImage est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN
	LIB_X est un Champ Libellé
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 100
			Hauteur = 30
			Libellé = "Titre"
			Image   = "logo.png"
		FIN
	FIN
FIN
