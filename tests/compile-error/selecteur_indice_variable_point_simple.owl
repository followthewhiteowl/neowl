// Le point simple sur un élément indexé de Sélecteur doit être refusé même
// quand l'indice est une variable, pas seulement quand il est littéral —
// c'est la graphie que le canon documente ([nIndice], [I]).

FEN_SelecteurIndiceVar est une Fenêtre
	PROPRIETES
		Largeur = 200
		Hauteur = 100
	FIN

	SEL_C est un Champ Sélecteur
		PROPRIETES
			Options = ["Rouge", "Vert", "Bleu"]
		FIN
	FIN

	PROCEDURE FinInitialisation()
		i est un entier = 1
		Trace(SEL_C[i].Libellé)
	FIN
FIN
