// Méthode doit être une valeur de l'enum httpMéthodes ; une valeur hors
// enum est refusée à la compilation (miroir de libelle_lota_invalid_enum.owl,
// pattern E_SEM_DSL_ENUM_VALUE_INVALID). DRAFT test_writer.
ServiceClients est un ServiceREST
	PROPRIETES
		UrlBase = ["api", "v1", "clients"]
	FIN

	LitClient est une OpérationHTTP
		PROPRIETES
			Méthode  = httpBidule
			Chemin   = ["clients", id]
			Réponses = [httpOK]
			CodeÉtat = httpOK
		FIN
		PROCEDURE surRequête(id est un entier) : entier
			RENVOYER id
		FIN
	FIN
FIN
