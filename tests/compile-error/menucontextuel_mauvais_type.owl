//  — la propriété d'attache `MenuContextuel = <nom>` doit
// référencer un bloc de type MenuContextuel. Ici MNU_ClassiqueSeul est un
// MenuPrincipal (menu classique de fenêtre) : mauvais type d'objet, erreur
// claire attendue.

FEN_MenuContextuelMauvaisType est une Fenêtre
	PROPRIETES
		Titre       = "MauvaisType"
		Largeur     = 300
		Hauteur     = 200
		Disposition = dispLibre
	FIN

	MNU_ClassiqueSeul est un MenuPrincipal
		SM_A est un SousMenu
			PROPRIETES
				Libellé = "Menu A"
			FIN
		FIN
	FIN

	BTN_Zone est un Champ Bouton
		PROPRIETES
			X              = 10
			Y              = 10
			Libellé        = "Zone"
			MenuContextuel = MNU_ClassiqueSeul
		FIN
	FIN
FIN
