// Meme refus au-dela de trois indices : le message reste le meme, il n'y a
// pas de degradation en tombant sur un message generique une fois le seuil
// depasse.
// Attendu : E_SEM_TABLE_INDEX_TOO_DEEP.

FEN_IndiceQuatreNiveaux est une Fenêtre
	PROPRIETES
		Disposition = dispVerticale
		Largeur     = 400
		Hauteur     = 300
	FIN
	TABLE_Synthese est un Champ Table
		PROPRIETES
			Étire = Vrai
		FIN
		COL_Tresorerie est une Colonne
			PROPRIETES
				Libellé = "Trésorerie"
				Type    = colTypeNumerique
				Largeur = 100
			FIN
		FIN
	FIN
	PROCEDURE Peindre()
		TABLE_Synthese[1][1][1][1]..Couleur = RVB(200, 0, 0)
	FIN
FIN
