// UrlBase attend une liste de segments. Une chaîne à la place doit être
// refusée à la compilation.
ServiceSi est un ServiceREST
	PROPRIETES
		UrlBase = "api/v1"
	FIN

	LitSi est une OpérationHTTP
		PROPRIETES
			Méthode  = httpGet
			Chemin   = ["clients"]
			Réponses = [httpOK]
			CodeÉtat = httpOK
		FIN
		PROCEDURE surRequête() : entier
			RENVOYER 0
		FIN
	FIN
FIN
