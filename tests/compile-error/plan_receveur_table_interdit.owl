//  — la propriété Plan est réservée à la fenêtre (plan actif) et à
// ses champs directs (plan d'appartenance) : interdite sur une Table.
FEN_PlanReceveurTable est une Fenêtre
	PROPRIETES
		Titre       = "Plan receveur Table interdit"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 300
	FIN

	TABLE_Unique est un Champ Table
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 300
			Hauteur = 200
			Plan    = 1
		FIN

		COL_A est une Colonne
			PROPRIETES
				Libellé = "A"
				Type    = colTypeTexte
				Largeur = 100
			FIN
		FIN
	FIN
FIN
