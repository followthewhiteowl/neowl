//  : malgré la présence d'un voisin déclarant une globale
// (gGlobalExistant2105 dans GlobalExistant2105.owl), une référence à un nom
// jamais déclaré doit toujours produire l'erreur "variable inconnue" — les
// voisins hydratés ne doivent jamais masquer un vrai symbole absent.
n est un entier = gJamaisDeclare2105
Trace(n)
