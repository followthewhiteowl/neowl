//  — non-régression : un Champ Saisie dont le FormatNombre inline est
// valide (milliers ' ' ≠ décimal ',') ne produit AUCUNE erreur au compile.
// Snapshot attendu : {"errors":[],"warnings":[]}.
FEN_ChampFnbValide est une Fenêtre
	PROPRIETES
		Titre       = "Champ FormatNombre valide"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 120
	FIN
	SAI_Valide est un Champ Saisie
		PROPRIETES
			X            = 10
			Y            = 10
			Largeur      = 180
			Hauteur      = 24
			TypeSaisie   = typSaisieNum
			FormatNombre = {SéparateurMilliers = " ", SéparateurDécimal = ",", ChiffresAprèsVirgule = 2}
			Valeur       = ""
		FIN
	FIN
FIN
