// CodeÉtat doit appartenir à la liste déclarée dans Réponses ; un code
// absent de Réponses est refusé à la compilation. DRAFT test_writer.
ServiceClients est un ServiceREST
	PROPRIETES
		UrlBase = ["api", "v1", "clients"]
	FIN

	LitClient est une OpérationHTTP
		PROPRIETES
			Méthode  = httpGet
			Chemin   = ["clients", id]
			Réponses = [httpOK]
			CodeÉtat = httpNonTrouvé
		FIN
		PROCEDURE surRequête(id est un entier) : entier
			RENVOYER id
		FIN
	FIN
FIN
