// Grand-parent de la chaîne modèle-de-modèles utilisée par
// test_etat_modele_iteration_trois_niveaux.owl.
//
// Déclare un bloc Itération nommé ITER_Partage, hérité transitivement
// par MOD_Mid puis ETAT_Leaf.

MOD_GP est un ModèleÉtat
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	Corps est un Corps
		PROPRIETES
			Hauteur = 40
		FIN
	FIN

	ITER_Partage est une Itération
		Trace("iteration-grand-parent")
	FIN
FIN
