// Prop ReinitialiserNombrePagesApres retiree des blocs Etat (alpha break-net).
// Runtime Etat V2 MVP sans iImprimeEtat — props pagination prematurees.
ETAT_Z est un Etat
	PROPRIETES
		Format = formatA4
	FIN
	bas est un BasDePage
		PROPRIETES
			ReinitialiserNombrePagesApres = Vrai
		FIN
		Trace("Bas")
	FIN
	ligne est un Corps
		Trace("Corps")
	FIN
FIN
