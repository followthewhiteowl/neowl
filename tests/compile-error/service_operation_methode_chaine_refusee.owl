// Méthode attend un identifiant de l'énumération httpMéthodes. Une
// chaîne à la place (même si elle ressemble au nom de la valeur) doit
// être refusée à la compilation.
ServiceSe est un ServiceREST
	PROPRIETES
		UrlBase = ["api"]
	FIN

	LitSe est une OpérationHTTP
		PROPRIETES
			Méthode  = "httpGet"
			Chemin   = ["clients"]
			Réponses = [httpOK]
			CodeÉtat = httpOK
		FIN
		PROCEDURE surRequête() : entier
			RENVOYER 0
		FIN
	FIN
FIN
