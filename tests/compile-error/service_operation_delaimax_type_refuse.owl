//  P1 — refus : DélaiMax attend un entier (secondes). Une chaîne doit
// être refusée à la compilation (type incompatible).
ServiceDelaiType est un ServiceREST
	PROPRIETES
		UrlBase = ["api"]
	FIN

	Diffuse est une OpérationHTTP
		PROPRIETES
			Méthode  = httpGet
			Chemin   = ["diffuse"]
			Flux     = fluxSSE
			DélaiMax = "trois cents"
		FIN
		PROCEDURE surRequête()
		FIN
	FIN
FIN
