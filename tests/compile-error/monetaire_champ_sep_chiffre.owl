//  — Champ Saisie dont le FormatMonétaire inline pose un séparateur de
// milliers contenant un chiffre ('0'). Refus AU COMPILE, miroir 
// (FormatNombre champ).
FEN_MonChampSepChiffre est une Fenêtre
	PROPRIETES
		Titre       = "Champ FormatMonétaire séparateur chiffre"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 120
	FIN
	SAI_MonSepChiffre est un Champ Saisie
		PROPRIETES
			X               = 10
			Y               = 10
			Largeur         = 180
			Hauteur         = 24
			TypeSaisie      = typSaisieMonétaire
			FormatMonétaire = {Symbole = "€", SéparateurMilliers = "0", SéparateurDécimal = ",", ChiffresAprèsVirgule = 2}
			Valeur          = ""
		FIN
	FIN
FIN
