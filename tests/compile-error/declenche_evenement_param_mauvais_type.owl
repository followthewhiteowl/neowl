// Robustesse type : evtToucheAppuyée attend un entier (code de touche).
// Passer une chaîne littérale est une erreur compile — le type des params
// est validé contre la signature portée par la constante evt*.

FEN_DeclParamMauvaisType est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN
	SAI_Modif est un Champ Saisie
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 150
			Hauteur = 30
		FIN
	FIN
	PROCEDURE Lance()
		DéclencheÉvénement(SAI_Modif, evtToucheAppuyée, "pasUnEntier")
	FIN
FIN
