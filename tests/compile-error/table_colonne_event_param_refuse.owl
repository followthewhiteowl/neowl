// Les événements d'une Colonne (surInitialisation / surSortie /
// surAChaqueModification) sont 0-arg. Un handler déclaré avec un paramètre
// doit être rejeté à la compilation, comme les autres events à signature
// fixe — pas avalé silencieusement.
FEN_ColonneEventParam est une Fenêtre
	PROPRIETES
		Titre       = "Colonne event mal signé"
		Disposition = dispLibre
		Largeur     = 300
		Hauteur     = 200
	FIN

	TABLE_Saisie est un Champ Table
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 200
			Hauteur = 90
		FIN

		COL_Libelle est une Colonne
			PROPRIETES
				Libellé = "Libellé"
				Type    = colTypeTexte
				Largeur = 180
			FIN

			PROCEDURE surSortie(x est un entier)
			FIN
		FIN
	FIN
FIN
