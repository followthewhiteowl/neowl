//  — un Champ Saisie dont le FormatNombre inline pose milliers ==
// décimal ('.') : config contradictoire (le dé-formatage ne saurait plus
// distinguer les séparateurs). Doit être refusée AU COMPILE, comme le projet.
FEN_ChampSepIdentiques est une Fenêtre
	PROPRIETES
		Titre       = "Champ FormatNombre séparateurs identiques"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 120
	FIN
	SAI_Ident est un Champ Saisie
		PROPRIETES
			X            = 10
			Y            = 10
			Largeur      = 180
			Hauteur      = 24
			TypeSaisie   = typSaisieNum
			FormatNombre = {SéparateurMilliers = ".", SéparateurDécimal = ".", ChiffresAprèsVirgule = 2}
			Valeur       = ""
		FIN
	FIN
FIN
