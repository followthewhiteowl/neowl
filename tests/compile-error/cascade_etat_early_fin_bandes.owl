// C1 : FIN prématuré après PROPRIETES d'un fichier-état.
// Les bandes de rapport (Corps, EnTêteDocument, BasDePage) retombent au top-level.
// BASELINE : 12 erreurs cascade aujourd'hui.
// CIBLE après  : ~1-3 erreurs (E_SEM_DSL_WINDOW_CLOSED_EARLY + note agrégée).

ETAT_CascadeC1 est un État
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN
FIN

corps est un Corps
	PROPRIETES
		Hauteur = 30
	FIN

	LIB_Titre est un Libellé
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 190
			Hauteur = 10
			Libellé = "Titre"
		FIN
	FIN
FIN

intro est un EnTêteDocument
	PROPRIETES
		Hauteur = 20
	FIN
FIN

bas est un BasDePage
	PROPRIETES
		Hauteur = 10
	FIN
FIN
