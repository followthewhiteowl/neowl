//  : BorneMax n'a d'effet que sur un champ de saisie numerique,
// monetaire ou numerique precis. Sur un Champ Saisie de type heure,
// la borne est ignoree en silence au runtime — doit lever un warning
// compile-time.
FEN_MaxValueSaisieHeure est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN
	SAI_X est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 10
			Largeur    = 150
			Hauteur    = 24
			TypeSaisie = typSaisieHeure
			BorneMax   = 90
		FIN
	FIN
FIN
