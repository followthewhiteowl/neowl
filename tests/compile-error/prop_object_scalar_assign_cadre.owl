// : Type OBJECT compile-check — scalaire direct sur prop
// composee.
//
// LIB_X..Cadre = 5 (un entier sur une prop qui attend un descripteur
// compose Cadre) doit produire une erreur de compilation nominative.
//
// Attendu apres impl : erreur compile "Cadre attend un descripteur
// compose, pas un scalaire" (ou equivalent).

FEN_X est une Fenetre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN
	LIB_X est un Champ Libelle
		PROPRIETES
			X       = 10
			Y       = 10
			Libelle = "test"
		FIN
	FIN
FIN

LIB_X..Cadre = 5
