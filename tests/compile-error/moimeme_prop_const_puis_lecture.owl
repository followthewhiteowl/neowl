// Variante : une affectation `MoiMême..A = <constante>` suivie d'une LECTURE
// `MoiMême..B` (ici en membre droit). La constante affectée ne doit pas
// contaminer le récepteur dynamique du `MoiMême..` de lecture qui suit.

FEN_MoiMemePropPuisLecture est une Fenêtre
	PROPRIETES
		Titre       = "Probe"
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 200
	FIN

	BTN_Y est un Champ Bouton
		PROPRIETES
			Libellé = "clic"
			X       = 10
			Y       = 10
			Largeur = 100
			Hauteur = 30
		FIN
		PROCEDURE surClic()
			MoiMême..Couleur     = RougeClair
			MoiMême..CouleurFond = MoiMême..Couleur
		FIN
	FIN
FIN
