// `..ValeurAffichée` sur une CELLULE de Table est en lecture seule : elle
// expose le texte formaté affiché (rendu du masque de la colonne), pas la
// valeur brute. Toute tentative d'affectation doit être rejetée à la
// compilation, comme pour le champ Saisie.
FEN_TableCelluleValeurAffichee est une Fenêtre
	PROPRIETES
		Titre = "Cellule — écriture ValeurAffichée refusée"
	FIN

	TABLE_Dates est un Champ Table
		PROPRIETES
		FIN

		COL_Date est une Colonne
			PROPRIETES
				Libellé         = "Date"
				Type            = colTypeDate
				Largeur         = 140
				MasqueAffichage = "AAAA-MM-JJ"
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		TableAjouteLigne(TABLE_Dates, "12/09/2026")
		TABLE_Dates[1][1]..ValeurAffichée = "forcée"
	FIN
FIN
