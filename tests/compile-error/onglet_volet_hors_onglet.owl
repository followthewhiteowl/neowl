// Compile-time error : un Volet hors d'un Champ Onglet.
// Le sous-bloc Volet ne peut apparaître qu'à l'intérieur d'un Champ Onglet
// (au même titre qu'une Colonne hors d'un Champ Table).
FEN_VoletHorsOnglet est une Fenêtre
	PROPRIETES
		Titre = "Test"
		Disposition = dispLibre
		Largeur = 400
		Hauteur = 300
	FIN

	VOL_Perdu est un Volet
		PROPRIETES
			Libellé = "Perdu"
		FIN
	FIN
FIN
