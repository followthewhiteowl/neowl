// Compile-time : RENVOYER interdit dans le bloc ENFIN (Arb 1 strict).
// Le cleanup doit s'exécuter sans interrompre le flux : tout retour
// doit se faire dans DANS ou FAIRE, jamais dans ENFIN.
FONCTION Test() : entier
	QUAND EXCEPTION DANS
		Trace("try")
	FAIRE
		Trace("catch")
	ENFIN
		RENVOYER 99
	FIN
	RENVOYER 0
FIN
