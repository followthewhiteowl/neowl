//  : PROCEDURE a nom libre dans un bloc (Corps) d'Etat.
// Politique canon : seul le top-level de l'Etat peut porter des procedures libres.
// Attendu : erreur compile (message provisoire — a confirmer par l'implementeur).

ETAT_HelperBloc est un Etat
	PROPRIETES
		Format = formatA4
	FIN

	corps est un corps
		PROPRIETES
			Hauteur = 40
		FIN

		PROCEDURE HelperBloc()
			RENVOYER 42
		FIN
	FIN
FIN
