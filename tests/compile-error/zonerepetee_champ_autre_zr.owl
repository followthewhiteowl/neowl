// Le trou n'est pas seulement "nom inventé" : un nom de champ RÉEL mais
// appartenant à une AUTRE ZoneRépétée du même fichier est accepté tout autant
// sur le descripteur de ligne, faute d'association ZoneRépétée -> ses champs
// au compile-time. Miroir  (Table), volet ZoneRépétée.

FEN_ZRChampAutreZr est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 300
	FIN
	ZR_A est un Champ ZoneRépétée
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 180
			Hauteur = 120
		FIN
		LIB_Un est un Champ Libellé
			PROPRIETES
				Libellé = "Un"
			FIN
		FIN
	FIN
	ZR_B est un Champ ZoneRépétée
		PROPRIETES
			X       = 200
			Y       = 10
			Largeur = 180
			Hauteur = 120
		FIN
		LIB_Deux est un Champ Libellé
			PROPRIETES
				Libellé = "Deux"
			FIN
		FIN
	FIN
	PROCEDURE Peindre()
		i est un entier = 1
		ZR_A[i].LIB_Deux = "valeur bidon"
	FIN
FIN
