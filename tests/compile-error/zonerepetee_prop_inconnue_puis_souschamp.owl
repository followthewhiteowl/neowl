// Compile-time error : propriété inconnue dans PROPRIETES d'un Champ
// ZoneRépétée, suivie d'un sous-champ valide. Miroir du comportement
// Onglet/Volet (onglet_prop_inconnue.owl) : 1 erreur nette sur la
// propriété, le sous-champ parsé normalement.
FEN_ZoneRepeteePropInconnue est une Fenêtre
	PROPRIETES
		Titre       = "Test"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 300
	FIN

	ZR_X est un Champ ZoneRépétée
		PROPRIETES
			X         = 10
			Y         = 10
			Largeur   = 380
			Hauteur   = 250
			PropBidon = 1
		FIN

		LIB_A est un Champ Libellé
			PROPRIETES
				Libellé = "A"
			FIN
		FIN
	FIN
FIN
