// MySelf (alias EN de MoiMême)..X sur une propriété inexistante doit être
// rejeté à la compilation, comme la forme FR.

FEN_MySelfPropInconnue est une Fenêtre
	PROPRIETES
		Titre       = "Probe"
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 200
	FIN

	LIB_Cible est un Champ Libellé
		PROPRIETES
			Libellé = "Cible"
			X       = 10
			Y       = 10
			Largeur = 100
			Hauteur = 30
		FIN
		PROCEDURE surClic()
			resSonde est une chaîne = MySelf..Nomsasfaf
		FIN
	FIN
FIN
