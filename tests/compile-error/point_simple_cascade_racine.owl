// Cascade entièrement en points simples : le premier point, à la racine,
// doit être refusé — pas seulement le dernier de la chaîne.

FEN_CascadeRacine est une Fenêtre
	PROPRIETES
		Largeur = 200
		Hauteur = 100
	FIN

	BTN_A est un Champ Bouton
		PROPRIETES
			Libellé = "OK"
		FIN
	FIN

	PROCEDURE FinInitialisation()
		BTN_A.Style.CadreExtérieur.Cadre.Arrondi = 7
	FIN
FIN
