// Controle positif : plusieurs OpérationHTTP dans le même ServiceREST,
// chacune avec un nom distinct, doivent toutes compiler. DRAFT test_writer,
// rouge aujourd'hui ("Type inconnu 'ServiceREST'") faute d'implémentation.
ServiceClients est un ServiceREST
	PROPRIETES
		UrlBase = ["api", "v1", "clients"]
	FIN

	ListeClients est une OpérationHTTP
		PROPRIETES
			Méthode  = httpGet
			Chemin   = ["clients"]
			Réponses = [httpOK]
			CodeÉtat = httpOK
		FIN
		PROCEDURE surRequête() : entier
			RENVOYER 0
		FIN
	FIN

	LitClient est une OpérationHTTP
		PROPRIETES
			Méthode  = httpGet
			Chemin   = ["clients", id]
			Réponses = [httpOK, httpNonTrouvé]
			CodeÉtat = httpOK
		FIN
		PROCEDURE surRequête(id est un entier) : entier
			RENVOYER id
		FIN
	FIN
FIN
