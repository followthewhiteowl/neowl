// Authentification doit être une valeur de l'enum d'authentification HTTP
// (httpAuthBearer / httpAuthAucune) ; une valeur hors enum est
// refusée à la compilation. DRAFT test_writer — noms d'enum figés par le
// brief ticket, pas encore enregistrés au registry.
ServiceClients est un ServiceREST
	PROPRIETES
		UrlBase          = ["api", "v1", "clients"]
		Authentification = httpAuthBidule
	FIN

	LitClient est une OpérationHTTP
		PROPRIETES
			Méthode  = httpGet
			Chemin   = ["clients", id]
			Réponses = [httpOK]
			CodeÉtat = httpOK
		FIN
		PROCEDURE surRequête(id est un entier) : entier
			RENVOYER id
		FIN
	FIN
FIN
