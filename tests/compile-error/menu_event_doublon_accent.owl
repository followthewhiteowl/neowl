// Compile-time error : deux blocs du meme evenement de menu ecrits avec des
// graphies divergentes en casse ET en accents. Invariants 1 et 2 : les deux
// designent surSélection, un seul serait cable.
FEN_MenuEventDoublonAccent est une Fenêtre
	PROPRIETES
		Titre         = "Doublon d'evenement de menu (graphies)"
		MenuPrincipal = MNU_EventAccent
	FIN

	MNU_EventAccent est un MenuPrincipal
		SM_Fichier est un SousMenu
			PROPRIETES
				Libellé = "&Fichier"
			FIN

			OPT_Fermer est une OptionMenu
				PROPRIETES
					Libellé = "&Fermer"
				FIN

				PROCEDURE surSélection()
				FIN

				PROCEDURE SURSELECTION()
				FIN
			FIN
		FIN
	FIN
FIN
