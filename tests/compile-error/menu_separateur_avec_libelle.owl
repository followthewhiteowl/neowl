//  (ticket A) — un MenuSéparateur n'affiche pas de texte : il
// ne peut pas porter Libellé (PROPRIETES reste réservé à Visible/style).

FEN_MenuSeparateurLibelle est une Fenêtre
	PROPRIETES
		Disposition     = dispLibre
		Largeur         = 200
		Hauteur         = 100
		MenuPrincipal   = MNU_X
	FIN

	MNU_X est un MenuPrincipal
		SM_A est un SousMenu
			PROPRIETES
				Libellé = "Menu A"
			FIN

			SEP_1 est un MenuSéparateur
				PROPRIETES
					Libellé = "Séparateur"
				FIN
			FIN
		FIN
	FIN
FIN
