//  — ressource pure voisine : même défaut que le fixture single-file
// (collection_procedure_sans_fin_rejetee.owl), PROCEDURE 'Premiere' sans son
// FIN propre. Ici on ajoute deux membres supplémentaires après pour
// reproduire fidèlement le symptôme du support #369 : plusieurs procédures
// mal comptées en cascade d'un coup, pas une seule.
COL_Utils est une CollectionDeProcédures

	PROCEDURE Premiere()
		i est un entier = 0
		TANTQUE i < 3
			i = i + 1
		FIN

	PROCEDURE Deuxieme()
		RENVOYER 42
	FIN

	PROCEDURE Troisieme()
		RENVOYER 43
	FIN

	PROCEDURE Quatrieme()
		RENVOYER 44
	FIN
FIN
