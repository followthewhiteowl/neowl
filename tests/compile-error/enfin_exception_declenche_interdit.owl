// Compile-time : ExceptionDéclenche interdit dans le bloc ENFIN.
// Lever une nouvelle exception dans le cleanup masquerait silencieusement
// l'exception originale en cas de propagation (cas C/D).
PROCEDURE Test()
	QUAND EXCEPTION DANS
		Trace("try")
	FAIRE
		Trace("catch")
	ENFIN
		ExceptionDéclenche("cleanup failed")
	FIN
FIN
