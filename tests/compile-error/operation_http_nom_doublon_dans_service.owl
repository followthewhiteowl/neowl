// Deux OpérationHTTP portant le même nom dans un même ServiceREST sont un
// doublon refusé à la compilation (miroir de fenetre_proc_doublon_accent
// pour les blocs PROCEDURE d'une fenêtre). DRAFT test_writer.
ServiceClients est un ServiceREST
	PROPRIETES
		UrlBase = ["api", "v1", "clients"]
	FIN

	LitClient est une OpérationHTTP
		PROPRIETES
			Méthode  = httpGet
			Chemin   = ["clients", id]
			Réponses = [httpOK]
			CodeÉtat = httpOK
		FIN
		PROCEDURE surRequête(id est un entier) : entier
			RENVOYER id
		FIN
	FIN

	LitClient est une OpérationHTTP
		PROPRIETES
			Méthode  = httpDelete
			Chemin   = ["clients", id]
			Réponses = [httpOK]
			CodeÉtat = httpOK
		FIN
		PROCEDURE surRequête(id est un entier) : entier
			RENVOYER id
		FIN
	FIN
FIN
