//  (ticket A) — deux affectations MenuPrincipal = sur la même
// Fenêtre : ambigu, erreur compile (multi-déclaration de MenuPrincipal
// est OK, multi-affectation ne l'est pas).

FEN_MenuDoubleAffectation est une Fenêtre
	PROPRIETES
		Disposition     = dispLibre
		Largeur         = 200
		Hauteur         = 100
		MenuPrincipal   = MNU_A
		MenuPrincipal   = MNU_B
	FIN

	MNU_A est un MenuPrincipal
		SM_A est un SousMenu
			PROPRIETES
				Libellé = "Menu A"
			FIN
		FIN
	FIN

	MNU_B est un MenuPrincipal
		SM_B est un SousMenu
			PROPRIETES
				Libellé = "Menu B"
			FIN
		FIN
	FIN
FIN
