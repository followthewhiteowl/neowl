// La forme colonne-first (TABLE_X.COL_Y[ligne]) désigne déjà entièrement la
// cellule : un second crochet est un indice de trop, comme pour la forme
// ligne-first. Les deux indices sont des variables — la graphie réelle.
// Attendu : E_SEM_TABLE_INDEX_TOO_DEEP.

FEN_IndiceColonneFirstDeuxCrochets est une Fenêtre
	PROPRIETES
		Disposition = dispVerticale
		Largeur     = 400
		Hauteur     = 300
	FIN
	TABLE_Synthese est un Champ Table
		PROPRIETES
			Étire = Vrai
		FIN
		COL_Tresorerie est une Colonne
			PROPRIETES
				Libellé = "Trésorerie"
				Type    = colTypeNumerique
				Largeur = 100
			FIN
		FIN
	FIN
	PROCEDURE Peindre()
		i est un entier = 1
		j est un entier = 2
		TABLE_Synthese.COL_Tresorerie[i][j]..Couleur = RVB(200, 0, 0)
	FIN
FIN
