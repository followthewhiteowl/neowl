// Chemin attend une liste. Un littéral entier à la place doit être
// refusé à la compilation.
ServiceSb est un ServiceREST
	PROPRIETES
		UrlBase = ["api"]
	FIN

	LitSb est une OpérationHTTP
		PROPRIETES
			Méthode  = httpGet
			Chemin   = 42
			Réponses = [httpOK]
			CodeÉtat = httpOK
		FIN
		PROCEDURE surRequête() : entier
			RENVOYER 0
		FIN
	FIN
FIN
