//  : idem pour le mot de passe, egalement famille texte — BorneMax
// n'a pas de sens sur un masque de saisie.
FEN_MaxValueSaisieMotDePasse est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN
	SAI_X est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 10
			Largeur    = 150
			Hauteur    = 24
			TypeSaisie = typSaisieMotDePasse
			BorneMax   = 90
		FIN
	FIN
FIN
