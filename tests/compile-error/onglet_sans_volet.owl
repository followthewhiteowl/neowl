// Compile-time error : un Champ Onglet sans aucun Volet.
// Les volets sont déclarés à la compilation (aucun ajout runtime en mode
// statique), donc un Onglet à 0 volet est un widget inutile.
FEN_OngletSansVolet est une Fenêtre
	PROPRIETES
		Titre = "Test"
		Disposition = dispLibre
		Largeur = 400
		Hauteur = 300
	FIN

	ONG_X est un Champ Onglet
		PROPRIETES
			X = 10
			Y = 10
			Largeur = 380
			Hauteur = 250
		FIN
	FIN
FIN
