// Mise en forme conditionnelle par cellule : n'existe pas.
// `TABLE_X[ligne].COL_Y` est valide et rend la VALEUR de la cellule ; un
// `.Prop` de plus doit etre refuse a la compilation, pas mourir au runtime
// sur « acces a un champ sur une valeur Null ».
// Attendu : E_SEM_TABLE_CELL_NO_PROP (forme deux-points, qui compile aussi).

FEN_CelluleProp2 est une Fenêtre
	PROPRIETES
		Disposition = dispVerticale
		Largeur     = 400
		Hauteur     = 300
	FIN
	TABLE_Synthese est un Champ Table
		PROPRIETES
			Étire = Vrai
		FIN
		COL_Tresorerie est une Colonne
			PROPRIETES
				Libellé = "Trésorerie"
				Type    = colTypeNumerique
				Largeur = 100
			FIN
		FIN
	FIN
	PROCEDURE Peindre()
		i est un entier = 1
		TABLE_Synthese[i].COL_Tresorerie..Couleur = RVB(200, 0, 0)
	FIN
FIN
