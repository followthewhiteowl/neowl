// ..Nom est la propriété universelle lecture seule qui retourne le nom
// déclaré d'un champ (son identité). Elle ne peut pas être réassignée en
// code : le nom d'un champ est fixé par sa déclaration.

FEN_NomRO est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 300
		Hauteur     = 150
	FIN
	SAI_X est un Champ de Saisie
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 200
			Hauteur = 25
		FIN
	FIN
	PROCEDURE Modifie()
		SAI_X..Nom = "autre"
	FIN
FIN
