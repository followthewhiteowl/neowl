// Forme colonne-first du cas croise : un nom de colonne REEL d'une AUTRE
// Table (COL_DEUX appartient a TABLE_D, pas TABLE_C) doit rester refuse en
// TABLE_C.COL_DEUX[ligne] comme en TABLE_C[ligne].COL_DEUX.

FEN_TableColonneAutreTableColFirst est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 300
	FIN
	TABLE_C est un Champ Table
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 180
			Hauteur = 150
		FIN
		COL_TROIS est une Colonne
			PROPRIETES
				Libellé = "Trois"
				Type    = colTypeTexte
				Largeur = 100
			FIN
		FIN
	FIN
	TABLE_D est un Champ Table
		PROPRIETES
			X       = 200
			Y       = 10
			Largeur = 180
			Hauteur = 150
		FIN
		COL_DEUX est une Colonne
			PROPRIETES
				Libellé = "Deux"
				Type    = colTypeTexte
				Largeur = 100
			FIN
		FIN
	FIN
	PROCEDURE Peindre()
		i est un entier = 1
		TABLE_C.COL_DEUX[i] = "valeur bidon"
		rLecture1465 est une chaîne = TABLE_C.COL_DEUX[i]
	FIN
FIN
