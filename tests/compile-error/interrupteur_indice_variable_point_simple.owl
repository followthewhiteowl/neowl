// Même refus que pour un Sélecteur : le point simple sur un élément indexé
// d'Interrupteur est refusé, indice littéral comme indice variable.

FEN_InterrupteurIndiceVar est une Fenêtre
	PROPRIETES
		Largeur = 200
		Hauteur = 100
	FIN

	INT_C est un Champ Interrupteur
		PROPRIETES
			Options = ["Lecture", "Écriture", "Suppression"]
		FIN
	FIN

	PROCEDURE FinInitialisation()
		i est un entier = 1
		Trace(INT_C[i].Libellé)
	FIN
FIN
