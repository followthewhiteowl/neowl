//  (ticket A) — propriété inconnue dans un bloc menu : pas de
// swallow, erreur compile (comme pour tout autre bloc widget).

FEN_MenuProprieteInconnue est une Fenêtre
	PROPRIETES
		Disposition     = dispLibre
		Largeur         = 200
		Hauteur         = 100
		MenuPrincipal   = MNU_X
	FIN

	MNU_X est un MenuPrincipal
		SM_A est un SousMenu
			PROPRIETES
				Libellé = "Menu A"
			FIN

			OPT_X est une OptionMenu
				PROPRIETES
					Libellé      = "Option X"
					CouleurBidon = Rouge
				FIN

				PROCEDURE surSélection()
				FIN
			FIN
		FIN
	FIN
FIN
