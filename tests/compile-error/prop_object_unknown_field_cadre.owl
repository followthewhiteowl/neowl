// : Type OBJECT compile-check — sous-champ inexistant
// sur prop composee.
//
// LIB_X..Cadre..Eppaisseur (typo : Eppaisseur au lieu de Epaisseur)
// doit produire une erreur de compilation nominative listant les
// champs valides du type Cadre.
//
// Attendu apres impl : erreur compile "Champ 'Eppaisseur' inconnu
// sur type Cadre. Champs valides : Couleur, Epaisseur, Trait,
// Arrondi, Bords, CoinHautGauche, ..." (ou equivalent).

FEN_X est une Fenetre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN
	LIB_X est un Champ Libelle
		PROPRIETES
			X       = 10
			Y       = 10
			Libelle = "test"
		FIN
	FIN
FIN

LIB_X..Cadre..Eppaisseur = 3
