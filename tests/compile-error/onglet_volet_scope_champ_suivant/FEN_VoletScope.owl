// Fenêtre-support : un Champ Onglet à volets, suivi de deux champs déclarés
// APRÈS lui. Ce qui suit un onglet à volets doit rester un champ de cette
// fenêtre — visible du compilateur, donc validé comme n'importe quel autre.

FEN_VoletScope est une Fenêtre
	PROPRIETES
		Titre       = "Portée après un onglet à volets"
		Disposition = dispLibre
		Largeur     = 480
		Hauteur     = 320
	FIN

	ONG_Classeur est un Champ Onglet
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 440
			Hauteur = 200
			Valeur  = 1
		FIN

		VOL_Premier est un Volet
			PROPRIETES
				Libellé     = "Premier"
				Disposition = dispLibre
			FIN

			// Un volet est un conteneur : il porte ses propres enfants, qui
			// ouvrent eux aussi un bloc à refermer.
			LIB_DansVolet est un Champ Libellé
				PROPRIETES
					X       = 10
					Y       = 10
					Libellé = "dans le volet"
				FIN
			FIN
		FIN

		VOL_Second est un Champ Volet
			PROPRIETES
				Libellé     = "Second"
				Disposition = dispLibre
			FIN
		FIN
	FIN

	LIB_Apres est un Champ Libellé
		PROPRIETES
			X       = 10
			Y       = 230
			Libellé = "après l'onglet"
		FIN
	FIN

	// Un champ dont le NOM commence par « Volet » n'est pas un sous-bloc : il
	// doit rester un champ ordinaire, lui aussi validé.
	VoletTemoin est un Champ Libellé
		PROPRIETES
			X       = 10
			Y       = 260
			Libellé = "témoin"
		FIN
	FIN
FIN
