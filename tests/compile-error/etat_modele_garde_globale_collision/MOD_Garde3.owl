// Modèle d'état pur utilisé par test_etat_modele_garde_globale_collision.owl.
//
// Déclare un paramètre top-level nRef. L'État voisin déclare un
// paramètre du même nom : les paramètres d'État/modèle partagent le
// même espace de noms global, donc le doublon est ambigu et refusé à
// l'impression.

MOD_Garde3 est un ModèleÉtat(nRef est un entier)
PROPRIETES
	Format      = formatA4
	Orientation = orientPortrait
FIN

Corps est un Corps
	PROPRIETES
		Hauteur = 40
	FIN
FIN
FIN
