// Un MenuPrincipal attend un styleMenuPrincipal. Lui affecter un style nommé
// d'un autre genre (theme.btnOk, un styleBouton) doit être rejeté à la
// compilation, comme sur un champ.

FEN_MismatchMenu est une Fenêtre
	PROPRIETES
		Titre         = "Mismatch menu"
		Disposition   = dispLibre
		Largeur       = 300
		Hauteur       = 120
		MenuPrincipal = MNU_x
	FIN

	MNU_x est un MenuPrincipal
		PROPRIETES
			Style = theme.btnOk
		FIN

		SM_Fichier est un SousMenu
			PROPRIETES
				Libellé = "&Fichier"
			FIN

			OPT_Quitter est une OptionMenu
				PROPRIETES
					Libellé = "&Quitter"
				FIN
			FIN
		FIN
	FIN
FIN
