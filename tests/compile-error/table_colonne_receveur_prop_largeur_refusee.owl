//  lot A — miroir de table_colonne_receveur_prop_libelle_refusee.owl
// pour 'Largeur' : receveur colonne accepté, mais 'Largeur' à chaud refusé
// EXPLICITEMENT (, pas de retour au no-op silencieux).
FEN_ColonneReceveurPropLargeur est une Fenêtre
	PROPRIETES
		Titre       = "Colonne receveur - Largeur refusée"
		Disposition = dispLibre
		Largeur     = 400
		Hauteur     = 300
	FIN

	TABLE_Unique est un Champ Table
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 300
			Hauteur = 200
		FIN

		COL_A est une Colonne
			PROPRIETES
				Libellé = "A"
				Type    = colTypeTexte
				Largeur = 100
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		COL_A..Largeur = 200
	FIN
FIN
