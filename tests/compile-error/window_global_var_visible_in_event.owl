// Verrou : variable declaree au top-level body fenetre (Declarations
// globales de référence) doit etre visible dans tous les events / user_procs.
FEN_X est une Fenetre
	PROPRIETES
		Titre = "X"
		Disposition = dispLibre
	FIN

	sTest est une chaine = "ok"
	nCompteur est un entier = 0

	BTN_OK est un Champ Bouton
		PROPRIETES
			Libelle = "OK"
		FIN
		PROCEDURE surClic()
			User est une chaine = sTest
			nCompteur = nCompteur + 1
		FIN
	FIN
FIN
