// CodeÉtat attend un identifiant de l'énumération httpCodeÉtat. Une
// chaîne à la place doit être refusée à la compilation.
ServiceSg est un ServiceREST
	PROPRIETES
		UrlBase = ["api"]
	FIN

	LitSg est une OpérationHTTP
		PROPRIETES
			Méthode  = httpGet
			Chemin   = ["clients"]
			Réponses = [httpOK]
			CodeÉtat = "httpOK"
		FIN
		PROCEDURE surRequête() : entier
			RENVOYER 0
		FIN
	FIN
FIN
