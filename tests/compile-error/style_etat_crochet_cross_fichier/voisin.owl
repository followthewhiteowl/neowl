// Compagnon : déclare le style relu par use.owl. Globale de style ordinaire,
// hors de tout bloc thème — un style de thème n'a pas de nom nu, il ne peut
// donc pas porter cette mesure-ci, qui vise le crochet d'état sur une variable
// déclarée chez un voisin.
stXF est un styleSaisie = {
	ZoneSaisie = { Etats = { Survol = { CouleurFond = Rouge } } }
}
