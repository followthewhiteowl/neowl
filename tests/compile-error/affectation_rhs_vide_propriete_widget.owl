// Même bug que affectation_rhs_vide_variable.owl, mais sur une propriété de
// champ (`..Libellé =`) plutôt qu'une variable. Aujourd'hui, la ligne
// suivante est une expression valide à elle seule (un appel), donc rien ne
// remonte comme erreur : l'affectation avale silencieusement l'instruction
// suivante entière comme membre droit. Cible : « Expression attendue »
// localisée sur la ligne de l'affectation.
FEN_Sonde est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
	FIN

	SEL_Mode est un Champ Sélecteur
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 240
			Options = [{Libellé = "Simple", SousLibellé = "Vue simple"},{Libellé = "Avancé", SousLibellé = "Vue avancée"}]
		FIN
	FIN

	PROCEDURE FinInitialisation()
		SEL_Mode[1]..Libellé =
		Trace("suite")
	FIN
FIN
