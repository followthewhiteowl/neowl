//  : FormatAffichage pose a la valeur par defaut (formatTexte) sur une
// saisie non multiligne -> aucun effet ignore, donc aucun warning (seul le
// format enrichi declenche le diagnostic).
FEN_FormatAffichageDefaut est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN
	SAI_X est un Champ Saisie
		PROPRIETES
			X               = 10
			Y               = 10
			Largeur         = 150
			Hauteur         = 24
			TypeSaisie      = typSaisieMotDePasse
			FormatAffichage = formatTexte
		FIN
	FIN
FIN
