//  — deux boutons declarent le MEME raccourci explicite "Alt+O"
// dans une meme fenetre : warning W_SEM_SHORTCUT_DUPLICATE emis sur le 2e
// bouton (ligne du 2e ToucheRaccourci).

FEN_DupExplicite est une Fenetre
	PROPRIETES
		Titre = "Dup explicite"
	FIN

	BTN_Un est un Champ Bouton
		PROPRIETES
			Libelle         = "Ouvrir"
			ToucheRaccourci = "Alt+O"
		FIN
	FIN

	BTN_Deux est un Champ Bouton
		PROPRIETES
			Libelle         = "Options"
			ToucheRaccourci = "Alt+O"
		FIN
	FIN
FIN
