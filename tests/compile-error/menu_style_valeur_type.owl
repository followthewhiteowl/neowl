//  — chaque propriété de style menu attend un type de valeur précis.
// Un attribut de police booléen (ici Police..Gras) attend Vrai/Faux ; un entier
// est refusé avec un message défensif.

FEN_MenuStyleValeurType est une Fenêtre
	PROPRIETES
		Disposition     = dispLibre
		Largeur         = 200
		Hauteur         = 100
		MenuPrincipal   = MNU_X
	FIN

	MNU_X est un MenuPrincipal
		PROPRIETES
			Style..Barre..Police..Gras = 12
		FIN

		SM_A est un SousMenu
			PROPRIETES
				Libellé = "Menu A"
			FIN
		FIN
	FIN
FIN
