//  : saisie texte simple (non multiligne) + format enrichi -> le format
// riche reste sans effet au runtime, le warning doit se declencher comme sur le
// mot de passe.
FEN_FormatAffichageTexte est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN
	SAI_X est un Champ Saisie
		PROPRIETES
			X               = 10
			Y               = 10
			Largeur         = 150
			Hauteur         = 24
			TypeSaisie      = typSaisieTexte
			FormatAffichage = formatTexteRiche
		FIN
	FIN
FIN
