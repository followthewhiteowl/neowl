// Modèle d'état réduit à un HautDePage (sans Corps) — fragment valide à
// partir de . Utilisé comme ancêtre par ETAT_HeriteSansCorps.owl
// (voisin) pour vérifier que l'absence de Corps sur l'état aplati reste
// une erreur même quand le modèle fournit déjà une bande.

MOD_SansCorps est un ModèleÉtat
	PROPRIETES
		Format      = formatA4
		Orientation = orientPortrait
	FIN

	haut est un HautDePage
		PROPRIETES
			Hauteur = 15
		FIN
		Trace("Haut de page du modèle")
	FIN
FIN
