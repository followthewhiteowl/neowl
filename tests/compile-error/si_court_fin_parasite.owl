// Compile-time error: forme courte SI avec FIN parasite sur la meme ligne.
// Nom de variable unique pour eviter collision avec d'autres tests du
// dossier (handle_check_command scanne le dossier parent pour les
// symboles cross-file).
fp_si_x est un entier = 5
SI fp_si_x > 0 ALORS Trace("a") FIN
