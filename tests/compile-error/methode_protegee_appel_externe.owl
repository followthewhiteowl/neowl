// Compile-time : methode PROTEGEE ne peut pas etre appelee depuis l'exterieur
// de la classe et de ses derivees. Appel depuis le top-level (non-classe)
// doit compile-error.

cService est une Classe
PUBLIC
	nCompteur est un entier

	PROCEDURE Constructeur()
		:nCompteur = 0
	FIN

	PROCEDURE PROTEGE InternalHelper()
		:nCompteur = :nCompteur + 5
		Trace("helper interne")
	FIN
FIN

PROCEDURE Main()
	oServ est un cService()
	oServ.InternalHelper()  // ATTENDU : compile-error "methode PROTEGEE"
FIN
