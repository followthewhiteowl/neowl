// La propriété Nom est l'identité déclarée du champ, non réassignable — et ce
// refus doit tenir même écrit en point simple, pas seulement en double point.

FEN_SaisieNom est une Fenêtre
	PROPRIETES
		Largeur = 200
		Hauteur = 100
	FIN

	SAI_X est un Champ Saisie
		PROPRIETES
			Valeur = "z"
		FIN
	FIN

	PROCEDURE FinInitialisation()
		SAI_X.Nom = "x"
	FIN
FIN
