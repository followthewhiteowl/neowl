// Mise en forme conditionnelle, forme colonne-first : un nom qui n'est pas
// une colonne déclarée de la Table doit être refusé quand la chaîne se
// termine par une propriété de mise en forme, pas seulement au niveau
// valeur (déjà couvert par table_cellule_nom_invente_colonne_first.owl).
// Attendu : E_SEM_TABLE_CELL_UNKNOWN_COLUMN.

FEN_MiseEnFormeColonneInventee est une Fenêtre
	PROPRIETES
		Disposition = dispVerticale
		Largeur     = 400
		Hauteur     = 300
	FIN
	TABLE_Synthese est un Champ Table
		PROPRIETES
			Étire = Vrai
		FIN
		COL_Tresorerie est une Colonne
			PROPRIETES
				Libellé = "Trésorerie"
				Type    = colTypeNumerique
				Largeur = 100
			FIN
		FIN
	FIN
	PROCEDURE Peindre()
		TABLE_Synthese.COL_Inventee[1]..Couleur = RVB(200, 0, 0)
	FIN
FIN
