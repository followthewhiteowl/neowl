// Robustesse forme chaîne + params : même en cible chaîne littérale
// ("BTN_Ok"), l'arité des params reste vérifiée au compile — la signature
// vient de la constante evt*, pas de la cible. evtClic (0 paramètre) + un
// paramètre = erreur compile.

FEN_DeclChaineAriteEnTrop est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN
	BTN_Ok est un Champ Bouton
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 100
			Hauteur = 30
			Libellé = "Ok"
		FIN
	FIN
	PROCEDURE Lance()
		DéclencheÉvénement("BTN_Ok", evtClic, 1)
	FIN
FIN
