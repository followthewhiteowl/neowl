// Bloc Initialisation obsolete au niveau champ.
// Le code d'initialisation se place dans le top-level (corps du champ).

FEN_Test est une Fenetre
	PROPRIETES
		Titre = "Test"
		Disposition = dispLibre
	FIN

	BTN_Action est un Champ Bouton
		PROPRIETES
			Libelle = "Action"
		FIN

		PROCEDURE Initialisation()
			Trace("init champ")
		FIN
	FIN
FIN
