//  P1 — garde de cohérence : un flux (Flux = fluxSSE / fluxOctets) est
// un mode de RÉPONSE progressive ; un corps multipart (ContentType =
// typeMimeFormulaireMultiPartie) est un mode de RÉCEPTION d'upload. Les deux
// combinés sont incohérents pour une opération et doivent être refusés à la
// compilation.
ServiceFluxMultipart est un ServiceREST
	PROPRIETES
		UrlBase = ["api"]
	FIN

	Diffuse est une OpérationHTTP
		PROPRIETES
			Méthode     = httpPost
			Chemin      = ["diffuse"]
			Flux        = fluxSSE
			ContentType = typeMimeFormulaireMultiPartie
		FIN
		PROCEDURE surRequête(fichier est un FichierTéléversé)
		FIN
	FIN
FIN
