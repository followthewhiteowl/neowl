//  lot A-bis — homonymie intra-fenêtre, colonne homonyme en position
// NON-première : deux Tables de la MÊME fenêtre déclarent chacune une colonne
// 'COL_A' en SECONDE position. Le refus d'ambiguïté et le nommage des
// Tables candidates doivent tenir quelle que soit la position de la colonne — le
// correctif de profondeur du pré-scan ne doit pas éteindre la détection.
FEN_ColonneReceveurHomonymeNonPremiere est une Fenêtre
	PROPRIETES
		Titre       = "Colonne receveur homonyme non première"
		Disposition = dispLibre
		Largeur     = 500
		Hauteur     = 300
	FIN

	TABLE_Un est un Champ Table
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 200
			Hauteur = 200
		FIN

		COL_Tete est une Colonne
			PROPRIETES
				Libellé = "Tête un"
				Type    = colTypeTexte
				Largeur = 100
			FIN
		FIN

		COL_A est une Colonne
			PROPRIETES
				Libellé = "Un"
				Type    = colTypeTexte
				Largeur = 100
			FIN
		FIN
	FIN

	TABLE_Deux est un Champ Table
		PROPRIETES
			X       = 220
			Y       = 10
			Largeur = 200
			Hauteur = 200
		FIN

		COL_Tete2 est une Colonne
			PROPRIETES
				Libellé = "Tête deux"
				Type    = colTypeTexte
				Largeur = 100
			FIN
		FIN

		COL_A est une Colonne
			PROPRIETES
				Libellé = "Deux"
				Type    = colTypeTexte
				Largeur = 100
			FIN
		FIN
	FIN

	PROCEDURE FinInitialisation()
		COL_A..Couleur = RVB(255, 0, 0)
	FIN
FIN
