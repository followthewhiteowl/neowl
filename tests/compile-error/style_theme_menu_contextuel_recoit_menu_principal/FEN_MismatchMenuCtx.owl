// Un MenuContextuel attend un styleMenuContextuel. Lui affecter un style de
// menu principal (theme.menuOk) doit être rejeté à la compilation.

FEN_MismatchMenuCtx est une Fenêtre
	PROPRIETES
		Titre       = "Mismatch menu contextuel"
		Disposition = dispLibre
		Largeur     = 300
		Hauteur     = 120
	FIN

	MNU_ctx est un MenuContextuel
		PROPRIETES
			Style = theme.menuOk
		FIN

		OPT_Copier est une OptionMenu
			PROPRIETES
				Libellé = "Copier"
			FIN
		FIN
	FIN
FIN
