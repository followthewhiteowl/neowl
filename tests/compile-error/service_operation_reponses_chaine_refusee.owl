// Réponses attend une liste de codes d'état. Une chaîne à la place doit
// être refusée à la compilation.
ServiceSh est un ServiceREST
	PROPRIETES
		UrlBase = ["api"]
	FIN

	LitSh est une OpérationHTTP
		PROPRIETES
			Méthode  = httpGet
			Chemin   = ["clients"]
			Réponses = "httpOK"
			CodeÉtat = httpOK
		FIN
		PROCEDURE surRequête() : entier
			RENVOYER 0
		FIN
	FIN
FIN
