//  (ticket A) — un MenuSéparateur n'est pas une action : il ne
// peut pas porter de PROCEDURE surSélection().

FEN_MenuSeparateurSelection est une Fenêtre
	PROPRIETES
		Disposition     = dispLibre
		Largeur         = 200
		Hauteur         = 100
		MenuPrincipal   = MNU_X
	FIN

	MNU_X est un MenuPrincipal
		SM_A est un SousMenu
			PROPRIETES
				Libellé = "Menu A"
			FIN

			SEP_1 est un MenuSéparateur
				PROCEDURE surSélection()
				FIN
			FIN
		FIN
	FIN
FIN
