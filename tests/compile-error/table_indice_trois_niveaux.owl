// Une Table s'adresse par ligne ('TABLE_X[1]') ou par ligne et colonne
// ('TABLE_X[1][1]'). Un 3e indice n'a plus rien a designer : refus a la
// compilation plutot qu'un message runtime qui ne nomme pas la Table.
// Attendu : E_SEM_TABLE_INDEX_TOO_DEEP.

FEN_IndiceTroisNiveaux est une Fenêtre
	PROPRIETES
		Disposition = dispVerticale
		Largeur     = 400
		Hauteur     = 300
	FIN
	TABLE_Synthese est un Champ Table
		PROPRIETES
			Étire = Vrai
		FIN
		COL_Tresorerie est une Colonne
			PROPRIETES
				Libellé = "Trésorerie"
				Type    = colTypeNumerique
				Largeur = 100
			FIN
		FIN
	FIN
	PROCEDURE Peindre()
		TABLE_Synthese[1][1][1]..Couleur = RVB(200, 0, 0)
	FIN
FIN
