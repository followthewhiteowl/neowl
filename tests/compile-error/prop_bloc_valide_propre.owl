// Garde anti-regression : un bloc PROPRIETES entierement valide (fenetre
// + champ) ne doit produire aucune erreur ni warning, avant et apres .

FEN_BlocValidePropres est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN
	SAI_X est un Champ Saisie
		PROPRIETES
			X       = 10
			Y       = 10
			Largeur = 100
			Hauteur = 30
		FIN
	FIN
FIN
