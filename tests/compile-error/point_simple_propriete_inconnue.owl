// Un nom de propriété inexistant, adressé en point simple : le refus doit
// être identique à celui du double point, pas un no-op silencieux.

FEN_ProprieteInconnue est une Fenêtre
	PROPRIETES
		Largeur = 200
		Hauteur = 100
	FIN

	LIB_A est un Champ Libellé
		PROPRIETES
			Libellé = "x"
		FIN
	FIN

	PROCEDURE FinInitialisation()
		LIB_A.PropFantome = 123
	FIN
FIN
