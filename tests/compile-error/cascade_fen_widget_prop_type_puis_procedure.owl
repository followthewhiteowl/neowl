//  — erreur de type dans PROPRIETES d'un widget, suivie d'une
// PROCEDURE declaree dans ce meme widget, desynchronisait le parseur :
// AVANT le fix, cascade fantome ("ne peut contenir que le bloc Fenetre",
// "bloc ferme trop tot", "N declaration(s) hors bloc") en plus de l'erreur
// de type legitime sur Width. CIBLE apres  : SEULE l'erreur de
// type remonte, zero cascade.

w_T is a Window()
	PROPERTIES
		Title = "T"
	END

	BTN_OK is a Control Button
		PROPERTIES
			Caption = "OK"
			Width   = "abc"
		END

		PROCEDURE onClick()
			Close()
		END
	END

	Edt_Test is a Control Input
		PROPERTIES
			Caption = "OK"
		END
	END
END
