//  (ticket A) — un OptionMenu est un item terminal : il ne peut
// pas contenir de sous-blocs (ici un OptionMenu enfant). Le conteneur
// déroulant, c'est SousMenu.

FEN_MenuOptionEnfants est une Fenêtre
	PROPRIETES
		Disposition     = dispLibre
		Largeur         = 200
		Hauteur         = 100
		MenuPrincipal   = MNU_X
	FIN

	MNU_X est un MenuPrincipal
		SM_A est un SousMenu
			PROPRIETES
				Libellé = "Menu A"
			FIN

			OPT_Parent est une OptionMenu
				PROPRIETES
					Libellé = "Parent"
				FIN

				OPT_Enfant est une OptionMenu
					PROPRIETES
						Libellé = "Enfant"
					FIN
				FIN
			FIN
		FIN
	FIN
FIN
