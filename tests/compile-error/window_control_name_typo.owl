// Regression : typo sur un nom de control DOIT remonter
// 'variable inconnue ou inaccessible'.
FEN_X est une Fenetre
	PROPRIETES
		Titre = ""
		Disposition = dispLibre
	FIN

	SAI_User est un Champ Saisie
		PROPRIETES
			Indication = "Nom"
		FIN
	FIN

	BTN_OK est un Champ Bouton
		PROPRIETES
			Libelle = "OK"
		FIN
		PROCEDURE surClic()
			User est une chaine = saiUser
		FIN
	FIN
FIN
