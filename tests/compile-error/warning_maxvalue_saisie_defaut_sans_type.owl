//  durcissement : Champ Saisie SANS TypeSaisie (defaut = texte) + borne
// -> warning (le defaut non-numerique rend la borne sans effet).
FEN_MaxValueDefautSansType est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 200
		Hauteur     = 100
	FIN
	SAI_X est un Champ Saisie
		PROPRIETES
			X          = 10
			Y          = 10
			Largeur    = 150
			Hauteur    = 24
			BorneMax   = 90
		FIN
	FIN
FIN
