// FinProgramme(Faux) : le code de fermeture du projet (Fermeture()) ne
// doit PAS s'exécuter. Même mécanisme de sentinelle que le cas Vrai, pour
// contraste direct (témoin négatif).
AppFinProgrammeFaux est un Projet
	PROPRIETES
		Langues = [langueFrançais]
	FIN

	PROCEDURE Fermeture()
		fSauveTexte("sentinelle.txt", "fermeture-executee")
	FIN

	FinProgramme(Faux)
FIN
