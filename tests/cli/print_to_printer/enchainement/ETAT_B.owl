// Etat B compagnon — enchaînement . Orientation paysage : vérifie que
// chaque état de la chaîne garde SA mise en page (point clé).
ETAT_B est un État
	PROPRIETES
		Format      = formatA4
		Orientation = orientPaysage
	FIN
	Corps est un Corps
		PROPRIETES
			Hauteur = 40
		FIN
		LBL_B est un Champ Libellé
			PROPRIETES
				X = 15
				Y = 15
				Largeur = 180
				Hauteur = 10
				Libellé = "Deuxieme etat de l'enchainement"
			FIN
		FIN
	FIN
FIN
