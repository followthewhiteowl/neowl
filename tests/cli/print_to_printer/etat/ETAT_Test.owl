	PROPRIETES
		Format      = formatA3
		Orientation = orientPortrait
	FIN

	Corps est un Corps
		PROPRIETES
			Hauteur = 60
		FIN

		LBL_Test est un Champ de Libellé
			PROPRIETES
				X       = 15
				Y       = 15
				Largeur = 180
				Hauteur = 10
				Libellé = "Impression d'un etat via l'imprimante"
			FIN
		FIN
	FIN
FIN
