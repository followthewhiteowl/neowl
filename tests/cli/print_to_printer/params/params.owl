//  Lot 1 : iParametre pilote le recto-verso (iRectoVerso) et la
// couleur/monochrome (iCouleur). Verrou round-trip : ce qu'on fixe par le
// setter, le getter le relit a l'identique.
//
// Isole dans son propre dossier : le mode script scanne les voisins du meme
// repertoire, on evite ainsi d'embarquer la fixture de rendu voisine.
//
// OWL_PRINTER_OUTPUT_FILE (pose par le harnais) derive l'imprimante vers un
// format fichier qui accepte tout reglage, rendant le round-trip deterministe
// en CI sans dependre des capacites d'un driver physique.

iParametre(iCouleur, iCouleur_Mono)
SI iParametre(iCouleur) = iCouleur_Mono ALORS
	Trace("PASS_COULEUR_MONO")
SINON
	Trace("FAIL_COULEUR_MONO")
FIN

iParametre(iCouleur, iCouleur_Couleur)
SI iParametre(iCouleur) = iCouleur_Couleur ALORS
	Trace("PASS_COULEUR_COUL")
SINON
	Trace("FAIL_COULEUR_COUL")
FIN

iParametre(iRectoVerso, iRectoVerso_Vertical)
SI iParametre(iRectoVerso) = iRectoVerso_Vertical ALORS
	Trace("PASS_DUPLEX_VERT")
SINON
	Trace("FAIL_DUPLEX_VERT")
FIN

iParametre(iRectoVerso, iRectoVerso_Simple)
SI iParametre(iRectoVerso) = iRectoVerso_Simple ALORS
	Trace("PASS_DUPLEX_SIMPLE")
SINON
	Trace("FAIL_DUPLEX_SIMPLE")
FIN

iParametre(iAlimentationPapier, iAlimentationPapier_Haut)
SI iParametre(iAlimentationPapier) = iAlimentationPapier_Haut ALORS
	Trace("PASS_BAC_HAUT")
SINON
	Trace("FAIL_BAC_HAUT")
FIN

// Haut (Upper) et UneSeule (OnlyOne) sont confondus par Qt : le suivi
// d'intention doit les garder distincts au round-trip.
iParametre(iAlimentationPapier, iAlimentationPapier_UneSeule)
SI iParametre(iAlimentationPapier) = iAlimentationPapier_UneSeule ALORS
	Trace("PASS_BAC_UNESEULE")
SINON
	Trace("FAIL_BAC_UNESEULE")
FIN
