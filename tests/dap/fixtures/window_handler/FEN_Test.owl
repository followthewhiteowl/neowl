FEN_Test est une Fenêtre
	PROPRIETES
		Disposition = dispLibre
		Largeur     = 300
		Hauteur     = 200
	FIN

	compteur est un entier = 0

	BTN_Go est un Champ Bouton
		PROPRIETES
			X = 10
			Y = 10
		FIN
		PROCEDURE surClic()
			increment est un entier = 5
			compteur += increment
			Trace("dans le handler clic")
		FIN
	FIN
FIN
